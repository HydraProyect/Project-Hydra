diff --git a/tests/CaeManager.Web.Tests/DialogoFocoJsTests.cs b/tests/CaeManager.Web.Tests/DialogoFocoJsTests.cs
new file mode 100644
index 000000000..0b140c3e6
--- /dev/null
+++ b/tests/CaeManager.Web.Tests/DialogoFocoJsTests.cs
@@ -0,0 +1,47 @@
+using FluentAssertions;
+
+namespace CaeManager.Web.Tests;
+
+/// <summary>
+/// La trampa de foco de Modal, Drawer, Context Workspace, buscador global y diálogo de restablecer el menú
+/// (wwwroot/js/dialogo-foco.js) no corre en bUnit. js/dialogoFoco.test.mjs la evalúa con un document falso: al
+/// abrirse, el foco entra en el diálogo si estaba fuera y se queda donde está si ya estaba dentro (#2194).
+/// </summary>
+public class DialogoFocoJsTests
+{
+    [Fact]
+    public async Task La_trampa_de_foco_no_roba_el_foco_si_ya_esta_dentro_del_dialogo()
+    {
+        // Mismo patrón que CampoFechaTests: necesita Node; sin él esta prueba falla en vez de saltarse.
+        var dir = AppContext.BaseDirectory;
+        while (dir is not null && !File.Exists(Path.Combine(dir, "CaeManager.slnx"))) dir = Path.GetDirectoryName(dir);
+        dir.Should().NotBeNull("se necesita la raíz del repositorio");
+        var prueba = Path.Combine(dir!, "tests", "CaeManager.Web.Tests", "js", "dialogoFoco.test.mjs");
+        File.Exists(prueba).Should().BeTrue();
+        var info = new System.Diagnostics.ProcessStartInfo("node", $"--test \"{prueba}\"")
+        {
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+        };
+        System.Diagnostics.Process proceso;
+        try { proceso = System.Diagnostics.Process.Start(info)!; }
+        catch (System.ComponentModel.Win32Exception ex)
+        {
+            throw new InvalidOperationException("Hace falta Node en el PATH para ejecutar js/dialogoFoco.test.mjs: " + ex.Message, ex);
+        }
+
+        using (proceso)
+        {
+            var salida = proceso.StandardOutput.ReadToEndAsync();
+            var error = proceso.StandardError.ReadToEndAsync();
+            var termino = proceso.WaitForExit(TimeSpan.FromSeconds(60));
+            if (!termino) proceso.Kill(entireProcessTree: true);
+            termino.Should().BeTrue("node --test no debe colgarse");
+            var textoSalida = await salida;
+            var textoError = await error;
+            proceso.ExitCode.Should().Be(0, "las pruebas de Node fallaron:\n" + textoSalida + textoError);
+            textoSalida.Should().MatchRegex(@"(?m)\bpass [1-9]\d*\s*$", "node --test debe haber ejecutado casos");
+        }
+    }
+}
diff --git a/tests/CaeManager.Web.Tests/js/dialogoFoco.test.mjs b/tests/CaeManager.Web.Tests/js/dialogoFoco.test.mjs
new file mode 100644
index 000000000..d7166a65b
--- /dev/null
+++ b/tests/CaeManager.Web.Tests/js/dialogoFoco.test.mjs
@@ -0,0 +1,101 @@
+// Pruebas de src/CaeManager.Web/wwwroot/js/dialogo-foco.js con un document falso: al abrir un diálogo el foco entra en él,
+// pero si ya está dentro (el usuario o Playwright escribiendo en un campo antes de que la trampa se active) no se mueve (#2194).
+// Las ejecuta DialogoFocoJsTests (dotnet test) con el Node de la máquina, sin dependencias.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { pathToFileURL, fileURLToPath } from 'node:url';
+
+const ruta = fileURLToPath(new URL('../../../src/CaeManager.Web/wwwroot/js/dialogo-foco.js', import.meta.url));
+
+// El módulo lee `document` al llamarse, no al importarse: basta con fijar el global antes de cada llamada.
+const { atraparFoco } = await import(pathToFileURL(ruta).href);
+
+function elemento(nombre, documento, padre = null) {
+    const el = {
+        nombre,
+        padre,
+        hijos: [],
+        offsetParent: {},
+        oyentes: {},
+        focus() { documento.activeElement = el; },
+        contains(otro) {
+            for (let actual = otro; actual; actual = actual.padre) if (actual === el) return true;
+            return false;
+        },
+        addEventListener(tipo, f) { el.oyentes[tipo] = f; },
+        removeEventListener(tipo) { delete el.oyentes[tipo]; },
+        querySelectorAll() {
+            const todos = [];
+            const recorrer = (n) => { for (const h of n.hijos) { if (h.enfocable) todos.push(h); recorrer(h); } };
+            recorrer(el);
+            return todos;
+        },
+    };
+    if (padre) padre.hijos.push(el);
+    return el;
+}
+
+function escena({ conCampos = true } = {}) {
+    const documento = { activeElement: null, querySelector: () => null };
+    const cuerpo = elemento('body', documento);
+    documento.body = cuerpo;
+    documento.contains = (otro) => cuerpo.contains(otro);
+    const abridor = elemento('abridor', documento, cuerpo);
+    abridor.enfocable = true;
+    const dialogo = elemento('dialogo', documento, cuerpo);
+    let primero = null;
+    let fecha = null;
+    if (conCampos) {
+        primero = elemento('primero', documento, dialogo);
+        primero.enfocable = true;
+        fecha = elemento('fecha', documento, dialogo);
+        fecha.enfocable = true;
+    }
+    globalThis.document = documento;
+    globalThis.HTMLElement = Object;
+    return { documento, abridor, dialogo, primero, fecha };
+}
+
+test('con el foco fuera, al abrir el diálogo el foco entra en el primer enfocable', () => {
+    const { documento, abridor, dialogo, primero } = escena();
+    abridor.focus();
+    atraparFoco(dialogo);
+    assert.equal(documento.activeElement, primero);
+});
+
+test('con el foco ya en un campo del diálogo, la trampa no se lo quita (#2194)', () => {
+    const { documento, dialogo, fecha } = escena();
+    fecha.focus();
+    atraparFoco(dialogo);
+    assert.equal(documento.activeElement, fecha);
+});
+
+test('con el foco en el propio contenedor, no se mueve al primer campo', () => {
+    const { documento, dialogo } = escena();
+    dialogo.focus();
+    atraparFoco(dialogo);
+    assert.equal(documento.activeElement, dialogo);
+});
+
+test('sin enfocables y con el foco fuera, el foco cae en el contenedor', () => {
+    const { documento, abridor, dialogo } = escena({ conCampos: false });
+    abridor.focus();
+    atraparFoco(dialogo);
+    assert.equal(documento.activeElement, dialogo);
+});
+
+test('sin elemento activo, el foco entra en el diálogo', () => {
+    const { documento, dialogo, primero } = escena();
+    documento.activeElement = null;
+    atraparFoco(dialogo);
+    assert.equal(documento.activeElement, primero);
+});
+
+test('al liberar la trampa, el foco vuelve a quien abrió el diálogo', () => {
+    const { documento, abridor, dialogo } = escena();
+    abridor.focus();
+    const trampa = atraparFoco(dialogo);
+    trampa.dispose();
+    assert.equal(documento.activeElement, abridor);
+    assert.equal(dialogo.oyentes.keydown, undefined);
+});
