# Plantilla de variables del stack local. Copia a `.env` en este mismo
# directorio y rellena — el `.env` real NUNCA se commitea (está en .gitignore).
# La referencia completa de cada variable es DEPLOY.md § 3 (los nombres son
# los mismos; solo cambia dónde se declaran).

# --- Infraestructura del compose ---
# Contraseña del PostgreSQL local (también compone ConnectionStrings__CaeManagerDb).
POSTGRES_PASSWORD=
# Dominio público del despliegue (p. ej. app.talveg.es) — Caddy pide el
# certificado TLS para este nombre exacto. El registro DNS (A) de este
# dominio debe apuntar ya a la IP pública de esta máquina antes de arrancar
# el stack, o Caddy no podrá validarlo con Let's Encrypt.
DOMINIO=
# Email de aviso de Let's Encrypt (solo recibe notificaciones si falla una
# renovación de certificado — no crea cuenta ni depende de terceros).
ACME_EMAIL=

# --- Obligatorias en producción (sin ellas el arranque falla a propósito) ---
AdministradorInicial__Email=
AdministradorInicial__Contrasena=

# --- Datos de prueba (esta etapa no tiene datos reales) ---
# Siembra la cartera de prueba en el primer arranque si no hay ningún Cliente.
DatosPrueba__Activo=true

# --- Opcionales: copiar de las variables que hubiera en Railway ---
# SSO Entra ID (DEPLOY.md § 3.1) — recuerda añadir el dominio nuevo a los
# redirect URIs del App Registration:
#AzureAd__TenantId=
#AzureAd__ClientId=
#AzureAd__ClientSecret=

# Correo por Microsoft Graph (DEPLOY.md § 3.2):
#Graph__TenantId=
#Graph__ClientId=
#Graph__ClientSecret=
#Graph__BuzonRemitente=

# Alertas de vencimiento por correo:
#AlertasPorCorreo__Activo=true
#AlertasPorCorreo__UrlBase=https://app.TU-DOMINIO.com

# Conector Microsoft 365 (DEPLOY.md § 3.4):
#Integraciones__Microsoft365__ClientId=
#Integraciones__Microsoft365__ClientSecret=

# WhatsApp Cloud API (DEPLOY.md § 3.5) — reapuntar la callback URL en Meta a
# https://app.TU-DOMINIO.com/api/integraciones/webhooks/whatsapp:
#Integraciones__WhatsApp__AppSecret=
#Integraciones__WhatsApp__VerifyToken=

# Chat "Pregúntale a Hydra":
#Anthropic__ApiKey=

# Observabilidad — Seq ya viene incluido en este mismo compose (servicio
# "seq", solo loopback): déjalo apuntando al nombre del servicio, no hace
# falta instancia externa. Sentry sí requiere DSN de un proyecto real.
Serilog__Seq__ServerUrl=http://seq:80
#Serilog__Seq__ApiKey=
Sentry__Dsn=
