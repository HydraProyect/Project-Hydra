# Plantilla de variables del stack de STAGING (segundo stack en la misma
# máquina que producción, ver docker-compose.staging.yml). Copia a
# `.env.staging` en este mismo directorio y rellena — nunca se commitea (está
# en .gitignore junto con `.env`). La referencia completa de cada variable es
# DEPLOY.md § 3 (los nombres son los mismos que en producción; solo cambia
# dónde se declaran y, para varias, que aquí sí conviene activarlas).
#
# No reutilices ningún valor de `.env` (el de producción) tal cual — en
# particular POSTGRES_PASSWORD y AdministradorInicial__Contrasena deberían
# ser propios de staging, aunque no haya datos reales detrás.

# --- Infraestructura del compose ---
# Contraseña del PostgreSQL de staging (también compone
# ConnectionStrings__CaeManagerDb). Propia, distinta de la de producción.
POSTGRES_PASSWORD=

# Nótese que staging NO tiene DOMINIO ni ACME_EMAIL propios: no levanta su
# propio Caddy (ver el comentario de docker-compose.staging.yml) — el dominio
# `staging.talveg.es` está escrito literal en el Caddyfile de producción, que
# es quien sirve TLS para los dos stacks desde el único 80/443 del host.

# --- Obligatorias en producción (sin ellas el arranque falla a propósito) ---
AdministradorInicial__Email=
AdministradorInicial__Contrasena=

# --- Datos de prueba ---
# En staging esto tiene más sentido que en producción: es exactamente el
# entorno donde quieres cartera de prueba sembrada para poder probar un
# cambio con datos realistas ANTES de que llegue a producción, no un valor
# heredado sin pensar. Déjalo en true salvo que estés probando explícitamente
# un flujo de "tenant recién creado, sin datos".
DatosPrueba__Activo=true

# SI DEJAS LA SIEMBRA EN true, ESTAS TRES SON OBLIGATORIAS. Sin ellas el
# arranque ABORTA — no arranca a medias ni avisa: lanza y el contenedor entra
# en bucle de reinicio. Es la guarda de seguridad del PR #296: los valores por
# defecto son constantes de un repositorio público, y usarlos publicaría el
# acceso a los tenants sembrados.
#
# El stack de staging corre con el entorno de Producción, así que la guarda
# aplica aquí igual que allí. Déjalas vacías SOLO si pones
# DatosPrueba__Activo=false.
#
# Incidente del 2026-08-29: staging quedó en bucle de reinicio con
# «La siembra está encendida en Producción pero falta DatosPrueba:Contrasena».
# Llevaba latente desde el 27 de agosto y solo se vio al reiniciar el
# contenedor, porque la guarda únicamente corre en el arranque. Un stack que
# lleva semanas en pie puede tener esto roto sin que nadie lo note.
DatosPrueba__Contrasena=
DatosPrueba__ClaveApiActiva=
DatosPrueba__ClaveApiRevocada=

# --- Opcionales: igual que en producción, normalmente NO hacen falta en
# staging salvo que quieras probar la integración concreta (SSO, WhatsApp,
# Microsoft 365 o el conector de correo exigen su propio App Registration/
# webhook apuntando a https://staging.talveg.es, distinto del de producción —
# no lo des por hecho si activas alguna de estas) ---
#AzureAd__TenantId=
#AzureAd__ClientId=
#AzureAd__ClientSecret=

#Graph__TenantId=
#Graph__ClientId=
#Graph__ClientSecret=
#Graph__BuzonRemitente=

#AlertasPorCorreo__Activo=true
#AlertasPorCorreo__UrlBase=https://staging.talveg.es

#Integraciones__Microsoft365__ClientId=
#Integraciones__Microsoft365__ClientSecret=

#Integraciones__WhatsApp__AppSecret=
#Integraciones__WhatsApp__VerifyToken=

# Chat "Pregúntale a Hydra" — si lo pruebas en staging, usa la misma clave de
# producción (no hay coste adicional por tener dos entornos apuntando a la
# misma cuenta de Anthropic) o una propia si quieres medir el coste aparte.
#Anthropic__ApiKey=

# --- Observabilidad — Seq propio de staging incluido en este mismo compose
# (servicio "seq", solo loopback en el puerto de host 5342, no 5341) ---
Serilog__Seq__ServerUrl=http://seq:80
#Serilog__Seq__ApiKey=
Sentry__Dsn=
