<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.7.2" />
    <!-- AngleSharp 1.4.0 llega de forma transitiva vía bunit y tiene una
         vulnerabilidad moderada conocida (GHSA-pgww-w46g-26qg) — se fija
         explícitamente a una versión parcheada en vez de silenciar el
         aviso, porque bunit 2.7.2 sigue funcionando bien contra ella. -->
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CaeManager.Web\CaeManager.Web.csproj" />
  </ItemGroup>

</Project>
