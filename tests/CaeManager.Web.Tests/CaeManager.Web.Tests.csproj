<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <!-- AngleSharp 1.4.0 llega de forma transitiva vía bunit y tiene una
         vulnerabilidad moderada conocida (GHSA-pgww-w46g-26qg) — se fija
         explícitamente a una versión parcheada en vez de silenciar el
         aviso, porque bunit 2.7.2 sigue funcionando bien contra ella.
         1.7.2 (no 1.7.1) porque HtmlSanitizer 9.2.1039, que Infrastructure usa
         para sanear el HTML de correo, exige >= 1.7.2 y la degradación rompe
         la restauración de este proyecto (NU1605). Este pin sube en tándem con
         el suelo de HtmlSanitizer: cada bump suyo obliga a revisarlo aquí. -->
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Fijado en exacta (no comodín): la 8.x exige licencia comercial de
         pago (Xceed); ver el razonamiento completo en
         CaeManager.Domain.Tests.csproj y dependabot.yml. -->
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tarifa de Anthropic del banco de modelos de IA: se lee en ejecución (TarifasAnthropic). -->
    <None Update="BancoModelosIa/tarifas-anthropic.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Suelo de hilos del ThreadPool (issue #2171, HIPÓTESIS no demostrada por instrumentación del pool).
         Los WaitForAssertion de 1 s de bUnit caducaban solo en CI con «Check count: 0». Con el suelo por defecto
         (= núcleos, 2-4 en CI) el pool inyecta hilos nuevos a ~1 por segundo si todos están ocupados, y la
         continuación del componente y la comprobación necesitan uno. Quién los ocupa no está identificado
         (xunit corre los tests en hilos propios, no del pool). Evidencia: con DOTNET_PROCESSOR_COUNT=2 la suite
         entera fallaba en WaitForAssertion de tests ajenos al issue, y con este suelo no. Si #2171 reaparece, el
         suelo no era la causa: medir ThreadPool.ThreadCount y PendingWorkItemCount en el fallo.
         Efecto asumido: un test que dependiera de un hilo libre del pool ya no lo delataría por intermitencia. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="64" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\CaeManager.E2ETests\Rendimiento\MedidorConsultasSql.cs" Link="Rendimiento\MedidorConsultasSql.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CaeManager.Web\CaeManager.Web.csproj" />
  </ItemGroup>

</Project>
