<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Fijado en exacta (no comodín): la 8.x exige licencia comercial de
         pago (Xceed); ver el razonamiento completo en
         CaeManager.Domain.Tests.csproj y dependabot.yml. -->
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <!-- Version fijada a la misma que ya resuelve el grafo de forma transitiva
         (ver packages.lock.json de CaeManager.Web/CaeManager.Infrastructure),
         para no introducir un segundo Roslyn en la solucion. DEC-65 (REC-178)
         pide instrumentacion lexica/sintactica de C# en vez de una regex mas
         sofisticada. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CaeManager.Domain\CaeManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Application\CaeManager.Application.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Infrastructure\CaeManager.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Migrations.PostgreSQL\CaeManager.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\CaeManager.Web\CaeManager.Web.csproj" />
  </ItemGroup>

</Project>
