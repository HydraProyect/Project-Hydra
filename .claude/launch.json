{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hydra-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--no-build",
        "--project",
        "src/CaeManager.Web",
        "--launch-profile",
        "http"
      ],
      "port": 5186
    },
    {
      "name": "hydra-web-lote2",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--no-build",
        "--project",
        "src/CaeManager.Web",
        "--no-launch-profile",
        "--",
        "--environment",
        "Development",
        "--urls",
        "http://localhost:5297",
        "--ConnectionStrings:CaeManagerDb=Host=localhost;Port=5432;Database=caemanager_lote2;Username=postgres;Password=postgres;Command Timeout=120",
        "--DatosPrueba:Activo=true"
      ],
      "port": 5297
    }
  ]
}