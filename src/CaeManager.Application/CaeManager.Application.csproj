<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CaeManager.Domain\CaeManager.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
    <PackageReference Include="MediatR" Version="12.*" />
    <PackageReference Include="MediatR.Contracts" Version="2.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>

  <!-- LectorRecuentoPaginasPdfSinAbrir expone una sobrecarga interna con el
       tope de las búsquedas textuales como parámetro, para que un test pruebe
       la lógica de lectura sin depender del reloj de pared de la máquina. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CaeManager.Application.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
