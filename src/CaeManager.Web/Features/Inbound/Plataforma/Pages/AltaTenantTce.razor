@page "/plataforma/inbound/alta-tenant-tce"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Web.Features.Inbound.Plataforma.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosAltaTenantTce> Textos

@* Tarjeta 31 (maqueta AltaTenantTCE.dc.html). Plano de Plataforma: la pantalla solo ofrece sus acciones dentro de una
   Sesión Privilegiada de Aprovisionamiento sin impersonación y con el Tenant activo resuelto, pero eso es solo
   presentación. La autoridad la deciden ContratarLineaInboundCommand, CorregirLineaInboundCommand y
   DarDeBajaLineaInboundCommand (AutoridadSobreLaLineaInbound): capacidad Aprovisionamiento, camino de escritura, Tenant
   objetivo = Tenant activo y sin Usuario simulado. *@

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"{Textos["TituloPagina"]} — {Marca.Nombre}")" />

<div class="contenedor-pagina alta-tce">
    @* Cabecera compartida (la de EstadoComercial, otra pantalla de Plataforma que no es un listado): conserva el antetítulo «Plataforma · Tenants». *@
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]">
        <Descripcion>@Textos["Subtitulo"]</Descripcion>
    </CabeceraPagina>

    <div class="alta-tce-aviso" role="note">
        <Icono Nombre="info" Tamano="TamanoIcono.Pequeno" />
        <div><strong>@Textos["AvisoActorTitulo"]</strong> @Textos["AvisoActorTexto"]</div>
    </div>

    @if (_cargando)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_errorCarga)
    {
        <div class="alta-tce-tarjeta alta-tce-bloqueo" role="alert">
            <p>@Textos["ErrorCarga"]</p>
            <Boton Variante="VarianteBoton.Secundario" OnClick="CargarAsync">@Textos["Reintentar"]</Boton>
        </div>
    }
    else if (Acceso == AccesoPantalla.Impersonacion)
    {
        <div class="alta-tce-tarjeta alta-tce-bloqueo" role="status" data-estado="impersonacion">
            <h2>@Textos["ImpersonacionTitulo"]</h2>
            <p>@Textos["ImpersonacionTexto"]</p>
        </div>
    }
    else if (Acceso == AccesoPantalla.TenantNoResuelto)
    {
        <div class="alta-tce-tarjeta alta-tce-bloqueo" role="status" data-estado="tenant-no-resuelto">
            <h2>@Textos["TenantNoResueltoTitulo"]</h2>
            <p>@Textos["TenantNoResueltoTexto"]</p>
        </div>
    }
    else if (Acceso == AccesoPantalla.SinSesion)
    {
        <div class="alta-tce-tarjeta alta-tce-bloqueo" role="status" data-estado="sin-sesion">
            <h2>@Textos["SinSesionTitulo"]</h2>
            <p>@Textos["SinSesionTexto"]</p>
            <a href="/delegaciones">@Textos["SinSesionEnlace"]</a>
        </div>
    }
    else if (_contratado is not null)
    {
        <div class="alta-tce-tarjeta">
            <div class="alta-tce-ok" role="status">
                <h2>@TituloHecho</h2>
                <p>@TextoHecho</p>
                <a href="/configuracion/plataforma">@Textos["VolverPlataforma"]</a>
            </div>
        </div>
    }
    else
    {
        <div class="alta-tce-tarjeta">
            <div class="alta-tce-pasos">
                <IndicadorPasos Pasos="Pasos" PasoActual="@PasoActualClave" PasosCompletados="PasosHechos"
                                EtiquetaGrupo="@Textos["PasosEtiqueta"]" />
            </div>

            <div class="alta-tce-cuerpo">
                @if (_paso == 1)
                {
                    <div class="campo">
                        <span class="campo-label">@Textos["CampoTenantTce"]</span>
                        <div class="alta-tce-solo-lectura" data-campo="tenant">@NombreTenant</div>
                        <span class="campo-ayuda">@Textos["CampoTenantTceAyuda"]</span>
                    </div>
                    @* shortcut: sin backend, cablear cuando entre B-04 (alta completa del Tenant TCE: nombre, CIF y
                       Empresa propia en esta misma pantalla). Hoy el Tenant se crea antes por la vía vigente (D-A). *@
                    <p class="alta-tce-nota" data-shortcut="B-04">@Textos["Paso1NoDisponible"]</p>
                }
                else if (_paso == 2)
                {
                    <fieldset class="alta-tce-radios">
                        <legend>@Textos["OperacionLeyenda"]</legend>
                        @* Como en la corrección: la ayuda fuera del <label>, enlazada con aria-describedby. *@
                        <div class="alta-tce-opc off"><input type="radio" id="alta-tce-operacion-externo" name="alta-tce-operacion" disabled aria-describedby="alta-tce-operacion-externo-ayuda" /><span><label for="alta-tce-operacion-externo"><b>@Textos["OperacionExternoTitulo"]</b></label><span id="alta-tce-operacion-externo-ayuda">@Textos["OperacionExternoAyuda"]</span></span></div>
                        <div class="alta-tce-opc off"><input type="radio" id="alta-tce-operacion-propio" name="alta-tce-operacion" disabled aria-describedby="alta-tce-operacion-propio-ayuda" /><span><label for="alta-tce-operacion-propio"><b>@Textos["OperacionPropioTitulo"]</b></label><span id="alta-tce-operacion-propio-ayuda">@Textos["OperacionPropioAyuda"]</span></span></div>
                    </fieldset>
                    @* shortcut: sin backend, cablear cuando entre B-04b (Asignación de Operación Inbound y encargo de
                       administración pleno del Operador CAE externo, D-D). *@
                    <p class="alta-tce-nota" data-shortcut="B-04b">@Textos["Paso2NoDisponible"]</p>
                }
                else if (_paso == 3)
                {
                    <p class="alta-tce-nota"><strong>@Textos["ProductoNotaTitulo"]</strong> @Textos["ProductoNotaTexto"]</p>
                    <CamposLinea Pagador="@_pagador" PagadorChanged="CambiarPagador"
                                 Tramo="@_tramo" TramoChanged="CambiarTramo"
                                 Modalidad="@_modalidad" ModalidadChanged="CambiarModalidad"
                                 Prefijo="alta" />
                    <div class="alta-tce-fila">
                        <div class="campo">
                            <span class="campo-label">@Textos["CampoBeneficiario"]</span>
                            <div class="alta-tce-solo-lectura">@NombreTenant</div>
                            <span class="campo-ayuda">@Textos["CampoBeneficiarioAyuda"]</span>
                        </div>
                        <div class="campo">
                            <span class="campo-label">@Textos["CampoVigencia"]</span>
                            <div class="alta-tce-solo-lectura">@Textos["CampoVigenciaValor"]</div>
                            <span class="campo-ayuda">@Textos["CampoVigenciaAyuda"]</span>
                        </div>
                    </div>
                }
                else if (_paso == 4)
                {
                    @* shortcut: sin backend, cablear cuando entre B-04b (el Administrador del Tenant TCE por
                       invitación, D-D). No se envía ningún correo. *@
                    <p class="alta-tce-nota" data-shortcut="B-04b">@Textos["Paso4NoDisponible"]</p>
                }
                else
                {
                    @foreach (var seccion in SeccionesResumen)
                    {
                        <section class="alta-tce-seccion" aria-label="@seccion.Titulo">
                            <h3 class="alta-tce-sec-cab">
                                <span>@seccion.Titulo</span>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" Deshabilitado="Ocupado"
                                       OnClick="() => IrA(seccion.Paso)">@Textos["Editar"]</Boton>
                            </h3>
                            <dl class="alta-tce-res">
                                @foreach (var fila in seccion.Filas)
                                {
                                    <dt>@fila.Clave</dt><dd>@fila.Valor</dd>
                                }
                            </dl>
                        </section>
                    }
                    @* Opción A' (DECISION_LOG e496f33): la declaración «solo Inbound» es opcional y nunca viene marcada.
                       ContratarLineaInboundCommand la guarda en la fila de la línea Inbound; sin ella, el Tenant conserva
                       Outbound. *@
                    <div class="alta-tce-opc" data-campo="declara-solo-inbound">
                        <input type="checkbox" id="alta-tce-declara-solo-inbound" checked="@_declaraSoloInbound" disabled="@Ocupado"
                               aria-describedby="alta-tce-declara-solo-inbound-texto"
                               @onchange="CambiarDeclaracionSoloInbound" />
                        <span><label for="alta-tce-declara-solo-inbound"><b>@Textos["DeclaracionSoloInboundTitulo"]</b></label> <span class="alta-tce-opc-texto" id="alta-tce-declara-solo-inbound-texto">@Textos["DeclaracionSoloInboundTexto"]</span></span>
                    </div>
                }

                @if (_error is not null)
                {
                    <p class="alta-tce-err" role="alert">@_error</p>
                }
            </div>

            <footer class="alta-tce-pie">
                <Boton Variante="VarianteBoton.Fantasma" OnClick="Cancelar" Deshabilitado="Ocupado">@Textos["Cancelar"]</Boton>
                <span class="alta-tce-sep"></span>
                @if (_paso > 1)
                {
                    <Boton Variante="VarianteBoton.Secundario" OnClick="Atras" Deshabilitado="Ocupado">@Textos["Atras"]</Boton>
                }
                @* Un solo primario por vista: Continuar en los pasos 1 a 4 y Dar de alta en el Resumen. *@
                <Boton Variante="VarianteBoton.Primario" OnClick="AvanzarAsync" Cargando="_enviando">@TextoPrimario</Boton>
            </footer>
        </div>

        @if (_cancelado)
        {
            <p class="alta-tce-mut" role="status">@Textos["Cancelado"]</p>
        }
    }

    @if (Acceso == AccesoPantalla.Permitida && !_cargando && !_errorCarga)
    {
        @* Baja y corrección (#2256), sin maqueta propia. La pantalla no lee todavía la línea vigente (lectura en curso en
           #2277): ofrece las dos acciones y el comando responde si no hay línea vigente. *@
        <section class="alta-tce-tarjeta alta-tce-linea" aria-labelledby="alta-tce-linea-titulo">
            <div class="alta-tce-linea-cab">
                <h2 id="alta-tce-linea-titulo">@Textos["LineaTitulo"]</h2>
                @if (!_editandoLinea)
                {
                    <span class="alta-tce-linea-acciones">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="EmpezarEdicion" Deshabilitado="Ocupado">@Textos["Editar"]</Boton>
                        <Boton Variante="VarianteBoton.Destructivo" Tamano="TamanoBoton.Pequeno" OnClick="PedirBaja" Deshabilitado="Ocupado">@Textos["DarDeBaja"]</Boton>
                    </span>
                }
            </div>
            <p class="alta-tce-mut">@Textos["LineaTexto"]</p>
            @if (_editandoLinea)
            {
                <p class="alta-tce-nota">@Textos["CorreccionNota"]</p>
                <CamposLinea Pagador="@_pagadorCorr" PagadorChanged="CambiarPagadorCorr"
                             Tramo="@_tramoCorr" TramoChanged="CambiarTramoCorr"
                             Modalidad="@_modalidadCorr" ModalidadChanged="CambiarModalidadCorr"
                             Prefijo="corr" />
                @* Elección obligatoria y sin valor de partida: la pantalla no lee la línea vigente, así que callar la declaración
                   sería revocarla sin decirlo. Guardar no envía el comando mientras no se elija una de las dos. *@
                <fieldset class="alta-tce-radios" data-campo="declara-solo-inbound-corr" role="radiogroup" aria-required="true"
                          aria-describedby="@(ErrorEsDeDeclaracion ? IdErrorDeclaracion : null)"
                          aria-invalid="@(ErrorEsDeDeclaracion ? "true" : null)">
                    <legend>@Textos["CorreccionDeclaracionLeyenda"]<span class="campo-obligatorio" aria-hidden="true">*</span></legend>
                    @* La ayuda va fuera del <label> y se enlaza con aria-describedby: el nombre accesible del radio es solo
                       su título, y la ayuda se anuncia como descripción. *@
                    <div class="alta-tce-opc">
                        <input type="radio" id="alta-tce-corr-declaracion-solo" name="alta-tce-corr-declaracion" value="solo"
                               aria-describedby="alta-tce-corr-declaracion-solo-ayuda"
                               checked="@(_declaraSoloInboundCorr == true)" disabled="@Ocupado"
                               @onchange="@(() => ElegirDeclaracionSoloInboundCorr(true))" />
                        <span><label for="alta-tce-corr-declaracion-solo"><b>@Textos["CorreccionDeclaracionSoloTitulo"]</b></label><span id="alta-tce-corr-declaracion-solo-ayuda">@Textos["CorreccionDeclaracionSoloAyuda"]</span></span>
                    </div>
                    <div class="alta-tce-opc">
                        <input type="radio" id="alta-tce-corr-declaracion-conserva" name="alta-tce-corr-declaracion" value="conserva"
                               aria-describedby="alta-tce-corr-declaracion-conserva-ayuda"
                               checked="@(_declaraSoloInboundCorr == false)" disabled="@Ocupado"
                               @onchange="@(() => ElegirDeclaracionSoloInboundCorr(false))" />
                        <span><label for="alta-tce-corr-declaracion-conserva"><b>@Textos["CorreccionDeclaracionConservaTitulo"]</b></label><span id="alta-tce-corr-declaracion-conserva-ayuda">@Textos["CorreccionDeclaracionConservaAyuda"]</span></span>
                    </div>
                </fieldset>
                <div class="alta-tce-linea-acciones">
                    <Boton Variante="VarianteBoton.Fantasma" OnClick="CancelarEdicion" Deshabilitado="Ocupado">@Textos["Cancelar"]</Boton>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="GuardarCorreccionAsync" Cargando="_enviandoLinea">@Textos["Guardar"]</Boton>
                </div>
            }
            @if (_errorLinea is not null)
            {
                <p class="alta-tce-err" role="alert" id="@(ErrorEsDeDeclaracion ? IdErrorDeclaracion : null)">@_errorLinea</p>
            }
            @if (_exitoLinea is not null)
            {
                <p class="alta-tce-exito" role="status">@_exitoLinea</p>
            }
        </section>

        <DialogoConfirmacion @bind-Visible="_confirmarBaja"
                             Titulo="@Textos["BajaTitulo"]"
                             Mensaje="@MensajeBaja"
                             TextoBotonConfirmar="@Textos["DarDeBaja"]"
                             TextoBotonDescartar="@Textos["Cancelar"]"
                             EnProgreso="_enviandoLinea"
                             OnConfirmar="DarDeBajaAsync" />
    }
</div>
</LimiteDeErrores>
