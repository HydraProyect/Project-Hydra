@page "/integraciones/buzones"
@* Administración de los buzones de Microsoft 365 (maqueta Buzones.dc.html). Sin prerender, como Conexiones: la página carga en
   el ciclo de vida y no persiste su estado. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Domain.Integraciones
@using CaeManager.Web.Features.Integraciones.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosBuzones> Textos


<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["Titulo"] — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"{Textos["Titulo"]} — {Marca.Nombre}")" />

<div class="@ClaseContenedorPagina">
    @* L-55: una pastilla por Empresa gestionada, encima del título como en el lienzo. Solo estrecha: las da el servidor y
       cada una se vuelve a autorizar al pulsarla. *@
    @if (MuestraEmpresas)
    {
        <div class="emps" role="group" aria-label="@Textos["EmpresaGestionada"]" data-testid="empresas-gestionadas">
            @foreach (var empresa in _empresas)
            {
                <PastillaInterruptor Etiqueta="@empresa.TenantNombre" Activa="@(EmpresaVisible?.TenantId == empresa.TenantId)"
                                     ActivaChanged="_ => ElegirEmpresaAsync(empresa)" />
            }
        </div>
    }
    <CabeceraPagina Titulo="@TituloVisible" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>
            @* En solo consulta no se explica el acuse ni se enlaza a Conexiones: los dos hablan del Tenant activo, no de la
               Empresa gestionada consultada. *@
            @if (!SoloConsulta)
            {
                <text>@Textos["Subtitulo"] </text>
            }
            @if (EmpresaRotulada is { } empresaVisible)
            {
                <span data-testid="subtitulo-empresa">@Textos["SubtituloDeEmpresa", empresaVisible.TenantNombre]</span>
            }
            @if (!SoloConsulta)
            {
                <text> @Textos["EnlaceConexiones"] <a href="/integraciones">@Textos["EnlaceConexionesVinculo"]</a>.</text>
            }
        </Descripcion>
        <Acciones>
            @* Secundario a la derecha del título (E31): abre el cajón con la elección de propietario y navega a la misma URL de
               conectar que Conexiones. Sin la URL pública no hay flujo OAuth posible y no se ofrece. Como los demás controles, solo
               lo ve el Administrador; el endpoint de conectar lo vuelve a exigir en el servidor. En solo consulta no está. *@
            @if (ConexionDisponible && !SoloConsulta)
            {
                <AuthorizeView Roles="@RolAdministrador" Context="autorizacionAnadir">
                    <Boton Variante="VarianteBoton.Secundario" OnClick="AbrirCajonAsync" data-testid="anadir-buzon">@Textos["AnadirBuzon"]</Boton>
                </AuthorizeView>
            }
        </Acciones>
    </CabeceraPagina>

    @if (!ConexionDisponible && !SoloConsulta)
    {
        <p class="aviso-conexion-no-disponible" role="status" data-testid="aviso-conexion-no-disponible">@Textos["AvisoConexionNoDisponible"]</p>
    }

    @if (_empresaConsultada is { } consultada)
    {
        @* DN-U: quien es Administrador lee cómo pasar a la Empresa gestionada para cambiar los buzones (la misma comprobación que
           muestra «Añadir buzón» y los controles de cada fila); quien no lo es, quién puede cambiarlos. *@
        <AuthorizeView Roles="@RolAdministrador" Context="autorizacionAviso">
            <Authorized>
                <p class="aviso-consulta-empresa" role="status" data-testid="aviso-consulta-empresa">@Textos["AvisoSoloConsulta", consultada.TenantNombre]</p>
            </Authorized>
            <NotAuthorized>
                <p class="aviso-consulta-empresa" role="status" data-testid="aviso-consulta-empresa">@Textos["AvisoSoloConsultaNoAdministrador", consultada.TenantNombre]</p>
            </NotAuthorized>
        </AuthorizeView>
    }

    @if (_cargando || (SoloConsulta && _cargandoConsulta))
    {
        <EstadoCargando Filas="3" />
    }
    else if (SoloConsulta && _consultaFallida)
    {
        <p class="texto-error" role="alert" data-testid="aviso-buzones-empresa-no-cargados">@Textos["AvisoCargaEmpresaFallida", _empresaConsultada!.TenantNombre]</p>
    }
    else if (!SoloConsulta && _cargaFallida)
    {
        <p class="texto-error" role="alert" data-testid="aviso-buzones-no-cargados">@Textos["AvisoCargaFallida"]</p>
    }
    else if (_conexiones.Count == 0)
    {
        <EstadoVacio Titulo="@Textos["VacioTitulo"]" Descripcion="@(SoloConsulta ? null : Textos["VacioTexto"].Value)" />
    }
    else
    {
        <div class="resumen-buzones" role="group" aria-label="@Textos["Resumen"]">
            <div><b data-testid="total-buzones">@_conexiones.Count</b><span>@Textos["ResumenBuzones"]</span></div>
        </div>

        <TarjetaListado>
            <Contenido>
                <table class="tabla-datos tabla-buzones">
                    <thead>
                        <tr>
                            <th scope="col">@Textos["ColBuzon"]</th>
                            <th scope="col">@Textos["ColTipo"]</th>
                            <th scope="col">@Textos["ColEnrutaA"]</th>
                            <th scope="col">@Textos["ColEstado"]</th>
                            <th scope="col">@Textos["ColUltimoCorreo"]</th>
                            <th scope="col">@Textos["ColResponsable"]</th>
                            <th scope="col">@Textos["ColAbiertas"]</th>
                            <th scope="col">@Textos["ColAcuse"]</th>
                            @* Lienzo Pulida-Buzones: la columna de acciones no tiene rótulo visible, solo para el lector de pantalla. *@
                            <th scope="col"><span class="sr-solo">@Textos["ColAcciones"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conexion in _conexiones)
                        {
                            <tr data-testid="fila-buzon">
                                <td>
                                    <span class="nombre-buzon">@conexion.Nombre</span>
                                    <span class="direccion-buzon">@conexion.BuzonEmail</span>
                                </td>
                                <td>@DescribirTipo(conexion)</td>
                                <td>@DescribirEnruta(conexion)</td>
                                <td>
                                    @* E35 (parcial): punto de color + texto, con los tokens de éxito, peligro y neutro. *@
                                    <span class="@($"estado-buzon estado-{ClaseEstado(conexion.Estado)}")" data-testid="estado-buzon">
                                        <span class="punto-estado" aria-hidden="true"></span>@ObtenerEtiquetaEstado(conexion.Estado)
                                    </span>
                                </td>
                                <td data-testid="ultimo-correo">@DescribirUltimoCorreo(conexion.Id)</td>
                                <td>
                                    @if (conexion.GestorPropietarioId is { } propietarioId)
                                    {
                                        @Textos["ResponsablePersonal", NombreDe(propietarioId)]
                                    }
                                    else if (SoloConsulta)
                                    {
                                        @NombreResponsable(conexion)
                                    }
                                    else
                                    {
                                        <AuthorizeView Roles="@RolAdministrador" Context="autorizacionResponsable">
                                            <Authorized>
                                                @{ var claves = new ClavesDeHermanos(); }
                                                <select class="selector-responsable" aria-label="@Textos["AriaResponsable", conexion.Nombre]"
                                                        data-testid="selector-responsable"
                                                        @key="claves.De((conexion.Id, _versionSelectores))"
                                                        disabled="@(_procesandoId is not null)"
                                                        @onchange="e => CambiarResponsableAsync(conexion, e.Value?.ToString())">
                                                    <option value="" selected="@(conexion.ResponsableUsuarioId is null)">@Textos["SinResponsable"]</option>
                                                    @foreach (var opcion in OpcionesDeResponsable(conexion))
                                                    {
                                                        <option value="@opcion.Id" selected="@(conexion.ResponsableUsuarioId == opcion.Id)">@opcion.NombreCompleto</option>
                                                    }
                                                </select>
                                            </Authorized>
                                            <NotAuthorized>
                                                @NombreResponsable(conexion)
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    }
                                </td>
                                <td class="celda-cifras" data-testid="abiertas-buzon">@DescribirAbiertas(conexion.Id)</td>
                                <td>
                                    @if (conexion.GestorPropietarioId is not null)
                                    {
                                        <span class="texto-secundario" data-testid="acuse-no-aplica">@Textos["AcuseNoAplica"]</span>
                                    }
                                    else if (SoloConsulta)
                                    {
                                        <Badge Tono="@(conexion.AcuseAutomaticoActivo ? TonoBadge.Exito : TonoBadge.Neutro)"><span data-testid="estado-acuse">@EtiquetaAcuse(conexion)</span></Badge>
                                    }
                                    else
                                    {
                                        <AuthorizeView Roles="@RolAdministrador" Context="autorizacionAcuse">
                                            <Authorized>
                                                <span class="control-acuse">
                                                    <button type="button" role="switch" data-testid="interruptor-acuse"
                                                            class="@($"interruptor {(conexion.AcuseAutomaticoActivo ? "interruptor-activo" : "")}")"
                                                            aria-checked="@(conexion.AcuseAutomaticoActivo ? "true" : "false")"
                                                            aria-label="@Textos["AriaAcuse", conexion.Nombre]"
                                                            disabled="@(_procesandoId is not null)"
                                                            @onclick="() => AlternarAcuseAsync(conexion)">
                                                        <span class="interruptor-pomo"></span>
                                                    </button>
                                                    <span data-testid="estado-acuse">@EtiquetaAcuse(conexion)</span>
                                                </span>
                                            </Authorized>
                                            <NotAuthorized>
                                                <Badge Tono="@(conexion.AcuseAutomaticoActivo ? TonoBadge.Exito : TonoBadge.Neutro)"><span data-testid="estado-acuse">@EtiquetaAcuse(conexion)</span></Badge>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    }
                                </td>
                                <td>
                                    @* L-57: «Comprobar acceso» en la fila, salvo en la que ya ofrece «Reconectar» en su franja de error (en el
                                       lienzo, un buzón con error solo lleva «Reconectar buzón»). «Pausar lectura» y «Quitar buzón…» no están
                                       (B4 y DN-I). *@
                                    @if (!SoloConsulta && !MuestraFranjaError(conexion))
                                    {
                                        <AuthorizeView Roles="@RolAdministrador" Context="autorizacionComprobar">
                                            <div class="acciones-buzon">
                                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                                       Deshabilitado="@(_procesandoId is not null)" Cargando="@(_comprobandoId == conexion.Id)"
                                                       aria-label="@Textos["AriaComprobarAcceso", conexion.Nombre]"
                                                       OnClick="() => ComprobarAccesoAsync(conexion)" data-testid="comprobar-acceso-buzon">@Textos["ComprobarAcceso"]</Boton>
                                            </div>
                                        </AuthorizeView>
                                    }
                                </td>
                            </tr>
                            @if (MuestraFranjaError(conexion))
                            {
                                @* E32 (parcial): franja con el último error de ese buzón y «Reconectar», que es la acción de «Reactivar». *@
                                <tr class="fila-franja-error">
                                    <td colspan="9">
                                        <div class="franja-error" role="alert" data-testid="franja-error-buzon">
                                            <span class="franja-error-texto">@Textos["FranjaErrorBuzon", conexion.BuzonEmail]: @conexion.UltimoError</span>
                                            @if (!SoloConsulta)
                                            {
                                                <AuthorizeView Roles="@RolAdministrador" Context="autorizacionReconectar">
                                                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                           Deshabilitado="@(_procesandoId is not null)"
                                                           OnClick="() => ReconectarAsync(conexion)" data-testid="reconectar-buzon">@Textos["Reconectar"]</Boton>
                                                </AuthorizeView>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </Contenido>
        </TarjetaListado>
    }
    <p class="texto-descriptivo pie-buzones">@Textos["PieBuzones"]</p>
</div>

<Modal Visible="_acuseAActivar is not null" VisibleChanged="(bool visible) => CerrarModalAcuse(visible)"
       Titulo="@Textos["ModalAcuseTitulo"]" Subtitulo="@_acuseAActivar?.BuzonEmail"
       CerrarAlHacerClicFuera="!_guardandoAcuse" Bloqueante="_guardandoAcuse">
    <ChildContent>
        <p>@Textos["ModalAcuseIntro"]</p>
        <div class="reglas-acuse" role="group" aria-label="@Textos["ModalAcuseReglasTitulo"]">
            <b>@Textos["ModalAcuseReglasTitulo"]</b>
            <ul>
                <li>@Textos["ModalAcuseRegla1"]</li>
                <li>@Textos["ModalAcuseRegla2"]</li>
                <li>@Textos["ModalAcuseRegla3"]</li>
                <li>@Textos["ModalAcuseRegla4"]</li>
            </ul>
        </div>
        @if (TextoDelAcuseEsBorrador)
        {
            <p class="texto-aviso-verificacion" data-testid="aviso-acuse-borrador">@Textos["ModalAcuseBorrador"]</p>
        }
        <p class="texto-descriptivo" role="status">@Textos["ModalAcuseAviso"]</p>
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoAcuse" OnClick="() => CerrarModalAcuse(false)">@Textos["ModalAcuseCancelar"]</Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_guardandoAcuse" OnClick="ConfirmarActivacionAcuseAsync" data-testid="guardar-acuse">@Textos["ModalAcuseGuardar"]</Boton>
    </Pie>
</Modal>

@* Cajón «Añadir buzón» (E31): los mismos campos y reglas que Conexiones. «Continuar en Microsoft» navega a la URL de conectar
   con página completa; el consentimiento, el nonce y los permisos son del endpoint. El guardián pregunta por una elección
   hecha y no enviada, y deja de hacerlo al pulsar «Continuar en Microsoft» (ContinuarAMicrosoftAsync). *@
<DrawerFormulario Visible="_cajonVisible" VisibleChanged="CerrarCajon" Titulo="@Textos["CajonTitulo"]"
                  HayCambios="HayEleccionSinEnviar" Cargando="_cargandoCajon" MensajeError="@_errorCajon"
                  OnGuardar="ContinuarAMicrosoftAsync"
                  TextoGuardar="@Textos["CajonContinuar"]" TextoCancelar="@Textos["CajonCancelar"]">
    <p class="texto-descriptivo">@Textos["CajonIntro"]</p>
    <CaeManager.Web.Features.Integraciones.Components.CamposPropietarioBuzon Seleccion="_propietario" Empresas="_opcionesCajon.Empresas" Gestores="_opcionesCajon.Gestores" AlCambiar="RepintarCajon" />
    <p class="texto-descriptivo">@Textos["CajonAyudaCompartido"]</p>
</DrawerFormulario>
</LimiteDeErrores>
