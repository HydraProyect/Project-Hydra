@page "/integraciones"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Domain.Integraciones

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Conexiones de integración — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    <CabeceraPagina Titulo="Conexiones de integración" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>
            Buzones de Microsoft 365 conectados para la bandeja de correo compartida (Comunicaciones).
            Cada conexión pertenece a una empresa sin rol CAE concreta, a la organización propia si se deja en blanco
            o al buzón personal de un Gestor CAE.
            Para investigar una conexión en concreto —carpetas, mensajes en Graph que aún no llegaron por
            webhook—, usa el <a href="/comunicaciones/buzon">explorador técnico del buzón (diagnóstico)</a>.
        </Descripcion>
    </CabeceraPagina>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    <section class="seccion-conexiones" aria-labelledby="titulo-buzones-microsoft365"
              @onclick="() => ActivarTabla(TablaConexiones.Buzones)" @onfocusin="() => ActivarTabla(TablaConexiones.Buzones)">
    <h2 id="titulo-buzones-microsoft365" class="titulo-bloque-conexiones">Buzones de Microsoft 365</h2>

    <div class="acciones-conexion-buzon">
        <CampoSelect Etiqueta="Empresa sin rol CAE (opcional)" Valor="@(_clienteSeleccionadoId?.ToString() ?? string.Empty)"
                     ValorChanged="SeleccionarCliente" Deshabilitado="@(_gestorPropietarioSeleccionadoId is not null)">
            <option value="">Buzón de la organización propia</option>
            @foreach (var cliente in _clientes)
            {
                <option value="@cliente.Id">@cliente.RazonSocial</option>
            }
        </CampoSelect>

        <CampoSelect Etiqueta="Buzón personal de un Gestor CAE (opcional)"
                     Valor="@(_gestorPropietarioSeleccionadoId?.ToString() ?? string.Empty)"
                     ValorChanged="SeleccionarGestorPropietario" Deshabilitado="@(_clienteSeleccionadoId is not null)">
            <option value="">—</option>
            @foreach (var gestor in _gestores)
            {
                <option value="@gestor.Id">@gestor.NombreCompleto</option>
            }
        </CampoSelect>

        <a class="enlace-conectar-microsoft" href="@UrlConectar">Conectar buzón de Microsoft 365 <span aria-hidden="true">↗</span></a>
    </div>

    @if (_cargando)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_conexiones.Count == 0)
    {
        <EstadoVacio Titulo="Sin conexiones" Descripcion="Todavía no hay ningún buzón de Microsoft 365 conectado." />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Buzón</th>
                    <th>Empresa sin rol CAE</th>
                    <th>Estado</th>
                    <th>Conectada</th>
                    <th><span class="solo-lector">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var conexion in _conexiones)
                {
                    <tr class="@ClaseFilaBuzon(conexion.Id)">
                        <td>@conexion.BuzonEmail</td>
                        <td>@DescribirPropietario(conexion)</td>
                        <td>
                            <Badge Tono="@ObtenerTonoEstado(conexion.Estado)">@ObtenerEtiquetaEstado(conexion.Estado)</Badge>
                            @if (conexion.Estado == EstadoConexionIntegracion.ConError && !string.IsNullOrWhiteSpace(conexion.UltimoError))
                            {
                                <span class="texto-error">@conexion.UltimoError</span>
                            }
                        </td>
                        <td>@conexion.FechaConectadaUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="acciones-conexion">
                            @if (conexion.Estado == EstadoConexionIntegracion.ConError)
                            {
                                <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Secundario"
                                       Deshabilitado="@(_procesandoId is not null)" OnClick="() => ReactivarAsync(conexion)" Cargando="@(_procesandoId == conexion.Id)">
                                    Reactivar
                                </Boton>
                            }
                            @if (conexion.Estado != EstadoConexionIntegracion.Deshabilitada)
                            {
                                <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Destructivo"
                                       Deshabilitado="@(_procesandoId is not null)" OnClick="() => AbrirDesconexion(conexion)" Cargando="@(_procesandoId == conexion.Id)">
                                    Desconectar
                                </Boton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </section>

    <section class="seccion-conexiones seccion-lineas-whatsapp" aria-labelledby="titulo-lineas-whatsapp"
              @onclick="() => ActivarTabla(TablaConexiones.Lineas)" @onfocusin="() => ActivarTabla(TablaConexiones.Lineas)">
    <h2 id="titulo-lineas-whatsapp" class="titulo-bloque-conexiones">Líneas de WhatsApp</h2>

    <p class="texto-descriptivo">
        Líneas oficiales de WhatsApp Cloud API (Meta). Cada línea enruta sus conversaciones nuevas a su Gestor CAE
        dueño (modo Gestor CAE fijo) o las reparte equitativamente entre un grupo (modo pool inbound).
    </p>

    <div class="acciones-lineas-whatsapp">
        <Boton Variante="VarianteBoton.Primario" Deshabilitado="_guardandoLinea" OnClick="AbrirAltaLinea">Nueva línea WhatsApp</Boton>
    </div>

    @if (_cargando)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_lineas.Count == 0)
    {
        <EstadoVacio Titulo="Sin líneas" Descripcion="Todavía no hay ninguna línea de WhatsApp conectada." />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Línea</th>
                    <th>Phone Number ID</th>
                    <th>Empresa sin rol CAE</th>
                    <th>Asignación</th>
                    <th>Estado</th>
                    <th><span class="solo-lector">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in _lineas)
                {
                    <tr class="@ClaseFilaLinea(linea.LineaId)">
                        <td>@linea.Nombre<br /><span class="texto-secundario">@linea.NumeroTelefono</span></td>
                        <td>@linea.PhoneNumberId</td>
                        <td>@(linea.ClienteNombre ?? "Organización propia")</td>
                        <td>@DescribirAsignacion(linea)</td>
                        <td>
                            <Badge Tono="@ObtenerTonoEstado(linea.Estado)">@ObtenerEtiquetaEstado(linea.Estado)</Badge>
                            @if (linea.Estado == EstadoConexionIntegracion.ConError && !string.IsNullOrWhiteSpace(linea.UltimoError))
                            {
                                <span class="texto-error">@linea.UltimoError</span>
                            }
                        </td>
                        <td>
                            <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoLinea" OnClick="() => AbrirEdicionLinea(linea)">
                                Editar
                            </Boton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </section>
</div>

<Modal Visible="_conexionADesconectar is not null" VisibleChanged="(bool visible) => CerrarModalDesconexion(visible)"
       Titulo="Desconectar el buzón" CerrarAlHacerClicFuera="!_desconectando" Bloqueante="_desconectando">
    <ChildContent>
        @if (_conexionADesconectar is not null)
        {
            <p>
                <strong>@_conexionADesconectar.BuzonEmail</strong> dejará de recibir y enviar correo desde TALVEG.
                Los hilos ya ingeridos se conservan; solo se detiene la ingesta de nuevos correos.
            </p>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_desconectando" OnClick="() => CerrarModalDesconexion()">Cancelar</Boton>
        <Boton Variante="VarianteBoton.Destructivo" Cargando="_desconectando" OnClick="DesconectarAsync">Desconectar</Boton>
    </Pie>
</Modal>

<Modal Visible="_modalLineaVisible" VisibleChanged="(bool visible) => CerrarModalLinea(visible)"
       Titulo="@(_lineaEnEdicion is null ? "Nueva línea WhatsApp" : "Editar línea WhatsApp")"
       CerrarAlHacerClicFuera="!_guardandoLinea" Bloqueante="_guardandoLinea">
    <ChildContent>
        @if (_lineaEnEdicion is null)
        {
            <CampoTexto Etiqueta="Nombre" Valor="@_lineaNombre" ValorChanged="v => _lineaNombre = v"
                        Placeholder="Línea comercial Madrid" />
            <CampoTexto Etiqueta="Número de teléfono (E.164)" Valor="@_lineaNumero" ValorChanged="v => _lineaNumero = v"
                        Placeholder="+34686543364" />
            <CampoTexto Etiqueta="Phone Number ID (Meta)" Valor="@_lineaPhoneNumberId" ValorChanged="v => _lineaPhoneNumberId = v" />
            <CampoTexto Etiqueta="WABA ID (Meta)" Valor="@_lineaWabaId" ValorChanged="v => _lineaWabaId = v" />

            <CampoSelect Etiqueta="Empresa sin rol CAE (opcional)" Valor="@(_lineaClienteId?.ToString() ?? string.Empty)"
                         ValorChanged="v => _lineaClienteId = Guid.TryParse(v, out var id) ? id : null">
                <option value="">Organización propia</option>
                @foreach (var cliente in _clientes)
                {
                    <option value="@cliente.Id">@cliente.RazonSocial</option>
                }
            </CampoSelect>
        }

        <CampoTexto Etiqueta="@(_lineaEnEdicion is null ? "Token de acceso (System User)" : "Nuevo token de acceso (vacío = conservar el actual)")"
                    Type="password" Valor="@_lineaToken" ValorChanged="v => _lineaToken = v" />

        <CampoSelect Etiqueta="Modo de asignación" Valor="@_lineaModo.ToString()"
                     ValorChanged="v => _lineaModo = Enum.Parse<ModoAsignacionLinea>(v)">
            <option value="@ModoAsignacionLinea.GestorFijo">Gestor CAE fijo (línea de una persona)</option>
            <option value="@ModoAsignacionLinea.PoolInbound">Pool inbound (reparto equitativo)</option>
        </CampoSelect>

        @if (_lineaModo == ModoAsignacionLinea.GestorFijo)
        {
            <CampoSelect Etiqueta="Gestor CAE dueño" Valor="@(_lineaComercialId?.ToString() ?? string.Empty)"
                         ValorChanged="v => _lineaComercialId = Guid.TryParse(v, out var id) ? id : null">
                <option value="">Elegir Gestor CAE…</option>
                @foreach (var gestor in _gestores)
                {
                    <option value="@gestor.Id">@gestor.NombreCompleto</option>
                }
            </CampoSelect>
        }
        else
        {
            <div class="campo">
                <label>Gestores CAE del pool</label>
                @foreach (var gestor in _gestores)
                {
                    <label class="opcion-pool-linea">
                        <input type="checkbox" checked="@_lineaMiembros.Contains(gestor.Id)"
                               @onchange="e => AlternarMiembroPool(gestor.Id, e.Value is true)" />
                        @gestor.NombreCompleto
                    </label>
                }
            </div>
        }

        <CampoTextarea Etiqueta="Mensaje automático de triage (vacío = desactivado)" Filas="3"
                       Valor="@_lineaMensajeAutoTriage" ValorChanged="v => _lineaMensajeAutoTriage = v"
                       Placeholder="¡Hola! Para atenderte mejor, dinos de qué empresa nos escribes y en qué podemos ayudarte." />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoLinea" OnClick="() => CerrarModalLinea()">Cancelar</Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_guardandoLinea" OnClick="GuardarLineaAsync">
            @(_lineaEnEdicion is null ? "Crear línea" : "Guardar cambios")
        </Boton>
    </Pie>
</Modal>
