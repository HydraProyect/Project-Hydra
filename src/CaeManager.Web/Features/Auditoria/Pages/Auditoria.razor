@page "/auditoria"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Auditoría — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    <div class="cabecera-pagina">
        @TituloPaginaIntegrable("Auditoría")
        <div class="acciones-cabecera">
            <a class="enlace-exportar" href="@EnlaceExportar"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Exportar a Excel</a>
        </div>
    </div>

    <div class="barra-filtros">
        <CampoSelect Etiqueta="Tipo de entidad" Valor="@(_filtroEntidadTipo ?? string.Empty)" ValorChanged="FiltrarPorEntidadAsync">
            <option value="">Todas</option>
            @foreach (var tipo in TiposEntidad)
            {
                <option value="@tipo">@tipo</option>
            }
        </CampoSelect>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar la auditoría" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="8" />
    }
    else if (SinRegistros && HayFiltrosActivos)
    {
        @* Distinto de "no hay registros de auditoría", y llevan a conclusiones
           opuestas: decirle a quien acaba de filtrar por "Documento" que nunca
           se modificó nada le hace creer que la auditoría no registra, cuando
           lo único cierto es que no registra ESE tipo de entidad.

           La copia no afirma que HAYA registros: el filtrado es de servidor y
           la consulta solo devuelve el total ya filtrado, así que esta página
           no sabe cuántos hay sin filtro. *@
        <EstadoVacio NombreIcono="vacio" Titulo="Ningún registro con este filtro"
                     Descripcion="Ninguna modificación registrada corresponde al tipo de entidad seleccionado.">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar el filtro</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (SinRegistros)
    {
        <EstadoVacio Titulo="No hay registros de auditoría" Descripcion="Todavía no se ha modificado ninguna entidad." />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Entidad</th>
                    <th>Acción</th>
                    <th>Usuario</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registro in Resultado.Elementos)
                {
                    <tr>
                        <td>@registro.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@registro.EntidadTipo</td>
                        <td>
                            <Badge Tono="@(registro.Accion switch {
                                "Creado" => TonoBadge.Exito,
                                "Eliminado" => TonoBadge.Peligro,
                                _ => TonoBadge.Advertencia
                            })">@registro.Accion</Badge>
                        </td>
                        <td>@NombreUsuario(registro.UsuarioId)</td>
                        <td>
                            @if (registro.TieneArchivoAnterior)
                            {
                                <a href="/auditoria/@registro.Id/archivo-anterior" target="_blank">Ver archivo anterior</a>
                            }
                            else if (registro.PuedeRestaurar)
                            {
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                       Cargando="EstaRestaurando(registro)" OnClick="() => RestaurarAsync(registro)">
                                    Restaurar
                                </Boton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <PaginadorSimple PaginaActual="Resultado.Pagina" TotalPaginas="Resultado.TotalPaginas"
                          TotalElementos="Resultado.TotalElementos" Etiqueta="registro(s)"
                          PaginaActualChanged="IrAPaginaAsync" />
    }
</div>
