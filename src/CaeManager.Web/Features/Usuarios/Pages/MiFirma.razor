@page "/mi-firma"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Application.Documentos.Commands.GuardarFirmaGuardadaUsuario
@using CaeManager.Application.Documentos.Queries.ObtenerFirmaGuardadaUsuario
@using Microsoft.AspNetCore.Authorization
@using MediatR
@inject IMediator Mediator
@inject ToastService Toasts
@inject IJSRuntime JSRuntime

<PageTitle>Mi firma — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Mi firma</h1>
    </div>

    <p class="descripcion-roles">
        Esta es la firma que se ofrecerá por defecto al firmar documentos en campo. Dibújala, escribe tu
        nombre o sube una foto de tu firma en papel — se guarda una sola, la última que confirmes
        reemplaza a la anterior.
    </p>

    @if (_cargando)
    {
        <EstadoCargando Filas="2" />
    }
    else
    {
        @if (_firmaActual is not null)
        {
            <div class="workspace-grupo-campos">
                <CampoInfo Etiqueta="Firma guardada actualmente">
                    <img src="/mi-firma/archivo" alt="Firma guardada" class="firma-guardada-vista-previa" />
                </CampoInfo>
                <CampoInfo Etiqueta="Actualizada" Valor="@_firmaActual.ActualizadaEnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" />
            </div>
        }

        <h3 class="workspace-subtitulo">Dibujar o escribir</h3>
        <div class="workspace-acciones-edicion">
            <Boton Variante="@(_escribirNombre ? VarianteBoton.Secundario : VarianteBoton.Primario)" Tamano="TamanoBoton.Pequeno" OnClick="() => CambiarModoEntradaAsync(escribir: false)">
                Dibujar
            </Boton>
            <Boton Variante="@(_escribirNombre ? VarianteBoton.Primario : VarianteBoton.Secundario)" Tamano="TamanoBoton.Pequeno" OnClick="() => CambiarModoEntradaAsync(escribir: true)">
                Escribir mi nombre
            </Boton>
        </div>

        @if (_escribirNombre)
        {
            <CampoTexto Etiqueta="Tu nombre" Valor="@_nombreEscrito" ValorChanged="AlCambiarNombreEscritoAsync" Placeholder="Escribe tu nombre tal como quieres que aparezca" class="firma-escrita-nombre" />
        }

        <canvas id="@_idCanvas" class="firma-en-campo-lienzo" width="500" height="200"></canvas>
        <div class="workspace-acciones-edicion">
            <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarLienzoAsync" Deshabilitado="_guardando">Borrar</Boton>
            <Boton OnClick="GuardarDibujadaAsync" Cargando="_guardando" Deshabilitado="@(!_trazoIniciado || _guardando)">Guardar como mi firma</Boton>
        </div>

        <h3 class="workspace-subtitulo">O sube una foto</h3>
        <ZonaSoltarArchivo Titulo="Sube una foto de tu firma" FormatosTexto="JPG o PNG, máx. 5 MB" Accept="image/*"
                           Cargando="_guardando" OnChange="SubirArchivoAsync" />
    }
</div>
