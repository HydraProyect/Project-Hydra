@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae}")]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Infrastructure.Identity

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Usuarios — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    @* Gen 2: la cabecera es la primitiva, no un div a mano. Integrada resuelve
       h1/h2 igual que TituloPaginaIntegrable, y las acciones entran por
       .acciones-cabecera, que es lo que el mockup nombra. *@
    <CabeceraPagina Titulo="Usuarios" Integrada="IntegradaEnConfiguracion">
        <Acciones>
            <Boton OnClick="AbrirCrear">+ Nuevo usuario</Boton>
        </Acciones>
    </CabeceraPagina>

    @* Mismo sitio y misma composición que las demás listas (list-page.css
       ".barra-filtros"): buscador a la izquierda, filtros a su derecha, nunca
       escondidos tras un menú. Se filtra en memoria — ver UsuariosFiltrados.

       El mockup Gen 2 no los pinta, y aun así se quedan: omitir un control en
       un mockup no es pedir que se retire del producto, y sin ellos una
       organización con cuarenta cuentas solo puede buscar a ojo. Ver también
       el estado vacío por filtro, que existe justamente por esta barra.

       Solo se pinta cuando hay algo que filtrar: sobre el error de carga
       mentiría (no hay lista sobre la que actuar) y sobre una organización
       recién creada serían tres controles que no pueden hacer nada. A
       diferencia de Empresas, aquí filtrar no es una consulta al servidor
       que pueda devolver cero de por sí. *@
    @if (!_errorCarga && !_cargando && _usuarios.Count > 0)
    {
        <div class="barra-filtros">
            <CampoTexto Placeholder="Buscar por nombre o correo…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
            <FiltroEstado Etiqueta="Rol" Valor="@_rolFiltro" ValorChanged="FiltrarPorRolAsync"
                          Opciones="OpcionesRol" />
            <FiltroEstado Etiqueta="Estado" Valor="@_activacionFiltro" ValorChanged="FiltrarPorActivacionAsync"
                          Opciones="OpcionesActivacion" />
        </div>
    }

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los usuarios" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="6" />
    }
    else if (_usuarios.Count == 0)
    {
        @* Sin acción: el alta ya está en la cabecera, a dos centímetros. *@
        <EstadoVacio Titulo="Aún no hay usuarios" Descripcion="Crea el primero para dar acceso al sistema." />
    }
    else if (UsuariosFiltrados.Count == 0)
    {
        @* Distinto de "aún no hay usuarios": los hay, pero ninguno casa con lo
           filtrado. Decirle "crea el primero" a quien tiene cuarenta y ha
           tecleado mal un apellido es mandarlo a duplicar una cuenta. *@
        <EstadoVacio Titulo="Ningún usuario coincide"
                     Descripcion="Prueba con otro texto, o quita los filtros de rol y estado.">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar filtros</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th scope="col">Correo</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Alcance</th>
                    <th scope="col">Estado</th>
                    @* La columna de acciones no lleva rótulo visible, pero sí
                       nombre: una cabecera vacía deja a quien navega con
                       lector de pantalla sin saber de qué columna es la celda
                       en la que está. *@
                    <th scope="col"><span class="encabezado-solo-lectores">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in UsuariosDePagina)
                {
                    <tr>
                        <td>
                            @usuario.Email
                            @if (usuario.Id == _usuarioActualId)
                            {
                                @* Quién eres tú en esta lista. Es la fila en la
                                   que ni puedes desactivarte ni tocar tu propio
                                   permiso sobre documentos sensibles, así que
                                   conviene que se distinga antes de intentarlo. *@
                                <span class="marca-eres-tu">tú</span>
                            }
                        </td>
                        <td>@usuario.NombreCompleto</td>
                        <td>
                            @Roles.NombreVisible(usuario.Rol)
                            @if (usuario.EsOperadorDelegado)
                            {
                                @* El rol mostrado es el de su asignación en esta organización,
                                   no el que tiene en la suya. Sin esta marca la fila es
                                   indistinguible de la de un usuario propio.

                                   Tono neutro, no Info: los tonos de color están
                                   reservados al semáforo documental (ver TonoBadge),
                                   y "Delegado" no es un estado bueno ni malo. *@
                                <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno"
                                       title="Opera esta organización desde otra mediante una delegación; el rol mostrado es el de su asignación aquí, no el de su organización de origen.">
                                    Delegado
                                </Badge>
                            }
                        </td>
                        @* Qué ve esta cuenta. Sin esta columna, un Gestor CAE
                           sin cartera tiene una fila idéntica a la de uno con
                           cartera, y el "no veo nada" que reporta no tiene
                           respuesta en ninguna pantalla. El mockup Gen 2 no la
                           dibuja; se conserva porque responde una pregunta que
                           no se responde en ningún otro sitio del producto. *@
                        <td title="@usuario.Alcance.Explicacion">
                            @if (usuario.Alcance.EsAviso)
                            {
                                <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">
                                    @usuario.Alcance.Texto
                                </Badge>
                            }
                            else
                            {
                                @usuario.Alcance.Texto
                            }
                        </td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <Badge Tono="TonoBadge.Exito">Activo</Badge>
                            }
                            else
                            {
                                <Badge Tono="TonoBadge.Peligro">Desactivado</Badge>
                            }
                        </td>
                        <td class="columna-accion">
                            @* Las dos acciones se agrupan tras "⋯" (H2 del design system):
                               antes ocupaban dos botones fantasma en línea que competían
                               visualmente y estiraban la fila. *@
                            <MenuAcciones>
                                <ItemMenuAccion OnClick="() => AbrirEditarAsync(usuario.Id)">
                                    Editar
                                </ItemMenuAccion>
                                @* Destructivo solo al desactivar: reactivar
                                   devuelve un acceso, no lo quita. *@
                                <ItemMenuAccion Destructivo="usuario.Activo"
                                                OnClick="() => CambiarActivacionAsync(usuario)">
                                    @(usuario.Activo ? "Desactivar" : "Reactivar")
                                </ItemMenuAccion>
                            </MenuAcciones>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="UsuariosFiltrados.Count"
                          Etiqueta="usuario(s)" PaginaActualChanged="IrAPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? "Nuevo usuario" : "Editar usuario")" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="Correo" Type="email" Placeholder="@("nombre@empresa.es")" Valor="@_email" ValorChanged="v => _email = v" Deshabilitado="@(_editandoId is not null)" />
        @if (_editandoId is not null)
        {
            <p class="texto-ayuda-campo">El correo identifica la cuenta y no se puede cambiar.</p>
        }

        <CampoTexto Etiqueta="Nombre completo" Valor="@_nombreCompleto" ValorChanged="v => _nombreCompleto = v" />
        @* Sin campo de contraseña: la cuenta nace sin ninguna y el propio
           usuario la establece desde su enlace de activación. Nadie más llega
           a conocerla — antes la escribía aquí el Administrador y viajaba en
           claro dentro del correo de bienvenida. *@
        <CampoSelect Etiqueta="Rol" Valor="@_rol" ValorChanged="CambiarRolAsync">
            @foreach (var rol in Roles.Todos)
            {
                <option value="@rol">@Roles.NombreVisible(rol)</option>
            }
        </CampoSelect>

        @if (_rol == Roles.Administrador && _usuarioActualEsAdministrador && _editandoId != _usuarioActualId)
        {
            @* DEC-36 (REC-099): permiso específico, aparte del rol — nadie lo
               hereda solo por ser Administrador, y solo otro Administrador
               (no DireccionCae) puede concederlo o revocarlo. "Otro" excluye
               la propia fila: el interruptor ni siquiera se ofrece editando
               tu propia cuenta (ver EsAutogestionDelPermisoSensible, que es
               quien de verdad lo impide si esto se saltara).

               Las dos frases del texto de ayuda son veraces EN ESTE BLOQUE, y
               solo aquí: la retirada automática al dejar de ser Administrador
               la ejecuta EditarUsuarioAsync dentro del mismo "si quien edita
               es Administrador" que gobierna esta condición. Si alguna vez
               este bloque se muestra a un DireccionCae, la segunda frase deja
               de ser cierta y hay que reescribirla. *@
            <div class="bloque-permiso-sensible">
                <label class="campo-checkbox" title="Permite consultar quién ha abierto o descargado documentos sensibles (reconocimientos médicos y similares)">
                    <input type="checkbox" checked="@_permisoConsultarAccesoDocumentosSensibles" @onchange="e => _permisoConsultarAccesoDocumentosSensibles = e.Value is bool activo && activo" />
                    Puede consultar el rastro de acceso a documentos sensibles
                </label>
                <p class="texto-permiso-sensible">
                    Permiso aparte del rol: solo otro Administrador puede concederlo o revocarlo.
                    Si el rol deja de ser Administrador, se retira automáticamente.
                </p>
            </div>
        }

        @if (_rol == Roles.GestorCae)
        {
            <CampoSelect Etiqueta="Coordinador CAE asignado (opcional)" Valor="@_coordinadorUsuarioId" ValorChanged="v => _coordinadorUsuarioId = v">
                <option value="">Sin asignar por ahora</option>
                @foreach (var coordinador in _coordinadoresDisponibles)
                {
                    <option value="@coordinador.Id">@coordinador.NombreCompleto (@coordinador.Email)</option>
                }
            </CampoSelect>
            <p class="texto-ayuda-campo">Sin coordinador asignado, solo Administrador y Dirección CAE ven su cartera.</p>
        }

        @if (_rol == Roles.Cliente)
        {
            @* "Empresa", no "cliente": lo que se busca es una Empresa del
               catálogo (BuscarEmpresaPorCifQuery) y lo que se vincula es esa
               empresa a la cuenta de portal. "Cliente" a secas aquí nombraría
               a la vez el rol de la cuenta y la contraparte buscada. *@
            <CampoTexto Etiqueta="CIF de la empresa a vincular" Placeholder="A00000000" Valor="@_clienteCif" ValorChanged="BuscarClientePorCifAsync" />
            @if (_buscandoCliente)
            {
                <p class="pista-documento pista-documento-info">Buscando…</p>
            }
            else if (_errorBusquedaCif)
            {
                @* No es lo mismo que "no existe": mandar a crear una empresa
                   que sí está en el catálogo la duplicaría. *@
                <p class="pista-documento pista-documento-error">No pudimos comprobar este CIF. Vuelve a intentarlo.</p>
            }
            else if (!string.IsNullOrWhiteSpace(_clienteCif))
            {
                @if (_clienteEncontrado is not null)
                {
                    <p class="pista-documento pista-documento-exito">✓ @_clienteEncontrado.RazonSocial</p>
                }
                else
                {
                    <p class="pista-documento pista-documento-error">✗ No encontramos ninguna empresa con este CIF — créala primero en Empresas.</p>
                }
            }
            else
            {
                <p class="texto-ayuda-campo">Se comprueba contra el catálogo de Empresas al dejar de escribir.</p>
            }
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" OnClick="() => CerrarDrawerAsync(false)">Cancelar</Boton>
        @* Deshabilitado mientras viaja la comprobación del CIF: guardar en ese
           instante decidiría con un resultado que todavía no ha llegado.
           Cargando ya impide el doble clic en el cliente; GuardarAsync lo
           impide además en el servidor, que es donde cuenta. *@
        <Boton OnClick="GuardarAsync" Cargando="_guardando" Deshabilitado="_buscandoCliente">Guardar</Boton>
    </Pie>
</Drawer>

@* El mismo enlace que se acaba de enviar por correo, para poder entregarlo por
   otra vía si no llega. No es una credencial equivalente a la contraseña que
   antes se enviaba: caduca, solo sirve una vez, y quien acaba de crear la
   cuenta no gana con él ningún acceso que no tuviera ya —hasta ahora era él
   quien elegía la contraseña inicial—. Lo que sí evita es que un correo
   perdido obligue a dar de alta a la persona otra vez. *@
<Modal Visible="@(_enlaceActivacion is not null)"
       VisibleChanged="@(v => { if (!v) _enlaceActivacion = null; })"
       Titulo="Usuario creado">
    <ChildContent>
        <p>
            Le hemos enviado por correo un enlace para que establezca su contraseña.
            Caduca en @MinutosCaducidadActivacion minutos y solo puede usarse una vez.
        </p>
        <p>Si el correo no le llega, puedes hacerle llegar tú este enlace:</p>
        <p class="enlace-activacion">@_enlaceActivacion</p>
        <p class="nota-cuenta-sin-contrasena">Cuenta creada sin contraseña: nadie más que la persona llega a conocerla.</p>
    </ChildContent>
    <Pie>
        <BotonCopiar Valor="@(_enlaceActivacion ?? string.Empty)" Etiqueta="el enlace de activación" />
        <Boton OnClick="() => _enlaceActivacion = null">Hecho</Boton>
    </Pie>
</Modal>
