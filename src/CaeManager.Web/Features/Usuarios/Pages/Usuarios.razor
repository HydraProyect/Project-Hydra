@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae}")]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Infrastructure.Identity

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Usuarios — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    <div class="cabecera-pagina">
        @TituloPaginaIntegrable("Usuarios")
        <Boton OnClick="AbrirCrear">+ Nuevo usuario</Boton>
    </div>

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los usuarios" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="6" />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Correo</th>
                    <th>Nombre</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in UsuariosDePagina)
                {
                    <tr>
                        <td>@usuario.Email</td>
                        <td>@usuario.NombreCompleto</td>
                        <td>@Roles.NombreVisible(usuario.Rol)</td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <Badge Tono="TonoBadge.Exito">Activo</Badge>
                            }
                            else
                            {
                                <Badge Tono="TonoBadge.Peligro">Desactivado</Badge>
                            }
                        </td>
                        <td>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEditarAsync(usuario.Id)">
                                Editar
                            </Boton>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => CambiarActivacionAsync(usuario)">
                                @(usuario.Activo ? "Desactivar" : "Reactivar")
                            </Boton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_usuarios.Count == 0)
        {
            <EstadoVacio Titulo="Aún no hay usuarios" Descripcion="Crea el primero para dar acceso al sistema." />
        }
        else
        {
            <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_usuarios.Count"
                              Etiqueta="usuario(s)" PaginaActualChanged="IrAPaginaAsync"
                              TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? "Nuevo usuario" : "Editar usuario")" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="Correo" Type="email" Valor="@_email" ValorChanged="v => _email = v" Deshabilitado="@(_editandoId is not null)" />
        <CampoTexto Etiqueta="Nombre completo" Valor="@_nombreCompleto" ValorChanged="v => _nombreCompleto = v" />
        @* Sin campo de contraseña: la cuenta nace sin ninguna y el propio
           usuario la establece desde su enlace de activación. Nadie más llega
           a conocerla — antes la escribía aquí el Administrador y viajaba en
           claro dentro del correo de bienvenida. *@
        <CampoSelect Etiqueta="Rol" Valor="@_rol" ValorChanged="CambiarRolAsync">
            @foreach (var rol in Roles.Todos)
            {
                <option value="@rol">@Roles.NombreVisible(rol)</option>
            }
        </CampoSelect>

        @if (_rol == Roles.Administrador)
        {
            @* DEC-36 (REC-099): permiso específico, aparte del rol — nadie lo
               hereda solo por ser Administrador. *@
            <label class="campo-checkbox" title="Permite consultar quién ha abierto o descargado documentos sensibles (reconocimientos médicos y similares)">
                <input type="checkbox" checked="@_permisoConsultarAccesoDocumentosSensibles" @onchange="e => _permisoConsultarAccesoDocumentosSensibles = e.Value is bool activo && activo" />
                Puede consultar el rastro de acceso a documentos sensibles
            </label>
        }

        @if (_rol == Roles.GestorCae)
        {
            <CampoSelect Etiqueta="Coordinador CAE asignado" Valor="@_coordinadorUsuarioId" ValorChanged="v => _coordinadorUsuarioId = v">
                <option value="">Sin asignar por ahora</option>
                @foreach (var coordinador in _coordinadoresDisponibles)
                {
                    <option value="@coordinador.Id">@coordinador.NombreCompleto (@coordinador.Email)</option>
                }
            </CampoSelect>
            <p class="texto-vacio-seccion">Sin coordinador asignado, solo Administrador y Dirección CAE ven su cartera.</p>
        }

        @if (_rol == Roles.Cliente)
        {
            <CampoTexto Etiqueta="CIF del cliente a vincular" Valor="@_clienteCif" ValorChanged="BuscarClientePorCifAsync" />
            @if (_buscandoCliente)
            {
                <p class="texto-vacio-seccion">Buscando…</p>
            }
            else if (!string.IsNullOrWhiteSpace(_clienteCif))
            {
                @if (_clienteEncontrado is not null)
                {
                    <p class="pista-documento pista-documento-exito">✓ @_clienteEncontrado.RazonSocial</p>
                }
                else
                {
                    <p class="pista-documento pista-documento-error">✗ No encontramos ninguna empresa con este CIF — créala primero en Empresas.</p>
                }
            }
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" OnClick="() => CerrarDrawerAsync(false)">Cancelar</Boton>
        <Boton OnClick="GuardarAsync" Cargando="_guardando">Guardar</Boton>
    </Pie>
</Drawer>

@* El mismo enlace que se acaba de enviar por correo, para poder entregarlo por
   otra vía si no llega. No es una credencial equivalente a la contraseña que
   antes se enviaba: caduca, solo sirve una vez, y quien acaba de crear la
   cuenta no gana con él ningún acceso que no tuviera ya —hasta ahora era él
   quien elegía la contraseña inicial—. Lo que sí evita es que un correo
   perdido obligue a dar de alta a la persona otra vez. *@
<Modal Visible="@(_enlaceActivacion is not null)"
       VisibleChanged="@(v => { if (!v) _enlaceActivacion = null; })"
       Titulo="Usuario creado">
    <ChildContent>
        <p>
            Le hemos enviado por correo un enlace para que establezca su contraseña.
            Caduca en @MinutosCaducidadActivacion minutos y solo puede usarse una vez.
        </p>
        <p>Si el correo no le llega, puedes hacerle llegar tú este enlace:</p>
        <p class="enlace-activacion">@_enlaceActivacion</p>
    </ChildContent>
    <Pie>
        <BotonCopiar Valor="@(_enlaceActivacion ?? string.Empty)" />
        <Boton OnClick="() => _enlaceActivacion = null">Hecho</Boton>
    </Pie>
</Modal>
