@using CaeManager.Domain.Comunicaciones
@using CaeManager.Application.Comunicaciones.Queries.ObtenerIntencionConversacion
@using CaeManager.Web.Features.Comunicaciones.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosIntencionesCae> Textos

<div aria-label="@Textos["EtiquetaIntencion"]">
    <Badge Tono="TonoBadge.Info" Tamano="TamanoBadge.Pequeno">@(Textos["ResumenChip", Textos[$"Intencion_{Intencion.IntencionActual}"], Textos[$"Confianza_{Intencion.Confianza}"]])</Badge>
    @if (Intencion.ConfirmadaPorPersona)
    {
        <span>@Textos[ClaveConfirmacion]</span>
    }
    else
    {
        <span>@Textos["PendienteRevision"]</span>
        <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Secundario" Deshabilitado="Guardando" OnClick="() => OnConfirmar.InvokeAsync(Intencion.IntencionActual)">@Textos["Confirmar"]</Boton>
    }
    <CampoSelect Etiqueta="@Textos["CambiarIntencion"]" Valor="@Intencion.IntencionActual.ToString()" ValorChanged="CambiarAsync" Deshabilitado="Guardando">
        @foreach (var intencion in IntencionesCae)
        {
            <option value="@intencion">@Textos[$"Intencion_{intencion}"]</option>
        }
    </CampoSelect>
    @if (Intencion.TipoEntidadPropuesta is { } tipo)
    {
        <a href="@RutaEntidad(tipo, Intencion.EntidadPropuestaId!.Value)">@(Textos["EntidadPropuesta", Textos[$"TipoEntidad_{tipo}"]])</a>
        <span>@Textos["PendienteEntidad"]</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public IntencionConversacionDto Intencion { get; set; } = default!;
    [Parameter] public bool Guardando { get; set; }
    private static readonly IntencionCae[] IntencionesCae = Enum.GetValues<IntencionCae>();
    // Claves del .resx, no texto de interfaz.
    private const string ClaveCambiada = "CambiadaConfirmada", ClaveConfirmada = "Confirmada";
    private string ClaveConfirmacion => Intencion.CambiadaPorPersona ? ClaveCambiada : ClaveConfirmada;
    [Parameter] public EventCallback<IntencionCae> OnConfirmar { get; set; }
    private static string RutaEntidad(TipoEntidadIntencion tipo, Guid id) => tipo switch
    {
        TipoEntidadIntencion.Trabajador => $"/trabajadores/{id}",
        TipoEntidadIntencion.Empresa => $"/empresas/{id}",
        TipoEntidadIntencion.Centro => $"/centros/{id}",
        _ => $"/documentos/tipos/{id}"
    };
    private Task CambiarAsync(string valor) => Enum.TryParse<IntencionCae>(valor, out var intencion)
        ? OnConfirmar.InvokeAsync(intencion) : Task.CompletedTask;
}
