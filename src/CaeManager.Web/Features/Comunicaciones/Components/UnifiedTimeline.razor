@*
    Cronología única de una conversación (docs/COMUNICACIONES.md § 12.3):
    mezcla mensajes de Correo y WhatsApp, y ahora también eventos del sistema
    (§ 16.7 — "Visita creada", etc.) cronológicamente, cada uno con su propio
    tratamiento — nunca listas separadas por pantalla. Componente reutilizable
    declarado en el diseño del Communication Workspace (§ 11); hoy solo lo
    consume Bandeja, pero está pensado para Historial/Auditoría más adelante.
*@
@using CaeManager.Application.Comunicaciones.Queries.ObtenerConversacionPorId
@using CaeManager.Domain.Comunicaciones

<div class="timeline-mensajes">
    @{ DateTime? fechaSeparadorAnterior = null; }
    @foreach (var item in ItemsOrdenados())
    {
        var fechaUtcItem = item switch { MensajeDetalleDto m => m.FechaUtc, EventoDetalleDto e => e.FechaUtc, _ => DateTime.UtcNow };
        var fechaLocal = fechaUtcItem.ToLocalTime().Date;
        if (fechaSeparadorAnterior != fechaLocal)
        {
            fechaSeparadorAnterior = fechaLocal;
            <div class="timeline-separador-fecha">
                <span>@FormatearSeparadorFecha(fechaLocal)</span>
            </div>
        }

        @if (item is EventoDetalleDto evento)
        {
            <div class="timeline-evento-fila">
                <span class="timeline-evento-icono" aria-hidden="true">
                    <Icono Nombre="configuracion" Tamano="TamanoIcono.Pequeno" />
                </span>
                <div class="timeline-evento">
                    <span class="timeline-evento-texto">@evento.Descripcion</span>
                    @if (evento.Tipo == TipoEventoConversacion.VisitaCreada)
                    {
                        <a class="timeline-evento-enlace" href="/visitas">Ver visita</a>
                    }
                    else if (evento.Tipo == TipoEventoConversacion.DocumentoActualizado)
                    {
                        <a class="timeline-evento-enlace" href="/documentos">Ver documento</a>
                    }
                    <span class="timeline-mensaje-fecha">@FormatearFechaRelativa(evento.FechaUtc)</span>
                </div>
            </div>
        }
        else if (item is MensajeDetalleDto mensaje)
        {
            var esRuidoSinConfirmar = EsRuidoSinConfirmar(mensaje);
            <div class="timeline-mensaje-fila timeline-mensaje-fila-@mensaje.Direccion.ToString().ToLowerInvariant() @(esRuidoSinConfirmar ? "timeline-mensaje-fila-ruido" : null)">
                <span class="timeline-avatar" title="@mensaje.Remitente" aria-hidden="true">@ObtenerIniciales(mensaje.Remitente)</span>
                <div class="timeline-mensaje timeline-mensaje-@mensaje.Direccion.ToString().ToLowerInvariant()">
                    <div class="timeline-mensaje-cabecera">
                        <span class="timeline-mensaje-remitente">@mensaje.Remitente</span>
                        <span class="timeline-badge-canal" title="@(mensaje.Canal == CanalConversacion.WhatsApp ? "WhatsApp" : "Correo")">
                            <Icono Nombre="@(mensaje.Canal == CanalConversacion.WhatsApp ? "chat" : "correo")" Tamano="TamanoIcono.Pequeno" />
                        </span>
                        @{
                            var participante = Participantes.FirstOrDefault(p => p.Email == mensaje.Remitente);
                        }
                        @if (participante is not null && Participantes.Select(p => p.TipoOrigen).Distinct().Count() > 1)
                        {
                            <Badge Tono="TonoBadge.Neutro">@participante.TipoOrigen</Badge>
                        }
                        @if (esRuidoSinConfirmar)
                        {
                            <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno">@DescribirMotivoRuido(mensaje)</Badge>
                            <button type="button" class="timeline-ruido-confirmar" title="Este mensaje sí importa — deja de tratarse como ruido"
                                    @onclick="() => OnConfirmarRuido.InvokeAsync(mensaje.Id)">
                                Esto sí importa
                            </button>
                        }
                        <span class="timeline-mensaje-fecha">@FormatearFechaRelativa(mensaje.FechaUtc)</span>
                    </div>

                    @* MarkupString solo es admisible aquí porque el cuerpo llega ya
                       saneado desde ObtenerConversacionPorIdQuery — ver MensajeDetalleDto. *@
                    <div class="timeline-mensaje-cuerpo">@((MarkupString)mensaje.CuerpoHtml)</div>

                    @if (mensaje.Direccion == DireccionMensaje.Saliente && mensaje.Canal == CanalConversacion.WhatsApp)
                    {
                        <div class="timeline-entrega-whatsapp">
                            <span class="timeline-ticks @(mensaje.EstadoEntrega == EstadoEntregaMensaje.Leido ? "leido" : null)"
                                  title="@DescribirEstadoEntrega(mensaje.EstadoEntrega)">@TicksEstadoEntrega(mensaje.EstadoEntrega)</span>
                            @if (mensaje.EstadoEntrega == EstadoEntregaMensaje.Fallido)
                            {
                                <span class="timeline-error-entrega">No entregado: @(mensaje.ErrorEntrega ?? "error desconocido")</span>
                            }
                        </div>
                    }

                    @if (mensaje.Adjuntos.Count > 0)
                    {
                        <div class="timeline-adjuntos">
                            @foreach (var adjunto in mensaje.Adjuntos)
                            {
                                <span class="timeline-adjunto-grupo">
                                    <a class="timeline-adjunto-chip" href="@($"/comunicaciones/adjuntos/{adjunto.Id}/archivo")" target="_blank">
                                        <Icono Nombre="documentos" Tamano="TamanoIcono.Pequeno" />
                                        <span class="timeline-adjunto-nombre">@adjunto.NombreArchivo</span>
                                        <span class="timeline-adjunto-tamano">@FormatearTamano(adjunto.TamanoBytes)</span>
                                    </a>
                                    <button type="button" class="timeline-adjunto-actualizar-documento"
                                            title="Actualizar documentación con este adjunto"
                                            @onclick="() => OnActualizarDocumentoDesdeAdjunto.InvokeAsync(adjunto.Id)">
                                        <Icono Nombre="tipos-documento" Tamano="TamanoIcono.Pequeno" /> Actualizar documentación
                                    </button>
                                </span>
                            }
                        </div>
                    }

                    @if (mensaje.SugerenciaVisita is { } sugerencia)
                    {
                        <div class="timeline-marca-ia"><span class="timeline-marca-ia-linea"></span>
                            <MarcaProcedencia Titulo="Detectado por Hydra"
                                               Etiqueta="@($"Detectado por Hydra — posible solicitud de visita, confianza {sugerencia.Confianza}%. {sugerencia.Resumen}")">
                                <Detalle>Confianza @sugerencia.Confianza% — @sugerencia.Resumen</Detalle>
                            </MarcaProcedencia>
                            <span>Posible solicitud de visita — revisar en Acciones sugeridas</span>
                            <span class="timeline-marca-ia-linea"></span>
                        </div>
                    }

                    @foreach (var sugerenciaGestion in mensaje.SugerenciasGestion)
                    {
                        <div class="timeline-marca-ia"><span class="timeline-marca-ia-linea"></span>
                            <MarcaProcedencia Titulo="Detectado por Hydra"
                                               Etiqueta="@($"Detectado por Hydra — posible actualización documental, confianza {sugerenciaGestion.Confianza}%. {sugerenciaGestion.Resumen}")">
                                <Detalle>Confianza @sugerenciaGestion.Confianza% — @sugerenciaGestion.Resumen</Detalle>
                            </MarcaProcedencia>
                            <span>Posible actualización de documentación — revisar en Acciones sugeridas</span>
                            <span class="timeline-marca-ia-linea"></span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MensajeDetalleDto> Mensajes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ParticipanteDetalleDto> Participantes { get; set; } = [];
    [Parameter] public IReadOnlyList<EventoDetalleDto> Eventos { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnActualizarDocumentoDesdeAdjunto { get; set; }
    [Parameter] public EventCallback<Guid> OnConfirmarRuido { get; set; }

    /// <summary>Ronda de reducción de ruido en Comunicaciones — mismo criterio en las dos formas en que un mensaje llega marcado como ruido, ver MensajeDetalleDto.</summary>
    private static bool EsRuidoSinConfirmar(MensajeDetalleDto mensaje) =>
        (mensaje.MotivoRuido != MotivoRuidoMensaje.Ninguno || mensaje.TieneSoloRepeticionesPendientes) && !mensaje.RuidoConfirmadoManualmente;

    private static string DescribirMotivoRuido(MensajeDetalleDto mensaje) => mensaje.MotivoRuido switch
    {
        MotivoRuidoMensaje.ResumenSinCambios => "Resumen sin cambios",
        MotivoRuidoMensaje.CorreoInterno => "Correo interno",
        MotivoRuidoMensaje.PosiblePhishing => "Posible phishing",
        _ when mensaje.TieneSoloRepeticionesPendientes => "Repetición — ya reclamado",
        _ => "Ruido"
    };

    /// <summary>Mezcla Mensajes y Eventos en una sola cronología — ambos DTOs son inmutables y llegan ya ordenados por su fuente, pero mezclados hace falta un único OrderBy.</summary>
    private IEnumerable<object> ItemsOrdenados() =>
        Mensajes.Cast<object>().Concat(Eventos.Cast<object>())
            .OrderBy(item => item switch { MensajeDetalleDto m => m.FechaUtc, EventoDetalleDto e => e.FechaUtc, _ => DateTime.MinValue });

    /// <summary>Dos letras del correo (local-part) o del teléfono para el avatar — sin depender de un nombre completo, que este DTO no siempre trae.</summary>
    private static string ObtenerIniciales(string remitente)
    {
        var local = remitente.Split('@')[0];
        return local.Length >= 2 ? local[..2].ToUpperInvariant() : local.ToUpperInvariant();
    }

    private static string FormatearTamano(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB"
    };

    /// <summary>Separador de día del timeline (mockup 03.1: "Hoy, 7 de agosto de 2026") — agrupa visualmente sin tocar el orden cronológico ya devuelto por ObtenerConversacionPorIdQueryHandler.</summary>
    private static string FormatearSeparadorFecha(DateTime fechaLocal)
    {
        var hoy = DateTime.Now.Date;
        if (fechaLocal == hoy) return $"Hoy, {fechaLocal:d 'de' MMMM 'de' yyyy}";
        if (fechaLocal == hoy.AddDays(-1)) return $"Ayer, {fechaLocal:d 'de' MMMM 'de' yyyy}";
        return fechaLocal.ToString("d 'de' MMMM 'de' yyyy");
    }

    private static string FormatearFechaRelativa(DateTime fechaUtc)
    {
        var transcurrido = DateTime.UtcNow - fechaUtc;

        if (transcurrido.TotalMinutes < 1) return "ahora";
        if (transcurrido.TotalMinutes < 60) return $"hace {(int)transcurrido.TotalMinutes} min";
        if (transcurrido.TotalHours < 24) return $"hace {(int)transcurrido.TotalHours} h";
        if (transcurrido.TotalDays < 30) return $"hace {(int)transcurrido.TotalDays} d";

        return fechaUtc.ToString("dd/MM/yyyy");
    }

    private static string TicksEstadoEntrega(EstadoEntregaMensaje? estado) => estado switch
    {
        EstadoEntregaMensaje.Enviado => "✓",
        EstadoEntregaMensaje.Entregado or EstadoEntregaMensaje.Leido => "✓✓",
        EstadoEntregaMensaje.Fallido => "!",
        _ => string.Empty,
    };

    private static string DescribirEstadoEntrega(EstadoEntregaMensaje? estado) => estado switch
    {
        EstadoEntregaMensaje.Enviado => "Enviado",
        EstadoEntregaMensaje.Entregado => "Entregado",
        EstadoEntregaMensaje.Leido => "Leído",
        EstadoEntregaMensaje.Fallido => "No entregado",
        _ => string.Empty,
    };
}
