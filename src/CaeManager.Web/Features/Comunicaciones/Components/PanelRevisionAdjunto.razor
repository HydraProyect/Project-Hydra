@*
    Panel de revisión de adjuntos del visor de documento a pantalla completa. Vive en Comunicaciones y entra en el visor del Núcleo por su
    hueco Panel (ContextoPanelVisor): el visor no referencia Outbound, el panel sí (tablero «Visor-Documento» del lienzo de Comunicaciones, estados
    L-66 y L-67, PR-A3): «¿Es el documento correcto?», «Asignar a», tipo de documento y las acciones asignar, rechazar y dejar para
    después. Reutiliza los Commands del reparto de adjuntos (FijarDestinoAdjunto, AsignarAdjuntosLote, ResolverAdjunto): el rol y el
    alcance de cartera los deciden ellos en el servidor y no se repiten aquí; el panel solo ofrece lo que el servidor va a aceptar
    (sin rol de escritura no hay acciones). NO envía nada al remitente.

    Lo que el lienzo pinta y hoy no existe en el modelo, y por eso no está: la lectura de Vega (confianza, sugerencia y umbral 70),
    los datos detectados en el documento con su semáforo, el veredicto «Todo coincide…» y el aviso de datos que no coinciden. Sin
    lectura el lienzo define su propio estado («Sin lectura de Vega»: nadie viene preseleccionado y se elige o se busca), que es el que
    se pinta. Tampoco hay «Cambiar la asignación»: ningún Command deshace un Documento ya dado de alta.

    Dos atajos deliberados, marcados donde están (shortcut:): la fecha de emisión (el lienzo no tiene el campo; la aporta quien abre
    el visor) y el rótulo «Rechazar documento» (el del lienzo promete reclamar al remitente, y ResolverAdjunto no envía nada).
*@
@using CaeManager.Application.Comunicaciones.Commands.AsignarAdjuntosLote
@using CaeManager.Application.Comunicaciones.Commands.FijarDestinoAdjunto
@using CaeManager.Application.Comunicaciones.Commands.ResolverAdjunto
@using CaeManager.Domain.Comunicaciones
@using CaeManager.Web.Features.Comunicaciones.Recursos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosRevisionAdjunto> Textos
@inject ILogger<PanelRevisionAdjunto> Logger

@{
    var b = Borrador;
    var pendiente = Adjunto.Estado == EstadoAdjuntoVisor.Pendiente;
    var editable = pendiente && _puedeEscribir;
    var candidatos = Candidatos(b);
    // «Revisar de nuevo» solo existe con rol de escritura: quien solo consulta no lee una instrucción que no puede seguir.
    var hayBloqueo = !pendiente && (_puedeEscribir || Adjunto.Estado == EstadoAdjuntoVisor.Asignado);
}
<aside class="vz-aside" aria-label="@Textos["Rev_Aria"]" tabindex="-1" @ref="_aside" @onkeydown="e => Contexto.Tecla.InvokeAsync(e)" @onkeydown:stopPropagation="true">
    <div class="vz-sec">
        <span class="vz-etq">@Textos["Rev_Pregunta"]</span>
        <span class="vz-badges">
            @if (pendiente && b.Destino is null)
            {
                <Badge Tono="TonoBadge.Neutro"><Icono Nombre="info" Tamano="TamanoIcono.Pequeno" />@Textos["Rev_FaltaElegir"]</Badge>
            }
            <Badge Tono="TonoBadge.Neutro">@Textos["Rev_SinVega"]</Badge>
        </span>
    </div>

    <div class="vz-sec">
        <span class="vz-sec-cab">
            <span class="vz-etq" id="vz-asignar-a">@Textos["Rev_AsignarA"]</span>
            <span class="vz-nota">@AyudaCandidatos(candidatos.Count)</span>
        </span>
        @if (hayBloqueo)
        {
            <span class="vz-ayuda" id="vz-bloqueo">@(Adjunto.Estado == EstadoAdjuntoVisor.Asignado ? Textos["Rev_Bloqueo_Asignado"] : Textos["Rev_Bloqueo_Rechazado"])</span>
        }
        <div class="vz-cands" role="radiogroup" aria-labelledby="vz-asignar-a" aria-describedby="@(hayBloqueo ? "vz-bloqueo" : null)" aria-disabled="@(editable ? null : "true")"
             @onkeydown="e => TeclaRadiosAsync(e, b, candidatos)" @onkeydown:stopPropagation="true">
            @foreach (var c in candidatos)
            {
                var elegido = b.Destino?.Id == c.Id;
                var destino = c;
                <button type="button" role="radio" class="vz-cand" data-cand="@c.Id" aria-checked="@(elegido ? "true" : "false")" aria-disabled="@(editable && !_ocupado ? null : "true")"
                        tabindex="@((b.Destino is null ? candidatos[0].Id == c.Id : elegido) ? 0 : -1)" @onclick="() => ElegirDestino(b, destino)" @key="c.Id">
                    <span class="vz-radio" aria-hidden="true"></span>
                    <span class="vz-cand-txt">
                        <span class="vz-cand-l1">@c.Nombre</span>
                        @if (!string.IsNullOrWhiteSpace(c.Detalle))
                        {
                            <span class="vz-cand-l2">@c.Detalle</span>
                        }
                    </span>
                </button>
            }
        </div>
        @if (editable)
        {
            <Boton Variante="VarianteBoton.Fantasma" class="vz-buscar-btn" aria-expanded="@(b.Buscando ? "true" : "false")" aria-controls="vz-busca" OnClick="() => AlternarBusqueda(b)"><Icono Nombre="buscar" Tamano="TamanoIcono.Pequeno" />@Textos["Rev_Buscar"]</Boton>
            @if (b.Buscando)
            {
                var resultados = Buscar(b);
                <div class="vz-busca" id="vz-busca" @onkeydown="e => TeclaCampoAsync(e, b)" @onkeydown:stopPropagation="true">
                    <CampoTexto Type="search" Etiqueta="@Textos["Rev_Buscar_Aria"]" Placeholder="@Textos["Rev_Buscar_Placeholder"]" Valor="@b.Consulta" ValorChanged="v => b.Consulta = v" />
                    <span class="vz-ayuda" role="status">@AyudaBusqueda(b.Consulta, resultados.Count)</span>
                    @foreach (var r in resultados)
                    {
                        var elegida = r;
                        <div class="vz-busca-res" @key="r.Id">
                            <span class="vz-cand-txt">
                                <span class="vz-cand-l1">@r.Nombre</span>
                                @if (!string.IsNullOrWhiteSpace(r.Detalle))
                                {
                                    <span class="vz-cand-l2">@r.Detalle</span>
                                }
                            </span>
                            <Boton Variante="VarianteBoton.Secundario" OnClick="() => ElegirBusqueda(b, elegida)">@Textos["Rev_Elegir_A", r.Nombre]</Boton>
                        </div>
                    }
                </div>
            }
            <div @onkeydown="e => TeclaCampoAsync(e, b)" @onkeydown:stopPropagation="true">
                <CampoSelect Etiqueta="@Textos["Rev_Tipo"]" Deshabilitado="_ocupado" Valor="@(TipoVigente(b)?.ToString() ?? string.Empty)" ValorChanged="v => ElegirTipo(b, v)">
                    <option value="">@Textos["Rev_Tipo_Elegir"]</option>
                    @foreach (var t in TiposOfrecidos(b))
                    {
                        <option value="@t.Id" selected="@(t.Id == TipoVigente(b))">@t.Nombre</option>
                    }
                </CampoSelect>
            </div>
        }
        else
        {
            <div class="vz-campo" role="group" aria-labelledby="vz-tipo-etq" aria-describedby="@(hayBloqueo ? "vz-bloqueo" : null)">
                <span class="vz-etq" id="vz-tipo-etq">@Textos["Rev_Tipo"]</span>
                <span class="vz-solo-lectura">@NombreTipoResuelto(b)</span>
            </div>
        }
    </div>

    @if (b.Aviso is not null)
    {
        <div class="vz-aviso" role="status"><Icono Nombre="advertencia" Tamano="TamanoIcono.Pequeno" /><span>@b.Aviso</span></div>
    }

    <div class="vz-pie">
        @if (pendiente && !_puedeEscribir)
        {
            <span class="vz-ayuda" role="status">@Textos["Rev_SoloConsulta"]</span>
        }
        else if (pendiente && !b.Rechazando)
        {
            var motivoAsignar = MotivoSinAsignar(b);
            <div class="vz-acciones">
                <Boton Variante="VarianteBoton.Primario" class="vz-acc vz-asignar" aria-disabled="@(motivoAsignar is null && !_ocupado ? null : "true")" aria-describedby="@(motivoAsignar is null ? null : "vz-ayuda-asignar")" OnClick="() => AsignarAsync(b)">@Textos["Rev_Asignar"]</Boton>
                @* shortcut: el rótulo del lienzo («Rechazar y reclamar el documento») promete reclamar al remitente, que no existe (ResolverAdjunto solo marca el adjunto como rechazado); volver al rótulo del lienzo cuando exista el envío al remitente. *@
                <Boton Variante="VarianteBoton.Secundario" class="vz-acc" Deshabilitado="_ocupado" OnClick="() => b.Rechazando = true">@Textos["Rev_Rechazar"]</Boton>
                <Boton Variante="VarianteBoton.Fantasma" class="vz-acc" Deshabilitado="_ocupado" OnClick="DejarAsync">@Textos["Rev_Dejar"]</Boton>
            </div>
            @if (motivoAsignar is not null)
            {
                <span class="vz-ayuda" id="vz-ayuda-asignar">@motivoAsignar</span>
            }
        }
        else if (pendiente)
        {
            var motivoOk = !string.IsNullOrWhiteSpace(b.Motivo);
            @* @key por adjunto: CampoTextarea reutiliza su instancia al cambiar de adjunto y, si el valor que recibe sigue siendo "", el navegador conservaría el motivo escrito en el anterior. *@
            <div @key="Adjunto.Id" @onkeydown="e => TeclaCampoAsync(e, b)" @onkeydown:stopPropagation="true">
                <CampoTextarea Etiqueta="@Textos["Rev_Motivo"]" Placeholder="@Textos["Rev_Motivo_Placeholder"]" Filas="3" Deshabilitado="_ocupado" Valor="@b.Motivo" ValorChanged="v => b.Motivo = v" />
            </div>
            @if (!motivoOk)
            {
                <span class="vz-ayuda" id="vz-ayuda-motivo">@Textos["Rev_Motivo_Ayuda"]</span>
            }
            <div class="vz-acciones">
                <Boton Variante="VarianteBoton.Destructivo" class="vz-acc" aria-disabled="@(motivoOk && !_ocupado ? null : "true")" aria-describedby="@(motivoOk ? null : "vz-ayuda-motivo")" OnClick="() => RechazarAsync(b)">@Textos["Rev_Rechazar"]</Boton>
                <Boton Variante="VarianteBoton.Secundario" class="vz-acc" Deshabilitado="_ocupado" OnClick="() => CancelarRechazo(b)">@Textos["Rev_Rechazo_Cancelar"]</Boton>
            </div>
        }
        else
        {
            <span class="vz-resuelto">
                <Badge Tono="@(Adjunto.Estado == EstadoAdjuntoVisor.Asignado ? TonoBadge.Neutro : TonoBadge.Peligro)">@(Adjunto.Estado == EstadoAdjuntoVisor.Asignado ? Textos["Rev_Resuelto_Asignado"] : Textos["Rev_Resuelto_Rechazado"])</Badge>
                <span>@TextoResuelto(b)</span>
            </span>
            @if (!_puedeEscribir)
            {
                <span class="vz-ayuda" role="status">@Textos["Rev_SoloConsulta"]</span>
            }
            else if (Adjunto.Estado == EstadoAdjuntoVisor.Rechazado)
            {
                <div class="vz-acciones">
                    <Boton Variante="VarianteBoton.Secundario" class="vz-acc vz-reabrir" Deshabilitado="_ocupado" OnClick="() => ReabrirAsync(b)">@Textos["Rev_Revisar_Nuevo"]</Boton>
                </div>
            }
        }
    </div>
</aside>

@code {
    private const int MinimoBusqueda = 2;
    private const int MaximoResultados = 5;

    // Métodos y no expresiones del marcado: el medidor de textos sin localizar toma el ">" de un "Count > 1" por cierre de etiqueta y contaría código como texto.
    private string AyudaCandidatos(int candidatos) => candidatos switch
    {
        0 => Textos["Rev_Ayuda_Ninguno"],
        1 => Textos["Rev_Ayuda_Unico"],
        _ => Textos["Rev_Ayuda_Varios", candidatos],
    };

    private string AyudaBusqueda(string consulta, int resultados)
    {
        if (consulta.Trim().Length < 2)
            return Textos["Rev_Buscar_Minimo"];
        return resultados switch
        {
            0 => Textos["Rev_Buscar_Ninguno"],
            1 => Textos["Rev_Buscar_Resultados_1"],
            _ => Textos["Rev_Buscar_Resultados_N", resultados],
        };
    }

    private sealed class BorradorRevision
    {
        public DestinoRevision? Destino { get; set; }
        public Guid? Tipo { get; set; }
        public List<DestinoRevision> Buscados { get; } = [];
        public bool Buscando { get; set; }
        public string Consulta { get; set; } = string.Empty;
        public bool Rechazando { get; set; }
        public string Motivo { get; set; } = string.Empty;
        public string? Aviso { get; set; }

        /// <summary>Trabajador, Empresa y tipo que el servidor tiene guardados en el adjunto: los de la propuesta al abrir el visor y, después, lo último que este panel fijó con éxito.</summary>
        public (Guid? TrabajadorId, Guid? EmpresaId, Guid? TipoDocumentoId) Fijado { get; set; }
    }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    /// <summary>El adjunto que se revisa, con su estado vigente, y las salidas del visor (el hueco Panel de VisorDocumentoPantallaCompleta se las da ya mezcladas con lo que se resolvió dentro de él).</summary>
    [Parameter, EditorRequired] public ContextoPanelVisor Contexto { get; set; } = default!;

    [Parameter, EditorRequired] public RevisionAdjuntos Revision { get; set; } = default!;

    private AdjuntoVisor Adjunto => Contexto.Adjunto;

    /// <summary>Adjuntos sin resolver de la cola, contando el actual: con ellos el aviso dice cuántos quedan.</summary>
    private int Pendientes => Contexto.Pendientes;

    private readonly Dictionary<Guid, BorradorRevision> _borradores = [];
    private ElementReference _aside;
    private bool _puedeEscribir;
    private bool _ocupado;

    // Cada adjunto conserva lo que se lleva escrito (destino elegido, tipo, motivo) mientras el visor siga abierto: cambiar de
    // adjunto no lo pierde (el lienzo pide confirmar el descarte; aquí simplemente no se descarta).
    // shortcut: cerrar el visor con un motivo escrito lo descarta sin la confirmación en línea del lienzo («Volver sin asignar»), cuando se pida esa confirmación, el visor debe preguntar al panel si hay borrador.
    // shortcut: tras asignar, rechazar o cancelar el foco no se mueve al motivo ni a la acción siguiente (el panel se vuelve a pintar), cuando se afine el teclado, enfocar con @ref el control que aparece.
    private BorradorRevision Borrador
    {
        get
        {
            if (!_borradores.TryGetValue(Adjunto.Id, out var b))
                _borradores[Adjunto.Id] = b = new BorradorRevision
                {
                    Tipo = Propuesta?.TipoDocumentoId,
                    Fijado = (Propuesta?.TrabajadorId, Propuesta?.EmpresaId, Propuesta?.TipoDocumentoId)
                };
            return b;
        }
    }

    private PropuestaRevision? Propuesta => Revision.Propuestas.GetValueOrDefault(Adjunto.Id);

    protected override async Task OnParametersSetAsync() =>
        _puedeEscribir = await SoloConEscritura.PuedeEscribirAsync(EstadoAutenticacion);

    private IReadOnlyList<DestinoRevision> Candidatos(BorradorRevision b)
    {
        var propuesto = Revision.Destinos.Where(d => d.EsEmpresa ? d.Id == Propuesta?.EmpresaId : d.Id == Propuesta?.TrabajadorId);
        return propuesto.Concat(b.Buscados).DistinctBy(d => d.Id).ToList();
    }

    private IReadOnlyList<DestinoRevision> Buscar(BorradorRevision b)
    {
        var consulta = b.Consulta.Trim();
        if (consulta.Length < MinimoBusqueda) return [];
        return Revision.Destinos
            .Where(d => d.Nombre.Contains(consulta, StringComparison.CurrentCultureIgnoreCase))
            .Take(MaximoResultados).ToList();
    }

    // Un tipo de Empresa no sirve a un Trabajador: con destino elegido solo se ofrecen los de su clase.
    private IEnumerable<TipoRevision> TiposOfrecidos(BorradorRevision b) =>
        b.Destino is null ? Revision.Tipos : Revision.Tipos.Where(t => t.ParaEmpresa == b.Destino.EsEmpresa);

    private Guid? TipoVigente(BorradorRevision b) => TiposOfrecidos(b).Any(t => t.Id == b.Tipo) ? b.Tipo : null;

    private void ElegirDestino(BorradorRevision b, DestinoRevision destino)
    {
        // Con un Command en curso no se cambia lo que se está enviando: el texto del resultado diría otra cosa que lo asignado.
        if (!_puedeEscribir || _ocupado || Adjunto.Estado != EstadoAdjuntoVisor.Pendiente) return;
        b.Destino = destino;
        b.Aviso = null;
    }

    // shortcut: las flechas cambian la tarjeta elegida (aria-checked y tabindex) pero el foco no la sigue, como pide el patrón radio de WAI-ARIA; cuando se afine el teclado, enfocar con @ref el radio elegido.
    private async Task TeclaRadiosAsync(KeyboardEventArgs e, BorradorRevision b, IReadOnlyList<DestinoRevision> candidatos)
    {
        var paso = e.Key is "ArrowDown" or "ArrowRight" ? 1 : e.Key is "ArrowUp" or "ArrowLeft" ? -1 : 0;
        if (paso == 0)
        {
            // Una tarjeta no es un campo: salvo las flechas (de la lista) y Escape (vuelve al panel), sus teclas son las del visor (+, -, [, ]).
            if (e.Key == "Escape") await _aside.FocusAsync();
            else await Contexto.Tecla.InvokeAsync(e);
            return;
        }

        if (candidatos.Count == 0 || !_puedeEscribir || Adjunto.Estado != EstadoAdjuntoVisor.Pendiente) return;

        var actual = b.Destino is null ? -1 : candidatos.ToList().FindIndex(c => c.Id == b.Destino.Id);
        var @base = actual >= 0 ? actual : (paso > 0 ? -1 : 0);
        ElegirDestino(b, candidatos[(@base + paso + candidatos.Count) % candidatos.Count]);
    }

    // Las teclas de un campo son del campo: no llegan al visor (+, -, [, ] y las flechas no cambian zoom, hoja ni adjunto).
    // Escape sale del campo al panel (un segundo Escape cierra el visor) y, con la búsqueda abierta, la pliega.
    private async Task TeclaCampoAsync(KeyboardEventArgs e, BorradorRevision b)
    {
        if (e.Key != "Escape") return;
        b.Buscando = false;
        b.Consulta = string.Empty;
        await _aside.FocusAsync();
    }

    private static void AlternarBusqueda(BorradorRevision b)
    {
        b.Buscando = !b.Buscando;
        b.Consulta = string.Empty;
    }

    private void ElegirBusqueda(BorradorRevision b, DestinoRevision elegido)
    {
        if (_ocupado) return;
        b.Buscados.Add(elegido);
        b.Buscando = false;
        b.Consulta = string.Empty;
        ElegirDestino(b, elegido);
    }

    private void ElegirTipo(BorradorRevision b, string valor)
    {
        if (_ocupado) return;
        b.Tipo = Guid.TryParse(valor, out var id) ? id : null;
        b.Aviso = null;
    }

    // shortcut: el lienzo no tiene campo de fecha de emisión, así que el panel no la pide: la aporta quien abre el visor en PropuestaRevision.FechaEmision (la conectará A4). Sin ella «Asignar el documento» queda deshabilitado con su ayuda; cuando A4 la lea del adjunto (o el lienzo añada el campo), esta ayuda desaparece.
    private string? MotivoSinAsignar(BorradorRevision b) =>
        b.Destino is null ? Textos["Rev_Ayuda_Asignar_Destino"].Value
        : TipoVigente(b) is null ? Textos["Rev_Ayuda_Asignar_Tipo"].Value
        : Propuesta?.FechaEmision is null ? Textos["Rev_Ayuda_Asignar_Fecha"].Value
        : null;

    private void CancelarRechazo(BorradorRevision b)
    {
        b.Rechazando = false;
        b.Motivo = string.Empty;
    }

    private async Task AsignarAsync(BorradorRevision b)
    {
        if (_ocupado || MotivoSinAsignar(b) is not null) return;
        // El visor reutiliza este panel al cambiar de adjunto y la navegación sigue viva mientras el Command corre: todo lo que se
        // usa tras un await sale de estas copias, nunca de Adjunto ni de Propuesta, que ya podrían ser los del adjunto siguiente.
        var adjuntoId = Adjunto.Id;
        var destino = b.Destino!;
        var tipoId = TipoVigente(b)!.Value;
        var propuesta = Propuesta!;
        Guid? trabajadorId = destino.EsEmpresa ? null : destino.Id, empresaId = destino.EsEmpresa ? destino.Id : null;
        var texto = Textos["Rev_Toast_Asignado", destino.Nombre, NombreTipo(tipoId)].Value;

        await EjecutarAsync(b, async () =>
        {
            // El lote solo asigna lo que coincide con lo que el servidor tiene guardado: si la persona eligió otra cosa, se guarda
            // antes. Lo guardado es lo último que este panel fijó con éxito (si no, la propuesta con la que se abrió el visor), no la
            // propuesta a secas: tras un destino fijado y un lote fallido, volver a la propuesta también exige volver a guardarla.
            var pedido = (trabajadorId, empresaId, tipoId: (Guid?)tipoId);
            if (b.Fijado != pedido)
            {
                var fijado = await Mediator.Send(new FijarDestinoAdjuntoCommand(adjuntoId, trabajadorId, empresaId, tipoId));
                if (fijado.EsFallido) return fijado.Error.Mensaje;
                b.Fijado = pedido;
            }

            var lote = await Mediator.Send(new AsignarAdjuntosLoteCommand(Revision.ConversacionId,
                [new AdjuntoAAsignar(adjuntoId, tipoId, trabajadorId, empresaId, propuesta.FechaEmision!.Value, propuesta.FechaVencimiento, propuesta.NoCaduca)]));
            if (lote.EsFallido) return lote.Error.Mensaje;

            var resultado = lote.Valor.FirstOrDefault(r => r.AdjuntoId == adjuntoId);
            return resultado is { Estado: EstadoAsignacionAdjunto.Asignado } ? null : resultado?.Detalle ?? Textos["Rev_Error"].Value;
        }, EstadoAdjuntoVisor.Asignado, texto);
    }

    private Task RechazarAsync(BorradorRevision b)
    {
        if (string.IsNullOrWhiteSpace(b.Motivo) || _ocupado) return Task.CompletedTask;
        var adjuntoId = Adjunto.Id;
        var motivo = b.Motivo.Trim();
        return EjecutarAsync(b, async () =>
        {
            var resultado = await Mediator.Send(new ResolverAdjuntoCommand(adjuntoId, ResolucionAdjunto.Rechazar, motivo));
            return resultado.EsFallido ? resultado.Error.Mensaje : null;
        }, EstadoAdjuntoVisor.Rechazado, Textos["Rev_Toast_Rechazado"].Value);
    }

    private Task ReabrirAsync(BorradorRevision b)
    {
        if (_ocupado) return Task.CompletedTask;
        var adjuntoId = Adjunto.Id;
        return EjecutarAsync(b, async () =>
        {
            var resultado = await Mediator.Send(new ResolverAdjuntoCommand(adjuntoId, ResolucionAdjunto.Reabrir));
            if (resultado.EsFallido) return resultado.Error.Mensaje;
            b.Rechazando = false;
            b.Motivo = string.Empty;
            return null;
        }, EstadoAdjuntoVisor.Pendiente, Textos["Rev_Toast_Reabierto"].Value);
    }

    private async Task DejarAsync()
    {
        if (Pendientes < 2)
        {
            ToastService.Mostrar(Textos["Rev_Toast_SinOtro"].Value);
            return;
        }

        ToastService.Mostrar(Textos["Rev_Toast_Dejado"].Value);
        await Contexto.Dejar.InvokeAsync();
    }

    /// <summary>Lanza la acción; si devuelve un texto, es el motivo del fallo y el adjunto no cambia; si no, se avisa del nuevo estado.</summary>
    private async Task EjecutarAsync(BorradorRevision b, Func<Task<string?>> accion, EstadoAdjuntoVisor nuevo, string texto)
    {
        // Copias antes del primer await: el visor puede estar ya en otro adjunto cuando el Command termine (ver AsignarAsync).
        var contexto = Contexto;
        var adjuntoId = contexto.Adjunto.Id;
        var quedan = contexto.Pendientes - 1;
        var total = contexto.Total;
        _ocupado = true;
        b.Aviso = null;
        string? fallo;
        try
        {
            fallo = await accion();
        }
        catch (ValidationException ex)
        {
            fallo = ex.Errors.FirstOrDefault()?.ErrorMessage ?? Textos["Rev_Error"].Value;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning("La revisión del adjunto {AdjuntoId} falló ({Excepcion}).", adjuntoId, ex.GetType().Name);
            fallo = Textos["Rev_Error"].Value;
        }
        finally
        {
            _ocupado = false;
        }

        if (fallo is not null)
        {
            b.Aviso = fallo;
            // Con el visor ya en otro adjunto el aviso en línea no se ve: el fallo se dice aparte y con el nombre del archivo.
            if (Adjunto.Id != adjuntoId)
                ToastService.Mostrar(Textos["Rev_Toast_ErrorOtro", contexto.Adjunto.NombreArchivo, fallo].Value, TonoToast.Error);
            return;
        }

        ToastService.Mostrar(nuevo == EstadoAdjuntoVisor.Pendiente ? texto
            : quedan > 1 ? Textos["Rev_Toast_Quedan_N", texto, quedan].Value
            : quedan == 1 ? Textos["Rev_Toast_Quedan_1", texto].Value
            : Textos["Rev_Toast_Revisados", texto, total].Value, TonoToast.Exito);
        await contexto.Resolver.InvokeAsync(new ResolucionAdjuntoVisor(adjuntoId, nuevo));
    }

    private string NombreTipo(Guid? id) => Revision.Tipos.FirstOrDefault(t => t.Id == id)?.Nombre ?? string.Empty;

    private string NombreTipoResuelto(BorradorRevision b) => NombreTipo(b.Tipo ?? Propuesta?.TipoDocumentoId);

    private string? TextoResuelto(BorradorRevision b)
    {
        if (Adjunto.Estado == EstadoAdjuntoVisor.Rechazado)
            return b.Motivo.Length > 0 ? b.Motivo.Trim() : Propuesta?.MotivoRechazo;

        var destino = b.Destino?.Nombre ?? Revision.Destinos.FirstOrDefault(d => d.EsEmpresa ? d.Id == Propuesta?.EmpresaId : d.Id == Propuesta?.TrabajadorId)?.Nombre;
        var tipo = NombreTipoResuelto(b);
        return destino is null || tipo.Length == 0 ? null : Textos["Rev_Resuelto_AsignadoTxt", destino, tipo].Value;
    }
}
