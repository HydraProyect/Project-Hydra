@*
    Fila de la lista de conversaciones de la bandeja (ver Bandeja.razor) —
    componente aparte en vez de una plantilla inline porque se repite en dos
    secciones (Triage y agrupado por Cliente).
*@
@using CaeManager.Application.Comunicaciones.Queries.ObtenerConversaciones
@using CaeManager.Domain.Comunicaciones

<li class="bandeja-fila @(Activa ? "bandeja-fila-activa" : null) @(Conversacion.EsperandoCliente ? "bandeja-fila-esperando" : null)" @onclick="() => OnSeleccionar.InvokeAsync(Conversacion.Id)">
    <span class="bandeja-fila-avatar" aria-hidden="true">
        @ObtenerIniciales(Conversacion.RemitentePrincipal)
        <span class="bandeja-fila-canal bandeja-fila-canal-@Conversacion.Canal.ToString().ToLowerInvariant()" title="@(Conversacion.Canal == CanalConversacion.WhatsApp ? "WhatsApp" : "Correo")">
            <Icono Nombre="@(Conversacion.Canal == CanalConversacion.WhatsApp ? "chat" : "correo")" Tamano="TamanoIcono.Pequeno" />
        </span>
    </span>
    <div class="bandeja-fila-contenido">
        @* Dos líneas (D-26): el Cliente empresarial —o el remitente, en Triage,
           que es la única identidad que hay— en negrita con la fecha, y debajo el
           asunto entero en su propia línea. «Cliente | Asunto» en una sola línea
           truncaba los dos en la columna de la lista. *@
        <div class="bandeja-fila-linea1">
            <span class="bandeja-fila-remitente" title="@(Conversacion.ClienteRazonSocial ?? Conversacion.RemitentePrincipal)">@(Conversacion.ClienteRazonSocial ?? Conversacion.RemitentePrincipal)</span>
            <span class="bandeja-fila-fecha">@FormatearFechaRelativa(Conversacion.FechaUltimoMensajeUtc)</span>
        </div>
        <div class="bandeja-fila-linea2">
            <span class="bandeja-fila-asunto" title="@Conversacion.Asunto">@Conversacion.Asunto</span>
        </div>
        <div class="bandeja-fila-linea3">
            <Badge Tono="TonoBadgeDeEstado(Conversacion.Estado)" Tamano="TamanoBadge.Pequeno">@Conversacion.Estado</Badge>
            @if (Conversacion.MensajesRuido > 0)
            {
                <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno" title="Mensajes ya clasificados como ruido (repetición o sin cambios) — sin novedad que atender">
                    @Conversacion.MensajesRuido mensaje@(Conversacion.MensajesRuido == 1 ? "" : "s") de ruido
                </Badge>
            }
            <span class="bandeja-fila-preview">@Conversacion.PreviewUltimoMensaje</span>
        </div>
    </div>
</li>

@code {
    [Parameter, EditorRequired] public ConversacionListaDto Conversacion { get; set; } = default!;
    [Parameter] public bool Activa { get; set; }
    [Parameter] public EventCallback<Guid> OnSeleccionar { get; set; }

    private static TonoBadge TonoBadgeDeEstado(EstadoConversacion estado) => estado switch
    {
        EstadoConversacion.Abierta => TonoBadge.Info,
        EstadoConversacion.Pendiente => TonoBadge.Info,
        _ => TonoBadge.Neutro
    };

    /// <summary>Mismo criterio que UnifiedTimeline.ObtenerIniciales: dos letras del remitente para el avatar, sin depender de un nombre completo que este DTO no siempre trae.</summary>
    private static string ObtenerIniciales(string remitente)
    {
        var local = remitente.Split('@')[0];
        return local.Length >= 2 ? local[..2].ToUpperInvariant() : local.ToUpperInvariant();
    }

    private static string FormatearFechaRelativa(DateTime fechaUtc)
    {
        var transcurrido = DateTime.UtcNow - fechaUtc;

        if (transcurrido.TotalMinutes < 1) return "ahora";
        if (transcurrido.TotalMinutes < 60) return $"hace {(int)transcurrido.TotalMinutes} min";
        if (transcurrido.TotalHours < 24) return $"hace {(int)transcurrido.TotalHours} h";
        if (transcurrido.TotalDays < 30) return $"hace {(int)transcurrido.TotalDays} d";

        return fechaUtc.EnHoraPeninsular().ToString("dd/MM/yyyy");
    }
}
