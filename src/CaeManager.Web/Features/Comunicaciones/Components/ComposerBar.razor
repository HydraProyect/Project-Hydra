@*
    Barra de respuesta única del Communication Workspace (docs/COMUNICACIONES.md
    § 12.4/§ 11): antes eran dos composers separados (Bandeja para correo,
    Chat para WhatsApp) — ahora es un solo componente que cambia de modo
    según Canal. Presentacional puro (como FilaConversacion): el estado y las
    llamadas a Mediator siguen viviendo en la página, este componente solo
    pinta y dispara eventos.
*@
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Comunicaciones.Queries.ObtenerMacros
@using CaeManager.Application.Integraciones
@using CaeManager.Domain.Comunicaciones
@using Microsoft.AspNetCore.Components.Forms

<div class="composer">
    @if (Canal == CanalConversacion.WhatsApp && !VentanaAbierta)
    {
        <div class="composer-banner composer-banner-cerrado">
            <Icono Nombre="alertas" Tamano="TamanoIcono.Pequeno" />
            <span>Han pasado más de 24 h desde el último mensaje del contacto — WhatsApp bloquea el envío libre hasta que
            escriba de nuevo. Puedes continuar la conversación por correo.</span>
        </div>

        <div class="composer-fallback">
            <CampoTexto Etiqueta="Correo del contacto" Placeholder="cliente@empresa.com" Valor="@EmailFallback" ValorChanged="v => EmailFallbackChanged.InvokeAsync(v)" />
            <CampoTextarea Valor="@Texto" ValorChanged="v => TextoChanged.InvokeAsync(v)" Filas="3" Placeholder="Escribe tu mensaje…" />
            <div class="composer-acciones">
                <Boton Cargando="Enviando" Deshabilitado="@(string.IsNullOrWhiteSpace(Texto) || string.IsNullOrWhiteSpace(EmailFallback))"
                       OnClick="() => OnEnviarFallbackCorreo.InvokeAsync()">
                    Continuar por correo
                </Boton>
            </div>
        </div>
    }
    else if (Canal == CanalConversacion.WhatsApp)
    {
        <div class="composer-banner composer-banner-abierto">
            <Icono Nombre="chat" Tamano="TamanoIcono.Pequeno" />
            <span>Ventana de respuesta abierta — se cierra @CierreVentanaLocal.</span>
        </div>

        <div class="composer-whatsapp">
            <textarea class="composer-whatsapp-input" rows="2" placeholder="Escribe un mensaje…"
                      disabled="@Enviando" value="@Texto"
                      @oninput="e => TextoChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                      @onkeydown="ManejarTeclaAsync"></textarea>
            <Boton Cargando="Enviando" Deshabilitado="@string.IsNullOrWhiteSpace(Texto)" OnClick="() => OnEnviar.InvokeAsync()" class="composer-boton-enviar-circular">
                <Icono Nombre="enviar" Tamano="TamanoIcono.Pequeno" />
            </Boton>
        </div>
    }
    else
    {
        <div class="composer-correo">
            <div class="composer-correo-prellenados">
                <CampoSelect Etiqueta="Macro / plantilla" Valor="@MacroSeleccionadaId" ValorChanged="v => OnAplicarMacro.InvokeAsync(v)">
                    <option value="">Sin macro</option>
                    @foreach (var macro in Macros)
                    {
                        <option value="@macro.Id">@macro.Titulo</option>
                    }
                </CampoSelect>

                @if (Centros.Count > 0)
                {
                    <CampoSelect Etiqueta="Compartir formatos de centro" Valor="@CentroFormatosSeleccionado" ValorChanged="v => OnCompartirFormatos.InvokeAsync(v)">
                        <option value="">Selecciona un centro…</option>
                        @foreach (var centro in Centros)
                        {
                            <option value="@centro.Id">@centro.Nombre</option>
                        }
                    </CampoSelect>
                }
            </div>

            <CampoTextarea Valor="@Texto" ValorChanged="v => TextoChanged.InvokeAsync(v)" Filas="4" Placeholder="Escribe tu respuesta…" />

            @if (AdjuntosPendientes.Count > 0)
            {
                <div class="composer-adjuntos-pendientes">
                    @foreach (var adjunto in AdjuntosPendientes)
                    {
                        <span class="composer-adjunto-chip">
                            <Icono Nombre="documentos" Tamano="TamanoIcono.Pequeno" />
                            <span class="composer-adjunto-nombre">@adjunto.NombreArchivo</span>
                            <button type="button" class="composer-adjunto-quitar" aria-label="Quitar @adjunto.NombreArchivo" @onclick="() => OnQuitarAdjunto.InvokeAsync(adjunto)">×</button>
                        </span>
                    }
                </div>
            }
            @if (ErrorAdjuntos is not null)
            {
                <p class="composer-adjuntos-error">@ErrorAdjuntos</p>
            }

            <div class="composer-acciones">
                <label class="composer-boton-adjuntar" title="Adjuntar archivo">
                    <Icono Nombre="importar" Tamano="TamanoIcono.Pequeno" /> Adjuntar
                    <InputFile OnChange="e => OnArchivosSeleccionados.InvokeAsync(e)" multiple />
                </label>
                <Boton Cargando="Enviando" Deshabilitado="@(string.IsNullOrWhiteSpace(Texto) || ErrorAdjuntos is not null)" OnClick="() => OnEnviar.InvokeAsync()">
                    Enviar
                </Boton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CanalConversacion Canal { get; set; }
    [Parameter] public bool VentanaAbierta { get; set; } = true;
    [Parameter] public string CierreVentanaLocal { get; set; } = string.Empty;

    [Parameter] public string Texto { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextoChanged { get; set; }
    [Parameter] public bool Enviando { get; set; }
    [Parameter] public EventCallback OnEnviar { get; set; }

    // --- Modo Correo ---
    [Parameter] public IReadOnlyList<MacroListaDto> Macros { get; set; } = [];
    [Parameter] public string MacroSeleccionadaId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnAplicarMacro { get; set; }
    [Parameter] public IReadOnlyList<CentroSelectorDto> Centros { get; set; } = [];
    [Parameter] public string CentroFormatosSeleccionado { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnCompartirFormatos { get; set; }
    [Parameter] public IReadOnlyList<AdjuntoParaEnviarDto> AdjuntosPendientes { get; set; } = [];
    [Parameter] public string? ErrorAdjuntos { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnArchivosSeleccionados { get; set; }
    [Parameter] public EventCallback<AdjuntoParaEnviarDto> OnQuitarAdjunto { get; set; }

    // --- Fallback de canal WhatsApp→correo (§ 16.5) ---
    [Parameter] public string EmailFallback { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> EmailFallbackChanged { get; set; }
    [Parameter] public EventCallback OnEnviarFallbackCorreo { get; set; }

    /// <summary>Enter envía, Shift+Enter hace salto de línea — convención de chat.</summary>
    private Task ManejarTeclaAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e) =>
        e.Key == "Enter" && !e.ShiftKey ? OnEnviar.InvokeAsync() : Task.CompletedTask;
}
