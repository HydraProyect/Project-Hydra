@page "/comunicaciones"
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Features.Comunicaciones.Recursos.TextosPlazosConversacion> TextosPlazos
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@* Mismos roles que el menú completo de CatalogoMenuLateral: la bandeja es una pantalla de
   gestión CAE y el rol Cliente no entra. Que el menú le oculte el enlace no
   basta — decide qué pestañas existen, no qué puede pedirse por URL
   (hallazgo N-2 de Project-Hydra-Negocio/seguridad/INFORME-AUDITORIA-2.md).
   Communication Workspace unificado (Project-Hydra-Negocio/tecnico/docs/COMUNICACIONES.md § 16, paso 2 del
   rediseño): una sola bandeja para Correo y WhatsApp — /comunicaciones/chat
   ya no existe como pantalla aparte (principio § 10.2). *@
@attribute [Authorize(Roles = RolesComunicaciones.Gestion)]
@using CaeManager.Web.Features.Documentos.Recursos
@using CaeManager.Application.Comunicaciones.Queries.ObtenerConversaciones
@using CaeManager.Application.Comunicaciones.Queries.ObtenerConversacionPorId
@using CaeManager.Application.Comunicaciones.Queries.ObtenerCompanerosGestorCae
@using CaeManager.Domain.Comunicaciones
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Comunicaciones.Components
@using Microsoft.AspNetCore.Components.Forms
@using MediatR
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Web.Features.Comunicaciones.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosListaConversaciones> TextosLista
@inject IStringLocalizer<TextosIntencionesCae> TextosIntenciones
@inject IStringLocalizer<TextosEstadosConversacion> TextosEstados
@inject IStringLocalizer<TextosCompanerosGestorCae> TextosCompaneros
@inject IMediator Mediator
@inject ToastService ToastService

<LimiteDeErrores Pagina="this">
<PageTitle>Comunicaciones — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina bandeja-contenedor">
    <div class="bandeja-layout @(_vista != "clientes" ? "bandeja-modo-personal" : _conversacionSeleccionadaId is null ? "bandeja-modo-tabla" : "bandeja-modo-hilo")">
        <aside class="bandeja-columna bandeja-filtros">
            @* Gen 2 («Comunicaciones TALVEG.dc.html»): el título de la pantalla
               y "Redactar" viven en la cabecera de la columna de la lista, no en
               una banda de cabecera sobre las tres columnas. Por eso esta página
               NO usa CabeceraPagina como el resto del programa Gen 2: su mockup
               es un maestro-detalle a pantalla completa y una banda superior le
               robaría alto a las tres columnas.

               "Buzón completo" (explorador técnico de carpetas M365, /comunicaciones/buzon)
               se retira de esta barra de trabajo diaria: el modelo aprobado gira en torno
               a conversaciones. El Buzón sigue existiendo como diagnóstico técnico — su
               punto de entrada pasa a Integraciones (propiedad de esa sesión, no de esta
               página). Las macros vuelven al redactor por decisión de producto del
               2026-10-23; su administración conserva la ruta /comunicaciones/macros. *@
            <div class="bandeja-lista-cabecera">
                <h1 class="bandeja-lista-titulo">Comunicaciones</h1>
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" OnClick="AbrirRedactarAsync">Redactar</Boton></SoloConEscritura>
            </div>

            @* Toggle "Clientes | Mi buzón personal" (rediseño acordado, ver
               memoria hydra-buzon-personal-rediseno-pendiente): sustituye a
               /comunicaciones/buzon-personal como página aislada — el buzón
               personal del gestor ahora vive dentro del mismo maestro-detalle,
               solo que de solo lectura (sin Composer ni Action Center, ver más
               abajo), porque hoy no existe ningún comando de "responder" para
               un mensaje del buzón personal. Es la anotación del mockup: «el
               toggle Clientes / Mi buzón vive dentro de la bandeja, no en una
               página aparte». /comunicaciones/buzon es OTRA pantalla —
               explorador de carpetas de Microsoft 365— y no es lo que este
               toggle abre. *@
            <div class="bandeja-vista-toggle" role="tablist" aria-label="Ámbito de la bandeja">
                <button type="button" role="tab" aria-selected="@(_vista == "clientes" ? "true" : "false")"
                        class="bandeja-toggle @(_vista == "clientes" ? "bandeja-toggle-activo" : null)" @onclick='() => CambiarVistaAsync("clientes")'>
                    Clientes
                </button>
                <button type="button" role="tab" aria-selected="@(_vista == "personal" ? "true" : "false")"
                        class="bandeja-toggle @(_vista == "personal" ? "bandeja-toggle-activo" : null)" @onclick='() => CambiarVistaAsync("personal")'>
                    Mi buzón personal
                </button>
            </div>

            @* «Contactar con un compañero»: correo y teléfono de los demás Gestores CAE de mi mismo
               Operador CAE, copiables. Lo que llega ya viene acotado en Application
               (ObtenerCompanerosGestorCaeQuery): esta página no filtra nada. Quien no es Gestor CAE
               recibe la lista vacía y no ve la sección. *@
            @if (_companeros.Count > 0)
            {
                <details class="companeros">
                    <summary>@TextosCompaneros["Titulo"]</summary>
                    <p class="companeros-ayuda">@TextosCompaneros["Ayuda"]</p>
                    <ul class="companeros-lista">
                        @foreach (var companero in _companeros)
                        {
                            <li @key="companero.UsuarioId" class="companero">
                                <span class="companero-nombre">@companero.Nombre</span>
                                <span class="companero-dato">
                                    <span class="companero-rotulo">@TextosCompaneros["Correo"]</span>
                                    @if (companero.Correo is { } correo)
                                    {
                                        <span class="companero-valor">@correo</span>
                                        <BotonCopiar Valor="@correo" Texto="@TextosCompaneros["CopiarCorreo"].Value" NombreAccesible="@TextosCompaneros["AccesibleCorreo", companero.Nombre].Value"
                                                     Etiqueta="@TextosCompaneros["EtiquetaCorreo", companero.Nombre].Value" />
                                    }
                                    else
                                    {
                                        <span class="companero-sin-dato">@TextosCompaneros["SinCorreo"]</span>
                                    }
                                </span>
                                <span class="companero-dato">
                                    <span class="companero-rotulo">@TextosCompaneros["Telefono"]</span>
                                    @if (companero.Telefono is { } telefono)
                                    {
                                        <span class="companero-valor">@telefono</span>
                                        <BotonCopiar Valor="@telefono" Texto="@TextosCompaneros["CopiarTelefono"].Value" NombreAccesible="@TextosCompaneros["AccesibleTelefono", companero.Nombre].Value"
                                                     Etiqueta="@TextosCompaneros["EtiquetaTelefono", companero.Nombre].Value" />
                                    }
                                    else
                                    {
                                        <span class="companero-sin-dato">@TextosCompaneros["SinTelefono"]</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </details>
            }

            @if (_vista == "clientes")
            {
                <div class="bandeja-filtros-form">
                    @if (_conversacionSeleccionadaId is not null)
                    {
                        <CampoTexto Etiqueta="@TextosLista["BuscarBuzon"]" Placeholder="@TextosLista["BuscarPlaceholder"]" Valor="@_busqueda" ValorChanged="async v => { _busqueda = v; await AplicarFiltrosAsync(); }" />
                    }

                    <div class="bandeja-toggles">
                        <button type="button" class="bandeja-toggle @(!_soloAsignadasAMi && !_soloSinAsignar && !_soloEsperandoCliente && !_soloFueraDeSla ? "bandeja-toggle-activo" : null)" @onclick="VerTodasAsync">
                            Todas
                        </button>
                        <button type="button" class="bandeja-toggle @(_soloAsignadasAMi ? "bandeja-toggle-activo" : null)" @onclick="FiltrarAsignadasAMiAsync">
                            @TextosLista["Mias"]
                        </button>
                        <button type="button" class="bandeja-toggle @(_soloSinAsignar ? "bandeja-toggle-activo" : null)" @onclick="FiltrarSinAsignarAsync">
                            Sin asignar
                        </button>
                        <button type="button" class="bandeja-toggle @(_soloEsperandoCliente ? "bandeja-toggle-activo" : null)" @onclick="AlternarEsperandoCliente">
                            @TextosLista["EsperandoCliente"]
                        </button>

                    </div>

                    <details class="bandeja-filtros-avanzados">
                        <summary>Más filtros</summary>
                        <div class="bandeja-filtros-avanzados-campos">
                            <CampoSelect Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="async v => { _estadoFiltro = v; await AplicarFiltrosAsync(); }">
                                <option value="">Todos los estados</option>
                                @foreach (var estado in EstadoConversacionPresentacion.EnOrdenDeSelector)
                                {
                                    <option value="@estado.ToString()">@EstadoConversacionPresentacion.Etiqueta(TextosEstados, estado)</option>
                                }
                            </CampoSelect>

                            <CampoSelect Etiqueta="@TextosIntenciones["EtiquetaIntencion"]" Valor="@_intencionFiltro" ValorChanged="async v => { _intencionFiltro = v; await AplicarFiltrosAsync(); }">
                                <option value="">@TextosIntenciones["TodasIntenciones"]</option>
                                @foreach (var intencion in IntencionesCae)
                                {
                                    <option value="@intencion">@TextosIntenciones[$"Intencion_{intencion}"]</option>
                                }
                            </CampoSelect>
                            <CampoTexto Etiqueta="Mes" Type="month" Valor="@_mesFiltro" ValorChanged="async v => { _mesFiltro = v; await AplicarFiltrosAsync(); }" />

                            <CampoSelect Etiqueta="Cliente" Valor="@_clienteIdFiltro" ValorChanged="async v => { _clienteIdFiltro = v; await AplicarFiltrosAsync(); }">
                                <option value="">Todos los Clientes</option>
                                @foreach (var cliente in _clientesSelector)
                                {
                                    <option value="@cliente.Id">@cliente.RazonSocial</option>
                                }
                            </CampoSelect>
                        </div>
                    </details>
                </div>

                <AtajosListaTeclado OnAtajo="ManejarAtajoListaAsync" />
                @if (_conversacionSeleccionadaId is not null)
                {
                    <div class="bandeja-lista">
                        @if (_errorCargaLista)
                        {
                            <EstadoVacio Titulo="@TextosLista["ErrorBuzon"]">
                                <Accion><Boton Variante="VarianteBoton.Secundario" OnClick="CargarListaAsync">@TextosLista["Reintentar"]</Boton></Accion>
                            </EstadoVacio>
                        }
                        else if (_cargandoLista)
                        {
                            <EstadoCargando Filas="6" />
                        }
                        else
                        {
                            <ul class="bandeja-grupo-filas">
                                @foreach (var conversacion in _conversaciones)
                                {
                                    <FilaConversacion Conversacion="conversacion" Activa="@(conversacion.Id == _conversacionSeleccionadaId)" Enfocada="@(conversacion.Id == _idEnfocado)" OnSeleccionar="SeleccionarConversacionAsync" />
                                }
                            </ul>
                            @if (TotalPaginas > 1)
                            {
                                <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalConversaciones"
                                                  Etiqueta="@TextosLista["Conversaciones"]" PaginaActualChanged="CambiarPaginaBandejaAsync" />
                            }
                        }
                    </div>
                }
            }
            else
            {
                <p class="bandeja-vista-personal-descripcion">
                    Correo que llega a tu buzón personal de Microsoft 365, no al de ningún Cliente — notificaciones de
                    plataformas externas a tu nombre, correo interno y correo que no reconocemos. Solo lectura: no hay
                    Composer aquí, no hay ninguna gestión CAE que atender.
                </p>

                <div class="bandeja-lista">
                    @if (_errorCargaLista)
                    {
                        <EstadoVacio Titulo="No pudimos cargar el buzón" Descripcion="Intenta nuevamente en unos segundos.">
                            <Accion>
                                <Boton Variante="VarianteBoton.Primario" OnClick="CargarBuzonPersonalAsync">Reintentar</Boton>
                            </Accion>
                        </EstadoVacio>
                    }
                    else if (_cargandoLista)
                    {
                        <EstadoCargando Filas="6" />
                    }
                    else if (_mensajesBuzonPersonal.Count == 0)
                    {
                        <EstadoVacio Titulo="Sin buzón personal conectado"
                                     Descripcion="Pide a un administrador que conecte tu buzón personal desde Integraciones, o todavía no ha llegado ningún correo." />
                    }
                    else
                    {
                        <ul class="bandeja-grupo-filas">
                            @foreach (var mensaje in _mensajesBuzonPersonal)
                            {
                                <FilaMensajeBuzonPersonal Mensaje="mensaje" Activa="@(mensaje.ConversacionId == _conversacionSeleccionadaId)" OnSeleccionar="SeleccionarConversacionAsync" />
                            }
                        </ul>
                    }
                </div>
            }
        </aside>

        @* D-26: divisor arrastrable (y con flechas) del ancho de la columna anterior; vive en el
           hueco entre columnas (absoluto, no es una celda de la rejilla) para no tapar la barra de
           desplazamiento de la lista. Lo gestiona wwwroot/js/panel-redimensionable.js, sin interop. *@
        <div class="bandeja-divisor" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="@TextosLista["AjustarAnchoLista"]"
             aria-valuemin="260" aria-valuemax="560" aria-valuenow="360"
             data-redimensionable="--bandeja-lista-ancho" data-min="260" data-max="560"></div>

        <section class="bandeja-columna bandeja-centro" aria-label="@TextosLista["Conversacion"]">
            @if (_conversacionSeleccionadaId is null && _vista == "clientes")
            {
                <div class="bandeja-tabla-cabecera">
                    <h2>@TextosLista[_soloAsignadasAMi ? "Mias" : _soloSinAsignar ? "SinAsignar" : _soloEsperandoCliente ? "EsperandoCliente" : "Todas"]</h2>
                    <span>@TextosLista[_totalConversaciones == 1 ? "RecuentoConversacion" : "RecuentoConversaciones", _totalConversaciones]</span>
                    <label class="bandeja-buscar">
                        <Icono Nombre="buscar" Tamano="TamanoIcono.Pequeno" />
                        <input type="search" aria-label="@TextosLista["BuscarBuzon"]" placeholder="@TextosLista["BuscarPlaceholder"]" value="@_busqueda"
                               @oninput="async e => { _busqueda = e.Value?.ToString() ?? string.Empty; await AplicarFiltrosAsync(); }" />
                    </label>
                </div>
                @if (_errorCargaLista)
                {
                    <EstadoVacio Titulo="@TextosLista["ErrorBuzon"]" Descripcion="@TextosLista["ErrorBuzonAyuda"]">
                        <Accion><Boton Variante="VarianteBoton.Primario" OnClick="CargarListaAsync">@TextosLista["Reintentar"]</Boton></Accion>
                    </EstadoVacio>
                }
                else if (_cargandoLista)
                {
                    <EstadoCargando Filas="6" />
                }
                else if (_conversaciones.Count > 0)
                {
                    <TablaConversaciones Conversaciones="_conversaciones" EnfocadaId="_idEnfocado" NombresAsignados="_ejecutivosDisponibles.ToDictionary(e => e.Id, e => e.NombreCompleto)" OnAbrir="SeleccionarConversacionAsync" />
                    @if (TotalPaginas > 1)
                    {
                        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalConversaciones"
                                          Etiqueta="@TextosLista["Conversaciones"]" PaginaActualChanged="CambiarPaginaBandejaAsync" />
                    }
                }
                else
                {
                    <EstadoVacio Titulo="@(HayFiltrosActivos ? TextosLista["SinResultados"] : TextosLista["SinConversaciones"])"
                                 Descripcion="@(HayFiltrosActivos ? TextosLista["SinResultadosAyuda"] : TextosLista["SinConversacionesAyuda"])">
                        <Accion>
                            @if (HayFiltrosActivos)
                            {
                                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@TextosLista["QuitarFiltros"]</Boton>
                            }
                        </Accion>
                    </EstadoVacio>
                }
            }
            else if (_conversacionSeleccionadaId is null)
            {
                <EstadoVacio Titulo="Selecciona una conversación" Descripcion="Elige un hilo de la izquierda para ver los mensajes." />
            }
            else if (_cargandoDetalle)
            {
                <EstadoCargando Filas="4" />
            }
            else if (_detalle is not null)
            {
                <div class="bandeja-centro-cabecera">
                    <div class="bandeja-centro-titulo">
                        <div class="bandeja-centro-titulo-fila">
                            <button type="button" class="bandeja-volver" aria-label="@TextosLista["VolverBandeja"]" @onclick="VolverABandejaAsync"><Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /></button>
                            <h2>@_detalle.Asunto</h2>
                            <button type="button" class="bandeja-centro-copiar-enlace" data-tooltip="Copiar enlace a esta conversación"
                                    aria-label="Copiar enlace a esta conversación" @onclick="CopiarEnlaceAsync">
                                <Icono Nombre="copiar" Tamano="TamanoIcono.Pequeno" />
                            </button>
                        </div>
                        <div class="bandeja-centro-meta">
                            <span class="bandeja-badge-canal bandeja-badge-canal-@_detalle.Canal.ToString().ToLowerInvariant()" title="@(_detalle.Canal == CanalConversacion.WhatsApp ? "WhatsApp" : "Correo")">
                                <Icono Nombre="@(_detalle.Canal == CanalConversacion.WhatsApp ? "chat" : "correo")" Tamano="TamanoIcono.Pequeno" />
                                @(_detalle.Canal == CanalConversacion.WhatsApp ? "WhatsApp" : "Correo")
                            </span>
                            <Badge Tono="EstadoConversacionPresentacion.Tono(_detalle.Estado)">@EstadoConversacionPresentacion.Etiqueta(TextosEstados, _detalle.Estado)</Badge>
                            @if (_detalle.EsConversacionInformativaPreCae)
                            {
                                <Badge Tono="TonoBadge.Neutro" title="@(_detalle.ResumenRelevanciaCae ?? "Todavía no se ha pedido ni mencionado ninguna gestión CAE en esta conversación.")">
                                    Contexto de negocio — sin gestión CAE todavía
                                </Badge>
                            }
                            <span class="bandeja-centro-subtitulo">@(_detalle.ClienteRazonSocial ?? "Sin Cliente asignado")</span>
                        </div>
                    </div>
                    <div class="bandeja-centro-acciones">
                        <PanelIntencionConversacion @key="_detalle.Id" ConversacionId="_detalle.Id" />
                        <MedidorTiempoGestion @ref="_medidorTiempo" ConversacionId="_detalle.Id" />

                        @if (_vista == "clientes")
                        {
                          <SoloConEscritura>
                            @if (_detalle.ClienteId is null)
                            {
                                <CampoSelect Valor="@_clienteTriageSeleccionado" ValorChanged="v => _clienteTriageSeleccionado = v">
                                    <option value="">Asignar Cliente…</option>
                                    @foreach (var cliente in _clientesSelector)
                                    {
                                        <option value="@cliente.Id">@cliente.RazonSocial</option>
                                    }
                                </CampoSelect>
                                <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Secundario"
                                       Deshabilitado="string.IsNullOrEmpty(_clienteTriageSeleccionado)" Cargando="_asignandoCliente" OnClick="AsignarClienteTriageAsync">
                                    Asignar
                                </Boton>
                            }


                            <CampoSelect Etiqueta="@TextosLista["Estado"]" @key="_intentosCambioEstado" Valor="@_detalle.Estado.ToString()" ValorChanged="CambiarEstadoDesdeSelectorAsync" Deshabilitado="_cambiandoEstado">
                                @foreach (var estado in EstadoConversacionPresentacion.EnOrdenDeSelector.Where(e => e != EstadoConversacion.Pendiente || e == _detalle.Estado))
                                {
                                    <option value="@estado.ToString()" disabled="@(estado == EstadoConversacion.Cerrada || !TransicionesEstadoConversacion.EstaPermitida(_detalle.Estado, estado))">@EstadoConversacionPresentacion.Etiqueta(TextosEstados, estado)</option>
                                }
                            </CampoSelect>
                            <CampoSelect Etiqueta="@TextosPlazos["Prioridad"]" Valor="@_detalle.Prioridad.ToString()" ValorChanged="CambiarPrioridadAsync" Deshabilitado="_cambiandoPrioridad">
                                <option value="Normal">@TextosPlazos["Normal"]</option>
                                <option value="Urgente">@TextosPlazos["Urgente"]</option>
                                <option value="Critica">@TextosPlazos["Critica"]</option>
                            </CampoSelect>
                            @if (_detalle.ClienteId is not null)
                            {
                                <CampoSelect Etiqueta="@TextosLista["AsignadaA"]" Valor="@_ejecutivoSeleccionado" ValorChanged="CambiarEjecutivoAsync" Deshabilitado="_cambiandoEjecutivo">
                                    <option value="">@TextosLista["SinAsignar"]</option>
                                    @foreach (var ejecutivo in _ejecutivosDisponibles)
                                    {
                                        <option value="@ejecutivo.Id">@ejecutivo.NombreCompleto</option>
                                    }
                                </CampoSelect>
                            }

                          </SoloConEscritura>
                        }
                    </div>
                </div>

                <AlertaCriticaConversacionPanel @key="_detalle.Id" ConversacionId="_detalle.Id" Asunto="@_detalle.Asunto" />
                <ResumenCierreConversacion Detalle="_detalle" />
                <UnifiedTimeline Mensajes="_detalle.Mensajes" Participantes="_detalle.Participantes" Eventos="_detalle.Eventos"
                                  NotasInternas="_notasInternas" AutoresNotas="_autoresNotas" AvataresNotas="_avataresNotas"
                                  OnActualizarDocumentoDesdeAdjunto="AbrirActualizarDocumentoAsync" OnConfirmarRuido="ConfirmarRuidoAsync" />

                @if (_vista == "clientes")
                {
                  <SoloConEscritura>
                    <RecordatorioPropuesto ConversacionId="_detalle.Id" Asunto="@_detalle.Asunto" Estado="_detalle.Estado"                                           FechaUltimoMensajeUtc="_detalle.FechaUltimoMensajeUtc" OnEnviado="CargarDetalleAsync" />

                    <div class="hilo-editor-cabecera">
                        <div class="bandeja-editor-tabs" role="group" aria-label="@TextosLista["TipoMensaje"]">
                            <button type="button" aria-pressed="@(!_notaInternaActiva ? "true" : "false")" @onclick="() => _notaInternaActiva = false">@TextosLista["RespuestaPublica"]</button>
                            <button type="button" aria-pressed="@(_notaInternaActiva ? "true" : "false")" @onclick="() => _notaInternaActiva = true">@TextosLista["NotaInterna"]</button>
                        </div>
                    </div>
                    <div class="bandeja-editor-publico" hidden="@_notaInternaActiva">
                    <ComposerBar Canal="_detalle.Canal" VentanaAbierta="VentanaAbierta" CierreVentanaLocal="@CierreVentanaLocal"
                                 Texto="@_textoRespuesta" TextoChanged="v => _textoRespuesta = v" Enviando="_enviando" OnEnviar="EnviarAsync"
                                 Macros="_macrosDisponibles" MacroSeleccionadaId="@_macroSeleccionadaId" OnAplicarMacro="AplicarMacro"
                                 Centros="_centrosClienteActivo" CentroFormatosSeleccionado="@_centroFormatosSeleccionado" OnCompartirFormatos="CompartirFormatosCentroAsync"
                                 AdjuntosPendientes="_adjuntosPendientes" ErrorAdjuntos="@_errorAdjuntos"
                                 OnArchivosSeleccionados="ManejarArchivosAdjuntosAsync" OnQuitarAdjunto="QuitarAdjuntoPendiente"
                                 EmailFallback="@_emailFallback" EmailFallbackChanged="v => _emailFallback = v" OnEnviarFallbackCorreo="EnviarFallbackCorreoAsync" />

                    </div>
                    <div class="bandeja-editor-nota" hidden="@(!_notaInternaActiva)">
                    <ComposerNotaInterna @key="_detalle.Id" @ref="_composerNota" ConversacionId="_detalle.Id" OnNotaCreada="RecargarNotasInternasAsync"
                                         OnTextoCambiado="AlCambiarNotaInterna" />
                    </div>
                  </SoloConEscritura>

                  @* Pie del editor, como en la maqueta: «Siguiente conversación» navega, no escribe, así que
                     queda FUERA de SoloConEscritura y el rol Consulta también avanza. Solo recorre la lista
                     ya cargada (mismos filtros y Asignación de Cartera). *@
                    <div class="hilo-editor-pie">
                        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="@(_cargandoLista || _cambiandoEstado || !HaySiguienteConversacion)" OnClick="SiguienteConversacionAsync">@TextosLista["SiguienteConversacion"]</Boton>
                    </div>

                  <SoloConEscritura>
                    @*
                        "Pedir prioridad" del mockup (Parte XVI PROMPT 09), a nivel
                        conversación — el comando ya existía y funcionaba desde
                        Centro 360 (CentroWorkspacePanel), aquí solo se cablea al
                        mismo Centro que el gestor ya eligió arriba para
                        "Compartir formatos de centro": la conversación es de un
                        Cliente, que puede tener varios Centros, así que hace
                        falta que el gestor haya elegido uno antes de poder pedir
                        prioridad sobre él.
                    *@
                    @if (!string.IsNullOrEmpty(_centroFormatosSeleccionado))
                    {
                        <div class="acordeon-asignaciones-cabecera">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPedirPrioridadAsync">
                                Pedir prioridad de validación
                            </Boton>
                        </div>
                    }
                  </SoloConEscritura>
                }
                else
                {
                    <p class="bandeja-vista-personal-solo-lectura">Vista de solo lectura — no hay ninguna gestión CAE que atender aquí.</p>
                }
            }
        </section>

        @if (_vista == "clientes" && (_clienteActivo is not null || HayAccionesPendientes))
        {
            <aside class="bandeja-columna bandeja-cliente">
                <AccionCenter SugerenciasVisita="SugerenciasVisitaPendientes" SugerenciasGestion="SugerenciasGestionPendientes"
                              SugerenciaVinculacion="_detalle?.SugerenciaVinculacion"
                              CentrosDisponibles="_centrosClienteActivo" TrabajadoresDisponibles="_trabajadoresSelector" TiposDocumentoDisponibles="_tiposDocumentoSelector"
                              OnCrearVisitaDesdeSugerencia="args => IrACrearVisitaDesdeSugerencia(args.SugerenciaId, args.CentroId, args.FechaInicio, args.FechaFin)"
                              OnDescartarSugerenciaVisita="DescartarSugerenciaVisitaAsync"
                              OnGenerarGestionesDesdeSugerencia="args => GenerarGestionesDesdeSugerenciaAsync(args.SugerenciaId, args.TrabajadorId, args.TipoDocumentoId)"
                              OnDescartarSugerenciaGestion="DescartarSugerenciaGestionAsync"
                              OnVincularConversacion="VincularConversacionAsync" />

                @if (_clienteActivo is not null)
                {
                    <div class="bandeja-cliente-titulo">
                        <Icono Nombre="clientes" Tamano="TamanoIcono.Pequeno" /> Contexto del Cliente
                    </div>
                    <div class="bandeja-cliente-cabecera">
                        <span class="bandeja-cliente-avatar" aria-hidden="true">@ObtenerInicialesCliente(_clienteActivo.RazonSocial)</span>
                        <div class="bandeja-cliente-identidad">
                            <h3>@_clienteActivo.RazonSocial</h3>
                            <span class="bandeja-cliente-cif">CIF @_clienteActivo.Cif</span>
                        </div>
                        @if (_clienteActivo.EsCritico)
                        {
                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">Crítico</Badge>
                        }
                    </div>
                    <dl class="bandeja-cliente-datos">
                        <dt>Gestor CAE</dt>
                        <dd>@(_ejecutivosDisponibles.FirstOrDefault(e => e.Id == _clienteActivo.EjecutivoUsuarioId)?.NombreCompleto ?? "Sin asignar")</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_clienteActivo.Notas))
                    {
                        <div class="bandeja-cliente-notas">
                            <span class="bandeja-cliente-notas-titulo">Notas del Cliente</span>
                            <p>@_clienteActivo.Notas</p>
                        </div>
                    }

                    @if (_detalle?.DocumentosCitados.Count > 0)
                    {
                        <div class="bandeja-documentos-citados">
                            <span class="bandeja-cliente-notas-titulo">Documentos citados</span>
                            <ul class="bandeja-documentos-citados-lista">
                                @foreach (var documento in _detalle.DocumentosCitados)
                                {
                                    <li class="bandeja-documento-citado">
                                        @if (documento.DocumentoId is { } documentoId)
                                        {
                                            <a class="bandeja-documento-citado-nombre" href="@($"/documentos?documentoId={documentoId}")">@documento.TipoDocumentoNombre</a>
                                        }
                                        else
                                        {
                                            <span class="bandeja-documento-citado-nombre">@documento.TipoDocumentoNombre</span>
                                        }
                                        <span class="bandeja-documento-citado-meta">
                                            @if (documento.PropietarioNombre is not null)
                                            {
                                                <span class="bandeja-documento-citado-propietario">@documento.PropietarioNombre</span>
                                            }
                                            <Badge Tono="@NivelBadgeTono(documento.Nivel)" Tamano="TamanoBadge.Pequeno">@NivelBadgeEtiqueta(documento.Nivel)</Badge>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </aside>
        }
    </div>

    <ModalFormulario HayCambios="() => HayCambiosActualizarDocumento" Visible="_modalActualizarDocumentoVisible" VisibleChanged="v => { if (!v) CerrarModalActualizarDocumento(); }"
                    Titulo="Actualizar documentación" Ancho="AnchoModal.Grande" Guardando="_aplicandoDocumento" Cargando="_detectandoDocumento" FilasCargando="4" MensajeError="@_errorActualizarDocumento"
                    TextoCancelar="Cancelar" TextoGuardar="Aplicar y registrar" OnGuardar="AplicarActualizacionDocumentoAsync">
        <ChildContent>
            @if (_confianzaDeteccionDocumento > 0)
            {
                <p class="modal-actualizar-documento-confianza">
                    <Icono Nombre="ia" Tamano="TamanoIcono.Pequeno" /> Detección de la IA — confianza @_confianzaDeteccionDocumento%. Revisa y corrige antes de aplicar.
                </p>
            }
            <div class="modal-actualizar-documento-formulario">
                <CampoSelect Etiqueta="Tipo de documento" Valor="@_tipoDocumentoIdFormulario" ValorChanged="v => _tipoDocumentoIdFormulario = v">
                    <option value="">Selecciona un tipo…</option>
                    @foreach (var tipo in _tiposDocumentoSelector.Where(t => t.AmbitoAplicacion is AmbitoAplicacion.Trabajador or AmbitoAplicacion.Empresa))
                    {
                        <option value="@tipo.Id">@tipo.Nombre (@(tipo.AmbitoAplicacion == AmbitoAplicacion.Trabajador ? "Trabajador" : "Empresa"))</option>
                    }
                </CampoSelect>

                <CampoSelect Etiqueta="Pertenece a" Valor="@_propietarioDocumentoFormulario" ValorChanged="v => _propietarioDocumentoFormulario = v">
                    <option value="@nameof(AmbitoAplicacion.Trabajador)">Trabajador</option>
                    <option value="@nameof(AmbitoAplicacion.Empresa)">Empresa</option>
                </CampoSelect>

                @if (_propietarioDocumentoFormulario == nameof(AmbitoAplicacion.Trabajador))
                {
                    <CampoSelect Etiqueta="Trabajador" Valor="@_trabajadorDocumentoIdFormulario" ValorChanged="v => _trabajadorDocumentoIdFormulario = v">
                        <option value="">Selecciona un trabajador…</option>
                        @foreach (var trabajador in EtiquetasSelectorTrabajador.Construir(_trabajadoresSelector))
                        {
                            <option value="@trabajador.Id">@trabajador.Texto</option>
                        }
                    </CampoSelect>
                }
                else
                {
                    <CampoSelect Etiqueta="Empresa" Valor="@_empresaDocumentoIdFormulario" ValorChanged="v => _empresaDocumentoIdFormulario = v">
                        <option value="">Selecciona una empresa…</option>
                        @foreach (var empresa in _empresasSelector)
                        {
                            <option value="@empresa.Id">@empresa.RazonSocial</option>
                        }
                    </CampoSelect>
                }

                <CampoTexto Etiqueta="Fecha de emisión" Type="date" Valor="@_fechaEmisionDocumentoFormulario" ValorChanged="v => _fechaEmisionDocumentoFormulario = v" />
                <CampoTexto Etiqueta="Fecha de caducidad (si no se calcula sola)" Type="date" Valor="@_fechaVencimientoDocumentoFormulario" ValorChanged="v => _fechaVencimientoDocumentoFormulario = v" />
                <label class="campo-checkbox">
                    <input type="checkbox" checked="@_noCaducaDocumentoFormulario" @onchange="e => _noCaducaDocumentoFormulario = e.Value is bool m && m" />
                    @TextosVigenciaDocumento.Texto("NoCaduca")
                </label>
                <CampoTextarea Etiqueta="Comentarios" Valor="@_comentariosDocumentoFormulario" ValorChanged="v => _comentariosDocumentoFormulario = v" Filas="2" />
            </div>
    </ChildContent>
    </ModalFormulario>

    @*
        "Redactar" del toolbar (Parte XVI PROMPT 09) — inicia una conversación
        SIN partir de un hilo existente, a diferencia de ResponderConversacionCommand.
        Mismo EnviarMensajeNuevoCommand que ya usaba Buzon.razor, con la misma
        resolución de conexión que EnviarReclamacionCommand (genérica del
        tenant o específica del cliente si hay más de una) — si hay más de un
        buzón candidato se pide explícitamente, nunca se manda "a ciegas"
        desde el primero que aparezca.
    *@
    <DrawerFormulario HayCambios="() => HayCambiosRedactar" Visible="_redactarVisible" VisibleChanged="v => _redactarVisible = v" Titulo="Redactar mensaje"
            Guardando="_enviandoRedaccion" MensajeError="@_redactarError" SinContenido="@(_conexionesRedactar.Count == 0 ? SinBuzonRedactar : null)"
            MotivoGuardarDeshabilitado="@(_conexionesRedactar.Count == 0 ? TextosComunesPagina["SinBuzonMotivo"].Value : null)"
            TextoCancelar="Cancelar" TextoGuardar="Enviar" TextoGuardando="Enviar" OnGuardar="EnviarMensajeNuevoDesdeRedactarAsync">
        <ChildContent>
            @if (_conexionesRedactar.Count > 1)
            {
                <CampoSelect Etiqueta="Enviar desde" Valor="@(_conexionRedactarId?.ToString() ?? string.Empty)" ValorChanged="v => _conexionRedactarId = Guid.TryParse(v, out var id) ? id : null">
                    <option value="">Selecciona un buzón…</option>
                    @foreach (var conexion in _conexionesRedactar)
                    {
                        <option value="@conexion.Id">@conexion.Nombre (@conexion.BuzonEmail)</option>
                    }
                </CampoSelect>
            }

            <CampoTexto Etiqueta="Para (separados por coma)" Valor="@_redactarDestinatarios" ValorChanged="v => _redactarDestinatarios = v" Placeholder="contacto@cliente.com" />
            <CampoTexto Etiqueta="Asunto" Valor="@_redactarAsunto" ValorChanged="v => _redactarAsunto = v" />
            <CampoTextarea Etiqueta="Mensaje" Valor="@_redactarCuerpo" ValorChanged="v => _redactarCuerpo = v" Filas="6" />
        </ChildContent>
    </DrawerFormulario>

    @* "Pedir prioridad" a nivel conversación — mismo Drawer que ya usa CentroWorkspacePanel, aquí sobre el Centro elegido en el composer. *@
    <DrawerFormulario HayCambios="() => HayCambiosPrioridad" Visible="_drawerPrioridadVisible" VisibleChanged="v => _drawerPrioridadVisible = v"
            Titulo="Pedir prioridad de validación" Guardando="_enviandoPrioridad" Cargando="_cargandoBorradorPrioridad" FilasCargando="3"
            MensajeError="@(_borradorPrioridad is null ? null : _mensajeErrorPrioridad)" SinContenido="SinBorradorPrioridad"
            MotivoGuardarDeshabilitado="@(_borradorPrioridad is null ? (_mensajeErrorPrioridad ?? ErroresTextos["ErrorBorradorPrioridad"].Value) : null)"
            TextoCancelar="Cancelar" TextoGuardar="Enviar" TextoGuardando="Enviar" OnGuardar="EnviarPrioridadAsync">
        <ChildContent>
            @if (_borradorPrioridad is not null)
            {
                @if (!_borradorPrioridad.HayConexionDisponible)
                {
                    <AvisoSinBuzonCorreo TextoParaCopiar="@AvisoSinBuzonCorreo.TextoDeCorreo(_asuntoPrioridad, AvisoSinBuzonCorreo.HtmlATexto(_cuerpoPrioridad))" Destinatarios="@_destinatarioPrioridad" />
                }
                @if (_borradorPrioridad.UltimaSolicitudEnviadaEnUtc is { } ultima)
                {
                    <p class="workspace-nota-contextual">Ya se pidió prioridad para este centro el @ultima.EnHoraPeninsular().ToString("dd/MM/yyyy HH:mm").</p>
                }
                <CampoTexto Etiqueta="Destinatarios (separados por coma)" Valor="@_destinatarioPrioridad" ValorChanged="v => _destinatarioPrioridad = v" />
                <CampoTexto Etiqueta="Asunto" Valor="@_asuntoPrioridad" ValorChanged="v => _asuntoPrioridad = v" />
                <CampoTextarea Etiqueta="Mensaje" Valor="@_cuerpoPrioridad" ValorChanged="v => _cuerpoPrioridad = v" Filas="10" />
                <p class="workspace-nota-contextual">@_borradorPrioridad.TotalDocumentosPendientes documento(s) pendiente(s) incluido(s) en el mensaje. Revisa y adapta el texto antes de enviarlo — se envía desde el buzón conectado de la plataforma.</p>
            }
        </ChildContent>
    </DrawerFormulario>
</div>

<CascadingValue Value="_ambitoConversacion" IsFixed="true">
    <AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CerrarFormulariosDescartando" />
</CascadingValue>
</LimiteDeErrores>
