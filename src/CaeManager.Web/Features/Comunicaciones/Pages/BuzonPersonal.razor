@page "/comunicaciones/buzon-personal"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RolesComunicaciones.Gestion)]

<PageTitle>Buzón personal — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Buzón personal</h1>
        <a class="enlace-exportar" href="/comunicaciones">Volver a Comunicaciones</a>
    </div>

    <p class="descripcion-delegaciones">
        Correo que llega a tu buzón personal de Microsoft 365, no al de ningún Cliente — notificaciones de
        plataformas externas a tu nombre (p. ej. DocuSign), correo interno de la organización y correo que
        no reconocemos. Nunca se mezcla con la Bandeja de Comunicaciones.
    </p>

    @if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el buzón" Descripcion="Inténtalo de nuevo en unos minutos." />
    }
    else if (_mensajes.Count == 0)
    {
        <EstadoVacio Titulo="Sin buzón personal conectado"
                     Descripcion="Pide a un administrador que conecte tu buzón personal desde Integraciones, o todavía no ha llegado ningún correo." />
    }
    else
    {
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Remitente</th>
                    <th>Asunto</th>
                    <th>Clasificación</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mensaje in _mensajes)
                {
                    var badge = DescribirBadge(mensaje);
                    var expandido = _mensajeExpandidoId == mensaje.MensajeId;
                    <tr class="fila-clicable" @onclick="() => AlternarExpandido(mensaje.MensajeId)">
                        <td>@mensaje.Remitente</td>
                        <td>@mensaje.Asunto</td>
                        <td>
                            @if (badge is { } b)
                            {
                                <Badge Tono="@b.Tono" Tamano="TamanoBadge.Pequeno">@b.Etiqueta</Badge>
                            }
                        </td>
                        <td>@mensaje.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    @if (expandido)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="buzon-personal-cuerpo">@((MarkupString)mensaje.CuerpoHtml)</div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
