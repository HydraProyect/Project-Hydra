@page "/subcontratas"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Subcontratas.Commands.CrearSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontratas
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Subcontratas
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Subcontratas
@using CaeManager.Web.Features.Subcontratas.Components
@using FluentValidation
@using Microsoft.AspNetCore.Components.QuickGrid
@using MediatR
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina lista-design">
    @* Lista 1:1 con «Subcontratas TALVEG.dc.html» del export de Design (DDL-083, 2026-10-18), con el mismo molde que Empresas y
       Trabajadores: cabecera de una línea (CabeceraListado) con el contador, el conmutador ☑ de selección múltiple —la única
       vía para eliminar: la fila no lleva menú—, el icono ⤓ de exportación de la vista filtrada (lectura: cualquier rol), ⌨, el
       menú ⋯ y UNA acción primaria. Sin antetítulo de grupo ni rótulo de la empresa gestionada: el selector de la barra
       lateral ya dice cuál es. El estado vacío sin empresa elegida (4a) sigue más abajo. *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
    {
        <CabeceraListado Titulo="@Textos["TituloPagina"]" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple"
                         RutaExportar="/subcontratas/exportar.xlsx" CriteriosExportar="CriteriosExportar">
            <Menu>
                <CaeManager.Web.Exportacion.EntradasExportar Ruta="/subcontratas/exportar.xlsx" />
            </Menu>
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">@Textos["BotonNuevaSubcontrata"]</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="@Textos["TituloPagina"]" />
    }

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve las
           subcontratas de su organización presentadas como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @* Barra de filtros: el buscador «Filtrar esta pantalla» (tecla f; razón social o CIF, ObtenerSubcontratasQuery), la pastilla
       «Nivel» (viaja en la URL como «nivel»), «Filtros guardados» con «Guardar filtro» y, debajo, la franja de estado (viaja en
       la URL como «estado»), los chips y «Limpiar todo». A la derecha, «Expandir todo».

       - La pastilla «Contratada por» filtra por la Empresa propia contratante (ContratadaPorEmpresaId; viaja como «contratadapor»).
       - Sin «Importar subcontratas» en el menú ⋯: no existe una plantilla de importación de Subcontratas. *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["PlaceholderBusqueda"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar"
                  VistaRecordada="_vistaRecordada">
        <Pastillas>
            <PastillaFiltro Etiqueta="@Textos["ContratadaPor"]" Valor="@_contratadaPorFiltro" ValorChanged="CambiarContratadaPorAsync" Opciones="OpcionesContratadaPor" />
            <PastillaFiltro Etiqueta="@Textos["RotuloNivel"]" Valor="@_nivelFiltro" ValorChanged="CambiarNivelAsync" Opciones="OpcionesNivel" />
        </Pastillas>
        <Estados>
            <FranjaEstado Opciones="EstadoDocumentoUi.FranjaDocumental" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                  Recuentos="_recuentosPorEstado" />
        </Estados>
        <Herramientas>
            <DesplegableAgrupar Opciones="OpcionesAgrupar" Valor="@_agruparPor" ValorChanged="CambiarAgrupacion" />
            @if (HayFilasDesplegables)
            {
                <BarraHerramientasLista TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos" />
            }
        </Herramientas>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["BotonQuitarBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_contratadaPorFiltro))
            {
                <ChipFiltro Etiqueta="@Textos["ChipContratadaPor", TextoContratadaPorFiltro]" EtiquetaAccesible="@Textos["BotonQuitarContratadaPor"]" OnQuitar="() => CambiarContratadaPorAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_nivelFiltro))
            {
                <ChipFiltro Etiqueta="@Textos["ChipNivelServicio", TextoNivelFiltro]" EtiquetaAccesible="@Textos["BotonQuitarNivelServicio"]" OnQuitar="() => CambiarNivelAsync(string.Empty)" />
            }
        </Chips>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                               OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Subcontratas"
                             ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorIntentaNuevamente"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
           a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
           filtrar lo manda a duplicar algo que ya existe.

           La copia no afirma que HAYA registros dados de alta: el filtrado
           es de servidor y la consulta solo devuelve el total ya filtrado,
           así que la pantalla no sabe cuántos hay sin filtro. El mockup dice
           «Hay subcontratas dadas de alta, pero ninguna coincide» — esa frase
           no se copia porque esta pantalla no puede saberla. *@
        <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioBusquedaTitulo"]"
                     Descripcion="@Textos["VacioBusquedaDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="subcontratas" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">@Textos["BotonNuevaSubcontrata"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        @* Marco de la lista de la maqueta: una sola tarjeta con la cabecera de columnas arriba y las filas separadas por una
           línea. Sin roles de tabla ni QuickGrid, como Empresas y Trabajadores: la fila se despliega y QuickGrid no soporta
           filas expandibles. Ordenan los rótulos «Subcontrata», «Contratada por», «Nivel» y «Cumplimiento» (?orden=, OrdenDeRejilla). *@
        @TarjetaListado.Renderizar(@<text>
            <div class="marco-lista-subcontratas">
            <div class="@ClaseRejilla("cabecera-columnas-subcontratas")">
                @if (_seleccionMultiple)
                {
                    <span class="seleccion-subcontrata"><input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" /></span>
                }
                <span></span>
                @CabeceraOrdenable("subcontrata", Textos["RotuloSubcontrata"])
                @CabeceraOrdenable("contratadapor", Textos["ContratadaPor"])
                @CabeceraOrdenable("nivel", Textos["RotuloNivel"])
                @CabeceraOrdenable("cumplimiento", Textos["RotuloCumplimiento"])
                <span>@Textos["RotuloEstadoDocumental"]</span>
                <span></span>
            </div>

            @{ var clavesDeGrupo = new ClavesDeHermanos(); }
            <div class="lista-filas-acordeon" aria-busy="@(_cargando ? "true" : "false")">
                @foreach (var grupo in GruposDePagina)
                {
                <div class="grupo-subcontratas" @key="clavesDeGrupo.De(grupo.Clave)">
                @if (_agruparPor is not null)
                {
                    <div class="cabecera-empresa-contratante">
                        @grupo.Nombre <span>· @grupo.Filas.Count</span>
                    </div>
                }
                @foreach (var subcontrata in grupo.Filas)
                {
                    var incidencias = Incidencias(subcontrata.Recuentos);
                    var expandido = _expandidos.Contains(subcontrata.Id) && incidencias.Count != 0;
                    <div class="@ClaseTarjeta(subcontrata)" @key="subcontrata.Id">
                        @* La fila no lleva menú «⋯». Un clic en cualquier punto de la fila abre la vista rápida (el panel del
                           Context Workspace), igual que Enter sobre la fila enfocada; los controles de dentro —casilla,
                           desplegable, CIF copiable, ventana de trabajadores, icono 360— hacen lo suyo y no dejan subir el
                           clic. Cada celda va envuelta para que la rejilla tenga SIEMPRE las columnas de la cabecera. *@
                        <div class="@(ClaseRejilla("tarjeta-fila-acordeon-cabecera") + " fila-pulsable")"
                             @onclick="() => AbrirVistaRapidaAsync(subcontrata.Id)">
                            @if (_seleccionMultiple)
                            {
                                <span class="seleccion-subcontrata"><input type="checkbox" aria-label="@Textos["AriaSeleccionarSubcontrata", subcontrata.RazonSocial]" checked="@_seleccionados.Contains(subcontrata.Id)" @onchange="e => AlternarSeleccion(subcontrata.Id, (bool)e.Value!)" @onclick:stopPropagation="true" /></span>
                            }
                            @if (incidencias.Count > 0)
                            {
                                <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                        aria-expanded="@(expandido ? "true" : "false")"
                                        aria-label="@Textos["DesplegarIncidenciasSubcontrata", subcontrata.RazonSocial]"
                                        @onclick="() => AlternarExpansion(subcontrata.Id)" @onclick:stopPropagation="true">
                                    <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                                </button>
                            }
                            else
                            {
                                <span></span>
                            }
                            @* Celda «Subcontrata»: la razón social (abre la vista rápida) y debajo, en una línea, el CIF copiable
                               con un clic y «· N trabajadores» (la maqueta deja ahí un texto extra tras el identificador). A la
                               página Subcontrata 360 se va con el icono 360 del final de la fila y con el del panel. *@
                            <span class="celda-identidad-subcontrata">
                                <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida"
                                        aria-label="@Textos["AbrirVistaRapidaDe", subcontrata.RazonSocial]"
                                        @onclick="() => AbrirVistaRapidaAsync(subcontrata.Id)" @onclick:stopPropagation="true">
                                    <TextoResaltado Texto="@subcontrata.RazonSocial" Termino="@_busqueda" />
                                </button>
                                <span class="celda-subcontrata-meta">
                                    @if (string.IsNullOrWhiteSpace(subcontrata.Cif))
                                    {
                                        @Textos["SinCif"]
                                    }
                                    else
                                    {
                                        <BotonCopiar EnLinea="true" Valor="@subcontrata.Cif" Texto="@subcontrata.Cif" TerminoResaltado="@_busqueda" Etiqueta="@Textos["EtiquetaCif"]"
                                                     NombreAccesible="@Textos["CopiarCif", subcontrata.Cif]" />
                                    }
                                    <span aria-hidden="true">·</span>
                                    <span class="meta-trabajadores-subcontrata">
                                        <VentanaContexto Etiqueta="@Textos["AriaTrabajadoresDe", subcontrata.RazonSocial]"
                                                         Titulo="@Textos["PestanaTrabajadores"]"
                                                         Interactiva="true" Deshabilitada="@(subcontrata.Trabajadores.Count == 0)"
                                                         Colocacion="VentanaContextoColocacion.AbajoCentro">
                                            <Disparador>@(subcontrata.Trabajadores.Count == 1 ? Textos["MetaTrabajadoresUno"] : Textos["MetaTrabajadoresVarios", subcontrata.Trabajadores.Count])</Disparador>
                                            <Detalle>
                                                @foreach (var trabajador in subcontrata.Trabajadores)
                                                {
                                                    <VentanaContextoElemento AlPulsar='() => NavigationManager.NavigateTo($"/trabajadores/{trabajador.Id}")'>
                                                        @trabajador.Nombre @trabajador.Apellidos
                                                    </VentanaContextoElemento>
                                                }
                                            </Detalle>
                                        </VentanaContexto>
                                    </span>
                                </span>
                            </span>
                            @* Nivel: texto plano, como la maqueta. Qué significa cada uno va en el título (sin atribuir la gestión a TALVEG). *@
                            <span class="celda-contratada-por">@TextoContratantes(subcontrata)</span>
                            <span class="celda-nivel-subcontrata" title="@DescribirNivel(subcontrata.NivelServicio)">@EstadoSupervisionUi.TextoNivel(Textos, subcontrata.NivelServicio)</span>
                            <span>
                                <BarraCumplimiento Porcentaje="subcontrata.CumplimientoPorcentaje"
                                                   Etiqueta="@EtiquetaCumplimiento(subcontrata.CumplimientoPorcentaje)" />
                            </span>
                            @* Estado documental: la pastilla (o «Sin incidencias» con su punto) y debajo el motivo con las cifras. El
                               detalle de cada documento vive en la fila desplegada, con su «Gestionar». *@
                            <span class="celda-estado-subcontrata">
                                <EstadoFila Tono="EstadoDocumentoUi.TonoDocumental(subcontrata.EstadoDocumental)"
                                            Texto="@EstadoDocumentoUi.TextoDocumental(subcontrata.EstadoDocumental)"
                                            Correcto="EstadoDocumentoUi.EsCorrecto(subcontrata.EstadoDocumental)"
                                            Motivo="@MotivoDeFila(subcontrata.Recuentos)" />
                            </span>
                            <div class="tarjeta-fila-acordeon-acciones acciones-subcontrata">
                                <Boton360 Nombre="@subcontrata.RazonSocial" Href="@($"/subcontratas/{subcontrata.Id}")" />
                            </div>
                        </div>
                        @if (expandido)
                        {
                            @* La fila desplegada son los documentos de sus trabajadores que piden trabajo, cada uno con la única acción
                               «Gestionar» (maqueta de Subcontratas; regla 8 de LEEME-AUTORIDAD: un solo verbo para todo lo que necesita el
                               trabajo del Gestor CAE). Son las incidencias que ya trae la fila: no cuestan otra consulta y se corrigen con
                               el mismo formulario de siempre (CorreccionIncidenciaDocumental). Quien solo consulta —o una incidencia sin
                               documento ni trabajador— ve el documento sin el botón: no se le ofrece un formulario que el comando le va a
                               denegar. *@
                            <div class="@("tarjeta-fila-acordeon-contenido" + (_seleccionMultiple ? " contenido-con-seleccion" : string.Empty))">
                                <ul class="documentos-pendientes-subcontrata" data-pieza="documentos-pendientes">
                                    @foreach (var incidencia in incidencias)
                                    {
                                        <li class="documento-pendiente-subcontrata">
                                            <span class="documento-pendiente-nombre">@incidencia.Descripcion</span>
                                            <Badge Tono="EstadoDocumentoUi.TonoDeSeveridad(incidencia.Estado)" title="@EstadoDocumentoUi.TextoDeSeveridad(incidencia.Estado)">@EstadoDocumentoUi.Texto(incidencia.Estado)</Badge>
                                            <span class="documento-pendiente-detalle">@DetalleDelDocumento(incidencia)</span>
                                            @if (EsCorregible(incidencia))
                                            {
                                                <button type="button" class="@("documento-pendiente-gestionar" + (EstadoDocumentoUi.EsCorrecto(incidencia.Estado) ? " gestionar-secundario" : ""))" data-accion="gestionar"
                                                        aria-label="@Textos["GestionarDocumentoAccesible", incidencia.Descripcion, subcontrata.RazonSocial]"
                                                        @onclick="() => CorregirIncidenciaAsync(incidencia)">@Textos["BotonGestionar"]</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
                </div>
                }
            </div>
            </div>
        </text>, PieDelListado)
    }
    @if (!_errorCarga && !_cargando && _elementosPagina.Count == 0)
    {
        @TarjetaListado.RenderizarMaqueta(null, PieDelListadoVacio)
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["TituloDrawerNueva"]"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <CampoTexto Etiqueta="@Textos["RotuloRazonSocial"]" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" OnBlur="ValidarRazonSocialAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.RazonSocial))" />
    <CampoTexto Etiqueta="@Textos["RotuloIdentificacionFiscal"]" Placeholder="@Textos["PlaceholderIdentificacionFiscal"]" Valor="@_cif" ValorChanged="v => _cif = v" OnBlur="ValidarCifAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.Cif))" />

    <SelectorMultiple Etiqueta="@Textos["EtiquetaClientesQueLaContrataron"]"
                       Elementos="@_clientesDisponiblesSelector"
                       Seleccionados="@_clienteIdsSeleccionados"
                       OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                       TextoVacio="@Textos["VacioClientesSelector"]" />

    @if (_resolverEmpresaEnSilencio)
    {
        @* DDL-076: perfil Cliente Directo con una única Empresa — sin
           selector, pedirle que confirme que él es él en una lista de
           un solo elemento no aporta nada. *@
        <CampoInfo Etiqueta="@Textos["EtiquetaEmpresaPrestaServicio"]" Valor="@_empresasDisponibles[0].RazonSocial" />
    }
    else
    {
        <SelectorMultiple Etiqueta="@Textos["EtiquetaEmpresasPrestaServicio"]"
                           Elementos="@_empresasDisponiblesSelector"
                           Seleccionados="@_empresaIdsSeleccionados"
                           OnAlternar="args => AlternarEmpresa(args.Id, args.Marcado)"
                           TextoVacio="@Textos["VacioEmpresasSelector"]" />
    }
</DrawerFormulario>

@* Corregir un documento con «Gestionar» en la fila desplegada (vencidos, por vencer y sin confirmar), sin salir del listado. *@
<CaeManager.Web.Features.Documentos.Components.CorreccionIncidenciaDocumental @ref="_correccion" OnCorregida="RefrescarTrasCorreccionAsync" />

@* EliminarSubcontratasCommand es ICommand, denegado a Consulta. El ☑ de «Selección múltiple»
   de la cabecera sigue visible para Consulta: seleccionar es lectura, y solo la barra de lote
   (que borra) va bajo SoloConEscritura. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@Textos["ConfirmarEliminarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

</LimiteDeErrores>

@code {
    // Rótulo de columna que ordena: la flecha del orden vigente la pinta la clase.
    private RenderFragment CabeceraOrdenable(string clave, string titulo) => @<span class="@(_orden.Clave == clave ? (_orden.Direccion == SortDirection.Descending ? "col-sort-desc" : "col-sort-asc") : "")">
        <button type="button" class="col-title" title="@Textos["OrdenarPorColumna"]" @onclick="() => OrdenarAsync(clave)"><span class="col-title-text">@titulo</span></button>
    </span>;

    private RenderFragment PieDelListado => PieSegun(false);

    // Sin subcontratas el pie sigue visible debajo de la tarjeta, con la presentación de la maqueta anterior
    // (regla compartida de los listados, ListadosPieSiempreVisibleTests).
    private RenderFragment PieDelListadoVacio => PieSegun(true);

    // Un solo montaje de la leyenda de atajos (LeyendaAtajosListaAdopcionTests): lo único que cambia es la presentación del pie.
    private RenderFragment PieSegun(bool presentacionMaqueta) => @<text>
        @if (!_errorCarga && (!_cargando || _totalElementos > 0))
        {
            <PaginadorSimple PresentacionMaqueta="presentacionMaqueta" PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                  PaginaActualChanged="CambiarPaginaAsync"
                                  TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" ElementosEnPagina="_elementosPagina.Count">
                    <Centro><LeyendaAtajosLista /></Centro>
                </PaginadorSimple>
        }
    </text>;
}
