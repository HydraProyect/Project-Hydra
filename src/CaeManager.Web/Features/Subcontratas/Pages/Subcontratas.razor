@page "/subcontratas"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Subcontratas.Commands.CrearSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontratas
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Subcontratas
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Subcontratas
@using CaeManager.Web.Features.Subcontratas.Components
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Mockup «Selector Empresa Gestionada» (lienzo 2): con varias empresas gestionadas, la lista dice de
       cuál es. El selector de la barra lateral cambia de empresa y recarga esta misma ruta sin query. *@
    <CabeceraEmpresaActiva Empresa="_empresaActiva" />

    @* Cabecera Gen 2 (Subcontratas TALVEG.dc.html): el kicker es el grupo del
       menú al que pertenece la pantalla, y el alta sube a la cabecera junto a
       Exportar — antes vivía en la barra de trabajo, mezclada con los
       controles que actúan sobre la lista. *@
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["KickerNegocio"]">
        <Acciones>
            @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
            {
                <a class="enlace-exportar" href="/subcontratas/exportar.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlaceExportarExcel"]</a>
            }
            @if (!_alcanceCero && !_sinEmpresaSeleccionada && !_resolviendoEmpresa)
            {
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">@Textos["BotonNuevaSubcontrata"]</Boton></SoloConEscritura>
            }
        </Acciones>
    </CabeceraPagina>

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve las
           subcontratas de su organización presentadas como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @* Pieza 2 del patrón de lista (BarraFiltros), la misma que Clientes. El mockup dibuja además un
       desplegable «Nivel de servicio» y lo marca él mismo como PROPUESTA: ObtenerSubcontratasQuery
       no acepta ese filtro (ni uno de estado documental), así que no se dibuja un control que no
       filtra nada hasta que exista en la consulta. Sin «Filtros guardados» hasta que haya filtro
       guardable (el patrón lo pinta solo si se le pasa alguno). *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["PlaceholderBusqueda"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync">
        <Chips>
            <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["BotonQuitarBusqueda"]" OnQuitar="LimpiarFiltrosAsync" />
        </Chips>
    </BarraFiltros>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorIntentaNuevamente"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
           a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
           filtrar lo manda a duplicar algo que ya existe.

           La copia no afirma que HAYA registros dados de alta: el filtrado
           es de servidor y la consulta solo devuelve el total ya filtrado,
           así que la pantalla no sabe cuántos hay sin filtro. El mockup dice
           «Hay subcontratas dadas de alta, pero ninguna coincide» — esa frase
           no se copia porque esta pantalla no puede saberla. *@
        <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioBusquedaTitulo"]"
                     Descripcion="@Textos["VacioBusquedaDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarBusqueda"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="subcontratas" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">@Textos["BotonNuevaSubcontrata"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple"
                                TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos">
            <Extra>
                <span class="conteo-subcontratas">@TextoConteo</span>
            </Extra>
        </BarraHerramientasLista>

        @if (_seleccionMultiple)
        {
            @* "Seleccionar todos" era falso y se contradecía con la propia barra
               de lote, que ya dice «N seleccionado(s) EN ESTA PÁGINA»: la casilla
               solo marca los de la página actual. Con 20 por página y 200
               coincidencias, quien la marcaba y pulsaba "Eliminar seleccionados"
               borraba 20 creyendo que borraba 200.

               Se dice ademas cuantas quedan fuera cuando las hay: es la mitad
               informativa del banner que pide el mockup. La otra mitad,
               "seleccionar las N filtradas", NO se implementa aqui — añade una
               capacidad de selección masiva sobre un camino destructivo, y eso
               es una decisión de producto, no de maquetación. *@
            <label class="campo-checkbox">
                <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                @Textos["SeleccionarLosDeEstaPagina"]
                @if (_totalElementos > _elementosPagina.Count)
                {
                    <span class="texto-vacio-seccion">@Textos["SeleccionHayMasEnTotal", _totalElementos]</span>
                }
            </label>
        }

        @* Cabecera de columnas. Sin roles de tabla a propósito, igual que en
           Empresas: la fila se despliega, y anunciarla como tabla prometería a
           un lector de pantalla una navegación por celdas que no existe. Sin
           QuickGrid por la misma razón: no soporta filas expandibles. *@
        <div class="@ClaseRejilla("cabecera-columnas-subcontratas")">
            @if (_seleccionMultiple)
            {
                <span></span>
            }
            <span></span>
            <span>@Textos["RotuloRazonSocial"]</span>
            <span>@Textos["RotuloNivelServicio"]</span>
            <span>@Textos["RotuloCumplimiento"]</span>
            <span>@Textos["ColumnaVencidos"]</span>
            <span>@Textos["ColumnaProximos"]</span>
            <span></span>
        </div>

        <div class="lista-filas-acordeon">
            @foreach (var subcontrata in _elementosPagina)
            {
                var expandido = _expandidos.Contains(subcontrata.Id);
                <div class="@ClaseTarjeta(subcontrata.Id)" @key="subcontrata.Id">
                    @* Cada celda va envuelta para que la rejilla tenga SIEMPRE el
                       mismo número de columnas que la cabecera: un componente que
                       no se pinta desalinearía la fila. *@
                    <div class="@ClaseRejilla("tarjeta-fila-acordeon-cabecera")">
                        @if (_seleccionMultiple)
                        {
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarSubcontrata", subcontrata.RazonSocial]" checked="@_seleccionados.Contains(subcontrata.Id)" @onchange="e => AlternarSeleccion(subcontrata.Id, (bool)e.Value!)" />
                        }
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@Textos["AriaTrabajadoresDe", subcontrata.RazonSocial]"
                                @onclick="() => AlternarExpansion(subcontrata.Id)">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        <span class="celda-identidad-subcontrata">
                            <button type="button" class="enlace-nombre-fila" @onclick="() => AbrirPreview(subcontrata.Id)">
                                @subcontrata.RazonSocial
                            </button>
                            <span class="tarjeta-fila-acordeon-meta">@(string.IsNullOrEmpty(subcontrata.Cif) ? Textos["SinCif"] : subcontrata.Cif)</span>
                        </span>
                        <span>
                            <Badge Tono="EstadoSupervisionUi.TonoNivel(subcontrata.NivelServicio)" Tamano="TamanoBadge.Pequeno"
                                   title="@DescribirNivel(subcontrata.NivelServicio)">
                                @EstadoSupervisionUi.TextoNivel(Textos, subcontrata.NivelServicio)
                            </Badge>
                        </span>
                        <span>
                            <AnilloCumplimiento Porcentaje="subcontrata.CumplimientoPorcentaje" Tamano="TamanoAnillo.Pequeno"
                                                 Etiqueta="@EtiquetaCumplimiento(subcontrata.CumplimientoPorcentaje)" />
                        </span>
                        <span class="celda-recuento-subcontrata">
                            @if (subcontrata.Recuentos.TotalVencidas > 0)
                            {
                                <VentanaContexto Etiqueta="@DescribirRecuento(subcontrata.Recuentos.Vencidas.Count, "RecuentoDocumentosVencidosUno", "RecuentoDocumentosVencidosVarios")"
                                                 Titulo="@DescribirRecuento(subcontrata.Recuentos.TotalVencidas, "RecuentoDocumentosVencidosUno", "RecuentoDocumentosVencidosVarios")">
                                    <Disparador>
                                        <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">
                                            @DescribirRecuento(subcontrata.Recuentos.TotalVencidas, "BadgeVencidosUno", "BadgeVencidosVarios")
                                        </Badge>
                                    </Disparador>
                                    <Detalle>
                                        @foreach (var incidencia in subcontrata.Recuentos.Vencidas)
                                        {
                                            <span class="ventana-linea">@incidencia.Descripcion</span>
                                        }
                                    </Detalle>
                                </VentanaContexto>
                            }
                            else
                            {
                                <span class="celda-sin-recuento">—</span>
                            }
                        </span>
                        <span class="celda-recuento-subcontrata">
                            @if (subcontrata.Recuentos.TotalProximas > 0)
                            {
                                <VentanaContexto Etiqueta="@EtiquetaProximos(subcontrata.Recuentos.Proximas)"
                                                 Titulo="@DescribirRecuento(subcontrata.Recuentos.TotalProximas, "RecuentoDocumentosProximosUno", "RecuentoDocumentosProximosVarios")">
                                    <Disparador>
                                        <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">
                                            @DescribirRecuento(subcontrata.Recuentos.TotalProximas, "BadgeProximosUno", "BadgeProximosVarios")
                                        </Badge>
                                    </Disparador>
                                    <Detalle>
                                        @foreach (var incidencia in subcontrata.Recuentos.Proximas)
                                        {
                                            @* Urgente y Proximo comparten badge Advertencia arriba (Codex,
                                               oleada 3): sin el tono por incidencia aquí, un documento urgente
                                               era indistinguible de uno próximo normal en esta lista. *@
                                            <span class="ventana-linea">
                                                <Badge Tono="EstadoDocumentoUi.Tono(incidencia.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(incidencia.Estado)</Badge>
                                                @incidencia.Descripcion
                                            </span>
                                        }
                                    </Detalle>
                                </VentanaContexto>
                            }
                            else if (subcontrata.Recuentos.TotalVencidas == 0)
                            {
                                <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">@Textos["BadgeAlCorriente"]</Badge>
                            }
                        </span>
                        @* Acciones tras "⋯", mismo criterio que Empresas. "Detalles"
                           abre la vista previa y "Abrir Subcontrata 360" el Context
                           Workspace: son dos profundidades distintas, y el mockup
                           ofrece las dos. *@
                        <div class="tarjeta-fila-acordeon-acciones">
                            <MenuAcciones>
                                <ItemMenuAccion OnClick="() => AbrirPreview(subcontrata.Id)">
                                    @Textos["MenuDetalles"]
                                </ItemMenuAccion>
                                <ItemMenuAccion OnClick='() => AbrirDesdePreviewAsync((subcontrata.Id, "informacion"))'>
                                    @Textos["MenuAbrirSubcontrata360"]
                                </ItemMenuAccion>
                                <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(subcontrata.Id, subcontrata.RazonSocial)">
                                    @Textos["MenuEliminar"]
                                </ItemMenuAccion></SoloConEscritura>
                            </MenuAcciones>
                        </div>
                    </div>
                    @if (expandido)
                    {
                        <div class="tarjeta-fila-acordeon-contenido">
                            <AcordeonTrabajadoresSubcontrata SubcontrataId="subcontrata.Id" OnCambio="() => RefrescarSubcontrataAsync(subcontrata.Id)" />
                        </div>
                    }
                </div>
            }
        </div>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                          Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
    }
</div>

<Drawer @ref="_drawerSubcontrata" HayCambios="() => HayCambiosSinGuardar" Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["TituloDrawerNueva"]" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="@Textos["RotuloRazonSocial"]" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" OnBlur="ValidarRazonSocialAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.RazonSocial))" />
        <CampoTexto Etiqueta="@Textos["RotuloIdentificacionFiscal"]" Placeholder="@Textos["PlaceholderIdentificacionFiscal"]" Valor="@_cif" ValorChanged="v => _cif = v" OnBlur="ValidarCifAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.Cif))" />

        <SelectorMultiple Etiqueta="@Textos["EtiquetaClientesQueLaContrataron"]"
                           Elementos="@_clientesDisponiblesSelector"
                           Seleccionados="@_clienteIdsSeleccionados"
                           OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                           TextoVacio="@Textos["VacioClientesSelector"]" />

        @if (_resolverEmpresaEnSilencio)
        {
            @* DDL-076: perfil Cliente Directo con una única Empresa — sin
               selector, pedirle que confirme que él es él en una lista de
               un solo elemento no aporta nada. *@
            <CampoInfo Etiqueta="@Textos["EtiquetaEmpresaPrestaServicio"]" Valor="@_empresasDisponibles[0].RazonSocial" />
        }
        else
        {
            <SelectorMultiple Etiqueta="@Textos["EtiquetaEmpresasPrestaServicio"]"
                               Elementos="@_empresasDisponiblesSelector"
                               Seleccionados="@_empresaIdsSeleccionados"
                               OnAlternar="args => AlternarEmpresa(args.Id, args.Marcado)"
                               TextoVacio="@Textos["VacioEmpresasSelector"]" />
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => _drawerSubcontrata?.SolicitarCierreAsync() ?? Task.CompletedTask">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_guardando" OnClick="GuardarAsync">
            @Textos["BotonGuardar"]
        </Boton>
    </Pie>
</Drawer>

<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="() => { _drawerVisible = false; }" />

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["ConfirmarEliminarTitulo", _razonSocialAEliminar]"
    Mensaje="@Textos["ConfirmarEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

@* EliminarSubcontratasCommand es ICommand, denegado a Consulta. «Selección múltiple» sigue
   visible: vive en BarraHerramientasLista junto a «Expandir todos» y el conteo, que sí son
   lectura, y ocultarlo solo a él exigiría tocar el componente compartido. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@Textos["ConfirmarEliminarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<SubcontrataPreviewDrawer Fila="FilaEnVistaPrevia" Visible="_previewVisible" VisibleChanged="v => _previewVisible = v" OnOperar="AbrirDesdePreviewAsync" />
</LimiteDeErrores>
