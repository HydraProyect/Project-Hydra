@page "/subcontratas"
@rendermode InteractiveServer
@using CaeManager.Application.Subcontratas.Commands.CrearSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontratas
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Subcontratas
@using CaeManager.Web.Features.Subcontratas
@using CaeManager.Web.Features.Subcontratas.Components
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService

<PageTitle>Subcontratas — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Subcontratas</h1>
    </div>

    @*
        "Subcontrata 360" (mismo lenguaje que Centro 360): una barra de
        trabajo con buscar/selección-múltiple/expandir-todos/nuevo, filas en
        acordeón con anillo de cumplimiento — sin QuickGrid, que no soporta
        filas expandibles.
    *@
    <div class="barra-trabajo-centros">
        <CampoTexto Placeholder="Buscar por razón social o CIF…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
               OnClick="() => AlternarSeleccionMultiple(!_seleccionMultiple)"
               aria-pressed="@(_seleccionMultiple ? "true" : "false")">
            Selección múltiple
        </Boton>
        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
               OnClick="() => AlternarTodosExpandidos(!TodosExpandidos)">
            @(TodosExpandidos ? "Colapsar todos" : "Expandir todos")
        </Boton>
        <Boton OnClick="AbrirCrear">+ Nueva subcontrata</Boton>
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las subcontratas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="() => CargarAsync()">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_elementosPagina.Count == 0)
    {
        <EstadoVacio Titulo="Aún no hay subcontratas" Descripcion="Crea la primera para poder dar de alta a sus trabajadores.">
            <Accion>
                <Boton OnClick="AbrirCrear">+ Nueva subcontrata</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (_seleccionMultiple)
        {
            <label class="campo-checkbox">
                <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                Seleccionar todos
            </label>
        }

        <div class="lista-filas-acordeon">
            @foreach (var subcontrata in _elementosPagina)
            {
                var expandido = _expandidos.Contains(subcontrata.Id);
                <div class="@("tarjeta-fila-acordeon" + (subcontrata.Id == _idEnfocado ? " fila-enfocada" : ""))" @key="subcontrata.Id">
                    <div class="tarjeta-fila-acordeon-cabecera">
                        @if (_seleccionMultiple)
                        {
                            <input type="checkbox" checked="@_seleccionados.Contains(subcontrata.Id)" @onchange="e => AlternarSeleccion(subcontrata.Id, (bool)e.Value!)" />
                        }
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@($"Trabajadores de {subcontrata.RazonSocial}")"
                                @onclick="() => AlternarExpansion(subcontrata.Id)">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        <AnilloCumplimiento Porcentaje="subcontrata.CumplimientoPorcentaje" Tamano="TamanoAnillo.Pequeno"
                                             Etiqueta="@($"{subcontrata.CumplimientoPorcentaje}% de cumplimiento — documentos al día / exigidos entre sus trabajadores")" />
                        <span class="tarjeta-fila-acordeon-identidad">
                            <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Subcontrata, subcontrata.Id, subcontrata.RazonSocial, "informacion")'>
                                @subcontrata.RazonSocial
                            </button>
                            <span class="tarjeta-fila-acordeon-meta">
                                @(string.IsNullOrEmpty(subcontrata.Cif) ? "Sin CIF" : subcontrata.Cif)
                                · <Badge Tono="EstadoSupervisionUi.TonoNivel(subcontrata.NivelServicio)" Tamano="TamanoBadge.Pequeno">@EstadoSupervisionUi.TextoNivel(subcontrata.NivelServicio)</Badge>
                            </span>
                        </span>
                        <span class="tarjeta-fila-acordeon-indicadores">
                            <span class="ranura-recuento">
                                @if (subcontrata.Recuentos.TotalVencidas > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(subcontrata.Recuentos.Vencidas, "vencido")"
                                                     Titulo="@($"{subcontrata.Recuentos.TotalVencidas} {(subcontrata.Recuentos.TotalVencidas == 1 ? "documento vencido" : "documentos vencidos")}")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                @subcontrata.Recuentos.TotalVencidas
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var incidencia in subcontrata.Recuentos.Vencidas)
                                            {
                                                <span class="ventana-linea">@incidencia.Descripcion</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                            <span class="ranura-recuento ranura-recuento-final">
                                @if (subcontrata.Recuentos.TotalProximas > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(subcontrata.Recuentos.Proximas, "próximo a vencer")"
                                                     Titulo="@($"{subcontrata.Recuentos.TotalProximas} {(subcontrata.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                @subcontrata.Recuentos.TotalProximas
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var incidencia in subcontrata.Recuentos.Proximas)
                                            {
                                                <span class="ventana-linea">@incidencia.Descripcion</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                                else if (subcontrata.Recuentos.TotalVencidas == 0)
                                {
                                    <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Al corriente</Badge>
                                }
                            </span>
                        </span>
                        <div class="tarjeta-fila-acordeon-acciones">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Subcontrata, subcontrata.Id, subcontrata.RazonSocial, "informacion")'>
                                Detalles
                            </Boton>
                        </div>
                    </div>
                    @if (expandido)
                    {
                        <div class="tarjeta-fila-acordeon-contenido">
                            <AcordeonTrabajadoresSubcontrata SubcontrataId="subcontrata.Id" OnCambio="() => RefrescarSubcontrataAsync(subcontrata.Id)" />
                        </div>
                    }
                </div>
            }
        </div>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                          Etiqueta="subcontrata(s)" PaginaActualChanged="CambiarPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nueva subcontrata" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" OnBlur="ValidarRazonSocialAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.RazonSocial))" />
        <CampoTexto Etiqueta="CIF" Valor="@_cif" ValorChanged="v => _cif = v" OnBlur="ValidarCifAsync" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.Cif))" />

        <SelectorMultiple Etiqueta="Clientes que la contrataron"
                           Elementos="@_clientesDisponiblesSelector"
                           Seleccionados="@_clienteIdsSeleccionados"
                           OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay clientes creados." />

        @if (_resolverEmpresaEnSilencio)
        {
            @* DDL-076: perfil Cliente Directo con una única Empresa — sin
               selector, pedirle que confirme que él es él en una lista de
               un solo elemento no aporta nada. *@
            <CampoInfo Etiqueta="Empresa a la que presta servicio" Valor="@_empresasDisponibles[0].RazonSocial" />
        }
        else
        {
            <SelectorMultiple Etiqueta="Empresas a las que presta servicio"
                               Elementos="@_empresasDisponiblesSelector"
                               Seleccionados="@_empresaIdsSeleccionados"
                               OnAlternar="args => AlternarEmpresa(args.Id, args.Marcado)"
                               TextoVacio="Todavía no hay empresas creadas." />
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} subcontrata(s)?")"
    Mensaje="Se ocultarán de las listas activas."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
