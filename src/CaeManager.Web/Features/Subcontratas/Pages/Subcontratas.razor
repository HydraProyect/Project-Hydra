@page "/subcontratas"
@rendermode InteractiveServer
@using CaeManager.Application.Subcontratas.Commands.CrearSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EditarSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontrata
@using CaeManager.Application.Subcontratas.Commands.EliminarSubcontratas
@using CaeManager.Application.Subcontratas.Commands.GuardarCredencialAccesoSubcontrata
@using CaeManager.Application.Subcontratas.Queries.ObtenerCredencialAccesoSubcontrata
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontrataPorId
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService

<PageTitle>Subcontratas — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Subcontratas</h1>
        <Boton OnClick="AbrirCrear">+ Nueva subcontrata</Boton>
    </div>

    <div class="barra-filtros">
        <CampoTexto Placeholder="Buscar por razón social…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las subcontratas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="RecargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple" />

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="SubcontrataListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <PropertyColumn Property="@(s => s.RazonSocial)" Sortable="true" />
                <PropertyColumn Property="@(s => s.Cif)" Title="CIF" Sortable="true" />
                <TemplateColumn Title="Acciones" Align="Align.End">
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Subcontrata, context.Id, context.RazonSocial, "informacion")'>
                        Detalles
                    </Boton>
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEliminar(context.Id, context.RazonSocial)">
                        Eliminar
                    </Boton>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="subcontrata(s)" PaginaActualChanged="CambiarPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="Aún no hay subcontratas" Descripcion="Crea la primera para poder dar de alta a sus trabajadores.">
                <Accion>
                    <Boton OnClick="AbrirCrear">+ Nueva subcontrata</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nueva subcontrata" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.RazonSocial))" />
        <CampoTexto Etiqueta="CIF" Valor="@_cif" ValorChanged="v => _cif = v" MensajeError="@ObtenerError(nameof(CrearSubcontrataCommand.Cif))" />

        <SelectorMultiple Etiqueta="Clientes que la contrataron"
                           Elementos="@_clientesDisponiblesSelector"
                           Seleccionados="@_clienteIdsSeleccionados"
                           OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay clientes creados." />

        <SelectorMultiple Etiqueta="Empresas a las que presta servicio"
                           Elementos="@_empresasDisponiblesSelector"
                           Seleccionados="@_empresaIdsSeleccionados"
                           OnAlternar="args => AlternarEmpresa(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay empresas creadas." />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar a {_razonSocialAEliminar}?")"
    Mensaje="Se ocultará de las listas activas."
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} subcontrata(s)?")"
    Mensaje="Se ocultarán de las listas activas."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
