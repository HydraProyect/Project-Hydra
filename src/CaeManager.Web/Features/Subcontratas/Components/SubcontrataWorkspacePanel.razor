@*
    Panel de Subcontrata para el Context Workspace — se le da el mismo
    tratamiento de primer nivel que a Empresa (decisión explícita del
    usuario: "si la dejas solo como pestaña del Cliente, acabarás
    duplicando lógica o limitando funcionalidades"). Pestañas: Información,
    Trabajadores, Documentación, Centros, Historial.
*@
@using CaeManager.Application.Subcontratas.Queries.ObtenerCentrosConActividadDeSubcontrata
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontrataPorId
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadores
@using CaeManager.Web.Components.Workspace
@using MediatR
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar la subcontrata" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.RazonSocial</h2>
    </div>

    <Pestanas Definiciones="_pestanas" PestanaActiva="PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones de la subcontrata">
        @switch (PestanaActiva)
        {
            case "informacion":
                <div class="workspace-grupo-campos">
                    <CampoInfo Etiqueta="Razón social" Valor="@_detalle.RazonSocial" />
                    <CampoInfo Etiqueta="Clientes con los que trabaja" Valor="@_detalle.ClienteIds.Count.ToString()" />
                    <CampoInfo Etiqueta="Empresas a las que presta servicio" Valor="@_detalle.EmpresaIds.Count.ToString()" />
                    <CampoInfo Etiqueta="Creada" Valor="@_detalle.CreadoEnUtc.ToLocalTime().ToString("dd/MM/yyyy")" />
                </div>
                break;

            case "trabajadores":
                @if (_cargandoTrabajadores)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_trabajadores is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin trabajadores" Descripcion="Esta subcontrata todavía no tiene ningún trabajador dado de alta." />
                }
                else if (_trabajadores is not null)
                {
                    <ul class="workspace-lista-entidades">
                        @foreach (var trabajador in _trabajadores)
                        {
                            <FilaEntidadRelacionada
                                Titulo="@($"{trabajador.Nombre} {trabajador.Apellidos}")"
                                Subtitulo="@trabajador.Dni"
                                OnClic="() => AbrirTrabajadorAsync(trabajador)" />
                        }
                    </ul>
                }
                break;

            case "documentacion":
                <EstadoVacio Titulo="Documentación no modelada a nivel de Subcontrata" Descripcion="El modelo de datos actual solo asocia Documentos a Trabajador, Cliente, Empresa o Vehículo — consulta la pestaña Documentación de cada Trabajador de esta subcontrata." />
                break;

            case "centros":
                @if (_cargandoCentros)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_centros is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin actividad en ningún centro" Descripcion="Ningún trabajador de esta subcontrata tiene asignaciones activas todavía." />
                }
                else if (_centros is not null)
                {
                    <p class="workspace-nota-contextual">Centros donde esta subcontrata tiene actividad real (trabajadores con asignación activa).</p>
                    <ul class="workspace-lista-entidades">
                        @foreach (var centro in _centros)
                        {
                            <FilaEntidadRelacionada
                                Titulo="@centro.Nombre"
                                Subtitulo="@($"{centro.ClienteRazonSocial} · {centro.TrabajadoresAsignados} trabajador(es)")"
                                OnClic="() => AbrirCentroAsync(centro)" />
                        }
                    </ul>
                }
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Subcontrata" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("trabajadores", "Trabajadores"),
        new("documentacion", "Documentación"),
        new("centros", "Centros"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private SubcontrataDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;

    private IReadOnlyList<TrabajadorListaDto>? _trabajadores;
    private bool _cargandoTrabajadores;
    private IReadOnlyList<CentroConActividadDto>? _centros;
    private bool _cargandoCentros;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _idCargado = EntidadId;
            _trabajadores = null;
            _centros = null;
            await CargarCabeceraAsync();
        }

        if (PestanaActiva == "trabajadores" && _trabajadores is null && !_cargandoTrabajadores)
            await CargarTrabajadoresAsync();

        if (PestanaActiva == "centros" && _centros is null && !_cargandoCentros)
            await CargarCentrosAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            _detalle = await Mediator.Send(new ObtenerSubcontrataPorIdQuery(EntidadId));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarTrabajadoresAsync()
    {
        _cargandoTrabajadores = true;
        var resultado = await Mediator.Send(new ObtenerTrabajadoresQuery(Busqueda: null, SubcontrataId: EntidadId, TamanoPagina: 50));
        _trabajadores = resultado.Elementos;
        _cargandoTrabajadores = false;
    }

    private async Task CargarCentrosAsync()
    {
        _cargandoCentros = true;
        _centros = await Mediator.Send(new ObtenerCentrosConActividadDeSubcontrataQuery(EntidadId));
        _cargandoCentros = false;
    }

    private Task AbrirTrabajadorAsync(TrabajadorListaDto trabajador) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Trabajador, trabajador.Id, $"{trabajador.Nombre} {trabajador.Apellidos}", "informacion");

    private Task AbrirCentroAsync(CentroConActividadDto centro) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Centro, centro.Id, centro.Nombre, "informacion");
}
