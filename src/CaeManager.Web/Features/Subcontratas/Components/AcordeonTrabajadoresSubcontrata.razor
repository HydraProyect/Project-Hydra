@*
    Segundo y tercer nivel de "Subcontrata 360" (mismo patrón que
    AcordeonAsignacionesCentro para Centro 360): trabajadores de la
    subcontrata con su fracción de documentación al día, expandibles a la
    tabla de documentos exigidos. Solo se instancia al expandir la fila
    (mismo criterio de carga perezosa) — sin acciones de alta/baja: los
    trabajadores se dan de alta/baja desde su propia ficha, no desde aquí
    (a diferencia de Centro, la Subcontrata no "asigna" trabajadores a sí
    misma).
*@
@using CaeManager.Application.Asignaciones.Queries.ObtenerAsignacionesDocumentacionPorCentro
@using CaeManager.Application.Subcontratas.Queries.ObtenerTrabajadoresDocumentacionPorSubcontrata
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Subcontratas.Recursos
@using CaeManager.Web.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosSubcontratas> Textos
@inject IStringLocalizer<TextosComunes> Comunes

@if (_errorCarga)
{
    <EstadoVacio Titulo="@Textos["ErrorCargaTrabajadoresTitulo"]" Descripcion="@Textos["ErrorIntentaNuevamente"]">
        <Accion>
            <Boton OnClick="CargarAsync">@Comunes["Reintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_trabajadores.Count == 0)
{
    <EstadoVacio Titulo="@Textos["AcordeonVacioTitulo"]" Descripcion="@Textos["AcordeonVacioDescripcion"]" />
}
else
{
    <div class="lista-trabajadores-acordeon">
        @foreach (var trabajador in _trabajadores)
        {
            var expandido = _expandidosTrabajador.Contains(trabajador.TrabajadorId);
            var vencidos = DocumentosVencidos(trabajador);
            var proximos = DocumentosProximos(trabajador);
            var urgentes = DocumentosUrgentes(trabajador);
            <div class="fila-trabajador-acordeon" @key="trabajador.TrabajadorId">
                <div class="fila-trabajador-acordeon-cuerpo">
                    <div class="fila-trabajador-rejilla">
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@Textos["AriaDocumentosExigidosA", trabajador.TrabajadorNombre]"
                                @onclick="() => AlternarExpansionTrabajador(trabajador.TrabajadorId)">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        <button type="button" class="enlace-nombre-fila fila-trabajador-nombre" @onclick="() => AbrirDetalleTrabajador(trabajador)">
                            @trabajador.TrabajadorNombre
                        </button>
                        <span class="fila-trabajador-fraccion">
                            @(trabajador.Documentos.Count > 0 ? $"{DocumentosAlDia(trabajador)}/{trabajador.Documentos.Count}" : "—")
                        </span>
                        <span class="tarjeta-fila-acordeon-indicadores">
                            <span class="ranura-recuento">
                                @if (vencidos.Count > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(vencidos.Count, "RecuentoDocumentosVencidosUno", "RecuentoDocumentosVencidosVarios")"
                                                     Titulo="@DescribirRecuento(vencidos.Count, "RecuentoDocumentosVencidosUno", "RecuentoDocumentosVencidosVarios")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                @vencidos.Count
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var documento in vencidos)
                                            {
                                                <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                            <span class="ranura-recuento">
                                @if (proximos.Count > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(proximos.Count, "RecuentoDocumentosProximosUno", "AriaRecuentoDocumentosProximosVarios")"
                                                     Titulo="@DescribirRecuento(proximos.Count, "RecuentoDocumentosProximosUno", "RecuentoDocumentosProximosVarios")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                @proximos.Count
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var documento in proximos)
                                            {
                                                <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                            <span class="ranura-recuento ranura-recuento-final">
                                @if (urgentes.Count > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(urgentes.Count, "RecuentoDocumentosUrgentesUno", "AriaRecuentoDocumentosUrgentesVarios")"
                                                     Titulo="@DescribirRecuento(urgentes.Count, "RecuentoDocumentosUrgentesUno", "RecuentoDocumentosUrgentesVarios")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento">
                                                @urgentes.Count
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var documento in urgentes)
                                            {
                                                <span class="ventana-linea">@DescribirDocumentoIncidencia(documento)</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                        </span>
                        <span class="fila-trabajador-accion">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                   class="@("accion-fila-enlace" + (trabajador.PeorEstado == EstadoDocumento.Vigente ? " accion-atenuada" : null))"
                                   OnClick="() => AbrirDetalleTrabajador(trabajador)">
                                @Textos["BotonDetalles"]
                            </Boton>
                        </span>
                    </div>
                    @if (expandido)
                    {
                        @if (trabajador.Documentos.Count == 0)
                        {
                            <p class="texto-vacio-seccion">@Textos["TrabajadorSinDocumentacionExigida"]</p>
                        }
                        else
                        {
                            <div class="tabla-documentos-requeridos" role="table"
                                 aria-label="@Textos["AriaDocumentacionExigidaA", trabajador.TrabajadorNombre]">
                                <div class="documentos-requeridos-cabecera" role="row">
                                    <span role="columnheader">@Textos["ColumnaDocumento"]</span>
                                    <span role="columnheader">@Textos["ColumnaEstado"]</span>
                                    <span role="columnheader">@Textos["ColumnaVigencia"]</span>
                                    <span role="columnheader" class="columna-accion">@Textos["ColumnaAccion"]</span>
                                </div>
                                @foreach (var documento in trabajador.Documentos)
                                {
                                    <div class="fila-documento-requerido" role="row" @key="documento.TipoDocumentoId">
                                        <span class="celda-documento-nombre" role="cell">
                                            <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarAsync(trabajador.TrabajadorId, documento)">
                                                @documento.TipoDocumentoNombre
                                            </button>
                                        </span>
                                        <span role="cell">
                                            @if (documento.DocumentoId is null)
                                            {
                                                @* Se pide en ese centro por dos vías posibles
                                                   (ResolucionTipoDocumentoCentro.Aplica, mismo criterio que
                                                   Alertas.razor): la fila de ese centro, o si el centro no dice
                                                   nada, el valor general del tipo. Atribuirlo solo al centro
                                                   mentía en los centros que no han configurado nada. *@
                                                <VentanaContexto Etiqueta="@Textos["AriaFaltaDocumento"]"
                                                                 Titulo="@Textos["BadgeFalta"]">
                                                    <Disparador>
                                                        <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@Textos["BadgeFalta"]</Badge>
                                                    </Disparador>
                                                    <Detalle>
                                                        @Textos["ExplicacionFaltaDocumento"]
                                                    </Detalle>
                                                </VentanaContexto>
                                            }
                                            else
                                            {
                                                <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">
                                                    @EstadoDocumentoUi.Texto(documento.Estado)
                                                </Badge>
                                            }
                                        </span>
                                        <span role="cell">
                                            <TextoFechaCopiable Fecha="documento.FechaVencimiento" Class="celda-documento-vigencia">
                                                @TextoVigencia(documento)
                                            </TextoFechaCopiable>
                                        </span>
                                        <span class="columna-accion" role="cell">
                                            @* DrawerGestionDocumento solo crea o renueva (CrearDocumento/RenovarDocumento,
                                               ICommand denegados a Consulta): no tiene uso de solo lectura. *@
                                            <SoloConEscritura>
                                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                                       class="@("accion-fila-enlace" + (RequiereIntervencion(documento) ? null : " accion-atenuada"))"
                                                       OnClick="() => GestionarAsync(trabajador.TrabajadorId, documento)">
                                                    @Textos["BotonGestionar"]
                                                </Boton>
                                            </SoloConEscritura>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

@code {
    [Parameter, EditorRequired] public Guid SubcontrataId { get; set; }
    [Parameter] public EventCallback OnCambio { get; set; }

    private IReadOnlyList<TrabajadorDocumentacionSubcontrataDto> _trabajadores = [];
    private bool _cargando = true;
    private bool _errorCarga;
    private readonly HashSet<Guid> _expandidosTrabajador = [];
    private DrawerGestionDocumento _drawerGestion = default!;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = false;

        try
        {
            _trabajadores = await Mediator.Send(new ObtenerTrabajadoresDocumentacionPorSubcontrataQuery(SubcontrataId));
        }
        catch (Exception)
        {
            _errorCarga = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AlternarExpansionTrabajador(Guid trabajadorId)
    {
        if (!_expandidosTrabajador.Add(trabajadorId))
            _expandidosTrabajador.Remove(trabajadorId);
    }

    private Task AbrirDetalleTrabajador(TrabajadorDocumentacionSubcontrataDto trabajador) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Trabajador, trabajador.TrabajadorId, trabajador.TrabajadorNombre, "informacion");

    /// <summary>Mismo patrón que AcordeonAsignacionesCentro.GestionarAsync: con DocumentoId edita, sin él abre creación para el faltante.</summary>
    private Task GestionarAsync(Guid trabajadorId, DocumentoRequeridoDto documento) =>
        documento.DocumentoId is { } documentoId
            ? _drawerGestion.AbrirEditarAsync(documentoId)
            : _drawerGestion.AbrirCrearParaFaltanteAsync(trabajadorId, documento.TipoDocumentoId);

    private async Task ManejarDocumentoGuardadoAsync()
    {
        await CargarAsync();
        await OnCambio.InvokeAsync();
    }

    private static List<DocumentoRequeridoDto> DocumentosVencidos(TrabajadorDocumentacionSubcontrataDto trabajador) =>
        trabajador.Documentos.Where(d => d.Estado is EstadoDocumento.Vencido or EstadoDocumento.Faltante).ToList();

    private static List<DocumentoRequeridoDto> DocumentosProximos(TrabajadorDocumentacionSubcontrataDto trabajador) =>
        trabajador.Documentos.Where(d => d.Estado == EstadoDocumento.Proximo).ToList();

    private static List<DocumentoRequeridoDto> DocumentosUrgentes(TrabajadorDocumentacionSubcontrataDto trabajador) =>
        trabajador.Documentos.Where(d => d.Estado == EstadoDocumento.Urgente).ToList();

    private static int DocumentosAlDia(TrabajadorDocumentacionSubcontrataDto trabajador) =>
        trabajador.Documentos.Count(d => d.Estado is EstadoDocumento.Vigente or EstadoDocumento.SinCaducidad);

    private static bool RequiereIntervencion(DocumentoRequeridoDto documento) =>
        documento.Estado is not EstadoDocumento.Vigente;

    private string DescribirDocumentoIncidencia(DocumentoRequeridoDto documento) =>
        documento.DocumentoId is null
            ? Textos["IncidenciaFalta", documento.TipoDocumentoNombre]
            : $"{documento.TipoDocumentoNombre} — {EstadoDocumentoUi.Texto(documento.Estado)}";

    /// <summary>Recuento con su plural: <paramref name="claveUno"/> para 1, <paramref name="claveVarios"/> (número en {0}) para el resto.</summary>
    private string DescribirRecuento(int total, string claveUno, string claveVarios) =>
        total == 1 ? Textos[claveUno] : Textos[claveVarios, total];

    private static string TextoVigencia(DocumentoRequeridoDto documento) =>
        documento.FechaVencimiento is { } fecha ? fecha.ToString("dd/MM/yyyy", CultureInfo.CurrentCulture) : "—";
}
