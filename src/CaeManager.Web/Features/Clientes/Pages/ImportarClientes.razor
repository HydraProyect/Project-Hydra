@page "/clientes/importar"
@* Sin prerender (como Mi trabajo, M-23): la página carga en el ciclo de vida y no persiste su estado; con prerender
   corría dos veces en cada visita. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.ConCargaMasivaCsv)]
@inject NavigationManager Navigation

<LimiteDeErrores Pagina="this" />

@code {
    // La plantilla de Clientes es hoy el paso 1 del asistente unificado
    // (/importacion, Features/Importacion/Pages/Importacion.razor — Plantillas["clientes"]).
    // Se redirige en vez de eliminar la ruta para no romper un marcador guardado (H-1).
    protected override void OnInitialized() =>
        Navigation.NavigateTo("/importacion?plantilla=clientes", forceLoad: true, replace: true);
}
