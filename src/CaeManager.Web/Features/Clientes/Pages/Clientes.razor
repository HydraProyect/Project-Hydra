@page "/clientes"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = CaeManager.Web.Features.Comunicaciones.RolesComunicaciones.Gestion)]
@using CaeManager.Application.Clientes.Commands.CrearCliente
@using CaeManager.Application.Clientes.Commands.EditarCliente
@using CaeManager.Application.Clientes.Commands.EliminarCliente
@using CaeManager.Application.Clientes.Queries.ObtenerClientePorId
@using CaeManager.Application.Clientes.Queries.ObtenerClientes
@using CaeManager.Application.Common
@using CaeManager.Application.Documentos
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Clientes.Components
@using CaeManager.Web.Features.Documentos
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.IncorporacionCartera.Components
@using CaeManager.Web.Features.Clientes.Recursos
@using CaeManager.Web.Components.Layout
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject IStringLocalizer<TextosClientes> Textos
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject ContextWorkspaceService WorkspaceService

<LimiteDeErrores Pagina="this">
<PageTitle>Clientes empresariales — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Rediseño de listados, fase 1 (piloto): cabecera de una línea (CabeceraListado) con el
       contador, el conmutador ☑ de selección múltiple, el menú «⋯» con las acciones
       secundarias y UNA acción primaria. Las filas de esta pantalla son Clientes
       empresariales del Tenant (Empresas que reciben el servicio en una Relación
       Empresarial), no Clientes comerciales TALVEG.

       Sin antetítulo («Negocio» ya está en las migas) y sin el rótulo de la empresa
       gestionada: el selector de la barra lateral ya dice cuál es. El estado vacío sin
       empresa elegida (4a) sigue más abajo.

       El «⋯» junta lo que antes era el enlace «Exportar a Excel» y el menú «Más»:
       Exportar (cualquier rol: es lectura), las dos importaciones (solo Administrador) y
       «Alta guiada» (con escritura y alcance no cero). *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
    {
        <CabeceraListado Titulo="@Textos["ListaTitulo"]" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            <Menu>
                <CaeManager.Web.Exportacion.EntradasExportar Ruta="/clientes/exportar.xlsx" Total="_totalElementos" Criterios="CriteriosExportar" />
                <SoloConEscritura>
                    <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                        <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/importacion?plantilla=clientes")'>@Textos["ListaImportar"]</ItemMenuAccion>
                        <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/importacion?plantilla=combinada")'>@Textos["ListaImportacionCombinada"]</ItemMenuAccion>
                    </AuthorizeView>
                    @if (!_alcanceCero)
                    {
                        <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/clientes/alta-guiada")'>Alta guiada</ItemMenuAccion>
                    }
                </SoloConEscritura>
            </Menu>
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">@Textos["ListaNuevo"]</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="@Textos["ListaTitulo"]" />
    }
    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve las
           clientes de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="clientes" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {

    @* Barra de filtros en modo pastillas: el buscador «Filtrar esta pantalla» (tecla f),
       una pastilla por filtro y «Más filtros» con los filtros guardados (cada uno con su ✕,
       que pide confirmación) y «Guardar filtro».

       - El buscador solo busca en la razón social (ObtenerClientesQuery no busca por CIF ni
         alias): la pista dice «nombre», no promete lo que no encuentra.
       - «Criticidad» (Todos / Solo críticos) sigue viajando en la URL como <c>critico</c>.
       - «Gestor CAE» nombra a la persona de referencia de este Cliente empresarial (no
         concede alcance: la cartera es el Tenant entero); el campo del modelo sigue siendo
         deuda terminológica en código. *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos"
                  OnLimpiarTodo="LimpiarFiltrosAsync" OnGuardarFiltro="AbrirGuardarFiltro"
                  FiltrosGuardados="OpcionesFiltrosGuardados" OnAplicarFiltroGuardado="AplicarFiltroGuardadoAsync"
                  OnBorrarFiltroGuardado="PedirEliminarFiltroGuardado">
        <Pastillas>
            <PastillaFiltro Etiqueta="Gestor CAE" Valor="@_ejecutivoFiltro" ValorChanged="CambiarEjecutivoFiltroAsync" Opciones="OpcionesGestorCae" />
            <PastillaFiltro Etiqueta="@Textos["ListaFiltroEstado"]" Valor="@_estadoDocumentalFiltro" ValorChanged="CambiarEstadoDocumentalFiltroAsync" Opciones="OpcionesEstadoDocumental" />
            <PastillaFiltro Etiqueta="@Textos["ListaFiltroCriticidad"]" Valor="@(_soloCriticos ? ValorSoloCriticos : string.Empty)"
                            ValorChanged="v => CambiarSoloCriticosAsync(v == ValorSoloCriticos)" Opciones="OpcionesCriticidad" />
        </Pastillas>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroBusqueda" EtiquetaAccesible="Quitar filtro de búsqueda" OnQuitar="QuitarFiltroBusquedaAsync" />
            }
            @if (_soloCriticos)
            {
                <ChipFiltro Etiqueta="Solo críticos" EtiquetaAccesible="Quitar filtro de críticos" OnQuitar="QuitarFiltroCriticosAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_ejecutivoFiltro))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroEjecutivo" EtiquetaAccesible="Quitar filtro de Gestor CAE" OnQuitar="QuitarFiltroEjecutivoAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_estadoDocumentalFiltro))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroEstadoDocumental" EtiquetaAccesible="Quitar filtro de estado documental" OnQuitar="QuitarFiltroEstadoDocumentalAsync" />
            }
        </Chips>
        <Resumen>
            @if (!_errorCarga && _totalElementos > 0 && HayFiltrosActivos)
            {
                @* El total lo da la consulta ya filtrada: es el número de coincidencias, no el de
                   la cartera entera. Sin filtros ya lo dice el contador de la cabecera. *@
                <span class="conteo-clientes">@TextoConteo</span>
            }
        </Resumen>
    </BarraFiltros>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los Clientes empresariales" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @* El grid se mantiene siempre montado (solo se oculta con CSS) para que la
           referencia @@ref siga siendo válida y RefreshDataAsync funcione incluso al
           pasar de 0 a 1 elementos — ver Clientes.razor.cs. *@
        @if (_seleccionMultiple && TodosSeleccionados && _totalElementos > _elementosPagina.Count)
        {
            @* Mitad informativa del banner del mockup. La otra mitad,
               «Seleccionar los N filtrados», NO se implementa: añade selección
               masiva sobre un camino destructivo (la barra de lote borra), y
               eso es una decisión de producto, no de maquetación — mismo
               criterio que Centros y Subcontratas. Por eso el texto dice
               expresamente que los de otras páginas no entran. *@
            <p class="aviso-seleccion-pagina" role="status">
                @TextoAvisoSeleccionPagina
            </p>
        }

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="ClienteListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="Seleccionar los de esta página" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@($"Seleccionar {context.RazonSocial}")" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Razón social" Sortable="true" SortBy="@(GridSort<ClienteListaDto>.ByAscending(c => c.RazonSocial))">
                    @* Pieza 5 del patrón: el nombre, en negrita y sin
                       subrayado, abre la vista previa lateral (pieza 6). La
                       ficha 360 (/clientes/{id}) se abre desde el «⋯» y desde
                       el pie de la vista previa. Esto revierte la decisión
                       2026-09-22 (nombre = enlace a la ficha); el contrato
                       del 2026-09-28 manda. *@
                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad" @onclick="() => AbrirVistaPrevia(context.Id)">@context.RazonSocial</button>
                    @* «⚑ Crítico» junto al nombre, en lugar de la antigua columna «Crítico». *@
                    @if (context.EsCritico)
                    {
                        <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="insignia-critico" title="@Textos["ListaCriticoTitulo"]"><Icono Nombre="bandera" Tamano="TamanoIcono.Pequeno" />@Textos["Critico"]</Badge>
                    }
                    @* Perfil incompleto: sin agenda no hay a quién reclamarle.
                       Lleva directo a la pestaña que lo resuelve. No sale en el
                       mockup y se conserva. *@
                    @if (context.SinContactoEnAgenda)
                    {
                        <button type="button" class="aviso-sin-agenda"
                                title="Sin contacto en la agenda: no se puede reclamar documentación a este Cliente empresarial"
                                @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Cliente, context.Id, context.RazonSocial, "agenda")'>
                            Sin contacto
                        </button>
                    }
                </TemplateColumn>
                <PropertyColumn Property="@(c => c.Cif)" Title="CIF" Sortable="true" />
                <TemplateColumn Title="Gestor CAE">
                    @if (GestorCaeDeLaFila(context.EjecutivoUsuarioId) is { } gestor)
                    {
                        <span class="persona-identidad">
                            <AvatarUsuario Nombre="@gestor.NombreCompleto" Avatar="@gestor.Avatar" Tamano="TamanoAvatarUsuario.Pequeno" />@gestor.NombreCompleto
                        </span>
                    }
                    else
                    {
                        <span class="texto-vacio-celda">—</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Centros" Align="Align.Center">
                    @* Antes era un enlace a /centros?clienteId=…, pero la lista
                       de Centros no filtra por ese parámetro (solo lo usa para
                       encadenar un alta): llevaba a TODOS los centros. Los
                       centros de este cliente sí están en su Cliente 360, en su
                       propia pestaña. *@
                    @if (context.Centros > 0)
                    {
                        <button type="button" class="enlace-centros-cliente"
                                aria-label="@($"Ver los {context.Centros} centros de {context.RazonSocial}")"
                                @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Cliente, context.Id, context.RazonSocial, "centros")'>
                            @context.Centros
                        </button>
                    }
                    else
                    {
                        <span class="texto-vacio-celda">0</span>
                    }
                </TemplateColumn>
                @* Columna de orden por defecto: el peor estado primero (Faltante → Vencido →
                   Urgente → Próximo → Al corriente), resuelto en ObtenerClientesQuery. *@
                <TemplateColumn Title="Estado documental" Sortable="true" IsDefaultSortColumn="true"
                                SortBy="@(GridSort<ClienteListaDto>.ByAscending(c => c.EstadoDocumentalPeor))">
                    @if (context.EstadoDocumentalPeor is { } peor)
                    {
                        <Badge Tono="EstadoDocumentoUi.Tono(peor)" ConIcono="true" title="@TituloEstadoDocumental(peor)">@TextoEstadoDocumental(peor, context.EstadoDocumentalCantidad)</Badge>
                    }
                    else
                    {
                        <Badge Tono="TonoBadge.Exito" ConIcono="true" title="Sin alertas de vigencia abiertas entre sus trabajadores">Al corriente</Badge>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Acciones" Align="Align.End">
                    @* Orden del contrato: «Abrir ficha 360 · Editar · … ·
                       Eliminar». La vista rápida ya no es un ítem: la abre el
                       nombre de la fila. La baja es lógica
                       (EliminarClienteCommand → MarcarComoEliminado, con
                       «Deshacer»), así que se rotula «Dar de baja» y con el
                       mismo verbo en la barra de lote, en los diálogos y en
                       los avisos; es el «Eliminar» del contrato. *@
                    <MenuAcciones>
                        <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo($"/clientes/{context.Id}")'>
                            Abrir ficha 360
                        </ItemMenuAccion>
                        <SoloConEscritura><ItemMenuAccion OnClick="() => AbrirEditarAsync(context.Id)">
                            Editar
                        </ItemMenuAccion></SoloConEscritura>
                        <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.RazonSocial)">
                            @Textos["DarDeBaja"]
                        </ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            @* Solo con más de una página (al tamaño mínimo, 20): con menos no hay nada que
               paginar, pero por encima de 20 se conserva el selector de tamaño aunque el
               tamaño elegido quepa en una página. Y si ya se eligió un tamaño mayor que el
               mínimo, el paginador se queda aunque el total baje (un filtro): sin él no habría
               forma de volver al tamaño de antes. Con cero resultados manda el estado vacío. *@
            @if (_totalElementos > TamanoPaginaMinimo || (_totalElementos > 0 && _paginacion.ItemsPerPage > TamanoPaginaMinimo))
            {
            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="Cliente(s) empresarial(es)" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
            }
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
               a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
               filtrar lo manda a duplicar algo que ya existe.

               La copia no afirma que HAYA registros dados de alta: el filtrado
               es de servidor y la consulta solo devuelve el total ya filtrado,
               así que la pantalla no sabe cuántos hay sin filtro. *@
            <EstadoVacio NombreIcono="vacio" Titulo="Ningún Cliente empresarial con estos filtros"
                         Descripcion="Ninguno coincide con la búsqueda ni con los filtros de criticidad, gestor o documentación.">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
            <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
                <EstadoVacio NombreIcono="clientes" Titulo="Aún no hay Clientes empresariales" Descripcion="Crea el primero para empezar a organizar tus centros de trabajo.">
                    <Accion>
                        <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">+ Nuevo Cliente empresarial</Boton></SoloConEscritura>
                        <Boton Variante="VarianteBoton.Secundario" OnClick='() => NavigationManager.NavigateTo("/clientes/alta-guiada")'>
                            Alta guiada (Cliente empresarial + Empresa + Centro)
                        </Boton>
                    </Accion>
                </EstadoVacio>
            </VacioSegunAlcance>
        }
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync"
                 Titulo="@(_editandoId is null ? "Nuevo Cliente empresarial" : "Editar Cliente empresarial")"
                 HayCambios="() => HayCambiosCliente" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 AlDescartarPorNavegacion="CerrarClienteDescartando"
                 TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <ChildContent>
        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" OnBlur="ValidarRazonSocialAsync" MensajeError="@ObtenerError(nameof(CrearClienteCommand.RazonSocial))" />
        <CampoTexto Etiqueta="Identificación fiscal" Placeholder="CIF, DNI o NIE" Valor="@_cif" ValorChanged="v => _cif = v" OnBlur="ValidarCifAsync" MensajeError="@ObtenerError(nameof(CrearClienteCommand.Cif))" />

        <label class="campo-checkbox">
            <input type="checkbox" @bind="_esCritico" /> Cliente empresarial crítico
        </label>

        <CampoTextarea Etiqueta="Notas" Valor="@_notas" ValorChanged="v => _notas = v" Filas="4" />

        @if (_editandoId is not null && _puedeReasignarEjecutivo)
        {
            <CampoSelect Etiqueta="Gestor CAE asignado" Valor="@_ejecutivoUsuarioId" ValorChanged="v => _ejecutivoUsuarioId = v">
                <option value="">Sin asignar</option>
                @foreach (var gestor in _gestoresDisponibles)
                {
                    <option value="@gestor.Id">@gestor.NombreCompleto (@gestor.Email)</option>
                }
            </CampoSelect>
            <p class="texto-vacio-seccion">Al cambiarlo, se avisa al Gestor CAE anterior y al nuevo. Es el Gestor CAE de referencia del Cliente empresarial: no cambia lo que cada uno puede ver.</p>
        }
    
    </ChildContent>
    <PieExtra>
        @if (_editandoId is null)
        {
            <Boton Variante="VarianteBoton.Secundario" Cargando="_guardando" OnClick="GuardarYCrearEmpresaAsync">
                Continuar con la empresa
            </Boton>
        }
    </PieExtra>
</DrawerFormulario>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Dar de baja a {_razonSocialAEliminar}?")"
    Mensaje="Se ocultará de las listas activas. Podrás deshacerlo desde el aviso que aparecerá."
    TextoBotonConfirmar="@Textos["DarDeBaja"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

@* Pieza 6: vista previa lateral. El pie ofrece «Abrir ficha 360». «Ver toda su
   documentación» sigue abriendo el panel de 520 px (Context Workspace). *@
<ClientePreviewDrawer ClienteId="_previewClienteId" Visible="_previewVisible" VisibleChanged="v => _previewVisible = v"
                      OnOperar="AbrirDesdeVistaPreviaAsync" OnAbrirFicha="AbrirFichaDesdeVistaPrevia" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true"
                    TextoAccion="@Textos["DarDeBajaSeleccionados"]" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Dar de baja {_seleccionados.Count} Cliente(s) empresarial(es)?")"
    Mensaje="Se ocultarán de las listas activas. Los que tengan centros activos no se podrán dar de baja."
    TextoBotonConfirmar="@Textos["DarDeBaja"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

@* Borrar un filtro guardado no tiene deshacer (el handler lo elimina), así que
   pide confirmación como cualquier otra acción destructiva. El mensaje dice el
   efecto real: desaparece de TUS filtros (son por usuario) y no toca ningún
   cliente ni lo que la lista enseña ahora. *@
<DialogoConfirmacion
    Visible="_filtroGuardadoAEliminar is not null"
    VisibleChanged="v => { if (!v) _filtroGuardadoAEliminar = null; }"
    Titulo="@($"¿Borrar el filtro guardado «{_filtroGuardadoAEliminar?.Nombre}»?")"
    Mensaje="Desaparecerá de tus filtros guardados de Clientes empresariales. No borra ningún Cliente empresarial ni cambia lo que la lista enseña ahora."
    TextoBotonConfirmar="Borrar filtro"
    EnProgreso="_eliminandoFiltroGuardado"
    OnConfirmar="ConfirmarEliminarFiltroGuardadoAsync" />

@* «Guardar filtro» es un formulario de un campo: ModalFormulario (guardián, «Cancelar», «Guardar» único con su motivo y estado, aviso
   del formulario y aviso de navegación vienen del kit; el DrawerFormulario de arriba lleva el suyo). *@
<ModalFormulario Visible="_mostrarGuardarFiltro" VisibleChanged="CerrarModalGuardarFiltro" Titulo="Guardar filtro actual"
                 Ancho="AnchoModal.Pequeno" HayCambios="() => HayCambiosFiltro" Guardando="_guardandoFiltro"
                 MensajeError="@_mensajeErrorFiltro" OnGuardar="GuardarFiltroActualAsync"
                 MotivoGuardarDeshabilitado="@(string.IsNullOrWhiteSpace(_nombreFiltroNuevo) ? Textos["GuardarFiltroSinNombre"].Value : null)"
                 AlDescartarPorNavegacion="CerrarFiltroDescartando" TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <CampoTexto Etiqueta="Nombre" Valor="@_nombreFiltroNuevo" ValorChanged="v => { _nombreFiltroNuevo = v; _mensajeErrorFiltro = null; }" Placeholder="Críticos sin CIF verificado" />
</ModalFormulario>
</LimiteDeErrores>

