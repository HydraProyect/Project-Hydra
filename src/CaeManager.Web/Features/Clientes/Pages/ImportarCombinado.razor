@page "/clientes/importar-combinado"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inject NavigationManager Navigation

@code {
    // La plantilla Combinada es hoy el paso 1 del asistente unificado
    // (/importacion, Features/Importacion/Pages/Importacion.razor — Plantillas["combinada"]).
    // Se redirige en vez de eliminar la ruta para no romper un marcador guardado (H-1).
    protected override void OnInitialized() =>
        Navigation.NavigateTo("/importacion?plantilla=combinada", forceLoad: true, replace: true);
}
