@page "/clientes/alta-guiada"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Web.Features.Comunicaciones.RolesComunicaciones.Gestion)]
@using CaeManager.Application.Centros.Commands.CrearCentro
@using CaeManager.Application.Clientes.Commands.CrearCliente
@using CaeManager.Application.Empresas.Commands.CrearEmpresa
@using CaeManager.Application.Empresas.Commands.EditarEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresaPorId
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Trabajadores.Commands.CrearTrabajador
@using CaeManager.Web.Components.Workspace
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject ContextWorkspaceService WorkspaceService
@inject IValidator<CrearClienteCommand> ValidadorClienteCrear
@inject IValidator<CrearEmpresaCommand> ValidadorEmpresaCrear
@inject IValidator<CrearCentroCommand> ValidadorCentroCrear
@inject IValidator<CrearTrabajadorCommand> ValidadorTrabajadorCrear

<PageTitle>Alta guiada — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina contenedor-alta-guiada">
    @* Miguero de dos nodos, igual que Centro 360 y Trabajador 360: arranca en
       la lista, no en el grupo de menú. El mockup dibuja «Negocio › Clientes ›
       Alta guiada», pero «Negocio» no tiene página a la que ir y Breadcrumb
       pinta todo nodo no final como botón — sería un control muerto. *@
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="Ruta de alta guiada" />

    <CabeceraPagina Titulo="Alta guiada de cliente">
        <Descripcion>
            Da de alta la Empresa, su Cliente, el primer Centro y sus Trabajadores en un solo sitio. Cada paso se guarda al
            confirmarlo — si te detienes a mitad de camino, lo ya creado no se pierde.
        </Descripcion>
        <Acciones>
            <a class="enlace-exportar" href="/clientes">Volver a Clientes</a>
        </Acciones>
    </CabeceraPagina>

    <IndicadorPasos Pasos="Pasos" PasoActual="@_pasoActual" PasosCompletados="_pasosCompletados" EtiquetaGrupo="Alta guiada" />

    <Tarjeta Class="tarjeta-alta-guiada">
        @if (_pasoActual == "empresa")
        {
            <h2 class="titulo-seccion-importacion">1. Empresa</h2>

            @if (_mensajeErrorEmpresa is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorEmpresa</div>
            }

            <label class="campo-checkbox">
                <input type="checkbox" @bind="_empresaExistente" /> Usar una empresa que ya existe
            </label>

            @if (_empresaExistente)
            {
                @* Tres estados, no uno: con cero empresas un desplegable cuya
                   única opción es "Selecciona una empresa…" invita a elegir
                   algo que no existe. *@
                @if (_cargandoCatalogoEmpresas)
                {
                    <EstadoCargando Filas="1" />
                }
                else if (_empresasCatalogo.Count == 0)
                {
                    <EstadoVacio Titulo="Todavía no hay ninguna empresa dada de alta"
                                 Descripcion="No es que el filtro no encuentre nada: el catálogo entero está vacío. Desmarca la casilla y crea la primera empresa aquí mismo." />
                }
                else
                {
                    <CampoSelect Etiqueta="Empresa" Valor="@_empresaExistenteId" ValorChanged="v => _empresaExistenteId = v">
                        <option value="">Selecciona una empresa…</option>
                        @foreach (var empresa in _empresasCatalogo)
                        {
                            <option value="@empresa.Id">@empresa.RazonSocial</option>
                        }
                    </CampoSelect>
                }
            }
            else
            {
                <CampoTexto Etiqueta="Razón social" Valor="@_razonSocialEmpresa" ValorChanged="v => _razonSocialEmpresa = v"
                            OnBlur="ValidarRazonSocialEmpresaAsync" MensajeError="@ObtenerError(_erroresEmpresa, nameof(CrearEmpresaCommand.RazonSocial))" />
                <CampoTexto Etiqueta="CIF (opcional)" Valor="@_cifEmpresa" ValorChanged="v => _cifEmpresa = v"
                            OnBlur="ValidarCifEmpresaAsync" MensajeError="@ObtenerError(_erroresEmpresa, nameof(CrearEmpresaCommand.Cif))" />
            }

            <div class="acciones-formulario">
                @* Con el catálogo vacío el botón no tiene nada que vincular. *@
                <Boton Cargando="_guardandoEmpresa" OnClick="GuardarEmpresaAsync"
                       Deshabilitado="@(_empresaExistente && !_cargandoCatalogoEmpresas && _empresasCatalogo.Count == 0)">
                    @(_empresaExistente ? "Vincular y continuar" : "Guardar y continuar")
                </Boton>
                <Boton Variante="VarianteBoton.Fantasma" Deshabilitado="_guardandoEmpresa" OnClick='() => NavigationManager.NavigateTo("/clientes")'>
                    Cancelar
                </Boton>
            </div>
        }
        else if (_pasoActual == "cliente")
        {
            <h2 class="titulo-seccion-importacion">2. Cliente</h2>
            @* El guardado es incremental de verdad: al llegar aquí la Empresa
               ya está en base. La marca lo dice explícitamente, que es lo que
               hace honesto que el botón secundario de este paso sea "Terminar
               aquí" y no "Cancelar". *@
            <p class="texto-vacio-seccion">
                Empresa: <strong>@_empresaNombre</strong>
                <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Ya creada</Badge>
            </p>

            @if (_mensajeErrorCliente is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorCliente</div>
            }

            <label class="campo-checkbox">
                <input type="checkbox" @bind="_clienteExistente" /> Vincular a un cliente que ya existe
            </label>

            @if (_clienteExistente)
            {
                @if (_cargandoCatalogoClientes)
                {
                    <EstadoCargando Filas="1" />
                }
                else if (_clientesCatalogo.Count == 0)
                {
                    <EstadoVacio Titulo="Todavía no hay ningún cliente dado de alta"
                                 Descripcion="No es que el filtro no encuentre nada: el catálogo entero está vacío. Desmarca la casilla y crea el primer cliente aquí mismo." />
                }
                else
                {
                    <CampoSelect Etiqueta="Cliente" Valor="@_clienteExistenteId" ValorChanged="v => _clienteExistenteId = v">
                        <option value="">Selecciona un cliente…</option>
                        @foreach (var cliente in _clientesCatalogo)
                        {
                            <option value="@cliente.Id">@cliente.RazonSocial</option>
                        }
                    </CampoSelect>
                }
            }
            else
            {
                <CampoTexto Etiqueta="Razón social" Valor="@_razonSocialCliente" ValorChanged="v => _razonSocialCliente = v"
                            OnBlur="ValidarRazonSocialClienteAsync" MensajeError="@ObtenerError(_erroresCliente, nameof(CrearClienteCommand.RazonSocial))" />
                <CampoTexto Etiqueta="CIF" Valor="@_cifCliente" ValorChanged="v => _cifCliente = v"
                            OnBlur="ValidarCifClienteAsync" MensajeError="@ObtenerError(_erroresCliente, nameof(CrearClienteCommand.Cif))" />

                <label class="campo-checkbox">
                    <input type="checkbox" @bind="_esCriticoCliente" /> Cliente crítico
                </label>
                @* Qué hace la casilla, no qué es: "crítico" a secas no dice al
                   gestor qué cambia si la marca. *@
                <p class="texto-vacio-seccion">Prioriza sus vencimientos.</p>

                <CampoTextarea Etiqueta="Notas del cliente" Valor="@_notasCliente" ValorChanged="v => _notasCliente = v" Filas="3" />
            }

            <div class="acciones-formulario">
                <Boton Cargando="_guardandoCliente" OnClick="GuardarClienteAsync"
                       Deshabilitado="@(_clienteExistente && !_cargandoCatalogoClientes && _clientesCatalogo.Count == 0)">
                    @(_clienteExistente ? "Vincular y continuar a Centro" : "Guardar y continuar a Centro")
                </Boton>
                <Boton Variante="VarianteBoton.Fantasma" Deshabilitado="_guardandoCliente" OnClick="VerEmpresaAsync">
                    Terminar aquí
                </Boton>
            </div>
        }
        else if (_pasoActual == "centro")
        {
            <h2 class="titulo-seccion-importacion">3. Centro</h2>
            <p class="texto-vacio-seccion">
                Empresa: <strong>@_empresaNombre</strong> · Cliente: <strong>@_clienteNombre</strong>
            </p>

            @if (_mensajeErrorCentro is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorCentro</div>
            }

            <CampoTexto Etiqueta="Nombre" Valor="@_nombreCentro" ValorChanged="v => _nombreCentro = v"
                        OnBlur="ValidarNombreCentroAsync" MensajeError="@ObtenerError(_erroresCentro, nameof(CrearCentroCommand.Nombre))" />
            <CampoTexto Etiqueta="Código de centro" Valor="@_codigoCentro" ValorChanged="v => _codigoCentro = v" />
            <CampoTexto Etiqueta="Dirección" Valor="@_direccionCentro" ValorChanged="v => _direccionCentro = v" />
            <CampoTexto Etiqueta="Contacto" Valor="@_contactoCentro" ValorChanged="v => _contactoCentro = v" />
            <CampoTexto Etiqueta="Contrato vigente hasta" Type="date" Valor="@_contratoVigenteHasta" ValorChanged="v => _contratoVigenteHasta = v" />

            <div class="acciones-formulario">
                <Boton Cargando="_guardandoCentro" OnClick="GuardarCentroAsync">Guardar centro</Boton>
                @if (_centrosCreados == 0)
                {
                    <Boton Variante="VarianteBoton.Fantasma" Deshabilitado="_guardandoCentro" OnClick="VerEmpresaAsync">
                        Terminar aquí
                    </Boton>
                }
            </div>

            @if (_centrosCreados > 0)
            {
                <div class="resumen-alta-guiada" role="status">
                    <p>
                        <strong>@_ultimoCentroNombre</strong> creado.
                        @(_centrosCreados > 1 ? $"({_centrosCreados} centros creados en esta alta.)" : "")
                    </p>
                    <div class="acciones-formulario">
                        <Boton Variante="VarianteBoton.Primario" OnClick="IrAPasoTrabajadores">Continuar a Trabajadores</Boton>
                        <Boton Variante="VarianteBoton.Secundario" OnClick="VerClienteAsync">Ver el cliente</Boton>
                        <Boton Variante="VarianteBoton.Secundario" OnClick="AnadirRequisitosAsync">Añadir requisitos documentales</Boton>
                    </div>
                    @* Los campos de arriba se acaban de vaciar. Sin decirlo, el
                       formulario en blanco se lee como que algo se ha perdido,
                       cuando es justo lo contrario: está listo para el
                       siguiente centro de la misma Empresa y Cliente. *@
                    <p class="texto-vacio-seccion">
                        El formulario se ha vaciado: puedes crear otro centro para esta misma Empresa y Cliente sin salir del paso.
                    </p>
                </div>
            }
        }
        else
        {
            <h2 class="titulo-seccion-importacion">4. Trabajadores</h2>
            <p class="texto-vacio-seccion">
                Empresa: <strong>@_empresaNombre</strong>
                @if (_ultimoCentroId is not null)
                {
                    <text> · Centro: <strong>@_ultimoCentroNombre</strong></text>
                }
            </p>
            @* Cada trabajador se crea en la Empresa del asistente y se
               asigna de inmediato al Centro que se acaba de crear (o al que
               llegó ya resuelto por una rama de entrada) — el propio hueco
               que el usuario pidió cerrar: dar de alta trabajadores y poder
               asignarlos a los centros a los que ingresan, sin salir del
               asistente. *@

            @if (_mensajeErrorTrabajador is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorTrabajador</div>
            }

            <CampoTexto Etiqueta="Nombre" Valor="@_nombreTrabajador" ValorChanged="v => _nombreTrabajador = v"
                        OnBlur="ValidarNombreTrabajadorAsync" MensajeError="@ObtenerError(_erroresTrabajador, nameof(CrearTrabajadorCommand.Nombre))" />
            <CampoTexto Etiqueta="Apellidos" Valor="@_apellidosTrabajador" ValorChanged="v => _apellidosTrabajador = v"
                        OnBlur="ValidarApellidosTrabajadorAsync" MensajeError="@ObtenerError(_erroresTrabajador, nameof(CrearTrabajadorCommand.Apellidos))" />
            <CampoTexto Etiqueta="DNI / NIE" Valor="@_dniTrabajador" ValorChanged="v => _dniTrabajador = v"
                        OnBlur="ValidarDniTrabajadorAsync" MensajeError="@ObtenerError(_erroresTrabajador, nameof(CrearTrabajadorCommand.Dni))" />
            <CampoTexto Etiqueta="Puesto" Valor="@_puestoTrabajador" ValorChanged="v => _puestoTrabajador = v" />
            <CampoTexto Etiqueta="Email" Valor="@_emailTrabajador" ValorChanged="v => _emailTrabajador = v" />

            <div class="acciones-formulario">
                <Boton Cargando="_guardandoTrabajador" OnClick="GuardarTrabajadorAsync">Guardar trabajador</Boton>
                <Boton Variante="VarianteBoton.Fantasma" Deshabilitado="_guardandoTrabajador" OnClick="VerEmpresaAsync">
                    Terminar aquí
                </Boton>
            </div>

            @if (_trabajadoresCreados > 0)
            {
                <div class="resumen-alta-guiada" role="status">
                    <p>
                        <strong>@_ultimoTrabajadorNombre</strong> creado@(_ultimoCentroId is not null ? " y asignado al centro" : "").
                        @(_trabajadoresCreados > 1 ? $"({_trabajadoresCreados} trabajadores creados en esta alta.)" : "")
                    </p>
                    <div class="acciones-formulario">
                        <Boton Variante="VarianteBoton.Secundario" OnClick="VerEmpresaAsync">Ver la empresa</Boton>
                    </div>
                    <p class="texto-vacio-seccion">
                        El formulario se ha vaciado: puedes crear otro trabajador para esta misma Empresa sin salir del paso.
                    </p>
                </div>
            }
        }
    </Tarjeta>
</div>
