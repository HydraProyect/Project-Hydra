@*
    Cliente 360, página (blueprint Project-Hydra-Negocio/tecnico/docs/blueprints/FICHAS-360.md y maqueta vigente;
    decisión del propietario 2026-09-22: cada 360 tiene página propia además
    del panel de 520 px). Ver el comentario de cabecera del .razor.cs para lo
    que esta página compone, lo que remite al panel y lo que no enseña.
*@
@page "/clientes/{ClienteId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Domain.Centros
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Blindaje42.Components
@using CaeManager.Web.Features.Centros
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Clientes.Components
@using CaeManager.Web.Features.Clientes.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosClientes> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.RazonSocial ?? Textos["Kicker"]) — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["RutaNavegacion"]" />

    @if (_noEncontrada)
    {
        <FichaNoEncontrada RutaLista="/clientes" />
    }
    else if (_error)
    {
        @*
            Mismo resultado que el panel: ObtenerClientePorIdQuery devuelve null
            fuera del alcance (IAlcanceDatosService + RLS) y la página no
            distingue «no existe» de «no tienes acceso» — no filtra información.
        *@
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]"
                     NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="ReintentarAsync">@Textos["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="5" />
    }
    else if (_detalle is not null)
    {
        @*
            Tarjeta de identidad compartida de las fichas 360. El anillo solo se ofrece
            con todos los Centros cargados y la lectura de bloqueos completada.
            Excluye los Centros sin gestión CAE y cuenta los que no tienen incidencias.
        *@
        @* Maqueta 17-10: «Cliente» sobre el nombre (Cliente 360 TALVEG.dc.html:315); la línea de datos termina en la pastilla con el peor
           estado de sus Centros con gestión CAE, por gravedad (CalculadoraEstadoCentro.Gravedad), no por el valor numérico del enum. *@
        <CabeceraIdentidad Titulo="@_detalle.RazonSocial" Kicker="@Textos["Kicker"]" Anillo="@(MostrarAnillo ? AnilloDeCentros : null)">
            <JuntoAlTitulo>
                @if (_detalle.EsCritico)
                {
                    <Badge Tono="TonoBadge.Peligro">@Textos["Critico"]</Badge>
                }
            </JuntoAlTitulo>
            <Datos>
              <div class="cliente360-datos">
               <div class="cliente360-meta">
                @{
                    var hayCif = !string.IsNullOrWhiteSpace(_detalle.Cif);
                    var recuentos = TextoRecuentos;
                    var contratista = _empresas is [var empresaContratista] ? empresaContratista.RazonSocial : null;
                }
                @* Sin CIF no hay nada que enseñar ni copiar, igual que en Empresa 360. *@
                @if (hayCif)
                {
                    <span>
                        @Textos["Cif"] <b>@_detalle.Cif</b>
                        <BotonCopiar Valor="@_detalle.Cif" Etiqueta="@Textos["CopiarCifEtiqueta"]" />
                    </span>
                }
                @if (recuentos is not null)
                {
                    @if (hayCif)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <span>@recuentos</span>
                }
                @if (contratista is not null)
                {
                    @if (hayCif || recuentos is not null)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <span>@Textos["CabeceraContratista", contratista]</span>
                }
                @if (PeorCentroConGestionCae is { } peorCentro)
                {
                    @if (hayCif || recuentos is not null || contratista is not null)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <Badge Tono="EstadoCentroUi.Tono(peorCentro.Estado, peorCentro.CumplimientoPorcentaje)" Tamano="TamanoBadge.Pequeno" data-peor-estado>@EstadoCentroUi.Texto(peorCentro.Estado, peorCentro.CumplimientoPorcentaje)</Badge>
                }
               </div>
               @* Decisión de Chris (2026-10-18): sin fila de indicadores por Centro en la cabecera; el motivo de cada Centro
                  se lee en su propia fila. *@
              </div>
            </Datos>
            <Acciones>
                @* Maqueta 17-10: acción principal «Editar Cliente» (abre el panel en Información) y menú «⋯» con «Tolerancia de documentos».
                   Las dos son escrituras: a Consulta no se le deja ni el botón ni un menú vacío. *@
                <SoloConEscritura>
                    <Boton Variante="VarianteBoton.Primario" OnClick="AbrirInformacionAsync">@Textos["EditarCliente"]</Boton>
                    <MenuAcciones ConBorde="true" EtiquetaAccesible="@Textos["MenuMasAcciones"]">
                        <ItemMenuAccion OnClick="AbrirToleranciasAsync">@Textos["ToleranciaMenu"]</ItemMenuAccion>
                        <ItemMenuAccion Destructivo="true" OnClick="AbrirBaja">@Textos["DarDeBaja"]</ItemMenuAccion>
                    </MenuAcciones>
                </SoloConEscritura>
            </Acciones>
        </CabeceraIdentidad>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral"]">
            <ChildContent>
                <Pestanas Definiciones="PestanasConRecuento" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestana" EtiquetaGrupo="@Textos["EtiquetaPestanas"]" Pagina360="true">
                    @switch (_pestanaActiva)
                    {
                        case "centros":
                            @if (_cargandoCentros)
                            {
                                <EstadoCargando Filas="3" />
                            }
                            else if (_errorCentros)
                            {
                                <EstadoVacio Titulo="@Textos["ErrorCentrosTitulo"]" Descripcion="@Textos["ErrorListaDescripcion"]">
                                    <Accion>
                                        <Boton Variante="VarianteBoton.Secundario" OnClick="ReintentarCentrosAsync">@Textos["Reintentar"]</Boton>
                                    </Accion>
                                </EstadoVacio>
                            }
                            else if (_centros is { Count: 0 })
                            {
                                <EstadoVacio Titulo="@Textos["SinCentrosTitulo"]" Descripcion="@Textos["SinCentrosDescripcion"]" />
                            }
                            else if (_centros is not null)
                            {
                                var centrosVisibles = CentrosVisibles;
                                @* Maqueta 17-10 (.barra-lista): los filtros de estado a la izquierda y el buscador a su derecha, en la misma fila. *@
                                <div class="cliente360-barra">
                                    <FranjaEstado Opciones="OpcionesFranjaCentros" Valor="@_estado" ValorChanged="CambiarEstado"
                                                  Recuentos="RecuentosCentros" TotalTodos="CentrosPorBusqueda.Count" />
                                    <div class="cliente360-buscador">
                                        <CampoTexto Type="search" Placeholder="@Textos["BuscadorCentros"]" aria-label="@Textos["BuscadorCentros"]"
                                                    Valor="@_busqueda" ValorChanged="BuscarCentros" />
                                    </div>
                                </div>
                                @if (_totalCentros > _centros.Count)
                                {
                                    <p class="texto-descriptivo" data-recuentos-parciales>@Textos["AvisoFranjaCentrosParcial", _centros.Count, _totalCentros]</p>
                                }
                                @* Decisión de Chris (2026-10-18): sin la línea «Mostrando N de M · del peor estado al mejor». Con el filtro
                                   sin resultados queda la salida: quitar los filtros. *@
                                @if (centrosVisibles.Count == 0)
                                {
                                    <p class="cliente360-resumen-lista">
                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="QuitarFiltros">@Textos["QuitarFiltros"]</Boton>
                                    </p>
                                }
                                @* Maqueta 17-10: el nombre del Centro abre su consulta rápida (panel de 520 px) y el icono 360 lleva a su página;
                                   rejilla identidad | cumplimiento | estado | icono, con la fila teñida si el Centro tiene un problema. *@
                                <ListaRelaciones Etiqueta="@Textos["ListaCentros"]">
                                    @foreach (var centro in centrosVisibles.Where(c => c.Estado != EstadoCentro.SinGestionCae))
                                    {
                                        <FilaRelacion @key="centro.Id" Nombre="@centro.Nombre" NombreIcono="centros" Tono="TonoDeFilaCentro(centro)"
                                                      HrefFila="@($"/centros/{centro.Id}")" OnNombre="() => AbrirCentroAsync(centro)" Detalle="FragmentoDetalleCentro(centro)">
                                            <JuntoAlNombre>
                                                @if (centro.Recuentos.Bloqueos.Count > 0)
                                                {
                                                    <span class="cliente360-bloqueo-plataforma">@Textos["RotuloBloqueoPlataforma"]</span>
                                                }
                                            </JuntoAlNombre>
                                            <Cifra>
                                                <span class="cliente360-cumplimiento" title="@Textos["CumplimientoCentro"]">
                                                    @(centro.CumplimientoPorcentaje is { } porcentaje ? $"{porcentaje} %" : Textos["CentroSinRequisitos"])
                                                </span>
                                            </Cifra>
                                            <Estado>
                                                <Badge Tono="EstadoCentroUi.Tono(centro.Estado, centro.CumplimientoPorcentaje)" Tamano="TamanoBadge.Pequeno">@EstadoCentroUi.Texto(centro.Estado, centro.CumplimientoPorcentaje)</Badge>
                                            </Estado>
                                            <Acciones>
                                                <Boton360 Nombre="@centro.Nombre" Href="@($"/centros/{centro.Id}")" />
                                            </Acciones>
                                        </FilaRelacion>
                                    }
                                </ListaRelaciones>
                                @if (centrosVisibles.Any(c => c.Estado == EstadoCentro.SinGestionCae))
                                {
                                    <section class="cliente360-sin-gestion-cae" aria-labelledby="cliente360-sin-gestion-titulo">
                                        <h3 id="cliente360-sin-gestion-titulo">@Textos["SinGestionCaeAnillo"]</h3>
                                        <ListaRelaciones Etiqueta="@Textos["ListaCentrosSinGestionCae"]">
                                            @foreach (var centro in centrosVisibles.Where(c => c.Estado == EstadoCentro.SinGestionCae))
                                            {
                                                <FilaRelacion @key="centro.Id" Nombre="@centro.Nombre" NombreIcono="centros"
                                                              HrefFila="@($"/centros/{centro.Id}")" OnNombre="() => AbrirCentroAsync(centro)" Detalle="FragmentoDetalleCentro(centro)">
                                                    <Derecha>
                                                        <Boton360 Nombre="@centro.Nombre" Href="@($"/centros/{centro.Id}")" />
                                                    </Derecha>
                                                </FilaRelacion>
                                            }
                                        </ListaRelaciones>
                                    </section>
                                }
                            }
                            break;

                        case "empresas":
                            @if (_cargandoEmpresas)
                            {
                                <EstadoCargando Filas="3" />
                            }
                            else if (_errorEmpresas)
                            {
                                <EstadoVacio Titulo="@Textos["ErrorEmpresasTitulo"]" Descripcion="@Textos["ErrorListaDescripcion"]">
                                    <Accion>
                                        <Boton Variante="VarianteBoton.Secundario" OnClick="ReintentarEmpresasAsync">@Textos["Reintentar"]</Boton>
                                    </Accion>
                                </EstadoVacio>
                            }
                            else if (_empresas is { Count: 0 })
                            {
                                <EstadoVacio Titulo="@Textos["SinEmpresasTitulo"]" Descripcion="@Textos["SinEmpresasDescripcion"]" />
                            }
                            else if (_empresas is not null)
                            {
                                <p class="cliente360-resumen-lista">@Plural(_empresas.Count, "ResumenEmpresasUno", "ResumenEmpresasVarios")</p>
                                <ListaRelaciones Etiqueta="@Textos["ListaEmpresas"]">
                                    @foreach (var empresa in _empresas)
                                    {
                                        @* Maqueta 17-10: el nombre abre la consulta rápida (panel de Empresa); el icono 360 lleva a Empresa 360. *@
                                        <FilaRelacion @key="empresa.Id" Nombre="@empresa.RazonSocial" NombreIcono="empresas"
                                                      OnNombre="() => AbrirEmpresaAsync(empresa)">
                                            <Detalle>@(string.IsNullOrWhiteSpace(empresa.Cif) ? "—" : empresa.Cif)</Detalle>
                                            <Derecha>
                                                <Boton360 Nombre="@empresa.RazonSocial" Href="@($"/empresas/{empresa.Id}")" />
                                            </Derecha>
                                        </FilaRelacion>
                                    }
                                </ListaRelaciones>
                            }
                            break;

                        case "subcontratas":
                            @if (_cargandoSubcontratas)
                            {
                                <EstadoCargando Filas="3" />
                            }
                            else if (_errorSubcontratas)
                            {
                                <EstadoVacio Titulo="@Textos["ErrorSubcontratasTitulo"]" Descripcion="@Textos["ErrorListaDescripcion"]">
                                    <Accion>
                                        <Boton Variante="VarianteBoton.Secundario" OnClick="ReintentarSubcontratasAsync">@Textos["Reintentar"]</Boton>
                                    </Accion>
                                </EstadoVacio>
                            }
                            else if (_subcontratas is { Count: 0 })
                            {
                                <EstadoVacio Titulo="@Textos["SinSubcontratasTitulo"]" Descripcion="@Textos["SinSubcontratasDescripcion"]" />
                            }
                            else if (_subcontratas is not null)
                            {
                                <p class="cliente360-resumen-lista">@Plural(_subcontratas.Count, "ResumenSubcontratasUno", "ResumenSubcontratasVarios")</p>
                                <ListaRelaciones Etiqueta="@Textos["ListaSubcontratas"]">
                                    @foreach (var subcontrata in _subcontratas)
                                    {
                                        <FilaRelacion @key="subcontrata.Id" Nombre="@subcontrata.RazonSocial" NombreIcono="subcontratas"
                                                      OnNombre="() => AbrirSubcontrataAsync(subcontrata)">
                                            <Derecha>
                                                <Boton360 Nombre="@subcontrata.RazonSocial" Href="@($"/subcontratas/{subcontrata.Id}")" />
                                            </Derecha>
                                        </FilaRelacion>
                                    }
                                </ListaRelaciones>
                            }
                            break;

                        case "documentacion":
                            <div class="cliente360-documentacion">
                                <DocumentosExigidosCliente ClienteId="ClienteId" Cargar="_documentacionHabilitada" Serie="_serie" />
                            </div>
                            break;

                        case "agenda":
                            <PestanaAgendaContactos Tipo="TipoPropietarioAgenda.Cliente" PropietarioId="ClienteId" />
                            break;

                        case "ficha":
                            @*
                                Maqueta 17-10: la tolerancia por defecto del Cliente empresarial vive en la pestaña «Ficha»
                                (antes, tarjeta del lateral): resumen de cuántos tipos la tienen y «Editar →», que abre el mismo
                                cajón de tolerancias. Los Centros la heredan salvo que fijen la suya.
                            *@
                            <div class="cliente360-ficha">
                                <Tarjeta Compacta="true" Titulo="@Textos["ToleranciaTarjetaTitulo"]">
                                    <AccionesHeader>
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirToleranciasAsync">@Textos["EditarEnlace"]</Boton>
                                        </SoloConEscritura>
                                    </AccionesHeader>
                                    <ChildContent>
                                        @if (ResumenTolerancias is { } resumenTolerancias)
                                        {
                                            <p class="cliente360-tolerancia-resumen" data-tolerancia-resumen>@resumenTolerancias</p>
                                        }
                                    </ChildContent>
                                </Tarjeta>
                            </div>
                            break;

                        case "historial":
                            <PestanaHistorial EntidadTipo="Cliente" EntidadId="ClienteId" />
                            break;
                    }
                </Pestanas>
            </ChildContent>
            <Lateral>
                @*
                    La razón social ya está en la cabecera; el CIF se repite aquí como «Identificación fiscal» copiable (maqueta del 17-10).
                    Del mockup de panel no entran, igual que en el panel, Alias y
                    Domicilio (sin columna), Portal principal (el portal es del
                    Centro), el «Gestor CAE de referencia» (deuda terminológica
                    congelada por TerminologiaCanonicaTests) ni Cumplimiento (sin dato por
                    Cliente empresarial). La fila «Gestor CAE» de la maqueta del 17-10 sí entra, con
                    «Dar acceso» y «Desasignarme» debajo (GestorCaeCliente): son las personas con
                    Asignación de Cartera sobre el Tenant, no esa referencia.
                *@
                <Tarjeta Compacta="true" Titulo="@Textos["TarjetaInformacion"]">
                    <AccionesHeader>
                        <SoloConEscritura>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirInformacionAsync">@Textos["EditarEnlace"]</Boton>
                        </SoloConEscritura>
                    </AccionesHeader>
                    <ChildContent>
                        <RejillaDatos>
                            @* Maqueta 17-10: «Identificación fiscal» ocupa la primera fila entera y se copia, aunque el CIF también esté en la cabecera. *@
                            @if (!string.IsNullOrWhiteSpace(_detalle.Cif))
                            {
                                <DatoRejilla Etiqueta="@Textos["IdentificacionFiscal"]" Ancho="true">
                                    @_detalle.Cif
                                    <BotonCopiar Valor="@_detalle.Cif" Etiqueta="@Textos["CopiarCifEtiqueta"]" />
                                </DatoRejilla>
                            }
                            <DatoRejilla Etiqueta="@Textos["Critico"]" Valor="@(_detalle.EsCritico ? Textos["Si"] : Textos["No"])" />
                            <DatoRejilla Etiqueta="@Textos["DatoAlta"]" Valor="@_detalle.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")" />
                        </RejillaDatos>
                        <GestorCaeCliente Cargar="_gestorCaeHabilitado" Serie="_serie" AlCargar="GestorCaeCargado" AlDesasignarme="IrAMiTrabajoTrasDesasignarme" />
                    </ChildContent>
                </Tarjeta>

                @* «Plataforma CAE»: lee después de la fila «Gestor CAE» (mismo DbContext); al Usuario de Cliente no se le pinta. *@
                <CaeManager.Web.Features.Clientes.Components.CajaPlataformaCaeCliente ClienteEmpresarialId="ClienteId"
                    Cargar="_plataformaCaeHabilitada" AlCargar="PlataformaCaeCargada" />

                @*
                    «Notas» es una sola columna (ClienteDetalleDto.Notas): la
                    tarjeta la enseña y «Editar →» abre el modal del kit.
                    Sin historial con fecha y autor: no existe entidad Nota.

                    La caja entera la decide el servidor (<c>NotaInternaVisible</c>):
                    al Usuario de Cliente (rol Cliente), que abre la ficha de su
                    propio Cliente empresarial, no se le pinta; la Sesión
                    Privilegiada de acceso total sí la ve, sin rol de negocio.
                *@
                @if (_detalle.NotaInternaVisible)
                {
                <NotaInterna Texto="@_detalle.Notas">
                    <Acciones>
                        <SoloConEscritura>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _notaVisible = true">@Textos["EditarEnlace"]</Boton>
                        </SoloConEscritura>
                    </Acciones>
                </NotaInterna>
                }
            </Lateral>
        </CuerpoConLateral>
    }
</div>
<DrawerToleranciasClienteEmpresarial @bind-Visible="_drawerToleranciasVisible" ClienteEmpresarialId="ClienteId" OnGuardado="TrasGuardarToleranciasAsync" />
@if (_detalle is not null)
{
    <SoloConEscritura>
        @if (_detalle.NotaInternaVisible)
        {
            <ModalNotaCliente @key="ClienteId" Detalle="_detalle" @bind-Visible="_notaVisible" OnGuardado="CargarCabeceraAsync" />
        }
        <DialogoConfirmacion @bind-Visible="_bajaVisible" Titulo="@Textos["BajaTitulo"]"
                             Mensaje="@Textos["BajaMensaje", _detalle.RazonSocial]" TextoBotonConfirmar="@Textos["DarDeBaja"]"
                             EnProgreso="_dandoDeBaja" OnConfirmar="DarDeBajaAsync">
            @if (_errorBaja is not null)
            {
                <p role="alert">@_errorBaja</p>
            }
        </DialogoConfirmacion>
    </SoloConEscritura>
}
</LimiteDeErrores>
