    private void IniciarEdicionIdentidad()
    {
        if (_detalle is null) return;

        _razonSocialEditada = _detalle.RazonSocial;
        _cifEditado = _detalle.Cif ?? string.Empty;
        _esCriticoEditado = _detalle.EsCritico;
        _mensajeErrorIdentidad = null;
        _erroresIdentidad = new Dictionary<string, string>();
        _editandoIdentidad = true;
    }

    private void CancelarEdicionIdentidad() => _editandoIdentidad = false;

    private string? ObtenerErrorIdentidad(string campo) => _erroresIdentidad.GetValueOrDefault(campo);

    /// <summary>
    /// La guarda de <c>_guardandoIdentidad</c> comprueba AL ENTRAR: el botón
    /// deshabilitado no basta, porque el clic ya viajaba cuando se
    /// deshabilitó. Reenvía la nota vigente para no borrarla, y la Version del
    /// detalle para que el comando detecte la edición concurrente.
    /// </summary>
    private async Task GuardarIdentidadAsync()
    {
        if (_detalle is null || _guardandoIdentidad) return;

        var generacion = _generacion;
        var detalle = _detalle;
        // El nombre que se está guardando, capturado antes del await: al
        // cambiar de ficha el borrador se tira, y el aviso tiene que poder
        // decir a quién se actualizó aunque ya no se vea.
        var nombreGuardado = _razonSocialEditada;
        _guardandoIdentidad = true;
        _mensajeErrorIdentidad = null;
        _erroresIdentidad = new Dictionary<string, string>();

        try
        {
            var resultado = await Mediator.Send(new EditarClienteCommand(
                detalle.Id, _razonSocialEditada, _cifEditado, _esCriticoEditado, detalle.Notas, detalle.Version));

            if (resultado.EsFallido)
            {
                // Misma regla del canal que en la nota: al formulario sin
                // nombre, al aviso con él.
                if (generacion == _generacion)
                    _mensajeErrorIdentidad = resultado.Error.Mensaje;
                else
                    ToastService.Mostrar($"No pudimos actualizar a {detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"{nombreGuardado} actualizado correctamente.", TonoToast.Exito);
            if (generacion != _generacion) return;
            _editandoIdentidad = false;
            // Recarga obligatoria: sin la Version nueva, un segundo guardado
            // choca contra la comprobación de concurrencia optimista.
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _erroresIdentidad = ex.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorIdentidad = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoIdentidad = false;
        }
    }

    /// <summary>
    /// Guardar la nota es un EditarClienteCommand completo —no hay comando de
    /// nota— así que reenvía la identidad vigente para no pisarla. Éxito solo
    /// si el comando lo dice: un Result fallido pinta el error y no toca ni el
    /// toast ni el borrador.
    /// </summary>
    private async Task GuardarNotaAsync()
    {
        if (_detalle is null || _guardandoNota) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _guardandoNota = true;
        _mensajeErrorNota = null;

        try
        {
            var nota = string.IsNullOrWhiteSpace(_notaEditada) ? null : _notaEditada;
            var resultado = await Mediator.Send(new EditarClienteCommand(
                detalle.Id, detalle.RazonSocial, detalle.Cif, detalle.EsCritico, nota, detalle.Version));

            if (resultado.EsFallido)
            {
                // Regla del canal (ver ConfirmarDarDeBajaAsync): si sigue
                // siendo esta ficha, el motivo va a su formulario TAL CUAL,
                // sin nombre —el formulario está dentro de la ficha, con su
                // razón social encima, y repetirlo ahí sería ruido—; si ya no
                // lo es, ese formulario no existe, el motivo se va al aviso y
                // entonces sí nombra de quién era. Un fallo no se traga por
                // haber cambiado de pantalla mientras el comando viajaba.
                if (generacion == _generacion)
                    _mensajeErrorNota = resultado.Error.Mensaje;
                else
                    ToastService.Mostrar($"No pudimos guardar la nota de {detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"Nota de {detalle.RazonSocial} guardada.", TonoToast.Exito);
            if (generacion != _generacion) return;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            var motivo = ex.Errors.FirstOrDefault()?.ErrorMessage ?? "Revisa el contenido de la nota.";
            if (generacion == _generacion)
                _mensajeErrorNota = motivo;
            else
                ToastService.Mostrar($"No pudimos guardar la nota de {detalle.RazonSocial}: {motivo}", TonoToast.Error);
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorNota = "No pudimos guardar la nota. Intenta nuevamente en unos segundos.";
            else
                ToastService.Mostrar($"No pudimos guardar la nota de {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoNota = false;
        }
    }

    private void AbrirDarDeBaja() => _confirmarBajaVisible = true;

    /// <summary>
    /// Baja lógica (EliminarClienteCommand marca la Empresa como eliminada; el
    /// comando la rechaza si tiene centros activos). Tras la baja la ficha ya
    /// no tiene nada que enseñar: se sale de este nivel —vuelve al anterior de
    /// la pila si lo hay, si no cierra el panel—, solo si este nivel sigue
    /// siendo el de este Cliente empresarial.
    /// </summary>
    private async Task ConfirmarDarDeBajaAsync()
    {
        if (_detalle is null || _dandoDeBaja) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _dandoDeBaja = true;

        try
        {
            var resultado = await Mediator.Send(new EliminarClienteCommand(detalle.Id));

            // Regla de las tres escrituras del panel, y es del CANAL, no del
            // manejador: un desenlace que viaja por AVISO nombra la entidad
            // —el aviso es global y puede leerse sobre cualquier ficha, así que
            // sin nombre se entendería de la que se esté viendo—; uno que
            // aterriza en el FORMULARIO de la ficha va sin nombre, porque ese
            // formulario solo existe mientras esa ficha está en pantalla y
            // lleva su razón social en la cabecera, justo encima. La baja no
            // tiene formulario: su único canal es el aviso, así que nombra
            // siempre, en los tres caminos.
            //
            // Y se anuncia siempre: el comando no lleva el token del ciclo
            // precisamente porque cerrar la ficha no deshace la baja, así que
            // callar el resultado porque entretanto cambió la ficha sería
            // tragarse un desenlace real —y, en el otro camino, un fallo—. Lo
            // que no pasa de la comprobación de generación es TOCAR la
            // pantalla: el diálogo y la navegación van detrás de ella, y la
            // navegación además comprueba que el nivel vigente siga siendo el
            // de esta entidad.
            if (resultado.EsFallido)
            {
                ToastService.Mostrar($"{detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                if (generacion == _generacion)
                    _confirmarBajaVisible = false;
                return;
            }

            ToastService.Mostrar($"{detalle.RazonSocial} se dio de baja.", TonoToast.Exito);
            if (generacion != _generacion) return;
            _confirmarBajaVisible = false;

            if (WorkspaceService.FrameActual is { Tipo: EntidadWorkspace.Cliente } frame && frame.EntidadId == detalle.Id)
            {
                if (WorkspaceService.Pila.Count > 1)
                    await WorkspaceService.VolverAsync();
                else
                    await WorkspaceService.CerrarAsync();
            }
        }
        catch (Exception)
        {
            ToastService.Mostrar($"No pudimos dar de baja a {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _dandoDeBaja = false;
        }
    }

    /// <summary>
    /// Al retirar el panel (cerrarlo, o que el Context Workspace pase a otro
    /// tipo de entidad) se invalida toda carga en vuelo —la cadena de
    /// <see cref="CargarTodoAsync"/> no sigue pidiendo datos para una ficha
    /// que ya no se ve— y se cancela la consulta que estuviera emitida. La
    /// cancelación llega a cada carga como una excepción que su propio catch
    /// ya descarta (la generación dejó de ser la vigente).
    /// </summary>
    public void Dispose()
    {
        InvalidarCargas();
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
