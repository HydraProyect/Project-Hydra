@* Crear un Cliente sin abandonar la pantalla desde la que se necesita
   (Fase A4) — se abre desde el "+ Crear «texto»" de un SelectorEntidad. Solo
   los campos obligatorios de CrearClienteCommand; EsCritico/Notas se dejan
   para cuando el gestor quiera editar el Cliente desde /clientes. *@
@using CaeManager.Application.Clientes.Commands.CrearCliente
@using FluentValidation
@using MediatR
@inject IMediator Mediator

<Modal Visible="Visible" VisibleChanged="CerrarAsync" Titulo="Nuevo cliente" Ancho="AnchoModal.Pequeno"
       CerrarAlHacerClicFuera="@(!_guardando)">
    <ChildContent>
        @if (_mensajeError is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeError</div>
        }

        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v"
                    MensajeError="@ObtenerError(nameof(CrearClienteCommand.RazonSocial))" />
        <CampoTexto Etiqueta="CIF" Valor="@_cif" ValorChanged="v => _cif = v"
                    MensajeError="@ObtenerError(nameof(CrearClienteCommand.Cif))" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarAsync(false)">
            Cancelar
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">Crear</Boton>
    </Pie>
</Modal>
