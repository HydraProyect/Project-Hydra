@* Crear un Cliente sin abandonar la pantalla desde la que se necesita
   (Fase A4) — se abre desde el "+ Crear «texto»" de un SelectorEntidad. Solo
   los campos obligatorios de CrearClienteCommand; EsCritico/Notas se dejan
   para cuando el gestor quiera editar el Cliente desde /clientes. *@
@using CaeManager.Application.Clientes.Commands.CrearCliente
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Recursos.TextosComunes> Comunes

<ModalFormulario HayCambios="() => HayCambiosSinGuardar" Visible="Visible" VisibleChanged="CerrarAsync" Titulo="Nuevo Cliente" Ancho="AnchoModal.Pequeno"
                 Guardando="_guardando" MensajeError="_mensajeError" HayErroresDeCampo="@(_erroresCampo.Count > 0)"
                 MotivoGuardarDeshabilitado="@(string.IsNullOrWhiteSpace(_razonSocial) || string.IsNullOrWhiteSpace(_cif) ? Comunes["CompletaCamposObligatorios"].Value : null)"
                 OnGuardar="GuardarAsync" TextoGuardar="@Comunes["FormularioRapidoCrear"]" TextoCancelar="@Comunes["FormularioRapidoCancelar"]">
        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="CambiarRazonSocialAsync"
                    MensajeError="@ObtenerError(nameof(CrearClienteCommand.RazonSocial))" />
        <CampoTexto aria-required="true" Etiqueta="Identificación fiscal *" Placeholder="CIF, DNI o NIE" Valor="@_cif" ValorChanged="CambiarCifAsync"
                    MensajeError="@ObtenerError(nameof(CrearClienteCommand.Cif))" />
</ModalFormulario>
