@*
    Pestaña «Documentación» de Cliente 360 (página): solo lo que el Cliente empresarial exige para acceder a sus
    Centros, es decir, sus requisitos documentales. Sin texto explicativo del art. 42.1/42.2 ET: los Gestores CAE lo
    saben (Chris, 2026-10-18).

    Universo: ObtenerDocumentacionExigidaDeClienteQuery, una sola consulta de servidor que agrega por tipo la misma
    regla que la pestaña «Requisitos» de Centro 360 sobre los Centros con gestión CAE del Cliente empresarial que caen
    en la Asignación de Cartera de quien mira. Un Centro sin gestión CAE no exige nada (como en Centro 360). No es un
    universo nuevo ni una lista de documentos registrados.

    Un solo formato de fila (nombre | en cuántos Centros | pastilla de estado | acción), en dos grupos plegados por
    defecto: lo que se exige a la Empresa empleadora y lo que se exige a sus Trabajadores (2026-10-21). Cada grupo enseña
    sus primeros diez y «Ver los N restantes».

    El certificado de la Seguridad Social (TGSS) se pide por Empresa: es la primera fila del grupo de la Empresa, una por
    Empresa con su estado real, y no sale además como requisito genérico. Pulsar su nombre abre DrawerBlindaje42 con el
    historial, en lectura para cualquier rol (el drawer guarda sus acciones tras SoloConEscritura); «Gestionar» abre el
    mismo drawer y solo se pinta con escritura. Un requisito de los Centros no tiene estado de cumplimiento en esta
    consulta: lleva «Se exige» o «Bloquea el acceso» y «Ver Centros», que lleva a la pestaña Centros del Cliente.

    No pregunta nada hasta que la página pone Cargar (terminó su cadena de lecturas): todas las consultas comparten el
    DbContext del circuito y no deben ir en paralelo. Al desmontarse cancela lo que tenga en vuelo.
*@
@using CaeManager.Application.Blindaje42.Queries.ObtenerBlindajeEmpresasDeCliente
@using CaeManager.Application.Centros.Queries.ObtenerDocumentacionExigidaDeCliente
@using CaeManager.Domain.Blindaje42
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Blindaje42.Components
@using CaeManager.Web.Features.Clientes.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject NavigationManager Navegacion
@inject IStringLocalizer<TextosClientes> Textos

@if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error)
{
    <EstadoVacio Titulo="@Textos["DocumentosExigidosError"]" Descripcion="@Textos["DocumentosExigidosErrorDescripcion"]">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="ReintentarAsync">@Textos["Reintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_empresas.Count == 0 && _documentacion.Requisitos.Count == 0)
{
    <EstadoVacio Titulo="@Textos["DocumentosExigidosVacio"]" />
}
else
{
    @* Un solo formato de fila (nombre | en cuántos Centros | estado | acción) en dos grupos plegados por defecto:
       lo que se exige a la Empresa empleadora y lo que se exige a sus Trabajadores. *@
    <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["ListaDocumentosExigidos"]">
        @foreach (var ambito in _ambitos)
        {
            var filas = FilasDe(ambito);
            if (filas.Count == 0)
                continue;

            // Documentos, no filas: el certificado de la Seguridad Social es uno aunque tenga una fila por Empresa.
            var documentos = filas.Select(f => f.Documento).Distinct().Count();
            var bloquean = filas.Where(f => f.Bloquea).Select(f => f.Documento).Distinct().Count();
            // Los grupos nacen plegados: el peor estado de sus filas se ve igualmente desde la cabecera.
            var descubiertos = filas.Any(f => f.TonoFila == TonoFila.Peligro);
            <FilaRelacion @key="ambito" Nombre="@Textos[ambito == AmbitoAplicacion.Empresa ? "RequisitoGrupoEmpresa" : "RequisitoGrupoTrabajador"]"
                          Tono="@(descubiertos ? TonoFila.Peligro : (TonoFila?)null)"
                          Desplegada="_gruposAbiertos.Contains(ambito)" DesplegadaChanged="v => AlternarGrupo(ambito, v)">
                <Detalle>@Textos[documentos == 1 ? "RequisitoGrupoUno" : "RequisitoGrupoVarios", documentos]</Detalle>
                <Estado>
                    @if (descubiertos)
                    {
                        <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@Textos["CertificadoConDescubiertos"]</Badge>
                    }
                    else if (bloquean > 0)
                    {
                        <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">@Textos[bloquean == 1 ? "RequisitoGrupoBloqueaUno" : "RequisitoGrupoBloqueanVarios", bloquean]</Badge>
                    }
                    else
                    {
                        <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno">@Textos["RequisitoGrupoSinBloqueos"]</Badge>
                    }
                </Estado>
                <Desplegable>
                    <ListaRelaciones Etiqueta="@Textos[ambito == AmbitoAplicacion.Empresa ? "RequisitoGrupoEmpresa" : "RequisitoGrupoTrabajador"]">
                        @foreach (var fila in VerRestantes.Recortar(filas, _gruposCompletos.Contains(ambito)))
                        {
                            <FilaRelacion @key="fila.Clave" Compacta="true" Nombre="@fila.Nombre" Tono="@fila.TonoFila" Detalle="DetalleDe(fila)"
                                          OnNombre="NombreDe(fila)">
                                <Cifra><span>@fila.Cifra</span></Cifra>
                                <Estado><Badge Tono="fila.Tono" Tamano="TamanoBadge.Pequeno">@fila.Estado</Badge></Estado>
                                <Acciones>
                                    @if (fila.Empresa is null)
                                    {
                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="IrACentros">@Textos["RequisitoVerCentros"]</Boton>
                                    }
                                    else
                                    {
                                        @* Con escritura, «Gestionar»; sin ella, el mismo drawer en lectura: la acción no falta a nadie. *@
                                        <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionEscritura">
                                            <Authorized>
                                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirDrawer(fila.Empresa)">@Textos["Gestionar"]</Boton>
                                            </Authorized>
                                            <NotAuthorized>
                                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirDrawer(fila.Empresa)">@Textos["RequisitoVerHistorial"]</Boton>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    }
                                </Acciones>
                            </FilaRelacion>
                        }
                    </ListaRelaciones>
                    <VerRestantes Total="filas.Count" Completa="_gruposCompletos.Contains(ambito)" OnVerRestantes="() => _gruposCompletos.Add(ambito)" />
                </Desplegable>
            </FilaRelacion>
        }
    </ListaRelaciones>
}

<DrawerBlindaje42 Visible="_drawerVisible" VisibleChanged="v => _drawerVisible = v"
                  ClienteId="_cliente" EmpresaId="_empresaId" EmpresaRazonSocial="_empresaNombre"
                  OnCambio="RecargarEmpresasAsync" />

@code {
    private static readonly DocumentacionExigidaClienteDto SinDocumentacion = new(0, []);

    [Parameter, EditorRequired] public Guid ClienteId { get; set; }

    /// <summary>
    /// La página lo pone cuando terminó su cadena de lecturas: hasta entonces no se pregunta nada, porque las
    /// consultas comparten el DbContext del circuito y no deben ir en paralelo.
    /// </summary>
    [Parameter] public bool Cargar { get; set; }

    /// <summary>
    /// Turno de lectura de la página: cada lectura de la pestaña lo toma y lo suelta al salir del DbContext, también si
    /// se canceló, así que ni choca con otra lectura de la página ni la siguiente empieza antes de que esta termine.
    /// </summary>
    [Parameter] public SerieDeLecturas? Serie { get; set; }

    /// <summary>
    /// Los requisitos que la página ya leyó para la cifra de su pestaña: la primera lectura los usa en vez de repetir la consulta
    /// (sigue siendo una sola consulta de servidor); «Reintentar» y las siguientes lecturas preguntan de nuevo.
    /// </summary>
    [Parameter] public DocumentacionExigidaClienteDto? Precargada { get; set; }

    private bool _precargadaUsada;

    private readonly CancellationTokenSource _ciclo = new();

    /// <summary>Copia de <c>_ciclo.Token</c>: se lee sin tocar la fuente, que puede estar ya liberada al desmontarse.</summary>
    private CancellationToken _cancelacion;

    /// <summary>Lecturas del Cliente empresarial actual (enlazada a <c>_ciclo</c>): se cancela al cambiar de Cliente.</summary>
    private CancellationTokenSource? _lectura;

    private IReadOnlyList<BlindajeEmpresaDto> _empresas = [];
    private DocumentacionExigidaClienteDto _documentacion = SinDocumentacion;
    private bool _cargando = true;
    private bool _error;
    private bool _leido;
    private Guid _cliente;

    /// <summary>Primero lo que se exige a la Empresa y después lo de sus Trabajadores, como devuelve el servidor.</summary>
    private static readonly AmbitoAplicacion[] _ambitos = [AmbitoAplicacion.Empresa, AmbitoAplicacion.Trabajador];

    /// <summary>Los grupos nacen plegados (decisión del 2026-10-21): solo se abre el que se pulsa.</summary>
    private readonly HashSet<AmbitoAplicacion> _gruposAbiertos = [];

    /// <summary>Grupos a los que se pidió «Ver los N restantes».</summary>
    private readonly HashSet<AmbitoAplicacion> _gruposCompletos = [];

    /// <summary>Sube con cada Cliente empresarial y con cada lectura completa: lo que llegue de una anterior no escribe.</summary>
    private int _generacion;

    private bool _drawerVisible;
    private Guid _empresaId;
    private string _empresaNombre = string.Empty;

    protected override void OnInitialized() => _cancelacion = _ciclo.Token;

    protected override async Task OnParametersSetAsync()
    {
        if (ClienteId != _cliente)
        {
            // Lo que siga en vuelo del Cliente anterior se corta ya: la página va a releer sobre el mismo DbContext.
            CancelarLectura();
            _cliente = ClienteId;
            _generacion++;
            _leido = false;
            _precargadaUsada = false;
            _cargando = true;
            _error = false;
            _empresas = [];
            _documentacion = SinDocumentacion;
            _gruposAbiertos.Clear();
            _gruposCompletos.Clear();
        }

        if (!Cargar || _leido)
            return;

        _leido = true;
        await CargarAsync();
    }

    /// <summary>Un doble clic en «Reintentar» no lanza una segunda lectura: la primera ya puso _cargando.</summary>
    private Task ReintentarAsync() => _cargando ? Task.CompletedTask : CargarAsync();

    private async Task CargarAsync()
    {
        var generacion = ++_generacion;
        var token = TokenDeLectura();
        _cargando = true;
        _error = false;

        try
        {
            // Una tras otra y con el turno de la página: comparten el DbContext del circuito.
            using var turno = await SerieDeLecturas.TomarSiHayAsync(Serie, token);
            var empresas = await Mediator.Send(new ObtenerBlindajeEmpresasDeClienteQuery(_cliente), token);
            var documentacion = Precargada is not null && !_precargadaUsada
                ? Precargada
                : await Mediator.Send(new ObtenerDocumentacionExigidaDeClienteQuery(_cliente), token);
            _precargadaUsada = true;
            if (generacion != _generacion) return;
            _empresas = empresas;
            _documentacion = documentacion ?? SinDocumentacion;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Desmontado o de otro Cliente empresarial: nadie va a pintar el resultado.
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _error = true;
        }
        finally
        {
            if (generacion == _generacion)
                _cargando = false;
        }
    }

    /// <summary>Tras una solicitud o una respuesta de la TGSS solo cambia el certificado: los requisitos no se releen.</summary>
    private async Task RecargarEmpresasAsync()
    {
        var generacion = _generacion;
        var token = TokenDeLectura();
        try
        {
            using var turno = await SerieDeLecturas.TomarSiHayAsync(Serie, token);
            var empresas = await Mediator.Send(new ObtenerBlindajeEmpresasDeClienteQuery(_cliente), token);
            if (generacion == _generacion)
                _empresas = empresas;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _error = true;
        }
    }

    /// <summary>
    /// Una fila de la lista, de cualquiera de los dos grupos: el mismo formato para todas. Un requisito de los Centros lleva
    /// «Se exige» o «Bloquea el acceso» (la consulta no sabe cuánto cumple el Cliente) y «Ver Centros»; el certificado de la
    /// Seguridad Social lleva una fila por Empresa con su estado real y «Gestionar».
    /// </summary>
    private sealed record FilaDoc(
        string Clave, string Documento, string Nombre, string? Detalle, string Cifra, TonoBadge Tono, string Estado,
        bool Bloquea, TonoFila? TonoFila = null, BlindajeEmpresaDto? Empresa = null);

    /// <summary>
    /// Las filas de un grupo. El certificado de la Seguridad Social es un requisito más del catálogo, pero se pinta con el
    /// estado de cada Empresa en vez de con el genérico, así que no sale dos veces.
    /// </summary>
    private IReadOnlyList<FilaDoc> FilasDe(AmbitoAplicacion ambito)
    {
        var filas = new List<FilaDoc>();
        var tgss = _documentacion.Requisitos.FirstOrDefault(r => r.EsCertificadoTgss);
        var tgssPorEmpresa = ambito == AmbitoAplicacion.Empresa && _empresas.Count > 0;

        if (tgssPorEmpresa)
        {
            var cifra = tgss is null ? string.Empty : TextoCentros(tgss.Centros);
            foreach (var empresa in _empresas)
            {
                var estado = empresa.UltimaSolicitud?.Estado;
                filas.Add(new FilaDoc(
                    $"tgss-{empresa.EmpresaId}", "tgss", Textos["CertificadoSeguridadSocialTitulo"],
                    $"{empresa.EmpresaRazonSocial} · {TextoSolicitudes(empresa.TotalSolicitudes)}", cifra,
                    PestanaBlindaje42.Tono(estado), EtiquetaCertificado(estado), tgss?.BloqueaAcceso ?? false,
                    estado == EstadoBlindaje42.NoExonerada ? TonoFila.Peligro : null, empresa));
            }
        }

        foreach (var requisito in _documentacion.Requisitos.Where(r => r.AmbitoAplicacion == ambito))
        {
            // Solo el que fija la cifra de las filas por Empresa: un segundo tipo con el mismo perfil sigue siendo requisito.
            if (tgssPorEmpresa && ReferenceEquals(requisito, tgss))
                continue;
            filas.Add(new FilaDoc(
                requisito.TipoDocumentoId.ToString(), requisito.TipoDocumentoId.ToString(), requisito.Nombre, null, TextoCentros(requisito.Centros),
                requisito.BloqueaAcceso ? TonoBadge.Advertencia : TonoBadge.Neutro,
                Textos[requisito.BloqueaAcceso ? "RequisitoBloqueaAcceso" : "RequisitoSeExige"], requisito.BloqueaAcceso));
        }

        return filas;
    }

    /// <summary>Solo el certificado de la Seguridad Social tiene historial que abrir al pulsar el nombre.</summary>
    private EventCallback NombreDe(FilaDoc fila) =>
        fila.Empresa is { } empresa ? EventCallback.Factory.Create(this, () => AbrirDrawer(empresa)) : default;

    private static RenderFragment? DetalleDe(FilaDoc fila) =>
        fila.Detalle is { } detalle ? builder => builder.AddContent(0, detalle) : null;

    private void AlternarGrupo(AmbitoAplicacion ambito, bool abierto)
    {
        if (abierto)
            _gruposAbiertos.Add(ambito);
        else
            _gruposAbiertos.Remove(ambito);
    }

    /// <summary>Los requisitos se definen por Centro: la lista de Centros del Cliente es donde se ven y se cambian.</summary>
    private void IrACentros() => Navegacion.NavigateTo($"clientes/{_cliente}?pestana=centros");

    private string EtiquetaCertificado(EstadoBlindaje42? estado) => estado switch
    {
        null => Textos["CertificadoSinSolicitar"],
        EstadoBlindaje42.PendienteRespuesta => Textos["CertificadoPendienteTgss"],
        EstadoBlindaje42.ExoneradaPorSilencio => Textos["CertificadoExoneradaSilencio"],
        EstadoBlindaje42.ExoneradaPorCertificacion => Textos["CertificadoExoneradaCertificacion"],
        EstadoBlindaje42.NoExonerada => Textos["CertificadoConDescubiertos"],
        _ => "—"
    };

    private string TextoSolicitudes(int total) => total switch
    {
        0 => Textos["SolicitudesCero"],
        1 => Textos["SolicitudesUna"],
        var n => Textos["SolicitudesVarias", n]
    };

    private string TextoCentros(int centros) =>
        _documentacion.CentrosConGestionCae == 1
            ? Textos["ExigidoEnCentroUnico"]
            : Textos["ExigidoEnCentros", centros, _documentacion.CentrosConGestionCae];

    private void AbrirDrawer(BlindajeEmpresaDto empresa)
    {
        _empresaId = empresa.EmpresaId;
        _empresaNombre = empresa.EmpresaRazonSocial;
        _drawerVisible = true;
    }

    private CancellationToken TokenDeLectura()
    {
        _lectura ??= CancellationTokenSource.CreateLinkedTokenSource(_cancelacion);
        return _lectura.Token;
    }

    private void CancelarLectura()
    {
        _lectura?.Cancel();
        _lectura?.Dispose();
        _lectura = null;
    }

    public void Dispose()
    {
        CancelarLectura();
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
