@page "/reportes"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Reportes.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosReportes> Textos

<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

@*
    Mockup: «Reportes TALVEG.dc.html» (ruta /reportes). Lo que el mockup pinta y
    esta pantalla NO copia, porque ninguna consulta lo sabe o lo hace:
    - Selector «Periodo»: GenerarInformeVigenciaQuery calcula los estados a
      fecha de hoy; no admite mes ni rango.
    - Membrete del Operador CAE («Consultora Vega, S.L.», CIF) y «Página 1 de
      3»: la vista previa no conoce ni la organización que firma ni la
      paginación del PDF.
    - «Generado… por Marta Rodríguez» y «el PDF final es idéntico».
    - «Descargar» en cada fila del historial: HistorialInforme no guarda el
      archivo, solo qué se generó, sobre quién y cuándo.
    - «Programar este informe…»: no existen informes programados.
*@
<div class="contenedor-pagina">
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]" />

    <div class="rejilla-reportes">
        <div class="columna-reportes-filtros">
            <div class="tarjeta-biblioteca">
                <span class="titulo-biblioteca" id="titulo-biblioteca">@Textos["TituloBiblioteca"]</span>
                @* Patrón radiogroup de WAI-ARIA: una sola parada de tabulador (la
                   opción marcada lleva tabindex="0", las demás "-1") y flechas
                   arriba/abajo/izquierda/derecha circulares que MARCAN la opción
                   destino —con la misma invalidación de la vista previa que el
                   clic— y le mueven el foco. El foco se da en OnAfterRenderAsync,
                   cuando la opción ya lleva tabindex="0", sin JS nuevo. *@
                <div class="lista-informes" role="radiogroup" aria-labelledby="titulo-biblioteca">
                    @foreach (var indice in Enumerable.Range(0, Informes.Count))
                    {
                        var informe = Informes[indice];
                        var seleccionado = informe.Id == _tipoInforme;
                        <button type="button" role="radio" class="@("item-informe " + (seleccionado ? "item-informe-seleccionado" : ""))"
                                aria-checked="@(seleccionado ? "true" : "false")" tabindex="@(seleccionado ? "0" : "-1")"
                                @ref="_referenciasInformes[indice]"
                                @onclick="() => SeleccionarInforme(informe.Id)"
                                @onkeydown="e => ManejarTeclaInforme(e, indice)">
                            <span class="radio-informe" aria-hidden="true">
                                @if (seleccionado)
                                {
                                    <span class="punto-radio-informe"></span>
                                }
                            </span>
                            <span class="texto-item-informe">
                                <span class="titulo-item-informe">@TituloInforme(informe.Id)</span>
                                <span class="descripcion-item-informe">@DescripcionInforme(informe.Id)</span>
                            </span>
                        </button>
                    }
                </div>

                <div class="filtros-informe">
                    <div class="campo-cliente-informe">
                        <CampoBuscarSelect Etiqueta="@Textos["EtiquetaClienteEmpresarial"]" Valor="@_clienteId" ValorChanged="CambiarClienteAsync"
                                           Opciones="OpcionesCliente" Marcador="@Textos["MarcadorBuscarClienteEmpresarial"]" />
                        @if (!SinCliente)
                        {
                            <button type="button" class="quitar-filtro-cliente" aria-label="@Textos["AriaQuitarFiltroCliente"]"
                                    @onclick="QuitarFiltroClienteAsync">
                                <Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /> @Textos["BotonQuitarFiltro"]
                            </button>
                        }
                    </div>

                    <div class="campo-centro-informe">
                        <CampoSelect Etiqueta="@Textos["EtiquetaCentrosIncluidos"]" Valor="@_centroId" ValorChanged="CambiarCentro"
                                     Deshabilitado="@(SinCliente || _cargandoCentros)">
                            <option value="">@Textos["OpcionTodosLosCentros"]</option>
                            @foreach (var centro in _centrosDisponibles)
                            {
                                <option value="@centro.Id">@Textos["OpcionSoloCentro", centro.Nombre]</option>
                            }
                        </CampoSelect>
                    </div>

                    @if (EsVigencia)
                    {
                        <label class="opcion-checkbox-informe">
                            <input type="checkbox" @bind="_incluirVigentes" @bind:after="CambiarIncluirVigentes" />
                            <span class="texto-opcion-checkbox-informe">
                                <span>@Textos["OpcionIncluirVigentes"]</span>
                                <span class="detalle-opcion-checkbox-informe">@Textos["OpcionIncluirVigentesDetalle"]</span>
                            </span>
                        </label>
                    }

                    <Boton OnClick="GenerarVistaPreviaAsync" Cargando="_generando">@Textos["BotonGenerarVistaPrevia"]</Boton>

                    <div class="acciones-exportar-informe">
                        @if (TienePlan)
                        {
                            <a class="boton-exportar-informe" href="@EnlaceExportar("pdf")"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["BotonDescargarPdf"]</a>
                            <a class="boton-exportar-informe" href="@EnlaceExportar("xlsx")"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["BotonDescargarExcel"]</a>
                        }
                        else
                        {
                            @* Sin vista previa vigente no hay qué descargar: sin href, no
                               un enlace atenuado solo por CSS que siguiera funcionando
                               con el teclado. *@
                            <span class="boton-exportar-informe boton-exportar-informe-deshabilitado" aria-disabled="true"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["BotonDescargarPdf"]</span>
                            <span class="boton-exportar-informe boton-exportar-informe-deshabilitado" aria-disabled="true"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["BotonDescargarExcel"]</span>
                        }
                    </div>

                    <button type="button" class="enlace-secundario-informe" disabled="@(!TienePlan)" @onclick="AbrirEnviarPorComunicaciones">
                        @Textos["BotonEnviarPorComunicaciones"]
                    </button>
                </div>
            </div>

            <div class="tarjeta-historial-informes">
                <div class="cabecera-historial-informes">@Textos["TituloHistorial"]</div>
                @if (_errorRegistroHistorial)
                {
                    <p class="aviso-historial-informes" role="status">@Textos["AvisoErrorRegistroHistorial"]</p>
                }
                @if (_cargandoHistorial)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorHistorial)
                {
                    <p class="vacio-historial-informes error-historial-informes">
                        @Textos["ErrorCargaHistorial"]
                        <button type="button" class="enlace-secundario-informe" @onclick="CargarHistorialAsync">@Textos["BotonReintentar"]</button>
                    </p>
                }
                else if (_historial.Count == 0)
                {
                    <p class="vacio-historial-informes">@Textos["HistorialVacio"]</p>
                }
                else
                {
                    @foreach (var item in _historial)
                    {
                        <div class="item-historial-informes">
                            <div class="fila-item-historial-informes">
                                <span class="nombre-item-historial-informes">@item.TipoInforme</span>
                                <span class="fecha-item-historial-informes">@(item.GeneradoEnUtc.ToLocalTime().ToString("dd/MM/yy HH:mm"))</span>
                            </div>
                            <span class="detalle-item-historial-informes">@(item.ClienteNombre ?? Textos["HistorialTodaLaCartera"].Value) · @NombreUsuario(item.GeneradoPorUsuarioId)</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="columna-reportes-vista">
            @if (SinCliente && !_generando)
            {
                <div class="aviso-sin-cliente-informe" role="status">
                    <Icono Nombre="advertencia" Tamano="TamanoIcono.Pequeno" />
                    <span>@Textos["AvisoSinClienteEmpresarial"]</span>
                </div>
            }

            @* ProgresoConMensajes y EstadoVacio no anuncian nada por sí mismos
               y tienen otros consumidores, así que los anuncios se ponen aquí:
               la región de estado existe SIEMPRE —vacía mientras no se genera—
               para que el lector de pantalla ya la esté vigilando cuando
               aparezca el progreso; el error, que se inserta, va en alert. *@
            <div class="@("region-progreso-informe" + (_generando ? "" : " region-progreso-informe-vacia"))" role="status" aria-live="polite">
                <ProgresoConMensajes Visible="_generando" Mensajes="MensajesGenerando" />
            </div>

            @* Generar empieza por InvalidarVistaPrevia: mientras _generando, las
               ramas de error, «sin informe» y hoja están todas apagadas. *@
            @if (_errorGeneracion)
            {
                <div class="error-generacion-informe" role="alert">
                    <EstadoVacio NombreIcono="error-circulo" Titulo="@Textos["ErrorGeneracionTitulo"]"
                                 Descripcion="@Textos["ErrorGeneracionDescripcion"]">
                        <Accion><Boton OnClick="GenerarVistaPreviaAsync">@Textos["BotonReintentar"]</Boton></Accion>
                    </EstadoVacio>
                </div>
            }
            else if (_sinInforme)
            {
                <EstadoVacio Titulo="@Textos["SinInformeTitulo"]"
                             Descripcion="@Textos["SinInformeDescripcion"]" />
            }
            else if (TienePlan)
            {
                var generado = _generado!;
                <div class="mesa-vista-previa-informe">
                    <article class="hoja-informe" aria-label="@Textos["AriaVistaPrevia"]">
                        <header class="cabecera-hoja-informe">
                            <h2 class="titulo-hoja-informe">@TituloGenerado@(NombreClienteGenerado is { } cliente ? $" — {cliente}" : "")</h2>
                            <span class="metadato-hoja-informe">@Textos["HojaGeneradoEl", generado.GeneradoEn.ToString("dd/MM/yyyy"), generado.GeneradoEn.ToString("HH:mm")]</span>
                            @if (_informeVigencia is { } cabeceraVigencia)
                            {
                                <span class="metadato-hoja-informe">
                                    @Textos["HojaAbarca", cabeceraVigencia.Alcance] · @(generado.IncluirVigentes ? Textos["HojaIncluyeVigentes"].Value : Textos["HojaSoloVencidosYUrgentes"].Value) · @ContarDocumentos(cabeceraVigencia.Filas.Count)
                                </span>
                            }
                            else if (_informeAsignaciones is { } cabeceraAsignaciones)
                            {
                                <span class="metadato-hoja-informe">
                                    @Textos["HojaAbarca", cabeceraAsignaciones.Alcance] · @ContarAsignacionesActivas(cabeceraAsignaciones.Filas.Count)
                                </span>
                            }
                        </header>

                        @if (_informeVigencia is { } iv)
                        {
                            @if (iv.Filas.Count == 0)
                            {
                                <p class="vacio-hoja-informe">
                                    @(generado.IncluirVigentes ? Textos["HojaVaciaConVigentes"].Value : Textos["HojaVaciaSinVigentes"].Value)
                                </p>
                            }
                            else
                            {
                                <div class="tabla-vista-previa-envoltorio">
                                    <table class="tabla-datos tabla-hoja-informe">
                                        <thead>
                                            <tr><th>@Textos["ColumnaTrabajador"]</th><th>@Textos["ColumnaEmpresa"]</th><th>@Textos["ColumnaDocumento"]</th><th>@Textos["ColumnaVence"]</th><th>@Textos["ColumnaEstado"]</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var fila in iv.Filas)
                                            {
                                                <tr>
                                                    <td class="celda-trabajador-informe">@fila.TrabajadorNombre</td>
                                                    <td>@fila.EmpresaRazonSocial</td>
                                                    <td>@fila.TipoDocumentoNombre</td>
                                                    <td class="celda-vence-informe">
                                                        <TextoFechaCopiable Fecha="fila.FechaVencimiento">@(fila.FechaVencimiento?.ToString("dd/MM/yyyy") ?? Textos["VenceNoCaduca"].Value)</TextoFechaCopiable>
                                                    </td>
                                                    <td><Badge Tono="EstadoDocumentoUi.Tono(fila.Estado)">@EstadoDocumentoUi.Texto(fila.Estado)</Badge></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else if (_informeAsignaciones is { } ia)
                        {
                            @if (ia.Filas.Count == 0)
                            {
                                <p class="vacio-hoja-informe">@Textos["HojaVaciaAsignaciones"]</p>
                            }
                            else
                            {
                                <div class="tabla-vista-previa-envoltorio">
                                    <table class="tabla-datos tabla-hoja-informe">
                                        <thead>
                                            <tr><th>@Textos["ColumnaTrabajador"]</th><th>@Textos["ColumnaCentro"]</th><th>@Textos["ColumnaAsignadoDesde"]</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var fila in ia.Filas)
                                            {
                                                <tr>
                                                    <td class="celda-trabajador-informe">@fila.TrabajadorNombre</td>
                                                    <td>@fila.CentroNombre</td>
                                                    <td>@fila.FechaAlta.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </article>
                    @* Cada descarga vuelve a ejecutar su consulta con los filtros de
                       la vista previa (ReportesEndpoints): no es una instantánea
                       de estas filas, así que no se promete que coincidan. *@
                    <span class="nota-vista-previa-informe">@Textos["NotaVistaPrevia"]</span>
                </div>
            }
            else if (!_generando)
            {
                <EstadoVacio NombreIcono="reportes" Titulo="@Textos["VacioInicialTitulo"]" Descripcion="@Textos["VacioInicialDescripcion"]" />
            }
        </div>
    </div>
</div>

<RedactarMensajeDrawer Visible="_composerVisible" VisibleChanged="v => _composerVisible = v"
                       AsuntoInicial="@TituloGenerado" Adjunto="_adjuntoInforme" />
