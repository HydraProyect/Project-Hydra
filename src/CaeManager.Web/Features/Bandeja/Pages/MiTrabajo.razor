@page "/mi-trabajo"
@* Sin prerender (M-23): OnInitializedAsync carga la cartera entera y no persiste su estado; con prerender corría dos veces. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae}")]
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Bandeja.Recursos
@using CaeManager.Web.Features.IncorporacionCartera.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosMiTrabajo> Textos

<LimiteDeErrores Pagina="this">
@* Mi trabajo Gen2, Nivel 1 multi-Tenant: mockup «Cola operativa multi-Tenant»
   (Mi trabajo.dc.html) sobre CONTRATO-MI-TRABAJO-GEN2-MULTI-TENANT-2026-09-22.
   Toda la cola de cada Tenant está aquí. La pantalla carga con el primer grupo desplegado
   y los demás plegados, como la maqueta (11-06, demo del 10-11; antes cargaba todo plegado,
   decisión del 2026-10-16), sin estado persistido: al desplegar un Tenant se ve lo urgente
   y el resto tras «Ver»; una búsqueda activa anula los pliegues (contrato § 5). Cada acción
   entra en su Tenant por el POST de /cuenta/cliente-activo (AccionCrossTenant).
   El Tenant de origen del Operador CAE no se gestiona desde aquí (§ 10).

   «Añadir a mi cartera» (el «Añadir empresa» del mockup) no incorpora nada: abre
   la solicitud al Coordinador CAE (contrato § 13), y solo aparece si el usuario
   es Gestor CAE y su Operador CAE opera alguna Empresa que aún no tiene.

   Sin construir, porque no hay capacidad detrás: los chips
   DEMO (andamiaje de la vista previa), la selección múltiple («x»,
   «Gestionar selección»), «Aplazar» y el historial del flujo en el detalle.
   Un Tenant propietario cuya cola falla no hace fallar la consulta entera
   (FS-07): el resto se pinta y el aviso «Cartera incompleta» lo nombra. Rótulos de pantalla del contrato de terminología § 3.2 (rótulo del 2026-10-09): el Tenant propietario se
   rotula «Empresa» y el Cliente empresarial «Cliente»; nunca «tenant». *@
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"{Textos["TituloPagina"]} — {Marca.Nombre}")" />

<div class="contenedor-pagina mi-trabajo">
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]">
        <Descripcion>
            @if (_vista is not null)
            {
                <span><strong class="mi-trabajo-titular">@_vista.Titular(Filtro)</strong> · @_vista.Subtitular(Filtro)</span>
            }
        </Descripcion>
        <Acciones>
            @if (_vista is not null && !_errorCarga)
            {
                @* Maqueta: «Ordenar por [Impacto]» arriba a la derecha. El ámbito de cartera (Empresa), «Agrupar por», el filtro y «Expandir todas» no están en la maqueta: se pliegan en «Vista y filtros» (bajo los chips) y no se pierde ninguno. *@
                <label class="mi-trabajo-ordenar">
                    <span class="mi-trabajo-ordenar-etiqueta">@Textos["OrdenarPor"]</span>
                    <select class="mi-trabajo-ordenar-select" aria-label="@Textos["OrdenarPor"]" @onchange="CambiarOrdenDesdeSelect">
                        <option value="@OrdenMiTrabajo.Prioridad" selected="@(_orden == OrdenMiTrabajo.Prioridad)">@Textos["Impacto"]</option>
                        <option value="@OrdenMiTrabajo.Cliente" selected="@(_orden == OrdenMiTrabajo.Cliente)">@Textos["Cliente"]</option>
                    </select>
                </label>
            }
            @if (_puedeAnadirACartera)
            {
                <Boton Variante="VarianteBoton.Secundario" OnClick="AbrirDialogoCartera">@Textos["AnadirAMiCartera"]</Boton>
            }
        </Acciones>
    </CabeceraPagina>

    @if (_puedeAnadirACartera)
    {
        <DialogoSolicitarIncorporacion @bind-Visible="_dialogoCarteraVisible" OnSolicitada="_ => CargarCandidatosCarteraAsync()" />
    }

    @if (_errorCarga)
    {
        @* Maqueta, vista «Error»: caja sin icono con título, detalle y «Reintentar» (no el EstadoVacio compartido, que lleva icono). *@
        <div class="mi-trabajo-error" role="alert">
            <h3>@Textos["ErrorCargaTitulo"]</h3>
            <p>@Textos["ErrorCargaDetalle"]</p>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Textos["ErrorCargaReintentar"]</Boton>
        </div>
    }
    else if (_vista is null)
    {
        <Esqueleto Forma="FormaEsqueleto.Lista" Cantidad="5" />
    }
    else
    {
        @if (ConsultandoCartera)
        {
            <div class="mi-trabajo-progreso" role="status" aria-live="polite">
                <span>@Textos["CargandoEmpresas", _completados, _totalPorCargar]</span>
                <div class="mi-trabajo-progreso-barra" role="progressbar" aria-valuemin="0" aria-valuemax="@_totalPorCargar" aria-valuenow="@_completados">
                    <i style="width: @PorcentajeCargado%"></i>
                </div>
            </div>
        }

        @if (_vista.NoConsultados.Count > 0)
        {
            <div class="alerta-formulario mi-trabajo-cartera-incompleta" role="alert">
                <span>@Textos["CarteraIncompleta", string.Join(", ", _vista.NoConsultados)]</span>
                <Boton Variante="VarianteBoton.Secundario" OnClick="CargarAsync">@Textos["ReintentarConsulta"]</Boton>
            </div>
        }

        var propagaciones = _vista.Propagaciones(Filtro);
        var propagacionesVisibles = _propagacionesTodas ? propagaciones : propagaciones.Take(TopePropagaciones).ToList();
        <section class="propagaciones" aria-label="@Textos["PropagacionesTitulo"]">
            <header class="propagaciones-cabecera">
                <h2>@Textos["PropagacionesTitulo"] · @propagaciones.Count</h2>
                <p>@Textos["PropagacionesDetalle"]</p>
            </header>
            @if (ConsultandoCartera)
            {
                <EstadoCargando Filas="3" />
            }
            else if (propagaciones.Count == 0)
            {
                <p class="propagaciones-vacio">@Textos[_vista.Incompleta(Filtro) ? "PropagacionesIncompletas" : _vista.SinAlcance(Filtro) ? "SinCarteraTitulo" : HayFiltrosActivos ? "PropagacionesSinResultados" : "PropagacionesVacio"]</p>
            }
            @foreach (var fila in propagacionesVisibles)
            {
                <div class="propagaciones-fila">
                    <div class="propagaciones-texto">
                        @* El título es el enlace al documento (maqueta): misma puerta cross-Tenant que «Gestionar», que revalida en cada envío. *@
                        <AccionCrossTenant TenantId="fila.TenantId" Item="fila.Item" Token="_token" UrlRetorno="@UrlMiTrabajo"
                                           UrlDestino="@MiTrabajoVista.UrlDocumento(fila)" ComoEnlace="true"
                                           Texto="@($"{fila.Item.Titulo} · {MiTrabajoVista.Sujeto(fila.Item)}")" Titulo="@Textos["PropagacionesAbrirDocumento"]" />
                        <span>@MiTrabajoVista.DestinoPropagacion(fila)</span>
                        <span>@fila.Item.ProveedorNombre</span>
                    </div>
                    <AccionCrossTenant TenantId="fila.TenantId" Item="fila.Item" Token="_token" UrlRetorno="@UrlMiTrabajo"
                                       Texto="@Textos["PropagacionesGestionar"]" Variante="VarianteBoton.Secundario" />
                </div>
            }
            @* Maqueta: el panel enseña 3 filas. El resto sigue a un clic, en el mismo panel: ninguna fila se pierde. *@
            @if (propagaciones.Count > TopePropagaciones)
            {
                <div class="propagaciones-pie">
                    <button type="button" class="propagaciones-ver-todas" aria-expanded="@(_propagacionesTodas ? "true" : "false")"
                            @onclick="() => _propagacionesTodas = !_propagacionesTodas">
                        @(_propagacionesTodas ? Textos["PropagacionesVerMenos"] : Textos["PropagacionesVerTodas", propagaciones.Count])
                    </button>
                </div>
            }
        </section>

        <div class="mi-trabajo-chips contenido-entra" role="group" aria-label="@Textos["FiltrarPorTipo"]" data-lista-con-filtros>
            @foreach (var chip in Chips)
            {
                <button type="button" class="@("mi-trabajo-chip" + (ChipActivo(chip) ? " mi-trabajo-chip-activo" : "") + (chip.Inerte ? " mi-trabajo-chip-inerte" : ""))"
                        aria-pressed="@(ChipActivo(chip) ? "true" : "false")" disabled="@chip.Inerte"
                        @onclick="() => CambiarTipo(chip.Tipo)">
                    @chip.Etiqueta <span class="mi-trabajo-chip-cuenta">@chip.Cantidad</span>
                </button>
            }
        </div>

        @* Maqueta: «N grupos · M tareas visibles» y, a la derecha, los atajos que de verdad existen en la capa de teclado.
           «Vista y filtros» pliega lo que la maqueta no dibuja pero la pantalla ya tenía: Empresa (ámbito de cartera), Agrupar por, filtro de la cola y Expandir/Plegar todas. *@
        <div class="mi-trabajo-resumen-fila">
            <span class="mi-trabajo-resumen" role="status">@ResumenLista</span>
            <button type="button" class="mi-trabajo-vista-alternar" aria-expanded="@(_vistaAbierta ? "true" : "false")" aria-controls="mi-trabajo-vista"
                    @onclick="AlternarVista">
                @Textos["VistaYFiltros"]
                @if (!_vistaAbierta && VistaActivos > 0)
                {
                    <span class="mi-trabajo-vista-activos" title="@Textos["VistaYFiltrosActivos"]">@VistaActivos</span>
                }
                <span class="@("mi-trabajo-chevron" + (_vistaAbierta ? "" : " mi-trabajo-chevron-plegado"))" aria-hidden="true"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
            </button>
            <span class="mi-trabajo-atajos">@Textos["Atajos"]
                <kbd title="@Textos["AtajoMover"]">j</kbd><kbd title="@Textos["AtajoMover"]">k</kbd><kbd title="@Textos["AtajoAbrir"]">↵</kbd>
            </span>
        </div>

        @if (_vistaAbierta)
        {
            <div id="mi-trabajo-vista" class="mi-trabajo-barra mi-trabajo-vista">
                <div class="mi-trabajo-cartera" role="group" aria-label="@Textos["MiCartera"]" @onkeydown="TeclaCartera">
                    <button type="button" class="mi-trabajo-cartera-resumen" aria-expanded="@(_carteraAbierta ? "true" : "false")" aria-haspopup="true"
                            @onclick="() => _carteraAbierta = !_carteraAbierta">
                        <span class="mi-trabajo-cartera-etiqueta">@Textos["Empresa"]</span>
                        <span class="mi-trabajo-cartera-actual">@(TenantFiltrado?.Nombre ?? Textos["TodaMiCartera"])</span>
                        <span class="@("mi-trabajo-chevron" + (_carteraAbierta ? "" : " mi-trabajo-chevron-plegado"))" aria-hidden="true"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
                    </button>
                    @if (_carteraAbierta)
                    {
                        <div class="mi-trabajo-cartera-fondo" aria-hidden="true" @onclick="() => _carteraAbierta = false"></div>
                    }
                    <div class="mi-trabajo-cartera-lista" hidden="@(!_carteraAbierta)">
                        <div class="mi-trabajo-cartera-cabecera">
                            <h2 class="mi-trabajo-cartera-titulo">@Textos["MiCartera"]</h2>
                            <span class="mi-trabajo-cartera-cuenta">@Empresas(_vista.Cartera.Count)</span>
                        </div>
                        <button type="button" class="@ClaseFilaCartera(null)" aria-pressed="@(_tenantFiltro is null ? "true" : "false")"
                                @onclick="() => CambiarTenant(null)">
                            <span class="mi-trabajo-cartera-avatar mi-trabajo-cartera-avatar-todo" aria-hidden="true">∑</span>
                            <span class="mi-trabajo-cartera-texto">
                                <span class="mi-trabajo-cartera-nombre">@Textos["TodaMiCartera"]</span>
                                <span class="mi-trabajo-cartera-sub">@EmpresasConsultadas(_vista.Cartera.Count)</span>
                            </span>
                            <span class="mi-trabajo-cartera-total">@_vista.TotalCartera</span>
                        </button>
                        @foreach (var tenant in _vista.Cartera)
                        {
                            <button type="button" class="@ClaseFilaCartera(tenant.TenantId)" aria-pressed="@(_tenantFiltro == tenant.TenantId ? "true" : "false")"
                                    @onclick="() => CambiarTenant(_tenantFiltro == tenant.TenantId ? null : tenant.TenantId)">
                                <span class="mi-trabajo-cartera-avatar" aria-hidden="true">@Iniciales(tenant.Nombre)</span>
                                <span class="mi-trabajo-cartera-texto">
                                    <span class="mi-trabajo-cartera-nombre">@tenant.Nombre</span>
                                    <span class="mi-trabajo-cartera-sub">@SubtituloCartera(tenant)</span>
                                </span>
                                <span class="mi-trabajo-cartera-total">@tenant.Total</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="mi-trabajo-barra-grupo" role="group" aria-label="@Textos["AgruparPor"]">
                    <span class="mi-trabajo-barra-etiqueta">@Textos["AgruparPor"]</span>
                    <button type="button" class="@ClasePestana(_agrupar == AgruparMiTrabajo.Tenant)" aria-pressed="@(_agrupar == AgruparMiTrabajo.Tenant ? "true" : "false")"
                            @onclick="() => CambiarAgrupar(AgruparMiTrabajo.Tenant)">@Textos["Empresa"]</button>
                    <button type="button" class="@ClasePestana(_agrupar == AgruparMiTrabajo.Severidad)" aria-pressed="@(_agrupar == AgruparMiTrabajo.Severidad ? "true" : "false")"
                            @onclick="() => CambiarAgrupar(AgruparMiTrabajo.Severidad)">@Textos["Severidad"]</button>
                </div>
                <div class="mi-trabajo-barra-derecha">
                    <input class="mi-trabajo-filtro" type="search" aria-label="@Textos["FiltroEtiqueta"]"
                           placeholder="@Textos["FiltroMarcador"]" value="@_busqueda" @oninput="CambiarBusqueda" />
                    @if (string.IsNullOrWhiteSpace(_busqueda))
                    {
                        <button type="button" class="mi-trabajo-plegar-todas" disabled="@_cargando" @onclick="AlternarTodas">@(TodoPlegado ? Textos["ExpandirTodas"] : Textos["PlegarTodas"])</button>
                    }
                </div>
            </div>
        }
        <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

        @* El detalle solo existe con una tarea abierta: sin ella no reserva
           columna y la cola gana ese ancho. La pista de teclado ya está en la
           barra de la cola («j k mover · ↵ abrir»). *@
        <div class="@("mi-trabajo-paneles contenido-entra" + (FilaAbierta is null ? " mi-trabajo-paneles-sin-detalle" : ""))">
            <section class="mi-trabajo-cola" aria-label="@Textos["ColaDeTrabajo"]">
                @* Maqueta: el estado vacío o cargando va dentro de una tarjeta; con grupos, cada grupo es la suya. *@
                <div class="@(Grupos.Count == 0 ? "mi-trabajo-estado" : null)">
                @if (Grupos.Count == 0 && ConsultandoCartera)
                {
                    @* Con la carga en marcha, una cola vacía solo dice que esa Empresa aún no ha terminado: ni «al día» ni «sin cartera». *@
                    <EstadoCargando Filas="4" />
                }
                else if (Grupos.Count == 0 && AlDia && _vista.SinAlcance(Filtro))
                {
                    @* P2.3: sin alcance no hay nada que vigilar, y «al día» afirmaría un
                       cumplimiento que nadie ha mirado. La Asignación de Cartera la da
                       el Coordinador CAE (al propio Coordinador CAE, enlace a Usuarios); «Añadir a mi cartera» abre esa solicitud. *@
                    <EstadoVacio NombreIcono="cartera"
                                 Titulo="@(TenantFiltrado is { } t ? Textos["SinCarteraEmpresa", t.Nombre] : Textos["SinCarteraTitulo"])"
                                 Descripcion="@(TenantFiltrado is { } t2
                                     ? Textos[_esCoordinadorCae ? "SinCarteraEmpresaDetalleCoordinador" : "SinCarteraEmpresaDetalle", t2.Nombre]
                                     : Textos[_esCoordinadorCae ? "SinCarteraDetalleCoordinador" : "SinCarteraDetalle"])">
                        <Accion>
                            @if (_esCoordinadorCae)
                            {
                                <a class="enlace-ver-todas" data-enlace="usuarios" href="/usuarios">@Textos["EnlaceUsuarios"]</a>
                            }
                            @if (_puedeAnadirACartera)
                            {
                                <Boton Variante="VarianteBoton.Primario" OnClick="AbrirDialogoCartera">@Textos["AnadirAMiCartera"]</Boton>
                            }
                            @if (TenantFiltrado is not null)
                            {
                                <Boton Variante="VarianteBoton.Secundario" OnClick="() => CambiarTenant(null)">@Textos["VerTodaMiCartera"]</Boton>
                            }
                        </Accion>
                    </EstadoVacio>
                }
                else if (Grupos.Count == 0 && AlDia)
                {
                    <EstadoVacio NombreIcono="exito-circulo" AcentoIcono="var(--color-success-500)" FondoIcono="var(--color-success-50)"
                                 Titulo="@(TenantFiltrado is { } t ? Textos["AlDiaEmpresa", t.Nombre] : _vista.Incompleta(Filtro) ? Textos["AlDiaIncompleta"] : Textos["AlDiaCartera"])"
                                 Descripcion="@(TenantFiltrado is { } t2
                                     ? Textos["AlDiaEmpresaDetalle", t2.Nombre]
                                     : _vista.Incompleta(Filtro) ? Textos["AlDiaIncompletaDetalle"] : Textos["AlDiaCarteraDetalle"])">
                        <Accion>
                            @if (TenantFiltrado is not null)
                            {
                                <Boton Variante="VarianteBoton.Secundario" OnClick="() => CambiarTenant(null)">@Textos["VerTodaMiCartera"]</Boton>
                            }
                        </Accion>
                    </EstadoVacio>
                }
                else if (Grupos.Count == 0 && HayFiltrosActivos)
                {
                    <EstadoVacio NombreIcono="filtro" Titulo="@Textos["SinResultadosTitulo"]"
                                 Descripcion="@Textos["SinResultadosDetalle"]">
                        <Accion>
                            <Boton Variante="VarianteBoton.Primario" OnClick="QuitarFiltros">@Textos["QuitarFiltros"]</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else
                {
                    <div class="mi-trabajo-grupos">
                        @{ var clavesGrupos = new ClavesDeHermanos(); }
                        @foreach (var grupo in Grupos)
                        {
                            <div class="@("mi-trabajo-grupo" + (grupo.Peor == SeveridadMiTrabajo.Bloqueo ? " mi-trabajo-grupo-bloqueo" : "") + (grupo.Plegado ? " mi-trabajo-grupo-plegado" : ""))" @key="clavesGrupos.De(grupo.Clave)">
                                <div class="mi-trabajo-grupo-encabezado">
                                @if (grupo.TenantId is { } tenantId)
                                {
                                    <button type="button" class="mi-trabajo-grupo-cabecera mi-trabajo-grupo-cabecera-tenant" aria-expanded="@(grupo.Plegado ? "false" : "true")"
                                            @onclick="() => AlternarTenant(tenantId)">
                                        <span class="@("mi-trabajo-chevron" + (grupo.Plegado ? " mi-trabajo-chevron-plegado" : ""))"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
                                        <span class="mi-trabajo-grupo-nombre">@grupo.Etiqueta</span>
                                        <span class="mi-trabajo-grupo-total">@grupo.Total</span>
                                        @if (grupo.ResumenCabecera is { Length: > 0 } resumenCabecera)
                                        {
                                            <span class="mi-trabajo-grupo-resumen">@resumenCabecera</span>
                                        }
                                        @if (grupo.Peor is { } peorTenant)
                                        {
                                            <Badge Tono="TonoSeveridad(peorTenant)" Tamano="TamanoBadge.Pequeno">@MiTrabajoVista.Etiqueta(peorTenant)</Badge>
                                        }
                                    </button>
                                }
                                else
                                {
                                    @* Modo Severidad: mismo patrón que la cabecera de Tenant, plegada salvo la primera, que se despliega al terminar la carga. *@
                                    <button type="button" class="mi-trabajo-grupo-cabecera mi-trabajo-grupo-cabecera-severidad" aria-expanded="@(grupo.Plegado ? "false" : "true")"
                                            @onclick="() => AlternarSeveridad(grupo.Clave)">
                                        <span class="@("mi-trabajo-chevron" + (grupo.Plegado ? " mi-trabajo-chevron-plegado" : ""))"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
                                        <span class="mi-trabajo-grupo-nombre">@grupo.Etiqueta</span>
                                        <span class="mi-trabajo-grupo-total">@grupo.Total</span>
                                    </button>
                                }
                                    <button type="button" class="mi-trabajo-grupo-gestionar" aria-label="@Textos["GestionarGrupo", grupo.Etiqueta]"
                                            @onclick="() => GestionarGrupo(grupo)">@Textos["Gestionar"]</button>
                                </div>

                                @* Los lotes y sus filas son hermanos bajo este mismo grupo: una sola fuente de claves para todos (numera las
                                   repeticiones: ningún Id repetido mata el circuito). Mezcla Tenants en el modo por severidad y el Id de la fila no
                                   lleva Tenant (ItemBandejaDto no lo tiene): va en la identidad para que la clave de una fila no dependa del orden
                                   en que otro Tenant repita su Id. *@
                                @{ string? clienteAnterior = null; var primera = true; var claves = new ClavesDeHermanos(); }
                                @foreach (var lote in MiTrabajoVista.AgruparPorTrabajador(grupo.Filas))
                                {
                                    var abiertoLote = LoteAbierto(lote);
                                    var cabeza = lote.Filas[0];
                                    var clienteLote = cabeza.Item.ClienteNombre ?? Textos["SinCliente"];
                                    @if (_agrupar == AgruparMiTrabajo.Tenant && _orden == OrdenMiTrabajo.Cliente && (primera || clienteLote != clienteAnterior))
                                    {
                                        <div class="mi-trabajo-subcabecera">@clienteLote</div>
                                    }
                                    clienteAnterior = clienteLote;
                                    primera = false;
                                    @if (lote.Colapsable)
                                    {
                                        <button type="button" @key="claves.De(lote.Clave)" class="mi-trabajo-lote" aria-expanded="@(abiertoLote ? "true" : "false")"
                                                @onclick="() => AlternarLote(lote)">
                                            <span class="@("mi-trabajo-chevron" + (abiertoLote ? "" : " mi-trabajo-chevron-plegado"))"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
                                            <Badge Tono="TonoSeveridad(cabeza.Severidad)" Tamano="TamanoBadge.Pequeno">@TipoItemBandejaUi.Texto(cabeza.Item)</Badge>
                                            <span class="mi-trabajo-lote-titulo">@Textos["LoteGestiones", lote.Filas.Count]</span>
                                            <span class="mi-trabajo-fila-sujeto">· @MiTrabajoVista.Sujeto(cabeza.Item)</span>
                                            @if (!abiertoLote)
                                            {
                                                <span class="mi-trabajo-lote-resumen">@ResumenLote(lote)</span>
                                            }
                                        </button>
                                    }
                                    @if (abiertoLote)
                                    {
                                        @foreach (var fila in lote.Filas)
                                        {
                                            <div @key="claves.De((fila.TenantId, fila.Item.Id))" class="@(ClaseFila(fila) + (lote.Colapsable ? " mi-trabajo-fila-en-lote" : ""))"
                                                 @onclick="() => AbrirDetalle(fila)">
                                                <span class="mi-trabajo-fila-icono" aria-hidden="true"><Icono Nombre="@TipoItemBandejaUi.Icono(fila.Item)" Tamano="TamanoIcono.Pequeno" /></span>
                                                <button type="button" class="mi-trabajo-fila-cuerpo" data-fila-abrir
                                                        aria-label="@($"{fila.Item.Titulo} · {fila.TenantNombre}")">
                                                    <span class="mi-trabajo-fila-linea">
                                                        <span class="mi-trabajo-fila-titulo">@fila.Item.Titulo</span>
                                                        <span class="mi-trabajo-fila-sujeto">· @MiTrabajoVista.Sujeto(fila.Item)</span>
                                                    </span>
                                                    <span class="mi-trabajo-fila-contexto">@ContextoFila(fila)</span>
                                                </button>
                                                <span class="mi-trabajo-fila-derecha" @onclick:stopPropagation="true">
                                                    <Badge Tono="TonoSeveridad(fila.Severidad)" Tamano="TamanoBadge.Pequeno">@MiTrabajoVista.Etiqueta(fila.Severidad)</Badge>
                                                    @if (fila.Item.Fecha is { } fecha)
                                                    {
                                                        <span class="mi-trabajo-fila-fecha">@fecha.ToString(Textos["FormatoDiaMes"], Cultura)</span>
                                                    }
                                                    @if (AccionesBandeja.PuedePedir(fila.Item))
                                                    {
                                                        <AccionCrossTenant TenantId="fila.TenantId" Item="fila.Item" Token="_token" UrlRetorno="@UrlMiTrabajo" Pedir="true"
                                                                           Titulo="@Textos["AccionPedirTitulo", MiTrabajoVista.Sujeto(fila.Item), fila.TenantNombre]" />
                                                    }
                                                    <AccionCrossTenant TenantId="fila.TenantId" Item="fila.Item" Token="_token" UrlRetorno="@UrlMiTrabajo"
                                                                       Titulo="@Textos["AbreEnLaPantalla", fila.TenantNombre]" />
                                                </span>
                                            </div>
                                        }
                                    }
                                }

                                @if (grupo.ResumenCalendario is { } resumen)
                                {
                                    <button type="button" class="mi-trabajo-pliegue" @onclick="() => AbrirPliegue(grupo.Clave)">
                                        <span>@resumen</span>
                                        <span class="mi-trabajo-pliegue-cta">@Textos["Ver"]</span>
                                    </button>
                                }
                            </div>
                        }
                        <div class="mi-trabajo-pie">
                            <span>@Pie</span>
                            @if (_abiertos.Count > 0 || _tenantsAbiertos.Count > 0 || _severidadesAbiertas.Count > 0)
                            {
                                <button type="button" class="mi-trabajo-volver-plegar" @onclick="VolverAPlegar">@Textos["VolverAPlegar"]</button>
                            }
                        </div>
                    </div>
                }
                </div>
            </section>

            @if (FilaAbierta is { } abierta)
            {
                <aside class="mi-trabajo-detalle" aria-label="@Textos["DetalleDeLaTarea"]">
                    <div class="mi-trabajo-detalle-cabecera">
                        <Badge Tono="TonoSeveridad(abierta.Severidad)">@MiTrabajoVista.Etiqueta(abierta.Severidad)</Badge>
                        <span class="mi-trabajo-detalle-tipo">@TipoItemBandejaUi.Texto(abierta.Item)</span>
                        <span class="mi-trabajo-detalle-cerrar">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="CerrarDetalle">@Textos["CerrarDetalle"]</Boton>
                        </span>
                    </div>
                    <div class="mi-trabajo-detalle-titulo">@abierta.Item.Titulo</div>
                    <div class="mi-trabajo-detalle-sujeto">@MiTrabajoVista.Sujeto(abierta.Item)</div>
                    @if (abierta.Item.Fecha is { } fechaDetalle)
                    {
                        <div class="mi-trabajo-detalle-plazo">@fechaDetalle.ToString(Textos["FormatoFechaLarga"], Cultura)</div>
                    }
                    <dl class="mi-trabajo-detalle-datos">
                        <dt>@Textos["Empresa"]</dt>
                        <dd>@abierta.TenantNombre</dd>
                        @* Maqueta Flujos 11, «Detalle de la tarea»: el Centro de la tarea va tras la Empresa. Solo si el ítem lo trae. *@
                        @if (abierta.Item.CentroNombre is { Length: > 0 } centro)
                        {
                            <dt>@Textos["Centro"]</dt>
                            <dd>@centro</dd>
                        }
                        <dt>@Textos["Cliente"]</dt>
                        <dd>@(abierta.Item.ClienteNombre ?? Textos["SinCliente"])</dd>
                        @if (abierta.Item.ProveedorNombre is { Length: > 0 } plataforma)
                        {
                            <dt>@Textos["PlataformaCae"]</dt>
                            <dd>@plataforma</dd>
                        }
                    </dl>
                    @if (AccionesBandeja.PuedePedir(abierta.Item))
                    {
                        <AccionCrossTenant TenantId="abierta.TenantId" Item="abierta.Item" Token="_token" UrlRetorno="@UrlMiTrabajo" Pedir="true"
                                           Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Medio"
                                           Titulo="@Textos["AccionPedirTitulo", MiTrabajoVista.Sujeto(abierta.Item), abierta.TenantNombre]" />
                    }
                    <AccionCrossTenant TenantId="abierta.TenantId" Item="abierta.Item" Token="_token" UrlRetorno="@UrlMiTrabajo"
                                       Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Medio"
                                       Titulo="@Textos["AbreEnLaPantalla", abierta.TenantNombre]" />
                </aside>
            }
        </div>
    }
</div>
</LimiteDeErrores>
