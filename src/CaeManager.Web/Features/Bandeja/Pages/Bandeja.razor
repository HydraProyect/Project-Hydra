@page "/bandeja"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae}")]
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaAgrupada
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaGestor
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Bandeja.Components
@using MediatR
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService

@* "Mi trabajo" en vez de "Bandeja" — ver el comentario de NavMenu.razor
   (H3, decisión provisional 2026-08-13). La ruta sigue siendo /bandeja.

   Rediseño (mockup "Mi trabajo TALVEG"): agrupada "por situación" — misma
   ObtenerBandejaAgrupadaQuery + GrupoCola que ya usa Inicio ("/"), en vez
   de la pared plana de PanelResolverItem de antes (hallazgo P-03). Filtro
   por chips y orden Impacto/Fecha límite son traducción directa del mockup.

   Estado medido del resto del mockup (2026-09-03, sobre #413 — no de
   memoria, ver DEC-22): "Reclamar en lote" (SelectorLoteDocumental +
   DrawerReclamacionLote) y la paginación por grupo (GrupoCola.
   PaginarPorGrupo) ya están construidas. La acción "Reclamar" junto a la de
   navegación por ítem también existe, pero solo para los ítems reclamables
   (Faltante/Vencido/Urgente de un Trabajador con TipoDocumentoId —
   TipoItemBandejaUi.EsReclamable); el resto de tipos sigue con una sola
   acción (AccionesBandeja). Sin construir todavía: el toast de "Deshacer"
   al reclamar (ToastService ya soporta una acción de este tipo —
   Empresas/Trabajadores/Clientes/Documentos la usan al eliminar — pero
   ningún flujo de Bandeja la dispara). "Posponer" se descartó como
   capacidad aprobada el 2026-09-02 (DEC-22): no es trabajo pendiente, la
   idea queda en el registro histórico. La selección múltiple con barra
   flotante "Reclamar todo" del mockup está marcada MEJORA ahí mismo y
   tampoco está construida: hoy el lote se arma en el Drawer, no marcando
   grupos.

   Las teclas "e" (plegar), "r" (resolver) y "p" (posponer) del mockup NO
   están: son propuesta de esa pantalla, no del CatalogoAtajos, y
   atajos-lista.js solo reparte j/k/x/Enter a TODAS las listas — añadirlas
   ahí sería cambiarlas en todas, no solo aquí. La leyenda de abajo solo
   promete las que el código sirve de verdad. *@
<PageTitle>Mi trabajo — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <CabeceraPagina Titulo="Mi trabajo" Kicker="Control">
        <Acciones>
            <div class="bandeja-orden">
                <label class="bandeja-orden-etiqueta" for="bandeja-orden">Ordenar por</label>
                <select id="bandeja-orden" class="bandeja-orden-select" value="@_orden" @onchange="CambiarOrdenAsync">
                    <option value="@nameof(OrdenBandeja.Impacto)">Impacto</option>
                    <option value="@nameof(OrdenBandeja.Fecha)">Fecha límite</option>
                </select>
            </div>
            <Boton Variante="VarianteBoton.Secundario" OnClick="AbrirReclamacionLoteAsync">Reclamar en lote</Boton>
        </Acciones>
    </CabeceraPagina>

    <div class="bandeja-chips" role="group" aria-label="Filtrar por tipo">
        @foreach (var chip in Chips)
        {
            <button type="button" class="@("bandeja-chip" + (chip.Tipo == _tipoFiltro ? " bandeja-chip-activo" : ""))"
                    aria-pressed="@(chip.Tipo == _tipoFiltro ? "true" : "false")"
                    @onclick="() => CambiarFiltroAsync(chip.Tipo)">
                @chip.Etiqueta <span class="bandeja-chip-cuenta" title="@chip.Titulo">@chip.Cantidad</span>
            </button>
        }
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar la bandeja" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="6" />
    }
    else if (ItemsFiltrados.Count == 0 && HayFiltrosActivos)
    {
        <EstadoVacio NombreIcono="filtro" Titulo="Nada con este filtro"
                     Descripcion="Prueba con otro tipo o vuelve a «Todos» para ver la cola entera.">
            <Accion>
                <Boton OnClick="QuitarFiltrosAsync">Quitar el filtro</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (ItemsFiltrados.Count == 0)
    {
        <EstadoVacio NombreIcono="exito-circulo" AcentoIcono="var(--color-success-500)" FondoIcono="var(--color-success-50)"
                     Titulo="La cola está vacía"
                     Descripcion="No queda nada pendiente en tu cartera: ni documentos vencidos, urgentes o faltantes, ni revisiones de IA, ni requisitos que bloqueen un Centro." />
    }
    else
    {
        <div class="bandeja-resumen">
            <span class="bandeja-resumen-cuenta">@ResumenVisible</span>
            <span class="bandeja-atajos">
                Atajos: <kbd>j</kbd> / <kbd>k</kbd> mover · <kbd>Enter</kbd> abrir
            </span>
        </div>

        <div class="lista-bandeja">
            @foreach (var grupo in GruposOrdenados)
            {
                <GrupoCola @key="grupo.GrupoId" Grupo="grupo" ExpandidaPorDefecto="true" AgruparPorEmpresa="_agruparPorEmpresa" IdEnfocado="@_idEnfocado" OnReclamar="AbrirReclamacionDeItemAsync" PaginarPorGrupo="true" MarcarBloqueo="true" />
            }
            @foreach (var item in _bandeja!.SinGrupo.Where(i => CoincideFiltro(i, _tipoFiltro)))
            {
                <PanelResolverItem @key="item.Id" Item="item" Enfocado="@(item.Id == _idEnfocado)" OnReclamar="AbrirReclamacionDeItemAsync" />
            }
        </div>
    }
</div>

@* Ambitos disponibles hoy: solo Trabajador tiene camino de reclamación
   completo (agenda + comando de envío) — ver ObtenerLoteReclamacionPorFiltroQuery.
   Ampliar esta lista cuando Empresa quede construido, no antes: ofrecerlo ya
   fallaría al enviar. *@
<DrawerReclamacionLote Visible="_reclamacionLoteVisible" VisibleChanged="v => _reclamacionLoteVisible = v"
                       AmbitosDisponibles="@(new[] { AmbitoAplicacion.Trabajador, AmbitoAplicacion.Empresa })"
                       AmbitoInicial="_ambitoPreseed" EntidadIdInicial="_entidadIdPreseed"
                       OnReclamacionEnviada="CargarAsync" />
