@*
    Acción de una fila de Mi trabajo Gen2 (multi-Tenant): el mismo POST con
    antiforgery a /cuenta/cliente-activo que el selector de Tenant de la cabecera y
    VisionCartera, con returnUrl = la pantalla exacta del ítem
    (AccionesBandeja.ResolverUrl; contrato Gen2 § 8). El endpoint revalida la
    autorización sobre ese Tenant en cada envío. Si recibe UrlRetorno (Mi trabajo con sus filtros),
    el destino lleva ?volver=… y el layout ofrece la vuelta (RetornoMiTrabajo).

    Se usa también para el Tenant que ya esté activo: un único camino para
    todas las filas evita que el comportamiento dependa de cuál sea el activo.
    RequisitoPendiente no tiene URL propia y aterriza en /bandeja del Tenant.

    Con Pedir, la misma puerta aterriza en /bandeja?pedir={Trabajador}: abre «Reclamar en lote» ya preseleccionado con lo que
    falta (el flujo de reclamación que ya existe; el Gestor CAE revisa y envía). Es una segunda acción de la fila, no sustituye a
    la primaria; lleva su propio marcador (data-accion-pedir) para no contarse como la acción primaria.
*@
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaGestor
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Components.Layout
@using CaeManager.Web.Features.Bandeja.Recursos
@using Microsoft.AspNetCore.Components.Forms

<form method="post" action="/cuenta/cliente-activo" class="accion-cross-tenant" data-accion-cross-tenant="@(Pedir ? null : "")" data-accion-pedir="@(Pedir ? "" : null)">
    @if (Token is not null)
    {
        <input type="hidden" name="@Token.FormFieldName" value="@Token.Value" />
    }
    <input type="hidden" name="tenantId" value="@TenantId" />
    <input type="hidden" name="returnUrl" value="@Destino" />
    <Boton Type="submit" Variante="Variante" Tamano="Tamano" title="@Titulo">
        @(Pedir ? TextosMiTrabajo.Texto("AccionPedir") : TipoItemBandejaUi.TextoAccion(Item))
    </Boton>
</form>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter, EditorRequired] public ItemBandejaDto Item { get; set; } = default!;
    [Parameter] public AntiforgeryRequestToken? Token { get; set; }
    [Parameter] public string? Titulo { get; set; }

    /// <summary>La URL de Mi trabajo con sus filtros, para que el destino ofrezca la vuelta (RetornoMiTrabajo).</summary>
    [Parameter] public string? UrlRetorno { get; set; }

    /// <summary>«Pedir» lo que falta de este Trabajador en vez de la acción primaria del ítem (solo si <see cref="AccionesBandeja.PuedePedir"/>).</summary>
    [Parameter] public bool Pedir { get; set; }

    private string Destino => RetornoMiTrabajo.ComponerDestino(
        Pedir ? AccionesBandeja.UrlPedir(Item) : AccionesBandeja.ResolverUrl(Item) ?? "/bandeja", UrlRetorno);
    [Parameter] public VarianteBoton Variante { get; set; } = VarianteBoton.Fantasma;
    [Parameter] public TamanoBoton Tamano { get; set; } = TamanoBoton.Pequeno;
}
