@*
    Una tarjeta = un ítem de la Bandeja del gestor, con una única acción
    primaria (Fase C) — nunca una fila de tabla con varias acciones
    compitiendo por la atención. Reutilizado tal cual en /bandeja y en el
    panel montado en /alertas.
*@
@using CaeManager.Application.Bandeja.Queries.ObtenerBandejaGestor
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject CaeManager.Web.Components.Workspace.ContextWorkspaceService WorkspaceService

<div class="panel-resolver-item @(Enfocado ? "panel-resolver-item-enfocado" : "")">
    <div class="panel-resolver-item-info">
        <Badge Tono="TipoItemBandejaUi.Tono(Item)">@TipoItemBandejaUi.Texto(Item)</Badge>
        <div>
            <p class="panel-resolver-item-titulo">@Item.Titulo</p>
            <p class="panel-resolver-item-subtitulo">@Item.Subtitulo</p>
        </div>
    </div>
    <div class="panel-resolver-item-fecha">
        @* Solo copiable donde Fecha es vigencia o cae en la excepción de P9 (Revisión
           IA) — ver TipoItemBandejaUi.EsFechaCopiable. VisitaUrgente y
           SugerenciaVisitaUrgente llevan FechaInicio/FechaInicioSugerida, ninguna de
           las dos cosas: texto plano. *@
        @if (TipoItemBandejaUi.EsFechaCopiable(Item))
        {
            <TextoFechaCopiable Fecha="Item.Fecha">@(Item.Fecha?.ToString("dd/MM/yyyy") ?? "—")</TextoFechaCopiable>
        }
        else
        {
            <span>@(Item.Fecha?.ToString("dd/MM/yyyy") ?? "—")</span>
        }
    </div>
    @if (TipoItemBandejaUi.EsReclamable(Item) && OnReclamar.HasDelegate)
    {
        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => OnReclamar.InvokeAsync(Item)">
            Reclamar
        </Boton>
    }
    @if (AccionPersonalizada is not null)
    {
        @AccionPersonalizada(Item)
    }
    else
    {
        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirAsync">
            @TipoItemBandejaUi.TextoAccion(Item)
        </Boton>
    }
</div>

@code {
    [Parameter, EditorRequired] public ItemBandejaDto Item { get; set; } = default!;
    [Parameter] public bool Enfocado { get; set; }

    /// <summary>U-2: puerta terminal de reclamación uniforme — el llamador decide qué hacer al pulsar (abrir el Drawer de lote preseed a este ítem). Sin binding, no se ofrece el botón.</summary>
    [Parameter] public EventCallback<ItemBandejaDto> OnReclamar { get; set; }

    /// <summary>
    /// Sustituye el botón "Abrir" por defecto (que navega dentro del MISMO
    /// circuito, en el Tenant hoy activo) — Mi trabajo Gen2 (multi-Tenant) lo
    /// usa para que la fila de un Tenant que no es el activo pase por el POST
    /// cross-Tenant de <c>AccionCrossTenant</c> en vez de navegar dentro del
    /// Tenant equivocado. Sin binding, comportamiento sin cambios (/bandeja,
    /// panel de /alertas).
    /// </summary>
    [Parameter] public RenderFragment<ItemBandejaDto>? AccionPersonalizada { get; set; }

    private Task AbrirAsync() => AccionesBandeja.AbrirAsync(Item, NavigationManager, WorkspaceService);
}
