    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _idCargado = EntidadId;
            _documentacion = null;
            _errorDocumentacion = false;
            _trabajadores = null;
            _errorTrabajadores = false;
            _vehiculos = null;
            _errorVehiculos = false;
            _plataformaCargada = false;
            _errorPlataforma = false;
            _estadoCentro = null;
            _editandoInformacion = false;
            await CargarCabeceraAsync();
            await CargarEstadoAsync();
        }

        if (PestanaActiva == "requisitos" && _documentacion is null && !_errorDocumentacion && !_cargandoDocumentacion)
            await CargarDocumentacionAsync();

        if (PestanaActiva == "trabajadores" && _trabajadores is null && !_errorTrabajadores && !_cargandoTrabajadores)
            await CargarTrabajadoresAsync();

        if (PestanaActiva == "vehiculos" && _vehiculos is null && !_errorVehiculos && !_cargandoVehiculos)
            await CargarVehiculosAsync();

        if (PestanaActiva == "plataforma" && !_plataformaCargada && !_errorPlataforma && !_cargandoPlataforma)
            await CargarPlataformaAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            _detalle = await Mediator.Send(new ObtenerCentroPorIdQuery(EntidadId));

            // Rastro de la última reclamación al Cliente de este Centro: es el
            // puente hacia Comunicaciones desde la superficie de operación. Su
            // fallo no puede tumbar el panel — es contexto, no el Centro.
            _ultimaReclamacion = _detalle is null
                ? null
                : await Mediator.Send(new ObtenerUltimaReclamacionClienteQuery(_detalle.ClienteId));

            // Qué hay pendiente de reclamar en ESTE centro — a diferencia de
            // _ultimaReclamacion (histórico), esto decide si el botón "Reclamar
            // documentación" se pinta. Mismo criterio de "no tumbar el panel":
            // si falla, simplemente no aparece el botón.
            var lotes = await Mediator.Send(new ObtenerLoteReclamacionQuery(CentroId: EntidadId));
            _loteReclamacionCentro = lotes.FirstOrDefault();
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void IniciarEdicionInformacion()
    {
        if (_detalle is null) return;

        _nombreInfo = _detalle.Nombre;
        _codigoCentroInfo = _detalle.CodigoCentro ?? string.Empty;
        _direccionInfo = _detalle.Direccion ?? string.Empty;
        _contactoInfo = _detalle.Contacto ?? string.Empty;
        _contratoVigenteHastaInfo = _detalle.ContratoVigenteHasta?.ToString("yyyy-MM-dd") ?? string.Empty;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();
        _editandoInformacion = true;
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private string? ObtenerErrorInformacion(string campo) => _erroresInformacion.GetValueOrDefault(campo);

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null) return;

        _guardandoInformacion = true;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();

        try
        {
            var codigoCentro = string.IsNullOrWhiteSpace(_codigoCentroInfo) ? null : _codigoCentroInfo;
            var direccion = string.IsNullOrWhiteSpace(_direccionInfo) ? null : _direccionInfo;
            var contacto = string.IsNullOrWhiteSpace(_contactoInfo) ? null : _contactoInfo;
            var contratoVigenteHasta = DateOnly.TryParse(_contratoVigenteHastaInfo, out var fecha) ? fecha : (DateOnly?)null;

            var resultado = await Mediator.Send(new EditarCentroCommand(
                _detalle.Id, _nombreInfo, codigoCentro, direccion, contacto, contratoVigenteHasta, _detalle.Version));

            if (resultado.EsFallido)
            {
                _mensajeErrorInformacion = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar("Centro actualizado correctamente.", TonoToast.Exito);
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            _erroresInformacion = ex.Errors
                .GroupBy(e => e.PropertyName)
                .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
        }
        catch (Exception)
        {
            _mensajeErrorInformacion = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            _guardandoInformacion = false;
        }
    }

    private async Task CargarEstadoAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoEstado = true;

        try
        {
            var resultado = await Mediator.Send(new ObtenerEstadoCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _estadoCentro = resultado;
        }
        catch (Exception)
        {
            // El badge de cumplimiento es informativo — si falla, simplemente no se muestra.
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoEstado = false;
        }
    }

    private async Task CargarDocumentacionAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoDocumentacion = true;
        _errorDocumentacion = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerDocumentacionRequeridaDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _documentacion = resultado ?? [];
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorDocumentacion = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoDocumentacion = false;
        }
    }

    private Task AbrirConfigurarAsync(DocumentacionRequeridaCentroDto item)
    {
        _tipoDocumentoIdEditando = item.TipoDocumentoId;
        _nombreTipoDocumentoEditando = item.Nombre;
        _incluidoEdicion = item.Aplica;
        _periodicidadSeleccionEdicion = item.PeriodicidadEspecialMeses switch
        {
            null => string.Empty,
            { } meses when PeriodicidadesPredefinidas.Contains(meses) => meses.ToString(),
            { } meses => "personalizado"
        };
        _periodicidadPersonalizadaEdicion = item.PeriodicidadEspecialMeses is { } m && !PeriodicidadesPredefinidas.Contains(m)
            ? m.ToString() : string.Empty;
        _bloqueaAccesoEdicion = item.BloqueaAcceso;
        _archivoUrlEdicion = item.ArchivoUrl;
        _nombreArchivoEdicion = item.NombreArchivoOriginal;
        _mensajeErrorDocumentacion = null;
        _drawerDocVisible = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Acepta PDF o Word (.docx) y lo guarda tal cual — a diferencia de
    /// Documentos.razor.cs, aquí NO se convierte el Word a PDF: el adjunto es
    /// el propio formulario que el destinatario tiene que poder editar en
    /// Word, así que forzarlo a PDF le quitaría justo eso.
    /// </summary>
    private async Task ManejarArchivoDocumentacionSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;

        if (!ConversorArchivosPdf.EsPdf(archivo.Name) && !ConversorArchivosPdf.EsWord(archivo.Name))
        {
            ToastService.Mostrar($"\"{archivo.Name}\" no es un PDF ni un Word (.docx).", TonoToast.Error);
            return;
        }

        if (archivo.Size > TamanoMaximoArchivoDocumentacionBytes)
        {
            ToastService.Mostrar($"\"{archivo.Name}\" supera los 10 MB.", TonoToast.Error);
            return;
        }

        _subiendoArchivoEdicion = true;
        StateHasChanged();

        try
        {
            byte[] contenido;
            await using (var flujo = archivo.OpenReadStream(TamanoMaximoArchivoDocumentacionBytes))
            using (var memoria = new MemoryStream())
            {
                await flujo.CopyToAsync(memoria);
                contenido = memoria.ToArray();
            }

            if (!ValidadorFirmaArchivo.TieneFirmaValida(contenido, archivo.Name))
            {
                ToastService.Mostrar(
                    $"\"{archivo.Name}\" no es realmente un PDF ni un Word (.docx) — su contenido no coincide con la extensión.",
                    TonoToast.Error);
                return;
            }

            using var flujoOriginal = new MemoryStream(contenido);
            _archivoUrlEdicion = await AlmacenamientoArchivos.GuardarAsync(flujoOriginal, archivo.Name);
            _nombreArchivoEdicion = archivo.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fallo al procesar el archivo subido en Requisitos del Centro");
            ToastService.Mostrar("No pudimos procesar el archivo. Intenta nuevamente.", TonoToast.Error);
        }
        finally
        {
            _subiendoArchivoEdicion = false;
        }
    }

    private void QuitarArchivoDocumentacionEdicion()
    {
        _archivoUrlEdicion = null;
        _nombreArchivoEdicion = null;
    }

    private async Task GuardarDocumentacionAsync()
    {
        _guardandoDocumentacion = true;
        _mensajeErrorDocumentacion = null;

        try
        {
            int? periodicidadMeses = _periodicidadSeleccionEdicion switch
            {
                "" => null,
                "personalizado" => int.TryParse(_periodicidadPersonalizadaEdicion, out var personalizado) ? personalizado : null,
                var seleccion => int.Parse(seleccion)
            };

            if (_periodicidadSeleccionEdicion == "personalizado" && periodicidadMeses is null)
            {
                _mensajeErrorDocumentacion = "Indica un número entero de meses, o deja el campo vacío si no vence.";
                return;
            }

            var resultado = await Mediator.Send(new EstablecerDocumentacionRequeridaCentroCommand(
                EntidadId, _tipoDocumentoIdEditando, _incluidoEdicion, periodicidadMeses, _bloqueaAccesoEdicion,
                _archivoUrlEdicion, _nombreArchivoEdicion));

            if (resultado.EsFallido)
            {
                _mensajeErrorDocumentacion = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar("Documentación del centro actualizada.", TonoToast.Exito);

            _drawerDocVisible = false;
            await CargarDocumentacionAsync();
            await CargarEstadoAsync();
        }
        catch (ValidationException ex)
        {
            _mensajeErrorDocumentacion = ex.Errors.FirstOrDefault()?.ErrorMessage
                ?? "No pudimos guardar los cambios. Revisa los datos introducidos.";
        }
        catch (Exception)
        {
            _mensajeErrorDocumentacion = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            _guardandoDocumentacion = false;
        }
    }

    private async Task QuitarAjusteAsync(DocumentacionRequeridaCentroDto item)
    {
        var resultado = await Mediator.Send(new EliminarDocumentacionRequeridaCentroCommand(EntidadId, item.TipoDocumentoId));
        if (resultado.EsFallido)
        {
            ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
            return;
        }

        ToastService.Mostrar($"\"{item.Nombre}\" vuelve a seguir el criterio global del tenant.", TonoToast.Exito);
        await CargarDocumentacionAsync();
        await CargarEstadoAsync();
    }

    private async Task CargarTrabajadoresAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoTrabajadores = true;
        _errorTrabajadores = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerTrabajadoresAsignadosDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _trabajadores = resultado;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorTrabajadores = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoTrabajadores = false;
        }
    }

    private async Task CargarVehiculosAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoVehiculos = true;
        _errorVehiculos = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerVehiculosConActividadDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _vehiculos = resultado;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorVehiculos = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoVehiculos = false;
        }
    }

    private async Task CargarPlataformaAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoPlataforma = true;
        _errorPlataforma = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerCanalesGestionDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
            {
                _canales = resultado;
                _plataformaCargada = true;
            }

            if (!_catalogoProveedorCargado)
            {
                var proveedores = await Mediator.Send(new ObtenerProveedoresPlataformaCaeQuery());
                _catalogoProveedorOpciones = proveedores.Select(p => new OpcionBuscable(p.Id.ToString(), p.Nombre)).ToList();
                _catalogoProveedorCargado = true;
            }
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorPlataforma = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoPlataforma = false;
        }
    }

    /// <summary>
    /// Resuelve la plataforma a partir de la URL (Lote 2-B, PLAN-EJECUCION-UX.md
    /// § Parte 2 (a)) — 1 candidato se auto-selecciona, 0 o varios muestran el
    /// selector manual (candidatos si hay multi-match como Sabentis/Quirón, el
    /// catálogo completo si no hay ninguno).
    /// </summary>
    private async Task ResolverProveedorPorUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_urlAccesoEdicion))
        {
            _mensajeResolucionProveedor = null;
            return;
        }

        _resolviendoProveedor = true;
        try
        {
            var candidatos = await ResolucionProveedor.ResolverPorUrlAsync(_urlAccesoEdicion);

            if (candidatos.Count == 1)
            {
                _proveedorPlataformaCaeIdEdicion = candidatos[0].Id.ToString();
                _proveedorNombreDetectadoEdicion = candidatos[0].Nombre;
                _mostrarSelectorManualProveedor = false;
                _mensajeResolucionProveedor = null;
            }
            else if (candidatos.Count > 1)
            {
                _proveedorPlataformaCaeIdEdicion = string.Empty;
                _mostrarSelectorManualProveedor = true;
                _opcionesSelectorProveedor = candidatos.Select(c => new OpcionBuscable(c.Id.ToString(), c.Nombre)).ToList();
                _mensajeResolucionProveedor = "Esta URL coincide con varias plataformas — elige la correcta.";
            }
            else
            {
                _proveedorPlataformaCaeIdEdicion = string.Empty;
                _mostrarSelectorManualProveedor = true;
                _opcionesSelectorProveedor = _catalogoProveedorOpciones;
                _mensajeResolucionProveedor = "No identificamos automáticamente esta plataforma — elígela de la lista.";
            }
        }
        finally
        {
            _resolviendoProveedor = false;
        }
    }

    private void AbrirNuevoCanal()
    {
        _canalIdEditando = null;
        _versionCanalEditando = default;
        _etiquetaPropositoEdicion = string.Empty;
        _tipoCanalEdicion = nameof(TipoCanalGestion.Plataforma);
        _urlAccesoEdicion = string.Empty;
        _proveedorPlataformaCaeIdEdicion = string.Empty;
        _proveedorNombreDetectadoEdicion = null;
        _mostrarSelectorManualProveedor = false;
        _mensajeResolucionProveedor = null;
        _opcionesSelectorProveedor = _catalogoProveedorOpciones;
        _cambiarCredencialesEdicion = false;
        _usuarioEdicion = string.Empty;
        _contrasenaEdicion = string.Empty;
        _emailsDestinatariosEdicion = string.Empty;
        _nombreContactoEdicion = string.Empty;
        _notasCanalEdicion = string.Empty;
        _mensajeErrorCanal = null;
        _drawerCanalVisible = true;
    }

    private async Task AbrirEditarCanal(CanalGestionResumenDto canal)
    {
        _canalIdEditando = canal.Id;
        _versionCanalEditando = canal.Version;
        _etiquetaPropositoEdicion = canal.EtiquetaProposito;
        _tipoCanalEdicion = canal.Tipo.ToString();
        _urlAccesoEdicion = canal.UrlAcceso ?? string.Empty;
        _cambiarCredencialesEdicion = false;
        _usuarioEdicion = string.Empty;
        _contrasenaEdicion = string.Empty;
        _emailsDestinatariosEdicion = canal.EmailsDestinatarios ?? string.Empty;
        _nombreContactoEdicion = canal.NombreContacto ?? string.Empty;
        _notasCanalEdicion = canal.Notas ?? string.Empty;
        _mensajeErrorCanal = null;

        if (canal.ProveedorPlataformaCaeId is { } proveedorId)
        {
            _proveedorPlataformaCaeIdEdicion = proveedorId.ToString();
            _proveedorNombreDetectadoEdicion = canal.ProveedorPlataformaCaeNombre;
            _mostrarSelectorManualProveedor = false;
            _mensajeResolucionProveedor = null;
        }
        else if (canal.Tipo == TipoCanalGestion.Plataforma)
        {
            // Canal migrado desde el antiguo NombrePlataforma de texto libre
            // sin match automático (Lote 2-B) — se reintenta la resolución con
            // la URL ya guardada antes de pedir selección manual.
            _proveedorPlataformaCaeIdEdicion = string.Empty;
            _mostrarSelectorManualProveedor = true;
            _opcionesSelectorProveedor = _catalogoProveedorOpciones;
            _mensajeResolucionProveedor = "Este acceso no tiene una plataforma resuelta — elígela de la lista.";
        }

        _drawerCanalVisible = true;

        if (canal.Tipo == TipoCanalGestion.Plataforma && canal.ProveedorPlataformaCaeId is null)
            await ResolverProveedorPorUrlAsync();
    }

    private async Task GuardarCanalAsync()
    {
        _guardandoCanal = true;
        _mensajeErrorCanal = null;

        try
        {
            var notas = string.IsNullOrWhiteSpace(_notasCanalEdicion) ? null : _notasCanalEdicion;
            Guid? proveedorPlataformaCaeId = Guid.TryParse(_proveedorPlataformaCaeIdEdicion, out var proveedorId) ? proveedorId : null;

            Result resultado;

            if (_canalIdEditando is { } id)
            {
                resultado = await Mediator.Send(new EditarCanalGestionCommand(
                    id, _etiquetaPropositoEdicion,
                    proveedorPlataformaCaeId,
                    string.IsNullOrWhiteSpace(_urlAccesoEdicion) ? null : _urlAccesoEdicion,
                    string.IsNullOrWhiteSpace(_emailsDestinatariosEdicion) ? null : _emailsDestinatariosEdicion,
                    string.IsNullOrWhiteSpace(_nombreContactoEdicion) ? null : _nombreContactoEdicion,
                    notas, _cambiarCredencialesEdicion,
                    string.IsNullOrWhiteSpace(_usuarioEdicion) ? null : _usuarioEdicion,
                    string.IsNullOrWhiteSpace(_contrasenaEdicion) ? null : _contrasenaEdicion,
                    _versionCanalEditando));
            }
            else
            {
                var tipo = _tipoCanalEdicion == nameof(TipoCanalGestion.Email)
                    ? TipoCanalGestion.Email
                    : TipoCanalGestion.Plataforma;

                resultado = await Mediator.Send(new CrearCanalGestionCommand(
                    EntidadId, tipo, _etiquetaPropositoEdicion,
                    proveedorPlataformaCaeId,
                    string.IsNullOrWhiteSpace(_urlAccesoEdicion) ? null : _urlAccesoEdicion,
                    string.IsNullOrWhiteSpace(_usuarioEdicion) ? null : _usuarioEdicion,
                    string.IsNullOrWhiteSpace(_contrasenaEdicion) ? null : _contrasenaEdicion,
                    string.IsNullOrWhiteSpace(_emailsDestinatariosEdicion) ? null : _emailsDestinatariosEdicion,
                    string.IsNullOrWhiteSpace(_nombreContactoEdicion) ? null : _nombreContactoEdicion,
                    notas));
            }

            if (resultado.EsFallido)
            {
                _mensajeErrorCanal = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar("Acceso de gestión documental guardado.", TonoToast.Exito);

            _drawerCanalVisible = false;
            await CargarPlataformaAsync();
        }
        catch (ValidationException ex)
        {
            _mensajeErrorCanal = ex.Errors.FirstOrDefault()?.ErrorMessage
                ?? "No pudimos guardar el acceso. Revisa los datos introducidos.";
        }
        catch (Exception)
        {
            _mensajeErrorCanal = "No pudimos guardar el acceso. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            _guardandoCanal = false;
        }
    }

    private async Task MarcarCanalPrincipalAsync(CanalGestionResumenDto canal)
    {
        try
        {
            var resultado = await Mediator.Send(new MarcarCanalGestionPrincipalCommand(canal.Id));

            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"«{canal.EtiquetaProposito}» es ahora el acceso principal.", TonoToast.Exito);
            await CargarPlataformaAsync();
        }
        catch (Exception)
        {
            ToastService.Mostrar("No pudimos cambiar el acceso principal. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
    }

    private void PedirConfirmacionEliminarCanal(CanalGestionResumenDto canal)
    {
        _canalAEliminar = canal;
        _confirmarEliminarCanalVisible = true;
    }

    private async Task ConfirmarEliminarCanalAsync()
    {
        if (_canalAEliminar is not { } canal)
            return;

        _eliminandoCanal = true;

        try
        {
            var usuarioId = await CurrentUserService.ObtenerUsuarioActualIdAsync();
            var resultado = await Mediator.Send(new EliminarCanalGestionCommand(canal.Id, usuarioId ?? Guid.Empty));

            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"Acceso «{canal.EtiquetaProposito}» eliminado.", TonoToast.Exito);
            await CargarPlataformaAsync();
        }
        catch (Exception)
        {
            ToastService.Mostrar("No pudimos eliminar el acceso. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            _eliminandoCanal = false;
            _confirmarEliminarCanalVisible = false;
            _canalAEliminar = null;
        }
    }

