@*
    Panel de Centro para el Context Workspace. Pestañas: Información,
    Requisitos del Centro (la petición original decía "Formularios" — se
    interpreta como Requisitos del Centro, apoyada en la entidad
    RequisitoDocumental que ya existía en el modelo sin ninguna Query hasta
    ahora), Trabajadores, Vehículos, Plataforma, Historial.
*@
@using CaeManager.Application.Centros.Queries.ObtenerCentroPorId
@using CaeManager.Application.Centros.Queries.ObtenerCanalGestionDeCentro
@using CaeManager.Application.Centros.Queries.ObtenerTrabajadoresAsignadosDeCentro
@using CaeManager.Domain.Centros
@using CaeManager.Application.Centros.Queries.ObtenerVehiculosConActividadDeCentro
@using CaeManager.Application.RequisitosDocumentales.Commands.CrearRequisitoDocumental
@using CaeManager.Application.RequisitosDocumentales.Commands.EditarRequisitoDocumental
@using CaeManager.Application.RequisitosDocumentales.Commands.EliminarRequisitoDocumental
@using CaeManager.Application.RequisitosDocumentales.Queries.ObtenerRequisitosDocumentalesDeCentro
@using CaeManager.Domain.Common
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar el centro" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.Nombre</h2>
    </div>

    <Pestanas Definiciones="_pestanas" PestanaActiva="PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones del centro">
        @switch (PestanaActiva)
        {
            case "informacion":
                <div class="workspace-grupo-campos">
                    <CampoInfo Etiqueta="Cliente" Valor="@_detalle.ClienteRazonSocial" />
                    <CampoInfo Etiqueta="Empresa" Valor="@_detalle.EmpresaRazonSocial" />
                    <CampoInfo Etiqueta="Código de centro" Valor="@_detalle.CodigoCentro" />
                    <CampoInfo Etiqueta="Dirección" Valor="@_detalle.Direccion" />
                    <CampoInfo Etiqueta="Contacto" Valor="@_detalle.Contacto" />
                    <CampoInfo Etiqueta="Contrato vigente hasta" Valor="@(_detalle.ContratoVigenteHasta?.ToString("dd/MM/yyyy"))" />
                </div>
                break;

            case "requisitos":
                <div class="workspace-cabecera-seccion">
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirCrearRequisitoAsync">
                        + Añadir requisito
                    </Boton>
                </div>
                @if (_cargandoRequisitos)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorRequisitos)
                {
                    <EstadoVacio Titulo="No pudimos cargar los requisitos" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarRequisitosAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_requisitos is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin requisitos adicionales" Descripcion="Este centro no tiene ningún Requisito Documental registrado más allá de la documentación base." />
                }
                else if (_requisitos is not null)
                {
                    <ul class="workspace-lista-requisitos">
                        @foreach (var requisito in _requisitos)
                        {
                            <li class="workspace-tarjeta-requisito" @key="requisito.Id">
                                <div class="workspace-tarjeta-requisito-cabecera">
                                    <span>@requisito.Descripcion</span>
                                    @if (requisito.BloqueaAcceso)
                                    {
                                        <Badge Tono="TonoBadge.Peligro">Bloquea acceso</Badge>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(requisito.PeriodicidadEspecial))
                                {
                                    <p class="workspace-metrica-inline">Periodicidad especial: @requisito.PeriodicidadEspecial</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(requisito.Notas))
                                {
                                    <p class="workspace-metrica-inline">@requisito.Notas</p>
                                }
                                <div class="workspace-tarjeta-requisito-acciones">
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEditarRequisitoAsync(requisito)">Editar</Boton>
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEliminarRequisito(requisito)">Eliminar</Boton>
                                </div>
                            </li>
                        }
                    </ul>
                }
                break;

            case "trabajadores":
                @if (_cargandoTrabajadores)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorTrabajadores)
                {
                    <EstadoVacio Titulo="No pudimos cargar los trabajadores" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarTrabajadoresAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_trabajadores is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin trabajadores asignados" Descripcion="Ningún trabajador tiene una asignación activa en este centro." />
                }
                else if (_trabajadores is not null)
                {
                    <ul class="workspace-lista-entidades">
                        @foreach (var trabajador in _trabajadores)
                        {
                            <FilaEntidadRelacionada
                                @key="trabajador.TrabajadorId"
                                Titulo="@trabajador.Nombre"
                                Subtitulo="@($"{trabajador.EmpleadorNombre} · desde {trabajador.FechaAlta:dd/MM/yyyy}")"
                                OnClic="() => AbrirTrabajadorAsync(trabajador)" />
                        }
                    </ul>
                }
                break;

            case "vehiculos":
                @if (_cargandoVehiculos)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorVehiculos)
                {
                    <EstadoVacio Titulo="No pudimos cargar los vehículos" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarVehiculosAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_vehiculos is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin vehículos con actividad" Descripcion="Ninguna Empresa/Subcontrata con trabajadores activos en este centro tiene vehículos registrados." />
                }
                else if (_vehiculos is not null)
                {
                    <p class="workspace-nota-contextual">Vehículos disponibles de las empresas/subcontratas con actividad en este centro. La asignación a un trabajador o centro concreto se gestiona de forma operativa, no está modelada todavía.</p>
                    <ul class="workspace-lista-entidades">
                        @foreach (var vehiculo in _vehiculos)
                        {
                            <FilaEntidadRelacionada
                                @key="vehiculo.Id"
                                Titulo="@($"{vehiculo.Nombre} ({vehiculo.NumeroPlaca})")"
                                Subtitulo="@vehiculo.EmpleadorNombre"
                                OnClic="() => AbrirVehiculoAsync(vehiculo)" />
                        }
                    </ul>
                }
                break;

            case "plataforma":
                @if (_cargandoPlataforma)
                {
                    <EstadoCargando Filas="2" />
                }
                else if (_errorPlataforma)
                {
                    <EstadoVacio Titulo="No pudimos cargar la plataforma" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarPlataformaAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_canal is null)
                {
                    <EstadoVacio Titulo="Sin canal de gestión" Descripcion="Este centro no tiene ningún portal externo ni gestión por correo registrado para acreditar documentación." />
                }
                else if (_canal.Tipo == TipoCanalGestion.Plataforma)
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Plataforma" Valor="@_canal.NombrePlataforma" />
                        <CampoInfo Etiqueta="URL de acceso" Valor="@_canal.UrlAcceso" />
                        <CampoInfo Etiqueta="Notas" Valor="@_canal.Notas" />
                        <CampoInfo Etiqueta="Credenciales">
                            <Badge Tono="@(_canal.TieneCredenciales ? TonoBadge.Exito : TonoBadge.Neutro)">
                                @(_canal.TieneCredenciales ? "Configuradas" : "Sin configurar")
                            </Badge>
                        </CampoInfo>
                    </div>
                    <p class="workspace-nota-contextual">El usuario y la contraseña se gestionan desde el formulario de edición del Centro — aquí solo se muestra si están configuradas, nunca su valor.</p>
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Gestión por correo" Valor="@_canal.EmailsDestinatarios" />
                        <CampoInfo Etiqueta="Contacto" Valor="@_canal.NombreContacto" />
                        <CampoInfo Etiqueta="Notas" Valor="@_canal.Notas" />
                    </div>
                }
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Centro" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>

    <Drawer Visible="_drawerRequisitoVisible" VisibleChanged="v => _drawerRequisitoVisible = v"
            Titulo="@(_editandoRequisitoId is null ? "Nuevo requisito" : "Editar requisito")"
            CerrarAlHacerClicFuera="@(_mensajeErrorRequisito is null && !_guardandoRequisito)">
        <ChildContent>
            @if (_mensajeErrorRequisito is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorRequisito</div>
            }
            <CampoTextarea Etiqueta="Descripción" Valor="@_descripcionRequisito" ValorChanged="v => _descripcionRequisito = v" />
            <CampoTexto Etiqueta="Periodicidad especial (opcional)" Valor="@_periodicidadRequisito" ValorChanged="v => _periodicidadRequisito = v" />
            <label class="campo-checkbox">
                <input type="checkbox" @bind="_bloqueaAccesoRequisito" /> Bloquea el acceso al centro mientras no se cumpla
            </label>
            <CampoTextarea Etiqueta="Notas (opcional)" Valor="@_notasRequisito" ValorChanged="v => _notasRequisito = v" />
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _drawerRequisitoVisible = false" Deshabilitado="_guardandoRequisito">Cancelar</Boton>
            <Boton OnClick="GuardarRequisitoAsync" Cargando="_guardandoRequisito">Guardar</Boton>
        </Pie>
    </Drawer>

    <DialogoConfirmacion
        Visible="_confirmarEliminarRequisitoVisible"
        VisibleChanged="v => _confirmarEliminarRequisitoVisible = v"
        Titulo="¿Eliminar este requisito?"
        Mensaje="@($"\"{_requisitoAEliminar?.Descripcion}\" dejará de aparecer en Requisitos del Centro.")"
        EnProgreso="_eliminandoRequisito"
        OnConfirmar="ConfirmarEliminarRequisitoAsync" />
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("requisitos", "Requisitos del Centro"),
        new("trabajadores", "Trabajadores"),
        new("vehiculos", "Vehículos"),
        new("plataforma", "Plataforma"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private CentroDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;

    private IReadOnlyList<RequisitoDocumentalDto>? _requisitos;
    private bool _cargandoRequisitos;
    private bool _errorRequisitos;

    private bool _drawerRequisitoVisible;
    private Guid? _editandoRequisitoId;
    private Guid _versionRequisito;
    private string _descripcionRequisito = string.Empty;
    private string _periodicidadRequisito = string.Empty;
    private bool _bloqueaAccesoRequisito;
    private string _notasRequisito = string.Empty;
    private bool _guardandoRequisito;
    private string? _mensajeErrorRequisito;

    private bool _confirmarEliminarRequisitoVisible;
    private RequisitoDocumentalDto? _requisitoAEliminar;
    private bool _eliminandoRequisito;
    private IReadOnlyList<TrabajadorAsignadoDto>? _trabajadores;
    private bool _cargandoTrabajadores;
    private bool _errorTrabajadores;
    private IReadOnlyList<VehiculoConActividadDto>? _vehiculos;
    private bool _cargandoVehiculos;
    private bool _errorVehiculos;
    private CanalGestionResumenDto? _canal;
    private bool _plataformaCargada;
    private bool _cargandoPlataforma;
    private bool _errorPlataforma;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _idCargado = EntidadId;
            _requisitos = null;
            _errorRequisitos = false;
            _trabajadores = null;
            _errorTrabajadores = false;
            _vehiculos = null;
            _errorVehiculos = false;
            _plataformaCargada = false;
            _errorPlataforma = false;
            await CargarCabeceraAsync();
        }

        if (PestanaActiva == "requisitos" && _requisitos is null && !_errorRequisitos && !_cargandoRequisitos)
            await CargarRequisitosAsync();

        if (PestanaActiva == "trabajadores" && _trabajadores is null && !_errorTrabajadores && !_cargandoTrabajadores)
            await CargarTrabajadoresAsync();

        if (PestanaActiva == "vehiculos" && _vehiculos is null && !_errorVehiculos && !_cargandoVehiculos)
            await CargarVehiculosAsync();

        if (PestanaActiva == "plataforma" && !_plataformaCargada && !_errorPlataforma && !_cargandoPlataforma)
            await CargarPlataformaAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            _detalle = await Mediator.Send(new ObtenerCentroPorIdQuery(EntidadId));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarRequisitosAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoRequisitos = true;
        _errorRequisitos = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerRequisitosDocumentalesDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _requisitos = resultado;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorRequisitos = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoRequisitos = false;
        }
    }

    private Task AbrirCrearRequisitoAsync()
    {
        _editandoRequisitoId = null;
        _versionRequisito = Guid.Empty;
        _descripcionRequisito = string.Empty;
        _periodicidadRequisito = string.Empty;
        _bloqueaAccesoRequisito = false;
        _notasRequisito = string.Empty;
        _mensajeErrorRequisito = null;
        _drawerRequisitoVisible = true;
        return Task.CompletedTask;
    }

    private Task AbrirEditarRequisitoAsync(RequisitoDocumentalDto requisito)
    {
        _editandoRequisitoId = requisito.Id;
        _versionRequisito = requisito.Version;
        _descripcionRequisito = requisito.Descripcion;
        _periodicidadRequisito = requisito.PeriodicidadEspecial ?? string.Empty;
        _bloqueaAccesoRequisito = requisito.BloqueaAcceso;
        _notasRequisito = requisito.Notas ?? string.Empty;
        _mensajeErrorRequisito = null;
        _drawerRequisitoVisible = true;
        return Task.CompletedTask;
    }

    private async Task GuardarRequisitoAsync()
    {
        _guardandoRequisito = true;
        _mensajeErrorRequisito = null;

        try
        {
            var periodicidad = string.IsNullOrWhiteSpace(_periodicidadRequisito) ? null : _periodicidadRequisito;
            var notas = string.IsNullOrWhiteSpace(_notasRequisito) ? null : _notasRequisito;

            Result resultado = _editandoRequisitoId is null
                ? await Mediator.Send(new CrearRequisitoDocumentalCommand(
                    EntidadId, _descripcionRequisito, periodicidad, _bloqueaAccesoRequisito, notas))
                : await Mediator.Send(new EditarRequisitoDocumentalCommand(
                    _editandoRequisitoId.Value, _descripcionRequisito, periodicidad, _bloqueaAccesoRequisito, notas, _versionRequisito));

            if (resultado.EsFallido)
            {
                _mensajeErrorRequisito = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar(
                _editandoRequisitoId is null ? "Requisito creado correctamente." : "Requisito actualizado correctamente.",
                TonoToast.Exito);

            _drawerRequisitoVisible = false;
            await CargarRequisitosAsync();
        }
        catch (ValidationException ex)
        {
            _mensajeErrorRequisito = ex.Errors.FirstOrDefault()?.ErrorMessage
                ?? "No pudimos guardar los cambios. Revisa los datos introducidos.";
        }
        catch (Exception)
        {
            _mensajeErrorRequisito = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            _guardandoRequisito = false;
        }
    }

    private void AbrirEliminarRequisito(RequisitoDocumentalDto requisito)
    {
        _requisitoAEliminar = requisito;
        _confirmarEliminarRequisitoVisible = true;
    }

    private async Task ConfirmarEliminarRequisitoAsync()
    {
        if (_requisitoAEliminar is null) return;

        _eliminandoRequisito = true;
        try
        {
            var resultado = await Mediator.Send(new EliminarRequisitoDocumentalCommand(_requisitoAEliminar.Id));
            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar("Requisito eliminado.", TonoToast.Exito);
            _confirmarEliminarRequisitoVisible = false;
            await CargarRequisitosAsync();
        }
        finally
        {
            _eliminandoRequisito = false;
        }
    }

    private async Task CargarTrabajadoresAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoTrabajadores = true;
        _errorTrabajadores = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerTrabajadoresAsignadosDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _trabajadores = resultado;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorTrabajadores = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoTrabajadores = false;
        }
    }

    private async Task CargarVehiculosAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoVehiculos = true;
        _errorVehiculos = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerVehiculosConActividadDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _vehiculos = resultado;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorVehiculos = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoVehiculos = false;
        }
    }

    private async Task CargarPlataformaAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoPlataforma = true;
        _errorPlataforma = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerCanalGestionDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
            {
                _canal = resultado;
                _plataformaCargada = true;
            }
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorPlataforma = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoPlataforma = false;
        }
    }

    private Task AbrirTrabajadorAsync(TrabajadorAsignadoDto trabajador) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Trabajador, trabajador.TrabajadorId, trabajador.Nombre, "informacion");

    private Task AbrirVehiculoAsync(VehiculoConActividadDto vehiculo) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Vehiculo, vehiculo.Id, vehiculo.Nombre, "informacion");
}
