    @* "Disparo desde Centro 360": el mismo EnviarReclamacionCommand que usa
       /documentos, pero ya acotado a este Centro por ObtenerLoteReclamacionQuery
       (CentroId). Confirmación explícita antes de enviar (docs/COMUNICACIONES.md
       § 16.3, "Automatización: siempre confirmar") — el botón abre esto, no
       manda nada solo. El cuerpo del correo lo compone el propio Command
       (ConstruirCuerpoHtml), por eso aquí solo se revisa la lista, no se edita
       texto libre (a diferencia de "Pedir prioridad", que sí es texto libre). *@
    <Drawer Visible="_drawerReclamacionCentroVisible" VisibleChanged="v => _drawerReclamacionCentroVisible = v"
            Titulo="Reclamar documentación del centro"
            CerrarAlHacerClicFuera="!_enviandoReclamacionCentro">
        <ChildContent>
            @if (_loteReclamacionCentro is null)
            {
                <EstadoCargando Filas="3" />
            }
            else
            {
                @if (_errorReclamacionCentro is not null)
                {
                    <div class="alerta-formulario" role="alert">@_errorReclamacionCentro</div>
                }
                @if (_loteReclamacionCentro.DestinatariosEmail.Count == 0)
                {
                    <div class="alerta-formulario" role="alert">Este cliente no tiene ningún usuario de portal con email — no se puede enviar la reclamación hasta que tenga uno.</div>
                }
                else
                {
                    <p class="workspace-nota-contextual">Destinatarios: @string.Join(", ", _loteReclamacionCentro.DestinatariosEmail)</p>
                }
                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th>Trabajador</th>
                            <th>Documento</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var documento in _loteReclamacionCentro.Documentos)
                        {
                            <tr @key="documento.DocumentoId">
                                <td>@documento.TrabajadorNombre</td>
                                <td>@documento.TipoDocumentoNombre</td>
                                <td>@documento.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _drawerReclamacionCentroVisible = false" Deshabilitado="_enviandoReclamacionCentro">Cancelar</Boton>
            <Boton OnClick="EnviarReclamacionCentroAsync" Cargando="_enviandoReclamacionCentro"
                   Deshabilitado="_loteReclamacionCentro is null || _loteReclamacionCentro.DestinatariosEmail.Count == 0">Enviar</Boton>
        </Pie>
    </Drawer>
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
