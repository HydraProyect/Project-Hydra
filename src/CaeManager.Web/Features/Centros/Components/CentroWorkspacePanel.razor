@*
    Panel de Centro para el Context Workspace. Pestañas: Información,
    Requisitos del Centro (PLAN-EJECUCION-UX.md § 0.4 — selector sobre el
    catálogo de TipoDocumento del tenant, ya no texto libre; sustituye a
    RequisitoDocumental, retirado), Trabajadores, Vehículos, Plataforma,
    Historial.
*@
@using CaeManager.Application.Centros.Queries.ObtenerCentroPorId
@using CaeManager.Application.Centros.Queries.ObtenerCanalGestionDeCentro
@using CaeManager.Application.Centros.Queries.ObtenerEstadoCentro
@using CaeManager.Application.Centros.Queries.ObtenerTrabajadoresAsignadosDeCentro
@using CaeManager.Application.Comunicaciones.Commands.PedirPrioridadValidacion
@using CaeManager.Application.Comunicaciones.Queries.ObtenerBorradorPedirPrioridad
@using CaeManager.Domain.Centros
@using CaeManager.Application.Centros.Queries.ObtenerVehiculosConActividadDeCentro
@using CaeManager.Application.Common
@using CaeManager.Application.Centros.Commands.EstablecerDocumentacionRequeridaCentro
@using CaeManager.Application.Centros.Commands.EliminarDocumentacionRequeridaCentro
@using CaeManager.Application.Centros.Queries.ObtenerDocumentacionRequeridaDeCentro
@using CaeManager.Web.Features.Centros
@using CaeManager.Web.Features.Documentos
@using CaeManager.Domain.Common
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Documentos
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService
@inject IFileStorageService AlmacenamientoArchivos
@inject ILogger<CentroWorkspacePanel> Logger

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar el centro" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.Nombre</h2>
        @if (_estadoCentro is not null)
        {
            <Badge Tono="EstadoCentroUi.Tono(_estadoCentro.Estado)">@EstadoCentroUi.Texto(_estadoCentro.Estado)</Badge>
        }
        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPedirPrioridadAsync">
            Pedir prioridad
        </Boton>
    </div>

    <Pestanas Definiciones="_pestanas" PestanaActiva="PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones del centro">
        @switch (PestanaActiva)
        {
            case "informacion":
                <div class="workspace-grupo-campos">
                    <CampoInfo Etiqueta="Cliente" Valor="@_detalle.ClienteRazonSocial" />
                    <CampoInfo Etiqueta="Empresa" Valor="@_detalle.EmpresaRazonSocial" />
                    <CampoInfo Etiqueta="Código de centro" Valor="@_detalle.CodigoCentro" />
                    <CampoInfo Etiqueta="Dirección" Valor="@_detalle.Direccion" />
                    <CampoInfo Etiqueta="Contacto" Valor="@_detalle.Contacto" />
                    <CampoInfo Etiqueta="Contrato vigente hasta" Valor="@(_detalle.ContratoVigenteHasta?.ToString("dd/MM/yyyy"))" />
                </div>
                @if (_cargandoEstado)
                {
                    <EstadoCargando Filas="2" />
                }
                else if (_estadoCentro is { Estado: not EstadoCentro.Vigente, Causas.Count: > 0 })
                {
                    <div class="workspace-cabecera-seccion">
                        <h3>Por qué no está Vigente</h3>
                    </div>
                    <ul class="workspace-lista-entidades">
                        @foreach (var causa in _estadoCentro.Causas)
                        {
                            <li class="workspace-tarjeta-requisito">
                                <span>@causa.Descripcion</span>
                                @if (causa.Bloqueante)
                                {
                                    <Badge Tono="TonoBadge.Peligro">Bloquea acceso</Badge>
                                }
                                else if (causa.Estado is { } estadoDocumento)
                                {
                                    <Badge Tono="EstadoDocumentoUi.Tono(estadoDocumento)">@EstadoDocumentoUi.Texto(estadoDocumento)</Badge>
                                }
                            </li>
                        }
                    </ul>
                }
                break;

            case "requisitos":
                @if (_cargandoDocumentacion)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorDocumentacion)
                {
                    <EstadoVacio Titulo="No pudimos cargar la documentación requerida" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarDocumentacionAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_documentacion is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin catálogo de documentos" Descripcion="Todavía no hay ningún Tipo de Documento de Trabajador o Empresa dado de alta en /tipos-documento." />
                }
                else if (_documentacion is not null)
                {
                    <p class="workspace-nota-contextual">
                        Documentos obligatorios por defecto (marcados en /tipos-documento) ya aparecen "Incluido" — desmárcalos para excluirlos solo de este centro.
                        Marca cualquier otro para exigirlo además, solo aquí.
                    </p>
                    <ul class="workspace-lista-requisitos">
                        @foreach (var item in _documentacion)
                        {
                            <li class="workspace-tarjeta-requisito" @key="item.TipoDocumentoId">
                                <div class="workspace-tarjeta-requisito-cabecera">
                                    <span>@item.Nombre</span>
                                    <Badge Tono="TonoBadge.Neutro">@(item.AmbitoAplicacion == AmbitoAplicacion.Empresa ? "Empresa" : "Trabajador")</Badge>
                                    <Badge Tono="@(item.Aplica ? TonoBadge.Exito : TonoBadge.Neutro)">@(item.Aplica ? "Incluido" : "Excluido")</Badge>
                                    @if (item.BloqueaAcceso)
                                    {
                                        <Badge Tono="TonoBadge.Peligro">Bloquea acceso</Badge>
                                    }
                                </div>
                                @if (item.PeriodicidadEspecialMeses is { } meses)
                                {
                                    <p class="workspace-metrica-inline">Renovación cada @meses mes(es) en este centro</p>
                                }
                                else if (item.Incluido is not null)
                                {
                                    <p class="workspace-metrica-inline">No vence en este centro</p>
                                }
                                @if (item.ArchivoUrl is not null)
                                {
                                    <p class="workspace-metrica-inline">
                                        <a href="/requisitos-documentales/@item.TipoDocumentoId/archivo" target="_blank">
                                            @(item.NombreArchivoOriginal ?? "Ver formulario")
                                        </a>
                                    </p>
                                }
                                <div class="workspace-tarjeta-requisito-acciones">
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirConfigurarAsync(item)">Configurar</Boton>
                                    @if (item.Incluido is not null)
                                    {
                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => QuitarAjusteAsync(item)">Quitar ajuste</Boton>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                break;

            case "trabajadores":
                @if (_cargandoTrabajadores)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorTrabajadores)
                {
                    <EstadoVacio Titulo="No pudimos cargar los trabajadores" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarTrabajadoresAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_trabajadores is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin trabajadores asignados" Descripcion="Ningún trabajador tiene una asignación activa en este centro." />
                }
                else if (_trabajadores is not null)
                {
                    <ul class="workspace-lista-entidades">
                        @foreach (var trabajador in _trabajadores)
                        {
                            <FilaEntidadRelacionada
                                @key="trabajador.TrabajadorId"
                                Titulo="@trabajador.Nombre"
                                Subtitulo="@($"{trabajador.EmpleadorNombre} · desde {trabajador.FechaAlta:dd/MM/yyyy}")"
                                OnClic="() => AbrirTrabajadorAsync(trabajador)" />
                        }
                    </ul>
                }
                break;

            case "vehiculos":
                @if (_cargandoVehiculos)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorVehiculos)
                {
                    <EstadoVacio Titulo="No pudimos cargar los vehículos" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarVehiculosAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_vehiculos is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin vehículos con actividad" Descripcion="Ninguna Empresa/Subcontrata con trabajadores activos en este centro tiene vehículos registrados." />
                }
                else if (_vehiculos is not null)
                {
                    <p class="workspace-nota-contextual">Vehículos disponibles de las empresas/subcontratas con actividad en este centro. La asignación a un trabajador o centro concreto se gestiona de forma operativa, no está modelada todavía.</p>
                    <ul class="workspace-lista-entidades">
                        @foreach (var vehiculo in _vehiculos)
                        {
                            <FilaEntidadRelacionada
                                @key="vehiculo.Id"
                                Titulo="@($"{vehiculo.Nombre} ({vehiculo.NumeroPlaca})")"
                                Subtitulo="@vehiculo.EmpleadorNombre"
                                OnClic="() => AbrirVehiculoAsync(vehiculo)" />
                        }
                    </ul>
                }
                break;

            case "plataforma":
                @if (_cargandoPlataforma)
                {
                    <EstadoCargando Filas="2" />
                }
                else if (_errorPlataforma)
                {
                    <EstadoVacio Titulo="No pudimos cargar la plataforma" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarPlataformaAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_canal is null)
                {
                    <EstadoVacio Titulo="Sin canal de gestión" Descripcion="Este centro no tiene ningún portal externo ni gestión por correo registrado para acreditar documentación." />
                }
                else if (_canal.Tipo == TipoCanalGestion.Plataforma)
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Plataforma" Valor="@_canal.NombrePlataforma" />
                        <CampoInfo Etiqueta="URL de acceso" Valor="@_canal.UrlAcceso" />
                        <CampoInfo Etiqueta="Notas" Valor="@_canal.Notas" />
                        <CampoInfo Etiqueta="Credenciales">
                            <Badge Tono="@(_canal.TieneCredenciales ? TonoBadge.Exito : TonoBadge.Neutro)">
                                @(_canal.TieneCredenciales ? "Configuradas" : "Sin configurar")
                            </Badge>
                        </CampoInfo>
                    </div>
                    <p class="workspace-nota-contextual">El usuario y la contraseña se gestionan desde el formulario de edición del Centro — aquí solo se muestra si están configuradas, nunca su valor.</p>
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Gestión por correo" Valor="@_canal.EmailsDestinatarios" />
                        <CampoInfo Etiqueta="Contacto" Valor="@_canal.NombreContacto" />
                        <CampoInfo Etiqueta="Notas" Valor="@_canal.Notas" />
                    </div>
                }
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Centro" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>

    <Drawer Visible="_drawerDocVisible" VisibleChanged="v => _drawerDocVisible = v"
            Titulo="@($"Configurar «{_nombreTipoDocumentoEditando}» en este centro")"
            CerrarAlHacerClicFuera="@(_mensajeErrorDocumentacion is null && !_guardandoDocumentacion)">
        <ChildContent>
            @if (_mensajeErrorDocumentacion is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorDocumentacion</div>
            }
            <label class="campo-checkbox">
                <input type="checkbox" @bind="_incluidoEdicion" /> Incluido — este centro lo exige
            </label>

            <CampoSelect Etiqueta="Periodo especial de renovación" Valor="@_periodicidadSeleccionEdicion" ValorChanged="v => _periodicidadSeleccionEdicion = v">
                <option value="">Sin vencimiento en este centro</option>
                @foreach (var meses in PeriodicidadesPredefinidas)
                {
                    <option value="@meses">@meses mes(es)</option>
                }
                <option value="personalizado">Personalizado…</option>
            </CampoSelect>
            @if (_periodicidadSeleccionEdicion == "personalizado")
            {
                <CampoTexto Etiqueta="Meses (número entero)" Type="number" Valor="@_periodicidadPersonalizadaEdicion" ValorChanged="v => _periodicidadPersonalizadaEdicion = v" />
            }

            <label class="campo-checkbox">
                <input type="checkbox" @bind="_bloqueaAccesoEdicion" /> Bloquea el acceso al centro mientras algún trabajador no lo tenga vigente
            </label>

            <div class="campo">
                <label>Formulario adjunto (Word o PDF, opcional)</label>
                @if (_archivoUrlEdicion is not null)
                {
                    <p class="workspace-metrica-inline">
                        @_nombreArchivoEdicion
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="QuitarArchivoDocumentacionEdicion">Quitar</Boton>
                    </p>
                }
                else
                {
                    <ZonaSoltarArchivo
                        OnChange="ManejarArchivoDocumentacionSeleccionadoAsync"
                        Accept=".pdf,application/pdf,.docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                        FormatosTexto="PDF · DOCX"
                        Cargando="_subiendoArchivoEdicion" />
                }
            </div>
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _drawerDocVisible = false" Deshabilitado="_guardandoDocumentacion">Cancelar</Boton>
            <Boton OnClick="GuardarDocumentacionAsync" Cargando="_guardandoDocumentacion" Deshabilitado="_subiendoArchivoEdicion">Guardar</Boton>
        </Pie>
    </Drawer>

    <Drawer Visible="_drawerPrioridadVisible" VisibleChanged="v => _drawerPrioridadVisible = v"
            Titulo="Pedir prioridad de validación"
            CerrarAlHacerClicFuera="@(_mensajeErrorPrioridad is null && !_enviandoPrioridad)">
        <ChildContent>
            @if (_cargandoBorradorPrioridad)
            {
                <EstadoCargando Filas="3" />
            }
            else if (_mensajeErrorPrioridad is not null && _borradorPrioridad is null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeErrorPrioridad</div>
            }
            else if (_borradorPrioridad is not null)
            {
                @if (!_borradorPrioridad.HayConexionDisponible)
                {
                    <div class="alerta-formulario" role="alert">No hay ningún buzón de correo conectado — conecta uno de Microsoft 365 antes de enviar.</div>
                }
                @if (_borradorPrioridad.UltimaSolicitudEnviadaEnUtc is { } ultima)
                {
                    <p class="workspace-nota-contextual">Ya se pidió prioridad para este centro el @ultima.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</p>
                }
                @if (_mensajeErrorPrioridad is not null)
                {
                    <div class="alerta-formulario" role="alert">@_mensajeErrorPrioridad</div>
                }
                <CampoTexto Etiqueta="Destinatarios (separados por coma)" Valor="@_destinatarioPrioridad" ValorChanged="v => _destinatarioPrioridad = v" />
                <CampoTexto Etiqueta="Asunto" Valor="@_asuntoPrioridad" ValorChanged="v => _asuntoPrioridad = v" />
                <CampoTextarea Etiqueta="Mensaje" Valor="@_cuerpoPrioridad" ValorChanged="v => _cuerpoPrioridad = v" Filas="10" />
                <p class="workspace-nota-contextual">@_borradorPrioridad.TotalDocumentosPendientes documento(s) pendiente(s) incluido(s) en el mensaje. Revisa y adapta el texto antes de enviarlo — se envía desde el buzón conectado de la plataforma.</p>
            }
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _drawerPrioridadVisible = false" Deshabilitado="_enviandoPrioridad">Cancelar</Boton>
            <Boton OnClick="EnviarPrioridadAsync" Cargando="_enviandoPrioridad" Deshabilitado="_cargandoBorradorPrioridad || _borradorPrioridad is null">Enviar</Boton>
        </Pie>
    </Drawer>
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("requisitos", "Requisitos del Centro"),
        new("trabajadores", "Trabajadores"),
        new("vehiculos", "Vehículos"),
        new("plataforma", "Plataforma"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private CentroDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;

    private EstadoCentroDto? _estadoCentro;
    private bool _cargandoEstado;

    private static readonly int[] PeriodicidadesPredefinidas = [1, 3, 6, 12, 24, 36, 48, 60];

    private IReadOnlyList<DocumentacionRequeridaCentroDto>? _documentacion;
    private bool _cargandoDocumentacion;
    private bool _errorDocumentacion;

    private bool _drawerDocVisible;
    private Guid _tipoDocumentoIdEditando;
    private string _nombreTipoDocumentoEditando = string.Empty;
    private bool _incluidoEdicion;
    private string _periodicidadSeleccionEdicion = string.Empty;
    private string _periodicidadPersonalizadaEdicion = string.Empty;
    private bool _bloqueaAccesoEdicion;
    private string? _archivoUrlEdicion;
    private string? _nombreArchivoEdicion;
    private bool _subiendoArchivoEdicion;
    private bool _guardandoDocumentacion;
    private string? _mensajeErrorDocumentacion;

    private const long TamanoMaximoArchivoDocumentacionBytes = 10 * 1024 * 1024;

    private IReadOnlyList<TrabajadorAsignadoDto>? _trabajadores;
    private bool _cargandoTrabajadores;
    private bool _errorTrabajadores;
    private IReadOnlyList<VehiculoConActividadDto>? _vehiculos;
    private bool _cargandoVehiculos;
    private bool _errorVehiculos;
    private CanalGestionResumenDto? _canal;
    private bool _plataformaCargada;
    private bool _cargandoPlataforma;
    private bool _errorPlataforma;

    private bool _drawerPrioridadVisible;
    private bool _cargandoBorradorPrioridad;
    private bool _enviandoPrioridad;
    private string? _mensajeErrorPrioridad;
    private BorradorPedirPrioridadDto? _borradorPrioridad;
    private string _destinatarioPrioridad = string.Empty;
    private string _asuntoPrioridad = string.Empty;
    private string _cuerpoPrioridad = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _idCargado = EntidadId;
            _documentacion = null;
            _errorDocumentacion = false;
            _trabajadores = null;
            _errorTrabajadores = false;
            _vehiculos = null;
            _errorVehiculos = false;
            _plataformaCargada = false;
            _errorPlataforma = false;
            _estadoCentro = null;
            await CargarCabeceraAsync();
            await CargarEstadoAsync();
        }

        if (PestanaActiva == "requisitos" && _documentacion is null && !_errorDocumentacion && !_cargandoDocumentacion)
            await CargarDocumentacionAsync();

        if (PestanaActiva == "trabajadores" && _trabajadores is null && !_errorTrabajadores && !_cargandoTrabajadores)
            await CargarTrabajadoresAsync();

        if (PestanaActiva == "vehiculos" && _vehiculos is null && !_errorVehiculos && !_cargandoVehiculos)
            await CargarVehiculosAsync();

        if (PestanaActiva == "plataforma" && !_plataformaCargada && !_errorPlataforma && !_cargandoPlataforma)
            await CargarPlataformaAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            _detalle = await Mediator.Send(new ObtenerCentroPorIdQuery(EntidadId));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarEstadoAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoEstado = true;

        try
        {
            var resultado = await Mediator.Send(new ObtenerEstadoCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _estadoCentro = resultado;
        }
        catch (Exception)
        {
            // El badge de cumplimiento es informativo — si falla, simplemente no se muestra.
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoEstado = false;
        }
    }

    private async Task CargarDocumentacionAsync()
    {
        var idSolicitado = EntidadId;
        _cargandoDocumentacion = true;
        _errorDocumentacion = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerDocumentacionRequeridaDeCentroQuery(idSolicitado));
            if (idSolicitado == EntidadId)
                _documentacion = resultado ?? [];
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorDocumentacion = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoDocumentacion = false;
        }
    }

    private Task AbrirConfigurarAsync(DocumentacionRequeridaCentroDto item)
    {
        _tipoDocumentoIdEditando = item.TipoDocumentoId;
        _nombreTipoDocumentoEditando = item.Nombre;
        _incluidoEdicion = item.Aplica;
        _periodicidadSeleccionEdicion = item.PeriodicidadEspecialMeses switch
        {
            null => string.Empty,
            { } meses when PeriodicidadesPredefinidas.Contains(meses) => meses.ToString(),
            { } meses => "personalizado"
        };
        _periodicidadPersonalizadaEdicion = item.PeriodicidadEspecialMeses is { } m && !PeriodicidadesPredefinidas.Contains(m)
            ? m.ToString() : string.Empty;
        _bloqueaAccesoEdicion = item.BloqueaAcceso;
        _archivoUrlEdicion = item.ArchivoUrl;
        _nombreArchivoEdicion = item.NombreArchivoOriginal;
        _mensajeErrorDocumentacion = null;
        _drawerDocVisible = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Acepta PDF o Word (.docx) y lo guarda tal cual — a diferencia de
    /// Documentos.razor.cs, aquí NO se convierte el Word a PDF: el adjunto es
    /// el propio formulario que el destinatario tiene que poder editar en
    /// Word, así que forzarlo a PDF le quitaría justo eso.
    /// </summary>
    private async Task ManejarArchivoDocumentacionSeleccionadoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;

        if (!ConversorArchivosPdf.EsPdf(archivo.Name) && !ConversorArchivosPdf.EsWord(archivo.Name))
        {
            ToastService.Mostrar($"\"{archivo.Name}\" no es un PDF ni un Word (.docx).", TonoToast.Error);
            return;
        }

        if (archivo.Size > TamanoMaximoArchivoDocumentacionBytes)
        {
            ToastService.Mostrar($"\"{archivo.Name}\" supera los 10 MB.", TonoToast.Error);
            return;
        }

        _subiendoArchivoEdicion = true;
        StateHasChanged();

        try
        {
            byte[] contenido;
            await using (var flujo = archivo.OpenReadStream(TamanoMaximoArchivoDocumentacionBytes))
            using (var memoria = new MemoryStream())
            {
                await flujo.CopyToAsync(memoria);
                contenido = memoria.ToArray();
            }

            if (!ValidadorFirmaArchivo.TieneFirmaValida(contenido, archivo.Name))
            {
                ToastService.Mostrar(
                    $"\"{archivo.Name}\" no es realmente un PDF ni un Word (.docx) — su contenido no coincide con la extensión.",
                    TonoToast.Error);
                return;
            }

            using var flujoOriginal = new MemoryStream(contenido);
            _archivoUrlEdicion = await AlmacenamientoArchivos.GuardarAsync(flujoOriginal, archivo.Name);
            _nombreArchivoEdicion = archivo.Name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fallo al procesar el archivo subido en Requisitos del Centro");
            ToastService.Mostrar("No pudimos procesar el archivo. Intenta nuevamente.", TonoToast.Error);
        }
        finally
        {
            _subiendoArchivoEdicion = false;
        }
    }

    private void QuitarArchivoDocumentacionEdicion()
    {
        _archivoUrlEdicion = null;
        _nombreArchivoEdicion = null;
    }

    private async Task GuardarDocumentacionAsync()
    {
        _guardandoDocumentacion = true;
        _mensajeErrorDocumentacion = null;

        try
        {
            int? periodicidadMeses = _periodicidadSeleccionEdicion switch
            {
                "" => null,
                "personalizado" => int.TryParse(_periodicidadPersonalizadaEdicion, out var personalizado) ? personalizado : null,
                var seleccion => int.Parse(seleccion)
            };

            if (_periodicidadSeleccionEdicion == "personalizado" && periodicidadMeses is null)
            {
                _mensajeErrorDocumentacion = "Indica un número entero de meses, o deja el campo vacío si no vence.";
                return;
            }

            var resultado = await Mediator.Send(new EstablecerDocumentacionRequeridaCentroCommand(
                EntidadId, _tipoDocumentoIdEditando, _incluidoEdicion, periodicidadMeses, _bloqueaAccesoEdicion,
                _archivoUrlEdicion, _nombreArchivoEdicion));

            if (resultado.EsFallido)
            {
                _mensajeErrorDocumentacion = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar("Documentación del centro actualizada.", TonoToast.Exito);

            _drawerDocVisible = false;
            await CargarDocumentacionAsync();
            await CargarEstadoAsync();
        }
        catch (ValidationException ex)
        {
            _mensajeErrorDocumentacion = ex.Errors.FirstOrDefault()?.ErrorMessage
                ?? "No pudimos guardar los cambios. Revisa los datos introducidos.";
        }
        catch (Exception)
        {
            _mensajeErrorDocumentacion = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
        }
        finally
        {
            _guardandoDocumentacion = false;
        }
    }

    private async Task QuitarAjusteAsync(DocumentacionRequeridaCentroDto item)
    {
        var resultado = await Mediator.Send(new EliminarDocumentacionRequeridaCentroCommand(EntidadId, item.TipoDocumentoId));
        if (resultado.EsFallido)
        {
            ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
            return;
        }

        ToastService.Mostrar($"\"{item.Nombre}\" vuelve a seguir el criterio global del tenant.", TonoToast.Exito);
        await CargarDocumentacionAsync();
        await CargarEstadoAsync();
    }

