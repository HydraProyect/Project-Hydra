@*
    Contenido del acordeón "Asignaciones" de una fila de /centros (Centro 360,
    Project-Hydra-Negocio/tecnico/docs/ux-audit/PLAN-EJECUCION-UX.md § 0.1/0.2). Autocontenido: solo se instancia cuando
    el usuario expande la fila (SeccionColapsable no renderiza su
    ChildContent hasta entonces), así que la Query de este componente ya es
    en sí misma la carga perezosa — no hace falta ningún guard adicional.

    Sustituye a la página /asignaciones para este Centro: mismo drawer de
    alta N×M (matriz + preflight) que tenía esa página, ahora con el Centro
    de esta fila pre-marcado, más la baja en lote (DarDeBajaAsignacionesCommand,
    antes sin ningún caller) y el tercer nivel de documentación requerida por
    trabajador.
*@
@using CaeManager.Application.Alertas
@using CaeManager.Application.Asignaciones.Commands.CrearAsignaciones
@using CaeManager.Application.Asignaciones.Commands.DarDeBajaAsignaciones
@using CaeManager.Application.Asignaciones.Queries.ObtenerAsignacionesDocumentacionPorCentro
@using CaeManager.Application.Asignaciones.Queries.ObtenerDocumentosFaltantesParaAsignacion
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService

@if (_errorCarga)
{
    <EstadoVacio Titulo="No pudimos cargar las asignaciones" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else
{
    @* Asignar y dar de baja son ICommand denegados a Consulta: la barra entera se le oculta, sin dejar el hueco.
       En el modo listado de /centros no se pinta: la fila desplegada solo lista incidencias. *@
    @if (!ModoListado)
    {
    <SoloConEscritura>
        <div class="acordeon-asignaciones-cabecera">
            <Boton Variante="@(AsignarEsPrimaria ? VarianteBoton.Primario : VarianteBoton.Secundario)" Tamano="TamanoBoton.Pequeno" OnClick="() => _drawerAsignacion.AbrirAsync(new[] { CentroId })">+ Asignar trabajador</Boton>
            @* La maqueta de Centro 360 (20-10) no lo lleva: «sin Dar de baja seleccionados (no decidido)». *@
            @if (!MostrarEstadoPlataforma)
            {
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_seleccionados.Count == 0" OnClick="AbrirConfirmarBajaLoteAsync">
                    Dar de baja seleccionados
                </Boton>
            }
        </div>
    </SoloConEscritura>
    }

    @Busqueda

    @*
        Ámbito EMPRESA (OD-13, blueprint § 3.3). Aparece solo cuando la empresa
        del centro tiene documentación con incidencia, y lista únicamente lo que
        hay que resolver — el resto se consulta desde "Detalles" de la empresa.

        La nota no es decorativa: sin ella, ver una lista corta se leería como
        "la empresa casi no tiene documentación", cuando lo que dice es "esto es
        lo que falla". Un vacío nunca se presenta como éxito (04 § 6).
    *@
    @if (IncidenciasEmpresa.Count > 0)
    {
        <div class="separador-ambito">Empresa</div>
        @*
            Tarjeta con la misma gramática que la lista de Trabajadores: una fila
            plegable de la Empresa (cifra, estado y «Detalles» en las columnas de la
            rejilla) y, al desplegarla, sus documentos con incidencia en la misma
            tabla que usa cada Trabajador. Va desplegada de entrada: el bloque solo
            existe cuando hay algo que resolver, y un vacío nunca se presenta como éxito.
            Contrato de fidelidad 2026-08-09 § 1.5: mismas columnas Documento ·
            Estado · Vigencia · Acción.
        *@
        <div class="bloque-empresa-ambito @(ModoListado ? "bloque-empresa-ambito-listado" : null)" data-bloque-empresa>
            <ListaRelaciones Etiqueta="@($"Empresa · {EmpresaNombre}")" EnTarjeta="true">
                <FilaRelacion Nombre="@EmpresaNombre" NombreIcono="empresas" Tono="TonoFila.Peligro"
                              OnNombre="AbrirDetalleEmpresa"
                              Desplegada="_empresaDesplegada" DesplegadaChanged="v => _empresaDesplegada = v"
                              EtiquetaDesplegar="@Textos["EmpresaBloqueDesplegar", EmpresaNombre]">
                    <Detalle>@Textos["EmpresaBloqueNota"]</Detalle>
                    <Cifra>
                        @* Cifra corta como el «3 de 4» de los Trabajadores: la columna mide 76 px. El nombre completo va en el title. *@
                        <span class="fila-trabajador-fraccion" title="@Textos[IncidenciasEmpresa.Count == 1 ? "EmpresaBloqueCifraUno" : "EmpresaBloqueCifraVarios", IncidenciasEmpresa.Count]">@IncidenciasEmpresa.Count doc.</span>
                    </Cifra>
                    <Estado>
                        <Badge Tono="TonoBadge.Peligro">@Textos["EmpresaBloqueEstado"]</Badge>
                    </Estado>
                    <Acciones>
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" aria-label="@Textos["EmpresaBloqueDetalles", EmpresaNombre]" OnClick="AbrirDetalleEmpresa">
                            Detalles
                        </Boton>
                    </Acciones>
                    <Desplegable>
                        <div class="tabla-documentos-requeridos documentos-trabajador-ficha" role="table" aria-label="@($"Documentación con incidencia de {EmpresaNombre}")">
                            <div class="documentos-requeridos-cabecera" role="row">
                                <span role="columnheader">Documento</span>
                                <span role="columnheader">Estado</span>
                                <span role="columnheader">Vigencia</span>
                                <span role="columnheader" class="columna-accion">Acción</span>
                            </div>
                            @foreach (var incidencia in IncidenciasEmpresa)
                            {
                                <div class="fila-documento-requerido" role="row" @key="incidencia.TipoDocumentoId">
                                    <span class="celda-documento-nombre" role="cell">
                                        @* El nombre abre el mismo drawer de gestión que la columna de acción, que Consulta no puede usar:
                                           a Consulta se le pinta como texto (igual que en Trabajador 360). *@
                                        <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionNombreEmpresa">
                                            <Authorized>
                                                <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarEmpresaAsync(incidencia)">
                                                    @incidencia.Descripcion
                                                </button>
                                            </Authorized>
                                            <NotAuthorized>@incidencia.Descripcion</NotAuthorized>
                                        </AuthorizeView>
                                    </span>
                                    @* Estado null: un rechazo en plataforma no tiene vigencia documental que describir (CalculoEstadoCentroService). *@
                                    <span role="cell">
                                        @if (incidencia.Estado is { } estadoIncidencia)
                                        {
                                            <Badge Tono="EstadoDocumentoUi.Tono(estadoIncidencia)" ConIcono Tamano="TamanoBadge.Pequeno">
                                                @EstadoDocumentoUi.Texto(estadoIncidencia)
                                            </Badge>
                                        }
                                        else
                                        {
                                            <Badge Tono="TonoBadge.Peligro" ConIcono Tamano="TamanoBadge.Pequeno">
                                                @Textos["BadgeRechazadoPlataforma"]
                                            </Badge>
                                        }
                                    </span>
                                    <span role="cell">
                                        <TextoFechaCopiable Fecha="incidencia.FechaVencimiento" Class="@EstadoDocumentoUi.ClaseCeldaVigencia(incidencia.Estado)">
                                            @TextoVigenciaEmpresa(incidencia)
                                        </TextoFechaCopiable>
                                    </span>
                                    <span class="columna-accion" role="cell">
                                        @* Como en AcordeonTrabajadoresSubcontrata: DrawerGestionDocumento solo crea o renueva
                                           (ICommand denegados a Consulta), así que a quien solo lee no se le ofrece. *@
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                   aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(incidencia.Descripcion, EmpresaNombre)"
                                                   OnClick="() => GestionarEmpresaAsync(incidencia)">
                                                Gestionar
                                            </Boton>
                                        </SoloConEscritura>
                                    </span>
                                </div>
                            }
                        </div>
                    </Desplegable>
                </FilaRelacion>
            </ListaRelaciones>
        </div>
        <div class="separador-ambito">Trabajadores</div>
    }

    @if (!ModoListado && _trabajadoresVisitaSinAsignacion.Count > 0)
    {
        <div class="aviso-visita-sin-asignacion" role="status">
            <p>La próxima visita a este centro incluye a estos trabajadores sin asignación activa aquí:</p>
            @foreach (var trabajador in _trabajadoresVisitaSinAsignacion)
            {
                <div class="fila-documento-requerido" @key="trabajador.TrabajadorId">
                    <span class="fila-documento-requerido-nombre">@trabajador.TrabajadorNombre</span>
                    @* CrearAsignacionCommand, denegado a Consulta: el aviso se le deja, la acción no. *@
                    <SoloConEscritura>
                        <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Cargando="_asignandoDesdeVisita.Contains(trabajador.TrabajadorId)"
                               OnClick="() => AsignarDesdeVisitaAsync(trabajador)">
                            Asignar
                        </Boton>
                    </SoloConEscritura>
                </div>
            }
        </div>
    }

    @if (MostrarTotales)
    {
        <FranjaEstado Opciones="OpcionesFranja" Valor="@FiltroEstado" ValorChanged="FiltroEstadoChanged"
                      Recuentos="RecuentosFranja" TotalTodos="_trabajadores.Count" />
        <p class="resumen-trabajadores">@Textos["MostrandoTrabajadores360", TrabajadoresFiltrados.Count, _trabajadores.Count]</p>
    }

    @if (_trabajadores.Count == 0)
    {
        <EstadoVacio Titulo="Sin trabajadores asignados" Descripcion="Ningún trabajador tiene una asignación activa en este centro." />
    }
    else if (TrabajadoresAMostrar.Count == 0)
    {
        @if (MostrarEnlacesCentro360)
        {
            <EstadoVacio Titulo="Todos al día" Descripcion="@($"Los {_trabajadores.Count} trabajadores de este centro tienen su documentación completa.")">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="VerCentroCompleto">
                        Ver los @_trabajadores.Count en Centro 360
                    </Boton>
                </Accion>
            </EstadoVacio>
        }
        else
        {
            <EstadoVacio Titulo="Todos al día" Descripcion="@($"Los {_trabajadores.Count} trabajadores de este centro tienen su documentación completa.")" />
        }
    }
    else
    {
        @*
            El buscador propio solo aparece cuando nadie lo gobierna desde
            fuera: en Centro 360 la búsqueda vive en la barra de trabajo del
            mockup y viaja en la URL, y pintarla también aquí serían dos
            campos que dicen lo mismo sobre la misma lista.
        *@
        @if (!ModoListado && !BusquedaGobernadaFuera && TrabajadoresAMostrar.Count > 1)
        {
            <div class="acordeon-asignaciones-busqueda">
                <CampoTexto Placeholder="Buscar trabajador…" Valor="@_busquedaTrabajador" ValorChanged="v => _busquedaTrabajador = v" />
            </div>
        }
        @if (TrabajadoresFiltrados.Count == 0)
        {
            @* Vacío POR FILTRO, distinto del vacío por no haber trabajadores: dice cuál de los dos filtros no encontró nada. *@
            <EstadoVacio Titulo="Sin coincidencias" Descripcion="@DescripcionSinCoincidencias">
                <Accion>
                    @if (!BusquedaGobernadaFuera)
                    {
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => _busquedaTrabajador = string.Empty">
                            Limpiar búsqueda
                        </Boton>
                    }
                </Accion>
            </EstadoVacio>
        }
        else
        {
        <div class="lista-trabajadores-acordeon @(ModoListado ? "lista-trabajadores-acordeon-listado" : null)">
            <ListaRelaciones Etiqueta="@($"{Textos["PestanaTrabajadores"]} · {CentroNombre}")" EnTarjeta="true">
            @foreach (var trabajador in TrabajadoresFiltrados)
            {
                var expandido = _expandidosTrabajador.Contains(trabajador.AsignacionId);
                <FilaRelacion @key="trabajador.AsignacionId" Nombre="@(ModoListado ? NombreTrabajadorListado(trabajador.TrabajadorNombre) : trabajador.TrabajadorNombre)" Iniciales="@(ModoListado ? null : InicialesTrabajador(trabajador.TrabajadorNombre))"
                              Tono="@(EstaBloqueado(trabajador.TrabajadorId) ? TonoFila.Peligro : EstadoDocumentoFicha360.TonoFila(trabajador.PeorEstado))"
                              Avatar="@(SeleccionMultiple && !ModoListado ? CasillaSeleccion(trabajador) : null)"
                              OnNombre="() => AbrirDetalleTrabajador(trabajador)"
                              OnAbrir360="@(ModoListado ? default : EventCallback.Factory.Create(this, () => AbrirDetalleTrabajador(trabajador)))"
                              Desplegada="expandido" DesplegadaChanged="_ => AlternarExpansionTrabajador(trabajador.AsignacionId)"
                              EtiquetaDesplegar="@($"Documentos exigidos a {trabajador.TrabajadorNombre}")">
                    <JuntoAlNombre>
                        @* Maqueta de Centro 360: la Empresa empleadora acompaña al Trabajador en la fila. *@
                        @if (EmpleadorDe(trabajador.TrabajadorId) is { } empleador)
                        {
                            <span class="fila-trabajador-empleador" data-empleador>@empleador</span>
                        }
                    </JuntoAlNombre>
                    <Detalle>
                        @if (BloqueosDe(trabajador.TrabajadorId).Count > 0)
                        {
                            <MotivoBloqueoTrabajador TrabajadorId="trabajador.TrabajadorId"
                                                     Bloqueos="BloqueosDe(trabajador.TrabajadorId)"
                                                     Otros="OtrosPendientesDe(trabajador)"
                                                     OnPedir="PedirAsync" MostrarAcciones="@(!ModoListado)" />
                        }
                        else
                        {
                            <span>@MotivoDocumental(trabajador)</span>
                        }
                    </Detalle>
                    <Cifra>
                        @if (ModoListado)
                        {
                            <span class="fila-trabajador-motivo" title="@MotivoTrabajadorListado(trabajador)">@MotivoTrabajadorListado(trabajador)</span>
                        }
                        else
                        {
                            <span class="fila-trabajador-fraccion">@(TextoFraccionTrabajador(trabajador))</span>
                        }
                    </Cifra>
                    <Estado>
                        <Badge Tono="@(EstaBloqueado(trabajador.TrabajadorId) ? TonoBadge.Peligro : EstadoDocumentoFicha360.Tono(trabajador.PeorEstado))">
                            @(EstaBloqueado(trabajador.TrabajadorId) ? Textos["BloqueadoEtiqueta"].Value : EstadoDocumentoFicha360.Texto(trabajador.PeorEstado))
                        </Badge>
                    </Estado>
                    <Acciones>
                        @if (ModoListado)
                        {
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                       class="fila-trabajador-gestionar accion-fila-enlace" aria-expanded="@(expandido ? "true" : "false")"
                                       OnClick="() => AlternarExpansionTrabajador(trabajador.AsignacionId)">@Textos["GestionarDocumento360"]</Boton>
                            </SoloConEscritura>
                        }
                        @if (!MostrarEstadoPlataforma && !ModoListado && !EstaBloqueado(trabajador.TrabajadorId) && PuedePedir(trabajador))
                        {
                            <SoloConEscritura>
                                @* Texto visible «Gestionar»; el nombre accesible dice que reclama los documentos del Trabajador, para no
                                   confundirlo con el «Gestionar» de cada documento. *@
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                       aria-label="@Textos["AriaGestionarDocumentosTrabajador", trabajador.TrabajadorNombre]"
                                       OnClick="() => PedirAsync(new(AmbitoAplicacion.Trabajador, trabajador.TrabajadorId))">@Textos["PedirDocumentacion360"]</Boton>
                            </SoloConEscritura>
                        }
                    </Acciones>
                    <Desplegable>
                        @if (expandido)
                        {
                            @if (trabajador.Documentos.Count == 0)
                            {
                                <p class="texto-vacio-seccion">Este centro no exige documentación específica a este trabajador.</p>
                            }
                            else
                            {
                                @if (MostrarEstadoPlataforma)
                                {
                                    <div class="tabla-plataforma-centro" role="table" aria-label="@($"{Textos["PestanaTrabajadores"]} · {trabajador.TrabajadorNombre}")">
                                        <div class="cabecera-plataforma-centro" role="row">
                                            <span role="columnheader">@Textos["DocumentoColumna360"]</span>
                                            <span role="columnheader">@(NombrePlataforma is { } plataformaCabecera ? Textos["PlataformaEstadoCabeceraNombre360", plataformaCabecera] : Textos["PlataformaEstadoCabecera360"])</span>
                                            <span role="columnheader">@Textos["PlataformaCaducidad360"]</span>
                                            <span role="columnheader">@Textos["PlataformaBloquea360"]</span>
                                            <span role="columnheader" class="cabecera-accion-plataforma">@Textos["AccionColumna360"]</span>
                                        </div>
                                        @{ var clavesDocumentos = new ClavesDeHermanos(); }
                                        @foreach (var documento in trabajador.Documentos.OrderBy(OrdenPlataforma))
                                        {
                                            <div class="fila-plataforma-centro @(BloqueaPlataforma(documento) ? "fila-plataforma-bloquea" : TienePendienteValidacion(documento) ? "fila-plataforma-pendiente" : null)" role="row" @key="clavesDocumentos.De((documento.TipoDocumentoId, documento.DocumentoId))">
                                                <span role="cell" class="identidad-documento-plataforma">
                                                    <span class="indicador-talveg" data-estado="@EstadoDocumentoFicha360.Tono(documento.Estado)" title="@Textos["PlataformaTalveg360", EstadoDocumentoFicha360.Texto(documento.Estado)]" aria-label="@Textos["PlataformaTalveg360", EstadoDocumentoFicha360.Texto(documento.Estado)]">T</span>
                                                    <span>@documento.TipoDocumentoNombre</span>
                                                </span>
                                                <span role="cell" class="estado-documento-plataforma">
                                                    @if (documento.AcreditacionesEnElCentro is not { Count: > 0 })
                                                    {
                                                        <span>@Textos["PlataformaSinDatos360"]</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var acreditacion in documento.AcreditacionesEnElCentro)
                                                        {
                                                            <Badge Tono="TonoPlataforma(acreditacion.Estado)" Tamano="TamanoBadge.Pequeno">@TextoPlataforma(acreditacion.Estado)</Badge>
                                                            <span class="nombre-plataforma-centro">@acreditacion.NombrePlataforma</span>
                                                            <AnotacionEstadoPlataforma Acreditacion="acreditacion" />
                                                        }
                                                    }
                                                    <CaeManager.Web.Features.Documentos.Components.LineaPlataformaYReclamacion Acreditaciones="null" UltimaReclamacion="documento.UltimaReclamacion" Estado="documento.Estado" LaFilaYaDiceLaPlataforma="false" />
                                                </span>
                                                <span role="cell"><TextoFechaCopiable Fecha="documento.FechaVencimiento">@TextoVigencia(documento)</TextoFechaCopiable></span>
                                                <span role="cell">@(documento.AcreditacionesEnElCentro is not { Count: > 0 } ? "—" : Textos[BloqueaPlataforma(documento) ? "PlataformaBloqueaSi360" : "PlataformaBloqueaNo360"].Value)</span>
                                                @* Columna «Acción» (bloque 3 del 21-10): el estado en la plataforma solo se cambia aquí, en Centro 360. Desde un
                                                   Centro no se sube nada a TALVEG (regla del 2026-10-19, #1475): si falta en TALVEG, la acción lleva a la ficha 360
                                                   del Trabajador; si no, «Marcar subido / validado» y «Cambiar» anotan el estado en la plataforma de ESTE Centro. *@
                                                <span role="cell" class="celda-accion-plataforma">
                                                    @if (GestionarEnPlataforma.FaltaEnTalveg(documento.DocumentoId, documento.Estado))
                                                    {
                                                        <SoloConEscritura>
                                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                                   data-accion="actualizar-en-ficha"
                                                                   Href="@GestionarEnPlataforma.RutaFicha(esDeEmpresa: false, trabajador.TrabajadorId)">
                                                                @GestionarEnPlataforma.TextoActualizar(esDeEmpresa: false)
                                                            </Boton>
                                                        </SoloConEscritura>
                                                    }
                                                    else if (documento.AcreditacionesEnElCentro is { Count: > 0 } acreditacionesAccion)
                                                    {
                                                        @foreach (var acreditacion in acreditacionesAccion)
                                                        {
                                                            <AccionEstadoPlataforma @key="acreditacion.Id" CentroId="CentroId" CentroNombre="@CentroNombre"
                                                                                    Acreditacion="acreditacion" DocumentoNombre="@documento.TipoDocumentoNombre"
                                                                                    TitularNombre="@trabajador.TrabajadorNombre" OnCambio="ManejarDocumentoGuardadoAsync" />
                                                        }
                                                    }
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                <div class="tabla-documentos-requeridos documentos-trabajador-ficha" role="table"
                                     aria-label="@($"Documentación exigida a {trabajador.TrabajadorNombre}")">
                                    <div class="documentos-requeridos-cabecera" role="row">
                                        <span role="columnheader">Documento</span>
                                        <span role="columnheader">Estado</span>
                                        <span role="columnheader">Vigencia</span>
                                        <span role="columnheader" class="columna-accion">Acción</span>
                                    </div>
                                    @{ var clavesDocumentos = new ClavesDeHermanos(); }
                                    @foreach (var documento in trabajador.Documentos)
                                    {
                                        <div class="fila-documento-requerido" role="row" @key="clavesDocumentos.De((documento.TipoDocumentoId, documento.DocumentoId))">
                                            <span class="celda-documento-nombre" role="cell">
                                                @* Mismo criterio que el nombre de la incidencia de Empresa, arriba: a Consulta, texto. *@
                                                <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionNombre">
                                                    <Authorized>
                                                        <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarAsync(trabajador.TrabajadorId, documento)">
                                                            @documento.TipoDocumentoNombre
                                                        </button>
                                                    </Authorized>
                                                    <NotAuthorized>@documento.TipoDocumentoNombre</NotAuthorized>
                                                </AuthorizeView>
                                                @* Solo la última reclamación: el estado en las plataformas de ESTE Centro va en la
                                                   celda de estado, en su propia línea «En la plataforma» (regla del 2026-10-19). *@
                                                <CaeManager.Web.Features.Documentos.Components.LineaPlataformaYReclamacion
                                                    SoloReclamacion="true"
                                                    Acreditaciones="documento.AcreditacionesEnElCentro"
                                                    UltimaReclamacion="documento.UltimaReclamacion"
                                                    Estado="documento.Estado" />
                                            </span>
                                            <span role="cell" class="celda-dos-estados">
                                                @* Dos estados, dos líneas (regla de Chris del 2026-10-19): la vigencia en TALVEG y la
                                                   acreditación en las plataformas de este Centro nunca se mezclan en un mismo rótulo. *@
                                                <span class="linea-estado linea-estado-talveg" data-linea="talveg">
                                                <span class="linea-estado-etiqueta">@CaeManager.Web.Features.Documentos.Recursos.TextosGestionarAcreditacion.Texto("LineaEnTalveg")</span>
                                                @if (documento.DocumentoId is null)
                                                {
                                                    @* Se pide aquí por dos vías posibles (ResolucionTipoDocumentoCentro.Aplica,
                                                       mismo criterio que Alertas.razor): la fila de este centro, o si el
                                                       centro no dice nada, el valor general del tipo. Atribuirlo solo al
                                                       centro mentía en los centros que no han configurado nada. *@
                                                    <VentanaContexto Etiqueta="Pendiente: se pide en este centro —porque lo tiene configurado o, si no dice nada, porque el tipo se pide siempre— y no hay ningún documento todavía"
                                                                     Titulo="Pendiente">
                                                        <Disparador>
                                                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">Pendiente</Badge>
                                                        </Disparador>
                                                        <Detalle>
                                                            Se pide en este centro —porque este centro lo tiene configurado o, si no dice nada, porque el tipo de documento se pide siempre— y todavía no hay ninguno subido.
                                                        </Detalle>
                                                    </VentanaContexto>
                                                }
                                                else if (documento.CaducaEnVentanaVisita)
                                                {
                                                    @*
                                                        "Riesgo en visita" es MODIFICADOR sobre Vigente, no un
                                                        cuarto estado (DDL-039, DDL-052): el badge conserva su
                                                        tono y la ventana explica la fecha de referencia.
                                                    *@
                                                    <VentanaContexto Etiqueta="Riesgo en visita: vigente hoy, caduca antes de que termine la próxima visita"
                                                                     Titulo="Vigente hoy, caduca en la visita">
                                                        <Disparador>
                                                            <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" ConIcono
                                                                   Tamano="TamanoBadge.Pequeno"
                                                                   class="badge-riesgo-ventana-visita">
                                                                @EstadoDocumentoUi.Texto(documento.Estado)
                                                            </Badge>
                                                        </Disparador>
                                                        <Detalle>
                                                            @if (documento.FechaVencimiento is { } vence)
                                                            {
                                                                <span class="ventana-linea">Válido hasta el @vence.ToString("dd/MM/yyyy").</span>
                                                            }
                                                            <span class="ventana-linea">
                                                                La próxima visita termina después de esa fecha, así que
                                                                dejaría de estar al día durante ella.
                                                            </span>
                                                        </Detalle>
                                                    </VentanaContexto>
                                                }
                                                else
                                                {
                                                    <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" ConIcono Tamano="TamanoBadge.Pequeno">
                                                        @EstadoDocumentoUi.Texto(documento.Estado, documento.EnToleranciaHasta)
                                                    </Badge>
                                                }
                                                </span>
                                                <span class="linea-estado linea-estado-plataforma @(documento.AcreditacionesEnElCentro?.Any(a => a.Estado == EstadoAcreditacion.Rechazada) == true ? "linea-estado-plataforma--rechazada" : null)"
                                                      data-linea="plataforma">
                                                    <span class="linea-estado-etiqueta">@CaeManager.Web.Features.Documentos.Recursos.TextosGestionarAcreditacion.Texto("LineaEnPlataforma")</span>
                                                    @GestionarEnPlataforma.TextoEnPlataforma(documento.AcreditacionesEnElCentro)
                                                </span>
                                            </span>
                                            <span role="cell">
                                                <TextoFechaCopiable Fecha="documento.FechaVencimiento" Class="@EstadoDocumentoUi.ClaseCeldaVigencia(documento.Estado)">
                                                    @TextoVigencia(documento)
                                                </TextoFechaCopiable>
                                            </span>
                                            <span class="columna-accion" role="cell">
                                                @* Desde un Centro no se sube nada (regla del 2026-10-19): si falta en TALVEG, la acción
                                                   lleva a la ficha 360 del Trabajador; si no, «Gestionar» abre el panel que cambia solo el
                                                   estado en la plataforma. En gris cuando los dos estados están al día. Solo con escritura. *@
                                                @if (GestionarEnPlataforma.FaltaEnTalveg(documento.DocumentoId, documento.Estado))
                                                {
                                                    <SoloConEscritura>
                                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                               data-accion="actualizar-en-ficha"
                                                               Href="@GestionarEnPlataforma.RutaFicha(esDeEmpresa: false, trabajador.TrabajadorId)">
                                                            @GestionarEnPlataforma.TextoActualizar(esDeEmpresa: false)
                                                        </Boton>
                                                    </SoloConEscritura>
                                                }
                                                else
                                                {
                                                    <SoloConEscritura>
                                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                                               class="@(GestionarEnPlataforma.AmbosAlDia(documento.Estado, documento.AcreditacionesEnElCentro) ? $"accion-fila-enlace {EstadoDocumentoFicha360.ClaseGestionarDiscreto}" : "accion-fila-enlace")"
                                                               data-accion="gestionar-acreditacion"
                                                               aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre, trabajador.TrabajadorNombre)"
                                                               OnClick="() => GestionarAcreditacion(trabajador, documento)">
                                                            @Textos["GestionarDocumento360"]
                                                        </Boton>
                                                    </SoloConEscritura>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                                }
                            }
                        }
                    </Desplegable>
                </FilaRelacion>
            }
            </ListaRelaciones>
        </div>
        }
        @*
            Pie de totales («Totales del centro» del mockup). Cuenta la lista
            COMPLETA cargada, no la filtrada: es el denominador del centro, no
            un recuento de lo que se ve. Y habla de los trabajadores, no «del
            centro» a secas — la documentación de la Empresa va en su propio
            bloque y no entra en esta suma.
        *@
        @if (MostrarTotales && TotalesDocumentales.Exigidos > 0)
        {
            <div class="nota-trabajadores-ocultos" data-totales-documentales>
                <span>
                    Documentación de los trabajadores de este centro:
                    @TotalesDocumentales.Exigidos exigidos · @TotalesDocumentales.AlDia al día ·
                    @Textos[TotalesDocumentales.Vencidos == 1 ? "GrupoResumenVencidoUno" : "GrupoResumenVencidoVarios", TotalesDocumentales.Vencidos]
                    · @Textos[TotalesDocumentales.Faltantes == 1 ? "GrupoResumenPendienteUno" : "GrupoResumenPendienteVarios", TotalesDocumentales.Faltantes]
                    @Textos["TotalesListaCompleta360"]
                </span>
            </div>
        }
        @if (TrabajadoresOcultosAlDia > 0)
        {
            <div class="nota-trabajadores-ocultos">
                <span>@TrabajadoresOcultosAlDia @(TrabajadoresOcultosAlDia == 1 ? "trabajador al día no se muestra aquí" : "trabajadores al día no se muestran aquí")</span>
                @if (MostrarEnlacesCentro360)
                {
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick="VerCentroCompleto">
                        Ver Centro 360 →
                    </Boton>
                }
            </div>
        }
    }
}

<Modal @ref="_modalBajaLote" HayCambios="() => HayCambiosSinGuardar" Visible="_confirmarBajaLoteVisible" VisibleChanged="v => _confirmarBajaLoteVisible = v" Titulo="@($"Dar de baja a {_seleccionados.Count} trabajador(es)")">
    <ChildContent>
        <p>Dejarán de estar activos en @CentroNombre a partir de la fecha indicada. El historial de la asignación se conserva.</p>
        <CampoTexto Etiqueta="Fecha de baja" Type="date" Valor="@_fechaBajaLote" ValorChanged="v => _fechaBajaLote = v" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_procesandoBajaLote" OnClick="() => _modalBajaLote?.SolicitarCierreAsync() ?? Task.CompletedTask">
            Cancelar
        </Boton>
        <Boton Variante="VarianteBoton.Destructivo" Cargando="_procesandoBajaLote" OnClick="ConfirmarBajaLoteAsync">
            Dar de baja
        </Boton>
    </Pie>
</Modal>

<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="() => _confirmarBajaLoteVisible = false" />

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />
@if (_acreditacionAGestionar is { } gestion)
{
    <PanelGestionarAcreditacion @bind-Visible="_panelAcreditacionVisible"
                                DocumentoNombre="@gestion.Documento.TipoDocumentoNombre" PropietarioNombre="@gestion.PropietarioNombre"
                                PropietarioId="gestion.PropietarioId" CentroNombre="@CentroNombre"
                                EstadoTalveg="gestion.Documento.Estado" FechaVencimiento="gestion.Documento.FechaVencimiento"
                                Acreditaciones="@(gestion.Documento.AcreditacionesEnElCentro ?? [])"
                                OnGuardado="ManejarDocumentoGuardadoAsync" />
}
<DrawerAsignacionMasiva @ref="_drawerAsignacion" OnGuardado="ManejarAsignacionGuardadaAsync" />

<DrawerReclamacionLote Visible="_pedirVisible" VisibleChanged="v => _pedirVisible = v"
                       AmbitosDisponibles="@(new[] { AmbitoAplicacion.Trabajador, AmbitoAplicacion.Empresa })"
                       AmbitoInicial="_pedirAmbito" EntidadIdInicial="_pedirEntidadId" IncluirPendientesSinFecha="true" />


@code {
    private RenderFragment CasillaSeleccion(TrabajadorAsignacionDocumentacionDto trabajador) => __builder =>
    {
        <input type="checkbox" aria-label="@($"Seleccionar a {trabajador.TrabajadorNombre} en el centro {CentroNombre}")"
               checked="@_seleccionados.Contains(trabajador.AsignacionId)"
               @onchange="e => AlternarSeleccion(trabajador.AsignacionId, (bool)e.Value!)" />
    };
}
