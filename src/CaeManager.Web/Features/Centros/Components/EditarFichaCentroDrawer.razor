@using CaeManager.Application.Centros.Commands.EditarFichaCentro
@using CaeManager.Application.Centros.Queries.ObtenerCentroPorId
@using CaeManager.Domain.Common
@using CaeManager.Web.Features.Centros.Recursos
@using FluentValidation
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosCentros> Textos

<DrawerFormulario Visible="Visible" VisibleChanged="VisibleChanged" Titulo="@Textos["FichaEditarTitulo"]"
    Cargando="_cargando" HayCambios="() => Visible && _lista && _instantanea.Difiere(Instantanea())"
    Guardando="_guardando" MensajeError="@_error" HayErroresDeCampo="@(_errores.Count > 0)"
    MotivoGuardarDeshabilitado="@(!_lista ? Textos["FichaNoDisponible"].Value : null)" OnGuardar="GuardarAsync"
    TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <CampoTexto Etiqueta="@Textos["FichaHorarioAcceso"]" Valor="@_horarioAcceso" ValorChanged="v => _horarioAcceso = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.HorarioAcceso))" />
    <CampoTexto Etiqueta="@Textos["FichaControlAccesosNombre"]" Valor="@_controlAccesosNombre" ValorChanged="v => _controlAccesosNombre = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.ControlAccesosNombre))" />
    <CampoTexto Etiqueta="@Textos["FichaControlAccesosTelefono"]" Valor="@_controlAccesosTelefono" ValorChanged="v => _controlAccesosTelefono = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.ControlAccesosTelefono))" />
    <CampoTexto Etiqueta="@Textos["FichaTecnicoPrevencionNombre"]" Valor="@_tecnicoPrevencionNombre" ValorChanged="v => _tecnicoPrevencionNombre = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.TecnicoPrevencionNombre))" />
    <CampoTexto Etiqueta="@Textos["FichaTecnicoPrevencionTelefono"]" Valor="@_tecnicoPrevencionTelefono" ValorChanged="v => _tecnicoPrevencionTelefono = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.TecnicoPrevencionTelefono))" />
    <CampoTexto Etiqueta="@Textos["FichaTecnicoPrevencionCorreo"]" Valor="@_tecnicoPrevencionCorreo" ValorChanged="v => _tecnicoPrevencionCorreo = v" MensajeError="@Error(nameof(EditarFichaCentroCommand.TecnicoPrevencionCorreo))" />
    <CampoSelect Etiqueta="@Textos["FichaTrabajosEnAltura"]" Valor="@_trabajosEnAltura" ValorChanged="v => _trabajosEnAltura = v"><option value="">@Textos["FichaSinInformar"]</option><option value="true">@Textos["FichaSi"]</option><option value="false">@Textos["FichaNo"]</option></CampoSelect>
    <CampoSelect Etiqueta="@Textos["FichaEspaciosConfinados"]" Valor="@_espaciosConfinados" ValorChanged="v => _espaciosConfinados = v"><option value="">@Textos["FichaSinInformar"]</option><option value="true">@Textos["FichaSi"]</option><option value="false">@Textos["FichaNo"]</option></CampoSelect>
    <CampoSelect Etiqueta="@Textos["FichaAtmosferasExplosivas"]" Valor="@_atmosferasExplosivas" ValorChanged="v => _atmosferasExplosivas = v"><option value="">@Textos["FichaSinInformar"]</option><option value="true">@Textos["FichaSi"]</option><option value="false">@Textos["FichaNo"]</option></CampoSelect>
</DrawerFormulario>

@code {
    [Parameter] public Guid CentroId { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnGuardada { get; set; }

    private bool _abierto, _cargando, _guardando, _lista;
    private int _generacion;
    private Guid _id, _version;
    private string _horarioAcceso = "",
        _controlAccesosNombre = "",
        _controlAccesosTelefono = "",
        _tecnicoPrevencionNombre = "",
        _tecnicoPrevencionTelefono = "",
        _tecnicoPrevencionCorreo = "",
        _trabajosEnAltura = "",
        _espaciosConfinados = "",
        _atmosferasExplosivas = "";
    private string? _error;
    private Dictionary<string, string> _errores = [];
    private readonly InstantaneaFormulario _instantanea = new();
    private readonly CancellationTokenSource _ciclo = new();

    private string? Error(string campo) => _errores.GetValueOrDefault(campo);
    private string Instantanea() => System.Text.Json.JsonSerializer.Serialize(new
    {
        _horarioAcceso, _controlAccesosNombre, _controlAccesosTelefono, _tecnicoPrevencionNombre, _tecnicoPrevencionTelefono, _tecnicoPrevencionCorreo, _trabajosEnAltura, _espaciosConfinados, _atmosferasExplosivas
    });

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible)
        {
            if (_abierto) ++_generacion;
            _abierto = false;
            return;
        }
        if (_abierto && _id == CentroId) return;
        _abierto = true;
        _id = CentroId;
        var generacion = ++_generacion;
        _cargando = true;
        _guardando = _lista = false;
        _error = null;
        _errores.Clear();
        try
        {
            var detalle = await Mediator.Send(new ObtenerCentroPorIdQuery(_id), _ciclo.Token);
            if (generacion != _generacion) return;
            if (detalle is null || !detalle.FichaVisible) { _error = Textos["FichaNoDisponible"]; return; }
            _version = detalle.Version;
            _horarioAcceso = detalle.HorarioAcceso ?? "";
            _controlAccesosNombre = detalle.ControlAccesosNombre ?? "";
            _controlAccesosTelefono = detalle.ControlAccesosTelefono ?? "";
            _tecnicoPrevencionNombre = detalle.TecnicoPrevencionNombre ?? "";
            _tecnicoPrevencionTelefono = detalle.TecnicoPrevencionTelefono ?? "";
            _tecnicoPrevencionCorreo = detalle.TecnicoPrevencionCorreo ?? "";
            _trabajosEnAltura = detalle.TrabajosEnAltura?.ToString().ToLowerInvariant() ?? "";
            _espaciosConfinados = detalle.EspaciosConfinados?.ToString().ToLowerInvariant() ?? "";
            _atmosferasExplosivas = detalle.AtmosferasExplosivas?.ToString().ToLowerInvariant() ?? "";
            _instantanea.Fijar(Instantanea());
            _lista = true;
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception) { if (generacion == _generacion) _error = Textos["FichaNoDisponible"]; }
        finally { if (generacion == _generacion) _cargando = false; }
    }

    private async Task GuardarAsync()
    {
        if (!_lista || _guardando || !Visible) return;
        var generacion = _generacion;
        _guardando = true;
        _errores.Clear();
        _error = null;
        try
        {
            var comando = new EditarFichaCentroCommand(_id, _version,
                _horarioAcceso,
                _controlAccesosNombre,
                _controlAccesosTelefono,
                _tecnicoPrevencionNombre,
                _tecnicoPrevencionTelefono,
                _tecnicoPrevencionCorreo,
                _trabajosEnAltura == "" ? null : _trabajosEnAltura == "true",
                _espaciosConfinados == "" ? null : _espaciosConfinados == "true",
                _atmosferasExplosivas == "" ? null : _atmosferasExplosivas == "true");
            var validacion = new EditarFichaCentroCommandValidator().Validate(comando);
            if (!validacion.IsValid) throw new ValidationException(validacion.Errors);
            var resultado = await Mediator.Send(comando, _ciclo.Token);
            if (generacion != _generacion) return;
            if (resultado.EsFallido)
            {
                // La versión original se conserva: el borrador nunca se reenvía con una versión no revisada.
                _error = resultado.Error.Mensaje;
                return;
            }
            _instantanea.Fijar(Instantanea());
            ToastService.Mostrar(Textos["FichaGuardada"], TonoToast.Exito);
            await VisibleChanged.InvokeAsync(false);
            await OnGuardada.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _errores = ex.Errors.GroupBy(e => e.PropertyName).ToDictionary(g => g.Key, g => g.First().ErrorMessage);
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception) { if (generacion == _generacion) _error = Textos["FichaErrorGuardar"]; }
        finally { if (generacion == _generacion) _guardando = false; }
    }

    public void Dispose()
    {
        ++_generacion;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
