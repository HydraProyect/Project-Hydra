@*
    Vista previa lateral del centro — pieza 6 del patrón único de pantalla de lista
    (Project-Hydra-Negocio/tecnico/CONTRATO-PATRON-PANTALLA-LISTA-2026-09-28.md § 3): resume el estado y
    ofrece «Abrir ficha 360». Se alimenta de la propia fila de la lista (<c>CentroListaDto</c>) y de las
    visitas que la lista ya cargó por lote: no hay consulta nueva, así que no puede enseñar más que la
    lista ni saltarse el alcance con el que ya se cargó.
*@
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Visitas.Queries.ObtenerProximaVisitaPorCentro
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosCentros> Textos

@if (Visible && Centro is { } c)
{
    <aside class="drawer-preview-centro" role="complementary" aria-label="@Textos["PreviewAria"]">
        <div class="cabecera-preview-centro">
            <div class="texto-cabecera-preview-centro">
                <span class="etiqueta-cabecera-preview-centro">@Textos["PreviewEtiqueta"]</span>
                <span class="nombre-cabecera-preview-centro">@c.Nombre</span>
            </div>
            <button type="button" class="boton-cerrar-preview-centro" aria-label="@Textos["PreviewCerrar"]" @onclick="Cerrar"><Icono Nombre="cerrar" /></button>
        </div>

        <div class="cuerpo-preview-centro">
            <div class="estado-preview-centro">
                <Badge Tono="EstadoCentroUi.Tono(c.Estado)">@EstadoCentroUi.Texto(c.Estado)</Badge>
            </div>
            <div class="rejilla-info-preview-centro">
                <div class="celda-info-preview-centro"><span>@Textos["PreviewCliente"]</span><strong>@c.ClienteRazonSocial</strong></div>
                <div class="celda-info-preview-centro"><span>@Textos["PreviewEmpresa"]</span><strong>@c.EmpresaRazonSocial</strong></div>
                <div class="celda-info-preview-centro"><span>@Textos["PreviewCodigo"]</span><strong>@(string.IsNullOrEmpty(c.CodigoCentro) ? "—" : c.CodigoCentro)</strong></div>
                <div class="celda-info-preview-centro"><span>@Textos["PreviewCumplimiento"]</span><strong>@(c.CumplimientoPorcentaje is { } p ? $"{p}%" : "—")</strong></div>
                <div class="celda-info-preview-centro"><span>@Textos["PreviewVencidos"]</span><strong>@c.Recuentos.TotalVencidas</strong></div>
                <div class="celda-info-preview-centro"><span>@Textos["PreviewProximos"]</span><strong>@c.Recuentos.TotalProximas</strong></div>
            </div>

            <div class="bloque-preview-centro">
                <span class="titulo-bloque-preview-centro">@Textos["PreviewVisitas"]</span>
                @if (Visitas.Count == 0)
                {
                    <span class="vacio-preview-centro">@Textos["PreviewSinVisitas"]</span>
                }
                else
                {
                    @foreach (var v in Visitas)
                    {
                        <span class="linea-visita-preview-centro">@Textos["PreviewVisitaLinea", v.FechaInicio.ToString("dd/MM"), v.FechaFin.ToString("dd/MM"), v.TrabajadoresCount]</span>
                    }
                }
            </div>

            <button type="button" class="enlace-panel-preview-centro" @onclick="AbrirPanelAsync">@Textos["PreviewAbrirPanel"] →</button>
        </div>

        <div class="pie-preview-centro">
            <Boton OnClick="AbrirFichaAsync">@Textos["PreviewAbrirFicha"]</Boton>
        </div>
    </aside>
}

@code {
    [Parameter] public CentroListaDto? Centro { get; set; }
    [Parameter] public IReadOnlyList<VisitaResumenDto> Visitas { get; set; } = [];
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>«Abrir ficha 360» del pie: cierra la vista previa y lleva a /centros/{id}; lo resuelve quien monta el drawer.</summary>
    [Parameter] public EventCallback<Guid> OnAbrirFicha { get; set; }

    /// <summary>«Abrir panel de detalles»: cierra la vista previa y abre el panel de 520 px del centro.</summary>
    [Parameter] public EventCallback<CentroListaDto> OnAbrirPanel { get; set; }

    private Task Cerrar() => VisibleChanged.InvokeAsync(false);

    private async Task AbrirFichaAsync()
    {
        if (Centro is not { } centro) return;
        await VisibleChanged.InvokeAsync(false);
        await OnAbrirFicha.InvokeAsync(centro.Id);
    }

    private async Task AbrirPanelAsync()
    {
        if (Centro is not { } centro) return;
        await VisibleChanged.InvokeAsync(false);
        await OnAbrirPanel.InvokeAsync(centro);
    }
}
