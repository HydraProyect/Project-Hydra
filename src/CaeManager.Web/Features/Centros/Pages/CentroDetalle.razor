@using CaeManager.Application.Centros.Queries.ObtenerDocumentacionEmpresasDeCentro
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@*
    Centro 360 (Centro 360 TALVEG, Parte XVI PROMPT 13) — ver comentario de
    cabecera en el .razor.cs para el porqué de lo que esta página NO
    reimplementa.
*@
@page "/centros/{CentroId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Centros
@using CaeManager.Application.Centros.Queries.ObtenerCanalesGestionDeCentro
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Integraciones
@using CaeManager.Domain.Centros
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosCentros> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.Nombre ?? "Centro") — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["RutaCentro360"]" />

    @if (_noEncontrada)
    {
        <Tarjeta>
            <FichaNoEncontrada RutaLista="/centros" />
        </Tarjeta>
    }
    else if (_error)
    {
        <Tarjeta>
            <EstadoVacio Titulo="@Textos["ErrorCargarCentro360"]" Descripcion="@Textos["ReintentarCentroDescripcion360"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Textos["ReintentarCentro360"]</Boton>
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_cargando)
    {
        <Tarjeta>
            <EstadoCargando Filas="5" />
        </Tarjeta>
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera de identidad en tarjeta (Centro 360 TALVEG del 17-10): el anillo a la izquierda, el nombre y, bajo él, SOLO el
            Cliente empresarial (rotulado «Cliente», CONTRATO_TERMINOLOGIA § 3.2), el número de Trabajadores y la pastilla con el
            estado del Centro. Fuera, por maqueta: el rótulo «Centro» sobre el nombre, la Empresa, la visita siguiente y las
            pastillas de motivos (vencidos, pendientes, bloqueos, por vencer).
            El NOMBRE del Cliente abre su consulta rápida (panel de 520 px) y el icono 360 de al lado lleva a su página
            (/clientes/{id}): decisión del propietario 2026-09-22, con el orden de la maqueta del 17-10.
        *@
        @* P1-X2: un Centro sin gestión CAE no tiene cumplimiento que medir; el anillo vacío se leería como 0 %.
           Sin anillo la ranura va a null, para que la tarjeta no reserve su hueco. *@
        <CabeceraIdentidad Titulo="@_detalle.Nombre"
                           Anillo="@(_detalle.GestionCae != ModalidadGestionCae.SinGestionCae ? AnilloDeCabecera : null)">
            <Datos>
                <span>
                    <button type="button" class="enlace-nombre-fila centro360-contraparte" title="@Textos["ConsultaRapida360"]" @onclick="AbrirClienteEmpresarial">@_detalle.ClienteRazonSocial</button>
                    <Boton360 Nombre="@_detalle.ClienteRazonSocial" Href="@($"/clientes/{_detalle.ClienteId}")" />
                </span>
                @if (_numeroTrabajadores is { } numero)
                {
                    <span>· @Textos[numero == 1 ? "TrabajadorAsignado360" : "TrabajadoresAsignados360", numero] ·</span>
                }
                @if (_resumen is not null)
                {
                    @* Una sola pastilla con el estado del Centro (la maqueta no lleva las de motivos). P1-X2: SinGestionCae es neutro, nunca un verde falso. *@
                    <span class="centro360-indicadores">
                        <Badge Tono="EstadoCentroUi.Tono(_resumen.Estado, _resumen.CumplimientoPorcentaje)" Tamano="TamanoBadge.Pequeno">@EstadoCentroUi.Texto(_resumen.Estado, _resumen.CumplimientoPorcentaje)</Badge>
                    </span>
                }
            </Datos>
            <Acciones>
                @* Lleva a /visitas con el Drawer de alta abierto (CrearVisitaCommand, denegado a Consulta). *@
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="ProgramarVisita">@Textos["ProgramarVisitaCentro"]</Boton></SoloConEscritura>
                @*
                    El resto de acciones, en el menú «⋯» del mockup. «Reclamar
                    documentación» remite al panel a propósito (ver doc de la
                    clase): el drawer de confirmación vive allí y ese segundo
                    paso es deliberado (Project-Hydra-Negocio/tecnico/docs/COMUNICACIONES.md § 16.3, "siempre
                    confirmar"). Lo que sí se decide aquí es SI hay algo que
                    reclamar, para no ofrecer una acción sin objeto.
                *@
                <MenuAcciones>
                    <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">@Textos["EditarCentro360"]</ItemMenuAccion></SoloConEscritura>
                    @if (_detalle.FichaVisible)
                    {
                        <SoloConEscritura><ItemMenuAccion OnClick="() => _editarFichaVisible = true">@Textos["FichaEditarTitulo"]</ItemMenuAccion></SoloConEscritura>
                    }
                    @if (_documentosPorReclamar > 0)
                    {
                        @* Reclamar envía un mensaje (EnviarReclamacionCommand): es escritura, y a Consulta no se le ofrece. *@
                        <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">@Textos["ReclamarDocumentacionCentro360", _documentosPorReclamar]</ItemMenuAccion></SoloConEscritura>
                    }
                    <ItemMenuAccion OnClick="GenerarInformeDelCentro">@Textos["GenerarInformeCentro360"]</ItemMenuAccion>
                    <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => _confirmarEliminarVisible = true">@Textos["DarBajaCentro360"]</ItemMenuAccion></SoloConEscritura>
                </MenuAcciones>
            </Acciones>
        </CabeceraIdentidad>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral360"]">
            <ChildContent>
                <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestana" PestanaActivaChanged="CambiarPestana"
                          EtiquetaGrupo="@Textos["EtiquetaGrupoPestanas"]">
                    @* Conservar la instancia mantiene filtros, selección y filas expandidas sin recargar al cambiar de pestaña. *@
                    <div hidden="@(_pestana != PestanaTrabajadores)">
                        <AcordeonAsignacionesCentro CentroId="_detalle.Id" CentroNombre="@_detalle.Nombre"
                                                      VisitaId="_visitas.Count > 0 ? _visitas[0].VisitaId : null"
                                                      VisitaFechaFin="_visitas.Count > 0 ? _visitas[0].FechaFin : null"
                                                      EmpresaId="_detalle.EmpresaId" EmpresaNombre="@_detalle.EmpresaRazonSocial"
                                                      SoloIncidencias="false"
                                                      FiltroTexto="@_busqueda" FiltroEstado="@_estadoFiltro" FiltroEstadoChanged="CambiarEstado"
                                                      OnResumenCargado="ActualizarResumenTrabajadores"
                                                      MostrarTotales="true" MostrarEstadoPlataforma="true" NombrePlataforma="@NombrePlataformaCentro"
                                                      Bloqueos="_bloqueos"
                                                      OnCambio="CargarAsync">
                            <Busqueda>
                                @*
                                    Barra de trabajo del mockup (data-workbar). Filtra client-side lo
                                    que el acordeón ya cargó —ninguna consulta nueva— y los dos filtros
                                    viajan en la URL para que un centro filtrado se pueda enlazar.
                                *@
                                <div class="barra-filtros" hidden="@(_pestana != PestanaTrabajadores)">
                                    <CampoTexto Placeholder="@Textos["BuscarTrabajadorCentro360"]" Valor="@_busqueda" ValorChanged="Buscar" />
                                    @if (HayFiltrosActivos)
                                    {
                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="LimpiarFiltros">@Textos["LimpiarFiltrosCentro360"]</Boton>
                                    }
                                </div>
                            </Busqueda>
                        </AcordeonAsignacionesCentro>
                    </div>
                    @if (_pestana == PestanaVisitas)
                    {
                        @if (_visitas.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["VacioVisitasTitulo"]" Descripcion="@Textos["VacioVisitasDescripcion"]">
                                <Accion>
                                    <SoloConEscritura>
                                        <Boton Variante="VarianteBoton.Secundario" OnClick="ProgramarVisita"
                                               aria-label="@Textos["ProgramarVisitaCentroAccesible"]">@Textos["ProgramarVisitaCentro"]</Boton>
                                    </SoloConEscritura>
                                </Accion>
                            </EstadoVacio>
                        }
                        else
                        {
                            <div class="centro-visitas-lista">
                                <ListaLateral>
                                    @foreach (var visita in VisitasParaMostrar)
                                    {
                                        <ElementoListaLateral @key="visita.VisitaId">
                                            <Etiqueta>
                                                <span>@visita.FechaInicio.ToString("dd/MM/yyyy") – @visita.FechaFin.ToString("dd/MM/yyyy")</span>
                                                <Boton360 Nombre="@($"{_detalle.Nombre} · {visita.FechaInicio:dd/MM/yyyy} – {visita.FechaFin:dd/MM/yyyy}")" Href="@($"/visitas/{visita.VisitaId}")" />
                                            </Etiqueta>
                                            <ChildContent><span>@Textos[visita.TrabajadoresCount == 1 ? "VisitaTrabajador" : "VisitaTrabajadores", visita.TrabajadoresCount]</span></ChildContent>
                                        </ElementoListaLateral>
                                    }
                                </ListaLateral>
                            </div>
                        }
                    }
                    @if (_pestana is PestanaDocumentacionCentro or PestanaRequisitos)
                    {
                        @if (_cargandoLecturasFase2)
                        {
                            <EstadoCargando Filas="3" />
                        }
                        else if (_errorLecturasFase2)
                        {
                            <EstadoVacio Titulo="@Textos["LecturaCentroError360"]" />
                        }
                        else if (_pestana == PestanaDocumentacionCentro)
                        {
                            @if (_documentacionEmpresas.Count == 0)
                            {
                                <EstadoVacio Titulo="@Textos[_detalle.GestionCae == ModalidadGestionCae.SinGestionCae ? "DocumentacionCentroSinGestion360" : "DocumentacionCentroSinEmpresas360"]" />
                            }
                            @if (_documentacionEmpresas.Count > 0)
                            {
                                <p class="centro-documentacion-intro">@(NombrePlataformaCentro is { } plataformaIntro ? Textos["DocumentacionEmpresaIntroNombre360", plataformaIntro] : Textos["DocumentacionEmpresaIntro360"])</p>
                                <div class="centro-documentacion-tabla" role="table" aria-label="@Textos["DocumentacionEmpresaTabla360"]">
                                    <div class="centro-documentacion-cabecera" role="row">
                                        <span role="columnheader">@Textos["DocumentoNombre360"]</span>
                                        <span role="columnheader">@(NombrePlataformaCentro is { } plataformaCabecera ? Textos["PlataformaEstadoCabeceraNombre360", plataformaCabecera] : Textos["PlataformaEstadoCabecera360"])</span>
                                        <span role="columnheader">@Textos["PlataformaCaducidad360"]</span>
                                        <span role="columnheader">@Textos["PlataformaBloquea360"]</span>
                                        <span role="columnheader" class="cabecera-accion-plataforma">@Textos["AccionColumna360"]</span>
                                    </div>
                                    @{ var clavesDocumentos = new ClavesDeHermanos(); }
                                    @* Como la maqueta del 20-10: una sola lista, lo que bloquea primero y luego lo pendiente de validar. *@
                                    @foreach (var (empresa, documento) in DocumentosEmpresaOrdenados.Where(x => !x.Empresa.DesdeRelacionSubcontrata))
                                    {
                                        @FilaDocumentoEmpresa((empresa, documento, clavesDocumentos))
                                    }
                                    @*
                                        Bloque 4 del 21-10: la documentación de cada Empresa subcontratada (Subcontrata) va en un
                                        desplegable propio, plegado por defecto, tras la de las Empresas del Centro. Misma cabecera que
                                        «Agrupar» (#1570) y el mismo «Ver los N restantes» de las filas largas.
                                    *@
                                    @foreach (var subcontrata in SubcontratasConDocumentos)
                                    {
                                        var claveSubcontrata = "docs:" + subcontrata.EmpresaId;
                                        var subcontrataAbierta = _subcontratasAbiertas.EstaAbierto(claveSubcontrata);
                                        <div role="row" class="centro-documentacion-grupo" @key="clavesDocumentos.De(claveSubcontrata)" data-subcontrata-docs>
                                            <div role="cell">
                                                <CabeceraGrupoLista Nombre="@subcontrata.Nombre" Total="subcontrata.Documentos.Count"
                                                                    Incidencias="subcontrata.Documentos.Count(DocumentoConIncidencia)"
                                                                    Abierto="subcontrataAbierta" OnAlternar="() => _subcontratasAbiertas.Alternar(claveSubcontrata)" />
                                            </div>
                                        </div>
                                        @if (subcontrataAbierta)
                                        {
                                            var documentosSubcontrata = subcontrata.Documentos.OrderBy(OrdenDocumentoSubcontrata).ToList();
                                            @foreach (var documento in VerRestantes.Recortar(documentosSubcontrata, _subcontratasCompletas.Contains(subcontrata.EmpresaId)))
                                            {
                                                @FilaDocumentoEmpresa((subcontrata, documento, clavesDocumentos))
                                            }
                                            <div role="row"><div role="cell">
                                                <VerRestantes Total="documentosSubcontrata.Count" Completa="_subcontratasCompletas.Contains(subcontrata.EmpresaId)"
                                                          OnVerRestantes="() => _subcontratasCompletas.Add(subcontrata.EmpresaId)" />
                                            </div></div>
                                        }
                                    }
                                    @foreach (var empresaSinDocumentos in _documentacionEmpresas.Where(e => e.Documentos.Count == 0))
                                    {
                                        <EstadoVacio @key="empresaSinDocumentos.EmpresaId" Titulo="@Textos["DocumentacionCentroSinExigidos360"]" />
                                    }
                                </div>
                            }
                        }
                        else if (_requisitosCentro.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["RequisitosCentroVacio360"]" />
                        }
                        else
                        {
                            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["PestanaRequisitos360"]">
                                @foreach (var requisito in _requisitosCentro)
                                {
                                    <FilaRelacion @key="requisito.TipoDocumentoId" Nombre="@requisito.Nombre">
                                        <Detalle>
                                            @Textos[requisito.AmbitoAplicacion == AmbitoAplicacion.Empresa ? "RequisitoCentroEmpresa360" : "RequisitoCentroTrabajador360"]
                                            · @Textos["RequisitoCentroTolerancia360", ReglaBloqueoDeAcceso.ResolverToleranciaDias(requisito.ToleranciaDias, requisito.ToleranciaHeredadaDias)]
                                        </Detalle>
                                        <Estado>@Textos[requisito.BloqueaAcceso ? "RequisitoCentroBloquea360" : "RequisitoCentroNoBloquea360"]</Estado>
                                        <Acciones><Boton360 Nombre="@requisito.Nombre" OnClick="() => IrATipoDocumento(requisito.TipoDocumentoId)" /></Acciones>
                                    </FilaRelacion>
                                }
                            </ListaRelaciones>
                        }
                    }
                    <div class="centro-ficha-canales" hidden="@(_pestana != PestanaFicha)">
                        <CajasFicha @key="CentroId" Cajas="CajasDeFicha" ClaveOrden="@($"centro-{CentroId}")" />
                    </div>
                    @if (_pestana == PestanaHistorial)
                    {
                        <h3 class="centro-historial-titulo">@Textos["HistorialCambios360"]</h3>
                        @* En su propio contenedor: dos hermanos con la misma @key (CentroId) rompen el render. *@
                        <div class="centro-historial-plataforma">
                            <HistorialEstadoPlataformaCentro @key="CentroId" CentroId="CentroId" />
                        </div>
                        <PestanaHistorial @key="CentroId" EntidadTipo="Centro" EntidadId="CentroId" />
                    }
                </Pestanas>
            </ChildContent>
            <Lateral>
                <Tarjeta Compacta="true" Titulo="@Textos["InformacionTitulo360"]">
                    <AccionesHeader>
                        <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirInformacion">@Textos["EditarFlecha360"]</Boton></SoloConEscritura>
                    </AccionesHeader>
                    <ChildContent>
                        <RejillaDatos>
                            @if (!string.IsNullOrWhiteSpace(_detalle.CodigoCentro))
                            {
                                <DatoRejilla Etiqueta="@Textos["InformacionCodigo360"]"><BotonCopiar EnLinea="true" Valor="@_detalle.CodigoCentro" Texto="@_detalle.CodigoCentro" NombreAccesible="@Textos["FichaCopiarDato", Textos["InformacionCodigo360"]]" /></DatoRejilla>
                            }
                            <DatoRejilla Etiqueta="@Textos["InformacionCliente360"]" Valor="@_detalle.ClienteRazonSocial" />
                            @if (!string.IsNullOrWhiteSpace(_detalle.Direccion))
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaDireccionCentro"]" Ancho="true"><BotonCopiar EnLinea="true" Valor="@_detalle.Direccion" Texto="@_detalle.Direccion" NombreAccesible="@Textos["FichaCopiarDato", Textos["FichaDireccionCentro"]]" /></DatoRejilla>
                            }
                            @if (_detalle.FichaVisible && _detalle.HorarioAcceso is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaHorarioAcceso"]" Valor="@_detalle.HorarioAcceso" />
                            }
                            @* Maqueta del 20-10: Código · Cliente · Dirección · Horario de acceso · Alta; la Empresa del Centro ya no va en esta tarjeta. *@
                            @if (_detalle.CreadoEnUtc is { } alta)
                            {
                                <DatoRejilla Etiqueta="@Textos["InformacionAlta360"]" Valor="@alta.EnHoraPeninsular().ToString("dd/MM/yyyy")" />
                            }
                        </RejillaDatos>
                    </ChildContent>
                </Tarjeta>

                @* Nota interna: el servidor decide si el lector es del equipo (NotaInternaVisible); a un usuario de
                   Cliente no le llega ni la tarjeta vacía. *@
                @if (_detalle.NotaInternaVisible)
                {
                    <NotaInternaEditable @key="_detalle.Id" Texto="@_detalle.Notas" Guardar="GuardarNotaInternaAsync" OnGuardada="RecargarTrasNotaInternaAsync" />
                }
            </Lateral>
        </CuerpoConLateral>
    }
</div>

<DialogoConfirmacion Visible="_confirmarEliminarVisible"
                     VisibleChanged="v => _confirmarEliminarVisible = v"
                     Titulo="@Textos["EliminarCentroTitulo", _detalle?.Nombre ?? string.Empty].Value"
                     Mensaje="@Textos["EliminarCentroMensaje"].Value"
                     EnProgreso="_eliminando"
                     OnConfirmar="ConfirmarEliminarAsync" />
@if (_detalle is { FichaVisible: true })
{
    <SoloConEscritura><EditarFichaCentroDrawer CentroId="CentroId" Visible="_editarFichaVisible" VisibleChanged="v => _editarFichaVisible = v" OnGuardada="CargarAsync" /></SoloConEscritura>
}
</LimiteDeErrores>

@code {
    /// <summary>Una fila de la tabla de documentación de Empresa (la de una Empresa del Centro o la de una Subcontrata).</summary>
    private RenderFragment<(DocumentacionEmpresaCentroDto Empresa, DocumentoEmpresaCentroDto Documento, ClavesDeHermanos Claves)> FilaDocumentoEmpresa => fila => @<text>
        @{ var (empresa, documento, clavesDocumentos) = fila; }
                                            <div class="centro-documentacion-fila @(BloqueaPlataforma(documento) ? "centro-documentacion-bloquea" : documento.AcreditacionesEnElCentro?.Any(a => a.Estado == EstadoAcreditacion.Subida) == true ? "centro-documentacion-pendiente" : null)" role="row" @key="clavesDocumentos.De((empresa.EmpresaId, documento.TipoDocumentoId))">
                                                <span role="cell" class="centro-documentacion-identidad">
                                                    <span class="centro-documentacion-t" data-estado="@EstadoDocumentoFicha360.Tono(documento.Estado)" title="@Textos["PlataformaTalveg360", EstadoDocumentoFicha360.Texto(documento.Estado)]" aria-label="@Textos["PlataformaTalveg360", EstadoDocumentoFicha360.Texto(documento.Estado)]">T</span>
                                                    <span class="centro-documentacion-nombre">
                                                        <span>@documento.Nombre</span>
                                                        <span class="centro-documentacion-empresa">
                                                            <button type="button" class="enlace-nombre-fila" @onclick="() => AbrirEmpresaDocumentacion(empresa)">@empresa.Nombre</button>
                                                            <Boton360 Nombre="@empresa.Nombre" OnClick="() => IrAEmpresaDocumentacion(empresa)" />
                                                        </span>
                                                    </span>
                                                </span>
                                                <span role="cell" class="centro-documentacion-plataforma">
                                                    @if (documento.AcreditacionesEnElCentro is not { Count: > 0 })
                                                    {
                                                        @Textos["PlataformaSinDatos360"]
                                                    }
                                                    else
                                                    {
                                                        @foreach (var acreditacion in documento.AcreditacionesEnElCentro)
                                                        {
                                                            <Badge Tono="TonoPlataforma(acreditacion.Estado)" Tamano="TamanoBadge.Pequeno">@TextoPlataforma(acreditacion.Estado)</Badge>
                                                            <span>@acreditacion.NombrePlataforma</span>
                                                            <AnotacionEstadoPlataforma Acreditacion="acreditacion" />
                                                        }
                                                    }
                                                    <CaeManager.Web.Features.Documentos.Components.LineaPlataformaYReclamacion UltimaReclamacion="documento.UltimaReclamacion" Estado="documento.Estado" LaFilaYaDiceLaPlataforma="false" />
                                                </span>
                                                <span role="cell" class="centro-documentacion-fecha">
                                                    <TextoFechaCopiable Fecha="documento.FechaVencimiento" FechaEmision="documento.FechaEmision">@(documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</TextoFechaCopiable>
                                                </span>
                                                <span role="cell">@(documento.AcreditacionesEnElCentro is { Count: > 0 } ? Textos[BloqueaPlataforma(documento) ? "PlataformaBloqueaSi360" : "PlataformaBloqueaNo360"].Value : "—")</span>
                                                @* Columna «Acción» (bloque 3 del 21-10): el estado en la plataforma solo se cambia en Centro 360. *@
                                                <span role="cell" class="celda-accion-plataforma">
                                                    @if (documento.AcreditacionesEnElCentro is { Count: > 0 } acreditacionesAccion)
                                                    {
                                                        @foreach (var acreditacion in acreditacionesAccion)
                                                        {
                                                            <AccionEstadoPlataforma @key="acreditacion.Id" CentroId="CentroId" CentroNombre="@_detalle!.Nombre"
                                                                                    Acreditacion="acreditacion" DocumentoNombre="@documento.Nombre"
                                                                                    TitularNombre="@empresa.Nombre" OnCambio="RecargarTrasCambioPlataformaAsync" />
                                                        }
                                                    }
                                                </span>
                                            </div>
    </text>;

    private RenderFragment CanalesDeGestion => __builder =>
    {
        if (_detalle is not null)
        {
<Tarjeta Compacta="true" Titulo="@Textos["CanalesGestionCentro360"]">
                    <AccionesHeader>
                        <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPlataforma">@Textos["GestionarCanalesCentro360"]</Boton></SoloConEscritura>
                    </AccionesHeader>
                    <ChildContent>
                        @if (_detalle.GestionCae == ModalidadGestionCae.SinGestionCae)
                        {
                            <p class="texto-vacio-seccion centro360-sin-gestion-cae">@Textos["GestionCaeExplicacionCentro360"]</p>
                        }
                        else if (_cargandoCanales)
                        {
                            <EstadoCargando Filas="2" />
                        }
                        else if (_canales.Count == 0)
                        {
                            <p class="texto-vacio-seccion">@Textos["CanalesVacioCentro360"]</p>
                            <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPlataforma">@Textos["RegistrarCanal360"]</Boton></SoloConEscritura>
                        }
                        else
                        {
                            <ListaLateral>
                                @foreach (var canal in _canales)
                                {
                                    <ElementoListaLateral @key="canal.Id">
                                        <Etiqueta>
                                            <span>
                                                @(canal.Tipo == TipoCanalGestion.Plataforma
                                                    ? (canal.ProveedorPlataformaCaeNombre ?? Textos["PlataformaSinResolverCentro360"].Value)
                                                    : Textos["GestionCorreoCentro360"].Value)
                                                @if (canal.Tipo == TipoCanalGestion.Plataforma)
                                                {
                                                    <Badge Tono="@(canal.TieneCredenciales ? TonoBadge.Exito : TonoBadge.Neutro)" Tamano="TamanoBadge.Pequeno">
                                                        @(Textos[canal.TieneCredenciales ? "ConCredencialesCentro360" : "SinCredencialesCentro360"])
                                                    </Badge>
                                                }
                                            </span>
                                            @if (canal.EsPrincipal)
                                            {
                                                <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">@Textos["CanalPrincipalCentro360"]</Badge>
                                            }
                                        </Etiqueta>
                                        <ChildContent>
                                            <span>@canal.EtiquetaProposito</span>
                                            @if (!string.IsNullOrWhiteSpace(canal.UrlAcceso))
                                            {
                                                @*
                                                    La dirección del portal se ABRE, no se copia: el
                                                    Gestor CAE la abre en pestaña nueva y pega allí las
                                                    credenciales. Solo http(s): la URL es texto libre y
                                                    un javascript: en un href ejecutaría script. Si no
                                                    es navegable se enseña como texto, sin enlace.
                                                *@
                                                <span>
                                                    @if (UrlPortalCae.Normalizar(canal.UrlAcceso) is { } destino)
                                                    {
                                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                               Href="@destino" target="_blank" rel="noopener noreferrer"
                                                               title="@canal.UrlAcceso"
                                                               aria-label="@Textos["AbrirPortalCentroAccesible360", canal.UrlAcceso]">
                                                            @Textos["AbrirPortalCentro360"]
                                                        </Boton>
                                                    }
                                                    else
                                                    {
                                                        @canal.UrlAcceso
                                                    }
                                                </span>
                                            }
                                            @*
                                                Copiar lo que el canal sirve para pegar en otra
                                                parte. Usuario y contraseña no vienen en este
                                                DTO: se piden al servidor solo al pulsar
                                                (DEC-53/DEC-62) y no se pintan; cada lectura
                                                efectiva queda en la auditoría del Tenant
                                                propietario (ObtenerCredencialCanalGestionQuery).
                                                Y solo para roles con escritura (decisión
                                                2026-09-23): a Consulta el servidor le devuelve
                                                null, así que ni se le ofrece.
                                            *@
                                            @if (canal.Tipo == TipoCanalGestion.Plataforma && canal.TieneCredenciales)
                                            {
                                                <SoloConEscritura>
                                                    <span>
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, false)" Etiqueta="el usuario" Texto="Copiar usuario" />
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, true)" Etiqueta="la contraseña" Texto="Copiar contraseña" />
                                                    </span>
                                                </SoloConEscritura>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(canal.EmailsDestinatarios))
                                            {
                                                <span class="canal-aviso-visita">
                                                    <span>@Textos["ParaAvisarVisita360"] · @Textos["PorCorreo360"]</span>
                                                    @canal.EmailsDestinatarios
                                                    <BotonCopiar Valor="@canal.EmailsDestinatarios" Etiqueta="@Textos["DireccionCanalCentro360"]" />
                                                </span>
                                            }
                                        </ChildContent>
                                    </ElementoListaLateral>
                                }
                            </ListaLateral>
                        }
                    </ChildContent>
                </Tarjeta>
        }
    };

    private IReadOnlyList<CajaFicha> CajasDeFicha =>
    [
        new("canales-centro", CanalesDeGestion),
        new("contactos-centro", ContactosDeFicha),
        .. HayDatosBasicosFicha ? new CajaFicha[] { new("datos-centro", DatosDeFicha) } : [],
        .. MuestraCajaAcceso ? new CajaFicha[] { new("acceso-centro", AccesoDeFicha) } : [],
        .. MuestraCajaPrevencion ? new CajaFicha[] { new("prevencion-centro", PrevencionDeFicha) } : []
    ];

    private RenderFragment ContactosDeFicha => __builder =>
    {
        <Tarjeta Compacta="true" Titulo="@Textos["ContactosCentro360"]">
            @if (_pestana == PestanaFicha)
            {
                <PestanaAgendaContactos @key="CentroId" Tipo="CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos.TipoPropietarioAgenda.Centro" PropietarioId="CentroId" VacioCompacto="true" />
            }
        </Tarjeta>
    };

    private RenderFragment AccesoDeFicha => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaAccesoTitulo"]" Compacta="true">
                <AccionesHeader>
                    @if (detalle.FichaVisible && !AccesoSinConfigurar)
                    {
                        <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _editarFichaVisible = true">@Textos["FichaEditarAccion"]</Boton></SoloConEscritura>
                    }
                </AccionesHeader>
                <ChildContent>
                    @if (AccesoSinConfigurar)
                    {
                        <EstadoVacio Titulo="@Textos["FichaAccesoVacioTitulo"]" Descripcion="@Textos["FichaAccesoVacioDescripcion"]">
                            <Accion><SoloConEscritura><Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => _editarFichaVisible = true">@Textos["FichaConfigurarAccion"]</Boton></SoloConEscritura></Accion>
                        </EstadoVacio>
                    }
                    else
                    {
                        <RejillaDatos>
                            @if (!string.IsNullOrWhiteSpace(detalle.Direccion))
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaDireccionCentro"]"><BotonCopiar Valor="@detalle.Direccion" Texto="@detalle.Direccion" Etiqueta="@Textos["FichaDireccionCentro"]" NombreAccesible="@Textos["FichaCopiarDato", Textos["FichaDireccionCentro"]]" /></DatoRejilla>
                            }
                            @if (detalle.FichaVisible && detalle.HorarioAcceso is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaHorarioAcceso"]" Valor="@detalle.HorarioAcceso" />
                            }
                            @if (detalle.FichaVisible && detalle.ControlAccesosNombre is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaControlAccesosNombre"]" Valor="@detalle.ControlAccesosNombre" />
                            }
                            @if (detalle.FichaVisible && detalle.ControlAccesosTelefono is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaControlAccesosTelefono"]"><BotonCopiar Valor="@detalle.ControlAccesosTelefono" Texto="@detalle.ControlAccesosTelefono" Etiqueta="@Textos["FichaControlAccesosTelefono"]" NombreAccesible="@Textos["FichaCopiarDato", Textos["FichaControlAccesosTelefono"]]" /></DatoRejilla>
                            }
                        </RejillaDatos>
                    }
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment PrevencionDeFicha => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaPrevencionTitulo"]" Compacta="true">
                <AccionesHeader>
                    @if (!PrevencionSinConfigurar)
                    {
                        <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _editarFichaVisible = true">@Textos["FichaEditarAccion"]</Boton></SoloConEscritura>
                    }
                </AccionesHeader>
                <ChildContent>
                    @if (PrevencionSinConfigurar)
                    {
                        <EstadoVacio Titulo="@Textos["FichaPrevencionVacioTitulo"]" Descripcion="@Textos["FichaPrevencionVacioDescripcion"]">
                            <Accion><SoloConEscritura><Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => _editarFichaVisible = true">@Textos["FichaConfigurarAccion"]</Boton></SoloConEscritura></Accion>
                        </EstadoVacio>
                    }
                    else
                    {
                        <RejillaDatos>
                            @if (detalle.TecnicoPrevencionNombre is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrevencionNombre"]" Valor="@detalle.TecnicoPrevencionNombre" />
                            }
                            @if (detalle.TecnicoPrevencionTelefono is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrevencionTelefono"]"><BotonCopiar Valor="@detalle.TecnicoPrevencionTelefono" Texto="@detalle.TecnicoPrevencionTelefono" Etiqueta="@Textos["FichaTecnicoPrevencionTelefono"]" NombreAccesible="@Textos["FichaCopiarDato", Textos["FichaTecnicoPrevencionTelefono"]]" /></DatoRejilla>
                            }
                            @if (detalle.TecnicoPrevencionCorreo is not null)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrevencionCorreo"]"><BotonCopiar Valor="@detalle.TecnicoPrevencionCorreo" Texto="@detalle.TecnicoPrevencionCorreo" Etiqueta="@Textos["FichaTecnicoPrevencionCorreo"]" NombreAccesible="@Textos["FichaCopiarDato", Textos["FichaTecnicoPrevencionCorreo"]]" /></DatoRejilla>
                            }
                            @if (detalle.TrabajosEnAltura is { } valorTrabajosEnAltura)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaTrabajosEnAltura"]" Valor="@Textos[valorTrabajosEnAltura ? "FichaSi" : "FichaNo"]" />
                            }
                            @if (detalle.EspaciosConfinados is { } valorEspaciosConfinados)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaEspaciosConfinados"]" Valor="@Textos[valorEspaciosConfinados ? "FichaSi" : "FichaNo"]" />
                            }
                            @if (detalle.AtmosferasExplosivas is { } valorAtmosferasExplosivas)
                            {
                                <DatoRejilla Etiqueta="@Textos["FichaAtmosferasExplosivas"]" Valor="@Textos[valorAtmosferasExplosivas ? "FichaSi" : "FichaNo"]" />
                            }
                        </RejillaDatos>
                    }
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment DatosDeFicha => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaDatosCentro"]" Compacta="true">
                <RejillaDatos>
                    @if (!string.IsNullOrWhiteSpace(detalle.CodigoCentro))
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaCodigoCentro"]" Valor="@detalle.CodigoCentro" />
                    }
                    @if (!string.IsNullOrWhiteSpace(detalle.Contacto))
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaContactoCentro"]" Valor="@detalle.Contacto" />
                    }
                    @if (detalle.ContratoVigenteHasta is { } hasta)
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaContratoHasta360"]" Valor="@hasta.ToString("dd/MM/yyyy")" />
                    }
                </RejillaDatos>
            </Tarjeta>
        }
    };

    private RenderFragment AnilloDeCabecera => @<AnilloCumplimiento Porcentaje="_resumen?.CumplimientoPorcentaje" Tamano="TamanoAnillo.Cabecera"
                                                                    Etiqueta="@($"{_resumen?.CumplimientoPorcentaje}% de cumplimiento — documentos al día / requeridos entre los trabajadores de este centro")" />;
}
