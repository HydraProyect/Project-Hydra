@using CaeManager.Application.Centros.Queries.ObtenerDocumentacionEmpresasDeCentro
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@*
    Centro 360 (Centro 360 TALVEG, Parte XVI PROMPT 13) — ver comentario de
    cabecera en el .razor.cs para el porqué de lo que esta página NO
    reimplementa.
*@
@page "/centros/{CentroId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Centros
@using CaeManager.Application.Centros.Queries.ObtenerCanalesGestionDeCentro
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Integraciones
@using CaeManager.Domain.Centros
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosCentros> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.Nombre ?? "Centro") — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="Ruta de Centro 360" />

    @if (_error)
    {
        <Tarjeta>
            <EstadoVacio Titulo="No pudimos cargar este centro" Descripcion="Puede que ya no exista o que no tengas acceso.">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
                    <EnlaceProfundoOtraEmpresa />
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_cargando)
    {
        <Tarjeta>
            <EstadoCargando Filas="5" />
        </Tarjeta>
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera de identidad en tarjeta (CabeceraIdentidad, la pieza de
            las fichas 360): el anillo a la izquierda, qué es («Centro»), el
            nombre, lo que califica al centro «junto al título», la identidad
            de sus contrapartes en la línea de datos y a la derecha la acción
            principal con el resto en un menú.

            Contrapartes (decisión del propietario 2026-09-22: cada 360 tiene
            página propia además del panel): el NOMBRE es un enlace real a la
            página 360 del Cliente empresarial (/clientes/{id}) y de la Empresa
            (/empresas/{id}), y el botón 360 de al lado abre su panel de 520 px
            como antes lo hacía el nombre. En pantalla el Cliente empresarial
            se rotula «Cliente» (CONTRATO_TERMINOLOGIA § 3.2; decisión de rótulo del 2026-10-09); en código sigue siendo
            ClienteEmpresarial.
        *@
        @* P1-X2: un Centro sin gestión CAE no tiene cumplimiento que medir; el anillo vacío se leería como 0 %.
           Sin anillo la ranura va a null, para que la tarjeta no reserve su hueco. *@
        <CabeceraIdentidad Titulo="@_detalle.Nombre" Kicker="@Textos["KickerCentro360"]"
                           Anillo="@(_detalle.GestionCae != ModalidadGestionCae.SinGestionCae ? AnilloDeCabecera : null)">
            <Datos>
                @* Cada contraparte es un bloque: la línea de datos es flex y separaría el rótulo de su nombre. *@
                <span>
                    @Textos["CabeceraCliente"] <a class="enlace-nombre-fila centro360-contraparte" href="@($"/clientes/{_detalle.ClienteId}")">@_detalle.ClienteRazonSocial</a>
                    <Boton360 Nombre="@_detalle.ClienteRazonSocial" OnClick="AbrirClienteEmpresarial" />
                </span>
                <span>
                    @Textos["CabeceraEmpresa"] <a class="enlace-nombre-fila centro360-contraparte" href="@($"/empresas/{_detalle.EmpresaId}")">@_detalle.EmpresaRazonSocial</a>
                    <Boton360 Nombre="@_detalle.EmpresaRazonSocial" OnClick="AbrirEmpresa" />
                </span>
                @if (_numeroTrabajadores is { } numero)
                {
                    <span>· @Textos[numero == 1 ? "TrabajadorAsignado360" : "TrabajadoresAsignados360", numero]</span>
                }
            </Datos>
            <JuntoAlTitulo>
                @if (_resumen is not null)
                {
                    <span class="centro360-indicadores">
                        @if (_resumen.Estado == EstadoCentro.Bloqueado)
                        {
                            @* Solo lo causa la plataforma del Cliente empresarial (D-7): el bloqueo de un documento es del Trabajador. *@
                            <Badge Tono="TonoBadge.Peligro">@EstadoCentroUi.Texto(EstadoCentro.Bloqueado)</Badge>
                        }
                        @if (_bloqueos.Count > 0)
                        {
                            var trabajadoresBloqueados = TextoBloqueoDeAcceso.TrabajadoresBloqueados(_bloqueos);
                            var tituloBloqueados = TextoBloqueoDeAcceso.Titulo(Textos, trabajadoresBloqueados);
                            <VentanaContexto Etiqueta="@tituloBloqueados" Titulo="@Textos["BloqueadosEncabezado"].Value">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" ConIcono="true">@tituloBloqueados</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var bloqueo in _bloqueos)
                                    {
                                        <span class="ventana-linea">@TextoBloqueoDeAcceso.Linea(Textos, bloqueo)</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Estado == EstadoCentro.SinGestionCae)
                        {
                            @* P1-X2: estado propio y tono neutro — nunca un verde falso. *@
                            <Badge Tono="EstadoCentroUi.Tono(EstadoCentro.SinGestionCae)">@EstadoCentroUi.Texto(EstadoCentro.SinGestionCae)</Badge>
                        }
                        @if (_resumen.Recuentos.VencidasPorFecha.Count > 0)
                        {
                            <VentanaContexto Etiqueta="@EtiquetaDeMotivo((_resumen.Recuentos.VencidasPorFecha.Count == 1 ? Textos["MotivoUnVencido"] : Textos["MotivoVencidos", _resumen.Recuentos.VencidasPorFecha.Count]).Value, _resumen.Recuentos.VencidasPorFecha, "vencido")"
                                             Titulo="@($"{_resumen.Recuentos.VencidasPorFecha.Count} {(_resumen.Recuentos.VencidasPorFecha.Count == 1 ? "documento vencido" : "documentos vencidos")}")">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@(_resumen.Recuentos.VencidasPorFecha.Count == 1 ? Textos["MotivoUnVencido"] : Textos["MotivoVencidos", _resumen.Recuentos.VencidasPorFecha.Count])</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.VencidasPorFecha)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Recuentos.Pendientes.Count > 0)
                        {
                            <VentanaContexto Etiqueta="@EtiquetaDeMotivo((_resumen.Recuentos.Pendientes.Count == 1 ? Textos["MotivoUnPendiente"] : Textos["MotivoPendientes", _resumen.Recuentos.Pendientes.Count]).Value, _resumen.Recuentos.Pendientes, Textos["CalificativoPendiente"].Value)"
                                             Titulo="@(_resumen.Recuentos.Pendientes.Count == 1 ? Textos["TituloUnPendiente"].Value : Textos["TituloPendientes", _resumen.Recuentos.Pendientes.Count].Value)">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@(_resumen.Recuentos.Pendientes.Count == 1 ? Textos["MotivoUnPendiente"] : Textos["MotivoPendientes", _resumen.Recuentos.Pendientes.Count])</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Pendientes)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Recuentos.Bloqueos.Count > 0)
                        {
                            <VentanaContexto Etiqueta="@EtiquetaDeMotivo((_resumen.Recuentos.Bloqueos.Count == 1 ? Textos["MotivoUnBloqueo"] : Textos["MotivoBloqueos", _resumen.Recuentos.Bloqueos.Count]).Value, _resumen.Recuentos.Bloqueos, Textos["CalificativoBloqueo"].Value)"
                                             Titulo="@(_resumen.Recuentos.Bloqueos.Count == 1 ? Textos["TituloUnBloqueo"].Value : Textos["TituloBloqueos", _resumen.Recuentos.Bloqueos.Count].Value)">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@(_resumen.Recuentos.Bloqueos.Count == 1 ? Textos["MotivoUnBloqueo"] : Textos["MotivoBloqueos", _resumen.Recuentos.Bloqueos.Count])</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Bloqueos)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Recuentos.TotalProximas > 0)
                        {
                            <VentanaContexto Etiqueta="@EtiquetaDeMotivo((_resumen.Recuentos.TotalProximas == 1 ? Textos["MotivoUnProximo"] : Textos["MotivoProximos", _resumen.Recuentos.TotalProximas]).Value, _resumen.Recuentos.Proximas, "próximo a vencer")"
                                             Titulo="@($"{_resumen.Recuentos.TotalProximas} {(_resumen.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">@(_resumen.Recuentos.TotalProximas == 1 ? Textos["MotivoUnProximo"] : Textos["MotivoProximos", _resumen.Recuentos.TotalProximas])</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Proximas)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                    </span>
                }
            </JuntoAlTitulo>
            <Acciones>
                @* Lleva a /visitas con el Drawer de alta abierto (CrearVisitaCommand, denegado a Consulta). *@
                <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" OnClick="ProgramarVisita">Programar visita</Boton></SoloConEscritura>
                @*
                    El resto de acciones, en el menú «⋯» del mockup. «Reclamar
                    documentación» remite al panel a propósito (ver doc de la
                    clase): el drawer de confirmación vive allí y ese segundo
                    paso es deliberado (Project-Hydra-Negocio/tecnico/docs/COMUNICACIONES.md § 16.3, "siempre
                    confirmar"). Lo que sí se decide aquí es SI hay algo que
                    reclamar, para no ofrecer una acción sin objeto.
                *@
                <MenuAcciones>
                    <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">Editar centro</ItemMenuAccion></SoloConEscritura>
                    <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => _confirmarEliminarVisible = true">@Textos["MenuEliminarCentro"]</ItemMenuAccion></SoloConEscritura>
                    @if (_documentosPorReclamar > 0)
                    {
                        @* Reclamar envía un mensaje (EnviarReclamacionCommand): es escritura, y a Consulta no se le ofrece. *@
                        <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">Reclamar documentación (@_documentosPorReclamar)</ItemMenuAccion></SoloConEscritura>
                    }
                    <ItemMenuAccion OnClick="GenerarInformeDelCentro">Generar informe del centro</ItemMenuAccion>
                </MenuAcciones>
            </Acciones>
        </CabeceraIdentidad>

        @*
            Barra de trabajo del mockup (data-workbar). Filtra client-side lo
            que el acordeón ya cargó —ninguna consulta nueva— y los dos filtros
            viajan en la URL para que un centro filtrado se pueda enlazar.
        *@
        <div class="barra-filtros" hidden="@(_pestana != PestanaTrabajadores)">
            <CampoTexto Placeholder="Buscar trabajador en este centro…" Valor="@_busqueda" ValorChanged="Buscar" />
            @if (HayFiltrosActivos)
            {
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="LimpiarFiltros">Limpiar filtros</Boton>
            }
        </div>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral360"]">
            <ChildContent>
                <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestana" PestanaActivaChanged="CambiarPestana"
                          EtiquetaGrupo="@Textos["EtiquetaGrupoPestanas"]">
                    @* Conservar la instancia mantiene filtros, selección y filas expandidas sin recargar al cambiar de pestaña. *@
                    <div hidden="@(_pestana != PestanaTrabajadores)">
                        <AcordeonAsignacionesCentro CentroId="_detalle.Id" CentroNombre="@_detalle.Nombre"
                                                      VisitaId="_visitas.Count > 0 ? _visitas[0].VisitaId : null"
                                                      VisitaFechaFin="_visitas.Count > 0 ? _visitas[0].FechaFin : null"
                                                      EmpresaId="_detalle.EmpresaId" EmpresaNombre="@_detalle.EmpresaRazonSocial"
                                                      IncidenciasEmpresa="IncidenciasEmpresaHeader"
                                                      SoloIncidencias="false"
                                                      FiltroTexto="@_busqueda" FiltroEstado="@_estadoFiltro" FiltroEstadoChanged="CambiarEstado"
                                                      OnResumenCargado="ActualizarResumenTrabajadores"
                                                      MostrarTotales="true"
                                                      Bloqueos="_bloqueos"
                                                      OnCambio="CargarAsync" />
                    </div>
                    @if (_pestana == PestanaVisitas)
                    {
                        @if (_visitas.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["VacioVisitasTitulo"]" Descripcion="@Textos["VacioVisitasDescripcion"]">
                                <Accion>
                                    <SoloConEscritura>
                                        <Boton Variante="VarianteBoton.Secundario" OnClick="ProgramarVisita"
                                               aria-label="@Textos["ProgramarVisitaCentroAccesible"]">@Textos["ProgramarVisitaCentro"]</Boton>
                                    </SoloConEscritura>
                                </Accion>
                            </EstadoVacio>
                        }
                        else
                        {
                            <Tarjeta Titulo="@Textos["VisitasActivasTitulo"]">
                                <ListaLateral>
                                    @foreach (var visita in VisitasParaMostrar)
                                    {
                                        <ElementoListaLateral @key="visita.VisitaId">
                                            <Etiqueta>@visita.FechaInicio.ToString("dd/MM/yyyy") – @visita.FechaFin.ToString("dd/MM/yyyy")</Etiqueta>
                                            <ChildContent><span>@Textos[visita.TrabajadoresCount == 1 ? "VisitaTrabajador" : "VisitaTrabajadores", visita.TrabajadoresCount]</span></ChildContent>
                                        </ElementoListaLateral>
                                    }
                                </ListaLateral>
                            </Tarjeta>
                        }
                    }
                    @if (_pestana is PestanaDocumentacionCentro or PestanaRequisitos)
                    {
                        @if (_cargandoLecturasFase2)
                        {
                            <EstadoCargando Filas="3" />
                        }
                        else if (_errorLecturasFase2)
                        {
                            <EstadoVacio Titulo="@Textos["LecturaCentroError360"]" />
                        }
                        else if (_pestana == PestanaDocumentacionCentro)
                        {
                            @if (_documentacionEmpresas.Count == 0)
                            {
                                <EstadoVacio Titulo="@Textos[_detalle.GestionCae == ModalidadGestionCae.SinGestionCae ? "DocumentacionCentroSinGestion360" : "DocumentacionCentroSinEmpresas360"]" />
                            }
                            @if (_documentacionEmpresas.Any(e => e.Documentos.Count > 0))
                            {
                                <CampoTexto Etiqueta="@Textos["BuscarDocumentacionCentro360"]" Valor="@_busquedaDocumentacionCentro" ValorChanged="v => _busquedaDocumentacionCentro = v" />
                                <FranjaEstado Opciones="OpcionesDocumentacionCentro" Valor="@_estadosDocumentacionCentro" ValorChanged="v => _estadosDocumentacionCentro = v"
                                               Recuentos="RecuentosDocumentacionCentro" EtiquetaAccesible="@Textos["FiltrarDocumentacionCentro360"]" />
                            }
                            @foreach (var empresa in _documentacionEmpresas)
                            {
                                var documentosVisibles = DocumentosParaMostrar(empresa);
                                <Tarjeta @key="empresa.EmpresaId" Titulo="@Textos["DocumentacionCentroExigeA360"]">
                                    <AccionesHeader>
                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEmpresaDocumentacion(empresa)">@empresa.Nombre</Boton>
                                        <Boton360 Nombre="@empresa.Nombre" OnClick="() => IrAEmpresaDocumentacion(empresa)" />
                                    </AccionesHeader>
                                    <ChildContent>
                                        @if (empresa.Documentos.Count == 0)
                                        {
                                            <EstadoVacio Titulo="@Textos["DocumentacionCentroSinExigidos360"]" />
                                        }
                                        else if (documentosVisibles.Count == 0)
                                        {
                                            <EstadoVacio Titulo="@Textos["DocumentacionCentroFiltroVacio360"]" />
                                        }
                                        else
                                        {
                                            <ListaRelaciones Etiqueta="@Textos["DocumentacionCentroLista360", empresa.Nombre]">
                                                @foreach (var documento in documentosVisibles)
                                                {
                                                    <FilaRelacion @key="documento.TipoDocumentoId" Nombre="@documento.Nombre" Tono="EstadoDocumentoFicha360.TonoFila(documento.Estado)">
                                                        <Detalle>
                                                            @if (documento.DocumentoId is null)
                                                            {
                                                                @Textos["DocumentoCentroAusente360"]
                                                            }
                                                            else
                                                            {
                                                                @if (documento.FechaEmision is { } emision)
                                                                {
                                                                    <span>@Textos["DocumentoCentroEmision360", emision.ToString("dd/MM/yyyy")]</span>
                                                                }
                                                                @if (documento.FechaVencimiento is { } vence)
                                                                {
                                                                    <span> · @Textos["DocumentoCentroVence360", vence.ToString("dd/MM/yyyy")]</span>
                                                                }
                                                                @if (documento.EnToleranciaHasta is { } tolerancia)
                                                                {
                                                                    <span> · @Textos["DocumentoCentroToleranciaHasta360", tolerancia.ToString("dd/MM/yyyy")]</span>
                                                                }
                                                            }
                                                        </Detalle>
                                                        <Estado><Badge Tono="EstadoDocumentoFicha360.Tono(documento.Estado)">@EstadoDocumentoFicha360.Texto(documento.Estado)</Badge></Estado>
                                                        <Acciones><Boton360 Nombre="@documento.Nombre" OnClick="() => IrATipoDocumento(documento.TipoDocumentoId)" /></Acciones>
                                                    </FilaRelacion>
                                                }
                                            </ListaRelaciones>
                                        }
                                        @if (empresa.Documentos.Count > 0)
                                        {
                                            <p class="nota">@Textos["DocumentacionCentroRecuento360", documentosVisibles.Count, empresa.Documentos.Count]</p>
                                        }
                                    </ChildContent>
                                </Tarjeta>
                            }
                        }
                        else if (_requisitosCentro.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["RequisitosCentroVacio360"]" />
                        }
                        else
                        {
                            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["PestanaRequisitos360"]">
                                @foreach (var requisito in _requisitosCentro)
                                {
                                    <FilaRelacion @key="requisito.TipoDocumentoId" Nombre="@requisito.Nombre">
                                        <Detalle>
                                            @Textos[requisito.AmbitoAplicacion == AmbitoAplicacion.Empresa ? "RequisitoCentroEmpresa360" : "RequisitoCentroTrabajador360"]
                                            · @Textos["RequisitoCentroTolerancia360", ReglaBloqueoDeAcceso.ResolverToleranciaDias(requisito.ToleranciaDias, requisito.ToleranciaHeredadaDias)]
                                        </Detalle>
                                        <Estado>@Textos[requisito.BloqueaAcceso ? "RequisitoCentroBloquea360" : "RequisitoCentroNoBloquea360"]</Estado>
                                        <Acciones><Boton360 Nombre="@requisito.Nombre" OnClick="() => IrATipoDocumento(requisito.TipoDocumentoId)" /></Acciones>
                                    </FilaRelacion>
                                }
                            </ListaRelaciones>
                        }
                    }
                    @if (_pestana == PestanaFicha && HayDatosFicha)
                    {
                        <CajasFicha Cajas="CajasDeFicha" />
                    }
                    @if (_pestana == PestanaHistorial)
                    {
                        <PestanaHistorial @key="CentroId" EntidadTipo="Centro" EntidadId="CentroId" />
                    }
                </Pestanas>
            </ChildContent>
            <Lateral>
                <Tarjeta Compacta="true" Titulo="Canales de gestión">
                    <AccionesHeader>
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPlataforma">Gestionar →</Boton>
                    </AccionesHeader>
                    <ChildContent>
                        @if (_detalle.GestionCae == ModalidadGestionCae.SinGestionCae)
                        {
                            <p class="texto-vacio-seccion centro360-sin-gestion-cae">@Textos["GestionCaeExplicacionCentro360"]</p>
                        }
                        else if (_cargandoCanales)
                        {
                            <EstadoCargando Filas="2" />
                        }
                        else if (_canales.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Sin canal de gestión registrado para este centro.</p>
                        }
                        else
                        {
                            <ListaLateral>
                                @foreach (var canal in _canales)
                                {
                                    <ElementoListaLateral @key="canal.Id">
                                        <Etiqueta>
                                            <span>
                                                @(canal.Tipo == TipoCanalGestion.Plataforma
                                                    ? (canal.ProveedorPlataformaCaeNombre ?? "Plataforma sin resolver")
                                                    : "Gestión por correo")
                                                @if (canal.Tipo == TipoCanalGestion.Plataforma)
                                                {
                                                    <Badge Tono="@(canal.TieneCredenciales ? TonoBadge.Exito : TonoBadge.Neutro)" Tamano="TamanoBadge.Pequeno">
                                                        @(canal.TieneCredenciales ? "Con credenciales" : "Sin credenciales")
                                                    </Badge>
                                                }
                                            </span>
                                            @if (canal.EsPrincipal)
                                            {
                                                <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Principal</Badge>
                                            }
                                        </Etiqueta>
                                        <ChildContent>
                                            <span>@canal.EtiquetaProposito</span>
                                            @if (!string.IsNullOrWhiteSpace(canal.UrlAcceso))
                                            {
                                                @*
                                                    La dirección del portal se ABRE, no se copia: el
                                                    Gestor CAE la abre en pestaña nueva y pega allí las
                                                    credenciales. Solo http(s): la URL es texto libre y
                                                    un javascript: en un href ejecutaría script. Si no
                                                    es navegable se enseña como texto, sin enlace.
                                                *@
                                                <span>
                                                    @if (UrlPortalCae.Normalizar(canal.UrlAcceso) is { } destino)
                                                    {
                                                        <Boton Variante="@(canal.EsPrincipal ? VarianteBoton.Primario : VarianteBoton.Secundario)" Tamano="TamanoBoton.Pequeno"
                                                               Href="@destino" target="_blank" rel="noopener noreferrer"
                                                               title="@canal.UrlAcceso"
                                                               aria-label="@($"Abrir el portal {canal.UrlAcceso} en una pestaña nueva")">
                                                            Abrir portal ↗
                                                        </Boton>
                                                    }
                                                    else
                                                    {
                                                        @canal.UrlAcceso
                                                    }
                                                </span>
                                            }
                                            @*
                                                Copiar lo que el canal sirve para pegar en otra
                                                parte. Usuario y contraseña no vienen en este
                                                DTO: se piden al servidor solo al pulsar
                                                (DEC-53/DEC-62) y no se pintan; cada lectura
                                                efectiva queda en la auditoría del Tenant
                                                propietario (ObtenerCredencialCanalGestionQuery).
                                                Y solo para roles con escritura (decisión
                                                2026-09-23): a Consulta el servidor le devuelve
                                                null, así que ni se le ofrece.
                                            *@
                                            @if (canal.Tipo == TipoCanalGestion.Plataforma && canal.TieneCredenciales)
                                            {
                                                <SoloConEscritura>
                                                    <span>
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, false)" Etiqueta="el usuario" Texto="Copiar usuario" />
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, true)" Etiqueta="la contraseña" Texto="Copiar contraseña" />
                                                    </span>
                                                </SoloConEscritura>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(canal.EmailsDestinatarios))
                                            {
                                                <span class="canal-aviso-visita">
                                                    <span>@Textos["ParaAvisarVisita360"] · @Textos["PorCorreo360"]</span>
                                                    @canal.EmailsDestinatarios
                                                    <BotonCopiar Valor="@canal.EmailsDestinatarios" Etiqueta="la dirección de este canal" />
                                                </span>
                                            }
                                        </ChildContent>
                                    </ElementoListaLateral>
                                }
                            </ListaLateral>
                        }
                    </ChildContent>
                </Tarjeta>

            </Lateral>
        </CuerpoConLateral>
    }
</div>

<DialogoConfirmacion Visible="_confirmarEliminarVisible"
                     VisibleChanged="v => _confirmarEliminarVisible = v"
                     Titulo="@Textos["EliminarCentroTitulo", _detalle?.Nombre ?? string.Empty].Value"
                     Mensaje="@Textos["EliminarCentroMensaje"].Value"
                     EnProgreso="_eliminando"
                     OnConfirmar="ConfirmarEliminarAsync" />
</LimiteDeErrores>

@code {
    private IReadOnlyList<CajaFicha> CajasDeFicha => HayDatosFicha ? [new("datos-centro", DatosDeFicha)] : [];

    private RenderFragment DatosDeFicha => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaDatosCentro"]" Compacta="true">
                <RejillaDatos>
                    @if (!string.IsNullOrWhiteSpace(detalle.CodigoCentro))
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaCodigoCentro"]" Valor="@detalle.CodigoCentro" />
                    }
                    @if (!string.IsNullOrWhiteSpace(detalle.Direccion))
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaDireccionCentro"]" Valor="@detalle.Direccion" />
                    }
                    @if (!string.IsNullOrWhiteSpace(detalle.Contacto))
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaContactoCentro"]" Valor="@detalle.Contacto" />
                    }
                    @if (detalle.ContratoVigenteHasta is { } hasta)
                    {
                        <DatoRejilla Etiqueta="@Textos["FichaContratoHasta360"]" Valor="@hasta.ToString("dd/MM/yyyy")" />
                    }
                </RejillaDatos>
            </Tarjeta>
        }
    };

    private RenderFragment AnilloDeCabecera => @<AnilloCumplimiento Porcentaje="_resumen?.CumplimientoPorcentaje" Tamano="TamanoAnillo.Cabecera"
                                                                    Etiqueta="@($"{_resumen?.CumplimientoPorcentaje}% de cumplimiento — documentos al día / requeridos entre los trabajadores de este centro")" />;
}
