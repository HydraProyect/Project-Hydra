@*
    Centro 360 (Centro 360 TALVEG, Parte XVI PROMPT 13) — ver comentario de
    cabecera en el .razor.cs para el porqué de lo que esta página NO
    reimplementa.
*@
@page "/centros/{CentroId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Centros
@using CaeManager.Application.Centros.Queries.ObtenerCanalesGestionDeCentro
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Integraciones
@using CaeManager.Domain.Centros
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosCentros> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.Nombre ?? "Centro") — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="Ruta de Centro 360" />

    @if (_error)
    {
        <Tarjeta>
            <EstadoVacio Titulo="No pudimos cargar este centro" Descripcion="Puede que ya no exista o que no tengas acceso.">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
                    <EnlaceProfundoOtraEmpresa />
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_cargando)
    {
        <Tarjeta>
            <EstadoCargando Filas="5" />
        </Tarjeta>
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera de identidad en tarjeta (CabeceraIdentidad, la pieza de
            las fichas 360): el anillo a la izquierda, qué es («Centro»), el
            nombre, lo que califica al centro «junto al título», la identidad
            de sus contrapartes en la línea de datos y a la derecha la acción
            principal con el resto en un menú.

            Contrapartes (decisión del propietario 2026-09-22: cada 360 tiene
            página propia además del panel): el NOMBRE es un enlace real a la
            página 360 del Cliente empresarial (/clientes/{id}) y de la Empresa
            (/empresas/{id}), y el botón 360 de al lado abre su panel de 520 px
            como antes lo hacía el nombre. En pantalla el Cliente empresarial
            se rotula «Cliente» (CONTRATO_TERMINOLOGIA § 3.2; decisión de rótulo del 2026-10-09); en código sigue siendo
            ClienteEmpresarial.
        *@
        @* P1-X2: un Centro sin gestión CAE no tiene cumplimiento que medir; el anillo vacío se leería como 0 %.
           Sin anillo la ranura va a null, para que la tarjeta no reserve su hueco. *@
        <CabeceraIdentidad Titulo="@_detalle.Nombre" Kicker="@Textos["KickerCentro360"]"
                           Anillo="@(_detalle.GestionCae != ModalidadGestionCae.SinGestionCae ? AnilloDeCabecera : null)">
            <Datos>
                @* Cada contraparte es un bloque: la línea de datos es flex y separaría el rótulo de su nombre. *@
                <span>
                    @Textos["CabeceraCliente"] <a class="enlace-nombre-fila centro360-contraparte" href="@($"/clientes/{_detalle.ClienteId}")">@_detalle.ClienteRazonSocial</a>
                    <Boton360 Nombre="@_detalle.ClienteRazonSocial" OnClick="AbrirClienteEmpresarial" />
                </span>
                <span>
                    · @Textos["CabeceraEmpresa"] <a class="enlace-nombre-fila centro360-contraparte" href="@($"/empresas/{_detalle.EmpresaId}")">@_detalle.EmpresaRazonSocial</a>
                    <Boton360 Nombre="@_detalle.EmpresaRazonSocial" OnClick="AbrirEmpresa" />
                </span>
                @if (_visitas.Count > 0)
                {
                    var proxima = _visitas[0];
                    <span>· Próxima visita: <b>@proxima.FechaInicio.ToString("dd/MM")–@proxima.FechaFin.ToString("dd/MM")</b></span>
                }
            </Datos>
            <JuntoAlTitulo>
                @if (_resumen is not null)
                {
                    <span class="centro360-indicadores">
                        @if (_resumen.Estado == EstadoCentro.Bloqueado)
                        {
                            @* Solo lo causa la plataforma del Cliente empresarial (D-7): el bloqueo de un documento es del Trabajador. *@
                            <Badge Tono="TonoBadge.Peligro">@EstadoCentroUi.Texto(EstadoCentro.Bloqueado)</Badge>
                        }
                        @if (_bloqueos.Count > 0)
                        {
                            var trabajadoresBloqueados = TextoBloqueoDeAcceso.TrabajadoresBloqueados(_bloqueos);
                            var tituloBloqueados = TextoBloqueoDeAcceso.Titulo(Textos, trabajadoresBloqueados);
                            <VentanaContexto Etiqueta="@tituloBloqueados" Titulo="@Textos["BloqueadosEncabezado"].Value">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" ConIcono="true">@tituloBloqueados</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var bloqueo in _bloqueos)
                                    {
                                        <span class="ventana-linea">@TextoBloqueoDeAcceso.Linea(Textos, bloqueo)</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Estado == EstadoCentro.SinGestionCae)
                        {
                            @* P1-X2: estado propio y tono neutro — nunca un verde falso. *@
                            <Badge Tono="EstadoCentroUi.Tono(EstadoCentro.SinGestionCae)">@EstadoCentroUi.Texto(EstadoCentro.SinGestionCae)</Badge>
                        }
                        @if (_resumen.Recuentos.TotalVencidas > 0)
                        {
                            <VentanaContexto Etiqueta="@DescribirRecuento(_resumen.Recuentos.Vencidas, "vencido")"
                                             Titulo="@($"{_resumen.Recuentos.TotalVencidas} {(_resumen.Recuentos.TotalVencidas == 1 ? "documento vencido" : "documentos vencidos")}")">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@_resumen.Recuentos.TotalVencidas vencido@(_resumen.Recuentos.TotalVencidas == 1 ? "" : "s")</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Vencidas)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Recuentos.TotalProximas > 0)
                        {
                            <VentanaContexto Etiqueta="@DescribirRecuento(_resumen.Recuentos.Proximas, "próximo a vencer")"
                                             Titulo="@($"{_resumen.Recuentos.TotalProximas} {(_resumen.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                <Disparador>
                                    <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">@_resumen.Recuentos.TotalProximas próximo@(_resumen.Recuentos.TotalProximas == 1 ? "" : "s")</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Proximas)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                        @if (_resumen.Recuentos.TotalPendientes > 0)
                        {
                            @* Pendiente en la plataforma CAE del Centro (2026-10-10): el documento vale, falta acreditarlo allí. *@
                            var pendientesPlataforma = _resumen.Recuentos.TotalPendientes;
                            var tituloPendientes = pendientesPlataforma == 1
                                ? Textos["TituloPendientesPlataformaUno"].Value
                                : Textos["TituloPendientesPlataformaVarios", pendientesPlataforma].Value;
                            <VentanaContexto Etiqueta="@tituloPendientes" Titulo="@tituloPendientes">
                                <Disparador>
                                    <Badge Tono="EstadoCentroUi.Tono(EstadoCentro.Pendiente)" Tamano="TamanoBadge.Pequeno">@(pendientesPlataforma == 1 ? Textos["MotivoUnPendientePlataforma"].Value : Textos["MotivoPendientesPlataforma", pendientesPlataforma].Value)</Badge>
                                </Disparador>
                                <Detalle>
                                    @foreach (var incidencia in _resumen.Recuentos.Pendientes)
                                    {
                                        <span class="ventana-linea">@incidencia.Descripcion</span>
                                    }
                                </Detalle>
                            </VentanaContexto>
                        }
                    </span>
                }
            </JuntoAlTitulo>
            <Acciones>
                @* Lleva a /visitas con el Drawer de alta abierto (CrearVisitaCommand, denegado a Consulta). *@
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="ProgramarVisita">Programar visita</Boton></SoloConEscritura>
                @*
                    El resto de acciones, en el menú «⋯» del mockup. «Reclamar
                    documentación» remite al panel a propósito (ver doc de la
                    clase): el drawer de confirmación vive allí y ese segundo
                    paso es deliberado (Project-Hydra-Negocio/tecnico/docs/COMUNICACIONES.md § 16.3, "siempre
                    confirmar"). Lo que sí se decide aquí es SI hay algo que
                    reclamar, para no ofrecer una acción sin objeto.
                *@
                <MenuAcciones>
                    <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">Editar centro</ItemMenuAccion></SoloConEscritura>
                    <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => _confirmarEliminarVisible = true">@Textos["MenuEliminarCentro"]</ItemMenuAccion></SoloConEscritura>
                    @if (_documentosPorReclamar > 0)
                    {
                        @* Reclamar envía un mensaje (EnviarReclamacionCommand): es escritura, y a Consulta no se le ofrece. *@
                        <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">Reclamar documentación (@_documentosPorReclamar)</ItemMenuAccion></SoloConEscritura>
                    }
                    <ItemMenuAccion OnClick="GenerarInformeDelCentro">Generar informe del centro</ItemMenuAccion>
                </MenuAcciones>
            </Acciones>
        </CabeceraIdentidad>

        @*
            Barra de trabajo del mockup (data-workbar). Filtra client-side lo
            que el acordeón ya cargó —ninguna consulta nueva— y los dos filtros
            viajan en la URL para que un centro filtrado se pueda enlazar.
        *@
        <div class="barra-filtros">
            <CampoTexto Placeholder="Buscar trabajador en este centro…" Valor="@_busqueda" ValorChanged="Buscar" />
            <FiltroEstado Etiqueta="Estado" TextoTodos="Todos" Valor="@_estadoFiltro" ValorChanged="CambiarEstado"
                          Opciones="AcordeonAsignacionesCentro.OpcionesEstadoDocumental" />
            @if (HayFiltrosActivos)
            {
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="LimpiarFiltros">Limpiar filtros</Boton>
            }
        </div>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral360"]">
            <ChildContent>
                <AcordeonAsignacionesCentro CentroId="_detalle.Id" CentroNombre="@_detalle.Nombre"
                                              VisitaId="_visitas.Count > 0 ? _visitas[0].VisitaId : null"
                                              VisitaFechaFin="_visitas.Count > 0 ? _visitas[0].FechaFin : null"
                                              EmpresaId="_detalle.EmpresaId" EmpresaNombre="@_detalle.EmpresaRazonSocial"
                                              IncidenciasEmpresa="IncidenciasEmpresaHeader"
                                              SoloIncidencias="false"
                                              FiltroTexto="@_busqueda" FiltroEstado="@_estadoFiltro"
                                              MostrarTotales="true"
                                              Bloqueos="_bloqueos"
                                              OnCambio="CargarAsync" />
            </ChildContent>
            <Lateral>
                <Tarjeta Compacta="true" Titulo="Canales de gestión">
                    <AccionesHeader>
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirPlataforma">Gestionar →</Boton>
                    </AccionesHeader>
                    <ChildContent>
                        @if (_detalle.GestionCae == ModalidadGestionCae.SinGestionCae)
                        {
                            <p class="texto-vacio-seccion centro360-sin-gestion-cae">@Textos["GestionCaeExplicacionCentro360"]</p>
                        }
                        else if (_cargandoCanales)
                        {
                            <EstadoCargando Filas="2" />
                        }
                        else if (_canales.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Sin canal de gestión registrado para este centro.</p>
                        }
                        else
                        {
                            <ListaLateral>
                                @foreach (var canal in _canales)
                                {
                                    <ElementoListaLateral @key="canal.Id">
                                        <Etiqueta>
                                            @canal.EtiquetaProposito
                                            @if (canal.EsPrincipal)
                                            {
                                                <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Principal</Badge>
                                            }
                                        </Etiqueta>
                                        <ChildContent>
                                            <span>
                                                @(canal.Tipo == TipoCanalGestion.Plataforma
                                                    ? (canal.ProveedorPlataformaCaeNombre ?? "Plataforma sin resolver")
                                                    : "Gestión por correo")
                                                @if (canal.Tipo == TipoCanalGestion.Plataforma)
                                                {
                                                    <Badge Tono="@(canal.TieneCredenciales ? TonoBadge.Exito : TonoBadge.Neutro)" Tamano="TamanoBadge.Pequeno">
                                                        @(canal.TieneCredenciales ? "Con credenciales" : "Sin credenciales")
                                                    </Badge>
                                                }
                                            </span>
                                            @*
                                                Copiar lo que el canal sirve para pegar en otra
                                                parte. Usuario y contraseña no vienen en este
                                                DTO: se piden al servidor solo al pulsar
                                                (DEC-53/DEC-62) y no se pintan; cada lectura
                                                efectiva queda en la auditoría del Tenant
                                                propietario (ObtenerCredencialCanalGestionQuery).
                                                Y solo para roles con escritura (decisión
                                                2026-09-23): a Consulta el servidor le devuelve
                                                null, así que ni se le ofrece.
                                            *@
                                            @if (canal.Tipo == TipoCanalGestion.Plataforma && canal.TieneCredenciales)
                                            {
                                                <SoloConEscritura>
                                                    <span>
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, false)" Etiqueta="el usuario" Texto="Copiar usuario" />
                                                        <BotonCopiar ValorAsync="CopiarCredencial(canal.Id, true)" Etiqueta="la contraseña" Texto="Copiar contraseña" />
                                                    </span>
                                                </SoloConEscritura>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(canal.EmailsDestinatarios))
                                            {
                                                <span>
                                                    @canal.EmailsDestinatarios
                                                    <BotonCopiar Valor="@canal.EmailsDestinatarios" Etiqueta="la dirección de este canal" />
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(canal.UrlAcceso))
                                            {
                                                @*
                                                    La dirección del portal se ABRE, no se copia: el
                                                    Gestor CAE la abre en pestaña nueva y pega allí las
                                                    credenciales. Solo http(s): la URL es texto libre y
                                                    un javascript: en un href ejecutaría script. Si no
                                                    es navegable se enseña como texto, sin enlace.
                                                *@
                                                <span>
                                                    @if (UrlPortalCae.Normalizar(canal.UrlAcceso) is { } destino)
                                                    {
                                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                               Href="@destino" target="_blank" rel="noopener noreferrer"
                                                               title="@canal.UrlAcceso"
                                                               aria-label="@($"Abrir el portal {canal.UrlAcceso} en una pestaña nueva")">
                                                            Abrir portal ↗
                                                        </Boton>
                                                    }
                                                    else
                                                    {
                                                        @canal.UrlAcceso
                                                    }
                                                </span>
                                            }
                                        </ChildContent>
                                    </ElementoListaLateral>
                                }
                            </ListaLateral>
                        }
                    </ChildContent>
                </Tarjeta>

                <Tarjeta Compacta="true" Titulo="Próxima visita">
                    @if (_visitas.Count == 0)
                    {
                        <p class="texto-vacio-seccion">Sin visitas programadas.</p>
                    }
                    else
                    {
                        <ListaLateral>
                            @foreach (var visita in _visitas)
                            {
                                <ElementoListaLateral @key="visita.VisitaId">
                                    <Etiqueta>@visita.FechaInicio.ToString("dd/MM/yyyy") – @visita.FechaFin.ToString("dd/MM/yyyy")</Etiqueta>
                                    <ChildContent><span>@visita.TrabajadoresCount trabajador(es)</span></ChildContent>
                                </ElementoListaLateral>
                            }
                        </ListaLateral>
                    }
                </Tarjeta>
            </Lateral>
        </CuerpoConLateral>
    }
</div>

<DialogoConfirmacion Visible="_confirmarEliminarVisible"
                     VisibleChanged="v => _confirmarEliminarVisible = v"
                     Titulo="@Textos["EliminarCentroTitulo", _detalle?.Nombre ?? string.Empty].Value"
                     Mensaje="@Textos["EliminarCentroMensaje"].Value"
                     EnProgreso="_eliminando"
                     OnConfirmar="ConfirmarEliminarAsync" />
</LimiteDeErrores>

@code {
    private RenderFragment AnilloDeCabecera => @<AnilloCumplimiento Porcentaje="_resumen?.CumplimientoPorcentaje" Tamano="TamanoAnillo.Cabecera"
                                                                    Etiqueta="@($"{_resumen?.CumplimientoPorcentaje}% de cumplimiento — documentos al día / requeridos entre los trabajadores de este centro")" />;
}
