@page "/centros"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@implements IDisposable
@attribute [Authorize]
@using CaeManager.Application.Centros.Commands.CrearCentro
@using CaeManager.Application.Centros.Commands.EditarCentro
@using CaeManager.Application.Centros.Commands.EliminarCentro
@using CaeManager.Application.Centros.Commands.EliminarCentros
@using CaeManager.Application.Centros.Queries.ObtenerCentroPorId
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using CaeManager.Web.Features.Centros
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@using CaeManager.Web.Features.Clientes.Components
@using CaeManager.Web.Features.Empresas.Components
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject IStringLocalizer<TextosCentros> Textos
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject ContextWorkspaceService WorkspaceService

<LimiteDeErrores Pagina="this">
<PageTitle>Centros — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Mockup «Selector Empresa Gestionada» (lienzo 2): con varias empresas gestionadas, la lista dice de
       cuál es. El selector de la barra lateral cambia de empresa y recarga esta misma ruta sin query
       (I14: ningún Id de enlace profundo ni filtro sobrevive). *@
    @if (!_sinEmpresaSeleccionada)
    {
        @* En el estado 4a no hay empresa activa que nombrar: la cabecera de empresa no se pinta. *@
        <CabeceraEmpresaActiva Empresa="_empresaActiva" />
    }

    @*
        Pieza 1 del patrón de lista (Project-Hydra-Negocio/tecnico/CONTRATO-PATRON-PANTALLA-LISTA-2026-09-28.md § 3):
        antetítulo del grupo del menú, «Exportar» como enlaces secundarios y UNA sola primaria. Las
        acciones que antes vivían dentro de la barra de trabajo (exportar, nuevo) suben aquí: nunca hay
        acciones de la página dentro de la barra de filtros. Frente al mockup «Lista Centros TALVEG.dc.html»
        (una sola fila con todo), manda el contrato: «Exportar a Excel» queda como enlace secundario y
        «Exportar asignaciones», acción extra, va dentro de «Más».
    *@
    <CabeceraPagina Titulo="Centros" Kicker="Negocio">
        <Acciones>
            @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
            {
                <a class="enlace-exportar" href="/centros/exportar.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Exportar a Excel</a>
                @* Acción extra: va en «Más» (contrato § 3, pieza 1); es una descarga, no una ruta de Blazor. *@
                <MenuAcciones Etiqueta="@Textos["CabeceraMas"]">
                    <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/asignaciones/exportar.xlsx", forceLoad: true)'>@Textos["ExportarAsignaciones"]</ItemMenuAccion>
                </MenuAcciones>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">+ Nuevo centro</Boton></SoloConEscritura>
                }
            }
        </Acciones>
    </CabeceraPagina>

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           datos de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @*
        Pieza 2 (BarraFiltros): buscador y estado con su etiqueta visible encima y, debajo, los chips
        activos con «Limpiar todo». Centros no tiene filtros guardados: no se pasa OnGuardarFiltro y
        «Guardar filtro» no se pinta.
    *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="Buscar centro, Cliente empresarial o empresa…"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync">
        <Filtros>
            <FiltroEstado Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                          Opciones="EstadoCentroUi.Opciones" />
        </Filtros>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroBusqueda" EtiquetaAccesible="@Textos["QuitarFiltroBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_estadoFiltro))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroEstado" EtiquetaAccesible="@Textos["QuitarFiltroEstado"]" OnQuitar="() => CambiarEstadoAsync(string.Empty)" />
            }
        </Chips>
    </BarraFiltros>

    @*
        Pieza 3 (BarraHerramientasLista): «Selección múltiple», «Expandir todos» y el recuento, en esta
        fila y en este orden. El orden por cumplimiento (blueprint § 3.1, DDL-036) existe para atacar los
        peores centros SIN depender de que haya una visita próxima; es un control de la lista entera, así
        que vive aquí.
    *@
    <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple"
                            TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos">
        <Extra>
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                   OnClick="() => CambiarOrdenAsync(nameof(CentroListaDto.CumplimientoPorcentaje))"
                   aria-pressed="@(_ordenarPor == nameof(CentroListaDto.CumplimientoPorcentaje) ? "true" : "false")">
                Cumplimiento @(_ordenarPor == nameof(CentroListaDto.CumplimientoPorcentaje) ? (_ordenDescendente ? "↓" : "↑") : "")
            </Boton>
            @if (_totalElementos > 0)
            {
                @* El total lo da la consulta ya filtrada: es el de las coincidencias, no el de la cartera. *@
                <span class="conteo-centros">@TextoConteo</span>
            }
        </Extra>
    </BarraHerramientasLista>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los centros" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="6" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
           a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
           filtrar lo manda a duplicar algo que ya existe.

           La copia no afirma que HAYA registros dados de alta: el filtrado
           es de servidor y la consulta solo devuelve el total ya filtrado,
           así que la pantalla no sabe cuántos hay sin filtro. *@
        <EstadoVacio NombreIcono="vacio" Titulo="Ningún centro con estos filtros"
                     Descripcion="Ninguno coincide con la búsqueda ni con el estado de documentación seleccionado.">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="centros" Titulo="Aún no hay centros" Descripcion="Crea el primero para empezar a asignar trabajadores.">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">+ Nuevo centro</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        @if (_seleccionMultiple)
        {
            @* "Seleccionar todos" era falso y se contradecía con la propia barra
               de lote, que ya dice «N seleccionado(s) EN ESTA PÁGINA»: la casilla
               solo marca los de la página actual. Con 20 por página y 200
               coincidencias, quien la marcaba y pulsaba "Eliminar seleccionados"
               borraba 20 creyendo que borraba 200.

               Se dice ademas cuantas quedan fuera cuando las hay: es la mitad
               informativa del banner que pide el mockup. La otra mitad,
               "seleccionar las N filtradas", NO se implementa aqui — añade una
               capacidad de selección masiva sobre un camino destructivo, y eso
               es una decisión de producto, no de maquetación. *@
            <label class="campo-checkbox">
                <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                Seleccionar los de esta página
                @if (_totalElementos > _elementosPagina.Count)
                {
                    <span class="texto-vacio-seccion">@($" — hay {_totalElementos} en total con estos filtros")</span>
                }
            </label>
        }

        @* Cabecera de columnas (pieza 4), la MISMA que en Empresas. Sin roles de tabla a propósito: esto no
           es una tabla —la fila se despliega— y anunciarlo como tal prometería a un lector de pantalla una
           navegación por celdas que no existe. Los anchos son los de la fila (indicadores de 200 px). *@
        <div class="cabecera-columnas-centros">
            @if (_seleccionMultiple)
            {
                <span class="cabecera-columnas-centros-seleccion"></span>
            }
            <span class="cabecera-columnas-centros-inicio"></span>
            <span class="cabecera-columnas-centros-centro">@Textos["ColCentro"]</span>
            <span class="cabecera-columnas-centros-indicadores">
                <span>@Textos["ColVencidos"]</span>
                <span>@Textos["ColProximos"]</span>
                <span>@Textos["ColEstadoVisita"]</span>
            </span>
            <span class="cabecera-columnas-centros-acciones"></span>
        </div>

        <div class="lista-filas-acordeon">
            @foreach (var centro in _elementosPagina)
            {
                <div class="@("tarjeta-fila-acordeon" + (centro.Id == _idEnfocado ? " fila-enfocada" : ""))" @key="centro.Id">
                    @{ var visitas = _visitasPorCentro.GetValueOrDefault(centro.Id) ?? []; }
                    @{ var visita = visitas.FirstOrDefault(); }
                    @{ var expandido = _expandidos.Contains(centro.Id); }
                    <div class="tarjeta-fila-acordeon-cabecera">
                        @if (_seleccionMultiple)
                        {
                            <input type="checkbox" aria-label="@($"Seleccionar el centro {centro.Nombre}")" checked="@_seleccionados.Contains(centro.Id)" @onchange="e => AlternarSeleccion(centro.Id, (bool)e.Value!)" />
                        }
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@($"Asignaciones de {centro.Nombre}")"
                                @onclick="() => AlternarExpansion(centro.Id)">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        <AnilloCumplimiento Porcentaje="centro.CumplimientoPorcentaje" Tamano="TamanoAnillo.Pequeno"
                                             Etiqueta="@($"{centro.CumplimientoPorcentaje}% de cumplimiento — documentos al día / requeridos entre los trabajadores de este centro")" />
                        @*
                            Identidad del centro en dos líneas (lámina L3): nombre encima,
                            cliente · empresa · código debajo. Antes iban en la misma línea
                            y el meta empujaba los indicadores a una posición distinta en
                            cada fila.
                        *@
                        <span class="tarjeta-fila-acordeon-identidad">
                            <button type="button" class="enlace-nombre-fila" @onclick="() => AbrirPanelAsync(centro.Id)">
                                @centro.Nombre
                            </button>
                            <span class="tarjeta-fila-acordeon-meta">@centro.ClienteRazonSocial · @centro.EmpresaRazonSocial@(string.IsNullOrEmpty(centro.CodigoCentro) ? "" : $" · {centro.CodigoCentro}")</span>
                        </span>
                        @*
                            Zona de indicadores de ancho FIJO. Es lo que hace que los
                            recuentos, el estado y la visita caigan en la misma vertical en
                            todas las filas, independientemente de lo largo que sea el
                            nombre del centro (lámina L3, blueprint § 3.2).
                        *@
                        @*
                            Ranuras FIJAS de recuento (blueprint § 3.2, lámina L3,
                            contrato de fidelidad 2026-08-09 § 1.6, bug C-2):
                            vencidos · próximos · estado-o-visita caen siempre en
                            la misma vertical, estén o no presentes en esa fila.

                            La 3ª ranura es mutuamente excluyente entre el Badge
                            de Estado y la visita — antes se mostraban los dos a
                            la vez y el ancho fijo de la columna no les alcanzaba
                            (C-2: "Visita 15/08–16/08" caía a una segunda línea
                            bajo "Bloqueado"). Cuando hay visita, la visita gana
                            el espacio porque es la información con fecha límite;
                            si no hay visita, se ve el estado.
                        *@
                        <span class="tarjeta-fila-acordeon-indicadores">
                            <span class="ranura-recuento">
                                @if (centro.Recuentos.TotalVencidas > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(centro.Recuentos.Vencidas, "vencido")"
                                                     Titulo="@($"{centro.Recuentos.TotalVencidas} {(centro.Recuentos.TotalVencidas == 1 ? "documento vencido" : "documentos vencidos")}")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento"
                                                   title="@($"{centro.Recuentos.TotalVencidas} {(centro.Recuentos.TotalVencidas == 1 ? "documento vencido" : "documentos vencidos")}")">
                                                @centro.Recuentos.TotalVencidas
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @DesgloseIncidencias(centro.Recuentos.Vencidas)
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                            <span class="ranura-recuento">
                                @if (centro.Recuentos.TotalProximas > 0)
                                {
                                    <VentanaContexto Etiqueta="@DescribirRecuento(centro.Recuentos.Proximas, "próximo a vencer")"
                                                     Titulo="@($"{centro.Recuentos.TotalProximas} {(centro.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                        <Disparador>
                                            <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno" class="badge-solo-recuento"
                                                   title="@($"{centro.Recuentos.TotalProximas} {(centro.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                                @centro.Recuentos.TotalProximas
                                            </Badge>
                                        </Disparador>
                                        <Detalle>
                                            @DesgloseIncidencias(centro.Recuentos.Proximas)
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                            <span class="ranura-recuento ranura-recuento-final">
                                @* Visitas SIN fusionar (DDL-035, OD-18). Ventana de contexto en los
                                   dos casos (antes solo la de varias visitas la tenía) — el badge
                                   de una sola visita es un recuento igual que cualquier otro (08 § 6,
                                   DDL-033), y sin ventana no dice cuántos trabajadores implica. *@
                                @if (visitas.Count == 1)
                                {
                                    <VentanaContexto Etiqueta="@($"1 visita programada: del {visita!.FechaInicio:dd/MM} al {visita.FechaFin:dd/MM}, {visita.TrabajadoresCount} trabajador(es)")"
                                                     Titulo="1 visita programada">
                                        <Disparador>
                                            <button type="button" class="badge-visita"
                                                    @onclick='() => NavigationManager.NavigateTo($"/visitas?q={Uri.EscapeDataString(centro.Nombre)}")'>
                                                Visita @visita!.FechaInicio.ToString("dd/MM")–@visita.FechaFin.ToString("dd/MM")
                                            </button>
                                        </Disparador>
                                        <Detalle>
                                            <span class="ventana-linea">@visita.FechaInicio.ToString("dd/MM") – @visita.FechaFin.ToString("dd/MM") · @visita.TrabajadoresCount trabajador(es)</span>
                                        </Detalle>
                                    </VentanaContexto>
                                }
                                else if (visitas.Count > 1)
                                {
                                    <VentanaContexto Etiqueta="@($"{visitas.Count} visitas programadas: {string.Join("; ", visitas.Select(v => $"del {v.FechaInicio:dd/MM} al {v.FechaFin:dd/MM}, {v.TrabajadoresCount} trabajador(es)"))}")"
                                                     Titulo="@($"{visitas.Count} visitas programadas")">
                                        <Disparador>
                                            <button type="button" class="badge-visita"
                                                    @onclick='() => NavigationManager.NavigateTo($"/visitas?q={Uri.EscapeDataString(centro.Nombre)}")'>
                                                @visitas.Count visitas
                                            </button>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var v in visitas)
                                            {
                                                <span class="ventana-linea">@v.FechaInicio.ToString("dd/MM") – @v.FechaFin.ToString("dd/MM") · @v.TrabajadoresCount trabajador(es)</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                                else if (MostrarEstadoEnIndicadores(centro))
                                {
                                    <Badge Tono="EstadoCentroUi.Tono(centro.Estado, centro.CumplimientoPorcentaje)" Tamano="TamanoBadge.Pequeno">@EstadoCentroUi.Texto(centro.Estado, centro.CumplimientoPorcentaje)</Badge>
                                }
                            </span>
                        </span>
                        @* Pieza 5: la última columna es siempre el menú «⋯» (MenuAcciones). Antes era el enlace
                           suelto «Detalles». Orden del contrato: «Abrir ficha 360» primero. «Eliminar centro» (baja lógica con «Deshacer»,
                           D-16) está aquí y en lote, activando «Selección múltiple». *@
                        <div class="tarjeta-fila-acordeon-acciones">
                            <MenuAcciones EtiquetaAccesible="@Textos["MenuFilaEtiqueta", centro.Nombre]">
                                <ItemMenuAccion OnClick="() => AbrirFichaCentro(centro.Id)">
                                    @Textos["MenuVerFicha360"]
                                </ItemMenuAccion>
                                <ItemMenuAccion OnClick="() => AbrirPanelAsync(centro.Id)">
                                    @Textos["MenuVistaPrevia"]
                                </ItemMenuAccion>
                                <SoloConEscritura>
                                    <ItemMenuAccion Destructivo="true" OnClick="() => PedirEliminarCentro(centro)">@Textos["MenuEliminarCentro"]</ItemMenuAccion>
                                </SoloConEscritura>
                            </MenuAcciones>
                        </div>
                    </div>
                    @if (expandido)
                    {
                        @* Igual que antes con SeccionColapsable: el contenido solo se
                           monta al expandir, no se paga el render de 34 acordeones. *@
                        <div class="tarjeta-fila-acordeon-contenido">
                            @* El título es verdadero por construcción: el
                               acordeón se monta aquí con SoloIncidencias. *@
                            <p class="acordeon-centro-titulo">Asignaciones con incidencias</p>
                            <AcordeonAsignacionesCentro CentroId="centro.Id" CentroNombre="@centro.Nombre"
                                                          VisitaId="visita?.VisitaId" VisitaFechaFin="visita?.FechaFin"
                                                          EmpresaId="centro.EmpresaId" EmpresaNombre="@centro.EmpresaRazonSocial"
                                                          IncidenciasEmpresa="IncidenciasDeEmpresa(centro)"
                                                          SeleccionMultiple="_seleccionMultiple"
                                                          SoloIncidencias="true"
                                                          MostrarEnlacesCentro360="false"
                                                          AsignarEsPrimaria="false"
                                                          OnCambio="() => RefrescarCentroAsync(centro.Id)" />
                            @* Camino a Centro 360 ÚNICO y SIEMPRE presente (Lista
                               Centros TALVEG.dc.html). Los enlaces que el acordeón
                               pinta por su cuenta son condicionales —solo con
                               trabajadores al día ocultos o con el estado «Todos
                               al día»—, así que un centro con pendientes y sin
                               ocultos no ofrecía camino alguno a /centros/{id}; y
                               cuando sí aparecían, se sumaban a este y la fila
                               ofrecía dos caminos al mismo destino. Por eso aquí
                               se apagan (MostrarEnlacesCentro360="false") y el
                               camino vive solo en la página: el acordeón también
                               lo monta CentroDetalle, donde apuntaría a sí mismo. *@
                            <div class="acordeon-centro-pie">
                                <a class="acordeon-centro-enlace-360" href="@($"/centros/{centro.Id}")">Ver el centro completo →</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                          Etiqueta="centro(s)" PaginaActualChanged="CambiarPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nuevo centro"
                  HayCambios="() => HayCambiosCentro" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                  HayErroresDeCampo="_erroresCampo.Count > 0" OnGuardar="GuardarAsync"
                  AlDescartarPorNavegacion="CerrarFormulariosDescartando"
                  TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <ChildContent>
        @if (_padresFijadosPorCadena)
        {
            <div class="campo">
                <label>Cliente empresarial</label>
                <span>@_clienteNombreSoloLectura</span>
            </div>
            <div class="campo">
                <label>Empresa</label>
                <span>@_empresaNombreSoloLectura</span>
            </div>

            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="DesvincularPadresFijadosAsync">
                Cambiar Cliente empresarial/empresa
            </Boton>
        }
        else
        {
            <SelectorEntidad Etiqueta="Cliente empresarial" Placeholder="Busca o crea un Cliente empresarial…" Valor="@_clienteId"
                              ValorChanged="CambiarClienteCreacionAsync" Opciones="ClientesComoOpciones"
                              PermiteCrear="true" OnCrearSolicitado="AbrirCrearClienteInline" />

            <SelectorEntidad Etiqueta="Empresa" Placeholder="@(string.IsNullOrEmpty(_clienteId) ? "Elige primero un Cliente empresarial…" : "Busca o crea una empresa…")"
                              Valor="@_empresaId" ValorChanged="AlElegirEmpresa" Opciones="EmpresasComoOpciones"
                              Deshabilitado="@(string.IsNullOrEmpty(_clienteId))"
                              PermiteCrear="true" OnCrearSolicitado="AbrirCrearEmpresaInline" />
        }

        <CampoTexto Etiqueta="Nombre" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearCentroCommand.Nombre))" />
        <CampoTexto Etiqueta="Código de centro" Valor="@_codigoCentro" ValorChanged="v => _codigoCentro = v" />
        <CampoTexto Etiqueta="Dirección" Valor="@_direccion" ValorChanged="v => _direccion = v" />
        <CampoTexto Etiqueta="Contacto" Valor="@_contacto" ValorChanged="v => _contacto = v" />
        <CampoTexto Etiqueta="Contrato vigente hasta" Type="date" Valor="@_contratoVigenteHasta" ValorChanged="v => _contratoVigenteHasta = v" />
    </ChildContent>
    <PieExtra>
        <Boton Variante="VarianteBoton.Secundario" Cargando="_guardando" OnClick="GuardarYCrearOtroAsync">
            Añadir otro centro
        </Boton>
    </PieExtra>
    <Dialogos>
        <FormularioRapidoCliente @ref="_formularioRapidoCliente" Visible="_formularioRapidoClienteVisible" VisibleChanged="v => _formularioRapidoClienteVisible = v"
                                  NombreInicial="@_nombreParaCrearCliente" OnCreado="ManejarClienteCreadoAsync" OnCambio="AlCambiarFormularioRapido" />

        <FormularioRapidoEmpresa @ref="_formularioRapidoEmpresa" Visible="_formularioRapidoEmpresaVisible" VisibleChanged="v => _formularioRapidoEmpresaVisible = v"
                                  NombreInicial="@_nombreParaCrearEmpresa" ClienteIdParaVincular="@ClienteIdParaFormularioRapido"
                                  OnCreado="ManejarEmpresaCreadaAsync" OnCambio="AlCambiarFormularioRapido" />
    </Dialogos>
</DrawerFormulario>

@* Los modales rápidos de Cliente empresarial y Empresa se abren desde el drawer y no montan aviso propio: este cubre lo escrito
   en ellos. Con el del kit (el del drawer) se coordinan (S12, lote 2b): salir con cambios en los dos pregunta una sola vez. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosFormulariosRapidos" AlDescartar="CerrarFormulariosDescartando" />

@* Baja y asignación masiva son escrituras: un rol de solo lectura (Consulta) puede marcar filas pero no ve la barra. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true">
        <AccionesExtra>
            @* Item 4 del backlog Centro 360 — funcionalidad nueva sin contrato previo,
               mismo patrón que "Asignar a centro…" de /trabajadores (Fase B). *@
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _drawerAsignacion.AbrirAsync(_seleccionados)">
                Asignar a centros seleccionados…
            </Boton>
        </AccionesExtra>
    </BarraAccionesLote>
</SoloConEscritura>

<DrawerAsignacionMasiva @ref="_drawerAsignacion" OnGuardado="ManejarAsignacionMasivaGuardadaAsync" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="CambiarVisibilidadConfirmarEliminar"
    Titulo="@(_centroAEliminarId is { } ? Textos["EliminarCentroTitulo", _centroAEliminarNombre].Value : $"¿Eliminar {_seleccionados.Count} centro(s)?")"
    Mensaje="Se ocultará(n) de las listas activas y sus asignaciones activas quedarán dadas de baja. Podrás deshacer la eliminación desde el aviso que aparecerá, pero las asignaciones seguirán de baja; después, solo un Administrador de tu organización puede recuperarlos desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
</LimiteDeErrores>
