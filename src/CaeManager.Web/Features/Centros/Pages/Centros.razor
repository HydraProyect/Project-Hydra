@page "/centros"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@implements IDisposable
@attribute [Authorize]
@using CaeManager.Application.Centros.Commands.CrearCentro
@using CaeManager.Application.Centros.Commands.EditarCentro
@using CaeManager.Application.Centros.Commands.EliminarCentro
@using CaeManager.Application.Centros.Commands.EliminarCentros
@using CaeManager.Application.Centros.Queries.ObtenerCentroPorId
@using CaeManager.Application.Centros.Queries.ObtenerCentros
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Common
@using CaeManager.Web.Features.Centros
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Centros.Recursos
@using Microsoft.Extensions.Localization
@using CaeManager.Web.Features.Clientes.Components
@using CaeManager.Web.Features.Empresas.Components
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject IStringLocalizer<TextosCentros> Textos
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject ContextWorkspaceService WorkspaceService

<LimiteDeErrores Pagina="this">
<PageTitle>Centros — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Rediseño de listados, fase 1: cabecera de una línea (CabeceraListado) con el contador, el
       conmutador ☑ de selección múltiple, el menú «⋯» con las dos descargas (lectura: cualquier
       rol) y UNA acción primaria. Sin antetítulo («Negocio» ya está en las migas) y sin el rótulo
       de la empresa gestionada: el selector de la barra lateral ya dice cuál es, y al cambiarla
       recarga esta ruta sin query (I14). El estado vacío sin empresa elegida (4a) sigue más abajo. *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
    {
        <CabeceraListado Titulo="Centros" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            <Menu>
                @* Descargas por GET: enlaces, no rutas de Blazor. *@
                <CaeManager.Web.Exportacion.EntradasExportar Ruta="/centros/exportar.xlsx" Total="@(_cargando || _errorCarga ? null : _totalElementos)" Criterios="CriteriosExportar" />
                <ItemMenuAccion Href="/asignaciones/exportar.xlsx">@Textos["ExportarAsignaciones"]</ItemMenuAccion>
            </Menu>
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">+ Nuevo centro</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="Centros" />
    }

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           datos de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @*
        Barra de filtros en modo pastillas (rediseño de listados, fase 1):
        - El buscador «Filtrar esta pantalla» (tecla f) busca en el nombre y el código del Centro,
          el Cliente empresarial y la Empresa (ObtenerCentrosQuery): la pista dice los cuatro.
        - Pastillas primarias: «Cliente» y «Estado». «Empresa» va dentro de «Más filtros».
          Las tres viajan en la URL (cliente, estado, empresa). «cliente» y «empresa» no son los
          parámetros del alta encadenada, que prefijan el formulario y no filtran.
        - En la misma fila: agrupar por Cliente empresarial (agrupación visual de la página, de serie),
          «Expandir todo» y el recuento. El orden por cumplimiento (blueprint § 3.1, DDL-036: atacar los
          peores centros sin depender de que haya visita) vive en la cabecera de su columna, como en la
          maqueta aprobada.
        Los filtros guardados (dentro de «Más filtros») guardan los parámetros de vista de la URL, con
        la agrupación y el orden: FiltrosGuardadosDeListado y ParametrosDeVista.
    *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  MasFiltrosActivos="@(!string.IsNullOrEmpty(_empresaFiltro))"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar">
        <Pastillas>
            <PastillaFiltro Etiqueta="@Textos["FiltroClienteEmpresarial"]" TextoTodos="@Textos["FiltroTodos"]" Valor="@_clienteFiltro"
                            ValorChanged="CambiarClienteFiltroAsync" Opciones="_opcionesCliente" />
        </Pastillas>
        <MasFiltros>
            <span class="menu-filtros-titulo" role="presentation">@Textos["FiltroEmpresa"]</span>
            <ItemMenuAccion Marcado="@string.IsNullOrEmpty(_empresaFiltro)" OnClick="() => CambiarEmpresaFiltroAsync(string.Empty)">@Textos["FiltroTodas"]</ItemMenuAccion>
            @foreach (var opcion in _opcionesEmpresa)
            {
                <ItemMenuAccion Marcado="@(opcion.Valor == _empresaFiltro)" OnClick="() => CambiarEmpresaFiltroAsync(opcion.Valor)">@opcion.Texto</ItemMenuAccion>
            }
        </MasFiltros>
        <Herramientas>
            @if (_elementosPagina.Count > 0)
            {
                <span class="segmentado-lista" role="group" aria-label="@Textos["AgruparEtiqueta"]" data-keytip="A" data-keytip-grupo="">
                    <button type="button" class="segmentado-lista-opcion" aria-pressed="@(_agruparPorCliente ? "false" : "true")"
                            @onclick="() => CambiarAgrupacion(false)">@Textos["AgruparNo"]</button>
                    <button type="button" class="segmentado-lista-opcion" aria-pressed="@(_agruparPorCliente ? "true" : "false")"
                            @onclick="() => CambiarAgrupacion(true)">@Textos["AgruparPorCliente"]</button>
                </span>
                <BarraHerramientasLista TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos" />
            }
        </Herramientas>
        <Resumen>
            @if (!_errorCarga && _totalElementos > 0)
            {
                @* El total lo da la consulta ya filtrada: es el de las coincidencias, no el de la cartera. *@
                <span class="conteo-centros">@TextoConteo</span>
            }
        </Resumen>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroBusqueda" EtiquetaAccesible="@Textos["QuitarFiltroBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_clienteFiltro))
            {
                <ChipFiltro Etiqueta="@Textos["ChipClienteEmpresarial", TextoOpcion(_opcionesCliente, _clienteFiltro)]" EtiquetaAccesible="@Textos["QuitarFiltroClienteEmpresarial"]" OnQuitar="() => CambiarClienteFiltroAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_empresaFiltro))
            {
                <ChipFiltro Etiqueta="@Textos["ChipEmpresa", TextoOpcion(_opcionesEmpresa, _empresaFiltro)]" EtiquetaAccesible="@Textos["QuitarFiltroEmpresa"]" OnQuitar="() => CambiarEmpresaFiltroAsync(string.Empty)" />
            }
        </Chips>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                               OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />

    @* Franja de estado: sustituye a la pastilla «Estado». Admite varios estados a la vez, viaja en la URL como
       «estado» (estados de código separados por coma) y cada botón dice cuántos Centros hay, con los demás
       filtros aplicados. «Por vencer» reúne Urgente y Próximo. *@
    <FranjaEstado Opciones="EstadoCentroUi.Franja" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                  Recuentos="_recuentosPorEstado" />

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los centros" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="6" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
           a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
           filtrar lo manda a duplicar algo que ya existe.

           La copia no afirma que HAYA registros dados de alta: el filtrado
           es de servidor y la consulta solo devuelve el total ya filtrado,
           así que la pantalla no sabe cuántos hay sin filtro. *@
        <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]"
                     Descripcion="@Textos["VacioFiltrosDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["VacioFiltrosQuitar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="centros" Titulo="Aún no hay centros" Descripcion="Crea el primero para empezar a asignar trabajadores.">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">+ Nuevo centro</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        @if (_seleccionMultiple)
        {
            @* "Seleccionar todos" era falso y se contradecía con la propia barra
               de lote, que ya dice «N seleccionado(s) EN ESTA PÁGINA»: la casilla
               solo marca los de la página actual. Con 20 por página y 200
               coincidencias, quien la marcaba y pulsaba "Eliminar seleccionados"
               borraba 20 creyendo que borraba 200.

               Se dice ademas cuantas quedan fuera cuando las hay: es la mitad
               informativa del banner que pide el mockup. La otra mitad,
               "seleccionar las N filtradas", NO se implementa aqui — añade una
               capacidad de selección masiva sobre un camino destructivo, y eso
               es una decisión de producto, no de maquetación. *@
            <label class="campo-checkbox">
                <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                Seleccionar los de esta página
                @if (_totalElementos > _elementosPagina.Count)
                {
                    <span class="texto-vacio-seccion">@($" — hay {_totalElementos} en total con estos filtros")</span>
                }
            </label>
        }

        @* Cabecera de columnas (pieza 4), con las columnas de la maqueta aprobada: Centro | Empresa |
           Cumplimiento | Estado | Visita. Los recuentos de vencidos y próximos no tienen columna: son el
           motivo bajo la pastilla de estado. Sin roles de tabla a propósito: esto no es una
           tabla —la fila se despliega— y anunciarlo como tal prometería a un lector de pantalla una
           navegación por celdas que no existe. «Cumplimiento» es el único rótulo que ordena (la consulta
           solo ordena por él en esta pantalla): pulsarlo de nuevo invierte el sentido. Los anchos son los
           de la fila (Centros.razor.css). *@
        <div class="cabecera-columnas-centros">
            @if (_seleccionMultiple)
            {
                <span class="cabecera-columnas-centros-seleccion"></span>
            }
            <span class="cabecera-columnas-centros-inicio"></span>
            <span class="cabecera-columnas-centros-centro">@Textos["ColCentro"]</span>
            <span class="columna-empresa-centro">@Textos["ColEmpresa"]</span>
            <span class="columna-cumplimiento-centro">
                <button type="button" class="cabecera-columna-orden"
                        aria-pressed="@(OrdenPorCumplimiento ? "true" : "false")"
                        @onclick="() => CambiarOrdenAsync(nameof(CentroListaDto.CumplimientoPorcentaje))">
                    @Textos["OrdenCumplimiento"] <span aria-hidden="true">@(OrdenPorCumplimiento ? (_ordenDescendente ? "↓" : "↑") : "")</span>
                </button>
            </span>
            <span class="cabecera-columnas-centros-indicadores">
                <span>@Textos["ColEstado"]</span>
                <span>@Textos["ColVisita"]</span>
            </span>
            <span class="cabecera-columnas-centros-acciones"></span>
        </div>

        @* Agrupación visual por Cliente empresarial (de serie): una cabecera por grupo con su
           contador y el resumen de la página («N con problema», «N por vencer»), tintada con el peor
           estado del grupo. Los grupos arrancan contraídos y se abren de uno en uno o con «Expandir
           todo»; con búsqueda, con un Centro concreto en la URL o con selección múltiple se ven
           abiertos (también mientras haya filas marcadas), y entonces la cabecera no es un botón (no
           podría contraerlos). Es visual y de la página: con el orden de serie los grupos salen del
           peor estado al mejor; con un orden pedido, en el de su primera fila, y dentro de cada grupo
           se respeta ese orden (Grupos). Con más de una página, una nota dice que los recuentos son de
           esta página y no del Cliente empresarial entero. *@
        var grupos = Grupos;
        @if (_agruparPorCliente && TotalPaginas > 1)
        {
            <p class="nota-grupos-pagina texto-vacio-seccion">@Textos["GrupoNotaEstaPagina"]</p>
        }
        var cabecerasDeGrupo = grupos.ToDictionary(g => g.Centros[0].Id);
        var clavesDeGrupo = new ClavesDeHermanos();
        <div class="lista-filas-acordeon">
            @foreach (var centro in FilasEnOrden(grupos))
            {
                @if (_agruparPorCliente && cabecerasDeGrupo.TryGetValue(centro.Id, out var grupo))
                {
                    var abierto = GrupoAbierto(grupo.ClienteEmpresarialId);
                    RenderFragment contenidoCabecera =
                        @<text>
                            <span class="grupo-lista-chevron" aria-hidden="true"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></span>
                            <span class="grupo-lista-nombre">@grupo.Nombre</span>
                            <span class="grupo-lista-contador" title="@Textos["GrupoContadorTitulo", grupo.Centros.Count]">@grupo.Centros.Count</span>
                            <span class="grupo-lista-resumen">
                                @if (grupo.ConProblema > 0)
                                {
                                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@Textos["GrupoConProblema", grupo.ConProblema]</Badge>
                                }
                                @if (grupo.PorVencer > 0)
                                {
                                    <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">@Textos["GrupoPorVencer", grupo.PorVencer]</Badge>
                                }
                            </span>
                        </text>;
                    <div class="@("grupo-lista" + ClaseTinteGrupo(grupo))" @key="clavesDeGrupo.De(grupo.ClienteEmpresarialId)">
                        @if (GruposForzadosAbiertos)
                        {
                            <div class="grupo-lista-cabecera grupo-lista-cabecera-abierta grupo-lista-cabecera-fija">@contenidoCabecera</div>
                        }
                        else
                        {
                            <button type="button" class="@("grupo-lista-cabecera" + (abierto ? " grupo-lista-cabecera-abierta" : ""))"
                                    aria-expanded="@(abierto ? "true" : "false")" @onclick="() => AlternarGrupo(grupo.ClienteEmpresarialId)">
                                @contenidoCabecera
                            </button>
                        }
                    </div>
                }
                @if (!GrupoAbierto(ClienteEmpresarialDe(centro)))
                {
                    continue;
                }
                <div class="@ClaseTarjeta(centro)" @key="centro.Id">
                    @{ var visitas = _visitasPorCentro.GetValueOrDefault(centro.Id) ?? []; }
                    @{ var visita = visitas.FirstOrDefault(); }
                    @{ var expandido = _expandidos.Contains(centro.Id); }
                    @* Patrón de listados: la fila no lleva menú «⋯». Un clic en cualquier punto de la
                       fila abre la vista rápida (el panel del Context Workspace), igual que Enter
                       sobre la fila enfocada; los controles de dentro —casilla, desplegable, ventanas
                       de contexto con incidencias corregibles, visitas, icono 360— hacen lo suyo y no
                       dejan subir el clic. *@
                    <div class="tarjeta-fila-acordeon-cabecera fila-pulsable" @onclick="() => AbrirPanelAsync(centro.Id)">
                        @if (_seleccionMultiple)
                        {
                            <input type="checkbox" aria-label="@($"Seleccionar el centro {centro.Nombre}")" checked="@_seleccionados.Contains(centro.Id)" @onchange="e => AlternarSeleccion(centro.Id, (bool)e.Value!)" @onclick:stopPropagation="true" />
                        }
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@($"Asignaciones de {centro.Nombre}")"
                                @onclick="() => AlternarExpansion(centro.Id)" @onclick:stopPropagation="true">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        @*
                            Identidad del centro en dos líneas: nombre encima y código debajo
                            (maqueta aprobada). Agrupado, el Cliente empresarial ya está en la
                            cabecera del grupo; sin agrupar no hay otro sitio que lo diga, así
                            que encabeza la segunda línea. La Empresa tiene su columna; en
                            pantallas estrechas esa columna se oculta y la Empresa vuelve a la
                            segunda línea (.meta-empresa-movil, Centros.razor.css).
                        *@
                        <span class="tarjeta-fila-acordeon-identidad">
                            @* El nombre es un botón que abre la vista rápida: es el destino de teclado del
                               clic en la fila (la fila entera no es focable con Tab). A la página Centro 360
                               se va con el icono 360 del final de la fila y con el del panel. *@
                            <button type="button" class="enlace-nombre-fila nombre-abre-vista-rapida"
                                    @onclick="() => AbrirPanelAsync(centro.Id)" @onclick:stopPropagation="true">
                                @centro.Nombre
                            </button>
                            @{ var meta = MetaCentro(centro); }
                            <span class="tarjeta-fila-acordeon-meta">@meta<span class="meta-empresa-movil">@(meta.Length > 0 ? " · " : "")@centro.EmpresaRazonSocial</span></span>
                        </span>
                        <span class="columna-empresa-centro" title="@centro.EmpresaRazonSocial">@centro.EmpresaRazonSocial</span>
                        <span class="columna-cumplimiento-centro">
                            <AnilloCumplimiento Porcentaje="centro.CumplimientoPorcentaje" Tamano="TamanoAnillo.Pequeno"
                                                 Etiqueta="@($"{centro.CumplimientoPorcentaje}% de cumplimiento — documentos al día / requeridos entre los trabajadores de este centro")" />
                        </span>
                        @*
                            Zona de indicadores de ancho FIJO, con dos ranuras: estado y visita. Es lo
                            que hace que caigan en la misma vertical en todas las filas, sea cual sea
                            el largo del nombre del centro (lámina L3, blueprint § 3.2).

                            Estado: la pastilla se pinta SIEMPRE (lo correcto, con punto verde y texto
                            gris) y debajo va el motivo, «N vencidos · M por vencer», que es lo que antes
                            decían las columnas «Venc.» y «Próx.». Cada parte del motivo abre su ventana
                            de contexto con las incidencias, por ámbito y corregibles sin salir del
                            listado. Sin vencidos ni próximos no hay motivo.

                            Visita: tiene su propia ranura y se ve A LA VEZ que el estado (decisión
                            del 2026-10-09). Antes se excluían porque las dos ranuras de recuento no
                            dejaban sitio para ambos (contrato de fidelidad 2026-08-09 § 1.6, bug C-2).
                        *@
                        <span class="tarjeta-fila-acordeon-indicadores">
                            <span class="ranura-recuento ranura-estado-centro">
                                @if (centro.Recuentos.TotalVencidas > 0 || centro.Recuentos.TotalProximas > 0)
                                {
                                    <EstadoFila Tono="EstadoCentroUi.Tono(centro.Estado, centro.CumplimientoPorcentaje)"
                                                Texto="@EstadoCentroUi.Texto(centro.Estado, centro.CumplimientoPorcentaje)"
                                                Correcto="EstadoCentroUi.EsCorrecto(centro.Estado, centro.CumplimientoPorcentaje)">
                                        <MotivoContenido>
                                            @if (centro.Recuentos.TotalVencidas > 0)
                                            {
                                                <VentanaContexto Etiqueta="@EtiquetaDeMotivo(MotivoVencidos(centro.Recuentos.TotalVencidas), centro.Recuentos.Vencidas, "vencido")"
                                                                 Colocacion="VentanaContextoColocacion.AbajoCentro"
                                                                 Interactiva="HayCorregibles(centro, centro.Recuentos.Vencidas)"
                                                                 Pie="@PieDeIncidencias(centro, centro.Recuentos.Vencidas)"
                                                                 Titulo="@($"{centro.Recuentos.TotalVencidas} {(centro.Recuentos.TotalVencidas == 1 ? "documento vencido" : "documentos vencidos")}")">
                                                    <Disparador>
                                                        <span class="motivo-recuento motivo-recuento-vencidos">@MotivoVencidos(centro.Recuentos.TotalVencidas)</span>
                                                    </Disparador>
                                                    <Detalle>
                                                        @DesgloseIncidencias(centro, centro.Recuentos.Vencidas)
                                                    </Detalle>
                                                </VentanaContexto>
                                            }
                                            @if (centro.Recuentos.TotalVencidas > 0 && centro.Recuentos.TotalProximas > 0)
                                            {
                                                <span class="motivo-recuento-separador" aria-hidden="true">·</span>
                                            }
                                            @if (centro.Recuentos.TotalProximas > 0)
                                            {
                                                <VentanaContexto Etiqueta="@EtiquetaDeMotivo(MotivoProximos(centro.Recuentos.TotalProximas), centro.Recuentos.Proximas, "próximo a vencer")"
                                                                 Colocacion="VentanaContextoColocacion.AbajoCentro"
                                                                 Interactiva="HayCorregibles(centro, centro.Recuentos.Proximas)"
                                                                 Pie="@PieDeIncidencias(centro, centro.Recuentos.Proximas)"
                                                                 Titulo="@($"{centro.Recuentos.TotalProximas} {(centro.Recuentos.TotalProximas == 1 ? "documento próximo a vencer" : "documentos próximos a vencer")}")">
                                                    <Disparador>
                                                        <span class="motivo-recuento motivo-recuento-proximos">@MotivoProximos(centro.Recuentos.TotalProximas)</span>
                                                    </Disparador>
                                                    <Detalle>
                                                        @DesgloseIncidencias(centro, centro.Recuentos.Proximas)
                                                    </Detalle>
                                                </VentanaContexto>
                                            }
                                        </MotivoContenido>
                                    </EstadoFila>
                                }
                                else
                                {
                                    <EstadoFila Tono="EstadoCentroUi.Tono(centro.Estado, centro.CumplimientoPorcentaje)"
                                                Texto="@EstadoCentroUi.Texto(centro.Estado, centro.CumplimientoPorcentaje)"
                                                Correcto="EstadoCentroUi.EsCorrecto(centro.Estado, centro.CumplimientoPorcentaje)" />
                                }
                            </span>
                            <span class="ranura-recuento ranura-recuento-final">
                                @* Visitas SIN fusionar (DDL-035, OD-18). Ventana de contexto en los
                                   dos casos (antes solo la de varias visitas la tenía) — el badge
                                   de una sola visita es un recuento igual que cualquier otro (08 § 6,
                                   DDL-033), y sin ventana no dice cuántos trabajadores implica. *@
                                @if (visitas.Count == 1)
                                {
                                    <VentanaContexto Etiqueta="@($"1 visita programada: del {visita!.FechaInicio:dd/MM} al {visita.FechaFin:dd/MM}, {visita.TrabajadoresCount} trabajador(es)")"
                                                     Titulo="1 visita programada">
                                        <Disparador>
                                            <button type="button" class="badge-visita"
                                                    @onclick='() => NavigationManager.NavigateTo($"/visitas?q={Uri.EscapeDataString(centro.Nombre)}")'
                                                    @onclick:stopPropagation="true">
                                                Visita @visita!.FechaInicio.ToString("dd/MM")–@visita.FechaFin.ToString("dd/MM")
                                            </button>
                                        </Disparador>
                                        <Detalle>
                                            <span class="ventana-linea">@visita.FechaInicio.ToString("dd/MM") – @visita.FechaFin.ToString("dd/MM") · @visita.TrabajadoresCount trabajador(es)</span>
                                        </Detalle>
                                    </VentanaContexto>
                                }
                                else if (visitas.Count > 1)
                                {
                                    <VentanaContexto Etiqueta="@($"{visitas.Count} visitas programadas: {string.Join("; ", visitas.Select(v => $"del {v.FechaInicio:dd/MM} al {v.FechaFin:dd/MM}, {v.TrabajadoresCount} trabajador(es)"))}")"
                                                     Titulo="@($"{visitas.Count} visitas programadas")">
                                        <Disparador>
                                            <button type="button" class="badge-visita"
                                                    @onclick='() => NavigationManager.NavigateTo($"/visitas?q={Uri.EscapeDataString(centro.Nombre)}")'
                                                    @onclick:stopPropagation="true">
                                                @visitas.Count visitas
                                            </button>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var v in visitas)
                                            {
                                                <span class="ventana-linea">@v.FechaInicio.ToString("dd/MM") – @v.FechaFin.ToString("dd/MM") · @v.TrabajadoresCount trabajador(es)</span>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            </span>
                        </span>
                        @* Sin menú «⋯» (patrón de listados). Lo que hacía ese menú: «Vista rápida» es el
                           clic en la fila; «Abrir ficha 360», este icono; «Eliminar centro», la selección
                           múltiple (☑ de la cabecera o tecla «x») con «Eliminar seleccionados» y su «Deshacer». *@
                        <div class="tarjeta-fila-acordeon-acciones">
                            <Boton360 Nombre="@centro.Nombre" Href="@($"/centros/{centro.Id}")" />
                        </div>
                    </div>
                    @if (expandido)
                    {
                        @* Igual que antes con SeccionColapsable: el contenido solo se
                           monta al expandir, no se paga el render de 34 acordeones. *@
                        <div class="tarjeta-fila-acordeon-contenido">
                            @* El título es verdadero por construcción: el
                               acordeón se monta aquí con SoloIncidencias. *@
                            <p class="acordeon-centro-titulo">Asignaciones con incidencias</p>
                            <AcordeonAsignacionesCentro CentroId="centro.Id" CentroNombre="@centro.Nombre"
                                                          VisitaId="visita?.VisitaId" VisitaFechaFin="visita?.FechaFin"
                                                          EmpresaId="centro.EmpresaId" EmpresaNombre="@centro.EmpresaRazonSocial"
                                                          IncidenciasEmpresa="IncidenciasDeEmpresa(centro)"
                                                          SeleccionMultiple="_seleccionMultiple"
                                                          SoloIncidencias="true"
                                                          MostrarEnlacesCentro360="false"
                                                          AsignarEsPrimaria="false"
                                                          OnCambio="() => RefrescarCentroAsync(centro.Id)" />
                            @* Camino a Centro 360 SIEMPRE presente en la fila desplegada, y uno solo dentro
                               de ella (Lista Centros TALVEG.dc.html). Los enlaces que el acordeón pinta por
                               su cuenta son condicionales —solo con trabajadores al día ocultos o con el
                               estado «Todos al día»—, así que un centro con pendientes y sin ocultos no
                               ofrecía camino alguno a /centros/{id}; y cuando sí aparecían, se sumaban a
                               este. Por eso aquí se apagan (MostrarEnlacesCentro360="false"): el acordeón
                               también lo monta CentroDetalle, donde apuntaría a sí mismo. La fila lleva
                               además su icono 360 (patrón de listados), que está con o sin desplegar. *@
                            <div class="acordeon-centro-pie">
                                <a class="acordeon-centro-enlace-360" href="@($"/centros/{centro.Id}")">Ver el centro completo →</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Con 20 o menos y el tamaño mínimo, una sola página: el paginador no aporta nada. *@
        @if (MostrarPaginador)
        {
            <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="centro(s)" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        }
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nuevo centro"
                  HayCambios="() => HayCambiosCentro" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                  HayErroresDeCampo="_erroresCampo.Count > 0" OnGuardar="GuardarAsync"
                  AlDescartarPorNavegacion="CerrarFormulariosDescartando"
                  TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <ChildContent>
        @if (_padresFijadosPorCadena)
        {
            <div class="campo">
                <label>Cliente</label>
                <span>@_clienteNombreSoloLectura</span>
            </div>
            <div class="campo">
                <label>Empresa</label>
                <span>@_empresaNombreSoloLectura</span>
            </div>

            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="DesvincularPadresFijadosAsync">
                Cambiar Cliente/empresa
            </Boton>
        }
        else
        {
            <SelectorEntidad Etiqueta="Cliente" Placeholder="Busca o crea un Cliente…" Valor="@_clienteId"
                              ValorChanged="CambiarClienteCreacionAsync" Opciones="ClientesComoOpciones"
                              PermiteCrear="true" OnCrearSolicitado="AbrirCrearClienteInline" />

            <SelectorEntidad Etiqueta="Empresa" Placeholder="@(string.IsNullOrEmpty(_clienteId) ? "Elige primero un Cliente…" : "Busca o crea una empresa…")"
                              Valor="@_empresaId" ValorChanged="AlElegirEmpresa" Opciones="EmpresasComoOpciones"
                              Deshabilitado="@(string.IsNullOrEmpty(_clienteId))"
                              PermiteCrear="true" OnCrearSolicitado="AbrirCrearEmpresaInline" />
        }

        <CampoTexto Etiqueta="Nombre" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearCentroCommand.Nombre))" />
        <CampoTexto Etiqueta="Código de centro" Valor="@_codigoCentro" ValorChanged="v => _codigoCentro = v" />
        <CampoTexto Etiqueta="Dirección" Valor="@_direccion" ValorChanged="v => _direccion = v" />
        <CampoTexto Etiqueta="Contacto" Valor="@_contacto" ValorChanged="v => _contacto = v" />
        <CampoTexto Etiqueta="Contrato vigente hasta" Type="date" Valor="@_contratoVigenteHasta" ValorChanged="v => _contratoVigenteHasta = v" />
    </ChildContent>
    <PieExtra>
        <Boton Variante="VarianteBoton.Secundario" Cargando="_guardando" OnClick="GuardarYCrearOtroAsync">
            Añadir otro centro
        </Boton>
    </PieExtra>
    <Dialogos>
        <FormularioRapidoCliente @ref="_formularioRapidoCliente" Visible="_formularioRapidoClienteVisible" VisibleChanged="v => _formularioRapidoClienteVisible = v"
                                  NombreInicial="@_nombreParaCrearCliente" OnCreado="ManejarClienteCreadoAsync" OnCambio="AlCambiarFormularioRapido" />

        <FormularioRapidoEmpresa @ref="_formularioRapidoEmpresa" Visible="_formularioRapidoEmpresaVisible" VisibleChanged="v => _formularioRapidoEmpresaVisible = v"
                                  NombreInicial="@_nombreParaCrearEmpresa" ClienteIdParaVincular="@ClienteIdParaFormularioRapido"
                                  OnCreado="ManejarEmpresaCreadaAsync" OnCambio="AlCambiarFormularioRapido" />
    </Dialogos>
</DrawerFormulario>

@* Los modales rápidos de Cliente empresarial y Empresa se abren desde el drawer y no montan aviso propio: este cubre lo escrito
   en ellos. Con el del kit (el del drawer) se coordinan (S12, lote 2b): salir con cambios en los dos pregunta una sola vez. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosFormulariosRapidos" AlDescartar="CerrarFormulariosDescartando" />

@* Baja y asignación masiva son escrituras: un rol de solo lectura (Consulta) puede marcar filas pero no ve la barra. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true">
        <AccionesExtra>
            @* Item 4 del backlog Centro 360 — funcionalidad nueva sin contrato previo,
               mismo patrón que "Asignar a centro…" de /trabajadores (Fase B). *@
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _drawerAsignacion.AbrirAsync(_seleccionados)">
                Asignar a centros seleccionados…
            </Boton>
        </AccionesExtra>
    </BarraAccionesLote>
</SoloConEscritura>

<DrawerAsignacionMasiva @ref="_drawerAsignacion" OnGuardado="ManejarAsignacionMasivaGuardadaAsync" />

@* Corregir una incidencia desde la ventana de contexto del motivo («N vencidos», «M por vencer»), sin salir del listado. *@
<CaeManager.Web.Features.Documentos.Components.CorreccionIncidenciaDocumental @ref="_correccion" OnCorregida="RefrescarTrasCorreccionAsync" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} centro(s)?")"
    Mensaje="Se ocultará(n) de las listas activas y sus asignaciones activas quedarán dadas de baja. Podrás deshacer la eliminación desde el aviso que aparecerá, pero las asignaciones seguirán de baja; después, solo un Administrador de esta organización puede recuperarlos desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
</LimiteDeErrores>
