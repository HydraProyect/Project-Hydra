@page "/configuracion/lectura-ia"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Web.Features.Configuracion.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosConfiguracion> Textos

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>@Textos["LecturaIaTituloPagina"] — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    @if (!IntegradaEnConfiguracion)
    {
        <a href="/configuracion/ia" class="enlace-volver-configuracion">@Textos["LecturaIaVolver"]</a>
    }

    @* Mockup «Lectura IA TALVEG.dc.html», pantalla A. Su copy decía «qué se
       extrae y con qué umbral»: no existe ningún umbral configurable (el
       propio mockup lo anota y recomienda dejar de prometerlo), y tampoco es
       cierto que el Nivel 2 decida «qué se lee» — ver el comentario de la
       clase. El texto dice lo que el código hace. *@
    <CabeceraPagina Titulo="@Textos["LecturaIaTituloPagina"]" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>
            @Textos["LecturaIaDescripcionAntesEnlace"]
            <a href="/configuracion/tipos">@Textos["LecturaIaDescripcionEnlace"]</a>@Textos["LecturaIaDescripcionDespuesEnlace"]
        </Descripcion>
    </CabeceraPagina>

    <p class="texto-descriptivo nota-alcance-lectura-ia">
        @Textos["LecturaIaNotaAlcance"]
    </p>

    @if (_error)
    {
        <div role="alert">
            <EstadoVacio Titulo="@Textos["LecturaIaErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
                <Accion>
                    <Boton OnClick="ReintentarAsync" Cargando="_cargando">@Textos["BotonReintentar"]</Boton>
                </Accion>
            </EstadoVacio>
        </div>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_clientes.Count == 0)
    {
        @* Sin buscador: filtrar una lista vacía no lleva a ninguna parte (nota del mockup). *@
        <EstadoVacio NombreIcono="clientes"
                     Titulo="@Textos["LecturaIaVacioTitulo"]"
                     Descripcion="@Textos["LecturaIaVacioDescripcion"]" />
    }
    else
    {
        <div class="seleccion-cliente-lectura-ia">
            <CampoTexto Etiqueta="@Textos["LecturaIaBuscarEtiqueta"]" Valor="@_filtro" ValorChanged="v => _filtro = v" Placeholder="@Textos["LecturaIaBuscarPlaceholder"]" />

            @if (SinCoincidencias)
            {
                <p class="sin-coincidencias-lectura-ia" role="status">@Textos["LecturaIaSinCoincidencias", _filtro.Trim()]</p>
            }
            else
            {
                <ul class="lista-seleccion-cliente">
                    @foreach (var cliente in ClientesFiltrados)
                    {
                        <li @key="cliente.Id">
                            @* Un enlace, no un botón: navega de verdad a la configuración de ese Cliente empresarial. *@
                            <a href="@($"/clientes/{cliente.Id}/lectura-ia")" class="item-seleccion-cliente">
                                <span>@cliente.RazonSocial</span>
                                <span class="item-seleccion-cliente-flecha" aria-hidden="true">→</span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
