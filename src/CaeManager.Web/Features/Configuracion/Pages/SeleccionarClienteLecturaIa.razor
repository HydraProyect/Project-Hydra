@page "/configuracion/lectura-ia"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using MediatR
@inject IMediator Mediator
@inject NavigationManager NavigationManager

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Lectura IA por cliente — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    @if (!IntegradaEnConfiguracion)
    {
        <a href="/configuracion/ia" class="enlace-volver-configuracion">← Configuración</a>
    }

    @TituloPaginaIntegrable("Lectura IA por cliente")
    <p class="descripcion-seleccion-cliente">
        Qué se extrae y con qué umbral de confianza, por cliente. Elige un cliente para configurar su lectura IA.
    </p>

    @if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_clientes.Count == 0)
    {
        <EstadoVacio Titulo="No hay clientes en tu cartera" Descripcion="Da de alta un cliente para poder configurar su lectura IA." />
    }
    else
    {
        <CampoTexto Etiqueta="Buscar cliente" Valor="@_filtro" ValorChanged="v => _filtro = v" Placeholder="Razón social…" />

        <ul class="lista-seleccion-cliente">
            @foreach (var cliente in ClientesFiltrados)
            {
                <li>
                    <a href="@($"/clientes/{cliente.Id}/lectura-ia")" class="item-seleccion-cliente">@cliente.RazonSocial</a>
                </li>
            }
        </ul>
    }
</div>
