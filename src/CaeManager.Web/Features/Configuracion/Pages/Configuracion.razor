@page "/configuracion"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@using CaeManager.Web.Features.Configuracion.Components

<PageTitle>Configuración — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div>
        <div class="eyebrow-configuracion">Sistema</div>
        <h1 class="titulo-pagina">Configuración</h1>
    </div>

    <div class="hub-configuracion">
        <nav class="subnav-configuracion" aria-label="Secciones de configuración">
            @foreach (var grupo in Grupos)
            {
                <div class="grupo-subnav">
                    <div class="titulo-grupo-subnav">@grupo.Titulo</div>
                    @foreach (var entrada in grupo.Entradas)
                    {
                        var activa = entrada.Id == EntradaEfectiva;
                        <a href="@(entrada.Ruta ?? $"/configuracion?entry={entrada.Id}")"
                           class="@($"entrada-subnav {(activa ? "entrada-subnav-activa" : "")}")"
                           aria-current="@(activa ? "page" : null)">
                            <span class="icono-entrada-subnav">@entrada.Icono</span>
                            <span class="texto-entrada-subnav">
                                <span class="nombre-entrada-subnav">@entrada.Nombre</span>
                                <span class="descripcion-entrada-subnav">@entrada.Descripcion</span>
                            </span>
                        </a>
                    }
                </div>
            }
        </nav>

        <div class="contenido-configuracion">
            @{
                var actual = Buscar(EntradaEfectiva);
            }
            <div class="migas-configuracion">
                Configuración <span class="separador-migas">→</span> @(actual is null ? "" : GrupoDe(actual.Id)) <span class="separador-migas">→</span> <span class="miga-actual">@(actual?.Nombre)</span>
            </div>

            @if (EntradaEfectiva == "params")
            {
                <ParametrosSistemaPanel />
            }
            else if (EntradaEfectiva == "automatizaciones")
            {
                <AutomatizacionesPanel />
            }
            else
            {
                <div class="placeholder-configuracion">
                    <span class="icono-placeholder-configuracion"></span>
                    <span class="titulo-placeholder-configuracion">@(actual?.Nombre ?? "Sección no encontrada")</span>
                    <span class="descripcion-placeholder-configuracion">
                        @(actual is null
                            ? "No reconocemos esta sección."
                            : $"{actual.Descripcion}. Pantalla pendiente de especificación.")
                    </span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static string GrupoDe(string entradaId) =>
        Grupos.First(g => g.Entradas.Any(e => e.Id == entradaId)).Titulo;
}
