@*
    Panel "Automatizaciones" del hub de Configuración (Parte XVI PROMPT 08).
    A diferencia del mockup (4 trabajos ilustrativos con estado en memoria),
    lista los 4 trabajos de fondo reales del sistema con su estado
    persistido — CatalogoAutomatizaciones es la fuente de verdad de qué
    trabajos existen. "Recálculo nocturno de semáforo" del mockup no tiene
    contrapartida real (los estados se calculan en vivo, nunca en lote) y
    por eso no aparece aquí; a cambio sí aparece "Vigilancia de gestiones
    urgentes de visita", que no estaba en el mockup pero es un trabajo real.
*@
@using CaeManager.Application.Configuracion.Commands.ActualizarEstadoAutomatizacion
@using CaeManager.Application.Configuracion.Queries.ObtenerEstadoAutomatizaciones
@using MediatR
@using CaeManager.Web.Features.Configuracion.Recursos
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosConfiguracion> Textos

@if (_errorCarga)
{
    <EstadoVacio Titulo="@Textos["AutomatizacionesErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
        <Accion>
            <Boton OnClick="CargarAsync">@Textos["BotonReintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else
{
    <div class="cabecera-automatizaciones">
        <h2>@Textos["AutomatizacionesEncabezado"]</h2>
        <p>@Textos["AutomatizacionesEntradilla"]</p>
    </div>

    <div class="tabla-automatizaciones" role="table">
        <div class="fila-automatizaciones fila-cabecera" role="row">
            <span role="columnheader">@Textos["ColumnaNombre"]</span>
            <span role="columnheader">@Textos["ColumnaUltimaEjecucion"]</span>
            <span role="columnheader">@Textos["ColumnaProximoCiclo"]</span>
            <span role="columnheader">@Textos["ColumnaResultado"]</span>
            <span role="columnheader">@Textos["ColumnaEstado"]</span>
        </div>

        @foreach (var trabajo in _trabajos)
        {
            <div class="fila-automatizaciones" role="row">
                <span class="celda-nombre" role="cell">
                    <span class="nombre-trabajo">@trabajo.Nombre</span>
                    <span class="descripcion-trabajo">@trabajo.Descripcion</span>
                </span>
                <span role="cell">@FormatearUltimaEjecucion(trabajo.UltimaEjecucionUtc)</span>
                <span role="cell">@FormatearProximoCiclo(trabajo)</span>
                <span class="celda-resultado" role="cell">
                    @if (!EstaConfigurado(trabajo.Id))
                    {
                        <Badge Tono="TonoBadge.Neutro">@Textos["ResultadoNoConfigurado"]</Badge>
                    }
                    else if (trabajo.UltimaEjecucionUtc is null)
                    {
                        <Badge Tono="TonoBadge.Neutro">@Textos["ResultadoSinDatos"]</Badge>
                    }
                    else if (trabajo.UltimoResultadoExitoso == true)
                    {
                        <Badge Tono="TonoBadge.Exito">@Textos["ResultadoCorrecta"]</Badge>
                    }
                    else
                    {
                        <Badge Tono="TonoBadge.Peligro">@Textos["ResultadoFallida"]</Badge>
                    }
                    @if (FormatearDetalleResultado(trabajo) is { } detalle)
                    {
                        <span class="detalle-resultado">@detalle</span>
                    }
                </span>
                <span role="cell">
                    @if (!EstaConfigurado(trabajo.Id))
                    {
                        <span class="siempre-activo">@Textos["EstadoSinConfigurar"]</span>
                    }
                    else if (trabajo.Conmutable)
                    {
                        <button type="button" role="switch" aria-checked="@trabajo.Activo.ToString().ToLowerInvariant()"
                                aria-label="@Textos["AriaConmutarTrabajo", trabajo.Nombre]" class="@($"interruptor {(trabajo.Activo ? "interruptor-activo" : "")}")"
                                disabled="@(_actualizando.Contains(trabajo.Id))" @onclick="() => ConmutarAsync(trabajo)">
                            <span class="interruptor-pomo"></span>
                        </button>
                    }
                    else
                    {
                        <span class="siempre-activo">@Textos["EstadoSiempreActivo"]</span>
                    }
                </span>
            </div>
        }
    </div>

    <span class="nota-auditoria">@Textos["AutomatizacionesNotaPie"]</span>
}
