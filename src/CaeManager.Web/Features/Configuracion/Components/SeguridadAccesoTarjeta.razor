@using CaeManager.Application.Configuracion.Commands.ActualizarSeguridadAcceso
@using CaeManager.Application.Configuracion.Queries
@using CaeManager.Domain.Configuracion
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Features.Configuracion.Recursos
@using CaeManager.Web.Services
@using FluentValidation
@inject MediatR.IMediator Mediator
@inject ToastService ToastService
@inject Microsoft.Extensions.Localization.IStringLocalizer<TextosConfiguracion> Textos

@* Solo la ve quien puede cambiarla: el Administrador del Tenant (AutoridadSeguridadAcceso). Si la
   lectura falla, la tarjeta no se pinta y el resto de /configuracion sigue funcionando. *@
@if (_puedeEditar)
{
    <section class="seguridad-acceso" aria-labelledby="seg-titulo" aria-busy="@(_guardando ? "true" : null)" data-testid="seguridad-acceso">
        <div class="seguridad-cabecera">
            <h2 id="seg-titulo" class="seguridad-titulo">@Textos["SeguridadTitulo"]</h2>
            <span class="seguridad-entradilla">@Textos["SeguridadEntradilla"]</span>
        </div>

        <AvisoFormulario Mensaje="@_mensajeError" />

        <div class="seguridad-campo">
            <label for="seg-minutos" class="seguridad-etiqueta">@Textos["SeguridadMinutosEtiqueta"]</label>
            <div class="seguridad-control">
                <input id="seg-minutos" class="seguridad-minutos @(_errorMinutos is null ? null : "seguridad-minutos-error")" type="number"
                       min="@ParametroSistema.MinimoMinutosInactividadSesion" max="@ParametroSistema.MaximoMinutosInactividadSesion"
                       readonly="@_guardando" aria-invalid="@(_errorMinutos is null ? null : "true")"
                       aria-describedby="@(_errorMinutos is null ? "seg-minutos-ayuda" : "seg-minutos-error seg-minutos-ayuda")"
                       @bind="_minutos" />
                <span class="seguridad-unidad">@Textos["SeguridadMinutosUnidad"]</span>
            </div>
            @if (_errorMinutos is not null)
            {
                <div id="seg-minutos-error" class="seguridad-error" role="alert">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5"></path><path d="M12 16h.01"></path></svg>
                    <span>@_errorMinutos</span>
                </div>
            }
            <span id="seg-minutos-ayuda" class="seguridad-ayuda">@Textos["SeguridadMinutosRango"]<br />@Textos["SeguridadMinutosAyuda"]</span>
        </div>

        <div class="seguridad-campo-interruptor">
            <div class="seguridad-interruptor-fila">
                <button type="button" role="switch" class="seguridad-interruptor @(_exigeTodos ? "seguridad-interruptor-activo" : null)"
                        aria-checked="@(_exigeTodos ? "true" : "false")" aria-labelledby="seg-dos-pasos"
                        aria-describedby="@(_exigeTodos ? "seg-dos-pasos-fija seg-dos-pasos-aviso" : "seg-dos-pasos-fija")"
                        aria-disabled="@(_guardando ? "true" : null)" @onclick="Conmutar">
                    <span class="seguridad-interruptor-pista"></span>
                    <span class="seguridad-interruptor-pomo"></span>
                </button>
                <span id="seg-dos-pasos" class="seguridad-etiqueta">@Textos["SeguridadDosPasosEtiqueta"]</span>
            </div>
            <span id="seg-dos-pasos-fija" class="seguridad-ayuda seguridad-sangria">@Textos["SeguridadDosPasosFija"]</span>
            @if (_exigeTodos)
            {
                <div id="seg-dos-pasos-aviso" class="seguridad-aviso" role="status">
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
                    <span>@Textos["SeguridadDosPasosAviso"]</span>
                </div>
            }
        </div>

        <div class="seguridad-acciones">
            <Boton Variante="VarianteBoton.Primario" OnClick="GuardarAsync" Cargando="_guardando">@(_guardando ? Textos["SeguridadGuardando"] : Textos["SeguridadGuardar"])</Boton>
        </div>
    </section>
}

@code {
    private bool _puedeEditar;
    private bool _guardando;
    private string _minutos = string.Empty;
    private bool _exigeTodos;
    private string? _errorMinutos;
    private string? _mensajeError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Mediator.Send(new ObtenerSeguridadAccesoQuery()) is not { PuedeEditar: true } ajuste) return;

            _minutos = ajuste.MinutosInactividadSesion.ToString();
            _exigeTodos = ajuste.ExigeSegundoFactorTodosLosPerfiles;
            _puedeEditar = true;
        }
        catch (Exception)
        {
            _puedeEditar = false;
        }
    }

    private void Conmutar()
    {
        if (!_guardando) _exigeTodos = !_exigeTodos;
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _errorMinutos = null;
        _mensajeError = null;
        StateHasChanged();

        try
        {
            var resultado = await Mediator.Send(new ActualizarSeguridadAccesoCommand(
                int.TryParse(_minutos, out var minutos) ? minutos : 0, _exigeTodos));

            if (resultado.EsFallido)
            {
                _mensajeError = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar(Textos["ToastSeguridadActualizada"], TonoToast.Exito);
        }
        catch (ValidationException ex)
        {
            _errorMinutos = ex.Errors.First().ErrorMessage;
        }
        catch (Exception)
        {
            _mensajeError = Textos["ErrorGuardarCambios"];
        }
        finally
        {
            _guardando = false;
        }
    }
}
