@*
    Panel "Parámetros del sistema" del hub de Configuración (Parte XVI
    PROMPT 08) — contenido movido tal cual desde la antigua Configuracion.razor
    de página única, sin tocar su lógica. El mockup solo especifica los dos
    campos de Umbrales de alerta bajo este nombre; "Jornada y medición de
    tiempo" y "Presupuesto de IA" se conservan aquí debajo porque conceptualmente
    también son parámetros del sistema y ya existían — el mockup no dice que
    esta pantalla deba tener SOLO esos dos campos, solo no llegó a mockear los
    demás.
*@
@using CaeManager.Application.Configuracion.Commands.ActualizarConfiguracionOperativa
@using CaeManager.Application.Configuracion.Commands.ActualizarParametroSistema
@using CaeManager.Application.Configuracion.Commands.ActualizarPresupuestoIa
@using CaeManager.Application.Configuracion.Queries
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Configuracion.Recursos
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosConfiguracion> Textos

@if (_errorCarga)
{
    <EstadoVacio Titulo="@Textos["ParametrosErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
        <Accion>
            <Boton OnClick="CargarAsync">@Textos["BotonReintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="2" />
}
else
{
    <Tarjeta Titulo="@Textos["UmbralesTitulo"]" Class="tarjeta-configuracion">
        <p class="descripcion-configuracion">
            @Textos["UmbralesDescripcion"]
        </p>

        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="@Textos["UmbralProximoEtiqueta"]" Type="number" Valor="@_umbralAmbarDias" ValorChanged="v => _umbralAmbarDias = v"
                    MensajeError="@ObtenerError(nameof(ActualizarParametroSistemaCommand.UmbralAmbarDias))" />
        <CampoTexto Etiqueta="@Textos["UmbralUrgenteEtiqueta"]" Type="number" Valor="@_umbralRojoDias" ValorChanged="v => _umbralRojoDias = v"
                    MensajeError="@ObtenerError(nameof(ActualizarParametroSistemaCommand.UmbralRojoDias))" />

        <div class="acciones-formulario">
            <Boton OnClick="GuardarAsync" Cargando="_guardando">@Textos["BotonGuardarCambios"]</Boton>
        </div>
    </Tarjeta>

    <Tarjeta Titulo="@Textos["JornadaTitulo"]" Class="tarjeta-configuracion">
        <p class="descripcion-configuracion">
            @Textos["JornadaDescripcion"]
        </p>

        @if (_mensajeErrorOperativa is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorOperativa</div>
        }

        <CampoTexto Etiqueta="@Textos["InicioJornadaEtiqueta"]" Type="time" Valor="@_horaInicioJornada" ValorChanged="v => _horaInicioJornada = v"
                    MensajeError="@ObtenerErrorOperativa(nameof(ActualizarConfiguracionOperativaCommand.HoraInicioJornada))" />
        <CampoTexto Etiqueta="@Textos["FinJornadaEtiqueta"]" Type="time" Valor="@_horaFinJornada" ValorChanged="v => _horaFinJornada = v"
                    MensajeError="@ObtenerErrorOperativa(nameof(ActualizarConfiguracionOperativaCommand.HoraFinJornada))" />
        <CampoTexto Etiqueta="@Textos["HorasMesEtiqueta"]" Type="number" Valor="@_horasJornadaMensualGestor" ValorChanged="v => _horasJornadaMensualGestor = v"
                    MensajeError="@ObtenerErrorOperativa(nameof(ActualizarConfiguracionOperativaCommand.HorasJornadaMensualGestor))" />

        <p class="descripcion-configuracion">
            @Textos["MedicionDescripcion"]
        </p>

        <label class="campo-checkbox">
            <input type="checkbox" @bind="_medicionTiempoActiva" /> @Textos["MedicionActivarEtiqueta"]
        </label>

        <CampoTexto Etiqueta="@Textos["SegundosSinFocoEtiqueta"]" Type="number" Valor="@_segundosInactividadPausa" ValorChanged="v => _segundosInactividadPausa = v"
                    MensajeError="@ObtenerErrorOperativa(nameof(ActualizarConfiguracionOperativaCommand.SegundosInactividadPausa))" />

        <label class="campo-checkbox">
            <input type="checkbox" @bind="_excluirFueraDeJornadaEnMetricas" /> @Textos["ExcluirFueraJornadaEtiqueta"]
        </label>

        <div class="acciones-formulario">
            <Boton OnClick="GuardarOperativaAsync" Cargando="_guardandoOperativa">@Textos["BotonGuardarCambios"]</Boton>
        </div>
    </Tarjeta>

    <Tarjeta Titulo="@Textos["PresupuestoTitulo"]" Class="tarjeta-configuracion">
        <p class="descripcion-configuracion">
            @Textos["PresupuestoDescripcion"]
        </p>

        @if (_mensajeErrorPresupuestoIa is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorPresupuestoIa</div>
        }

        <CampoTexto Etiqueta="@Textos["PresupuestoMensualEtiqueta"]" Type="number" Valor="@_presupuestoMensualIaUsd" ValorChanged="v => _presupuestoMensualIaUsd = v" />

        <div class="acciones-formulario">
            <Boton OnClick="GuardarPresupuestoIaAsync" Cargando="_guardandoPresupuestoIa">@Textos["BotonGuardarCambios"]</Boton>
        </div>
    </Tarjeta>
}
