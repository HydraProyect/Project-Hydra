@using CaeManager.Web.Features.IncorporacionCartera.Recursos
@using Microsoft.Extensions.Localization

<div class="aviso-sin-asignacion-cartera" data-estado="sin-asignacion-cartera">
    <EstadoVacio NombreIcono="cartera"
                 Titulo="@(Titulo ?? Textos["SinAsignacionTitulo"])"
                 Descripcion="@(Descripcion ?? Textos[_esCoordinador ? "SinAsignacionDetalleCoordinador" : "SinAsignacionDetalle"])">
        <Accion>
            @if (_esCoordinador)
            {
                <a class="enlace-ver-todas" data-enlace="usuarios" href="/usuarios">@Textos["SinAsignacionEnlaceUsuarios"]</a>
            }
            @if (_puedeAnadirACartera)
            {
                <Boton Variante="VarianteBoton.Primario" OnClick="() => _dialogoVisible = true">@Textos["SinAsignacionAnadir"]</Boton>
            }
        </Accion>
    </EstadoVacio>
</div>

@if (_puedeAnadirACartera)
{
    <DialogoSolicitarIncorporacion @bind-Visible="_dialogoVisible" OnSolicitada="_ => CargarCandidatosAsync()" />
}
