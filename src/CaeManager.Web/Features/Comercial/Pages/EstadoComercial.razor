@page "/configuracion/comercial"
@rendermode InteractiveServer
@attribute [Authorize]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@* Las operaciones comerciales de plataforma las autoriza AdminPlataforma (A3), no el rol Administrador de Identity.
   Mantener el rol crearía un AND que no forma parte del contrato de la
   capacidad — y desde F2b-2 el claim de rol se retira bajo sesión
   privilegiada, así que la UI dependería de una autoridad que el plano 3
   deliberadamente no conserva.

   La página no es el enforcement: ese vive en el comando. Que alguien vea
   la ruta y el comando la rechace no es una vulnerabilidad. *@
@using CaeManager.Domain.Tenants

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Estado comercial — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    <CabeceraPagina Titulo="Estado comercial de los tenants" Kicker="Plataforma" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>
            La suscripción se crea en Stripe, fuera de TALVEG; aquí solo se vincula su identificador. Cuando Stripe
            notifica un cambio por webhook, el estado comercial se aplica solo; «Actualizar desde Stripe» lo consulta
            a mano. Cada fila es un tenant: el Tenant beneficiario de su suscripción. Quién la paga —el Pagador
            TALVEG— lo sabe Stripe, no esta tabla, y no tiene por qué coincidir con el Tenant propietario.
        </Descripcion>
    </CabeceraPagina>

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar el estado comercial"
                     Descripcion="La lista de tenants no se ha podido obtener. No se ha modificado nada."
                     NombreIcono="advertencia"
                     AcentoIcono="var(--color-danger-500)"
                     FondoIcono="var(--color-danger-50)">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" Cargando="_cargando" OnClick="ReintentarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (!_listaPintada)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_tenants.Count == 0)
    {
        <EstadoVacio Titulo="No hay ningún tenant todavía"
                     Descripcion="Los tenants aparecerán aquí en cuanto existan. Si esperabas verlos, esta vista requiere la capacidad de administración de plataforma con alcance global; sin ella, la lista llega vacía."
                     NombreIcono="cartera" />
    }
    else
    {
        <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

        <div class="estado-comercial-tabla">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Estado comercial</th>
                        <th>Suscripción de Stripe</th>
                        <th>Actualizado</th>
                        <th><span class="estado-comercial-oculto">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in _tenants)
                    {
                        <tr @key="tenant.TenantId" class="@(tenant.TenantId == _idEnfocado ? "fila-enfocada" : null)"
                            data-tenant-id="@tenant.TenantId">
                            <td class="estado-comercial-nombre">@tenant.Nombre</td>
                            <td><Badge Tono="@TonoDe(tenant.EstadoComercial)">@TextoDe(tenant.EstadoComercial)</Badge></td>
                            <td>
                                @if (tenant.StripeSubscriptionId is { } idSuscripcion)
                                {
                                    <button type="button" class="estado-comercial-id" title="Copiar el id de suscripción"
                                            @onclick="() => CopiarIdAsync(idSuscripcion)">@idSuscripcion</button>
                                }
                                else
                                {
                                    <span class="estado-comercial-sin-id">—</span>
                                }
                            </td>
                            <td class="estado-comercial-fecha">@TextoActualizado(tenant)</td>
                            <td class="columna-accion">
                                @if (tenant.StripeSubscriptionId is null)
                                {
                                    <Boton Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirVincular(tenant)">Vincular suscripción</Boton>
                                }
                                else
                                {
                                    <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Secundario"
                                           Cargando="@(_actualizandoTenantId == tenant.TenantId)"
                                           OnClick="() => PedirConfirmacionActualizar(tenant)">
                                        Actualizar desde Stripe
                                    </Boton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<Modal Visible="FormularioVincularVisible" VisibleChanged="CerrarFormularioVincular"
       Titulo="Vincular suscripción de Stripe" CerrarAlHacerClicFuera="!_vinculando">
    <ChildContent>
        @if (_tenantAVincular is not null)
        {
            <div class="estado-comercial-formulario">
                <p class="texto-descriptivo">
                    Tenant: <strong>@_tenantAVincular.Nombre</strong>. Pega el identificador de la suscripción creada
                    en Stripe. Quién la paga en Stripe y su estado inicial se leen de la propia suscripción, no de lo
                    que escribas aquí.
                </p>

                <div>
                    <CampoTexto Etiqueta="Id de suscripción de Stripe" Valor="@_stripeSubscriptionId"
                                ValorChanged="CambiarIdSuscripcion" Placeholder="sub_…"
                                autocomplete="off" spellcheck="false" />
                    <p class="estado-comercial-pista">Empieza por sub_ y se puede copiar del panel de Stripe.</p>
                </div>

                @if (_errorVincular is not null)
                {
                    <div class="alerta-formulario" role="alert">@_errorVincular</div>
                }
            </div>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_vinculando" OnClick="() => CerrarFormularioVincular(false)">Cancelar</Boton>
        <Boton Cargando="_vinculando" OnClick="PedirConfirmacionVincular">Vincular</Boton>
    </Pie>
</Modal>

<DialogoConfirmacion Visible="ConfirmacionVincularVisible" VisibleChanged="CerrarConfirmacionVincular"
                     Titulo="¿Vincular esta suscripción?"
                     Mensaje="@MensajeConfirmacionVincular"
                     TextoBotonConfirmar="Vincular suscripción"
                     EnProgreso="_vinculando"
                     OnConfirmar="VincularAsync" />

<DialogoConfirmacion Visible="_tenantAActualizar is not null" VisibleChanged="CerrarConfirmacionActualizar"
                     Titulo="¿Actualizar el estado comercial desde Stripe?"
                     Mensaje="@MensajeConfirmacionActualizar"
                     TextoBotonConfirmar="Actualizar desde Stripe"
                     EnProgreso="_actualizandoTenantId is not null"
                     OnConfirmar="ActualizarDesdeStripeAsync" />

@code {
    private static TonoBadge TonoDe(EstadoComercialTenant estado) => estado switch
    {
        EstadoComercialTenant.Activa => TonoBadge.Exito,
        EstadoComercialTenant.AvisoImpago => TonoBadge.Advertencia,
        EstadoComercialTenant.SoloLectura => TonoBadge.Advertencia,
        EstadoComercialTenant.Suspendida => TonoBadge.Peligro,
        _ => TonoBadge.Neutro,
    };

    private static string TextoDe(EstadoComercialTenant estado) => estado switch
    {
        EstadoComercialTenant.SinSuscripcion => "Sin suscripción",
        EstadoComercialTenant.Activa => "Activa",
        EstadoComercialTenant.AvisoImpago => "Aviso de impago",
        EstadoComercialTenant.SoloLectura => "Solo lectura",
        EstadoComercialTenant.Suspendida => "Suspendida",
        _ => estado.ToString(),
    };
}
