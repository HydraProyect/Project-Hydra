@namespace CaeManager.Web.Features.AtajosGlobales

<Modal Visible="_ayudaVisible" VisibleChanged="v => _ayudaVisible = v" Titulo="Atajos de teclado">
    <ChildContent>
        <div class="chuleta-atajos">
            <section>
                <h3>Navegación</h3>
                @foreach (var atajo in CatalogoAtajos.Navegacion)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@atajo.Descripcion</span>
                    </div>
                }
            </section>
            <section>
                <h3>Acciones</h3>
                @foreach (var atajo in CatalogoAtajos.Acciones)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@atajo.Descripcion</span>
                    </div>
                }
            </section>
            <section>
                <h3>Dentro de una lista</h3>
                @foreach (var atajo in CatalogoAtajos.Lista)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@atajo.Descripcion</span>
                    </div>
                }
            </section>
            <section>
                <h3>Sobre una fecha</h3>
                <div class="chuleta-atajos-fila"><kbd>Clic</kbd><span>Copiar vencimiento</span></div>
                <div class="chuleta-atajos-fila"><kbd>Alt/Option + clic</kbd><span>Copiar emisión, cuando esté disponible</span></div>
            </section>
        </div>
    </ChildContent>
</Modal>
