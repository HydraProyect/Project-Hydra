@namespace CaeManager.Web.Features.AtajosGlobales
@using CaeManager.Web.Features.AtajosGlobales.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosAtajosGlobales> Textos
@inherits CaeManager.Web.Components.IsloteInteractivo

<LimiteDeErrores Islote="this">
<Modal Visible="_ayudaVisible" VisibleChanged="v => _ayudaVisible = v" Titulo="@Textos["TituloAyuda"]">
    <ChildContent>
        <div class="chuleta-atajos">
            <section>
                <h3>@Textos["SeccionNavegacion"]</h3>
                @foreach (var atajo in CatalogoAtajos.Navegacion)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@Textos[atajo.ClaveDescripcion]</span>
                    </div>
                }
            </section>
            <section>
                <h3>@Textos["SeccionAcciones"]</h3>
                @foreach (var atajo in CatalogoAtajos.Acciones)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@Textos[atajo.ClaveDescripcion]</span>
                    </div>
                }
            </section>
            <section>
                <h3>@Textos["SeccionLista"]</h3>
                @foreach (var atajo in CatalogoAtajos.Lista)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@Textos[atajo.ClaveDescripcion]</span>
                    </div>
                }
            </section>
            <section>
                <h3>@Textos["SeccionFicha"]</h3>
                @foreach (var atajo in CatalogoAtajos.Ficha)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@Textos[atajo.ClaveDescripcion]</span>
                    </div>
                }
            </section>
            @* KeyTips: los gestos, las letras estables que hoy tienen control y, para quien no
               usa el teclado, un botón que enciende el modo (cierra la chuleta primero). *@
            <section>
                <h3>@Textos["SeccionKeyTips"]</h3>
                @foreach (var atajo in CatalogoAtajos.KeyTipsGestos)
                {
                    <div class="chuleta-atajos-fila">
                        <kbd>@atajo.Tecla</kbd>
                        <span>@Textos[atajo.ClaveDescripcion]</span>
                    </div>
                }
                <div class="chuleta-atajos-letras">
                    @foreach (var atajo in CatalogoAtajos.KeyTips.Where(a => CatalogoAtajos.KeyTipsConControl.Contains(a.Tecla)))
                    {
                        <span class="chuleta-atajos-letra"><kbd>@atajo.Tecla</kbd> @Textos[atajo.ClaveDescripcion]</span>
                    }
                </div>
                <p class="chuleta-atajos-nota">@Textos["KeyTipsNotaDeducidas"]</p>
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MostrarKeyTipsAsync">@Textos["KeyTipsMostrar"]</Boton>
            </section>
            <section>
                <h3>@Textos["SeccionFecha"]</h3>
                <div class="chuleta-atajos-fila"><kbd>@Textos["TeclaClic"]</kbd><span>@Textos["FechaCopiarVencimiento"]</span></div>
                <div class="chuleta-atajos-fila"><kbd>@Textos["TeclaAltClic"]</kbd><span>@Textos["FechaCopiarEmision"]</span></div>
            </section>
        </div>
    </ChildContent>
</Modal>
</LimiteDeErrores>
