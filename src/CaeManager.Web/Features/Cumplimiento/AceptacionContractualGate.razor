@*
    Aceptación de los documentos contractuales obligatorios fuera del alta (#2009, decisión D-6 del
    2026-11-15): mientras el Tenant propietario tenga una versión vigente sin aceptar, su Administrador
    queda bloqueado por este modal hasta que la acepte. Mismo patrón que AceptacionTerminosGate: montado
    una sola vez en MainLayout, dentro de AuthorizeView/Authorized, con su propio @@rendermode.

    Solo bloquea al Administrador del Tenant propietario: para cualquier otra cuenta (otro rol, Gestor CAE
    o Administrador de un Operador CAE externo, Actor de Plataforma TALVEG, impersonación) la consulta
    devuelve una lista vacía y este gate no pinta nada.

    Con el catálogo vacío no se bloquea a nadie: hoy CatalogoDocumentosContractuales (Infrastructure) no
    publica ningún documento, porque los textos son borradores del abogado, así que la consulta devuelve
    siempre una lista vacía y este modal no aparece. Lo fija AceptacionContractualGateTests.

    Tampoco bloquea mientras las escrituras del Tenant propietario estén bloqueadas por su estado (solo
    lectura o suspensión): la consulta devuelve vacío, porque el Command se rechazaría siempre y el modal
    no tendría salida. Si la consulta falla, en cambio, no deja pasar: pinta un modal de error con un
    botón para reintentar.

    La IP de quien acepta es la del contexto HTTP del prerenderizado, como en el alta: en el circuito no
    hay HttpContext, así que se lee al prerenderizar y pasa al circuito por el estado persistido. Se lee
    del HttpContext en cascada y, si no llega, de IHttpContextAccessor (como MainLayout).
*@
@using CaeManager.Application.Common
@using CaeManager.Application.Cumplimiento.AceptacionContractual
@using CaeManager.Web.Features.Cumplimiento.Recursos
@using MediatR
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject IStringLocalizer<TextosAceptacionContractual> Textos
@inject PersistentComponentState EstadoPersistente
@inject IServiceProvider Servicios
@inject NavigationManager Navegacion
@inject IHttpContextAccessor HttpContextAccessor
@inherits CaeManager.Web.Components.IsloteInteractivo

<LimiteDeErrores Islote="this">
@if (_errorConsulta)
{
    @* No es un formulario: un Modal bloqueante con un único primario, sin nada que guardar ni descartar. *@
    <Modal Visible="true" Titulo="@Textos["TituloErrorConsulta"]" Bloqueante="true">
        <ChildContent>
            <p class="gate-contractual-error">@Textos["ErrorConsulta"]</p>
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Primario" Deshabilitado="_consultando" OnClick="ReintentarAsync">@Textos["BotonReintentar"]</Boton>
        </Pie>
    </Modal>
}
else if (_pendientes.Count > 0)
{
    <ModalFormulario Visible="true" Titulo="@Textos["TituloModal"]" Bloqueante="true" Ancho="AnchoModal.Grande"
                     HayCambios="() => _marcados.Count > 0 || _facultades" Guardando="_aceptando" MensajeError="@_error"
                     MotivoGuardarDeshabilitado="@(!TodoMarcado ? Textos["MotivoAceptar"].Value : null)"
                     TextoGuardar="@Textos["BotonAceptar"]" TextoCancelar="" OnGuardar="AceptarAsync">
        <ChildContent>
            <p class="texto-consentimiento">@Textos["Introduccion", Marca.Nombre]</p>
            @foreach (var documento in _pendientes)
            {
                <p class="documento-contractual-pendiente" data-documento="@documento.Documento">
                    <label class="campo-checkbox">
                        <input type="checkbox" checked="@_marcados.Contains(documento.Documento)"
                               @onchange="e => Marcar(documento.Documento, (bool)e.Value!)" />
                        @Textos["CasillaDocumento", documento.Titulo, documento.Version]
                    </label>
                    <a href="@EnlaceTexto(documento)" target="_blank" rel="noopener noreferrer">@Textos["EnlaceTexto"]</a>
                </p>
            }
            <label class="campo-checkbox campo-facultades">
                <input type="checkbox" checked="@_facultades" @onchange="e => _facultades = (bool)e.Value!" />
                @Textos["CasillaFacultades"]
            </label>
        </ChildContent>
    </ModalFormulario>
}
</LimiteDeErrores>

@code {
    /// <summary>Solo en el prerenderizado: de ahí sale la IP de quien acepta (o del accesor si no llega).</summary>
    [CascadingParameter] public HttpContext? ContextoHttp { get; set; }

    private IReadOnlyList<DocumentoContractualPendienteDto> _pendientes = [];
    private readonly HashSet<string> _marcados = new(StringComparer.Ordinal);
    private bool _facultades;
    private bool _aceptando;
    private bool _errorConsulta;
    private bool _consultando;
    private string? _error;
    private string? _ip;
    private PersistingComponentStateSubscription _persistencia;
    private EstadoGate? _estado;
    private const string ClavePersistencia = "gate-contractual-estado-v1";

    /// <summary>
    /// Lo que el prerenderizado deja al circuito: de qué usuario es, cuándo se leyó, qué tenía pendiente y la IP
    /// de la petición. Lo pendiente solo se reutiliza dentro de la caducidad de las lecturas del layout; la IP, para
    /// el mismo usuario, siempre, porque el circuito no tiene otra forma de conocerla.
    /// </summary>
    public sealed record EstadoGate(Guid Usuario, DateTimeOffset Creado, IReadOnlyList<DocumentoContractualPendienteDto> Pendientes, string? Ip);

    private bool TodoMarcado => _facultades && _pendientes.All(d => _marcados.Contains(d.Documento));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuario = Servicios.GetService<ICurrentUserService>() is { } actual
                ? await actual.ObtenerUsuarioActualIdAsync() : null;
            var anterior = Restaurar(usuario);
            _ip = IpDeLaPeticion() ?? anterior?.Ip;
            if (anterior is not null && Vigente(anterior))
                _pendientes = anterior.Pendientes;
            else
                _pendientes = await Mediator.Send(new ObtenerAceptacionesContractualesPendientesQuery());

            if (usuario is { } leido)
                _estado = new(leido, DateTimeOffset.UtcNow, _pendientes, _ip);
        }
        catch (Exception)
        {
            // Falla cerrado (revisión Codex de la PR #2270): una consulta que falla no es «sin pendientes». Nada más
            // bloquea al Administrador del Tenant propietario mientras le falte aceptar, así que tomar el error por
            // una lista vacía le dejaría seguir sin aceptar. El modal de error bloquea también a cualquier otra
            // cuenta, porque sin la consulta no se sabe si es quien acepta; la consulta no lanza para quien no
            // acepta (le devuelve una lista vacía), así que a esas cuentas solo las retiene un fallo real, con el
            // reintento a mano.
            _pendientes = [];
            _errorConsulta = true;
        }
        _persistencia = EstadoPersistente.RegisterOnPersisting(PersistirAsync);
    }

    private async Task ReintentarAsync()
    {
        _consultando = true;
        try
        {
            _pendientes = await Mediator.Send(new ObtenerAceptacionesContractualesPendientesQuery());
            _errorConsulta = false;
        }
        catch (Exception)
        {
            _errorConsulta = true;
        }
        finally
        {
            _consultando = false;
        }
    }

    private string? IpDeLaPeticion()
    {
        // El HttpContext en cascada no está garantizado en un componente InteractiveServer montado en el layout;
        // sin IP cada clic recargaría la página y el Administrador no saldría del modal. El accesor cubre ese hueco
        // en el prerenderizado; si ninguno de los dos trae contexto, queda la IP persistida.
        var ip = (ContextoHttp ?? HttpContextAccessor.HttpContext)?.Connection.RemoteIpAddress;
        return ip is null ? null : (ip.IsIPv4MappedToIPv6 ? ip.MapToIPv4() : ip).ToString();
    }

    /// <summary>Lo que dejó el prerenderizado, si es del mismo usuario. Un estado ilegible se ignora y se consulta.</summary>
    private EstadoGate? Restaurar(Guid? usuario)
    {
        try
        {
            return EstadoPersistente.TryTakeFromJson<EstadoGate>(ClavePersistencia, out var anterior)
                && anterior is { Pendientes: not null } && usuario is { } id && anterior.Usuario == id
                ? anterior
                : null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private static bool Vigente(EstadoGate estado) =>
        DateTimeOffset.UtcNow - estado.Creado is var edad && edad >= TimeSpan.Zero && edad < MemoPorContexto.Caducidad;

    private Task PersistirAsync()
    {
        if (_estado is { } estado)
            EstadoPersistente.PersistAsJson(ClavePersistencia, estado);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistencia.Dispose();

    private void Marcar(string documento, bool marcado)
    {
        if (marcado) _marcados.Add(documento);
        else _marcados.Remove(documento);
    }

    private static string EnlaceTexto(DocumentoContractualPendienteDto documento) =>
        $"/legal/contrato/{Uri.EscapeDataString(documento.Documento)}/{Uri.EscapeDataString(documento.Version)}";

    private async Task AceptarAsync()
    {
        if (!TodoMarcado) return;

        if (_ip is null)
        {
            // Un circuito sin prerenderizado (reconexión, navegación sin recarga) no trae la IP, y el Command la
            // exige. Sin esto el modal no se podría cerrar nunca: se recarga la página, el prerenderizado la lee y
            // el Administrador vuelve a marcar las casillas.
            Navegacion.NavigateTo(Navegacion.Uri, forceLoad: true);
            return;
        }

        _aceptando = true;
        _error = null;
        try
        {
            var resultado = await Mediator.Send(new AceptarDocumentosContractualesCommand(
                _pendientes.Select(d => new DocumentoContractualAceptado(d.Documento, d.Version, d.HashSha256)).ToList(),
                DeclaraFacultades: _facultades, _ip));
            if (resultado.EsFallido)
            {
                _error = resultado.Error.Mensaje;
                // Si lo pendiente cambió con el modal abierto (otra versión publicada, otra cuenta que ya aceptó),
                // se vuelve a leer: con la lista vieja el Command fallaría siempre igual.
                var actuales = await Mediator.Send(new ObtenerAceptacionesContractualesPendientesQuery());
                if (!actuales.SequenceEqual(_pendientes))
                {
                    _pendientes = actuales;
                    _marcados.Clear();
                    _facultades = false;
                }
                return;
            }

            _pendientes = await Mediator.Send(new ObtenerAceptacionesContractualesPendientesQuery());
            _marcados.Clear();
            _facultades = false;
        }
        catch (Exception)
        {
            _error = Textos["ErrorRegistro"];
        }
        finally
        {
            _aceptando = false;
        }
    }
}
