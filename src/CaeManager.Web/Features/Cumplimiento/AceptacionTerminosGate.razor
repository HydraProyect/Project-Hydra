@*
    Aceptación obligatoria de Términos y Condiciones + Política de Privacidad
    (docs/business/DECISION_LOG.md 2026-08-08). Montado una sola vez en
    MainLayout, dentro de AuthorizeView/Authorized — mismo criterio que
    ContextWorkspace/AsistenteIa: necesita su propio @@rendermode porque todo
    lo que vive fuera de @@Body no hereda el modo interactivo del Body.

    Cubre "usuario nuevo" (nunca aceptó) y "usuario existente tras un cambio
    material de los términos" (VersionTerminos.Actual subió) con el mismo
    mecanismo — no hace falta distinguir los dos casos.
*@
@using CaeManager.Application.Cumplimiento.Commands.AceptarTerminos
@using CaeManager.Application.Cumplimiento.Queries.ObtenerEstadoAceptacionTerminos
@using CaeManager.Web.Features.Cumplimiento.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject IStringLocalizer<TextosCumplimiento> Textos

@if (_debeAceptar)
{
    <Modal Visible="true" Titulo="@Textos["TituloModal"]" Bloqueante="true" Ancho="AnchoModal.Grande">
        <ChildContent>
            <p class="texto-consentimiento">@Textos["TextoConsentimiento", Marca.Nombre]</p>
            <p>
                <a href="/legal/terminos" target="_blank" rel="noopener noreferrer">@Textos["EnlaceTerminos"]</a>
                &nbsp;·&nbsp;
                <a href="/legal/privacidad" target="_blank" rel="noopener noreferrer">@Textos["EnlacePrivacidad"]</a>
            </p>
            <label class="campo-checkbox">
                <input type="checkbox" checked="@_marcado" @onchange="e => _marcado = (bool)e.Value!" />
                @Textos["CasillaAceptacion"]
            </label>
            @if (_error is not null)
            {
                <div class="alerta-formulario" role="alert">@_error</div>
            }
        </ChildContent>
        <Pie>
            <Boton Deshabilitado="!_marcado" Cargando="_aceptando" OnClick="AceptarAsync">@Textos["BotonAceptar"]</Boton>
        </Pie>
    </Modal>
}

@code {
    private bool _debeAceptar;
    private bool _marcado;
    private bool _aceptando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _debeAceptar = await Mediator.Send(new ObtenerEstadoAceptacionTerminosQuery());
        }
        catch (Exception)
        {
            // Mejor esfuerzo: si la comprobación falla (p. ej. circuito
            // recién abierto sin sesión resuelta todavía), no bloquea al
            // usuario con un gate que no puede completar — se reintenta en
            // la siguiente navegación/render.
            _debeAceptar = false;
        }
    }

    private async Task AceptarAsync()
    {
        if (!_marcado) return;

        _aceptando = true;
        _error = null;
        try
        {
            var resultado = await Mediator.Send(new AceptarTerminosCommand());
            if (resultado.EsFallido)
            {
                _error = resultado.Error.Mensaje;
                return;
            }

            _debeAceptar = false;
        }
        catch (Exception)
        {
            _error = Textos["ErrorRegistro"];
        }
        finally
        {
            _aceptando = false;
        }
    }
}
