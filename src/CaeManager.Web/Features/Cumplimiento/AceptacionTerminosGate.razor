@*
    Aceptación obligatoria de Términos y Condiciones + Política de Privacidad
    (Project-Hydra-Negocio/DECISION_LOG.md 2026-08-08). Montado una sola vez en
    MainLayout, dentro de AuthorizeView/Authorized — mismo criterio que
    ContextWorkspace/AsistenteIa: necesita su propio @@rendermode porque todo
    lo que vive fuera de @@Body no hereda el modo interactivo del Body.

    Cubre "usuario nuevo" (nunca aceptó) y "usuario existente tras un cambio
    material de los términos" (VersionTerminos.Actual subió) con el mismo
    mecanismo — no hace falta distinguir los dos casos.
*@
@using CaeManager.Application.Cumplimiento.Commands.AceptarTerminos
@using CaeManager.Application.Cumplimiento.Queries.ObtenerEstadoAceptacionTerminos
@using CaeManager.Web.Features.Cumplimiento.Recursos
@using CaeManager.Application.Common
@using MediatR
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject IStringLocalizer<TextosCumplimiento> Textos
@inject PersistentComponentState EstadoPersistente
@inject IServiceProvider Servicios
@inherits CaeManager.Web.Components.IsloteInteractivo

<LimiteDeErrores Islote="this">
@if (_debeAceptar)
{
    <Modal Visible="true" Titulo="@Textos["TituloModal"]" Bloqueante="true" Ancho="AnchoModal.Grande">
        <ChildContent>
            <p class="texto-consentimiento">@Textos["TextoConsentimiento", Marca.Nombre]</p>
            <p>
                <a href="/legal/terminos" target="_blank" rel="noopener noreferrer">@Textos["EnlaceTerminos"]</a>
                &nbsp;·&nbsp;
                <a href="/legal/privacidad" target="_blank" rel="noopener noreferrer">@Textos["EnlacePrivacidad"]</a>
            </p>
            <label class="campo-checkbox">
                <input type="checkbox" checked="@_marcado" @onchange="e => _marcado = (bool)e.Value!" />
                @Textos["CasillaAceptacion"]
            </label>
            @if (_error is not null)
            {
                <div class="alerta-formulario" role="alert">@_error</div>
            }
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Primario" Deshabilitado="!_marcado" Cargando="_aceptando" OnClick="AceptarAsync">@Textos["BotonAceptar"]</Boton>
        </Pie>
    </Modal>
}
</LimiteDeErrores>

@code {
    private bool _debeAceptar;
    private bool _marcado;
    private bool _aceptando;
    private string? _error;
    private PersistingComponentStateSubscription _persistencia;
    private EstadoGate? _estado;
    private const string ClavePersistencia = "gate-terminos-estado-v1";

    /// <summary>
    /// Lo que el prerenderizado deja al circuito para no repetir la consulta: de qué usuario es y cuándo se leyó.
    /// El prerenderizado sigue pintando el modal bloqueante; el circuito solo lo reutiliza para el mismo usuario
    /// y dentro de la caducidad de las lecturas del layout.
    /// </summary>
    public sealed record EstadoGate(Guid Usuario, DateTimeOffset Creado, bool DebeAceptar);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuario = Servicios.GetService<ICurrentUserService>() is { } actual
                ? await actual.ObtenerUsuarioActualIdAsync() : null;
            if (EstadoPersistente.TryTakeFromJson<EstadoGate>(ClavePersistencia, out var anterior)
                && anterior is not null && usuario is { } id && anterior.Usuario == id
                && DateTimeOffset.UtcNow - anterior.Creado is var edad && edad >= TimeSpan.Zero
                && edad < MemoPorContexto.Caducidad)
                _debeAceptar = anterior.DebeAceptar;
            else
            {
                _debeAceptar = await Mediator.Send(new ObtenerEstadoAceptacionTerminosQuery());
                if (usuario is { } leido)
                    _estado = new(leido, DateTimeOffset.UtcNow, _debeAceptar);
            }
        }
        catch (Exception)
        {
            // Mejor esfuerzo: si la comprobación falla (p. ej. circuito
            // recién abierto sin sesión resuelta todavía), no bloquea al
            // usuario con un gate que no puede completar — se reintenta en
            // la siguiente navegación/render.
            _debeAceptar = false;
        }
        _persistencia = EstadoPersistente.RegisterOnPersisting(PersistirAsync);
    }

    private Task PersistirAsync()
    {
        if (_estado is { } estado)
            EstadoPersistente.PersistAsJson(ClavePersistencia, estado);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistencia.Dispose();

    private async Task AceptarAsync()
    {
        if (!_marcado) return;

        _aceptando = true;
        _error = null;
        try
        {
            var resultado = await Mediator.Send(new AceptarTerminosCommand());
            if (resultado.EsFallido)
            {
                _error = resultado.Error.Mensaje;
                return;
            }

            _debeAceptar = false;
        }
        catch (Exception)
        {
            _error = Textos["ErrorRegistro"];
        }
        finally
        {
            _aceptando = false;
        }
    }
}
