@*
    Drawer de historial + acciones del blindaje 42.1 para un par (Empresa,
    Cliente) concreto. Dos acciones, ambas hechos puntuales que nunca se
    editan una vez guardados (ver el comentario de SolicitudCertificacionTgss):
    "Nueva solicitud" siempre crea una fila; "Registrar respuesta" solo está
    disponible sobre la solicitud más reciente cuando todavía no tiene
    resultado — no tiene sentido responder a una solicitud antigua ya resuelta.
*@
@using CaeManager.Application.Blindaje42.Commands.RegistrarRespuestaCertificacionTgss
@using CaeManager.Application.Blindaje42.Commands.SolicitarCertificacionTgss
@using CaeManager.Application.Blindaje42.Queries.ObtenerHistorialCertificacionesTgss
@using CaeManager.Domain.Blindaje42
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@inject IMediator Mediator
@inject ToastService Toasts
@inject TimeProvider Reloj

<Drawer Visible="Visible" VisibleChanged="CerrarAsync" Titulo="@($"Blindaje 42.1 · {EmpresaRazonSocial}")"
        CerrarAlHacerClicFuera="@(!_guardandoSolicitud && !_guardandoRespuesta)"
        HayCambios="() => HayCambiosSinGuardar">
    <ChildContent>
        <p class="texto-vacio-seccion">
            Certificación negativa por descubiertos en la TGSS sobre esta empresa (art. 42.1 ET). La TGSS debe
            librarla en 30 días improrrogables; pasado el plazo sin respuesta, el Cliente queda exonerado. Cada
            solicitud solo cubre los descubiertos existentes en su fecha — no los que surjan después mientras
            dure el encargo.
        </p>

        @* Registrar solicitud y registrar respuesta son ICommand denegados a Consulta: se le
           ocultan los formularios enteros; el historial de abajo sí es lectura. *@
        <SoloConEscritura>
            <div class="workspace-grupo-campos">
                <CampoTexto Etiqueta="Fecha de la nueva solicitud" Type="date" Valor="@_fechaSolicitud" ValorChanged="v => _fechaSolicitud = v" />
                <CampoTextarea Etiqueta="Observaciones (opcional)" Valor="@_observacionesNueva" ValorChanged="v => _observacionesNueva = v" Filas="2" />
                @if (_errorSolicitud is not null)
                {
                    <span class="campo-mensaje-error" role="alert">@_errorSolicitud</span>
                }
                <Boton Variante="VarianteBoton.Primario" OnClick="RegistrarSolicitudAsync" Cargando="_guardandoSolicitud" Deshabilitado="_guardandoSolicitud">
                    Registrar solicitud
                </Boton>
            </div>

            <hr />
        </SoloConEscritura>

        @if (_cargando)
        {
            <EstadoCargando Filas="2" />
        }
        else if (_error)
        {
            <EstadoVacio Titulo="No pudimos cargar el historial" Descripcion="Intenta nuevamente en unos segundos.">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_historial is { Count: 0 })
        {
            <EstadoVacio Titulo="Sin solicitudes" Descripcion="Todavía no se ha solicitado ninguna certificación TGSS para esta empresa." />
        }
        else if (_historial is not null)
        {
            @foreach (var solicitud in _historial)
            {
                <div class="workspace-nota-contextual">
                    <div class="workspace-cabecera-entidad">
                        <strong>Solicitada el @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")</strong>
                        <Badge Tono="Tono(solicitud.Estado)">@Etiqueta(solicitud.Estado)</Badge>
                    </div>
                    <span class="detalle-tecnico">Plazo orientativo hasta @solicitud.FechaLimiteOrientativa.ToString("dd/MM/yyyy") (30 días naturales, art. 42.1 ET)</span>

                    @if (solicitud.Resultado is { } resultado)
                    {
                        <span>
                            Respuesta TGSS: @(resultado == ResultadoCertificacionTgss.SinDescubiertos ? "sin descubiertos" : "con descubiertos")
                            el @solicitud.FechaRespuesta!.Value.ToString("dd/MM/yyyy")
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(solicitud.Observaciones))
                    {
                        <span>@solicitud.Observaciones</span>
                    }

                    @if (solicitud.TieneEvidencia)
                    {
                        <span class="detalle-tecnico">Justificante: @solicitud.EvidenciaNombreArchivo</span>
                    }

                    @if (solicitud.Resultado is null && solicitud.Id == _historial[0].Id)
                    {
                        <SoloConEscritura>
                        @if (_respondiendoSolicitudId == solicitud.Id)
                        {
                            <div class="workspace-grupo-campos">
                                <CampoSelect Etiqueta="Resultado" Valor="@_resultadoRespuesta" ValorChanged="v => _resultadoRespuesta = v">
                                    <option value="">Selecciona el resultado…</option>
                                    <option value="@nameof(ResultadoCertificacionTgss.SinDescubiertos)">Sin descubiertos</option>
                                    <option value="@nameof(ResultadoCertificacionTgss.ConDescubiertos)">Con descubiertos</option>
                                </CampoSelect>
                                <CampoTexto Etiqueta="Fecha de respuesta" Type="date" Valor="@_fechaRespuesta" ValorChanged="v => _fechaRespuesta = v" />
                                <ZonaSoltarArchivo Titulo="Justificante (opcional)" FormatosTexto="PDF, JPG o PNG, máx. 10 MB"
                                                    Accept=".pdf,application/pdf,.jpg,.jpeg,.png,image/jpeg,image/png"
                                                    Cargando="_subiendoEvidencia" OnChange="ManejarEvidenciaAsync"
                                                    NombreArchivoActual="@_evidenciaNombreArchivo" />
                                @if (_errorRespuesta is not null)
                                {
                                    <span class="campo-mensaje-error" role="alert">@_errorRespuesta</span>
                                }
                                <div class="workspace-tarjeta-requisito-acciones">
                                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                           OnClick="() => _respondiendoSolicitudId = null" Deshabilitado="_guardandoRespuesta">
                                        Cancelar
                                    </Boton>
                                    <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" OnClick="() => RegistrarRespuestaAsync(solicitud.Id)"
                                           Cargando="_guardandoRespuesta" Deshabilitado="_guardandoRespuesta">
                                        Guardar respuesta
                                    </Boton>
                                </div>
                            </div>
                        }
                        else
                        {
                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirRespuesta(solicitud.Id)">
                                Registrar respuesta
                            </Boton>
                        }
                        </SoloConEscritura>
                    }
                </div>
            }
        }
    </ChildContent>
</Drawer>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public Guid ClienteId { get; set; }
    [Parameter, EditorRequired] public Guid EmpresaId { get; set; }
    [Parameter] public string EmpresaRazonSocial { get; set; } = string.Empty;

    /// <summary>Avisa al padre (la lista de empresas) para que recargue los estados tras cualquier cambio.</summary>
    [Parameter] public EventCallback OnCambio { get; set; }


    private IReadOnlyList<SolicitudCertificacionTgssDto>? _historial;
    private bool _cargando = true;
    private bool _error;
    private bool _visibleAnterior;
    private Guid _empresaCargada;

    private string _fechaSolicitud = string.Empty;
    private string _fechaSolicitudInicial = string.Empty;
    private string _fechaRespuestaInicial = string.Empty;
    private string _observacionesNueva = string.Empty;
    private bool _guardandoSolicitud;
    private string? _errorSolicitud;

    private Guid? _respondiendoSolicitudId;
    private string _resultadoRespuesta = string.Empty;
    private string _fechaRespuesta = string.Empty;
    private byte[]? _evidenciaContenido;
    private string? _evidenciaNombreArchivo;
    private bool _subiendoEvidencia;
    private bool _guardandoRespuesta;
    private string? _errorRespuesta;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && (!_visibleAnterior || EmpresaId != _empresaCargada))
        {
            _empresaCargada = EmpresaId;
            ReiniciarFormularios();
            await CargarAsync();
        }

        _visibleAnterior = Visible;
    }

    /// <summary>
    /// «¿Descartar cambios?» al cerrar el drawer con la X, Escape o el fondo (S3): hay algo escrito que
    /// se perdería. Las fechas cuentan solo si se apartaron de la que se propuso al abrir (hoy); el
    /// formulario de respuesta, solo mientras está abierto. Mientras guarda no pregunta: el cierre
    /// se ignora de todos modos (CerrarAsync).
    /// </summary>
    private bool HayCambiosSinGuardar =>
        Visible && !_guardandoSolicitud && !_guardandoRespuesta
        && (!string.IsNullOrWhiteSpace(_observacionesNueva)
            || _fechaSolicitud != _fechaSolicitudInicial
            || (RespuestaALaVista
                && (!string.IsNullOrEmpty(_resultadoRespuesta)
                    || _evidenciaContenido is not null
                    || _fechaRespuesta != _fechaRespuestaInicial)));

    /// <summary>
    /// El formulario de respuesta solo se pinta sobre la solicitud más reciente y sin resultado: si tras
    /// recargar el historial la que se respondía ya no es la primera, sus campos siguen en memoria pero
    /// nadie los ve, y no cuentan como cambio.
    /// </summary>
    private bool RespuestaALaVista =>
        _respondiendoSolicitudId is { } id && _historial is { Count: > 0 } historial && historial[0].Id == id && historial[0].Resultado is null;

    private void ReiniciarFormularios()
    {
        _fechaSolicitud = _fechaSolicitudInicial = FechaDeHoy.ParaCampoFecha(Reloj);
        _observacionesNueva = string.Empty;
        _errorSolicitud = null;
        _respondiendoSolicitudId = null;
        _resultadoRespuesta = string.Empty;
        _fechaRespuesta = _fechaRespuestaInicial = FechaDeHoy.ParaCampoFecha(Reloj);
        _evidenciaContenido = null;
        _evidenciaNombreArchivo = null;
        _errorRespuesta = null;
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            _historial = await Mediator.Send(new ObtenerHistorialCertificacionesTgssQuery(EmpresaId, ClienteId));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task RegistrarSolicitudAsync()
    {
        if (!DateOnly.TryParse(_fechaSolicitud, out var fecha))
        {
            _errorSolicitud = "Indica una fecha de solicitud válida.";
            return;
        }

        _errorSolicitud = null;
        _guardandoSolicitud = true;
        var fechaEnviada = _fechaSolicitud;

        try
        {
            var resultado = await Mediator.Send(new SolicitarCertificacionTgssCommand(
                EmpresaId, ClienteId, fecha, string.IsNullOrWhiteSpace(_observacionesNueva) ? null : _observacionesNueva));

            if (resultado.EsFallido)
            {
                _errorSolicitud = resultado.Error.Mensaje;
                return;
            }

            Toasts.Mostrar("Solicitud registrada.", TonoToast.Exito);
            _observacionesNueva = string.Empty;
            // Lo guardado ya no es un cambio pendiente aunque la fecha sea retroactiva: la base pasa a ser la que
            // se envió (no la que haya en el campo tras el await, que podría ser otra tecleada mientras tanto).
            _fechaSolicitudInicial = fechaEnviada;
            await CargarAsync();
            await OnCambio.InvokeAsync();
        }
        finally
        {
            _guardandoSolicitud = false;
        }
    }

    private void AbrirRespuesta(Guid solicitudId)
    {
        _respondiendoSolicitudId = solicitudId;
        _resultadoRespuesta = string.Empty;
        _fechaRespuesta = _fechaRespuestaInicial = FechaDeHoy.ParaCampoFecha(Reloj);
        _evidenciaContenido = null;
        _evidenciaNombreArchivo = null;
        _errorRespuesta = null;
    }

    private async Task ManejarEvidenciaAsync(InputFileChangeEventArgs args)
    {
        _subiendoEvidencia = true;
        try
        {
            await using var flujo = args.File.OpenReadStream(LimitesArchivoSubido.TamanoMaximoBytes);
            using var memoria = new MemoryStream();
            await flujo.CopyToAsync(memoria);
            _evidenciaContenido = memoria.ToArray();
            _evidenciaNombreArchivo = args.File.Name;
        }
        catch (Exception)
        {
            _errorRespuesta = "No se pudo leer el archivo. Prueba con otro.";
        }
        finally
        {
            _subiendoEvidencia = false;
        }
    }

    private async Task RegistrarRespuestaAsync(Guid solicitudId)
    {
        if (string.IsNullOrWhiteSpace(_resultadoRespuesta) || !Enum.TryParse<ResultadoCertificacionTgss>(_resultadoRespuesta, out var resultado))
        {
            _errorRespuesta = "Selecciona el resultado de la TGSS.";
            return;
        }

        if (!DateOnly.TryParse(_fechaRespuesta, out var fecha))
        {
            _errorRespuesta = "Indica una fecha de respuesta válida.";
            return;
        }

        _errorRespuesta = null;
        _guardandoRespuesta = true;

        try
        {
            var resultadoComando = await Mediator.Send(new RegistrarRespuestaCertificacionTgssCommand(
                solicitudId, resultado, fecha, _evidenciaContenido, _evidenciaNombreArchivo));

            if (resultadoComando.EsFallido)
            {
                _errorRespuesta = resultadoComando.Error.Mensaje;
                return;
            }

            Toasts.Mostrar("Respuesta registrada.", TonoToast.Exito);
            _respondiendoSolicitudId = null;
            await CargarAsync();
            await OnCambio.InvokeAsync();
        }
        finally
        {
            _guardandoRespuesta = false;
        }
    }

    private static string Etiqueta(EstadoBlindaje42 estado) => estado switch
    {
        EstadoBlindaje42.PendienteRespuesta => "Pendiente TGSS",
        EstadoBlindaje42.ExoneradaPorSilencio => "Exonerada (silencio)",
        EstadoBlindaje42.ExoneradaPorCertificacion => "Exonerada (certificación)",
        EstadoBlindaje42.NoExonerada => "Con descubiertos",
        _ => "—"
    };

    private static TonoBadge Tono(EstadoBlindaje42 estado) => estado switch
    {
        EstadoBlindaje42.PendienteRespuesta => TonoBadge.Info,
        EstadoBlindaje42.ExoneradaPorSilencio => TonoBadge.Advertencia,
        EstadoBlindaje42.ExoneradaPorCertificacion => TonoBadge.Exito,
        EstadoBlindaje42.NoExonerada => TonoBadge.Peligro,
        _ => TonoBadge.Neutro
    };

    private Task CerrarAsync(bool visible) =>
        _guardandoSolicitud || _guardandoRespuesta ? Task.CompletedTask : VisibleChanged.InvokeAsync(visible);
}
