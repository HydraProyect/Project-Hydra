@using CaeManager.Application.ContactosSeguridad.Commands.ProponerContactoSeguridad
@using CaeManager.Web.Features.ContactoSeguridad.Recursos
@using FluentValidation
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosContactoSeguridad> Textos

<DrawerFormulario Visible="Visible" VisibleChanged="VisibleChanged" Titulo="@Textos["DrawerTitulo"]"
    HayCambios="() => Visible && _instantanea.Difiere(Instantanea())"
    Guardando="_guardando" MensajeError="@_error" HayErroresDeCampo="@(_errores.Count > 0)" OnGuardar="GuardarAsync"
    TextoGuardar="@Textos["BotonEnviar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <p class="contacto-seguridad-nota">@Textos["DrawerNota"]</p>
    <CampoTexto Etiqueta="@Textos["CampoNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" MensajeError="@Error(nameof(ProponerContactoSeguridadCommand.Nombre))" />
    <CampoTexto Etiqueta="@Textos["CampoCorreo"]" Type="email" Valor="@_correo" ValorChanged="v => _correo = v" MensajeError="@Error(nameof(ProponerContactoSeguridadCommand.Correo))" />
    <CampoTexto Etiqueta="@Textos["CampoTelefono"]" Type="tel" Valor="@_telefono" ValorChanged="v => _telefono = v" MensajeError="@Error(nameof(ProponerContactoSeguridadCommand.Telefono))" />
</DrawerFormulario>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnPropuesta { get; set; }

    private bool _abierto, _guardando;
    private int _generacion;
    private string _nombre = "", _correo = "", _telefono = "";
    private string? _error;
    private Dictionary<string, string> _errores = [];
    private readonly InstantaneaFormulario _instantanea = new();
    private readonly CancellationTokenSource _ciclo = new();

    private string? Error(string campo) => _errores.GetValueOrDefault(campo);
    private string Instantanea() => System.Text.Json.JsonSerializer.Serialize(new { _nombre, _correo, _telefono });

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            if (_abierto) ++_generacion;
            _abierto = false;
            return;
        }
        if (_abierto) return;
        // Cada apertura empieza en blanco: una propuesta es siempre una persona nueva, no la edición de la vigente.
        _abierto = true;
        ++_generacion;
        _nombre = _correo = _telefono = "";
        _guardando = false;
        _error = null;
        _errores.Clear();
        _instantanea.Fijar(Instantanea());
    }

    private async Task GuardarAsync()
    {
        if (_guardando || !Visible) return;
        var generacion = _generacion;
        _guardando = true;
        _errores.Clear();
        _error = null;
        try
        {
            var comando = new ProponerContactoSeguridadCommand(_nombre.Trim(), _correo.Trim(),
                string.IsNullOrWhiteSpace(_telefono) ? null : _telefono.Trim());
            var validacion = new ProponerContactoSeguridadCommandValidator().Validate(comando);
            if (!validacion.IsValid) throw new ValidationException(validacion.Errors);
            var resultado = await Mediator.Send(comando, _ciclo.Token);
            if (generacion != _generacion) return;
            if (resultado.EsFallido)
            {
                _error = resultado.Error.Mensaje;
                return;
            }
            _instantanea.Fijar(Instantanea());
            ToastService.Mostrar(Textos["PropuestaEnviada"], TonoToast.Exito);
            await VisibleChanged.InvokeAsync(false);
            await OnPropuesta.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _errores = ex.Errors.GroupBy(e => e.PropertyName).ToDictionary(g => g.Key, g => g.First().ErrorMessage);
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception) { if (generacion == _generacion) _error = Textos["ErrorGuardar"]; }
        finally { if (generacion == _generacion) _guardando = false; }
    }

    public void Dispose()
    {
        ++_generacion;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
