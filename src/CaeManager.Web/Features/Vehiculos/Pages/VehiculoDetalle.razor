@*
    Vehículo 360 (página): la ficha entera de un Vehículo, con su
    documentación registrada, su historial y sus datos. Mockup de referencia:
    «Paginas 360 nuevas TALVEG.maqueta.html», incluida la pestaña Ficha.

    Identidad con anillo, pestañas Documentación, Centros orientativos de su Empresa empleadora, Ficha e Historial y tarjeta lateral
    Información. El lateral se cierra con la «Nota interna» (pieza NotaInterna),
    que se edita en su propio DrawerFormulario y se guarda con un comando
    estrecho, no con el panel. Los Centros describen actividad de Trabajadores de su Empresa empleadora,
    sin asignación del Vehículo a Centro ni Visita. «Eliminar vehículo» (menú «Más acciones») vuelve al
    listado con un aviso que ofrece «Deshacer». Quedan pendientes fecha de alta y tarjeta lateral del
    empleador.

    El anillo mide los documentos REGISTRADOS, no los exigidos: todavía no
    existe un universo de documentos exigidos a un vehículo. Por eso aquí no
    hay estado «Pendiente»; los documentos de un vehículo no bloquean el
    acceso de nadie.

    Sin banda de incidencias bajo la cabecera (decisión de producto del
    2026-10-09): los vencidos se ven, y se abren, en su fila.

    Editar los datos de identidad abre el panel del Vehículo (Context Workspace) en «Información»,
    que es donde vive la edición en línea con su aviso de cambios sin
    guardar; al cerrarse el panel la ficha se vuelve a leer. Las cajas de Ficha
    se editan con su propio DrawerFormulario y comando estrecho.
*@
@page "/vehiculos/{VehiculoId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Policy = CaeManager.Web.Services.Autorizacion.PoliticasFichas360.Vehiculo)]
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Vehiculos.Recursos
@using CaeManager.Web.Features.Vehiculos.Components
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosVehiculos> Textos
@inject IStringLocalizer<TextosComunes> Comunes

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.Nombre ?? Textos["FichaKicker"]) — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["FichaRutaNavegacion"]" />

    @if (_error)
    {
        @* No encontrado y sin acceso se ven igual, para no revelar si el
           registro existe en otra organización: la consulta devuelve null en
           los dos casos. *@
        <Tarjeta>
            <EstadoVacio Titulo="@Textos["ErrorCargaVehiculoTitulo"]" Descripcion="@Textos["FichaErrorDescripcion"]"
                         NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="ReintentarAsync">@Textos["BotonReintentar"]</Boton>
                    <EnlaceProfundoOtraEmpresa />
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_cargando)
    {
        <Tarjeta>
            <EstadoCargando Filas="5" />
        </Tarjeta>
    }
    else if (_detalle is not null)
    {
        <CabeceraIdentidad Titulo="@_detalle.Nombre" Kicker="@Textos["FichaKicker"]">
            <Anillo>
                <AnilloCumplimiento Porcentaje="_detalle.DocumentosAlDia.Porcentaje" Tamano="TamanoAnillo.Cabecera"
                                    Detalle="@Textos["FichaAnilloDetalle", _detalle.DocumentosAlDia.AlDia, _detalle.DocumentosAlDia.Requeridos]"
                                    Etiqueta="@EtiquetaAnillo" />
            </Anillo>
            <Datos>
                <span class="vehiculo360-placa">
                    <BotonCopiar Valor="@_detalle.NumeroPlaca" Texto="@_detalle.NumeroPlaca"
                                 Etiqueta="@Textos["FichaCopiarLaMatricula"]"
                                 NombreAccesible="@Textos["FichaCopiarMatricula", _detalle.NumeroPlaca]" />
                </span>
                <span aria-hidden="true">·</span>
                <span>@_detalle.Modelo</span>
                <span aria-hidden="true">·</span>
                <span>@Textos["FichaEmpleadorPrefijo"]</span>
                @if (RutaEmpleador is { } rutaEmpleador)
                {
                    <a class="vehiculo360-enlace" href="@rutaEmpleador">@_detalle.EmpleadorNombre</a>
                }
                else
                {
                    <span>@_detalle.EmpleadorNombre</span>
                }
            </Datos>
            <Acciones>
                <SoloConEscritura>
                    <Boton Variante="VarianteBoton.Primario" OnClick="SubirDocumentoAsync">@Textos["FichaSubirDocumento"]</Boton>
                    <MenuAcciones EtiquetaAccesible="@Textos["FichaMasAcciones"]" ConBorde="true">
                        <ItemMenuAccion OnClick="AbrirInformacionAsync">@Textos["FichaEditarVehiculo"]</ItemMenuAccion>
                        @* EliminarVehiculoCommand es ICommand: denegado a Consulta, que no ve este menú. *@
                        <ItemMenuAccion OnClick="() => _confirmarEliminarVisible = true" Destructivo="true">@Textos["FichaEliminarVehiculo"]</ItemMenuAccion>
                    </MenuAcciones>
                </SoloConEscritura>
            </Acciones>
        </CabeceraIdentidad>

        <Pestanas Definiciones="PestanasConRecuento" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestana" EtiquetaGrupo="@Textos["EtiquetaSecciones"]">
            <CuerpoConLateral EtiquetaLateral="@Textos["FichaEtiquetaLateral"]">
                <ChildContent>
                    @switch (_pestanaActiva)
                    {
                        case "documentacion":
                            @if (_cargandoDocumentos)
                            {
                                <EstadoCargando Filas="3" />
                            }
                            else if (_errorDocumentos)
                            {
                                <Tarjeta>
                                    <EstadoVacio Titulo="@Textos["FichaErrorDocumentosTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]"
                                                 NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)">
                                        <Accion>
                                            <Boton Variante="VarianteBoton.Secundario" OnClick="CargarDocumentosAsync">@Textos["BotonReintentar"]</Boton>
                                        </Accion>
                                    </EstadoVacio>
                                </Tarjeta>
                            }
                            else if (_documentos.Count == 0)
                            {
                                <Tarjeta>
                                    <EstadoVacio Titulo="@Textos["FichaVacioDocumentosTitulo"]" Descripcion="@Textos["FichaVacioDocumentosDescripcion"]"
                                                 NombreIcono="documentos">
                                        <Accion>
                                            <SoloConEscritura>
                                                <Boton Variante="VarianteBoton.Secundario" OnClick="SubirDocumentoAsync">@Textos["FichaSubirDocumento"]</Boton>
                                            </SoloConEscritura>
                                        </Accion>
                                    </EstadoVacio>
                                </Tarjeta>
                            }
                            else
                            {
                                <FranjaEstado Opciones="OpcionesDocumentos" Valor="@SeleccionEstados.Unir(_estados)" ValorChanged="CambiarEstado"
                                              Recuentos="RecuentosDocumentos" TotalTodos="_documentos.Count" />
                                <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["FichaListaDocumentos"]">
                                    <Encabezado>
                                        @Textos["FichaMostrando", DocumentosVisibles.Count, _documentos.Count] · @Textos["OrdenDocumentos"]
                                        @if (_totalDocumentos > _documentos.Count)
                                        {
                                            <span data-documentos-truncados>@Textos["DocumentosCargados", _documentos.Count, _totalDocumentos]</span>
                                        }
                                        @if (VencidosFueraDeLaLista)
                                        {
                                            <b class="vehiculo360-vencidos-fuera" data-vencidos-fuera>@Textos["FichaVencidosFueraDeLaLista"]</b>
                                        }
                                    </Encabezado>
                                    <ChildContent>
                                        @foreach (var documento in DocumentosVisibles)
                                        {
                                            <FilaRelacion @key="documento.Id"
                                                          Nombre="@documento.TipoDocumentoNombre"
                                                          NombreIcono="documentos"
                                                          OnNombre="() => AbrirDocumentoAsync(documento)"
                                                          Tono="@EstadoDocumentoFicha360.TonoFila(documento.Estado)">
                                                <Detalle>@Textos["FichaVence", documento.FechaVencimiento is { } vence ? vence.ToString("dd/MM/yyyy") : "—"]</Detalle>
                                                <Estado>
                                                    <Badge Tono="EstadoDocumentoFicha360.Tono(documento.Estado)">@EstadoDocumentoFicha360.Texto(documento.Estado)</Badge>
                                                    <BadgesAcreditacion Acreditaciones="documento.Acreditaciones" />
                                                </Estado>
                                                <Acciones>
                                                    @if (EstadoDocumentoFicha360.PideGestionar(documento.Estado))
                                                    {
                                                        <SoloConEscritura>
                                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="@EstadoDocumentoFicha360.ClaseGestionar(documento.Estado, "accion-fila-enlace")"
                                                                   aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre)"
                                                                   OnClick="() => EditarDocumentoAsync(documento)">@EstadoDocumentoFicha360.TextoAccion</Boton>
                                                        </SoloConEscritura>
                                                    }
                                                </Acciones>
                                            </FilaRelacion>
                                        }
                                    </ChildContent>
                                    <Pie>
                                        @if (DocumentosVisibles.Count == 0)
                                        {
                                            @Textos["DocumentosVacioFiltroTitulo"]
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick="() => CambiarEstado(null)">@Textos["BotonQuitarFiltros"]</Boton>
                                        }
                                        else
                                        {
                                            @Textos["FichaNotaRegistrados"]
                                        }
                                    </Pie>
                                </ListaRelaciones>
                            }
                            break;

                        case "centros":
                            <p>@Textos["CentrosOrientativos360"]</p>
                            @if (_cargandoCentros)
                            {
                                <EstadoCargando Filas="3" />
                            }
                            else if (_errorCentros)
                            {
                                <EstadoVacio Titulo="@Textos["ErrorCentros360"]">
                                    <Accion><Boton Variante="VarianteBoton.Secundario" OnClick="CargarCentrosAsync">@Textos["BotonReintentar"]</Boton></Accion>
                                </EstadoVacio>
                            }
                            else if (_centros is { Count: 0 })
                            {
                                <EstadoVacio Titulo="@Textos["SinCentrosEmpleador360"]" />
                            }
                            else if (_centros is not null)
                            {
                                <ListaRelaciones Etiqueta="@Textos["PestanaCentrosEmpleador360"]">
                                    @foreach (var centro in _centros)
                                    {
                                        <FilaRelacion @key="centro.Id" Nombre="@centro.Nombre" Href="@($"/centros/{centro.Id}")" NombreIcono="centros">
                                            <Detalle>@centro.ClienteRazonSocial</Detalle>
                                        </FilaRelacion>
                                    }
                                </ListaRelaciones>
                            }
                            break;

                        case "ficha":
                            <CajasFicha Cajas="CajasDeFicha" />
                            <Tarjeta Titulo="@Textos["FichaConductores"]">
                                <AccionesHeader>
                                    <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirEditorFicha">@Textos["FichaEditarEnlace"]</Boton></SoloConEscritura>
                                </AccionesHeader>
                                <ChildContent>
                                    @if (_detalle.Conductores.Count == 0)
                                    {
                                        <p class="vehiculo360-nota">@Textos["FichaSinConductores"]</p>
                                    }
                                    else
                                    {
                                        <ListaRelaciones Etiqueta="@Textos["FichaConductores"]">
                                            @foreach (var conductor in _detalle.Conductores)
                                            {
                                                <FilaRelacion @key="conductor.TrabajadorId" Nombre="@conductor.NombreCompleto"
                                                    OnAbrir360="() => AbrirConductorAsync(conductor.TrabajadorId, conductor.NombreCompleto)"
                                                    Href="@($"/trabajadores/{conductor.TrabajadorId}")" NombreIcono="trabajadores">
                                                    <Estado><Badge Tono="TonoBadge.Exito">@Textos["FichaAutorizado"]</Badge></Estado>
                                                </FilaRelacion>
                                            }
                                        </ListaRelaciones>
                                    }
                                    <p class="vehiculo360-nota">@Textos["FichaNotaConductores"]</p>
                                </ChildContent>
                            </Tarjeta>
                            break;

                        case "historial":
                            <PestanaHistorial EntidadTipo="Vehiculo" EntidadId="VehiculoId" />
                            break;
                    }
                </ChildContent>
                <Lateral>
                    <Tarjeta Compacta="true" Titulo="@Textos["PestanaInformacion"]">
                        <AccionesHeader>
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirInformacionAsync">@Textos["FichaEditarEnlace"]</Boton>
                            </SoloConEscritura>
                        </AccionesHeader>
                        <ChildContent>
                            <RejillaDatos>
                                <DatoRejilla Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_detalle.Nombre" />
                                <DatoRejilla Etiqueta="@Textos["EtiquetaMatricula"]" Valor="@_detalle.NumeroPlaca" />
                                <DatoRejilla Etiqueta="@Textos["EtiquetaModelo"]" Valor="@_detalle.Modelo" />
                            </RejillaDatos>
                        </ChildContent>
                    </Tarjeta>
                    <Tarjeta Compacta="true" Titulo="@Textos["EtiquetaEmpleador"]">
                        <ListaRelaciones Etiqueta="@Textos["EtiquetaEmpleador"]">
                            <FilaRelacion Nombre="@_detalle.EmpleadorNombre" Href="@RutaEmpleador" NombreIcono="empresas" OnAbrir360="AbrirEmpleador" />
                        </ListaRelaciones>
                        <p class="vehiculo360-nota">@Textos["FichaNotaEmpleador"]</p>
                    </Tarjeta>

                    @* Quién ve la nota lo decide el servidor (ObtenerVehiculoPorIdQuery), no esta página: con
                       NotaInternaVisible = false la tarjeta no existe, ni siquiera vacía. Consulta la lee sin «Editar». *@
                    @if (_detalle.NotaInternaVisible)
                    {
                        <NotaInterna Texto="@_detalle.Notas">
                            <Acciones>
                                <SoloConEscritura>
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirEditorNota">@Textos["FichaEditarEnlace"]</Boton>
                                </SoloConEscritura>
                            </Acciones>
                        </NotaInterna>
                    }
                </Lateral>
            </CuerpoConLateral>
        </Pestanas>

        <SoloConEscritura>
            <DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="RecargarTrasCambioAsync" />
            <EditarFichaVehiculoDrawer @key="VehiculoId" VehiculoId="VehiculoId" Visible="_editorFichaVisible"
                VisibleChanged="v => _editorFichaVisible = v" OnGuardada="RecargarFichaAsync" />
            <DialogoConfirmacion
                Visible="_confirmarEliminarVisible"
                VisibleChanged="v => _confirmarEliminarVisible = v"
                Titulo="@Textos["FichaConfirmarEliminarTitulo", _detalle.Nombre]"
                Mensaje="@Textos["FichaConfirmarEliminarMensaje"]"
                EnProgreso="_eliminando"
                OnConfirmar="ConfirmarEliminarAsync" />
        </SoloConEscritura>

        @* Editor de la nota interna: solo se abre desde «Editar →» de su tarjeta, que ya está tras SoloConEscritura. *@
        <DrawerFormulario Visible="_editorNotaVisible" VisibleChanged="CambiarVisibilidadEditorNota" Titulo="@Comunes["NotaInternaTitulo"]"
                          HayCambios="() => HayCambiosEnLaNota" Guardando="_guardandoNota" MensajeError="@_mensajeErrorNota"
                          HayErroresDeCampo="@(_errorCampoNota is not null)" OnGuardar="GuardarNotaAsync"
                          TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
            <CampoTextarea Etiqueta="@Comunes["NotaInternaTitulo"]" Valor="@_notaEnEdicion" ValorChanged="v => _notaEnEdicion = v"
                           Filas="8" MensajeError="@_errorCampoNota" />
            <p class="vehiculo360-nota">@Comunes["NotaInternaNoLaVeCliente"]</p>
        </DrawerFormulario>
    }
</div>
</LimiteDeErrores>

@code {
    private IReadOnlyList<CajaFicha> CajasDeFicha =>
        [new("tipo-titularidad", CajaTipoTitularidad), new("seguro", CajaSeguro)];

    private Task AbrirConductorAsync(Guid id, string nombre) =>
        WorkspaceService.AbrirAsync(EntidadWorkspace.Trabajador, id, nombre, "informacion");

    private RenderFragment CajaTipoTitularidad => __builder =>
    {
        <Tarjeta Titulo="@Textos["FichaTipoTitularidad"]">
            <AccionesHeader>
                <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirEditorFicha">@Textos["FichaEditarEnlace"]</Boton></SoloConEscritura>
            </AccionesHeader>
            <ChildContent>
                <RejillaDatos>
                    <DatoRejilla Etiqueta="@Textos["FichaTipo"]" Valor="@(_detalle!.Tipo ?? "—")" Ancho="true" />
                    <DatoRejilla Etiqueta="@Textos["FichaTitularidad"]" Valor="@(_detalle.Titularidad ?? "—")" Ancho="true" />
                    <DatoRejilla Etiqueta="@Textos["FichaRevisionGrua"]" Valor="@(_detalle.RevisionGrua ?? "—")" />
                    <DatoRejilla Etiqueta="@Textos["FichaDeclaracionCe"]" Valor="@(_detalle.DeclaracionCe ?? "—")" />
                </RejillaDatos>
            </ChildContent>
        </Tarjeta>
    };

    private RenderFragment CajaSeguro => __builder =>
    {
        <Tarjeta Titulo="@Textos["FichaSeguro"]">
            <AccionesHeader>
                <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirEditorFicha">@Textos["FichaEditarEnlace"]</Boton></SoloConEscritura>
            </AccionesHeader>
            <ChildContent>
                <RejillaDatos>
                    <DatoRejilla Etiqueta="@Textos["FichaAseguradora"]" Valor="@(_detalle!.Aseguradora ?? "—")" />
                    <DatoRejilla Etiqueta="@Textos["FichaPoliza"]" Valor="@(_detalle.Poliza ?? "—")" />
                    <DatoRejilla Etiqueta="@Textos["FichaRecibo"]" Valor="@(_detalle.Recibo ?? "—")" Ancho="true" />
                </RejillaDatos>
            </ChildContent>
        </Tarjeta>
    };
}
