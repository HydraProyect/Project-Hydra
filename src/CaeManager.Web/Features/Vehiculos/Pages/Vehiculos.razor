@page "/vehiculos"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Vehiculos.Commands.CrearVehiculo
@using CaeManager.Application.Vehiculos.Commands.EditarVehiculo
@using CaeManager.Application.Vehiculos.Commands.EliminarVehiculos
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculoPorId
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculos
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratasParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Vehiculos.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.Vehiculos.Recursos
@using Microsoft.Extensions.Localization
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosVehiculos> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina lista-design">
    @* La empresa gestionada activa sigue resolviendo qué lista se carga; el rediseño oculta
       su rótulo en la cabecera y conserva el estado vacío cuando todavía no hay selección. *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
    {
        <CabeceraListado Titulo="@Textos["TituloPagina"]" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple"
                         SeleccionMultipleChanged="@(_puedeEscribir && !_alcanceCero && !_errorCarga ? EventCallback.Factory.Create<bool>(this, AlternarSeleccionMultiple) : default)"
                         RutaExportar="@(_alcanceCero ? null : "/vehiculos/exportar.xlsx")" CriteriosExportar="CriteriosExportar" Menu="@(!_alcanceCero ? MenuExportarTodo : null)">
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">@Textos["BotonNuevoVehiculo"]</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="@Textos["TituloPagina"]" />
    }

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           vehículos de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="vehiculos" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @if (!_alcanceCero)
    {
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar"
                  VistaRecordada="_vistaRecordada">
        <Pastillas>
            <PastillaFiltro Etiqueta="@Textos["ListaColumnaEmpresa"]" TextoTodos="@Textos["ListaFiltroTodos"]"
                            Valor="@ValorFiltroEmpleador" ValorChanged="CambiarFiltroEmpleadorAsync" Opciones="OpcionesFiltroEmpleador" />
        </Pastillas>
        <Estados>
            <FranjaEstado Opciones="EstadoDocumentoUi.FranjaDocumental" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                  Recuentos="_recuentosPorEstado" />
        </Estados>
        <Herramientas>
            <PastillaFiltro Etiqueta="@Textos["EtiquetaAgrupar"]" TextoTodos="@Textos["OpcionSinAgrupar"]" Valor="@ValorAgrupacion"
                            ValorChanged="CambiarAgrupacionAsync" Opciones="OpcionesAgrupacion" Keytip="A" />
            @if (_elementosPagina.Count > 0)
            {
                <BarraHerramientasLista TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos" />
            }
        </Herramientas>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@Textos["ListaChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["ListaQuitarBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroEmpresaId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroEmpresa" EtiquetaAccesible="@Textos["ListaQuitarEmpresa"]" OnQuitar="() => FiltrarPorEmpresaAsync(string.Empty)" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroSubcontrataId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroSubcontrata" EtiquetaAccesible="@Textos["ListaQuitarSubcontrata"]" OnQuitar="() => FiltrarPorSubcontrataAsync(string.Empty)" />
            }
        </Chips>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                               OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Vehiculos"
                             ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    @* Franja de estado: conserva la semántica de la franja para «Documentación». Admite varios estados a la vez, viaja en la
       URL como «estado» (estados de código separados por coma) y cada botón dice cuántas filas hay, con los
       demás filtros aplicados. «Por vencer» reúne Urgente y Próximo. *@

    }

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaListaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">@Textos["BotonReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (_totalElementos > 0 || _cargando)
        {
        @TarjetaListado.Renderizar(@<text>
                <div>
                <table class="tabla-datos quickgrid vehiculos-rejilla-propia" theme="default" aria-busy="@(_cargando ? "true" : "false")">
                    <thead><tr>
                        @if (_seleccionMultiple)
                        {
                            <th scope="col"><input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" /></th>
                        }
                        @CabeceraOrdenable(_campoOrdenVehiculo, TituloColumnaVehiculo)
                        @CabeceraOrdenable(nameof(VehiculoListaDto.EmpleadorNombre), Textos["ListaColumnaEmpresa"])
                        @CabeceraOrdenable(nameof(VehiculoListaDto.Modelo), Textos["EtiquetaModelo"])
                        @CabeceraOrdenable(nameof(VehiculoListaDto.EstadoDocumental), Textos["ListaColumnaDocumentacion"], "col-estado")
                        <th scope="col"></th>
                    </tr></thead>
                    <tbody>
                    @{ var claves = new ClavesDeHermanos(); string? grupoAnterior = null; }
                    @foreach (var context in _elementosPagina)
                    {
                        @if (_agruparPorEmpresa && context.EmpleadorNombre != grupoAnterior)
                        {
                            grupoAnterior = context.EmpleadorNombre;
                            var enGrupo = VehiculosDelGrupo(context.EmpleadorNombre);
                            @* Título del grupo «Por Empresa» (maqueta de Vehículos): la Empresa y cuántos Vehículos suyos hay en esta página. *@
                            <tr @key='claves.De((context.EmpleadorNombre, "grupo"))' class="vehiculo-grupo" data-grupo-empresa="@context.EmpleadorNombre"><td colspan="@(_seleccionMultiple ? 6 : 5)">@context.EmpleadorNombre<span class="vehiculo-grupo-recuento">@enGrupo</span></td></tr>
                        }
                        <tr @key="claves.De(context.Id)" class="@ObtenerClaseFila(context)">
                            @if (_seleccionMultiple)
                            {
                                <td><input type="checkbox" aria-label="@(Textos["AriaSeleccionarVehiculo", context.Nombre] + (string.IsNullOrWhiteSpace(context.NumeroPlaca) ? "" : Textos["AriaSeleccionarVehiculoMatricula", context.NumeroPlaca]))" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" /></td>
                            }
                            <td><div class="vehiculo-identidad">
                                @if (context.Incidencias.Count > 0)
                                {
                                    <button type="button" class="boton-expandir-incidencias" aria-label="@Textos["DesplegarIncidenciasVehiculo", context.Nombre]" aria-expanded="@(EstaExpandido(context) ? "true" : "false")" @onclick="() => AlternarExpansion(context.Id)" @onclick:stopPropagation="true"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></button>
                                }
                                <span class="celda-vehiculo">
                                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida" aria-label="@Textos["AbrirVistaRapidaDe", context.Nombre]" @onclick="() => AbrirVistaRapidaAsync(context.Id)"><TextoResaltado Texto="@context.Nombre" Termino="@_busqueda" /></button>
                                    @if (!string.IsNullOrWhiteSpace(context.NumeroPlaca))
                                    {
                                        <span class="celda-vehiculo-modelo celda-vehiculo-matricula"><BotonCopiar EnLinea="true" Valor="@context.NumeroPlaca" Texto="@context.NumeroPlaca" TerminoResaltado="@_busqueda" Etiqueta="@Textos["FichaCopiarLaMatricula"]" NombreAccesible="@Textos["FichaCopiarMatricula", context.NumeroPlaca]" /></span>
                                    }
                                </span>
                            </div></td>
                            <td>@context.EmpleadorNombre</td>
                            <td><TextoResaltado Texto="@context.Modelo" Termino="@_busqueda" /></td>
                            <td class="col-estado"><BarraCumplimiento Porcentaje="@PorcentajeDocumentacion(context)"
                                                   Texto="@MotivoIncidenciasUi.RegistradosVigentes(context.DocumentosVigentes, context.DocumentosRegistrados)"
                                                   Etiqueta="@MotivoIncidenciasUi.RegistradosVigentesAccesible(context.DocumentosVigentes, context.DocumentosRegistrados)" /><EstadoFila Tono="EstadoDocumentoUi.TonoDocumental(context.EstadoDocumental)" Texto="@EstadoDocumentoUi.TextoDocumental(context.EstadoDocumental)" Correcto="EstadoDocumentoUi.EsCorrecto(context.EstadoDocumental)" Motivo="@MotivoIncidenciasUi.Texto(context.Incidencias, CaeManager.Domain.Common.DiaDeNegocio.Hoy())" /></td>
                            <td><Boton360 Nombre="@context.Nombre" Href="@($"/vehiculos/{context.Id}")" /></td>
                        </tr>
                        @if (context.Incidencias.Count > 0 && EstaExpandido(context))
                        {
                            <tr @key="claves.De((context.Id, true))" class="vehiculo-detalle-incidencias"><td colspan="@(_seleccionMultiple ? 6 : 5)">
                                <SubcajaIncidenciasDocumentales Incidencias="context.Incidencias" Interactiva="_puedeEscribir" AlPulsar="CorregirIncidenciaAsync" Busqueda="@_busqueda" />
                            </td></tr>
                        }
                    }
                    </tbody>
                </table>

                </div>

        </text>, PieDelListado)
        }
        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "aún no hay vehículos": hay cuatro filtros puestos
               —búsqueda, documentación, empresa y subcontrata— y ofrecer "crea
               el primero" a quien acaba de filtrar lo manda a dar de alta un
               vehículo que probablemente ya existe, con la matrícula duplicada
               que eso arrastra.

               La copia no afirma que HAYA vehículos dados de alta: el filtrado
               es de servidor y solo devuelve el total ya filtrado. *@
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
            <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
                <EstadoVacio NombreIcono="vehiculos" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                    <Accion>
                        <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" OnClick="AbrirCrearAsync">@Textos["BotonNuevoVehiculo"]</Boton></SoloConEscritura>
                    </Accion>
                </EstadoVacio>
            </VacioSegunAlcance>
        }
        @if (_totalElementos == 0 && !_cargando)
        {
            @TarjetaListado.RenderizarMaqueta(null, PieDelListadoVacio)
        }
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerNuevoTitulo"]"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <div class="campo">
        <label>@Textos["EtiquetaEmpleador"]</label>
        <div class="lista-seleccion-multiple">
            <label class="campo-checkbox">
                <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "empresa")" @onchange="SeleccionarTipoEmpresa" />
                @Textos["EtiquetaEmpresa"]
            </label>
            <label class="campo-checkbox">
                <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "subcontrata")" @onchange="SeleccionarTipoSubcontrata" />
                @Textos["EtiquetaSubcontrata"]
            </label>
        </div>
    </div>

    @if (_tipoEmpleador == "empresa" && _resolverEmpresaEnSilencio)
    {
        @* DDL-076: perfil Cliente Directo con una única Empresa — sin
           selector, pedirle que confirme que él es él en un desplegable
           de un solo elemento no aporta nada. *@
        <CampoInfo Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresasDisponibles[0].RazonSocial" />
    }
    else if (_tipoEmpleador == "empresa")
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresaId" ValorChanged="v => _empresaId = v">
            <option value="">@Textos["OpcionSeleccionaEmpresa"]</option>
            @foreach (var empresa in _empresasDisponibles)
            {
                <option value="@empresa.Id">@empresa.RazonSocial</option>
            }
        </CampoSelect>
    }
    else
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_subcontrataId" ValorChanged="v => _subcontrataId = v">
            <option value="">@Textos["OpcionSeleccionaSubcontrata"]</option>
            @foreach (var subcontrata in _subcontratasDisponibles)
            {
                <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
            }
        </CampoSelect>
    }

    <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.Nombre))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaModelo"]" Valor="@_modelo" ValorChanged="v => _modelo = v" OnBlur="ValidarModeloAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.Modelo))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaMatricula"]" Valor="@_numeroPlaca" ValorChanged="v => _numeroPlaca = v" OnBlur="ValidarNumeroPlacaAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.NumeroPlaca))" />
</DrawerFormulario>

@* Corrección de una incidencia desde la ventana del motivo. Monta su formulario al primer uso. *@
<CorreccionIncidenciaDocumental @ref="_correccion" OnCorregida="RefrescarTrasCorreccionAsync" />

@* EliminarVehiculosCommand es ICommand, denegado a Consulta. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@Textos["ConfirmarEliminarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

</LimiteDeErrores>

@code {
    private RenderFragment? PieDelListado => _errorCarga || (_cargando && _totalElementos == 0) ? null : PieSegun(false);

    // Sin vehículos el pie sigue visible debajo de la tarjeta, con la presentación de la maqueta anterior
    // (regla compartida de los listados, ListadosPieSiempreVisibleTests).
    private RenderFragment PieDelListadoVacio => PieSegun(true);

    private RenderFragment PieSegun(bool presentacionMaqueta) => @<text>
        @if (!_errorCarga && (!_cargando || _totalElementos > 0))
        {
            <PaginadorSimple PresentacionMaqueta="presentacionMaqueta" PaginaActual="@_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                  PaginaActualChanged="CambiarPaginaAsync"
                                  TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" ElementosEnPagina="_elementosPagina.Count">
                    <Centro><LeyendaAtajosLista /></Centro>
                </PaginadorSimple>
        }
    </text>;
}

@code {
    private RenderFragment MenuExportarTodo => @<CaeManager.Web.Exportacion.EntradasExportar Ruta="/vehiculos/exportar.xlsx" />;
}

@code {
    private RenderFragment CabeceraOrdenable(string propiedad, string titulo, string clase = "") => @<th scope="col" class="@(clase + (_orden.Propiedad == propiedad ? (_orden.Direccion == SortDirection.Descending ? " col-sort-desc" : " col-sort-asc") : ""))" aria-sort="@(_orden.Propiedad == propiedad ? (_orden.Direccion == SortDirection.Descending ? "descending" : "ascending") : "none")">
        <div class="col-header-content">
            <button type="button" class="col-title" @onclick="() => OrdenarAsync(propiedad)"><span class="col-title-text">@titulo</span><span aria-hidden="true">@(_orden.Propiedad == propiedad ? (_orden.Direccion == SortDirection.Descending ? "↓" : "↑") : string.Empty)</span></button>
            @if (propiedad == _campoOrdenVehiculo)
            {
                <button type="button" class="col-options-button" aria-label="@Textos["OpcionesOrdenVehiculo"]" aria-expanded="@(_opcionesOrdenVehiculo ? "true" : "false")" @onclick="() => _opcionesOrdenVehiculo = !_opcionesOrdenVehiculo"><Icono Nombre="filtro" Tamano="TamanoIcono.Pequeno" /></button>
                @if (_opcionesOrdenVehiculo)
                {
                    <div class="col-options" data-opciones-orden><CampoSelect Etiqueta="@Textos["ListaOrdenarPor"]" Valor="@_campoOrdenVehiculo" ValorChanged="CambiarCampoOrdenVehiculoAsync"><option value="@nameof(VehiculoListaDto.Nombre)">@Textos["EtiquetaNombre"]</option><option value="@nameof(VehiculoListaDto.NumeroPlaca)">@Textos["EtiquetaMatricula"]</option></CampoSelect></div>
                }
            }
        </div>
    </th>;
}
