@page "/vehiculos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Vehiculos.Commands.CrearVehiculo
@using CaeManager.Application.Vehiculos.Commands.EditarVehiculo
@using CaeManager.Application.Vehiculos.Commands.EliminarVehiculo
@using CaeManager.Application.Vehiculos.Commands.EliminarVehiculos
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculoPorId
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculos
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratasParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Vehiculos.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.Vehiculos.Recursos
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosVehiculos> Textos

<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">@Textos["TituloPagina"]</h1>
        <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoVehiculo"]</Boton></SoloConEscritura>
    </div>

    <div class="barra-filtros">
        <CampoTexto Placeholder="@Textos["PlaceholderBusqueda"]" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <FiltroEstado Etiqueta="@Textos["EtiquetaDocumentacion"]" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                      Opciones="EstadoDocumentoUi.OpcionesDocumentales" />
        <div class="filtro-empresa">
            <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_filtroEmpresaId" ValorChanged="FiltrarPorEmpresaAsync">
                <option value="">@Textos["OpcionTodasEmpresas"]</option>
                @foreach (var empresa in _empresasDisponibles)
                {
                    <option value="@empresa.Id">@empresa.RazonSocial</option>
                }
            </CampoSelect>
        </div>
        <div class="filtro-empresa">
            <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_filtroSubcontrataId" ValorChanged="FiltrarPorSubcontrataAsync">
                <option value="">@Textos["OpcionTodasSubcontratas"]</option>
                @foreach (var subcontrata in _subcontratasDisponibles)
                {
                    <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
                }
            </CampoSelect>
        </div>
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaListaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton OnClick="RecargarAsync">@Textos["BotonReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @* Aquí la barra solo lleva «Selección múltiple», y la selección solo alimenta
           «Eliminar seleccionados» (ICommand denegado a Consulta). *@
        <SoloConEscritura>
            <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple" />
        </SoloConEscritura>

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="VehiculoListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@(Textos["AriaSeleccionarVehiculo", context.Nombre] + (string.IsNullOrWhiteSpace(context.NumeroPlaca) ? "" : Textos["AriaSeleccionarVehiculoMatricula", context.NumeroPlaca]))" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="@Textos["EtiquetaNombre"]" Sortable="true" SortBy="@(GridSort<VehiculoListaDto>.ByAscending(v => v.Nombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => AbrirPreview(context.Id)'>
                        @context.Nombre
                    </button>
                </TemplateColumn>
                <PropertyColumn Property="@(v => v.Modelo)" Title="@Textos["EtiquetaModelo"]" Sortable="true" />
                <PropertyColumn Property="@(v => v.NumeroPlaca)" Title="@Textos["EtiquetaMatricula"]" Sortable="true" />
                <PropertyColumn Property="@(v => v.EmpleadorNombre)" Title="@Textos["ColumnaEmpleador"]" Sortable="true" />
                <TemplateColumn Title="@Textos["EtiquetaDocumentacion"]" Sortable="true" SortBy="@(GridSort<VehiculoListaDto>.ByAscending(v => v.EstadoDocumental))">
                    <Badge Tono="EstadoDocumentoUi.TonoDocumental(context.EstadoDocumental)">
                        @EstadoDocumentoUi.TextoDocumental(context.EstadoDocumental)
                    </Badge>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaAcciones"]" Align="Align.End">
                    <MenuAcciones>
                        <ItemMenuAccion OnClick='() => AbrirPreview(context.Id)'>
                            @Textos["AccionVer"]
                        </ItemMenuAccion>
                        <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.Nombre)">
                            @Textos["AccionEliminar"]
                        </ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "aún no hay vehículos": hay cuatro filtros puestos
               —búsqueda, documentación, empresa y subcontrata— y ofrecer "crea
               el primero" a quien acaba de filtrar lo manda a dar de alta un
               vehículo que probablemente ya existe, con la matrícula duplicada
               que eso arrastra.

               La copia no afirma que HAYA vehículos dados de alta: el filtrado
               es de servidor y solo devuelve el total ya filtrado. *@
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio NombreIcono="vehiculos" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoVehiculo"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerNuevoTitulo"]" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <div class="campo">
            <label>@Textos["EtiquetaEmpleador"]</label>
            <div class="lista-seleccion-multiple">
                <label class="campo-checkbox">
                    <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "empresa")" @onchange="SeleccionarTipoEmpresa" />
                    @Textos["EtiquetaEmpresa"]
                </label>
                <label class="campo-checkbox">
                    <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "subcontrata")" @onchange="SeleccionarTipoSubcontrata" />
                    @Textos["EtiquetaSubcontrata"]
                </label>
            </div>
        </div>

        @if (_tipoEmpleador == "empresa" && _resolverEmpresaEnSilencio)
        {
            @* DDL-076: perfil Cliente Directo con una única Empresa — sin
               selector, pedirle que confirme que él es él en un desplegable
               de un solo elemento no aporta nada. *@
            <CampoInfo Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresasDisponibles[0].RazonSocial" />
        }
        else if (_tipoEmpleador == "empresa")
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresaId" ValorChanged="v => _empresaId = v">
                <option value="">@Textos["OpcionSeleccionaEmpresa"]</option>
                @foreach (var empresa in _empresasDisponibles)
                {
                    <option value="@empresa.Id">@empresa.RazonSocial</option>
                }
            </CampoSelect>
        }
        else
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_subcontrataId" ValorChanged="v => _subcontrataId = v">
                <option value="">@Textos["OpcionSeleccionaSubcontrata"]</option>
                @foreach (var subcontrata in _subcontratasDisponibles)
                {
                    <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
                }
            </CampoSelect>
        }

        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.Nombre))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaModelo"]" Valor="@_modelo" ValorChanged="v => _modelo = v" OnBlur="ValidarModeloAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.Modelo))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaMatricula"]" Valor="@_numeroPlaca" ValorChanged="v => _numeroPlaca = v" OnBlur="ValidarNumeroPlacaAsync" MensajeError="@ObtenerError(nameof(CrearVehiculoCommand.NumeroPlaca))" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            @Textos["BotonGuardar"]
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["ConfirmarEliminarTitulo", _nombreAEliminar]"
    Mensaje="@Textos["ConfirmarEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

@* EliminarVehiculosCommand es ICommand, denegado a Consulta. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@Textos["ConfirmarEliminarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<VehiculoPreviewDrawer VehiculoId="_previewVehiculoId" Visible="_previewVisible" VisibleChanged="v => _previewVisible = v" OnOperar="AbrirDesdePreviewAsync" />
