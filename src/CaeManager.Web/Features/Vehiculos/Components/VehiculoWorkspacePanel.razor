@* Panel de Vehículo para el Context Workspace. Pestañas: Información, Documentación, Historial. *@
@using CaeManager.Application.Vehiculos.Commands.EditarVehiculo
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculoPorId
@using CaeManager.Domain.Documentos
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Vehiculos.Recursos
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosVehiculos> Textos

@if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="@Textos["ErrorCargaVehiculoTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarCabeceraAsync">@Textos["BotonReintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.Nombre</h2>
        <span class="workspace-subtitulo-entidad">@_detalle.EmpleadorNombre</span>
        @if (!_editandoInformacion)
        {
            @* El lápiz vive en la cabecera en todas las pestañas (patrón de listados: la fila no
               lleva menú y editar se hace desde el panel, también con la tecla «e»). Desde otra
               pestaña lleva primero a «Información», que es donde está el formulario.
               Editar acaba en EditarVehiculoCommand, ICommand denegado a Consulta. *@
            <SoloConEscritura>
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="EditarDesdeCabeceraAsync"
                       aria-label="@Textos["AriaEditarInformacion"]" title="@Textos["TituloEditarConAtajo"]">
                    <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
                </Boton>
            </SoloConEscritura>
        }
        @* A la página Vehículo 360 completa: lo que antes ofrecía el pie de la vista previa. *@
        <Boton360 Nombre="@_detalle.Nombre" Href="@($"/vehiculos/{EntidadId}")" />
    </div>

    @* PestanaActiva con @: el parámetro es string, y sin @ Razor le pasa el literal "PestanaActiva" (ninguna pestaña quedaba marcada como activa). *@
    <Pestanas Definiciones="_pestanas" PestanaActiva="@PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="@Textos["EtiquetaSecciones"]">
        @switch (PestanaActiva)
        {
            case "informacion":
                @if (_editandoInformacion)
                {
                    @if (_mensajeErrorInformacion is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorInformacion</div>
                    }
                    <div class="workspace-grupo-campos">
                        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombreInfo" ValorChanged="v => _nombreInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.Nombre))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaMatricula"]" Valor="@_numeroPlacaInfo" ValorChanged="v => _numeroPlacaInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.NumeroPlaca))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaModelo"]" Valor="@_modeloInfo" ValorChanged="v => _modeloInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.Modelo))" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaEmpleador"]" Valor="@_detalle.EmpleadorNombre" />
                    </div>
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_guardandoInformacion" OnClick="CancelarEdicionInformacion">@Textos["BotonCancelar"]</Boton>
                        <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Cargando="_guardandoInformacion" OnClick="GuardarInformacionAsync">@Textos["BotonGuardar"]</Boton>
                    </div>
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_detalle.Nombre" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaMatricula"]" Valor="@_detalle.NumeroPlaca" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaModelo"]" Valor="@_detalle.Modelo" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaEmpleador"]" Valor="@_detalle.EmpleadorNombre" />
                    </div>
                }
                break;

            case "documentacion":
                <PestanaDocumentacion Ambito="AmbitoAplicacion.Vehiculo" PropietarioId="EntidadId" PermiteSubir="true" />
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Vehiculo" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@* P1-E2b: la edición en línea de Información vive en el panel, no en la pestaña: cambiar de pestaña no la pierde
   y no pregunta, por eso el aviso va fuera de <Pestanas>. Abrir otra ficha, volver, el
   breadcrumb o cerrar el panel sí la pierden: el Context Workspace pregunta a este aviso
   antes. Fuera del if/else, para que recargar la cabecera tras guardar no lo desmonte. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CancelarEdicionInformacion" />

@code {
    // De instancia, no static: las etiquetas salen del localizador inyectado.
    private IReadOnlyList<PestanaDefinicion> _pestanas = [];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private VehiculoDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;

    /// <summary>
    /// Se incrementa al cambiar de Vehículo. Toda continuación que la
    /// compruebe tras un await sabe si sigue perteneciendo a la ficha que la
    /// pidió — mismo patrón que <c>EmpresaWorkspacePanel.razor</c>.
    /// </summary>
    private int _generacion;
    private int _cargaCabecera;

    /// <summary>
    /// Se cancela al retirar el panel (Dispose). Su Token se lee SIEMPRE
    /// antes del primer await del método que lo usa: leerlo después dejaría
    /// que un Dispose intermedio lo hubiera desechado.
    /// </summary>
    private readonly CancellationTokenSource _ciclo = new();
    private CancellationToken _cancelacion;

    /// <summary>
    /// Edición in situ de "Información" (Centro 360, Project-Hydra-Negocio/tecnico/docs/ux-audit/PLAN-EJECUCION-UX.md
    /// § 0.10) — sustituye al Drawer de "Editar" de <c>/vehiculos</c>,
    /// retirado. Empleador no entra: no forma parte de
    /// <see cref="EditarVehiculoCommand"/>, solo se fija al crear.
    /// </summary>
    private bool _editandoInformacion;
    private string _nombreInfo = string.Empty;
    private string _modeloInfo = string.Empty;
    private string _numeroPlacaInfo = string.Empty;
    private bool _guardandoInformacion;
    private string? _mensajeErrorInformacion;
    private Dictionary<string, string> _erroresInformacion = new();

    private readonly InstantaneaFormulario _instantaneaInformacion = new();

    /// <summary>P1-E2b: la edición en línea de Información comparada con cómo se abrió.</summary>
    private bool HayCambiosSinGuardar =>
        _editandoInformacion && _instantaneaInformacion.Difiere(ValoresInformacion());

    private object?[] ValoresInformacion() => [_nombreInfo, _numeroPlacaInfo, _modeloInfo];

    protected override void OnInitialized()
    {
        _cancelacion = _ciclo.Token;
        WorkspaceService.OnEdicionSolicitada += AlSolicitarEdicion;
        _pestanas =
        [
            new("informacion", Textos["PestanaInformacion"]),
            new("documentacion", Textos["EtiquetaDocumentacion"]),
            new("historial", Textos["PestanaHistorial"])
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId == _idCargado)
            return;

        _generacion++;
        _idCargado = EntidadId;
        _editandoInformacion = false;
        _guardandoInformacion = false;
        await CargarCabeceraAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var carga = ++_cargaCabecera;
        var id = EntidadId;
        _cargando = true;
        _error = false;

        try
        {
            var detalle = await Mediator.Send(new ObtenerVehiculoPorIdQuery(id), cancelacion);
            if (generacion != _generacion || carga != _cargaCabecera) return;
            _detalle = detalle;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _error = true;
        }
        finally
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _cargando = false;
        }

        if (generacion != _generacion || carga != _cargaCabecera || cancelacion.IsCancellationRequested)
            return;

        // Una petición de edición («e») no sobrevive a una carga fallida ni a una ficha que ya
        // no existe: si se quedara pendiente, un «Reintentar» con éxito entraría en edición sin
        // que nadie lo pida.
        if (_error || _detalle is null)
            WorkspaceService.ConsumirEdicionSolicitada(EntidadWorkspace.Vehiculo, id);
        else
            await AtenderEdicionSolicitadaAsync();
    }

    private void AlSolicitarEdicion() => InvokeAsync(async () =>
    {
        await AtenderEdicionSolicitadaAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Tecla «e» de un listado (<c>ContextWorkspaceService.AbrirEnEdicionAsync</c>): equivale
    /// a pulsar el lápiz de la cabecera. Solo se consume con el detalle ya cargado; si llega
    /// antes, la atiende el final de la carga. El lápiz va dentro de <c>SoloConEscritura</c>,
    /// así que aquí se repite su misma condición: un rol de Consulta no entra en edición.
    /// </summary>
    private async Task AtenderEdicionSolicitadaAsync()
    {
        // Con una carga en curso el detalle en memoria puede ser el de una visita anterior a
        // esta misma ficha: editar ahora copiaría al formulario datos que la carga va a
        // sustituir. La petición espera; la atiende el final de la carga.
        if (_cargando || _detalle is null || _detalle.Id != EntidadId)
            return;
        if (!WorkspaceService.ConsumirEdicionSolicitada(EntidadWorkspace.Vehiculo, EntidadId))
            return;
        if (_editandoInformacion || EstadoAutenticacion is null)
            return;

        var usuario = (await EstadoAutenticacion).User;
        if (!CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv.Split(',').Any(usuario.IsInRole))
            return;

        await EditarDesdeCabeceraAsync();
    }

    private async Task EditarDesdeCabeceraAsync()
    {
        if (PestanaActiva != "informacion")
            await PestanaActivaChanged.InvokeAsync("informacion");

        IniciarEdicionInformacion();
    }

    private void IniciarEdicionInformacion()
    {
        if (_detalle is null) return;

        _nombreInfo = _detalle.Nombre;
        _modeloInfo = _detalle.Modelo;
        _numeroPlacaInfo = _detalle.NumeroPlaca;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();
        _editandoInformacion = true;
        _instantaneaInformacion.Fijar(ValoresInformacion());
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private string? ObtenerErrorInformacion(string campo) => _erroresInformacion.GetValueOrDefault(campo);

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null || _guardandoInformacion) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _guardandoInformacion = true;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();

        try
        {
            var resultado = await Mediator.Send(new EditarVehiculoCommand(
                detalle.Id, _nombreInfo, _modeloInfo, _numeroPlacaInfo, detalle.Version));
            // El guardado ya es firme aunque el panel haya pasado a otra ficha: el listado que
            // tenga esta fila a la vista la vuelve a pedir y la sustituye en sitio.
            if (!resultado.EsFallido) WorkspaceService.NotificarEntidadGuardada(EntidadWorkspace.Vehiculo, detalle.Id);

            if (resultado.EsFallido)
            {
                if (generacion == _generacion)
                    _mensajeErrorInformacion = resultado.Error.Mensaje;
                else
                    ToastService.MostrarError(detalle.Nombre, resultado.Error);
                return;
            }

            if (generacion != _generacion) return;

            ToastService.Mostrar(Textos["ToastActualizado"], TonoToast.Exito);
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _erroresInformacion = ex.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
            else
                ToastService.Mostrar(Textos["ErrorGuardarDe", detalle.Nombre], TonoToast.Error);
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorInformacion = Textos["ErrorGuardar"];
            else
                ToastService.Mostrar(Textos["ErrorGuardarDe", detalle.Nombre], TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoInformacion = false;
        }
    }

    public void Dispose()
    {
        WorkspaceService.OnEdicionSolicitada -= AlSolicitarEdicion;
        _generacion++;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
