@* Panel de Vehículo para el Context Workspace. Pestañas: Información, Documentación, Historial. *@
@using CaeManager.Application.Vehiculos.Commands.EditarVehiculo
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculoPorId
@using CaeManager.Domain.Documentos
@using FluentValidation
@using MediatR
@implements IDisposable
@inject IMediator Mediator
@inject ToastService ToastService

@if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar el vehículo" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.Nombre</h2>
        <span class="workspace-subtitulo-entidad">@_detalle.EmpleadorNombre</span>
        @if (PestanaActiva == "informacion" && !_editandoInformacion)
        {
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="IniciarEdicionInformacion" aria-label="Editar información del vehículo">
                <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
            </Boton>
        }
    </div>

    @* PestanaActiva con @: el parámetro es string, y sin @ Razor le pasa el literal "PestanaActiva" (ninguna pestaña quedaba marcada como activa). *@
    <Pestanas Definiciones="_pestanas" PestanaActiva="@PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones del vehículo">
        @switch (PestanaActiva)
        {
            case "informacion":
                @if (_editandoInformacion)
                {
                    @if (_mensajeErrorInformacion is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorInformacion</div>
                    }
                    <div class="workspace-grupo-campos">
                        <CampoTexto Etiqueta="Nombre" Valor="@_nombreInfo" ValorChanged="v => _nombreInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.Nombre))" />
                        <CampoTexto Etiqueta="Matrícula" Valor="@_numeroPlacaInfo" ValorChanged="v => _numeroPlacaInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.NumeroPlaca))" />
                        <CampoTexto Etiqueta="Modelo" Valor="@_modeloInfo" ValorChanged="v => _modeloInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarVehiculoCommand.Modelo))" />
                        <CampoInfo Etiqueta="Empleador" Valor="@_detalle.EmpleadorNombre" />
                    </div>
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_guardandoInformacion" OnClick="CancelarEdicionInformacion">Cancelar</Boton>
                        <Boton Tamano="TamanoBoton.Pequeno" Cargando="_guardandoInformacion" OnClick="GuardarInformacionAsync">Guardar</Boton>
                    </div>
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Nombre" Valor="@_detalle.Nombre" />
                        <CampoInfo Etiqueta="Matrícula" Valor="@_detalle.NumeroPlaca" />
                        <CampoInfo Etiqueta="Modelo" Valor="@_detalle.Modelo" />
                        <CampoInfo Etiqueta="Empleador" Valor="@_detalle.EmpleadorNombre" />
                    </div>
                }
                break;

            case "documentacion":
                <PestanaDocumentacion Ambito="AmbitoAplicacion.Vehiculo" PropietarioId="EntidadId" />
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Vehiculo" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("documentacion", "Documentación"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private VehiculoDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;

    /// <summary>
    /// Se incrementa al cambiar de Vehículo. Toda continuación que la
    /// compruebe tras un await sabe si sigue perteneciendo a la ficha que la
    /// pidió — mismo patrón que <c>EmpresaWorkspacePanel.razor</c>.
    /// </summary>
    private int _generacion;
    private int _cargaCabecera;

    /// <summary>
    /// Se cancela al retirar el panel (Dispose). Su Token se lee SIEMPRE
    /// antes del primer await del método que lo usa: leerlo después dejaría
    /// que un Dispose intermedio lo hubiera desechado.
    /// </summary>
    private readonly CancellationTokenSource _ciclo = new();
    private CancellationToken _cancelacion;

    /// <summary>
    /// Edición in situ de "Información" (Centro 360, PLAN-EJECUCION-UX.md
    /// § 0.10) — sustituye al Drawer de "Editar" de <c>/vehiculos</c>,
    /// retirado. Empleador no entra: no forma parte de
    /// <see cref="EditarVehiculoCommand"/>, solo se fija al crear.
    /// </summary>
    private bool _editandoInformacion;
    private string _nombreInfo = string.Empty;
    private string _modeloInfo = string.Empty;
    private string _numeroPlacaInfo = string.Empty;
    private bool _guardandoInformacion;
    private string? _mensajeErrorInformacion;
    private Dictionary<string, string> _erroresInformacion = new();

    protected override void OnInitialized() => _cancelacion = _ciclo.Token;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId == _idCargado)
            return;

        _generacion++;
        _idCargado = EntidadId;
        _editandoInformacion = false;
        _guardandoInformacion = false;
        await CargarCabeceraAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var carga = ++_cargaCabecera;
        var id = EntidadId;
        _cargando = true;
        _error = false;

        try
        {
            var detalle = await Mediator.Send(new ObtenerVehiculoPorIdQuery(id), cancelacion);
            if (generacion != _generacion || carga != _cargaCabecera) return;
            _detalle = detalle;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _error = true;
        }
        finally
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _cargando = false;
        }
    }

    private void IniciarEdicionInformacion()
    {
        if (_detalle is null) return;

        _nombreInfo = _detalle.Nombre;
        _modeloInfo = _detalle.Modelo;
        _numeroPlacaInfo = _detalle.NumeroPlaca;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();
        _editandoInformacion = true;
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private string? ObtenerErrorInformacion(string campo) => _erroresInformacion.GetValueOrDefault(campo);

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null || _guardandoInformacion) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _guardandoInformacion = true;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();

        try
        {
            var resultado = await Mediator.Send(new EditarVehiculoCommand(
                detalle.Id, _nombreInfo, _modeloInfo, _numeroPlacaInfo, detalle.Version));

            if (resultado.EsFallido)
            {
                if (generacion == _generacion)
                    _mensajeErrorInformacion = resultado.Error.Mensaje;
                else
                    ToastService.Mostrar($"{detalle.Nombre}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            if (generacion != _generacion) return;

            ToastService.Mostrar("Vehículo actualizado correctamente.", TonoToast.Exito);
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _erroresInformacion = ex.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
            else
                ToastService.Mostrar($"No pudimos guardar los cambios de {detalle.Nombre}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorInformacion = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
            else
                ToastService.Mostrar($"No pudimos guardar los cambios de {detalle.Nombre}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoInformacion = false;
        }
    }

    public void Dispose()
    {
        _generacion++;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
