@page "/configuracion/plataforma"
@rendermode InteractiveServer
@attribute [Authorize]
@* Sin gate de rol: esta puerta es exclusiva de la IDENTIDAD RAÍZ designada por
   el despliegue, y eso no es lo mismo que el rol Administrador de Identity ni
   que tener AdminPlataforma —la capacidad es lo que se obtiene al cruzarla.
   La página no reproduce ninguna regla: pregunta a la consulta de
   descubrimiento y despacha el comando, que es la autoridad final. *@
@using CaeManager.Application.Plataforma.Queries.PuedeInicializarPlataforma
@using CaeManager.Application.Plataforma.Commands.AutoConcederPrivilegio
@using CaeManager.Domain.Plataforma
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@inject IMediator Mediator
@inject AntiforgeryStateProvider AntiforgeryStateProvider

<PageTitle>Plataforma — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <a href="/configuracion" class="enlace-volver-configuracion">← Configuración</a>

    <h1 class="titulo-pagina">Administración de plataforma</h1>

    @* ── Cierre de la sesión de soporte (B1.3) ─────────────────────────────
       Se llega aquí desde /cuenta/soporte/salir, que borra la cookie de contexto
       y trae el id en la URL. El cierre NO se despacha desde el circuito: va por
       un <form> normal al endpoint, igual que el selector de workspace y por el
       mismo motivo —escribe estado de servidor y necesita token antiforgery—.

       Y hay un motivo más, propio de esta pantalla: dentro de un circuito no hay
       HttpContext, así que ni la selección ni la sesión privilegiada se resuelven
       (SeleccionSinHttpContextTests). Un botón que despachara el comando desde
       aquí no podría comprobar si el técnico sigue dentro del tenant visitado; el
       endpoint sí. *@
    @if (SesionCerrada)
    {
        <p role="status" class="alerta-info">Sesión de soporte cerrada.</p>
    }
    else if (ErrorCierre is not null)
    {
        <p role="alert" class="mensaje-error">@TextoDeErrorDeCierre(ErrorCierre)</p>
    }
    else if (SesionParaCerrar is { } sesion)
    {
        <p class="descripcion-seleccion-cliente">
            Has salido del cliente visitado, pero la sesión de soporte sigue abierta y lo
            estará hasta que venza su ventana. Ciérrala ahora para que conste cuándo
            terminó la visita.
        </p>

        <form method="post" action="/cuenta/soporte/cerrar">
            @if (_token is not null)
            {
                <input type="hidden" name="@_token.FormFieldName" value="@_token.Value" />
            }
            <input type="hidden" name="sesionPrivilegiadaId" value="@sesion" />

            <button type="submit" class="boton boton-primario">Cerrar la sesión de soporte</button>
        </form>
    }

    @if (_cargando)
    {
        <p>Comprobando el estado de la plataforma…</p>
    }
    else if (_puedeInicializar)
    {
        <p class="descripcion-seleccion-cliente">
            Esta plataforma todavía no tiene administración inicializada. Al confirmar te concedes la
            capacidad de administración de plataforma, y este paso <strong>no vuelve a estar
            disponible</strong>: se ejecuta una sola vez y no se reabre aunque después se revoque la
            concesión.
        </p>

        @if (_error is not null)
        {
            <p role="alert" class="mensaje-error">@_error</p>
        }

        <button class="boton boton-primario" disabled="@_ejecutando" @onclick="InicializarAsync">
            Inicializar administración de plataforma
        </button>
    }
    else
    {
        <p class="descripcion-seleccion-cliente">
            No hay nada que inicializar aquí.
        </p>
    }
</div>

@code {
    private bool _cargando = true;
    private bool _puedeInicializar;
    private bool _ejecutando;
    private string? _error;
    private AntiforgeryRequestToken? _token;

    /// <summary>
    /// El id que trae <c>/cuenta/soporte/salir</c> en la redirección. No es
    /// autoridad: quien decide si esa sesión se puede cerrar es el comando, y
    /// debajo de él la política RLS <c>privilegio_del_usuario</c>, que solo
    /// entrega las sesiones que cuelgan de una concesión del usuario actual.
    /// </summary>
    [SupplyParameterFromQuery(Name = "sesionParaCerrar")]
    public Guid? SesionParaCerrar { get; set; }

    [SupplyParameterFromQuery(Name = "errorCierre")]
    public string? ErrorCierre { get; set; }

    [SupplyParameterFromQuery(Name = "cerrada")]
    public string? Cerrada { get; set; }

    private bool SesionCerrada => Cerrada == "1";

    protected override async Task OnInitializedAsync()
    {
        _token = AntiforgeryStateProvider.GetAntiforgeryToken();
        _puedeInicializar = await Mediator.Send(new PuedeInicializarPlataformaQuery());
        _cargando = false;
    }

    /// <summary>
    /// Traduce el código que viaja en la URL. Se traduce aquí y no se muestra
    /// crudo porque el endpoint manda un código, nunca texto de excepción.
    /// </summary>
    private static string TextoDeErrorDeCierre(string codigo) => codigo switch
    {
        "SesionPrivilegiada.YaCerrada" => "Esa sesión de soporte ya estaba cerrada.",
        "SesionPrivilegiada.NoEncontrada" => "No encontramos esa sesión de soporte.",
        _ => "No se pudo cerrar la sesión de soporte.",
    };

    private async Task InicializarAsync()
    {
        _ejecutando = true;
        _error = null;

        // El comando es la autoridad final. Que la consulta haya dicho que sí no
        // basta: entre una cosa y otra el bootstrap puede haberse consumido, y
        // aquí se vuelve a comprobar —con su token de concurrencia detrás—.
        var resultado = await Mediator.Send(
            new AutoConcederPrivilegioCommand(Guid.Empty, CapacidadPrivilegio.AdminPlataforma, DiasDeVigencia: 1));

        if (resultado.EsFallido)
        {
            _error = resultado.Error.Mensaje;
            _ejecutando = false;
            return;
        }

        // Consumido: la puerta desaparece.
        _puedeInicializar = false;
        _ejecutando = false;
    }
}
