@page "/calendario"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Calendario.Queries
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Comunes

<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]">
        <Acciones>
            @if (!_error)
            {
                <div class="calendario-navegacion">
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesAnteriorAsync" aria-label="@Textos["MesAnterior"]">
                        <span class="calendario-flecha-anterior"><Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" /></span>
                    </Boton>
                    <span class="calendario-titulo-mes" aria-live="polite">@TituloMes</span>
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesSiguienteAsync" aria-label="@Textos["MesSiguiente"]">
                        <Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" />
                    </Boton>
                </div>
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesActualAsync">@Textos["Hoy"]</Boton>
            }
        </Acciones>
    </CabeceraPagina>

    @if (_error)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton OnClick="CargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else
    {
        <div class="calendario-rejilla">
            @foreach (var nombreDia in NombresDiasSemana)
            {
                <div class="calendario-cabecera-dia">@nombreDia</div>
            }

            @foreach (var celda in CeldasDelMes())
            {
                @if (!celda.DelMes)
                {
                    @* Días del mes anterior/siguiente que completan la semana: se
                       pintan atenuados para orientar, pero no se consultan (la
                       carga es por mes), así que no pueden afirmar nada — ni
                       recuento ni «sin eventos». Por eso tampoco son botón. *@
                    <div class="calendario-celda calendario-celda-fuera" aria-hidden="true">
                        <span class="calendario-dia-numero">@celda.Fecha.Day</span>
                    </div>
                }
                else
                {
                    var dia = celda.Fecha;
                    var vencimientosDelDia = VencimientosDelDia(dia);
                    var visitasDelDia = VisitasDelDia(dia);
                    var peorEstado = PeorEstado(vencimientosDelDia);
                    var esHoy = dia == HoyEfectivo;
                    var claseNumero = esHoy ? "calendario-dia-numero calendario-dia-hoy" : "calendario-dia-numero";

                    @if (vencimientosDelDia.Count == 0 && visitasDelDia.Count == 0)
                    {
                        <div class="calendario-celda">
                            <span class="@claseNumero">@dia.Day</span>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="calendario-celda calendario-celda-con-datos"
                                aria-label="@EtiquetaDia(dia, vencimientosDelDia, visitasDelDia, peorEstado)"
                                title="@EtiquetaDia(dia, vencimientosDelDia, visitasDelDia, peorEstado)"
                                @onclick="() => SeleccionarDia(dia)">
                            <span class="@claseNumero">@dia.Day</span>
                            @if (peorEstado is not null)
                            {
                                <Badge Tono="EstadoDocumentoUi.Tono(peorEstado.Value)">@vencimientosDelDia.Count</Badge>
                            }
                            @if (visitasDelDia.Count > 0)
                            {
                                <span class="calendario-visitas">
                                    <span class="calendario-barra-visita"></span>
                                    @if (visitasDelDia.Count > 1)
                                    {
                                        <span class="calendario-visitas-numero">@visitasDelDia.Count</span>
                                    }
                                </span>
                            }
                        </button>
                    }
                }
            }
        </div>

        @* La leyenda dice lo que PeorEstado calcula con el semáforo único del
           sistema (EstadoDocumentoUi): Urgente es rojo como Vencido, y un día
           puede ser verde si todo lo que vence en él aún está vigente. El
           mockup Gen 2 dibuja solo rojo = «algún vencido» y ámbar = «próximos
           o urgentes»; copiar esa frase afirmaría algo que esta pantalla no
           pinta. *@
        <div class="calendario-leyenda">
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Peligro">n</Badge>@Textos["LeyendaVencidoOUrgente"]</span>
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Advertencia">n</Badge>@Textos["LeyendaProximo"]</span>
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Exito">n</Badge>@Textos["LeyendaVigente"]</span>
            <span class="calendario-leyenda-item"><span class="calendario-barra-visita calendario-barra-visita-leyenda"></span>@Textos["LeyendaVisita"]</span>
            <span>@Textos["LeyendaExplicacion"]</span>
        </div>
    }
</div>

<Modal Visible="@(_diaSeleccionado is not null)"
       VisibleChanged="@((bool visible) => { if (!visible) CerrarDetalle(); })"
       Titulo="@(_diaSeleccionado is not null ? FechaLarga(_diaSeleccionado.Value) : string.Empty)">
    @if (_diaSeleccionado is not null)
    {
        var vencimientosDelDiaSeleccionado = VencimientosDelDia(_diaSeleccionado.Value);
        var visitasDelDiaSeleccionado = VisitasDelDia(_diaSeleccionado.Value);

        <p class="calendario-resumen-dia">@ResumenDia(_diaSeleccionado.Value, vencimientosDelDiaSeleccionado.Count, visitasDelDiaSeleccionado.Count)</p>

        @if (vencimientosDelDiaSeleccionado.Count > 0)
        {
            <section class="calendario-seccion-modal">
                <h3 class="calendario-subtitulo-modal">@Textos["SubtituloVencimientos"]</h3>
                <ul class="calendario-lista-modal">
                    @foreach (var vencimiento in vencimientosDelDiaSeleccionado)
                    {
                        <li class="calendario-fila-modal">
                            <span class="calendario-fila-texto">
                                <span class="calendario-fila-principal">@vencimiento.TrabajadorNombre</span>
                                <span class="calendario-fila-secundaria">@vencimiento.TipoDocumentoNombre</span>
                            </span>
                            <Badge Tono="EstadoDocumentoUi.Tono(vencimiento.Estado)">@EstadoDocumentoUi.Texto(vencimiento.Estado)</Badge>
                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => GestionarDocumento(vencimiento.DocumentoId)">
                                @Textos["Gestionar"]
                            </Boton>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (visitasDelDiaSeleccionado.Count > 0)
        {
            <section class="calendario-seccion-modal">
                <h3 class="calendario-subtitulo-modal">@Textos["SubtituloVisitas"]</h3>
                <ul class="calendario-lista-modal">
                    @foreach (var visita in visitasDelDiaSeleccionado)
                    {
                        <li class="calendario-fila-modal">
                            <span class="calendario-barra-visita calendario-barra-visita-fila"></span>
                            <span class="calendario-fila-texto">
                                <span class="calendario-fila-principal">@visita.CentroNombre</span>
                                <span class="calendario-fila-secundaria">@DetalleVisita(visita)</span>
                            </span>
                            @if (visita.NotificadoCliente)
                            {
                                <Badge Tono="TonoBadge.Exito" title="@Textos["NotificadaDetalle"]">@Textos["Notificada"]</Badge>
                            }
                            else
                            {
                                <Badge Tono="TonoBadge.Advertencia" title="@Textos["SinNotificarDetalle"]">@Textos["SinNotificar"]</Badge>
                            }
                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => GestionarVisita(visita.Id)">
                                @Textos["IrAVisitas"]
                            </Boton>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</Modal>
