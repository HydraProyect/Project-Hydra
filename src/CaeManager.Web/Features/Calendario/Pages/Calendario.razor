@page "/calendario"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Calendario.Queries
@using CaeManager.Web.Features.Documentos

<PageTitle>Calendario — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Calendario de vencimientos</h1>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el calendario" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <div class="calendario-navegacion">
            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesAnteriorAsync">← Mes anterior</Boton>
            <div class="calendario-mes-actual">
                <span class="calendario-titulo-mes">@TituloMes.Substring(0, 1).ToUpperInvariant()@TituloMes.Substring(1)</span>
                <button type="button" class="enlace-hoy" @onclick="MesActualAsync">Hoy</button>
            </div>
            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesSiguienteAsync">Mes siguiente →</Boton>
        </div>

        <div class="calendario-leyenda">
            <span class="calendario-leyenda-item"><span class="calendario-leyenda-punto calendario-leyenda-punto-peligro"></span>Vencido / urgente</span>
            <span class="calendario-leyenda-item"><span class="calendario-leyenda-punto calendario-leyenda-punto-advertencia"></span>Próximo</span>
            <span class="calendario-leyenda-item"><span class="calendario-leyenda-punto calendario-leyenda-punto-exito"></span>Vigente</span>
            <span class="calendario-leyenda-item"><span class="calendario-leyenda-punto calendario-leyenda-punto-info"></span>Visitas programadas</span>
        </div>

        @if (_cargando)
        {
            <EstadoCargando Filas="4" />
        }
        else
        {
            <div class="calendario-rejilla">
                @foreach (var nombreDia in NombresDiasSemana)
                {
                    <div class="calendario-cabecera-dia">@nombreDia</div>
                }

                @foreach (var celda in CeldasDelMes())
                {
                    @if (celda is null)
                    {
                        <div class="calendario-celda calendario-celda-vacia"></div>
                    }
                    else
                    {
                        var dia = celda.Value;
                        var vencimientosDelDia = VencimientosDelDia(dia);
                        var visitasDelDia = VisitasDelDia(dia);
                        var peorEstado = PeorEstado(vencimientosDelDia);
                        var esHoy = dia == DateOnly.FromDateTime(DateTime.Today);
                        var tieneDatos = vencimientosDelDia.Count > 0 || visitasDelDia.Count > 0;

                        <div class="calendario-celda @(esHoy ? "calendario-celda-hoy" : "") @(tieneDatos ? "calendario-celda-con-datos" : "")"
                             @onclick="() => SeleccionarDia(dia)">
                            <span class="calendario-dia-numero">@dia.Day</span>
                            <span class="calendario-indicadores">
                                @if (peorEstado is not null)
                                {
                                    <span class="calendario-indicador">
                                        <Badge Tono="EstadoDocumentoUi.Tono(peorEstado.Value)">@vencimientosDelDia.Count</Badge>
                                    </span>
                                }
                                @if (visitasDelDia.Count > 0)
                                {
                                    <span class="calendario-indicador" title="Visitas programadas">
                                        <Badge Tono="TonoBadge.Info">@visitasDelDia.Count</Badge>
                                    </span>
                                }
                            </span>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<Modal Visible="@(_diaSeleccionado is not null)"
       VisibleChanged="@((bool visible) => { if (!visible) CerrarDetalle(); })"
       Titulo="@(_diaSeleccionado is not null ? $"{_diaSeleccionado:dd/MM/yyyy}" : string.Empty)">
    @if (_diaSeleccionado is not null)
    {
        var vencimientosDelDiaSeleccionado = VencimientosDelDia(_diaSeleccionado.Value);
        var visitasDelDiaSeleccionado = VisitasDelDia(_diaSeleccionado.Value);

        @if (vencimientosDelDiaSeleccionado.Count > 0)
        {
            <h3 class="calendario-subtitulo-modal">Vencimientos</h3>
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>Estado</th>
                        <th>Trabajador</th>
                        <th>Tipo de documento</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vencimiento in vencimientosDelDiaSeleccionado)
                    {
                        <tr>
                            <td><Badge Tono="EstadoDocumentoUi.Tono(vencimiento.Estado)">@EstadoDocumentoUi.Texto(vencimiento.Estado)</Badge></td>
                            <td>@vencimiento.TrabajadorNombre</td>
                            <td>@vencimiento.TipoDocumentoNombre</td>
                            <td>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => GestionarDocumento(vencimiento.DocumentoId)">
                                    Gestionar
                                </Boton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (visitasDelDiaSeleccionado.Count > 0)
        {
            <h3 class="calendario-subtitulo-modal">Visitas programadas</h3>
            <div class="calendario-tabla-modal-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>Centro / Cliente</th>
                        <th>Trabaj.</th>
                        <th>Notif.</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visita in visitasDelDiaSeleccionado)
                    {
                        <tr>
                            <td>@visita.CentroNombre<div class="calendario-fila-secundaria">@visita.ClienteRazonSocial</div></td>
                            <td>@visita.TotalTrabajadores</td>
                            <td>
                                @if (visita.NotificadoCliente)
                                {
                                    <Badge Tono="TonoBadge.Exito">Sí</Badge>
                                }
                                else
                                {
                                    <Badge Tono="TonoBadge.Advertencia">No</Badge>
                                }
                            </td>
                            <td>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => GestionarVisita(visita.Id)">
                                    Gestionar
                                </Boton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
</Modal>
