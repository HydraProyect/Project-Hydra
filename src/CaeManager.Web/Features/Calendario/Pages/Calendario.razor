@page "/calendario"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Calendario.Queries
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Comunes
@using CaeManager.Web.Features.Calendario.Components
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Domain.Documentos

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]">
        <Acciones>
            @if (!_error)
            {
                <div class="calendario-vistas" role="tablist" aria-label="@Textos["Vista"]">
                    <button @ref="_tabMes" id="calendario-tab-mes" type="button" role="tab" aria-controls="calendario-panel" tabindex="@(_vistaSemana ? -1 : 0)" aria-selected="@(!_vistaSemana ? "true" : "false")"
                            @onkeydown="e => CambiarVistaTecladoAsync(e, false)" @onclick="() => CambiarVistaAsync(false)">@Textos["Mes"]</button>
                    <button @ref="_tabSemana" id="calendario-tab-semana" type="button" role="tab" aria-controls="calendario-panel" tabindex="@(_vistaSemana ? 0 : -1)" aria-selected="@(_vistaSemana ? "true" : "false")"
                            @onkeydown="e => CambiarVistaTecladoAsync(e, true)" @onclick="() => CambiarVistaAsync(true)">@Textos["SemanaPorEmpresa"]</button>
                </div>
                <div class="calendario-navegacion">
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesAnteriorAsync" class="calendario-control" aria-label="@Textos[_vistaSemana ? "SemanaAnterior" : "MesAnterior"]">
                        <span class="calendario-flecha-anterior"><Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" /></span>
                    </Boton>
                    <span class="calendario-titulo-mes" aria-live="polite">@TituloMes</span>
                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesSiguienteAsync" class="calendario-control" aria-label="@Textos[_vistaSemana ? "SemanaSiguiente" : "MesSiguiente"]">
                        <Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" />
                    </Boton>
                </div>
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="MesActualAsync" class="calendario-control calendario-hoy-boton">@Textos["Hoy"]</Boton>
            }
        </Acciones>
    </CabeceraPagina>

    <div id="calendario-panel" role="tabpanel" aria-labelledby="@(_vistaSemana ? "calendario-tab-semana" : "calendario-tab-mes")">
    @if (_error)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="@(_vistaSemana ? 5 : 4)" />
    }
    else if (_vistaSemana)
    {
        <SemanaPorEmpresa Lunes="_semanaActual" Hoy="HoyEfectivo" Empresas="_empresasSemana"
                          OnReclamar="empresa => _empresaReclamacion = empresa" />
    }
    else
    {
        <div class="calendario-rejilla">
            @foreach (var nombreDia in NombresDiasSemana)
            {
                <div class="calendario-cabecera-dia">@nombreDia</div>
            }

            @foreach (var celda in CeldasDelMes())
            {
                @if (!celda.DelMes)
                {
                    @* Días del mes anterior/siguiente que completan la semana: se
                       pintan atenuados para orientar, pero no se consultan (la
                       carga es por mes), así que no pueden afirmar nada — ni
                       recuento ni «sin eventos». Por eso tampoco son botón. *@
                    <div class="calendario-celda calendario-celda-fuera" aria-hidden="true">
                        <span class="calendario-dia-numero">@celda.Fecha.Day</span>
                    </div>
                }
                else
                {
                    var dia = celda.Fecha;
                    var vencimientosDelDia = VencimientosDelDia(dia);
                    var visitasDelDia = VisitasDelDia(dia);
                    var peorEstado = PeorEstado(vencimientosDelDia);
                    var esHoy = dia == HoyEfectivo;
                    var claseNumero = esHoy ? "calendario-dia-numero calendario-dia-hoy" : "calendario-dia-numero";

                    @if (vencimientosDelDia.Count == 0 && visitasDelDia.Count == 0)
                    {
                        <div class="calendario-celda">
                            <span class="@claseNumero">@dia.Day</span>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="calendario-celda calendario-celda-con-datos"
                                aria-label="@EtiquetaDia(dia, vencimientosDelDia, visitasDelDia, peorEstado)"
                                title="@EtiquetaDia(dia, vencimientosDelDia, visitasDelDia, peorEstado)"
                                @onclick="() => SeleccionarDia(dia)">
                            <span class="@claseNumero">@dia.Day</span>
                            @if (peorEstado is not null)
                            {
                                <Badge Tono="EstadoDocumentoUi.TonoDeSeveridad(peorEstado.Value)">@vencimientosDelDia.Count</Badge>
                            }
                            @if (visitasDelDia.Count > 0)
                            {
                                <span class="calendario-visitas">
                                    <span class="calendario-barra-visita"></span>
                                    @if (visitasDelDia.Count > 1)
                                    {
                                        <span class="calendario-visitas-numero">@visitasDelDia.Count</span>
                                    }
                                </span>
                            }
                        </button>
                    }
                }
            }
        </div>
    }

    @* La leyenda va bajo la rejilla del Mes y bajo la tabla de la Semana (mockup: una sola leyenda para las dos vistas).
       Dice lo que PeorEstado calcula con el semáforo único del sistema (EstadoDocumentoUi): Urgente es rojo como
       Vencido, y un día puede ser verde si todo lo que vence en él aún está vigente. El mockup Gen 2 dibuja solo
       rojo = «algún vencido» y ámbar = «próximos o urgentes»; copiar esa frase afirmaría algo que esta pantalla
       no pinta. *@
    @if (!_error && !_cargando)
    {
        <div class="calendario-leyenda">
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Peligro">n</Badge>@Textos["LeyendaVencidoOUrgente"]</span>
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Advertencia">n</Badge>@Textos["LeyendaProximo"]</span>
            <span class="calendario-leyenda-item"><Badge Tono="TonoBadge.Exito">n</Badge>@Textos["LeyendaVigente"]</span>
            <span class="calendario-leyenda-item"><span class="calendario-barra-visita calendario-barra-visita-leyenda"></span>@Textos["LeyendaVisita"]</span>
            <span>@Textos["LeyendaExplicacion"]</span>
        </div>
    }
    </div>
</div>

<DetalleDia Fecha="_diaSeleccionado" Vencimientos="@FilasDelDiaSeleccionado" Visitas="@VisitasDelDiaSeleccionado" OnCerrar="CerrarDetalle" />
@if (_empresaReclamacion is { } empresa)
{
    <DrawerReclamacionLote @key="empresa.EmpresaId" Visible="true"
                          VisibleChanged="v => { if (!v) _empresaReclamacion = null; }"
                          AmbitosDisponibles="@(new[] { AmbitoAplicacion.Empresa, AmbitoAplicacion.Trabajador })"
                          DocumentoIdsIniciales="@(empresa.Documentos.Select(d => d.DocumentoId).ToArray())"
                          TitularIdInicial="empresa.EmpresaId"
                          OnReclamacionEnviada="CargarAsync" />
}
</LimiteDeErrores>
