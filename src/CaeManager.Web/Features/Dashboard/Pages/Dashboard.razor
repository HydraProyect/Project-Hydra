@page "/"
@rendermode InteractiveServer
@using CaeManager.Application.Dashboard.Queries
@using CaeManager.Web.Features.Documentos

<PageTitle>Dashboard — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="dashboard-cabecera">
        <span class="dashboard-kicker">Dashboard</span>
        <h1 class="titulo-pagina">@Saludo</h1>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el dashboard" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_kpis is null)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_kpis.SinCarteraAsignada)
    {
        <EstadoVacio Titulo="Sin cartera asignada" Descripcion="Todavía no tienes ningún cliente asignado, así que no hay datos que mostrar. Pide a tu Coordinador o a un Administrador de la plataforma que te asigne cartera." />
    }
    else
    {
        <div class="rejilla-kpis-criticos">
            <TarjetaMetrica Etiqueta="Documentos vencidos" Valor="@_kpis.DocumentosVencidos.ToString()" Tono="TonoBadge.Peligro" Enlace="/alertas?estado=Vencido" />
            <TarjetaMetrica Etiqueta="Urgentes (≤15 días)" Valor="@_kpis.DocumentosUrgentes.ToString()" Tono="TonoBadge.Peligro" Enlace="/alertas?estado=Urgente" />
            <TarjetaMetrica Etiqueta="Próximos (≤30 días)" Valor="@_kpis.DocumentosProximos.ToString()" Tono="TonoBadge.Advertencia" Enlace="/alertas?estado=Proximo" />
            <TarjetaMetrica Etiqueta="SLA documental" Valor="@($"{_kpis.TasaCumplimientoDocumental}%")"
                            Tono="@SlaDocumentalTono(_kpis.TasaCumplimientoDocumental)" Enlace="/documentos" />
        </div>

        @if (_mostrarDocumentosAtencion && _desglose is not null)
        {
            <Tarjeta Titulo="Documentos que requieren atención">
                @if (_desglose.DocumentosAtencion.Count == 0)
                {
                    <p class="texto-vacio-seccion">No hay documentos urgentes ni vencidos ahora mismo.</p>
                }
                else
                {
                    <table class="tabla-datos">
                        <thead>
                            <tr>
                                <th>Estado</th>
                                <th>Trabajador</th>
                                <th>Tipo de documento</th>
                                <th>Vencimiento</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var documento in _desglose.DocumentosAtencion)
                            {
                                <tr class="fila-clicable" @onclick="() => IrADocumento(documento.DocumentoId)">
                                    <td><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></td>
                                    <td>@documento.TrabajadorNombre</td>
                                    <td>@documento.TipoDocumentoNombre</td>
                                    <td>@(documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a class="enlace-ver-todas" href="/alertas">Ver todas las alertas →</a>
                }
            </Tarjeta>
        }

        <h2 class="dashboard-subtitulo">Actividad general</h2>
        <div class="rejilla-kpis-secundarios">
            <TarjetaMetrica Discreta="true" Etiqueta="Trabajadores activos" Valor="@_kpis.TrabajadoresActivos.ToString()" Enlace="/trabajadores" />
            <TarjetaMetrica Discreta="true" Etiqueta="Centros / plataformas" Valor="@_kpis.Centros.ToString()" Enlace="/centros" />
            <TarjetaMetrica Discreta="true" Etiqueta="Vigentes" Valor="@_kpis.DocumentosVigentes.ToString()" Enlace="/documentos?estado=Vigente" />
            <TarjetaMetrica Discreta="true" Etiqueta="Visitas programadas" Valor="@_kpis.VisitasProgramadas.ToString()" Enlace="/visitas" />
        </div>

        @if (_mostrarDocumentosAtencion && _desglose is not null)
        {
            <div class="rejilla-desglose">
                @if (_estadisticasAprobacion is not null)
                {
                    <Tarjeta Titulo="Gestiones automáticas vs manuales">
                        @if (TotalAprobaciones == 0)
                        {
                            <p class="texto-vacio-seccion">Todavía no hay documentos verificados por IA.</p>
                        }
                        else
                        {
                            <div class="barra-comparativa" role="img" aria-label="@($"{PorcentajeAutomatica}% de las gestiones fueron automáticas, {PorcentajeManual}% manuales")">
                                @if (PorcentajeAutomatica > 0)
                                {
                                    <div class="barra-comparativa-segmento barra-comparativa-automatica" style="width:@(PorcentajeAutomatica)%"></div>
                                }
                                @if (PorcentajeManual > 0)
                                {
                                    <div class="barra-comparativa-segmento barra-comparativa-manual" style="width:@(PorcentajeManual)%"></div>
                                }
                            </div>
                            <ul class="barra-comparativa-leyenda">
                                <li class="barra-comparativa-item">
                                    <span class="barra-comparativa-punto barra-comparativa-automatica"></span>
                                    Automáticas — @_estadisticasAprobacion.Automaticas (@PorcentajeAutomatica%)
                                </li>
                                <li class="barra-comparativa-item">
                                    <span class="barra-comparativa-punto barra-comparativa-manual"></span>
                                    Manuales — @_estadisticasAprobacion.Manuales (@PorcentajeManual%)
                                </li>
                            </ul>
                        }
                    </Tarjeta>
                }

                @if (_mostrarCentrosEnRiesgo)
                {
                    <Tarjeta Titulo="Centros con más riesgo">
                        @if (_desglose.CentrosEnRiesgo.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Ningún centro tiene documentación urgente o vencida.</p>
                        }
                        else
                        {
                            <table class="tabla-datos">
                                <thead>
                                    <tr>
                                        <th>Centro</th>
                                        <th>Cliente</th>
                                        <th>Vencidos</th>
                                        <th>Urgentes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var centro in _desglose.CentrosEnRiesgo)
                                    {
                                        <tr class="fila-clicable" @onclick="() => IrACentro(centro.CentroNombre)">
                                            <td>@centro.CentroNombre</td>
                                            <td>@centro.ClienteNombre</td>
                                            <td><Badge Tono="TonoBadge.Peligro">@centro.DocumentosVencidos</Badge></td>
                                            <td><Badge Tono="TonoBadge.Advertencia">@centro.DocumentosUrgentes</Badge></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </Tarjeta>
                }

                @if (_mostrarEmpresasEnRiesgo)
                {
                    <Tarjeta Titulo="Empresas con más riesgo">
                        @if (_desglose.EmpresasEnRiesgo.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Ninguna empresa tiene documentación urgente o vencida.</p>
                        }
                        else
                        {
                            <table class="tabla-datos">
                                <thead>
                                    <tr>
                                        <th>Empresa</th>
                                        <th>Vencidos</th>
                                        <th>Urgentes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var empresa in _desglose.EmpresasEnRiesgo)
                                    {
                                        <tr class="fila-clicable" @onclick="() => IrAEmpresa(empresa.EmpresaRazonSocial)">
                                            <td>@empresa.EmpresaRazonSocial</td>
                                            <td><Badge Tono="TonoBadge.Peligro">@empresa.DocumentosVencidos</Badge></td>
                                            <td><Badge Tono="TonoBadge.Advertencia">@empresa.DocumentosUrgentes</Badge></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </Tarjeta>
                }
            </div>
        }
    }
</div>
