@page "/"
@rendermode InteractiveServer
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Visitas

<PageTitle>Dashboard — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="dashboard-cabecera">
        <span class="dashboard-kicker">Dashboard</span>
        <h1 class="titulo-pagina">@Saludo</h1>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el dashboard" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_kpis is null)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_kpis.SinCarteraAsignada)
    {
        <EstadoVacio Titulo="Sin cartera asignada" Descripcion="Todavía no tienes ningún cliente asignado, así que no hay datos que mostrar. Pide a tu Coordinador o a un Administrador de la plataforma que te asigne cartera." />
    }
    else
    {
        @* Resumen de ausencia (docs/blueprints/OPERATIONAL-HOME.md § 6, DDL-068): solo aparece
           al volver tras una ausencia real, nunca en navegación normal dentro de la sesión. *@
        @if (_queLlegoSinVer.Count > 0)
        {
            <h2 class="dashboard-subtitulo">Qué llegó sin ver</h2>
            <div class="lista-bandeja">
                @foreach (var item in _queLlegoSinVer)
                {
                    <PanelResolverItem Item="item" />
                }
            </div>
        }

        @* Cumplimiento global + KPIs secundarios (docs/blueprints/OPERATIONAL-HOME.md § 3):
           sustituye los 4 tiles críticos (Vencidos/Urgentes/Próximos/SLA) — esos conteos ahora
           se leen directamente en "Requiere atención", no como cifra suelta sin acción asociada. *@
        <div class="dashboard-resumen">
            <div class="dashboard-resumen-anillo">
                <AnilloCumplimiento Porcentaje="_kpis.TasaCumplimientoDocumental" Tamano="TamanoAnillo.Medio"
                                     Etiqueta="@($"{_kpis.TasaCumplimientoDocumental}% de cumplimiento documental")" />
                <span class="dashboard-resumen-anillo-etiqueta">Cumplimiento documental</span>
            </div>
            <div class="rejilla-kpis-secundarios">
                <TarjetaMetrica Discreta="true" Etiqueta="Trabajadores activos" Valor="@_kpis.TrabajadoresActivos.ToString()" NombreIcono="trabajadores" Enlace="/trabajadores" />
                <TarjetaMetrica Discreta="true" Etiqueta="Centros / plataformas" Valor="@_kpis.Centros.ToString()" NombreIcono="centros" Enlace="/centros" />
                <TarjetaMetrica Discreta="true" Etiqueta="Vigentes" Valor="@_kpis.DocumentosVigentes.ToString()" NombreIcono="check" Enlace="/documentos?estado=Vigente" />
                <TarjetaMetrica Discreta="true" Etiqueta="Visitas programadas" Valor="@_kpis.VisitasProgramadas.ToString()" NombreIcono="visitas" Enlace="/visitas" />
            </div>
        </div>

        @if (_mostrarRequiereAtencion)
        {
            <h2 class="dashboard-subtitulo">Requiere atención</h2>
            @if (_requiereAtencion.Count == 0)
            {
                @* Cierre verificado (DDL-071): "nada pendiente" solo tranquiliza si dice
                   también qué viene después — el próximo vencimiento conocido. *@
                <p class="texto-vacio-seccion">@TextoCierreAtencion</p>
            }
            else
            {
                <div class="lista-bandeja">
                    @foreach (var item in _requiereAtencion)
                    {
                        <PanelResolverItem Item="item" />
                    }
                </div>
                <a class="enlace-ver-todas" href="/bandeja">Ver todo en Bandeja →</a>
            }

            @if (_pulso is not null)
            {
                @* Pulso del equipo (DDL-071): agregado semanal contra el propio histórico,
                   sin desglose por persona. El copy enuncia hechos con cifras (01 § 7) — la
                   comparación es con la mejor semana del equipo, nunca un ranking. *@
                <h2 class="dashboard-subtitulo">Pulso del equipo</h2>
                <Tarjeta>
                    @if (_pulso.ResueltosEstaSemana == 0 && _pulso.MejorSemanaInicio is null)
                    {
                        <p class="texto-vacio-seccion">Todavía no hay documentos resueltos — el pulso semanal aparecerá con la primera verificación.</p>
                    }
                    else
                    {
                        <p class="pulso-equipo-cifra">@_pulso.ResueltosEstaSemana @(_pulso.ResueltosEstaSemana == 1 ? "documento resuelto" : "documentos resueltos") esta semana</p>
                        <p class="pulso-equipo-detalle">
                            Semana anterior: @_pulso.ResueltosSemanaAnterior.
                            @if (_pulso.MejorSemanaInicio is { } inicioMejor)
                            {
                                @($" Mejor semana del equipo: {_pulso.MejorSemanaHistorica} (semana del {inicioMejor:dd/MM}).")
                            }
                        </p>
                        @if (_pulso.EsMejorSemana)
                        {
                            <p class="pulso-equipo-detalle">Esta ya es la mejor semana del equipo hasta ahora.</p>
                        }
                    }
                </Tarjeta>
            }
        }

        <h2 class="dashboard-subtitulo">Próximamente</h2>
        @if (_proximamente.Count == 0)
        {
            <p class="texto-vacio-seccion">No hay visitas programadas.</p>
        }
        else
        {
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>Centro</th>
                        <th>Cliente</th>
                        <th>Fechas</th>
                        <th>Trabajadores</th>
                        <th>Urgencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visita in _proximamente)
                    {
                        <tr class="fila-clicable" @onclick="@(() => NavigationManager.NavigateTo("/visitas"))">
                            <td>@visita.CentroNombre</td>
                            <td>@visita.ClienteRazonSocial</td>
                            <td>@visita.FechaInicio.ToString("dd/MM/yyyy") – @visita.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@visita.TotalTrabajadores</td>
                            <td><Badge Tono="NivelUrgenciaVisitaUi.Tono(visita.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(visita.NivelUrgencia)</Badge></td>
                        </tr>
                    }
                </tbody>
            </table>
            <a class="enlace-ver-todas" href="/visitas">Ver todas en Visitas →</a>
        }
    }
</div>
