@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Web.Features.Bandeja
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Dashboard.Components
@using CaeManager.Web.Features.Visitas

<PageTitle>Dashboard — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* La cabecera del mockup lleva a la derecha la fecha de hoy y un indicador
       de sistema. El indicador dice ahí «Recuentos calculados en tiempo real»;
       aquí dice la hora de la lectura, que es lo único cierto: esta pantalla no
       refresca sola. Solo aparece cuando ya hay algo cargado — durante el
       esqueleto no hay ninguna hora que afirmar. *@
    <CabeceraPagina Titulo="@Saludo" Kicker="Dashboard">
        <Acciones>
            <span class="inicio-cabecera-meta">
                <span class="inicio-fecha">@FechaDeHoy</span>
                @if (TextoActualizado is { } actualizado)
                {
                    <span class="inicio-separador" aria-hidden="true">·</span>
                    <span class="inicio-indicador-sistema">
                        <span class="inicio-punto-sistema" aria-hidden="true"></span>@actualizado
                    </span>
                }
            </span>
        </Acciones>
    </CabeceraPagina>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el dashboard" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_kpis is null)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_kpis.SinCarteraAsignada)
    {
        <EstadoVacio Titulo="Sin cartera asignada" Descripcion="Todavía no tienes ningún cliente asignado, así que no hay datos que mostrar. Pide a tu Coordinador o a un Administrador de la plataforma que te asigne cartera." />
    }
    else
    {
        @if (_queLlegoSinVer.Count > 0)
        {
            <div class="inicio-seccion-cabecera">
                <h2 class="dashboard-subtitulo">Qué llegó sin ver</h2>
                <span class="inicio-seccion-meta">@ResumenQueLlegoSinVer</span>
            </div>
            <div class="dashboard-lista-unificada">
                @foreach (var item in _queLlegoSinVer)
                {
                    <PanelResolverItem Item="item" />
                }
            </div>
        }

        @if (_mostrarRequiereAtencion && _bandejaAgrupada is { } bandeja)
        {
            <div class="inicio-seccion-cabecera">
                <h2 class="dashboard-subtitulo">Requiere atención</h2>
                @if (ResumenAtencion is { } resumenAtencion)
                {
                    <span class="inicio-seccion-meta">@resumenAtencion</span>
                }
            </div>
            @if (bandeja.Grupos.Count == 0 && bandeja.SinGrupo.Count == 0)
            {
                @* Cierre verificado (DDL-071): "nada pendiente" solo tranquiliza si dice
                   también qué viene después — el próximo vencimiento conocido. El mockup
                   lo pinta como tarjeta con marca de éxito y salida al Calendario, no
                   como un párrafo suelto: es el único momento en que esta pantalla da
                   una buena noticia. *@
                <div class="inicio-cierre">
                    <span class="inicio-cierre-marca" aria-hidden="true">
                        <Icono Nombre="exito-circulo" Tamano="TamanoIcono.Pequeno" />
                    </span>
                    <p class="inicio-cierre-texto">@TextoCierreAtencion</p>
                    <a class="inicio-cierre-enlace" href="/calendario">Ver calendario →</a>
                </div>
            }
            else
            {
                <div class="lista-bandeja">
                    @for (var i = 0; i < Math.Min(bandeja.Grupos.Count, MaximoGruposAtencion); i++)
                    {
                        <GrupoCola @key="bandeja.Grupos[i].GrupoId" Grupo="bandeja.Grupos[i]"
                                   ExpandidaPorDefecto="@(i == 0 && TipoItemBandejaUi.BloqueaAccesoDeVerdad(bandeja.Grupos[i]))"
                                   Compacto="true" AgruparPorEmpresa="AgruparPorEmpresa" />
                    }
                    @foreach (var item in bandeja.SinGrupo)
                    {
                        <PanelResolverItem @key="item.Id" Item="item" />
                    }
                </div>
                @* El mockup deja la salida a la cola completa siempre visible, no solo
                   cuando el resumen se queda corto: aquí se ven como mucho
                   MaximoGruposAtencion grupos, y quien quiere operar de verdad va a
                   Mi trabajo tanto si son tres como si son treinta. *@
                <a class="enlace-ver-todas" href="/bandeja">Ver todo en Mi trabajo →</a>
            }

            @if (_pendientePorPlataforma.Count > 0)
            {
                <h2 class="dashboard-subtitulo">Pendiente por plataforma</h2>
                <div class="dashboard-lista-unificada">
                    @foreach (var plataforma in _pendientePorPlataforma)
                    {
                        <FilaPlataforma Plataforma="plataforma" />
                    }
                </div>
            }

            @if (_sinRespuesta.Count > 0)
            {
                <h2 class="dashboard-subtitulo">Reclamado y sin respuesta</h2>
                <div class="dashboard-lista-unificada">
                    @foreach (var reclamacion in _sinRespuesta)
                    {
                        <div class="dashboard-sin-respuesta-fila">
                            <span class="dashboard-sin-respuesta-texto">
                                <span class="dashboard-sin-respuesta-cliente">@reclamacion.RazonSocialTitular</span> —
                                @reclamacion.TotalDocumentos documento@(reclamacion.TotalDocumentos == 1 ? "" : "s")
                                reclamado@(reclamacion.TotalDocumentos == 1 ? "" : "s") hace @reclamacion.DiasTranscurridos días, sin respuesta.
                            </span>
                            <Badge Tono="TonoBadge.Advertencia">Sin respuesta</Badge>
                            <a class="enlace-ver-todas" href="/documentos?pestana=reclamaciones">Revisar y reclamar →</a>
                        </div>
                    }
                </div>
            }
        }

        @* Cumplimiento + KPIs secundarios: DESPUÉS de "Reclamado y sin respuesta"
           (mockup Inicio TALVEG — Parte XV SCREEN 01, § 5-11). La prioridad es
           dar de primera vista lo que hay que GESTIONAR; una cifra de
           cumplimiento no suma nada por sí sola y no compite por ese primer
           vistazo (01 § 5.3: Action + Exception sobre Information). Visible
           también para Cliente (fuera del bloque _mostrarRequiereAtencion),
           que no tiene cola que gestionar pero sí su propio cumplimiento. *@
        <div class="dashboard-resumen">
            <div class="dashboard-resumen-tarjeta-anillo">
                <AnilloCumplimiento Porcentaje="_kpis.TasaCumplimientoDocumental" Tamano="TamanoAnillo.Grande" Leyenda="Cumplimiento"
                                     Etiqueta="@($"{_kpis.TasaCumplimientoDocumental}% de cumplimiento documental")" />
                <div>
                    <p class="dashboard-resumen-anillo-titulo">@_kpis.TasaCumplimientoDocumental% de cumplimiento documental</p>
                    <p class="dashboard-resumen-anillo-detalle">@_kpis.DocumentosVigentes.ToString("N0") de @TotalDocumentosConVigencia.ToString("N0") documentos vigentes en cartera</p>
                    @* "Desglosar por cliente" del mockup no tiene destino real todavía
                       (no hay vista de cumplimiento agrupada por cliente para este rol —
                       Visión de cartera exige Coordinador+; Reportes, P-14, es de todo el
                       tenant sin filtro). Enlaza al informe más cercano que existe hoy en
                       vez de a un enlace roto; construir el desglose real queda pendiente. *@
                    <a class="dashboard-resumen-anillo-enlace" href="/reportes">Desglosar por cliente →</a>
                </div>
            </div>
            <div class="rejilla-kpis-secundarios">
                <TarjetaMetrica Discreta="true" Etiqueta="Trabajadores activos" Valor="@_kpis.TrabajadoresActivos.ToString()" NombreIcono="trabajadores" Enlace="/trabajadores"
                                 Pista="@(_kpis.TrabajadoresNuevosEsteMes > 0 ? $"{_kpis.TrabajadoresNuevosEsteMes} nuevos este mes" : null)" />
                <TarjetaMetrica Discreta="true" Etiqueta="Centros / plataformas" Valor="@_kpis.Centros.ToString()" NombreIcono="centros" Enlace="/centros"
                                 Pista="@(CentrosBloqueados > 0 ? $"{CentrosBloqueados} centro{(CentrosBloqueados == 1 ? "" : "s")} bloqueado{(CentrosBloqueados == 1 ? "" : "s")}" : null)" />
                <TarjetaMetrica Discreta="true" Etiqueta="Vigentes" Valor="@_kpis.DocumentosVigentes.ToString()" NombreIcono="check" Enlace="/documentos?estado=Vigente"
                                 Pista="@(DocumentosFueraDeVigencia > 0 ? $"{DocumentosFueraDeVigencia} fuera de vigencia" : null)" />
                <TarjetaMetrica Discreta="true" Etiqueta="Visitas programadas" Valor="@_kpis.VisitasProgramadas.ToString()" NombreIcono="visitas" Enlace="/visitas"
                                 Pista="@(_proximamente.Count > 0 ? $"próxima el {_proximamente[0].FechaInicio:dd/MM}" : null)" />
            </div>
        </div>

        @* El mockup sube «Ver todas las visitas» a la cabecera de la sección: la
           tabla muestra como mucho MaximoVisitasProximas, así que la salida al
           listado completo tiene que verse antes de recorrerla, no después. *@
        <div class="inicio-seccion-cabecera">
            <h2 class="dashboard-subtitulo">Próximamente</h2>
            @if (_proximamente.Count > 0)
            {
                <a class="inicio-seccion-enlace" href="/visitas">Ver todas las visitas →</a>
            }
        </div>
        @if (_proximamente.Count == 0)
        {
            <p class="texto-vacio-seccion">No hay visitas programadas.</p>
        }
        else
        {
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>Centro</th>
                        <th>Cliente</th>
                        <th>Fechas</th>
                        <th>Trabajadores</th>
                        <th>Urgencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visita in _proximamente)
                    {
                        <tr class="fila-clicable" @onclick="@(() => NavigationManager.NavigateTo("/visitas"))">
                            <td class="dashboard-visita-centro">@visita.CentroNombre</td>
                            <td>@visita.ClienteRazonSocial</td>
                            <td>@visita.FechaInicio.ToString("dd/MM/yyyy") – @visita.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>@visita.TotalTrabajadores</td>
                            <td><Badge Tono="NivelUrgenciaVisitaUi.Tono(visita.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(visita.NivelUrgencia)</Badge></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* Pulso del equipo: al final de la pantalla (mockup Inicio TALVEG) —
           es un insight de moral de equipo, no algo que gestionar, así que va
           después de todo lo accionable. Visible solo si hay cartera con cola
           que gestionar (_pulso solo se calcula dentro de _mostrarRequiereAtencion). *@
        @if (_pulso is not null)
        {
            <div class="dashboard-pulso">
                @if (_pulso.ResueltosEstaSemana == 0 && _pulso.MejorSemanaInicio is null)
                {
                    <div class="dashboard-pulso-eyebrow">
                        <span class="dashboard-pulso-etiqueta"><Icono Nombre="pulso" Tamano="TamanoIcono.Pequeno" /> Pulso del equipo</span>
                        <span class="dashboard-pulso-cifra">Todavía no hay documentos resueltos esta semana.</span>
                    </div>
                }
                else
                {
                    <div class="dashboard-pulso-eyebrow">
                        <span class="dashboard-pulso-etiqueta"><Icono Nombre="pulso" Tamano="TamanoIcono.Pequeno" /> Pulso del equipo</span>
                        <span class="dashboard-pulso-cifra">@_pulso.ResueltosEstaSemana @(_pulso.ResueltosEstaSemana == 1 ? "documento resuelto" : "documentos resueltos") esta semana.</span>
                    </div>
                    <div class="dashboard-pulso-comparativa">
                        <div class="dashboard-pulso-metrica">
                            <span class="dashboard-pulso-metrica-etiqueta">Semana anterior</span>
                            <span class="dashboard-pulso-metrica-valor">
                                @_pulso.ResueltosSemanaAnterior
                                @if (_pulso.ResueltosEstaSemana > _pulso.ResueltosSemanaAnterior)
                                {
                                    <span class="dashboard-pulso-tendencia" title="Esta semana vais por encima de la anterior"><Icono Nombre="tendencia" Tamano="TamanoIcono.Pequeno" /></span>
                                }
                            </span>
                        </div>
                        @if (_pulso.MejorSemanaInicio is not null)
                        {
                            <div class="dashboard-pulso-metrica">
                                <span class="dashboard-pulso-metrica-etiqueta">Mejor semana</span>
                                <span class="dashboard-pulso-metrica-valor">
                                    @_pulso.MejorSemanaHistorica
                                    @if (_pulso.ResueltosEstaSemana >= _pulso.MejorSemanaHistorica)
                                    {
                                        <span class="dashboard-pulso-tendencia" title="Esta semana iguala o supera vuestra mejor semana"><Icono Nombre="tendencia" Tamano="TamanoIcono.Pequeno" /></span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                }
                <a class="dashboard-pulso-enlace" href="/auditoria">Ver actividad del equipo →</a>
            </div>
        }
    }
</div>
