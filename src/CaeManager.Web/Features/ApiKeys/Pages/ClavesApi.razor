@page "/configuracion/claves-api"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>Claves API — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina claves-api">
    <CabeceraPagina Titulo="Claves de la API pública" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>La API pública (<code>/api/v1</code>, solo lectura por ahora) se autentica con estas claves de TALVEG, una por integración. Solo se emiten para una organización con una delegación de soporte ya existente.</Descripcion>
    </CabeceraPagina>
    @if (_delegacionesSoporte.Count == 0 && !_cargandoDelegaciones)
    {
        <EstadoVacio Titulo="No hay ninguna delegación de soporte disponible" Descripcion="Antes de emitir una clave hace falta una delegación de soporte con una organización (ver Delegaciones)." />
    }
    else
    {
        <section class="claves-api-panel" aria-label="Claves API">
            <CampoSelect Etiqueta="Organización con delegación de soporte" Valor="@(_delegacionSeleccionadaId?.ToString() ?? string.Empty)" ValorChanged="OnDelegacionSeleccionadaAsync">
                <option value="">Selecciona una organización…</option>
                @foreach (var delegacion in _delegacionesSoporte) { <option value="@delegacion.Id">@delegacion.ClienteNombre</option> }
            </CampoSelect>
            @if (_delegacionSeleccionadaId is not null)
            {
                <div class="claves-api-acciones"><Boton OnClick="AbrirGeneracion">Generar clave</Boton></div>
                @if (_cargandoClaves) { <EstadoCargando Filas="3" /> }
                else if (_claves.Count == 0) { <EstadoVacio Titulo="Sin claves emitidas" Descripcion="Esta organización todavía no tiene ninguna clave de la API pública." /> }
                else
                {
                    <div class="claves-api-tabla-contenedor">
                        <table class="tabla-datos claves-api-tabla">
                            <thead><tr><th>Nombre</th><th>Prefijo</th><th>Creada</th><th>Último uso</th><th>Estado</th><th><span class="solo-lector">Acciones</span></th></tr></thead>
                            <tbody>
                            @foreach (var clave in _claves)
                            {
                                <tr>
                                    <td class="claves-api-nombre">@clave.NombreDescriptivo</td><td><code title="Prefijo visible de la clave">@clave.PrefijoVisible…</code></td>
                                    <td>@clave.CreadaEnUtc.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@(clave.UltimoUsoUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                                    <td><Badge Tono="@(clave.EstaActiva ? TonoBadge.Exito : TonoBadge.Neutro)">@(clave.EstaActiva ? "Activa" : "Revocada")</Badge></td>
                                    <td class="claves-api-accion">@if (clave.EstaActiva) { <Boton Tamano="TamanoBoton.Pequeno" Variante="VarianteBoton.Destructivo" OnClick="() => PedirRevocacion(clave)" Cargando="@(_procesandoId == clave.Id)">Revocar</Boton> }</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }
</div>

<Modal Visible="_mostrarFormularioGenerar" VisibleChanged="CerrarFormularioGenerar" Titulo="Generar clave" CerrarAlHacerClicFuera="@(!_generando)">
    <ChildContent>
        <CampoTexto Etiqueta="Nombre" Valor="@_nombreNuevaClave" ValorChanged="CambiarNombreNuevaClave" Placeholder="Integración con el ERP" />
        @if (_errorGenerar is not null) { <p class="aviso-error" role="alert">@_errorGenerar</p> }
    </ChildContent>
    <Pie><Boton Variante="VarianteBoton.Secundario" Deshabilitado="_generando" OnClick="() => CerrarFormularioGenerar(false)">Cancelar</Boton><Boton Cargando="_generando" OnClick="GenerarAsync">Generar</Boton></Pie>
</Modal>

<Modal Visible="@(_claveGenerada is not null)" VisibleChanged="CerrarClaveGenerada" Titulo="Clave generada" CerrarAlHacerClicFuera="false">
    <ChildContent>
        @if (_claveGenerada is not null) { <p class="aviso-revocacion" role="alert">Copia esta clave ahora: no se puede volver a mostrar. Si se pierde, hay que revocarla y generar otra.</p><div class="clave-generada"><span>Clave</span><code>@_claveGenerada</code></div> }
    </ChildContent>
    <Pie><BotonCopiar Valor="@(_claveGenerada ?? string.Empty)" Etiqueta="la clave API" /><Boton OnClick="() => CerrarClaveGenerada(false)">Ya la copié</Boton></Pie>
</Modal>

<DialogoConfirmacion Visible="@(_claveARevocar is not null)" VisibleChanged="CerrarRevocacion" Titulo="Revocar la clave" Mensaje="@MensajeRevocacion" TextoBotonConfirmar="Revocar" EnProgreso="_revocando" OnConfirmar="RevocarAsync" />
