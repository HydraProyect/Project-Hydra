@page "/facturacion"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae}")]
@using System.Globalization
@using CaeManager.Domain.Dashboard
@using CaeManager.Web.Features.Facturacion.Recursos
@using Microsoft.Extensions.Localization

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

@*
    «Facturación» contra su maqueta («Facturacion TALVEG.dc.html», assets/facturacion-operador.js): la cuota que el Operador
    CAE externo cobra a cada Empresa gestionada. Los números son los del Cuadro de dirección (ver FacturacionOperadorModelo).
    Lo que cada Empresa gestionada cobra a sus Clientes empresariales no se usa de momento y sale como la pestaña
    «Próximamente» de la maqueta; FacturacionPorClienteEmpresarial se conserva sin ruta.
*@
<div class="contenedor-pagina fct">
    <div class="fct-cabecera">
        <CabeceraPagina Kicker="@Textos["Kicker"]" Titulo="@Textos["TituloPagina"]">
            <Descripcion>@Textos["Descripcion"]</Descripcion>
        </CabeceraPagina>
        <div class="fct-meses" role="group" aria-label="@Textos["EtiquetaMes"]">
            @foreach (var chip in Meses())
            {
                var elegido = chip.Anyo == _anyo && chip.Mes == _mes;
                <button type="button" class="fct-mes" aria-pressed="@(elegido ? "true" : "false")" disabled="@(chip.Futuro || _cargando)"
                        title="@chip.Titulo" @onclick="() => ElegirMesAsync(chip.Anyo, chip.Mes)">
                    <span class="fct-mes-corto">@chip.Corto</span>
                    <span class="fct-mes-marca">@chip.Marca</span>
                </button>
            }
        </div>
    </div>

    <div class="fct-pestanas" role="tablist" aria-label="@Textos["EtiquetaVista"]">
        <button type="button" role="tab" class="fct-pestana" aria-selected="true">@Textos["PestanaCuota"]</button>
        <button type="button" role="tab" class="fct-pestana fct-pestana-futura" aria-selected="false" disabled title="@Textos["PestanaPorClienteAyuda"]">
            @Textos["PestanaPorCliente"]
            <span class="fct-insignia">@Textos["Proximamente"]</span>
        </button>
    </div>

    @if (_sinAcceso)
    {
        <EstadoVacio NombreIcono="candado" Titulo="@Textos["SinAccesoCifrasTitulo"]" Descripcion="@Textos["SinAccesoCifrasDescripcion"]" />
    }
    else if (_error)
    {
        <EstadoVacio NombreIcono="error-circulo" Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
            <Accion><Boton Variante="VarianteBoton.Secundario" OnClick="CargarAsync">@Textos["Reintentar"]</Boton></Accion>
        </EstadoVacio>
    }
    else if (_cargando || _modelo is null)
    {
        <EstadoCargando Filas="4" />
    }
    else
    {
        var estado = EstadoDelMes;
        <div class="fct-estado">
            <span class="fct-pastilla" data-estado="@estado.Clave">@estado.Texto</span>
            <span class="fct-estado-detalle">@estado.Detalle</span>
            @if (_modelo.TenantsSinAlcanceCompleto > 0)
            {
                <span class="fct-alcance" title="@Textos["AlcanceParcialAyuda"]">· @AlcanceParcial</span>
            }
            <span class="fct-exportar">
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Href="@RutaExcel" download>@Textos["ExportarExcel"]</Boton>
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Href="@RutaExtranjeros" Deshabilitado="@(ExtranjerosDelMes == 0)"
                       title="@TituloExtranjeros" download>@Textos["ExportarExtranjeros"]</Boton>
            </span>
        </div>

        @if (_modelo.Empresas.Count == 0)
        {
            <EstadoVacio NombreIcono="empresas" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]" />
        }
        else
        {
            var empresa = Seleccionada ?? _modelo.Empresas[0];
            <div class="fct-rejilla">
                <section class="fct-tarjeta fct-lista-tarjeta">
                    <div class="fct-lista-cabecera">
                        <span>@Textos["ColumnaEmpresa"]</span>
                        <span>@Textos["ColumnaCuota", NombreMes(_anyo, _mes)]</span>
                    </div>
                    <div role="listbox" aria-label="@Textos["ListaEmpresas"]">
                        @foreach (var fila in _modelo.Empresas)
                        {
                            var tenantId = fila.TenantId;
                            <button type="button" role="option" class="fct-fila" aria-selected="@(fila.TenantId == empresa.TenantId ? "true" : "false")"
                                    @onclick="() => ElegirEmpresa(tenantId)">
                                <span class="fct-fila-texto">
                                    <b class="fct-fila-nombre">@fila.Nombre</b>
                                    <span class="fct-fila-sub">@SubEmpresa(fila)</span>
                                </span>
                                <span class="@ClaseCuota(fila)">@TextoCuota(fila)</span>
                            </button>
                        }
                        @if (!_modelo.ImportesOcultos)
                        {
                            <div class="fct-total"><b>@Textos["TotalMes"]</b><b>@TextoTotal()</b></div>
                            @if (_modelo.AlcanceParcial)
                            {
                                <div class="fct-total-parcial" role="note">@TextoTotalParcial</div>
                            }
                        }
                    </div>
                </section>

                <section class="fct-tarjeta fct-detalle">
                    <div class="fct-detalle-cabecera">
                        <span class="fct-detalle-titulo">
                            <h2>@empresa.Nombre</h2>
                            <span class="fct-detalle-sub">@NombreMes(_anyo, _mes)</span>
                        </span>
                        @if (_modelo.PuedeEditarTarifas)
                        {
                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirTarifas(empresa)">@Textos["BotonTarifas"]</Boton>
                        }
                    </div>
                    @if (empresa.Congelada && !empresa.ImportesOcultos)
                    {
                        <span class="fct-insignia fct-congelada">@Textos["TarifaCongelada"]</span>
                    }
                    <div class="fct-conceptos">
                        <span class="fct-cab">@Textos["CabConcepto"]</span>
                        <span class="fct-cab fct-der">@Textos["CabUnidades"]</span>
                        <span class="fct-cab">@Textos["CabTarifa"]</span>
                        <span class="fct-cab fct-der">@Textos["CabImporte"]</span>
                        @foreach (var concepto in empresa.Conceptos)
                        {
                            <span>@NombreConcepto(concepto.Concepto)</span>
                            <b class="fct-der">
                                @Unidades(concepto.Unidades)
                                @if (ComplementoUnidades(empresa, concepto) is { } complemento)
                                {
                                    <small class="fct-complemento">@complemento</small>
                                }
                            </b>
                            <span class="@(TarifaActiva(concepto) ? null : "fct-tenue")">@TextoTarifa(empresa, concepto)</span>
                            <span class="fct-der">@(empresa.ImportesOcultos ? Textos["SinImporte"].Value : TextoImporte(concepto))</span>
                        }
                        <b class="fct-pie-cuota">@Textos["FilaCuota"]</b>
                        <span class="fct-pie-cuota"></span>
                        <span class="fct-pie-cuota"></span>
                        <b class="@($"fct-pie-cuota fct-der fct-cuota-total{((empresa.SinTarifa || empresa.SinTarifaEnElMes) && !empresa.ImportesOcultos ? " fct-cuota-aviso" : null)}")">@TextoCuota(empresa)</b>
                    </div>
                    @if (empresa.ImportesOcultos)
                    {
                        <div class="fct-aviso fct-aviso-neutro" role="note">@Textos["AvisoImportesOcultos"]</div>
                    }
                    else if (empresa.SinTarifa)
                    {
                        <div class="fct-aviso" role="note">
                            <span class="fct-aviso-texto">@Textos["AvisoSinTarifa"]</span>
                            @if (_modelo.PuedeEditarTarifas)
                            {
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirTarifas(empresa)">@Textos["FijarTarifa"]</Boton>
                            }
                        </div>
                    }
                    else if (empresa.SinTarifaEnElMes)
                    {
                        <div class="fct-aviso" role="note"><span class="fct-aviso-texto">@Textos["AvisoSinTarifaEnElMes"]</span></div>
                    }
                    <div class="fct-metricas">
                        <span>@Textos["Gestiones"] <b>@TextoGestiones(empresa)</b></span>
                        <span>@Textos["IngresoPorGestion"] <b>@DineroOSinDato(empresa.IngresoPorGestion, empresa)</b></span>
                        <span>@Textos["CostoPorGestion"] <b data-metrica="costo-gestion">@CostoPorGestionConCuenta(empresa)</b></span>
                        <span>@Textos["CostoPorExtranjero"] <b data-metrica="costo-extranjero">@CostoPorExtranjeroConCuenta(empresa)</b></span>
                        <span>@Textos["Relacion"] <b>@TextoRelacion(empresa)</b></span>
                        <a class="fct-enlace-cuadro" href="/direccion">@Textos["VerEnCuadro"]</a>
                    </div>
                </section>
            </div>
        }
    }

    <DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerTitulo", _drawerNombre]"
                      Subtitulo="@Textos["DrawerSubtitulo"]" HayCambios="() => HayCambiosTarifas" Guardando="_guardando"
                      MensajeError="@_errorGuardar" OnGuardar="GuardarTarifasAsync" TextoGuardar="@Textos["GuardarTarifas"]"
                      TextoCancelar="@Textos["CancelarDrawer"]" MotivoGuardarDeshabilitado="@MotivoGuardarDeshabilitado">
        @if (DrawerSinTarifa)
        {
            <div class="fct-aviso" role="note"><span class="fct-aviso-texto">@Textos["DrawerSinTarifa"]</span></div>
        }
        <label class="fct-campo fct-campo-moneda">
            <span class="fct-campo-etiqueta">@Textos["Moneda"]</span>
            <select class="fct-control" @bind="_moneda">
                <option value="EUR">@Textos["MonedaEur"]</option>
                <option value="USD">@Textos["MonedaUsd"]</option>
                @if (MonedaOriginalFueraDeLista)
                {
                    <option value="@_monedaOriginal">@_monedaOriginal</option>
                }
            </select>
        </label>
        @if (CambiaMoneda)
        {
            <div class="fct-aviso fct-aviso-moneda" role="note">
                <span class="fct-aviso-texto">@Textos["AvisoCambioMoneda", _monedaOriginal!, _moneda]</span>
            </div>
        }
        @foreach (var indice in IndicesTarifa)
        {
            var nombre = NombreTarifaDrawer(indice);
            <div class="fct-concepto-drawer" data-activo="@(_activo[indice] ? "true" : "false")">
                <div class="fct-concepto-cabecera">
                    <span class="fct-concepto-texto">
                        <b>@nombre</b>
                        <span class="fct-ayuda">@AyudaDrawer(indice)</span>
                    </span>
                    <label class="fct-interruptor">
                        @(_activo[indice] ? Textos["SeCobra"].Value : Textos["NoSeCobra"].Value)
                        <input type="checkbox" role="switch" checked="@_activo[indice]"
                               aria-label="@(_activo[indice] ? Textos["AriaDejarDeCobrar", nombre.ToLower(CultureInfo.CurrentCulture)].Value : Textos["AriaCobrar", nombre.ToLower(CultureInfo.CurrentCulture)].Value)"
                               @onchange="e => AlternarActivo(indice, e.Value is true)" />
                    </label>
                </div>
                <label class="fct-precio">
                    <input type="number" min="0" step="0.01" placeholder="0,00" disabled="@(!_activo[indice])"
                           value="@_precioTexto[indice]"
                           aria-label="@Textos["AriaPrecio", nombre.ToLower(CultureInfo.CurrentCulture)].Value"
                           aria-invalid="@(_errorPrecio[indice] is null ? null : "true")"
                           @onchange="e => FijarPrecio(indice, e.Value)" />
                    <span class="fct-precio-unidad">@UnidadPrecio</span>
                </label>
                @if (_errorPrecio[indice] is { } errorPrecio)
                {
                    <span class="fct-error-precio" aria-live="polite">@errorPrecio</span>
                }
            </div>
        }
        <span class="fct-ayuda">@Textos["DrawerNota"]</span>
    </DrawerFormulario>
</div>
</LimiteDeErrores>
