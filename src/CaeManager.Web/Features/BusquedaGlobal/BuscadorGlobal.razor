@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject BusquedaGlobalService BusquedaGlobalService
@inject MediatR.IMediator Mediator
@inject NavigationManager Navigation
@using CaeManager.Application.BusquedaGlobal.Queries.BuscarGlobal

@if (_visible)
{
    var grupos = GruposVisibles;
    var indice = 0;

    <div class="buscador-superposicion" @onclick="Cerrar">
        <div class="buscador-panel" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Buscar o ejecutar">

            <div class="buscador-cabecera">
                <Icono Nombre="buscar" Tamano="TamanoIcono.Pequeno" />
                <input @ref="_inputElemento"
                       class="buscador-input"
                       type="text"
                       role="combobox"
                       aria-label="Buscar o ejecutar"
                       aria-autocomplete="list"
                       aria-expanded="@(grupos.Count > 0 ? "true" : "false")"
                       aria-controls="buscador-lista"
                       aria-activedescendant="@(_indiceSeleccionado >= 0 ? $"buscador-item-{_indiceSeleccionado}" : null)"
                       placeholder="Buscar o ejecutar… (clientes empresariales, trabajadores, documentos, acciones)"
                       value="@_valorMostrado"
                       @oninput="ManejarEntradaAsync"
                       @onkeydown="ManejarTeclaAsync" />
                <span class="buscador-tecla-escape" aria-hidden="true">esc</span>
            </div>

            <div class="buscador-resultados">
                @if (ConsultaVacia && grupos.Count == 0)
                {
                    <p class="buscador-mensaje">Escribe al menos 2 caracteres para buscar.</p>
                }
                else if (!ConsultaVacia && _errorBusqueda is not null)
                {
                    <p class="buscador-mensaje buscador-mensaje-error" role="status">@_errorBusqueda</p>
                }
                else if (!ConsultaVacia && _buscando)
                {
                    <p class="buscador-mensaje" role="status">Buscando…</p>
                }
                else if (!ConsultaVacia && grupos.Count == 0)
                {
                    <p class="buscador-mensaje" role="status">Sin resultados para «@_termino» en tu cartera.</p>
                }
                else
                {
                    @* La búsqueda encontró cero entidades, pero la lista no
                       está vacía porque el palette siempre ofrece "Crear X
                       «término»" para las categorías sin resultado. Sin este
                       aviso esas acciones tapaban la noticia y el usuario no
                       llegaba a enterarse de que su búsqueda no encontró
                       nada — el mensaje existía, pero su guarda exigía que no
                       hubiera ninguna acción, cosa que nunca ocurre. *@
                    @if (!ConsultaVacia && _resultado is not null && !_resultado.TieneResultados)
                    {
                        <p class="buscador-mensaje buscador-mensaje-vacio" role="status">Sin resultados para «@_termino» en tu cartera.</p>
                    }
                    <div id="buscador-lista" class="buscador-lista" role="listbox" aria-label="Resultados">
                        @foreach (var grupo in grupos)
                        {
                            <div class="buscador-grupo" role="group" aria-label="@grupo.Titulo">
                                <h2 class="buscador-grupo-titulo">@grupo.Titulo</h2>
                                @foreach (var fila in grupo.Items)
                                {
                                    var indiceItem = indice++;
                                    var activo = indiceItem == _indiceSeleccionado;
                                    <a class="buscador-item @(activo ? "buscador-item-seleccionado" : "")"
                                       id="buscador-item-@indiceItem"
                                       role="option"
                                       aria-selected="@(activo ? "true" : "false")"
                                       href="@fila.Item.UrlDestino"
                                       @onclick="() => Seleccionar(fila.Item, fila.TipoHistorial)"
                                       @onclick:preventDefault="true">
                                        <span class="buscador-item-icono" aria-hidden="true">
                                            <Icono Nombre="@fila.Icono" Tamano="TamanoIcono.Pequeno" />
                                        </span>
                                        <span class="buscador-item-texto">
                                            <span class="buscador-item-titulo">@fila.Item.Titulo</span>
                                            @if (!string.IsNullOrWhiteSpace(fila.Subtitulo))
                                            {
                                                <span class="buscador-item-subtitulo">@fila.Subtitulo</span>
                                            }
                                        </span>
                                        @if (activo)
                                        {
                                            <span class="buscador-item-pista" aria-hidden="true">↵ @fila.PistaEnter</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="buscador-pie">
                <span class="buscador-ambito">Buscando en tu cartera</span>
                <span class="buscador-leyenda">
                    <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
                    <span><kbd>Tab</kbd> grupo</span>
                    <span><kbd>↵</kbd> abrir</span>
                    <span><kbd>Esc</kbd> cerrar</span>
                </span>
            </div>
        </div>
    </div>
}
