@page "/plantillas/documentos-generados"
@* Sin prerender (como Mi trabajo, M-23): la página carga en el ciclo de vida y no persiste su estado; con prerender
   corría dos veces en cada visita. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Web.Features.Plantillas.Components

<LimiteDeErrores Pagina="this">
<PageTitle>Documentos generados — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"Documentos generados — {Marca.Nombre}")" />

<div class="contenedor-pagina">
    @* Cabecera Gen 2 (Documentos Generados TALVEG.dc.html): kicker, título y
       «Volver a Plantillas» como acción secundaria a la derecha. Esta ruta se
       conserva para marcadores guardados; el mismo panel vive como pestaña
       «Generados» de Plantillas, que es donde lo pinta PlantillasTab. *@
    <CabeceraPagina Titulo="Documentos generados" Kicker="Documentos · Plantillas">
        <Acciones>
            <Boton Variante="VarianteBoton.Secundario" Href="/plantillas">
                <Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> Volver a Plantillas
            </Boton>
        </Acciones>
    </CabeceraPagina>

    <DocumentosGeneradosPanel />
</div>
</LimiteDeErrores>
