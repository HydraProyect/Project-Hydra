@page "/plantillas"
@* Sin prerender (como Mi trabajo, M-23): la página carga en el ciclo de vida y no persiste su estado; con prerender
   corría dos veces en cada visita. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae}")]
@using CaeManager.Web.Features.Documentos.Components
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Features.Documentos.Recursos.TextosDocumentos> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>Plantillas — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"Plantillas — {Marca.Nombre}")" />

<div class="contenedor-pagina lista-design">
    @* Cabecera del lienzo «Documentos · listado sin pestañas» (v34): kicker, título con su contador, entradilla y la acción
       principal a la derecha (D-27: Plantillas es página propia en el menú Ciclo documental; Documentos enlaza desde «Más
       acciones»). «+ Nueva plantilla» vive solo aquí. *@
    <CabeceraPagina Titulo="Plantillas" Kicker="Ciclo documental">
        <JuntoAlTitulo>
            @if (_total is { } total)
            {
                <span class="contador-titulo-plantillas">@total</span>
            }
        </JuntoAlTitulo>
        @* Qué es una plantilla: la entradilla del artboard «Plantillas» (v34). *@
        <Descripcion>@Textos["PlantillasEntradilla"]</Descripcion>
        <Acciones>
            <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick='() => Navigation.NavigateTo("/plantillas/nueva")'>+ Nueva plantilla</Boton></SoloConEscritura>
        </Acciones>
    </CabeceraPagina>

    <PlantillasTab PestanaInicial="@PestanaInicial" PestanaActivaChanged="CambiarPestana" TotalCambiado="CambiarTotal" />
</div>
</LimiteDeErrores>
