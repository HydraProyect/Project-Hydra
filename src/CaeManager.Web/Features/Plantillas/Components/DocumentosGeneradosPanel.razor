@*
    Contenido de "Documentos generados" — extraído de la antigua página
    dedicada (Plantillas TALVEG.dc.html pide una pestaña "Generados" dentro
    de la propia pantalla de Plantillas, no una página aparte). La página
    /plantillas/documentos-generados se conserva tal cual apuntando a este
    mismo panel, por si algo enlaza directo a esa URL — no se ha encontrado
    ningún enlace externo, pero borrar la ruta no aporta nada y sí arriesga
    romper un marcador guardado.
*@
@using CaeManager.Domain.Plantillas
@using MediatR
@inject IMediator Mediator

<div class="barra-filtros">
    <CampoSelect Etiqueta="Plantilla" Valor="@(_plantillaFiltro?.ToString() ?? "")" ValorChanged="CambiarPlantillaFiltroAsync">
        <option value="">Todas las plantillas</option>
        @foreach (var plantilla in _plantillasDisponibles)
        {
            <option value="@plantilla.Id">@plantilla.Nombre</option>
        }
    </CampoSelect>

    <CampoSelect Etiqueta="Trabajador" Valor="@(_trabajadorFiltro?.ToString() ?? "")" ValorChanged="CambiarTrabajadorFiltroAsync">
        <option value="">Todos los trabajadores</option>
        @foreach (var trabajador in _trabajadoresDisponibles)
        {
            <option value="@trabajador.Id">@trabajador.NombreCompleto (@trabajador.Dni)</option>
        }
    </CampoSelect>
</div>

@if (_errorCarga)
{
    <EstadoVacio Titulo="No pudimos cargar los documentos generados" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_cargando)
{
    <EstadoCargando Filas="6" />
}
else if (_documentosGenerados.Count == 0)
{
    <EstadoVacio Titulo="Todavía no se ha generado ningún documento" Descripcion="Genera uno individual o en lote desde una plantilla confirmada." />
}
else
{
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Plantilla</th>
                <th>Trabajador</th>
                <th>Empresa</th>
                <th>Generado el</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var generado in _documentosGenerados)
            {
                <tr>
                    <td>
                        @if (_versionActualPorPlantilla.TryGetValue(generado.PlantillaDocumentoId, out var versionId))
                        {
                            <a class="enlace-exportar" href="@($"/plantillas/{versionId}/editar")" title="Ir a configurar los campos de esta plantilla">@generado.PlantillaNombre</a>
                        }
                        else
                        {
                            @generado.PlantillaNombre
                        }
                    </td>
                    <td>@(generado.TrabajadorNombreCompleto ?? "—")</td>
                    <td>@(generado.EmpresaRazonSocial ?? "—")</td>
                    <td>@generado.GeneradoEnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (generado.Estado == EstadoDocumentoGenerado.Generado)
                        {
                            <Badge Tono="TonoBadge.Exito">Generado</Badge>
                        }
                        else if (generado.Estado == EstadoDocumentoGenerado.GeneradoConAvisos)
                        {
                            @* El documento existe; algún obligatorio quedó vacío (DEC-5) y/o algún valor no fue reconocido por su campo (DEC-32, REC-115). *@
                            <Badge Tono="TonoBadge.Advertencia" title="Revisa este documento: algún dato quedó sin rellenar o con un valor que su campo no reconoció">Generado con avisos</Badge>
                        }
                        else
                        {
                            <Badge>@generado.Estado</Badge>
                        }
                    </td>
                    <td>
                        <a class="enlace-exportar" href="@($"/documentos/{generado.DocumentoId}/archivo")" target="_blank" title="Abre el PDF generado en una pestaña nueva">Ver PDF</a>
                        &nbsp;·&nbsp;
                        <a class="enlace-exportar" href="@($"/documentos?documentoId={generado.DocumentoId}")" title="Abre la ficha del documento en el módulo de Documentos">Gestionar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
