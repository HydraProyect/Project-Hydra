@* Apartados editables del aviso de un incidente de seguridad. El primer aviso no lleva «Consecuencias»
   (se completa en la notificación completa). Los límites los repiten el comando y la función de la base.
   Cada cambio avisa a la página (ContenidoCambiado): el borrador es suyo, y sin ese aviso solo se repintaría
   este formulario y el botón de enviar seguiría deshabilitado con todos los apartados ya escritos. *@
@using CaeManager.Web.Features.IncidentesSeguridad.Recursos
@using Microsoft.Extensions.Localization

<div class="incidente-formulario">
    <CampoTextarea Etiqueta="@Textos["ApartadoNaturaleza"]" Valor="@Contenido.Naturaleza" ValorChanged="v => CambiarAsync(() => Contenido.Naturaleza = v)" />
    <CampoTextarea Etiqueta="@Textos["ApartadoDatosEInteresados"]" Valor="@Contenido.DatosEInteresados" ValorChanged="v => CambiarAsync(() => Contenido.DatosEInteresados = v)" />
    @if (ConConsecuencias)
    {
        <CampoTextarea Etiqueta="@Textos["ApartadoConsecuencias"]" Valor="@Contenido.Consecuencias" ValorChanged="v => CambiarAsync(() => Contenido.Consecuencias = v)" />
    }
    <CampoTextarea Etiqueta="@Textos["ApartadoMedidas"]" Valor="@Contenido.Medidas" ValorChanged="v => CambiarAsync(() => Contenido.Medidas = v)" />
    <CampoTextarea Etiqueta="@Textos["ApartadoContacto"]" Valor="@Contenido.Contacto" ValorChanged="v => CambiarAsync(() => Contenido.Contacto = v)" />
</div>

@code {
    [Parameter, EditorRequired] public BorradorAvisoIncidente Contenido { get; set; } = default!;
    [Parameter] public bool ConConsecuencias { get; set; }
    [Parameter, EditorRequired] public IStringLocalizer<TextosIncidenteSeguridad> Textos { get; set; } = default!;
    [Parameter] public EventCallback ContenidoCambiado { get; set; }

    private Task CambiarAsync(Action cambiar)
    {
        cambiar();
        return ContenidoCambiado.InvokeAsync();
    }
}
