@page "/cuenta/extension"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Conectar extensión — @Marca.Nombre</PageTitle>

<div class="pagina-conectar-extension">
    <div class="cabecera-pagina">
        <h1>Conectar extensión de navegador</h1>
    </div>

    <p class="descripcion-delegaciones">
        Genera un token para conectar la extensión de @Marca.Nombre en tu navegador y subir
        documentos a las plataformas CAE externas directamente desde aquí, sin descargarlos antes
        a tu disco. Lo normal es que la extensión se conecte sola en cuanto generas el token; si no
        lo hace, aquí abajo te decimos por qué y cómo conectarla a mano. Dura 8 horas y no se
        renueva solo.
    </p>

    @if (_token is null)
    {
        <Boton Cargando="_generando" OnClick="GenerarAsync">Generar token</Boton>
    }
    else
    {
        @switch (_enlace)
        {
            case ResultadoEnlace.Conectado:
                <p class="aviso-exito">
                    Extensión conectada@(_versionExtension is not null ? $" (v{_versionExtension})" : "").
                    Ya puedes cerrar esta página.
                </p>
                break;

            case ResultadoEnlace.PuenteNoConfigurado:
                <p class="aviso-error">
                    Este entorno no tiene configurado el enlace automático, así que ni se ha
                    intentado. No es cosa de tu navegador y no se arregla reinstalando nada.
                </p>
                break;

            case ResultadoEnlace.NoDetectada:
                <p class="aviso-error">
                    No hemos detectado la extensión en este navegador. O no está instalada, o es
                    anterior al enlace automático.
                </p>
                break;

            case ResultadoEnlace.Rechazado:
                <p class="aviso-error">
                    La extensión@(_versionExtension is not null ? $" (v{_versionExtension})" : "")
                    rechazó el enlace: @_errorExtension
                </p>
                break;
        }

        @if (DebePedirActualizar)
        {
            <p class="descripcion-delegaciones">
                Tu extensión es la v@_versionExtension, y conectarla a mano necesita la
                v@CompatibilidadExtension.VersionMinimaConexionManual o posterior. Actualízala
                desde la página de extensiones de tu navegador y vuelve a generar el token: no te
                damos aquí el código de conexión porque tu versión todavía no tiene dónde pegarlo.
            </p>
        }
        else if (DebeOfrecerCodigo)
        {
            <p class="descripcion-delegaciones">
                Con la extensión en la v@CompatibilidadExtension.VersionMinimaConexionManual o
                posterior: abre su ventana, despliega <strong>Conectar a mano</strong> y pega ahí
                este código. Si la tuya es anterior, actualízala primero — el control no existe en
                las versiones antiguas. El código lleva dentro el token, así que trátalo igual: no
                lo reenvíes ni lo dejes escrito en ningún sitio.
            </p>

            <CampoTexto Etiqueta="Código de conexión" Valor="@_codigoConexion" ValorChanged="_ => { }" Deshabilitado="true" />

            <div class="acciones-extension">
                <BotonCopiar Valor="@_codigoConexion" Etiqueta="el código de conexión" />
            </div>
        }

        @if (_expiraEnUtc is not null)
        {
            <p class="descripcion-delegaciones">
                Expira el @_expiraEnUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
            </p>
        }

        <div class="acciones-extension">
            <Boton Variante="VarianteBoton.Secundario" Cargando="_generando" OnClick="GenerarAsync">Generar otro</Boton>
        </div>
    }

    @if (_error is not null)
    {
        <p class="aviso-error">@_error</p>
    }
</div>
