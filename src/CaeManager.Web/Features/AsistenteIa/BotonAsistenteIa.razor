@rendermode InteractiveServer
@inject AsistenteIaService AsistenteIaService
@using CaeManager.Web.Features.AsistenteIa.Recursos
@using Microsoft.Extensions.Localization
@inject DisponibilidadAsistente Disponibilidad
@inject IStringLocalizer<TextosAsistenteIa> Textos
@inherits CaeManager.Web.Components.IsloteInteractivo

@* Sin ningún proveedor configurado (Anthropic:ApiKey para las consultas, o
   TypeSafe:Activo + TypeSafe:ApiKey para el agente) el botón ni se muestra — el
   chat queda completamente inerte en vez de mostrar algo roto (mismo principio que
   Sentry/Backups: funciona sin configurar, se activa con una variable). *@
<LimiteDeErrores Islote="this">
@if (Disponibilidad.Alguna)
{
    <button type="button" class="boton-asistente-ia" @onclick="() => AsistenteIaService.Abrir()" data-tooltip="@TituloBoton" aria-label="@TituloBoton">
        <Icono Nombre="chat" Tamano="TamanoIcono.Medio" />
    </button>
}
</LimiteDeErrores>
