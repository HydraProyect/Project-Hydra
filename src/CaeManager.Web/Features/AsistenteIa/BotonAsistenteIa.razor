@rendermode InteractiveServer
@inject AsistenteIaService AsistenteIaService
@using CaeManager.Infrastructure.AsistenteIa
@using Microsoft.Extensions.Options
@inject IOptions<AnthropicOptions> Opciones

@* Sin Anthropic:ApiKey configurada el botón ni se muestra — el chat queda
   completamente inerte en vez de mostrar algo roto (mismo principio que
   Sentry/Backups: funciona sin configurar, se activa con una variable). *@
@if (!string.IsNullOrWhiteSpace(Opciones.Value.ApiKey))
{
    <button type="button" class="boton-asistente-ia" @onclick="() => AsistenteIaService.Abrir()" title="Pregúntale a Hydra">
        <Icono Nombre="chat" Tamano="TamanoIcono.Medio" />
    </button>
}
