@using CaeManager.Application.Common

@if (_visible)
{
    <div class="asistente-superposicion" @onmousedown="() => _mouseDownEnSuperposicion = true" @onclick="ManejarClicSuperposicion">
        <div class="asistente-panel" @onmousedown="() => _mouseDownEnSuperposicion = false" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="asistente-titulo">
            <div class="asistente-cabecera">
                <h2 id="asistente-titulo">@Textos["Titulo"]</h2>
                <button type="button" class="asistente-cerrar" @onclick="Cerrar" aria-label="@Textos["CerrarEtiqueta"]"><Icono Nombre="cerrar" /></button>
            </div>

            <p class="asistente-descripcion">@Textos["Descripcion"]</p>

            <div class="asistente-mensajes">
                @if (_historial.Count == 0)
                {
                    <p class="asistente-mensaje-vacio">@Textos["MensajeVacio"]</p>
                }

                @foreach (var mensaje in _historial)
                {
                    @if (mensaje.Rol == RolMensajeChat.Usuario)
                    {
                        <div class="asistente-mensaje asistente-mensaje-usuario">@mensaje.Texto</div>
                    }
                    else
                    {
                        <div class="asistente-mensaje asistente-mensaje-asistente asistente-mensaje-markdown">@RenderizarMarkdown(mensaje.Texto)</div>
                    }
                }

                @if (_enviando)
                {
                    <div class="asistente-mensaje asistente-mensaje-asistente asistente-mensaje-cargando">@Textos["Pensando"]</div>
                }

                @if (_mensajeError is not null)
                {
                    <div class="asistente-mensaje-error" role="alert">@_mensajeError</div>
                }
            </div>

            <div class="asistente-entrada">
                <textarea class="asistente-textarea"
                          placeholder="@Textos["PlaceholderPregunta"]"
                          value="@_valorMostrado"
                          disabled="@_enviando"
                          @oninput="e => _pregunta = e.Value?.ToString() ?? string.Empty"
                          @onkeydown="ManejarTeclaAsync"></textarea>
                <button type="button" class="asistente-boton-enviar" disabled="@(_enviando || _pregunta.Trim().Length == 0)" @onclick="EnviarAsync">
                    @Textos["BotonEnviar"]
                </button>
            </div>
        </div>
    </div>
}
