@*
    Dato de cabecera «Gestor CAE» de la pantalla Empresas (decisiones 2026-10-08 y 2026-10-09):
    quién gestiona el Tenant propietario activo. No es una columna porque la Asignación de
    Cartera es sobre el Tenant entero (ADR-011 § 2.7, enmienda 2026-10-08): es el mismo dato para
    todas las filas.

    Operador CAE = organización; Gestor CAE = persona. Salen personas: el Gestor CAE principal
    —«Coordinador CAE principal» si quien lleva la marca gestiona el Tenant con ese rol— y los
    Gestores CAE de apoyo, con la fecha de fin si su cartera la tiene.

    UNA LÍNEA. Junto al título caben pocas personas: salen por su nombre las dos primeras
    (PersonasALaVista; los principales van antes que los de apoyo) y las demás se agrupan en una
    pastilla «+N» que abre una ventana con TODAS, cada una con su rótulo. Los nombres largos se
    recortan con puntos suspensivos y se leen enteros en su `title` y en esa ventana: no se
    pierde información. El Operador CAE y los avisos de «sin principal» se dicen siempre.

    El dato es de lectura para las dos miradas. Las dos acciones que acompañan al dato —«+ Dar
    acceso» y «Desasignarme»— no las decide este componente: las pinta PanelDarAcceso en su forma
    de cabecera, con sus propias lecturas (a quien es el principal de la operación, la primera; a
    quien tiene un apoyo propio, la segunda; a ninguno con un rol efectivo de solo consulta) y sus
    Commands, que lo vuelven a comprobar todo. El panel se monta cuando
    ObtenerPersonasConCarteraQuery devuelve filas de este Tenant, es decir, cuando el dato no se
    mira desde el Tenant propietario: para cualquier cuenta del Operador CAE a la que esa consulta
    responde, que incluye a su Administrador y a su Dirección CAE además de Coordinadores y
    Gestores CAE. Montarlo no es ofrecer nada: los botones los filtra el propio panel. Al
    Administrador del Tenant propietario no se le monta ni se le ofrece nada sobre la cartera.
    Retirar una propuesta, retirar un apoyo concedido, revocar y «Asumir» siguen en sus pantallas.

    Tras «+ Dar acceso» basta con releer este dato. Tras «Desasignarme», quien mira ya no tiene
    acceso al Tenant propietario cuyos datos pinta la pantalla: además de releer, la cabecera lo
    avisa por AlDesasignarme y la página decide qué hace (Empresas lleva a Mi trabajo con un aviso).

    Quién recibe datos lo deciden las consultas, no este componente:
    - ObtenerPersonasConCarteraQuery responde a una cuenta activa del Operador CAE externo que
      gestiona este Tenant (Administrador, Dirección CAE, Coordinador CAE o Gestor CAE de esa
      organización): ve a los suyos, sin nombrarle su propia organización.
    - ObtenerOperadoresCaeDeMiTenantQuery responde al Administrador del Tenant propietario: ve,
      por cada Asignación de Operación, qué Operador CAE lo gestiona y quién es el principal. Una
      operación sin principal se dice junto a su organización.
    Si las dos vuelven vacías (otro rol del Tenant propietario, un Tenant de operación interna,
    Soporte TALVEG) no se pinta nada.
*@
@using CaeManager.Application.Common
@using CaeManager.Application.Usuarios.Queries.ObtenerOperadoresCaeDeMiTenant
@using CaeManager.Application.Usuarios.Queries.ObtenerPersonasConCartera
@using CaeManager.Domain.Common
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Features.Empresas.Recursos
@using CaeManager.Web.Features.IncorporacionCartera.Components
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ITenantActual TenantActual
@inject IStringLocalizer<TextosEmpresas> Textos

@if (_error)
{
    <span class="cabecera-gestor-cae" role="group" aria-label="@Textos["GestorCaeGrupo"]">
        <span class="cabecera-gestor-cae-rotulo">@Textos["GestorCaeRotulo"]</span>
        <span class="cabecera-gestor-cae-sin-dato" role="status">@Textos["GestorCaeError"]</span>
    </span>
}
else if (_grupos.Count > 0)
{
    var titulo = Textos[_desdeElPropietario ? "GestorCaeTituloPropietario" : "GestorCaeTitulo"].Value;
    var tramos = TramosALaVista();
    var ocultas = _grupos.Sum(g => g.Principales.Count + g.Apoyos.Count) - tramos.Sum(t => t.Piezas.Count(p => p.Persona is not null));

    <span class="cabecera-gestor-cae" role="group" aria-label="@Textos["GestorCaeGrupo"]" title="@titulo">
        <span class="cabecera-gestor-cae-rotulo">@Textos["GestorCaeRotulo"]</span>
        <span class="cabecera-gestor-cae-personas" title="@Resumen()">
            @{ var claves = new ClavesDeHermanos(); }
            @foreach (var tramo in tramos)
            {
                @if (!ReferenceEquals(tramo, tramos[0]))
                {
                    <span class="cabecera-gestor-cae-separador" aria-hidden="true">|</span>
                }
                @foreach (var pieza in tramo.Piezas)
                {
                    @if (!ReferenceEquals(pieza, tramo.Piezas[0]))
                    {
                        <span class="cabecera-gestor-cae-separador" aria-hidden="true">·</span>
                    }
                    @switch (pieza.Clase)
                    {
                        case ClasePieza.Operador:
                            <span class="cabecera-gestor-cae-operador" data-gestor-cae="operador">
                                <span class="cabecera-gestor-cae-sin-dato">@Textos["GestorCaeOperador"]</span>
                                <strong class="cabecera-gestor-cae-nombre" title="@tramo.Grupo.Operador">@tramo.Grupo.Operador</strong>
                            </span>
                            break;
                        case ClasePieza.Principal:
                            <span class="cabecera-gestor-cae-persona" data-gestor-cae="principal" @key="claves.De((tramo.Grupo.Clave, pieza.Persona!.UsuarioId))">
                                <AvatarUsuario Nombre="@pieza.Persona.Nombre" Avatar="@pieza.Persona.Avatar" Tamano="TamanoAvatarUsuario.Pequeno" />
                                <strong class="cabecera-gestor-cae-nombre" title="@pieza.Persona.Nombre">@pieza.Persona.Nombre</strong>
                                <span class="cabecera-gestor-cae-pastilla cabecera-gestor-cae-principal">@RotuloPrincipal(pieza.Persona)</span>
                            </span>
                            break;
                        case ClasePieza.Apoyo:
                            <span class="cabecera-gestor-cae-persona" data-gestor-cae="apoyo" @key="claves.De((tramo.Grupo.Clave, pieza.Persona!.UsuarioId))">
                                <AvatarUsuario Nombre="@pieza.Persona.Nombre" Avatar="@pieza.Persona.Avatar" Tamano="TamanoAvatarUsuario.Pequeno" />
                                <span class="cabecera-gestor-cae-nombre" title="@pieza.Persona.Nombre">@pieza.Persona.Nombre</span>
                                <span class="cabecera-gestor-cae-pastilla">@RotuloApoyo(pieza.Persona)</span>
                            </span>
                            break;
                        case ClasePieza.SinPrincipal:
                            @* Sin principal es un estado válido (el relevo automático no encontró a quién pasar
                               la marca). «Asumir» vive en su panel: aquí solo se dice. *@
                            <span class="cabecera-gestor-cae-sin-dato cabecera-gestor-cae-aviso" data-gestor-cae="sin-principal">@Textos["GestorCaeSinPrincipal"]</span>
                            break;
                        case ClasePieza.OtraSinPrincipal:
                            @* Varias Asignaciones de Operación del mismo Operador CAE y solo alguna con
                               principal: callarlo haría creer que todas lo tienen. *@
                            <span class="cabecera-gestor-cae-sin-dato cabecera-gestor-cae-aviso" data-gestor-cae="otra-sin-principal">@Textos["GestorCaeOtraSinPrincipal"]</span>
                            break;
                    }
                }
            }
        </span>
        @if (ocultas > 0)
        {
            @* Las que no caben en la línea. La ventana las enseña a TODAS, no solo a las agrupadas:
               quien la abre lee la cartera entera sin tener que sumar la línea y la ventana. *@
            <VentanaContexto Etiqueta="@Textos["GestorCaeMasEtiqueta", ocultas]" Titulo="@titulo"
                             Colocacion="VentanaContextoColocacion.AbajoCentro" data-gestor-cae-mas="@ocultas">
                <Disparador>
                    <span class="cabecera-gestor-cae-pastilla cabecera-gestor-cae-mas">@Textos["GestorCaeMas", ocultas]</span>
                </Disparador>
                <Detalle>
                    @foreach (var grupo in _grupos)
                    {
                        @if (grupo.Operador is { } operador)
                        {
                            <span class="ventana-linea" data-gestor-cae-detalle="operador">@Textos["GestorCaeOperador"] <strong>@operador</strong></span>
                        }
                        @foreach (var principal in grupo.Principales)
                        {
                            <span class="ventana-linea" data-gestor-cae-detalle="principal"><strong>@principal.Nombre</strong> · @RotuloPrincipal(principal)</span>
                        }
                        @if (grupo.Principales.Count == 0)
                        {
                            <span class="ventana-linea" data-gestor-cae-detalle="sin-principal">@Textos["GestorCaeSinPrincipal"]</span>
                        }
                        else if (grupo.OtraSinPrincipal)
                        {
                            <span class="ventana-linea" data-gestor-cae-detalle="otra-sin-principal">@Textos["GestorCaeOtraSinPrincipal"]</span>
                        }
                        @foreach (var apoyo in grupo.Apoyos)
                        {
                            <span class="ventana-linea" data-gestor-cae-detalle="apoyo">@apoyo.Nombre · @RotuloApoyo(apoyo)</span>
                        }
                    }
                </Detalle>
            </VentanaContexto>
        }
    </span>
    @if (!_desdeElPropietario && TenantActual.TenantId is { } tenantId)
    {
        @* Fuera del grupo a propósito: su formulario y su confirmación no deben heredar la
           tipografía ni el recorte de la línea. En pantalla quedan a continuación, en la misma línea. *@
        <PanelDarAcceso TenantId="tenantId" EnCabecera="true" AlCambiar="CargarAsync" AlDesasignarme="AlDesasignarme" />
    }
}

@code {
    /// <summary>
    /// Cuántas personas salen por su nombre en la línea; las demás van a la pastilla «+N». Dos es lo
    /// que cabe junto al título, con sus rótulos y los botones de la cabecera, a 1280 px de ancho.
    /// </summary>
    public const int PersonasALaVista = 2;

    /// <summary>
    /// Quien mira acaba de desasignarse de su apoyo sobre el Tenant propietario activo (el Command lo
    /// aceptó) y ya no tiene acceso a él. La cabecera ya releyó su dato; la página que pinta datos
    /// de ese Tenant decide qué hace con los suyos. Nunca llega tras «+ Dar acceso».
    /// </summary>
    [Parameter] public EventCallback AlDesasignarme { get; set; }

    private readonly CancellationTokenSource _ciclo = new();
    private IReadOnlyList<Grupo> _grupos = [];
    private bool _desdeElPropietario;
    private bool _error;

    /// <summary>
    /// Un tramo de la cabecera. Desde el Operador CAE hay uno solo, sin nombre de organización;
    /// desde el Tenant propietario, uno por Asignación de Operación, con su Operador CAE.
    /// </summary>
    private sealed record Grupo(
        Guid Clave, string? Operador, IReadOnlyList<PersonaConCartera> Principales,
        IReadOnlyList<PersonaConCartera> Apoyos, bool OtraSinPrincipal);

    private enum ClasePieza { Operador, Principal, Apoyo, SinPrincipal, OtraSinPrincipal }

    /// <summary>Una pieza de la línea: el Operador CAE de un tramo, una persona o un aviso.</summary>
    private sealed record Pieza(ClasePieza Clase, PersonaConCartera? Persona = null);

    private sealed record Tramo(Grupo Grupo, IReadOnlyList<Pieza> Piezas);

    protected override Task OnInitializedAsync() => CargarAsync();

    /// <summary>
    /// Lee quién gestiona el Tenant propietario activo. Corre al montar y cada vez que
    /// <see cref="PanelDarAcceso"/> avisa de que una acción terminó.
    /// </summary>
    private async Task CargarAsync()
    {
        if (TenantActual.TenantId is not { } tenantId)
            return;

        try
        {
            var operaciones = (await Mediator.Send(new ObtenerPersonasConCarteraQuery(tenantId), _ciclo.Token))
                .Where(o => o.TenantId == tenantId)
                .ToList();
            if (operaciones.Count > 0)
            {
                _desdeElPropietario = false;
                _grupos = [DesdeElOperador(operaciones)];
                _error = false;
                return;
            }

            var propias = (await Mediator.Send(new ObtenerOperadoresCaeDeMiTenantQuery(), _ciclo.Token))
                .Where(o => o.TenantId == tenantId)
                .ToList();
            _desdeElPropietario = propias.Count > 0;
            _grupos = propias
                .Select(o => new Grupo(
                    o.AsignacionOperacionId, o.NombreOperador ?? string.Empty,
                    o.Principal is { } principal ? [principal] : [],
                    o.Apoyos, OtraSinPrincipal: false))
                .ToList();
            _error = false;
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception)
        {
            // Un fallo no es «nadie lo gestiona»: se dice, en vez de dejar la cabecera muda.
            _error = true;
        }
    }

    // Una Asignación de Operación por Operador CAE y Tenant propietario es lo normal; si hubiera
    // más de una viva, se muestran juntas: la pregunta es quién gestiona el Tenant. Cada una
    // tiene su principal, y todos se rotulan como tales: llamar «apoyo» al principal de la
    // segunda sería falso. Quien es principal de una no se repite como apoyo de otra. Y si
    // alguna no tiene principal mientras otra sí, se dice.
    private static Grupo DesdeElOperador(IReadOnlyList<CarterasDeOperacion> operaciones)
    {
        var principales = operaciones.Select(o => o.Principal).OfType<PersonaConCartera>()
            .DistinctBy(p => p.UsuarioId)
            .OrderBy(p => p.Nombre)
            .ToList();
        var idsPrincipales = principales.Select(p => p.UsuarioId).ToHashSet();
        var apoyos = operaciones.SelectMany(o => o.Apoyos)
            .Where(p => !idsPrincipales.Contains(p.UsuarioId))
            .DistinctBy(p => p.UsuarioId)
            .OrderBy(p => p.Nombre)
            .ToList();

        return new Grupo(Guid.Empty, null, principales, apoyos, operaciones.Any(o => o.Principal is null));
    }

    /// <summary>
    /// Lo que sale en la línea, tramo a tramo y en el orden de siempre (Operador CAE, principales, aviso
    /// de «sin principal», apoyos), con un tope de <see cref="PersonasALaVista"/> personas en total. El
    /// tope solo recorta personas: el Operador CAE y los avisos se dicen siempre.
    /// </summary>
    private IReadOnlyList<Tramo> TramosALaVista()
    {
        var quedan = PersonasALaVista;
        var tramos = new List<Tramo>();
        foreach (var grupo in _grupos)
        {
            var piezas = new List<Pieza>();
            if (grupo.Operador is not null)
                piezas.Add(new Pieza(ClasePieza.Operador));
            foreach (var principal in grupo.Principales)
            {
                if (quedan-- > 0)
                    piezas.Add(new Pieza(ClasePieza.Principal, principal));
            }

            if (grupo.Principales.Count == 0)
                piezas.Add(new Pieza(ClasePieza.SinPrincipal));
            else if (grupo.OtraSinPrincipal)
                piezas.Add(new Pieza(ClasePieza.OtraSinPrincipal));

            foreach (var apoyo in grupo.Apoyos)
            {
                if (quedan-- > 0)
                    piezas.Add(new Pieza(ClasePieza.Apoyo, apoyo));
            }

            tramos.Add(new Tramo(grupo, piezas));
        }

        return tramos;
    }

    /// <summary>
    /// La cartera entera en una frase, para el <c>title</c> de la línea: lo que un nombre recortado o
    /// la pastilla «+N» no dejan leer de un vistazo.
    /// </summary>
    private string Resumen() => string.Join(" | ", _grupos.Select(grupo =>
    {
        var partes = new List<string>();
        if (grupo.Operador is { } operador)
            partes.Add($"{Textos["GestorCaeOperador"].Value} {operador}");
        partes.AddRange(grupo.Principales.Select(p => $"{p.Nombre} ({RotuloPrincipal(p)})"));
        if (grupo.Principales.Count == 0)
            partes.Add(Textos["GestorCaeSinPrincipal"].Value);
        else if (grupo.OtraSinPrincipal)
            partes.Add(Textos["GestorCaeOtraSinPrincipal"].Value);
        partes.AddRange(grupo.Apoyos.Select(a => $"{a.Nombre} ({RotuloApoyo(a)})"));
        return string.Join(" · ", partes);
    }));

    private string RotuloPrincipal(PersonaConCartera principal) =>
        principal.Rol == Roles.CoordinadorCae ? Textos["GestorCaeCoordinadorPrincipal"] : Textos["GestorCaePrincipal"];

    private string RotuloApoyo(PersonaConCartera apoyo) =>
        apoyo.VigenciaHasta is { } hasta
            ? Textos["GestorCaeApoyoHasta", DiaDeNegocio.De(hasta).ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)]
            : Textos["GestorCaeApoyo"];

    public void Dispose()
    {
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
