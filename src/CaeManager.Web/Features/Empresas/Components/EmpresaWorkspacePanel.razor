@*
    Panel de Empresa para el Context Workspace. Pestañas: Información,
    Clientes, Documentación, Historial.

    "Clientes" es la relación directa (EmpresaCliente, N:N) — quiénes
    contratan a esta Empresa. No es "Centros": Centro cuelga de Cliente, no
    de Empresa (Centro.ClienteId es la FK real, ver ObtenerCentrosDeClienteQuery
    en ClienteWorkspacePanel.razor), y mostrar aquí los centros de sus
    Clientes describía datos ajenos a la Empresa, no propios.
*@
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Commands.BorrarCredencialAccesoEmpresaContrasena
@using CaeManager.Application.Empresas.Commands.EditarEmpresa
@using CaeManager.Application.Empresas.Commands.EliminarEmpresa
@using CaeManager.Application.Empresas.Commands.GuardarCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerClientesDeEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerCredencialAccesoEmpresaSinContrasena
@using CaeManager.Application.Empresas.Queries.ObtenerCumplimientoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresaPorId
@using CaeManager.Domain.Documentos
@using FluentValidation
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using MediatR
@implements IDisposable
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar la empresa" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="cabecera-empresa-360">
        <span class="icono-empresa-360"><Icono Nombre="empresas" /></span>
        <div class="texto-cabecera-empresa-360">
            <span class="kicker-empresa-360">Empresa</span>
            <h2 class="workspace-titulo-entidad titulo-empresa-360">@_detalle.RazonSocial</h2>
            @if (PestanaActiva == "clientes" && _clientes is not null)
            {
                <span class="recuentos-empresa-360">@(_clientes.Count == 1 ? "1 cliente empresarial" : $"{_clientes.Count} clientes empresariales")</span>
            }
        </div>
        @if (_cumplimiento is not null)
        {
            <AnilloCumplimiento Porcentaje="_cumplimiento" Tamano="TamanoAnillo.Medio"
                                 Etiqueta="@($"{_cumplimiento}% de cumplimiento acumulado en los centros donde esta empresa tiene actividad")" />
        }
        @if (PestanaActiva == "informacion" && !_editandoInformacion)
        {
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="IniciarEdicionInformacionAsync" aria-label="Editar información de la empresa">
                <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
            </Boton>
        }
    </div>

    @* PestanaActiva con @: el parámetro es string, y sin @ Razor le pasa el literal "PestanaActiva" (ninguna pestaña quedaba marcada como activa). *@
    <Pestanas Definiciones="PestanasConRecuento" PestanaActiva="@PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones de la empresa">
        @switch (PestanaActiva)
        {
            case "informacion":
                @if (_editandoInformacion)
                {
                    @if (_mensajeErrorInformacion is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorInformacion</div>
                    }
                    <CampoTexto Etiqueta="Razón social" Valor="@_razonSocialInfo" ValorChanged="v => _razonSocialInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarEmpresaCommand.RazonSocial))" />
                    <CampoTexto Etiqueta="CIF" Valor="@_cifInfo" ValorChanged="v => _cifInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarEmpresaCommand.Cif))" />
                    <CampoTexto Etiqueta="CNAE" Placeholder="p. ej. 4321" Valor="@_cnaeInfo" ValorChanged="v => _cnaeInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarEmpresaCommand.Cnae))" />
                    <CampoTexto Etiqueta="Convenio aplicable" Valor="@_convenioAplicableInfo" ValorChanged="v => _convenioAplicableInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarEmpresaCommand.ConvenioAplicable))" />
                    <label class="campo-checkbox">
                        <input type="checkbox" @bind="_esActividadAnexoIInfo" /> Actividad del Anexo I del RSP
                    </label>
                    <SelectorMultiple Etiqueta="Clientes empresariales con los que trabaja"
                                       Elementos="@_clientesDisponiblesSelector"
                                       Seleccionados="@_clienteIdsInfo"
                                       OnAlternar="args => AlternarClienteInfo(args.Id, args.Marcado)"
                                       TextoVacio="Todavía no hay clientes empresariales creados." />
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_guardandoInformacion" OnClick="CancelarEdicionInformacion">Cancelar</Boton>
                        <Boton Tamano="TamanoBoton.Pequeno" Cargando="_guardandoInformacion" OnClick="GuardarInformacionAsync">Guardar</Boton>
                    </div>

                    <div class="campo">
                        <label>Credenciales de acceso a Plataforma CAE</label>
                    </div>
                    @if (_mensajeErrorCredenciales is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorCredenciales</div>
                    }
                    <div class="campo-con-boton">
                        <CampoTexto Etiqueta="URL" Valor="@_credencialUrl" ValorChanged="v => _credencialUrl = v" />
                        <BotonCopiar Valor="@_credencialUrl" Etiqueta="la URL" />
                    </div>
                    <div class="campo-con-boton">
                        <CampoTexto Etiqueta="Empresa / Cliente empresarial / Proveedor" Valor="@_credencialCampoEmpresa" ValorChanged="v => _credencialCampoEmpresa = v" />
                        <BotonCopiar Valor="@_credencialCampoEmpresa" Etiqueta="este campo" />
                    </div>
                    <div class="campo-con-boton">
                        <CampoTexto Etiqueta="Usuario" Valor="@_credencialUsuario" ValorChanged="v => _credencialUsuario = v" />
                        <BotonCopiar Valor="@_credencialUsuario" Etiqueta="el usuario" />
                    </div>
                    <div class="campo-con-boton">
                        <CampoTexto Etiqueta="Contraseña" Type="password" Placeholder="Déjalo en blanco para conservar la actual" Valor="@_credencialContrasena" ValorChanged="v => _credencialContrasena = v" />
                        <BotonCopiar ValorAsync="ObtenerContrasenaParaCopiarAsync" Etiqueta="la contraseña" />
                    </div>
                    @if (_hayCredencialGuardada)
                    {
                        <div class="workspace-acciones-edicion">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirBorrarContrasena">
                                Borrar contraseña
                            </Boton>
                        </div>
                    }
                    <CampoTextarea Etiqueta="Notas" Valor="@_credencialNotas" ValorChanged="v => _credencialNotas = v" Filas="3" />
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Cargando="_guardandoCredenciales" OnClick="GuardarCredencialesAsync">
                            Guardar credenciales
                        </Boton>
                    </div>
                }
                else
                {
                    <div class="rejilla-info-empresa-360">
                        <CampoInfo Etiqueta="Razón social" Valor="@_detalle.RazonSocial" />
                        <CampoInfo Etiqueta="CIF" Valor="@_detalle.Cif" />
                        <CampoInfo Etiqueta="CNAE" Valor="@_detalle.Cnae" />
                        <CampoInfo Etiqueta="Convenio aplicable" Valor="@_detalle.ConvenioAplicable" />
                        <CampoInfo Etiqueta="Actividad del Anexo I del RSP" Valor="@(_detalle.EsActividadAnexoI ? "Sí" : "No")" />
                        <CampoInfo Etiqueta="Clientes empresariales con los que trabaja" Valor="@_detalle.ClienteIds.Count.ToString()" />
                        <CampoInfo Etiqueta="Creada" Valor="@_detalle.CreadoEnUtc.ToLocalTime().ToString("dd/MM/yyyy")" />
                    </div>
                    <div class="acciones-empresa-360">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="IniciarEdicionInformacionAsync">Editar identidad</Boton>
                        <Boton Variante="VarianteBoton.Destructivo" Tamano="TamanoBoton.Pequeno" OnClick="AbrirDarDeBaja">Dar de baja</Boton>
                    </div>
                }
                break;

            case "clientes":
                @if (_cargandoClientes)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorClientes)
                {
                    <EstadoVacio Titulo="No pudimos cargar los clientes" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion>
                            <Boton OnClick="CargarClientesAsync">Reintentar</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_clientes is { Count: 0 })
                {
                    <EstadoVacio Titulo="Sin clientes empresariales" Descripcion="Esta empresa todavía no tiene ningún Cliente empresarial asociado." />
                }
                else if (_clientes is not null)
                {
                    <ul class="workspace-lista-entidades">
                        @foreach (var cliente in _clientes)
                        {
                            <FilaEntidadRelacionada
                                @key="cliente.Id"
                                Titulo="@cliente.RazonSocial"
                                Subtitulo="@cliente.Cif"
                                OnClic="() => AbrirClienteAsync(cliente)" />
                        }
                    </ul>
                }
                break;

            case "documentacion":
                <PestanaDocumentacion Ambito="AmbitoAplicacion.Empresa" PropietarioId="EntidadId" />
                break;

            case "agenda":
                <PestanaAgendaContactos Tipo="TipoPropietarioAgenda.Empresa" PropietarioId="EntidadId" />
                break;

            case "sello":
                <PestanaSelloEmpresa EntidadId="EntidadId" />
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Empresa" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>

    <DialogoConfirmacion
        Visible="_confirmarBorrarContrasenaVisible"
        VisibleChanged="v => _confirmarBorrarContrasenaVisible = v"
        Titulo="¿Borrar la contraseña guardada?"
        Mensaje="La URL, el usuario y las notas de la credencial no se tocan — solo se borra la contraseña."
        EnProgreso="_borrandoContrasena"
        OnConfirmar="ConfirmarBorrarContrasenaAsync" />

    <DialogoConfirmacion
        Visible="_confirmarBajaVisible"
        VisibleChanged="v => _confirmarBajaVisible = v"
        Titulo="¿Dar de baja esta empresa?"
        Mensaje="La baja no se puede deshacer desde esta ficha. Si tiene trabajadores, la operación se rechazará."
        EnProgreso="_dandoDeBaja"
        OnConfirmar="ConfirmarDarDeBajaAsync" />
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("clientes", "Clientes empresariales"),
        new("documentacion", "Documentación"),
        new("agenda", "Agenda"),
        new("sello", "Sello"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private EmpresaDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;
    private int? _cumplimiento;

    private IReadOnlyList<ClienteDeEmpresaDto>? _clientes;
    private bool _cargandoClientes;
    private bool _errorClientes;
    private int _generacion;
    private int _cargaCabecera;
    private int _cargaClientes;
    private readonly CancellationTokenSource _ciclo = new();
    private CancellationToken _cancelacion;

    /// <summary>
    /// Edición in situ de "Información" (Centro 360, PLAN-EJECUCION-UX.md
    /// § 0.10) — sustituye al Drawer de "Editar" de <c>/empresas</c>, retirado.
    /// Las credenciales de acceso vivían dentro de ese mismo Drawer (solo en
    /// modo edición, nunca al crear) — se mueven aquí en vez de perderse:
    /// siguen siendo una acción de "Guardar" independiente, como ya lo eran.
    /// </summary>
    private bool _editandoInformacion;
    private string _razonSocialInfo = string.Empty;
    private string _cifInfo = string.Empty;
    private string _cnaeInfo = string.Empty;
    private string _convenioAplicableInfo = string.Empty;
    private bool _esActividadAnexoIInfo;
    private HashSet<Guid> _clienteIdsInfo = [];
    private IReadOnlyList<ClienteSelectorDto> _clientesDisponibles = [];
    private IReadOnlyList<ElementoSeleccionable> _clientesDisponiblesSelector =>
        _clientesDisponibles.Select(c => new ElementoSeleccionable(c.Id, c.RazonSocial)).ToList();
    private bool _guardandoInformacion;
    private string? _mensajeErrorInformacion;
    private Dictionary<string, string> _erroresInformacion = new();

    private string _credencialUrl = string.Empty;
    private string _credencialCampoEmpresa = string.Empty;
    private string _credencialUsuario = string.Empty;

    /// <summary>
    /// Nunca se precarga desde el servidor (DEC-53/DEC-62) — solo lo que el
    /// usuario escriba en esta sesión de edición. Vacío al guardar significa
    /// "conserva la almacenada", no "bórrala": ver
    /// <c>GuardarCredencialAccesoEmpresaCommand</c>.
    /// </summary>
    private string _credencialContrasena = string.Empty;
    private string _credencialNotas = string.Empty;

    /// <summary>Si ya existe una fila de credencial — controla si "Borrar contraseña" tiene sentido mostrarse.</summary>
    private bool _hayCredencialGuardada;
    private bool _guardandoCredenciales;
    private string? _mensajeErrorCredenciales;
    private bool _confirmarBorrarContrasenaVisible;
    private bool _borrandoContrasena;
    private bool _confirmarBajaVisible;
    private bool _dandoDeBaja;

    // El recuento se limita a la pestaña que representa; la cabecera solo lo muestra allí.
    private IReadOnlyList<PestanaDefinicion> PestanasConRecuento =>
        _pestanas.Select(p => p.Id == "clientes" && _clientes is not null
            ? p with { Etiqueta = $"{p.Etiqueta} ({_clientes.Count})" }
            : p).ToList();

    protected override void OnInitialized() => _cancelacion = _ciclo.Token;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _generacion++;
            _idCargado = EntidadId;
            _clientes = null;
            _errorClientes = false;
            _cumplimiento = null;
            _editandoInformacion = false;
            _confirmarBajaVisible = false;
            _guardandoInformacion = false;
            _guardandoCredenciales = false;
            _borrandoContrasena = false;
            _dandoDeBaja = false;
            await CargarCabeceraAsync();
        }

        if (PestanaActiva == "clientes" && _clientes is null && !_errorClientes && !_cargandoClientes)
            await CargarClientesAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var carga = ++_cargaCabecera;
        var id = EntidadId;
        _cargando = true;
        _error = false;

        try
        {
            var detalle = await Mediator.Send(new ObtenerEmpresaPorIdQuery(id), cancelacion);
            if (generacion != _generacion || carga != _cargaCabecera) return;
            var cumplimiento = await Mediator.Send(new ObtenerCumplimientoEmpresaQuery(id), cancelacion);
            if (generacion != _generacion || carga != _cargaCabecera) return;
            _detalle = detalle;
            _cumplimiento = cumplimiento;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _error = true;
        }
        finally
        {
            if (generacion == _generacion && carga == _cargaCabecera)
                _cargando = false;
        }
    }

    private async Task CargarClientesAsync()
    {
        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var carga = ++_cargaClientes;
        var idSolicitado = EntidadId;
        _cargandoClientes = true;
        _errorClientes = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerClientesDeEmpresaQuery(idSolicitado), cancelacion);
            if (generacion == _generacion && carga == _cargaClientes && idSolicitado == EntidadId)
                _clientes = resultado;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generacion == _generacion && carga == _cargaClientes && idSolicitado == EntidadId)
                _errorClientes = true;
        }
        finally
        {
            if (generacion == _generacion && carga == _cargaClientes && idSolicitado == EntidadId)
                _cargandoClientes = false;
        }
    }

    private Task AbrirClienteAsync(ClienteDeEmpresaDto cliente) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Cliente, cliente.Id, cliente.RazonSocial, "informacion");

    private async Task IniciarEdicionInformacionAsync()
    {
        if (_detalle is null) return;

        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var detalle = _detalle;
        IReadOnlyList<ClienteSelectorDto> clientes;
        try
        {
            clientes = await Mediator.Send(new ObtenerClientesParaSelectorQuery(), cancelacion);
            if (generacion != _generacion) return;
            var credencial = await Mediator.Send(new ObtenerCredencialAccesoEmpresaSinContrasenaQuery(detalle.Id), cancelacion);
            if (generacion != _generacion) return;

            _clientesDisponibles = clientes;
            _razonSocialInfo = detalle.RazonSocial;
            _cifInfo = detalle.Cif ?? string.Empty;
            _cnaeInfo = detalle.Cnae ?? string.Empty;
            _convenioAplicableInfo = detalle.ConvenioAplicable ?? string.Empty;
            _esActividadAnexoIInfo = detalle.EsActividadAnexoI;
            _clienteIdsInfo = detalle.ClienteIds.ToHashSet();
            _mensajeErrorInformacion = null;
            _erroresInformacion = new Dictionary<string, string>();

            _credencialUrl = credencial?.UrlAcceso ?? string.Empty;
            _credencialCampoEmpresa = credencial?.CampoEmpresa ?? string.Empty;
            _credencialUsuario = credencial?.Usuario ?? string.Empty;
            _credencialContrasena = string.Empty;
            _credencialNotas = credencial?.Notas ?? string.Empty;
            _hayCredencialGuardada = credencial is not null;
            _mensajeErrorCredenciales = null;

            _editandoInformacion = true;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (Exception)
        {
            if (generacion == _generacion)
                ToastService.Mostrar("No pudimos abrir la edición. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private void AlternarClienteInfo(Guid clienteId, bool seleccionado)
    {
        if (seleccionado)
            _clienteIdsInfo.Add(clienteId);
        else
            _clienteIdsInfo.Remove(clienteId);
    }

    private string? ObtenerErrorInformacion(string campo) => _erroresInformacion.GetValueOrDefault(campo);

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null || _guardandoInformacion) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _guardandoInformacion = true;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();

        try
        {
            var cif = string.IsNullOrWhiteSpace(_cifInfo) ? null : _cifInfo;
            var cnae = string.IsNullOrWhiteSpace(_cnaeInfo) ? null : _cnaeInfo;
            var convenioAplicable = string.IsNullOrWhiteSpace(_convenioAplicableInfo) ? null : _convenioAplicableInfo;
            var resultado = await Mediator.Send(
                new EditarEmpresaCommand(
                    detalle.Id, _razonSocialInfo, cif, _clienteIdsInfo.ToList(),
                    cnae, convenioAplicable, _esActividadAnexoIInfo, detalle.Version));
            if (resultado.EsFallido)
            {
                if (generacion == _generacion)
                    _mensajeErrorInformacion = resultado.Error.Mensaje;
                else
                    ToastService.Mostrar($"{detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            if (generacion != _generacion) return;

            ToastService.Mostrar($"{detalle.RazonSocial} actualizada correctamente.", TonoToast.Exito);
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
                _erroresInformacion = ex.Errors.GroupBy(e => e.PropertyName)
                    .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
            else
                ToastService.Mostrar($"No pudimos guardar los cambios de {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorInformacion = "No pudimos guardar los cambios. Intenta nuevamente en unos segundos.";
            else
                ToastService.Mostrar($"No pudimos guardar los cambios de {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoInformacion = false;
        }
    }

    private async Task GuardarCredencialesAsync()
    {
        if (_detalle is null || _guardandoCredenciales) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _guardandoCredenciales = true;
        _mensajeErrorCredenciales = null;

        try
        {
            var urlAcceso = string.IsNullOrWhiteSpace(_credencialUrl) ? null : _credencialUrl;
            var campoEmpresa = string.IsNullOrWhiteSpace(_credencialCampoEmpresa) ? null : _credencialCampoEmpresa;
            var usuario = string.IsNullOrWhiteSpace(_credencialUsuario) ? null : _credencialUsuario;
            var contrasena = string.IsNullOrWhiteSpace(_credencialContrasena) ? null : _credencialContrasena;
            var notas = string.IsNullOrWhiteSpace(_credencialNotas) ? null : _credencialNotas;

            var resultado = await Mediator.Send(
                new GuardarCredencialAccesoEmpresaCommand(detalle.Id, urlAcceso, campoEmpresa, usuario, contrasena, notas));
            if (resultado.EsFallido)
            {
                if (generacion == _generacion)
                    _mensajeErrorCredenciales = resultado.Error.Mensaje;
                else
                    ToastService.Mostrar($"{detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            if (generacion != _generacion) return;

            ToastService.Mostrar($"Credenciales de {detalle.RazonSocial} guardadas correctamente.", TonoToast.Exito);
            _hayCredencialGuardada = true;
            _credencialContrasena = string.Empty;
        }
        catch (Exception)
        {
            if (generacion == _generacion)
                _mensajeErrorCredenciales = "No pudimos guardar las credenciales. Intenta nuevamente en unos segundos.";
            else
                ToastService.Mostrar($"No pudimos guardar las credenciales de {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _guardandoCredenciales = false;
        }
    }

    /// <summary>
    /// Petición explícita y separada (DEC-53/DEC-62): solo se pide al
    /// servidor en el momento de copiar, nunca como efecto de abrir el
    /// panel. <see cref="ObtenerCredencialAccesoEmpresaQuery"/> sigue siendo
    /// la única vía que decodifica la contraseña, y sigue marcada como
    /// <c>IConsultaDeSecretosDeTenant</c>.
    /// </summary>
    private async Task<string?> ObtenerContrasenaParaCopiarAsync()
    {
        if (_detalle is null) return null;

        var cancelacion = _cancelacion;
        var generacion = _generacion;
        var credencial = await Mediator.Send(new ObtenerCredencialAccesoEmpresaQuery(_detalle.Id), cancelacion);
        if (generacion != _generacion) return null;
        if (string.IsNullOrEmpty(credencial?.Contrasena))
        {
            ToastService.Mostrar("No hay ninguna contraseña guardada.", TonoToast.Info);
            return null;
        }

        return credencial.Contrasena;
    }

    private void AbrirBorrarContrasena() => _confirmarBorrarContrasenaVisible = true;

    private async Task ConfirmarBorrarContrasenaAsync()
    {
        if (_detalle is null || _borrandoContrasena) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _borrandoContrasena = true;

        try
        {
            var resultado = await Mediator.Send(new BorrarCredencialAccesoEmpresaContrasenaCommand(detalle.Id));

            if (resultado.EsFallido)
            {
                ToastService.Mostrar($"{detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"Contraseña de {detalle.RazonSocial} borrada.", TonoToast.Exito);
            if (generacion != _generacion) return;
            _credencialContrasena = string.Empty;
            _confirmarBorrarContrasenaVisible = false;
        }
        catch (Exception)
        {
            ToastService.Mostrar($"No pudimos borrar la contraseña de {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion)
                _borrandoContrasena = false;
        }
    }

    private void AbrirDarDeBaja() => _confirmarBajaVisible = true;

    private async Task ConfirmarDarDeBajaAsync()
    {
        if (_detalle is null || _dandoDeBaja) return;

        var generacion = _generacion;
        var detalle = _detalle;
        _dandoDeBaja = true;
        try
        {
            var resultado = await Mediator.Send(new EliminarEmpresaCommand(detalle.Id));
            if (resultado.EsFallido)
            {
                ToastService.Mostrar($"{detalle.RazonSocial}: {resultado.Error.Mensaje}", TonoToast.Error);
                if (generacion == _generacion) _confirmarBajaVisible = false;
                return;
            }

            ToastService.Mostrar($"{detalle.RazonSocial} se dio de baja.", TonoToast.Exito);
            if (generacion != _generacion) return;
            _confirmarBajaVisible = false;
            if (WorkspaceService.FrameActual is { Tipo: EntidadWorkspace.Empresa } frame && frame.EntidadId == detalle.Id)
            {
                if (WorkspaceService.Pila.Count > 1) await WorkspaceService.VolverAsync();
                else await WorkspaceService.CerrarAsync();
            }
        }
        catch (Exception)
        {
            ToastService.Mostrar($"No pudimos dar de baja {detalle.RazonSocial}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion) _dandoDeBaja = false;
        }
    }

    public void Dispose()
    {
        _generacion++;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
