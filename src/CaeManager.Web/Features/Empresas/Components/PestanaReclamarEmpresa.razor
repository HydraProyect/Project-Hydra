@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Web.Features.Empresas.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject IStringLocalizer<TextosPestanaReclamar> Textos

@* Pestaña «Reclamar» de Empresa 360 (maqueta «Reclamacion preventiva TALVEG.dc.html», decisión de Chris, 2026-10-19): todo lo vencido,
   pendiente o por vencer de la Empresa y de todos sus Trabajadores, consolidado y filtrable por Delegación y Oficio. Los datos son de
   ObtenerReclamacionPreventivaEmpresaQuery (alcance de cartera incluido); la pestaña no recuenta ni amplía nada y no tiene envío propio:
   «Reclamar» abre el DrawerReclamacionLote de siempre ya en su revisión, y nada se envía sin el clic del Gestor CAE en el cajón. *@
<section class="reclamar-empresa" data-pieza="reclamar-empresa" aria-label="@Textos["Etiqueta"]">
    @if (_error)
    {
        <Tarjeta>
            <EstadoVacio Titulo="@Textos["ErrorTitulo"]" Descripcion="@Textos["ErrorDescripcion"]"
                         NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="CargarAsync">@Textos["Reintentar"]</Boton>
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_dto is null)
    {
        <Tarjeta><EstadoCargando Filas="4" /></Tarjeta>
    }
    else
    {
        @if (_filas.Count == 0 && !HayFiltroDeServidor)
        {
            @* Sin nada que reclamar no es «al día»: la consulta devuelve lo mismo para una Empresa fuera de la cartera, así que el texto habla
               de lo que se puede reclamar y no afirma que la Empresa cumpla. *@
            <Tarjeta>
                <EstadoVacio Titulo="@Textos["NadaQueReclamarTitulo"]" Descripcion="@Textos["NadaQueReclamarDescripcion"]"
                             NombreIcono="exito-circulo" AcentoIcono="var(--color-success-500)" FondoIcono="var(--color-success-50)" />
            </Tarjeta>
        }
        else
        {
            @* Los dos recuentos que no filtran van en una línea de apoyo; los que filtran son los chips de estado de siempre
               (FiltroEstadosMultiple), con el mismo universo que cuentan. *@
            <p class="reclamar-empresa-resumen" aria-busy="@(_recargando ? "true" : "false")" aria-live="polite">
                <span class="reclamar-empresa-dato"><b>@_vista.EmpresaVencidosOPendientes</b> @Textos["ResumenEmpresa"]</span>
                <span class="reclamar-empresa-dato"><b>@_vista.TrabajadoresAfectados</b> @Textos["ResumenTrabajadores"]</span>
            </p>

            <FiltroEstadosMultiple Opciones="OpcionesDeEstado" Seleccion="EstadosMarcados" SeleccionChanged="CambiarEstados"
                                   Total="_filas.Count" Etiqueta="@Textos["FiltroEstado"]" />

            <div class="reclamar-empresa-pastillas">
                @* Delegación y Oficio piden al servidor: mientras carga se deshabilitan (el DbContext de la conexión no admite dos consultas
                   a la vez). El fieldset deshabilita de una vez los botones de las pastillas; Agrupar es de cliente y sigue libre. *@
                @* Sin delegaciones ni Oficios el fieldset quedaría con solo su leyenda: no se pinta. *@
                @if (Sedes.Count > 0 || _dto.Oficios.Count > 0)
                {
                    <fieldset class="reclamar-empresa-servidor" disabled="@_recargando">
                        <legend class="reclamar-empresa-legend">@Textos["FiltrosDelServidor"]</legend>
                        @if (Sedes.Count > 0)
                        {
                            <PastillaFiltro Etiqueta="@Textos["FiltroSede"]" TextoTodos="@Textos["TodasLasSedes"]" Valor="@(_sedeId?.ToString() ?? string.Empty)"
                                            ValorChanged="CambiarSedeAsync" Opciones="OpcionesDeSede" />
                        }
                        @if (_dto.Oficios.Count > 0)
                        {
                            <PastillaFiltro Etiqueta="@Textos["FiltroOficio"]" TextoTodos="@Textos["TodosLosOficios"]" Valor="@(_oficioId?.ToString() ?? string.Empty)"
                                            ValorChanged="CambiarOficioAsync" Opciones="OpcionesDeOficio" />
                        }
                    </fieldset>
                }
                <PastillaFiltro Etiqueta="@Textos["AgruparPor"]" Valor="@AgrupacionActiva.ToString()" ValorChanged="Agrupar"
                                Opciones="OpcionesDeAgrupacion" OfrecerTodos="false" />
                @if (HayFiltrosActivos)
                {
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" Deshabilitado="_recargando" OnClick="QuitarFiltrosAsync">@Textos["QuitarFiltros"]</Boton>
                }
            </div>

            @if (!HaySedes)
            {
                <p class="texto-descriptivo reclamar-empresa-nota">@Textos["SinSedes"]</p>
            }

            @if (_vista.Grupos.Count == 0)
            {
                <Tarjeta>
                    <EstadoVacio Titulo="@Textos["SinResultadosTitulo"]" Descripcion="@Textos["SinResultadosDescripcion"]">
                        <Accion>
                            <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_recargando" OnClick="QuitarFiltrosAsync">@Textos["QuitarFiltros"]</Boton>
                        </Accion>
                    </EstadoVacio>
                </Tarjeta>
            }
            else
            {
                @* La lista es la de la pestaña Trabajadores de Subcontrata: tarjeta con «Mostrando N de M», una fila por
                   grupo (iniciales o icono, detalle, estado en píldora y acción) y los documentos del grupo desplegados debajo. *@
                <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["Etiqueta"]">
                    <Encabezado>
                        <span class="reclamar-empresa-linea">
                            <span>@Textos["Mostrando", _vista.TotalFilas, _filas.Count]</span>
                            <SoloConEscritura>
                                <span class="reclamar-empresa-cta">
                                    @if (PuedeReclamar)
                                    {
                                        <span>@Textos["NadaSeEnvia"]</span>
                                    }
                                    else if (!_recargando)
                                    {
                                        <span>@Textos["SinDestinatario"]</span>
                                    }
                                    <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Deshabilitado="!PuedeReclamar" OnClick="AbrirTodo">@Textos["ReclamarVisibles", _vista.TotalFilas]</Boton>
                                </span>
                            </SoloConEscritura>
                        </span>
                    </Encabezado>
                    <ChildContent>
                        @{ var clavesGrupos = new ClavesDeHermanos(); }
                        @foreach (var grupo in _vista.Grupos)
                        {
                            var abierto = _abiertos.Contains(grupo.Clave);
                            var peor = PeorFila(grupo);
                            <FilaRelacion @key="clavesGrupos.De(grupo.Clave)" Nombre="@grupo.Titulo" Iniciales="@InicialesDeGrupo(grupo)" NombreIcono="@NombreIconoDeGrupo(grupo)"
                                          Tono="TonoDeGrupo(grupo)" Desplegada="abierto" DesplegadaChanged="v => AlternarGrupo(grupo.Clave)"
                                          EtiquetaDesplegar="@Textos[abierto ? "PlegarGrupo" : "DesplegarGrupo", grupo.Titulo]">
                                <Detalle>
                                    <span>@grupo.Subtitulo · @DesgloseDeGrupo(grupo)</span>
                                    @if (grupo.Lote is { } lote)
                                    {
                                        <span class="reclamar-empresa-grupo-destino">
                                            @if (lote.Destinatarios is { Count: > 0 })
                                            {
                                                <span>· @TextoDestino(lote)</span>
                                            }
                                            else
                                            {
                                                <span class="reclamar-empresa-sin-contacto" role="alert">· @TextoSinContacto(lote)</span>
                                            }
                                            <span>· @TextoUltimaReclamacion(lote)</span>
                                        </span>
                                    }
                                </Detalle>
                                <Estado>
                                    <Badge Tono="peor.Tono">@peor.Insignia</Badge>
                                </Estado>
                                <Acciones>
                                    @if (grupo.Lote is { } loteGrupo)
                                    {
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                   Deshabilitado="@(_recargando || loteGrupo.Destinatarios is not { Count: > 0 })" OnClick="() => AbrirGrupo(loteGrupo.Clave)" aria-label="@Textos["ReclamarGrupoEtiqueta", grupo.Titulo]">@Textos["ReclamarGrupo"]</Boton>
                                        </SoloConEscritura>
                                    }
                                </Acciones>
                                <Desplegable>
                                    <ul class="reclamar-empresa-filas" aria-label="@grupo.Titulo">
                                        @{ var clavesFilas = new ClavesDeHermanos(); }
                                        @foreach (var fila in grupo.Filas)
                                        {
                                            <li class="reclamar-empresa-fila" data-pieza="fila" @key="clavesFilas.De(fila.Clave)">
                                                <span class="reclamar-empresa-fila-nombre">
                                                    <strong>@fila.Tipo</strong>
                                                    <span class="reclamar-empresa-fila-detalle" data-pieza="fila-detalle">@DetalleDeFila(fila)</span>
                                                </span>
                                                <Badge Tono="fila.Tono" Tamano="TamanoBadge.Pequeno">@fila.Insignia</Badge>
                                            </li>
                                        }
                                    </ul>
                                </Desplegable>
                            </FilaRelacion>
                        }
                    </ChildContent>
                </ListaRelaciones>
            }
        }

        @* Lo vigente en TALVEG que falta en la plataforma del Cliente empresarial no se reclama a la Empresa: aquí solo se enseña. *@
        @if (_errorSubir)
        {
            <p class="texto-descriptivo reclamar-empresa-nota">@Textos["SubirError"]</p>
        }
        else if (_pendientesDeSubir.Count > 0)
        {
            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["SubirTitulo", _pendientesDeSubir.Count]">
                <Encabezado>
                    <span class="reclamar-empresa-linea">
                        <span><strong>@Textos["SubirTitulo", _pendientesDeSubir.Count]</strong> · @Textos["SubirDescripcion"]</span>
                        <a class="reclamar-empresa-enlace" href="@($"/empresas/{EmpresaId}?pestana=plataformas")">@Textos["SubirVerPlataformas"]</a>
                    </span>
                </Encabezado>
                <ChildContent>
                    @{ var clavesSubir = new ClavesDeHermanos(); }
                    @foreach (var fila in _pendientesDeSubir)
                    {
                        <FilaRelacion @key="clavesSubir.De(fila.Clave)" Nombre="@fila.Tipo" NombreIcono="documentos">
                            <Detalle>@Textos["SubirFila", fila.Titular, fila.Centro]</Detalle>
                        </FilaRelacion>
                    }
                </ChildContent>
            </ListaRelaciones>
        }

        @if (_filas.Count > 0 || HayFiltroDeServidor)
        {
            <p class="texto-descriptivo reclamar-empresa-nota">@Textos["NotaPie"]</p>
        }
    }
    @* El cajón de siempre, abierto ya en su revisión con lo que enseña esta pestaña. Cada tarjeta se envía con su comando, que vuelve a
       validar documentos, cartera y destinatarios. *@
    <DrawerReclamacionLote Visible="_cajonVisible" VisibleChanged="CambiarCajon"
                           AmbitosDisponibles="@(new[] { AmbitoAplicacion.Trabajador, AmbitoAplicacion.Empresa })"
                           LotesIniciales="@(_cajonVisible ? _cajonLotes : null)" IncluirPendientesSinFecha="true"
                           OnReclamacionEnviada="CargarAsync" />
</section>
