@using System.Globalization
@using CaeManager.Application.Documentos.Queries.ObtenerAcreditacionesPorProveedor
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Empresas.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject IStringLocalizer<TextosEmpresas> Textos

@* Pestaña «Plataformas» de Empresa 360 (maqueta «Empresa 360 TALVEG»): el estado de los documentos de la Empresa en la plataforma CAE de
   cada Cliente, por Centro. Lee ObtenerAcreditacionesPorProveedorQuery acotada a esta Empresa (la misma que el drill-down por plataforma
   de Documentos y la Bandeja, con su mismo alcance de gestión). *@
<section class="plataformas-empresa" data-pieza="plataformas-empresa" aria-label="@Textos["PestanaPlataformas"]">
    <p class="plataformas-apoyo">@Textos["PlataformasApoyo"]</p>

    @* Los mismos chips de estado que las demás fichas 360 (FiltroEstadosMultiple): «Solo incidencias» es el chip marcado y «Todo» quita la marca. *@
    @if (_filas is not null)
    {
        <FiltroEstadosMultiple Opciones="OpcionesFiltro" Seleccion="Marcados" SeleccionChanged="CambiarFiltro" Total="_filas.Count"
                               TextoTodos="@Textos["PlataformasTodoRotulo"]" Etiqueta="@Textos["PlataformasQueMostrar"]" />
    }

    @if (_error)
    {
        <Tarjeta>
            <EstadoVacio Titulo="@Textos["PlataformasErrorTitulo"]" Descripcion="@Textos["ErrorSeccionDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Textos["Reintentar"]</Boton>
                </Accion>
            </EstadoVacio>
        </Tarjeta>
    }
    else if (_filas is null)
    {
        <Tarjeta><EstadoCargando Filas="3" /></Tarjeta>
    }
    else if (_filas.Count == 0)
    {
        <Tarjeta>
            <EstadoVacio Titulo="@Textos["PlataformasSinDatosTitulo"]" Descripcion="@Textos["PlataformasSinDatosDescripcion"]" />
            @* Quien no gestiona Centros (p. ej. el rol de Cliente empresarial) recibe la lista vacía aunque la Empresa sí tenga documentos: no se le afirma que no hay nada. *@
            <p class="plataformas-nota" data-nota="alcance">@Textos["PlataformasSinAlcanceNota"]</p>
        </Tarjeta>
    }
    else
    {
        var grupos = Grupos();
        @if (grupos.Count == 0 && HayFiltrosActivos)
        {
            <Tarjeta>
                <EstadoVacio Titulo="@Textos["PlataformasVacioTitulo"]" Descripcion="@Textos["PlataformasVacioDescripcion"]" />
            </Tarjeta>
        }
        else
        {
            @* Como la pestaña Plataformas de Subcontrata: una tarjeta, «Cliente › Centro» como cabecera de cada grupo y una fila por documento. *@
            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["PestanaPlataformas"]">
                <Encabezado>@Textos["PlataformasMostrando", TotalVisibles(grupos), _filas.Count]</Encabezado>
                <ChildContent>
                    @{ var claves = new ClavesDeHermanos(); }
                    @foreach (var grupo in grupos)
                    {
                        <li class="plataformas-grupo" @key="claves.De((grupo.Cliente, grupo.CentroId, grupo.Plataforma))">
                            <span class="plataformas-grupo-titulo">
                                <span class="plataformas-grupo-cliente">@grupo.Cliente ›</span>
                                <strong>@grupo.Centro</strong>
                                <span class="plataformas-grupo-cliente">@Textos["PlataformasPlataforma", grupo.Plataforma, Resumen(grupo.Incidencias)]</span>
                            </span>
                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Href="@($"/centros/{grupo.CentroId}")">@Textos["PlataformasIrAlCentro"]</Boton>
                        </li>
                        @foreach (var fila in grupo.Visibles)
                        {
                            <FilaRelacion @key="claves.De((fila.Cliente, fila.CentroId, fila.Plataforma, fila.Documento))" Nombre="@fila.Documento" Tono="TonoDeFila(fila)">
                                <Detalle>@Detalle(fila)</Detalle>
                                <Estado><Badge Tono="@Tono(fila)">@NombreEstado(fila)</Badge></Estado>
                            </FilaRelacion>
                        }
                    }
                </ChildContent>
            </ListaRelaciones>
        }
    }
</section>
@code {
    [Parameter, EditorRequired] public Guid EmpresaId { get; set; }

    /// <summary>Avisa de cuántas incidencias hay al terminar de cargar: es el contador de la pestaña en la ficha (maqueta «Empresa 360»).</summary>
    [Parameter] public EventCallback<int> IncidenciasCargadas { get; set; }

    private sealed record Grupo(string Cliente, Guid CentroId, string Centro, string Plataforma, IReadOnlyList<FilaPlataforma> Visibles, int Incidencias);

    private readonly CancellationTokenSource _ciclo = new();
    private List<FilaPlataforma>? _filas;
    private bool _error;
    private bool _soloIncidencias = true;
    private Guid _cargado;
    private int _carga;

    private int Incidencias => _filas is null ? 0 : FilasPlataformasEmpresa.Incidencias(_filas);

    private IReadOnlyList<OpcionEstadoRecuento> OpcionesFiltro => [new("incidencias", Textos["PlataformasSoloIncidenciasRotulo"], Incidencias)];

    private IReadOnlySet<string> Marcados => _soloIncidencias ? new HashSet<string> { "incidencias" } : new HashSet<string>();

    private void CambiarFiltro(IReadOnlySet<string> marcados) => _soloIncidencias = marcados.Contains("incidencias");

    protected override async Task OnParametersSetAsync()
    {
        if (EmpresaId == _cargado) return;
        _cargado = EmpresaId;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var carga = ++_carga;
        var empresaId = EmpresaId;
        _error = false;
        _filas = null;
        try
        {
            // El universo y la regla de incidencia son los de FilasPlataformasEmpresa: los mismos con los que la ficha cuenta el
            // contador de la pestaña antes de abrirla.
            var proveedores = await Mediator.Send(FilasPlataformasEmpresa.Consulta(empresaId), _ciclo.Token);
            if (carga != _carga) return;

            _filas = FilasPlataformasEmpresa.Construir(proveedores);
            await IncidenciasCargadas.InvokeAsync(Incidencias);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            if (carga == _carga) _error = true;
        }
    }

    public void Dispose()
    {
        _ciclo.Cancel();
        _ciclo.Dispose();
    }

    private IReadOnlyList<Grupo> Grupos() => _filas!
        .GroupBy(f => (f.Cliente, f.CentroId, f.Centro, f.Plataforma))
        .Select(g =>
        {
            var todas = g.OrderBy(FilasPlataformasEmpresa.Rango).ThenBy(f => f.Documento, StringComparer.CurrentCultureIgnoreCase).ToList();
            var visibles = _soloIncidencias ? todas.Where(FilasPlataformasEmpresa.EsIncidencia).ToList() : todas;
            return new Grupo(g.Key.Cliente, g.Key.CentroId, g.Key.Centro, g.Key.Plataforma, visibles, FilasPlataformasEmpresa.Incidencias(todas));
        })
        .Where(g => g.Visibles.Count > 0)
        .OrderBy(g => g.Cliente, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(g => g.Centro, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private string Resumen(int incidencias) => incidencias switch
    {
        0 => Textos["PlataformasTodoValidado"],
        1 => Textos["PlataformasUnaIncidencia"],
        _ => Textos["PlataformasVariasIncidencias", incidencias]
    };

    private string NombreEstado(FilaPlataforma fila) => fila.Vencida ? Textos["PlataformasEstadoVencidoEnPlataforma"] : fila.Estado switch
    {
        EstadoAcreditacion.Aceptada => Textos["PlataformasEstadoValidado"],
        EstadoAcreditacion.Subida => Textos["PlataformasEstadoPendienteValidacion"],
        EstadoAcreditacion.Rechazada => Textos["PlataformasEstadoRechazado"],
        _ => Textos["PlataformasEstadoPendienteSubir"]
    };

    private string Detalle(FilaPlataforma fila)
    {
        if (fila.Vencida)
            return fila.VenceEnPlataforma is { } fecha
                ? Textos["PlataformasVencidoEl", fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)]
                : Textos["PlataformasEstadoVencidoEnPlataforma"];
        return string.IsNullOrWhiteSpace(fila.Motivo) ? string.Empty : fila.Motivo;
    }

    private static TonoFila? TonoDeFila(FilaPlataforma fila) => fila.Vencida ? TonoFila.Peligro : fila.Estado switch
    {
        EstadoAcreditacion.Aceptada => null,
        EstadoAcreditacion.Subida => TonoFila.Advertencia,
        _ => TonoFila.Peligro
    };

    private static TonoBadge Tono(FilaPlataforma fila) => fila.Vencida ? TonoBadge.Peligro : fila.Estado switch
    {
        EstadoAcreditacion.Aceptada => TonoBadge.Exito,
        EstadoAcreditacion.Subida => TonoBadge.Advertencia,
        _ => TonoBadge.Peligro
    };
}