@page "/empresas"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Empresas.Commands.CrearEmpresa
@using CaeManager.Application.Empresas.Commands.EditarEmpresa
@using CaeManager.Application.Empresas.Commands.EliminarEmpresas
@using CaeManager.Application.Empresas.Commands.GuardarCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerClientesDeEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresaPorId
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Common
@using CaeManager.Application.Tenants.Queries.ObtenerPerfilVocabularioActual
@using CaeManager.Domain.Tenants
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Empresas.Components
@using CaeManager.Web.Features.Empresas.Recursos
@using Microsoft.Extensions.Localization
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject ICurrentUserService CurrentUserService
@inject IStringLocalizer<TextosEmpresas> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@_tituloPagina — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Rediseño de listados, fase 1: cabecera de una línea (CabeceraListado) con el contador, el
       conmutador ☑ de selección múltiple —la única vía para eliminar: la fila no lleva menú—,
       el menú «⋯» con «Exportar a Excel» (lectura: cualquier rol) y UNA acción primaria. El título lo sigue decidiendo el perfil de vocabulario del
       Tenant («Empresas», o «Mi empresa» con el perfil ClienteDirecto).

       Sin antetítulo («Negocio» ya está en las migas) y sin el rótulo de la empresa gestionada:
       el selector de la barra lateral ya dice cuál es. El estado vacío sin empresa elegida (4a)
       sigue más abajo. *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa)
    {
        <CabeceraListado Titulo="@_tituloPagina" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            @* «Gestor CAE» es dato de cabecera, no columna: la Asignación de Cartera es sobre el
               Tenant entero, así que es el mismo para todas las filas. *@
            <DatoCabecera>
                <CabeceraGestorCae />
            </DatoCabecera>
            <Menu>
                <CaeManager.Web.Exportacion.EntradasExportar Ruta="/empresas/exportar.xlsx" Total="@(_cargando || _errorCarga ? null : _totalElementos)" Criterios="CriteriosExportar" />
            </Menu>
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">+ Nueva empresa</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="@_tituloPagina" />
    }

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve las
           empresas de su organización presentadas como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @* Barra de filtros en modo pastillas: el buscador «Filtrar esta pantalla» (tecla f) y, en la
       misma fila, «Expandir todo / Contraer todo» y el recuento. El estado se filtra en la franja
       de debajo. Sin «Más filtros»: esta pantalla no tiene filtros guardados.

       - El buscador busca en la razón social y en el CIF (ObtenerEmpresasQuery): la pista
         dice los dos.
       - «Documentación» es el peor estado de vigencia de los documentos de la Empresa; viaja
         en la URL como «estado». *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync">
        @* Sin pastillas desde que el estado se filtra en la franja; el fragmento vacío mantiene la barra en modo pastillas. *@
        <Pastillas></Pastillas>
        <Herramientas>
            @if (_elementosPagina.Count > 0)
            {
                <BarraHerramientasLista TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidosAsync" />
            }
        </Herramientas>
        <Resumen>
            @if (!_errorCarga && _totalElementos > 0)
            {
                @* El total lo da la consulta ya filtrada: es el número de coincidencias, no el
                   de la cartera entera. *@
                <span class="conteo-empresas">@TextoConteo</span>
            }
        </Resumen>
        @* Lo que está filtrando se ve y se quita de uno en uno (#497). El valor del FiltroEstado vive
           dentro de un desplegable cerrado, así que sin esto una lista corta parece una lista corta,
           y no una recortada. «Limpiar todo» es el mismo LimpiarFiltrosAsync que «Quitar los filtros»
           del estado vacío, que limpia también los dos filtros de la URL. *@
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@($"Búsqueda: \"{_busqueda}\"")" EtiquetaAccesible="Quitar filtro de búsqueda" OnQuitar="QuitarFiltroBusquedaAsync" />
            }
        </Chips>
    </BarraFiltros>
    @* Franja de estado: sustituye a la pastilla «Documentación». Admite varios estados a la vez, viaja en la
       URL como «estado» (estados de código separados por coma) y cada botón dice cuántas filas hay, con los
       demás filtros aplicados. «Por vencer» reúne Urgente y Próximo. *@
    <FranjaEstado Opciones="EstadoDocumentoUi.FranjaDocumental" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                  Recuentos="_recuentosPorEstado" TextoTodos="@Textos["ListaFiltroTodas"]" />

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las empresas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="6" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay empresas", y llevan a acciones opuestas:
           ofrecer "crea la primera" a quien acaba de teclear mal una razón
           social es mandarlo a duplicar una empresa que ya existe.

           La copia no afirma que HAYA empresas dadas de alta: aquí el filtrado
           es de servidor y la consulta solo devuelve el total YA filtrado, así
           que no sabemos cuántas hay sin filtro. Con cero empresas y un filtro
           escrito, "no coincide ninguna" sigue siendo cierto. Por eso no se
           copia el «Hay empresas dadas de alta, pero…» del mockup. *@
        <EstadoVacio NombreIcono="vacio" Titulo="Ninguna empresa con este filtro"
                     Descripcion="Ninguna coincide con la búsqueda ni con el estado de documentación seleccionado.">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="empresas" Titulo="Aún no hay empresas" Descripcion="Crea la primera para poder dar de alta trabajadores.">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrear">+ Nueva empresa</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        @if (_seleccionMultiple)
        {
            @* "Seleccionar todos" era falso y se contradecía con la propia barra
               de lote, que ya dice «N seleccionado(s) EN ESTA PÁGINA»: la casilla
               solo marca los de la página actual. Con 20 por página y 200
               coincidencias, quien la marcaba y pulsaba "Eliminar seleccionados"
               borraba 20 creyendo que borraba 200 (#503).

               Se dice ademas cuantas quedan fuera cuando las hay: es la mitad
               informativa del banner que pide el mockup. La otra mitad,
               "seleccionar las N filtradas", NO se implementa aqui — añade una
               capacidad de selección masiva sobre un camino destructivo, y eso
               es una decisión de producto, no de maquetación. *@
            <label class="campo-checkbox">
                <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                Seleccionar los de esta página
                @if (_totalElementos > _elementosPagina.Count)
                {
                    <span class="texto-vacio-seccion">@($" — hay {_totalElementos} en total con estos filtros")</span>
                }
            </label>
        }

        @* Marco de la lista del mockup: una sola tarjeta con la cabecera de
           columnas arriba y las filas separadas por una línea, en vez de una
           tarjeta suelta por Empresa. *@
        <div class="marco-lista-empresas">
        @* Cabecera de columnas (#498). Sin roles de tabla a propósito: esto no
           es una tabla —la fila se despliega— y anunciarlo como tal prometería
           a un lector de pantalla una navegación por celdas que no existe. Sin
           QuickGrid por lo mismo: no soporta filas expandibles. Los rótulos no
           ordenan: el mockup no lo pide. *@
        <div class="@ClaseRejilla("cabecera-columnas-empresas")">
            @if (_seleccionMultiple)
            {
                <span></span>
            }
            <span></span>
            <span>@Textos["ColEmpresa"]</span>
            <span>Cumplimiento</span>
            <span>Documentación</span>
            <span>Detecciones</span>
            <span></span>
        </div>

        <div class="lista-filas-acordeon">
            @foreach (var empresa in _elementosPagina)
            {
                <div class="@ClaseTarjeta(empresa)" @key="empresa.Id">
                    @{ var expandido = _expandidos.Contains(empresa.Id); }
                    @* Patrón de listados: la fila no lleva menú «⋯». Un clic en cualquier punto de la
                       fila abre la vista rápida (el panel del Context Workspace), igual que Enter
                       sobre la fila enfocada; los controles de dentro —casilla, desplegable, CIF
                       copiable, detecciones, icono 360— hacen lo suyo y no dejan subir el clic. *@
                    <div class="@(ClaseRejilla("tarjeta-fila-acordeon-cabecera") + " fila-pulsable")"
                         @onclick="() => AbrirVistaRapidaAsync(empresa.Id)">
                        @if (_seleccionMultiple)
                        {
                            <input type="checkbox" aria-label="@($"Seleccionar {empresa.RazonSocial}")" checked="@_seleccionados.Contains(empresa.Id)" @onchange="e => AlternarSeleccion(empresa.Id, (bool)e.Value!)" @onclick:stopPropagation="true" />
                        }
                        <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                aria-expanded="@(expandido ? "true" : "false")"
                                aria-label="@($"{(expandido ? "Ocultar" : "Ver")} los Clientes de {empresa.RazonSocial}")"
                                @onclick="() => AlternarExpansionAsync(empresa.Id)" @onclick:stopPropagation="true">
                            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                        </button>
                        @* El mockup pinta bajo la razón social «CNAE 4322 · Anexo I».
                           EmpresaListaDto no trae ni el CNAE ni el Anexo I (viven en
                           el detalle, y el panel de vista previa ya los enseña), así
                           que no se copia: sería una consulta más por fila. *@
                        @* El nombre es un botón que abre la vista rápida: es el destino de teclado
                           del clic en la fila (la fila entera no es focable con Tab). A la página
                           Empresa 360 (decisión del propietario 2026-09-22: cada 360 tiene página
                           propia) se va con el icono 360 del final de la fila y con el del panel. *@
                        @* Razón social y CIF en una sola celda de dos líneas, como la columna «Empresa» de la
                           maqueta aprobada (fase 1). El CIF se copia con un clic, sin abrir la fila. *@
                        <span class="celda-identidad-empresa">
                            <button type="button" class="enlace-nombre-fila celda-empresa nombre-abre-vista-rapida"
                                    aria-label="@Textos["AbrirVistaRapidaDe", empresa.RazonSocial]"
                                    @onclick="() => AbrirVistaRapidaAsync(empresa.Id)" @onclick:stopPropagation="true">
                                @empresa.RazonSocial
                            </button>
                            <span class="tarjeta-fila-acordeon-meta celda-empresa">
                                @if (string.IsNullOrWhiteSpace(empresa.Cif))
                                {
                                    @("—")
                                }
                                else
                                {
                                    <BotonCopiar EnLinea="true" Valor="@empresa.Cif" Texto="@empresa.Cif" Etiqueta="@Textos["EtiquetaCif"]"
                                                 NombreAccesible="@Textos["CopiarCif", empresa.Cif]" />
                                }
                            </span>
                        </span>
                        @* La fila no nombra ni cuenta Clientes empresariales (decisión del propietario, 2026-10-08:
                           sin columna «Presta servicio a»): solo los enseña el desplegable del chevron, que los pide
                           con alcance de gestión. *@
                        @* Cumplimiento antes que Documentación, en el orden del mockup. Cada
                           celda va envuelta para que la rejilla tenga SIEMPRE el mismo número
                           de columnas: un componente que no se pinta desalinearía la fila
                           respecto a la cabecera. *@
                        <span>
                            <AnilloCumplimiento Porcentaje="empresa.CumplimientoPorcentaje" Tamano="TamanoAnillo.Pequeno"
                                                 Etiqueta="@EtiquetaCumplimiento(empresa.CumplimientoPorcentaje)" />
                        </span>
                        <span>
                            <EstadoFila Tono="EstadoDocumentoUi.TonoDocumental(empresa.EstadoDocumental)"
                                        Texto="@EstadoDocumentoUi.TextoDocumental(empresa.EstadoDocumental)"
                                        Correcto="EstadoDocumentoUi.EsCorrecto(empresa.EstadoDocumental)"
                                        Titulo="@TituloEstadoDocumental(empresa.EstadoDocumental)" />
                        </span>
                        <span>
                            @if (empresa.DeteccionesPendientes > 0)
                            {
                                <button type="button" class="badge-deteccion"
                                        @onclick='() => NavigationManager.NavigateTo($"/empresas/{empresa.Id}/deteccion-trabajadores")'
                                        @onclick:stopPropagation="true">
                                    <Icono Nombre="ia" Tamano="TamanoIcono.Pequeno" />
                                    @(empresa.DeteccionesPendientes == 1 ? "1 detección" : $"{empresa.DeteccionesPendientes} detecciones")
                                </button>
                            }
                            else
                            {
                                <span class="celda-sin-deteccion">—</span>
                            }
                        </span>
                        @* Sin menú «⋯» (patrón de listados). Lo que hacía ese menú:
                           «Vista rápida» es el clic en la fila; «Abrir Empresa 360», este icono;
                           «Detección de trabajadores», la pastilla de la columna Detecciones (misma
                           condición: solo con detecciones pendientes); «Eliminar», la selección
                           múltiple (☑ de la cabecera o tecla «x»). *@
                        <div class="tarjeta-fila-acordeon-acciones">
                            <Boton360 Nombre="@empresa.RazonSocial" Href="@($"/empresas/{empresa.Id}")" />
                        </div>
                    </div>
                    @if (expandido)
                    {
                        @* La fila desplegada son los Clientes empresariales de las
                           Relaciones Empresariales vigentes en las que esta Empresa es
                           la proveedora: un rol de la relación, no un tipo de la
                           Empresa. Su rótulo, su vacío y su error son los de la pestaña
                           «Clientes» de Empresa 360 (TextosEmpresas):
                           neutros, sin recuento y sin «presta servicio a» (decisión del
                           propietario, 2026-10-08). *@
                        <div class="tarjeta-fila-acordeon-contenido">
                            @{ var clientes = _clientesPorEmpresa.GetValueOrDefault(empresa.Id); }
                            @if (clientes is null)
                            {
                                <EstadoCargando Filas="2" />
                            }
                            else if (_clientesConError.Contains(empresa.Id))
                            {
                                @* Antes un fallo se pintaba como «no tiene ningún
                                   Cliente asociado»: calma donde lo cierto es que no
                                   sabemos nada. *@
                                <p class="texto-vacio-seccion" role="alert">@Textos["ErrorClientes"]</p>
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => ReintentarClientesAsync(empresa.Id)">
                                    Reintentar
                                </Boton>
                            }
                            else if (clientes.Count == 0)
                            {
                                @* ObtenerClientesDeEmpresaQuery devuelve vacío también sin alcance de gestión:
                                   el texto es cierto en los dos casos y no revela cuál (#810). *@
                                <p class="texto-vacio-seccion">@Textos["VacioClientesDescripcion"]</p>
                            }
                            else
                            {
                                <span class="titulo-clientes-empresa">@Textos["PestanaClientes"]</span>
                                <ul class="workspace-lista-entidades">
                                    @foreach (var cliente in clientes)
                                    {
                                        <FilaEntidadRelacionada
                                            @key="cliente.Id"
                                            Titulo="@cliente.RazonSocial"
                                            Subtitulo="@cliente.Cif"
                                            OnClic="() => IrAlCliente(cliente.Id, cliente.RazonSocial)" />
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        </div>

        @* Solo con más de una página al tamaño mínimo (20), o si ya se eligió un tamaño mayor:
           sin él no habría forma de volver al tamaño de antes. Mismo criterio que Clientes. *@
        @if (MostrarPaginador)
        {
            <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="empresa(s)" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        }
        <LeyendaAtajosLista />
    }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nueva empresa"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 AlDescartarPorNavegacion="CerrarDrawerDescartando"
                 TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <ChildContent>
        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" OnBlur="ValidarRazonSocialAsync" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.RazonSocial))" />
        <CampoTexto Etiqueta="Identificación fiscal" Placeholder="CIF, DNI o NIE" Valor="@_cif" ValorChanged="v => _cif = v" OnBlur="ValidarCifAsync" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.Cif))" />
        <CampoTexto Etiqueta="CNAE" Placeholder="p. ej. 4321" Valor="@_cnae" ValorChanged="v => _cnae = v" OnBlur="ValidarCnaeAsync" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.Cnae))" />
        <CampoTexto Etiqueta="Convenio aplicable" Valor="@_convenioAplicable" ValorChanged="v => _convenioAplicable = v" OnBlur="ValidarConvenioAplicableAsync" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.ConvenioAplicable))" />

        <label class="campo-checkbox">
            <input type="checkbox" @bind="_esActividadAnexoI" /> Actividad del Anexo I del RSP
        </label>

        <SelectorMultiple Etiqueta="Clientes con los que trabaja"
                           Elementos="@_clientesDisponiblesSelector"
                           Seleccionados="@_clienteIdsSeleccionados"
                           OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay Clientes creados." />
    </ChildContent>
    <PieExtra>
        <Boton Variante="VarianteBoton.Secundario" Cargando="_guardando" OnClick="GuardarYCrearCentroAsync">
            Continuar con el centro
        </Boton>
    </PieExtra>
</DrawerFormulario>

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} empresa(s)?")"
    Mensaje="Se ocultarán de las listas activas. Podrás deshacerlo desde el aviso que aparecerá; después, solo un Administrador del Tenant puede recuperarlas desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
</LimiteDeErrores>

