@page "/empresas"
@rendermode InteractiveServer
@using CaeManager.Application.Empresas.Commands.CrearEmpresa
@using CaeManager.Application.Empresas.Commands.EditarEmpresa
@using CaeManager.Application.Empresas.Commands.EliminarEmpresa
@using CaeManager.Application.Empresas.Commands.EliminarEmpresas
@using CaeManager.Application.Empresas.Commands.GuardarCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerCredencialAccesoEmpresa
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresaPorId
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresas
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject ICurrentUserService CurrentUserService

<PageTitle>Empresas — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Empresas</h1>
        <Boton OnClick="AbrirCrear">+ Nueva empresa</Boton>
    </div>

    <div class="barra-filtros">
        <CampoTexto Placeholder="Buscar por razón social…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <FiltroEstado Etiqueta="Documentación" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                      Opciones="EstadoDocumentoUi.OpcionesDocumentales" />
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las empresas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="RecargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple" />

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="EmpresaListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Razón social" Sortable="true" SortBy="@(GridSort<EmpresaListaDto>.ByAscending(e => e.RazonSocial))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Empresa, context.Id, context.RazonSocial, "informacion")'>
                        @context.RazonSocial
                    </button>
                </TemplateColumn>
                <PropertyColumn Property="@(e => e.Cif)" Title="CIF" Sortable="true" />
                <TemplateColumn Title="Documentación" Sortable="true" SortBy="@(GridSort<EmpresaListaDto>.ByAscending(e => e.EstadoDocumental))">
                    <Badge Tono="EstadoDocumentoUi.TonoDocumental(context.EstadoDocumental)">
                        @EstadoDocumentoUi.TextoDocumental(context.EstadoDocumental)
                    </Badge>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" Align="Align.End">
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Empresa, context.Id, context.RazonSocial, "informacion")'>
                        Detalles
                    </Boton>
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEliminar(context.Id, context.RazonSocial)">
                        Eliminar
                    </Boton>
                </TemplateColumn>
            </QuickGrid>

            <div class="paginador">
                <Paginator State="_paginacion" />
            </div>
        </div>

        @if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="Aún no hay empresas" Descripcion="Crea la primera para poder dar de alta trabajadores.">
                <Accion>
                    <Boton OnClick="AbrirCrear">+ Nueva empresa</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="Nueva empresa" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="Razón social" Valor="@_razonSocial" ValorChanged="v => _razonSocial = v" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.RazonSocial))" />
        <CampoTexto Etiqueta="CIF" Valor="@_cif" ValorChanged="v => _cif = v" MensajeError="@ObtenerError(nameof(CrearEmpresaCommand.Cif))" />

        <SelectorMultiple Etiqueta="Clientes con los que trabaja"
                           Elementos="@_clientesDisponiblesSelector"
                           Seleccionados="@_clienteIdsSeleccionados"
                           OnAlternar="args => AlternarCliente(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay clientes creados." />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Variante="VarianteBoton.Secundario" Cargando="_guardando" OnClick="GuardarYCrearCentroAsync">
            Continuar con el centro
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar a {_razonSocialAEliminar}?")"
    Mensaje="Se ocultará de las listas activas. Podrás deshacerlo desde el aviso que aparecerá."
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} empresa(s)?")"
    Mensaje="Se ocultarán de las listas activas. Podrás recuperarlas desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
