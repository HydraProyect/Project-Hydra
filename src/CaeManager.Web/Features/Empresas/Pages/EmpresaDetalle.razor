@*
    Empresa 360 — página (mockup «Empresa 360 página TALVEG»). Ver el
    comentario de cabecera del .razor.cs: mismas consultas y alcance que
    EmpresaWorkspacePanel, y cómo se cuentan los trabajadores por estado.
*@
@page "/empresas/{EmpresaId:guid}"
@* Sin prerender (como Mi trabajo, M-23): la carga de la ficha corre en OnParametersSetAsync y no persiste su
   estado; con prerender corría dos veces en cada visita. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Services
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Empresas.Components
@using CaeManager.Web.Features.Empresas.Recursos
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosEmpresas> Textos
@inject IStringLocalizer<TextosComunes> Comunes

<LimiteDeErrores Pagina="this">
<PageTitle>@(_detalle?.RazonSocial ?? Textos["TituloPestanaNavegador"]) — @Marca.Nombre</PageTitle>
<TituloDePaginaSinPrerender Titulo="@($"{_detalle?.RazonSocial ?? Textos["TituloPestanaNavegador"]} — {Marca.Nombre}")" />

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["EtiquetaMigas"]" />

    @if (_noEncontrada)
    {
        <FichaNoEncontrada RutaLista="/empresas" />
    }
    else if (_error)
    {
        <EstadoVacio Titulo="@Textos["ErrorTitulo"]" Descripcion="@Textos["ErrorDescripcion"]"
                     NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Textos["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="5" />
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera de identidad en tarjeta: anillo a la izquierda,
            identidad y recuentos en la línea de datos. Las incidencias se
            consultan en los chips de la pestaña Trabajadores.
        *@
        <CabeceraIdentidad Titulo="@_detalle.RazonSocial" Kicker="@Textos["Kicker"]">
            <Anillo>
                <AnilloCumplimiento Porcentaje="_cumplimiento" Tamano="TamanoAnillo.Cabecera"
                                    Etiqueta="@(_cumplimiento is { } p ? Textos["AnilloEtiqueta", p] : Textos["AnilloSinDato"])" />
            </Anillo>
            <Datos>
                @if (!string.IsNullOrWhiteSpace(_detalle.Cif))
                {
                    @* «CIF» + valor en 14/600 + icono de copiar (.cif-copiable de «Empresa 360»): el dato es el botón. *@
                    <span class="empresa360-meta-cif">
                        <span>@Textos["MetaCif"]</span>
                        <BotonCopiar EnLinea="true" ConIcono="true" ConfirmarConIcono="false" Valor="@_detalle.Cif" Texto="@_detalle.Cif"
                                     Etiqueta="@Textos["CopiarElCif"]" NombreAccesible="@Textos["CopiarCif", _detalle.Cif]" />
                    </span>
                    @if (_clientes is { Count: > 0 } || _recuentos is not null || _filaDelListado is not null)
                    {
                        <span aria-hidden="true">·</span>
                    }
                }
                @* Los Clientes empresariales se cuentan con ObtenerClientesDeEmpresaQuery, que
                   aplica el alcance de gestión, igual que la pestaña. EmpresaDetalleDto.ClienteIds
                   no está acotado: contarlo anunciaría una cartera que el actor no puede ver.
                   Una lista vacía no se cuenta: sin alcance de gestión el handler devuelve
                   vacío a propósito, y «0 clientes» sería falso para quien no puede ver la
                   cartera (Codex, #810). *@
                @if (_clientes is { Count: > 0 } clientesMeta)
                {
                    <span>@Plural(clientesMeta.Count, "MetaClientesUno", "MetaClientesVarios")</span>
                }
                @if (_recuentos is { } recuentosMeta)
                {
                    @if (_clientes is { Count: > 0 })
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <span>@Plural(recuentosMeta.Total, "MetaTrabajadoresUno", "MetaTrabajadoresVarios")</span>
                }
                @* Chip de estado documental de la maqueta (junto al CIF): el de la fila de esta Empresa en /empresas. Misma consulta, mismo
                   rótulo y mismo tono que la lista (un Vencido que ningún Centro marca obligatorio sigue siendo aviso, no rojo). *@
                @if (_filaDelListado is { } filaEstado)
                {
                    @if (_clientes is { Count: > 0 } || _recuentos is not null)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    @* Como en la lista: lo correcto se dice en texto sin pastilla de color; el color queda para lo que hay que atender. *@
                    @if (EstadoDocumentoUi.EsCorrecto(filaEstado.EstadoDocumental))
                    {
                        <span>@EstadoDocumentoUi.TextoDocumental(filaEstado.EstadoDocumental)</span>
                    }
                    else
                    {
                        <Badge Tono="EstadoDocumentoUi.TonoDocumental(filaEstado.EstadoDocumental, filaEstado.VencidoSinBloqueo)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.TextoDocumental(filaEstado.EstadoDocumental)</Badge>
                    }
                }
            </Datos>
            <Acciones>
                @* «Preparar paquete» (maqueta, primera acción de la cabecera): el zip sale de TALVEG, así que solo con un rol que escribe,
                   la misma lista blanca que aplica DescargarPaqueteEmpresaQuery. *@
                <SoloConEscritura>
                    <BotonPaqueteEmpresa EmpresaId="_detalle.Id" RazonSocial="@_detalle.RazonSocial" />
                </SoloConEscritura>
                <Boton Variante="VarianteBoton.Secundario" class="empresa360-accion-cabecera" Href="@($"/empresas/{_detalle.Id}/deteccion-trabajadores")">@Textos["AccionDetectar"]</Boton>
                <Boton Variante="VarianteBoton.Secundario" class="empresa360-accion-cabecera" Href="@($"/empresas/{_detalle.Id}/reclamar-acceso")">@Textos["AccionReclamarAcceso"]</Boton>
                <SoloConEscritura>
                    <Boton Variante="VarianteBoton.Primario" OnClick="SubirDocumentoAsync">@Textos["AccionSubirDocumento"]</Boton>
                </SoloConEscritura>
                @* El único ítem del menú es de escritura: sin escritura no hay menú. *@
                <SoloConEscritura>
                    <MenuAcciones ConBorde="true" EtiquetaAccesible="@Textos["MenuMasAcciones"]">
                        <ItemMenuAccion OnClick="AbrirInformacion">@Textos["AccionEditarEmpresa"]</ItemMenuAccion>
                    </MenuAcciones>
                </SoloConEscritura>
            </Acciones>
        </CabeceraIdentidad>

        @* «Subir documento» de la cabecera: el alta del drawer con la Empresa ya elegida. *@
        <DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral"]">
            <ChildContent>
                <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestana" PestanaActivaChanged="CambiarPestanaAsync" EtiquetaGrupo="@Textos["EtiquetaGrupoPestanas"]" Pagina360="true">
                    @switch (_pestana)
                    {
                        case PestanaVigencia:
                            <PestanaVigenciaEmpresa EmpresaId="_detalle.Id" />
                            break;
                        case PestanaPlataformas:
                            <PestanaPlataformasEmpresa EmpresaId="_detalle.Id" IncidenciasCargadas="n => _incidenciasPlataformas = n" />
                            break;
                        case PestanaClientes:
                            @PestanaDeClientes
                            break;
                        case PestanaDocumentacion:
                            <PestanaDocumentacion Ambito="AmbitoAplicacion.Empresa" PropietarioId="_detalle.Id" EnPagina="true" ConFiltros="true" ConVerDocumento="true"
                                                      PlaceholderBuscador="@Textos["BuscadorDocumentos"]" EtiquetaFiltros="@Textos["EtiquetaFiltrosDocumentacion"]"
                                                      TextoSinResultados="@Textos["NingunDocumentoConFiltro"]" />
                            break;
                        case PestanaReclamar:
                            <PestanaReclamarEmpresa EmpresaId="_detalle.Id" />
                            break;
                        case PestanaAgenda:
                            <PestanaAgendaContactos Tipo="TipoPropietarioAgenda.Empresa" PropietarioId="_detalle.Id" />
                            break;
                        case PestanaFicha:
                            <CajasFicha Cajas="CajasDeFicha" />
                            @* «Sello» ya no es pestaña ni caja del flujo: la maqueta lo pone como sección propia bajo las cajas. *@
                            @if (HayCajaSello)
                            {
                                <section class="empresa360-seccion empresa360-sello" data-pieza="sello-empresa">
                                    <h2 class="empresa360-sello-titulo">@Textos["PestanaSello"]</h2>
                                    <p class="empresa360-apoyo">@Textos["SelloApoyo"]</p>
                                    <Tarjeta>
                                        <PestanaSelloEmpresa EntidadId="_detalle.Id" />
                                    </Tarjeta>
                                </section>
                            }
                            break;
                        case PestanaHistorial:
                            <PestanaHistorial EntidadTipo="Empresa" EntidadId="_detalle.Id" />
                            break;
                        default:
                            @PestanaDeTrabajadores
                            break;
                    }
                </Pestanas>
            </ChildContent>
            <Lateral>
                <Tarjeta Titulo="@Textos["TarjetaInformacion"]" Compacta="true">
                    <AccionesHeader>
                        <SoloConEscritura>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirInformacion">@Textos["EditarFlecha"]</Boton>
                        </SoloConEscritura>
                    </AccionesHeader>
                    <ChildContent>
                        @* Orden y anchos de la maqueta: identificación fiscal, CNAE y convenio a ancho completo; alta y Anexo I, a media rejilla. *@
                        <RejillaDatos>
                            @* Solo lo que se tiene: un campo opcional sin valor no se pinta (ni como «—»). *@
                            @if (!string.IsNullOrWhiteSpace(_detalle.Cif))
                            {
                                <DatoRejilla Etiqueta="@Textos["DatoIdentificacionFiscal"]" Ancho="true">
                                    <BotonCopiar EnLinea="true" ConIcono="true" Valor="@_detalle.Cif" Texto="@_detalle.Cif" Etiqueta="@Textos["CopiarElCif"]" NombreAccesible="@Textos["CopiarCif", _detalle.Cif]" />
                                </DatoRejilla>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.Cnae))
                            {
                                <DatoRejilla Etiqueta="@Textos["DatoCnae"]" Valor="@_detalle.Cnae" Ancho="true" />
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.ConvenioAplicable))
                            {
                                <DatoRejilla Etiqueta="@Textos["DatoConvenio"]" Valor="@_detalle.ConvenioAplicable" Ancho="true" />
                            }
                            <DatoRejilla Etiqueta="@Textos["DatoAlta"]" Valor="@_detalle.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")" />
                            <DatoRejilla Etiqueta="@Textos["DatoAnexoI"]" Valor="@(_detalle.EsActividadAnexoI ? Textos["Si"] : Textos["No"])" />
                        </RejillaDatos>
                    </ChildContent>
                </Tarjeta>

                @if (_contactoPrincipal is { } contactoPrincipal)
                {
                    <Tarjeta Titulo="@Textos["TarjetaSePideDocumentacion"]" Compacta="true">
                        <AccionesHeader>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="IrAAgendaAsync">@Textos["IrAAgendaFlecha"]</Boton>
                        </AccionesHeader>
                        <ChildContent>
                            <div class="empresa360-contacto">
                                <div class="empresa360-contacto-identidad">
                                    <span class="empresa360-contacto-iniciales" aria-hidden="true">@Iniciales(contactoPrincipal.Nombre)</span>
                                    <span class="empresa360-contacto-texto">
                                        <b>@contactoPrincipal.Nombre</b>
                                        <span class="empresa360-apoyo">@(string.IsNullOrWhiteSpace(contactoPrincipal.Cargo) ? Textos["ContactoPrincipal"] : $"{contactoPrincipal.Cargo} · {Textos["ContactoPrincipal"].Value.ToLowerInvariant()}")</span>
                                    </span>
                                </div>
                                @* Correo y teléfono como filas-botón de 36 px con el icono de copiar a la derecha (maqueta «Empresa 360»). *@
                                <div class="empresa360-contacto-filas">
                                    <BotonCopiar EnLinea="true" ConIcono="true" Valor="@contactoPrincipal.Email" Texto="@contactoPrincipal.Email"
                                                 Etiqueta="@Textos["CopiarCorreoContacto"]" NombreAccesible="@($"{Textos["CopiarCorreoContacto"]} {contactoPrincipal.Email}")" />
                                    @if (!string.IsNullOrWhiteSpace(contactoPrincipal.Telefono))
                                    {
                                        <BotonCopiar EnLinea="true" ConIcono="true" Valor="@contactoPrincipal.Telefono" Texto="@contactoPrincipal.Telefono"
                                                     Etiqueta="@Textos["CopiarTelefonoContacto"]" NombreAccesible="@($"{Textos["CopiarTelefonoContacto"]} {contactoPrincipal.Telefono}")" />
                                    }
                                </div>
                                <p class="empresa360-apoyo empresa360-contacto-pie">@Textos["TarjetaSePideDocumentacionPie"]</p>
                            </div>
                        </ChildContent>
                    </Tarjeta>
                }
                @* Una sola nota por Empresa (Empresa.Notas), la misma que en Cliente 360 y Subcontrata 360. Quién la
                   ve lo decide el servidor (ObtenerEmpresaPorIdQuery): al usuario de Cliente, que también lee esta
                   ficha, le llega NotaInternaVisible = false y la tarjeta no existe, ni siquiera vacía. *@
                @if (_detalle.NotaInternaVisible)
                {
                    <NotaInterna Texto="@_detalle.Notas">
                        <Acciones>
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirEditorNota">@Textos["EditarFlecha"]</Boton>
                            </SoloConEscritura>
                        </Acciones>
                    </NotaInterna>
                }
            </Lateral>
        </CuerpoConLateral>

        <SoloConEscritura>
            <EditarFichaEmpresaDrawer @key="EmpresaId" EmpresaId="EmpresaId" Visible="_editorFichaVisible"
                VisibleChanged="v => _editorFichaVisible = v" OnGuardada="FichaGuardadaAsync" />
        </SoloConEscritura>

        @* Editor de la nota interna: solo se abre desde «Editar →» de su tarjeta, que ya está tras SoloConEscritura. *@
        <DrawerFormulario Visible="_editorNotaVisible" VisibleChanged="CambiarVisibilidadEditorNota" Titulo="@Comunes["NotaInternaTitulo"]"
                          HayCambios="() => HayCambiosEnLaNota" Guardando="_guardandoNota" MensajeError="@_mensajeErrorNota"
                          HayErroresDeCampo="@(_errorCampoNota is not null)" OnGuardar="GuardarNotaAsync"
                          TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
            <CampoTextarea Etiqueta="@Comunes["NotaInternaTitulo"]" Valor="@_notaEnEdicion" ValorChanged="v => _notaEnEdicion = v"
                           Filas="8" MensajeError="@_errorCampoNota" />
            <p class="empresa360-apoyo">@Comunes["NotaInternaNoLaVeCliente"]</p>
        </DrawerFormulario>
    }
</div>
</LimiteDeErrores>

@code {
    private IReadOnlyList<CajaFicha> CajasDeFicha =>
    [
        .. HayCajaAcceso ? new[] { new CajaFicha("acceso", CajaDeAcceso) } : [],
        .. _detalle?.FichaVisible == true ? new[] { new CajaFicha("firma-documentos", CajaFirmaDocumentos), new CajaFicha("prevencion", CajaPrevencion), new CajaFicha("mutua", CajaMutua), new CajaFicha("formacion", CajaFormacion) } : [],
        new CajaFicha("catalogo-trabajadores", CajaDeCatalogoTrabajadores)
    ];

    // Catálogo de delegaciones y oficios de la Empresa (decisión de Chris, 2026-10-18). No cuenta en HayCajasDeFicha: quien ve la
    // pestaña Ficha lo ve; no es motivo para que la pestaña exista.
    private RenderFragment CajaDeCatalogoTrabajadores => __builder =>
    {
        <CatalogoTrabajadoresEmpresaCaja EmpresaId="_detalle!.Id" />
    };

    private RenderFragment AccionEditarFicha => @<SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _editorFichaVisible = true">@Textos["FichaEditarEnlace"]</Boton></SoloConEscritura>;

    private RenderFragment CajaFirmaDocumentos => __builder =>
    {
        if (_detalle is { FichaVisible: true } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaFirmaDocumentos"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaCanalFirma"]" Valor="@(detalle.CanalFirmaDocumentos == CaeManager.Domain.Empresas.Empresa.CanalFirmaPorCorreo ? Textos["FichaPorCorreo"].Value : detalle.CanalFirmaDocumentos)" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaFirmante"]" Valor="@detalle.FirmanteDocumentos" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaCustodiaSello"]" Valor="@(detalle.SelloCustodiadoPorOperadorCae is { } custodia ? Textos[custodia ? "FichaSi" : "FichaNo"].Value : null)" Ancho="true" />
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaPrevencion => __builder =>
    {
        if (_detalle is { FichaVisible: true } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaPrevencion"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaModalidadPreventiva"]" Valor="@detalle.ModalidadOrganizacionPreventiva" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaOrganizacionSpa"]" Valor="@detalle.OrganizacionSpa" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaContactoSpaNombre"]" Valor="@detalle.ContactoSpaNombre" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaContactoSpaCorreo"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.ContactoSpaCorreo))
                            {
                                <BotonCopiar Valor="@detalle.ContactoSpaCorreo" Texto="@detalle.ContactoSpaCorreo" Etiqueta="@Textos["FichaCopiarCorreoSpa"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarCorreoSpa"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaContactoSpaTelefono"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.ContactoSpaTelefono))
                            {
                                <BotonCopiar Valor="@detalle.ContactoSpaTelefono" Texto="@detalle.ContactoSpaTelefono" Etiqueta="@Textos["FichaCopiarTelefonoSpa"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarTelefonoSpa"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrlNombre"]" Valor="@detalle.TecnicoPrlNombre" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrlCorreo"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.TecnicoPrlCorreo))
                            {
                                <BotonCopiar Valor="@detalle.TecnicoPrlCorreo" Texto="@detalle.TecnicoPrlCorreo" Etiqueta="@Textos["FichaCopiarCorreoTecnicoPrl"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarCorreoTecnicoPrl"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaTecnicoPrlTelefono"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.TecnicoPrlTelefono))
                            {
                                <BotonCopiar Valor="@detalle.TecnicoPrlTelefono" Texto="@detalle.TecnicoPrlTelefono" Etiqueta="@Textos["FichaCopiarTelefonoTecnicoPrl"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarTelefonoTecnicoPrl"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                    </RejillaDatos>
                    <p class="texto-descriptivo">@Textos["FichaNotaTecnico"]</p>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaMutua => __builder =>
    {
        if (_detalle is { FichaVisible: true } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaMutua"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaMutuaNombre"]" Valor="@detalle.Mutua" Ancho="true" />
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaFormacion => __builder =>
    {
        if (_detalle is { FichaVisible: true } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaFormacion"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaContactoFormacionNombre"]" Valor="@detalle.ContactoFormacionNombre" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaContactoFormacionCorreo"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.ContactoFormacionCorreo))
                            {
                                <BotonCopiar Valor="@detalle.ContactoFormacionCorreo" Texto="@detalle.ContactoFormacionCorreo" Etiqueta="@Textos["FichaCopiarCorreoFormacion"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarCorreoFormacion"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaContactoFormacionTelefono"]" Ancho="true">
                            @if (!string.IsNullOrWhiteSpace(detalle.ContactoFormacionTelefono))
                            {
                                <BotonCopiar Valor="@detalle.ContactoFormacionTelefono" Texto="@detalle.ContactoFormacionTelefono" Etiqueta="@Textos["FichaCopiarTelefonoFormacion"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarTelefonoFormacion"]]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaDeAcceso => __builder =>
    {
        <Tarjeta Titulo="@Textos["TarjetaCarpeta"]">
            @if (_errorAcceso)
            {
                <p class="texto-vacio-seccion">@Textos["ErrorAcceso"]</p>
            }
            else if (_accesoRequiereDosFactores)
            {
                <p class="texto-vacio-seccion acceso-requiere-2fa">
                    @Textos["AccesoRequiereDosFactores"]
                    <a href="@SegundoFactorParaCredenciales.RutaConfigurarVolviendoA(SegundoFactorParaCredenciales.RutaActual(NavigationManager))" data-enhance-nav="false">@Textos["ActivarDosFactores"]</a>
                </p>
            }
            else if (UrlPortalCae.Normalizar(_credencial?.UrlAcceso) is { } destino)
            {
                <Boton Variante="VarianteBoton.Secundario" Href="@destino" target="_blank" rel="noopener noreferrer">@Textos["AbrirCarpeta"]</Boton>
            }
        </Tarjeta>
    };

    private RenderFragment PestanaDeTrabajadores => __builder =>
    {
        <section class="empresa360-seccion">
            @if (_cargandoTrabajadores)
            {
                <EstadoCargando Filas="5" />
            }
            else if (_errorTrabajadores || _recuentos is null)
            {
                <EstadoVacio Titulo="@Textos["ErrorTrabajadores"]" Descripcion="@Textos["ErrorSeccionDescripcion"]">
                    <Accion>
                        <Boton Variante="VarianteBoton.Primario" OnClick="CargarTrabajadoresAsync">@Textos["Reintentar"]</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else if (_recuentos.Total == 0)
            {
                <EstadoVacio Titulo="@Textos["VacioTrabajadoresTitulo"]" Descripcion="@Textos["VacioTrabajadoresDescripcion"]" />
            }
            else
            {
                var r = _recuentosLista ?? _recuentos;
                @* Barra de la maqueta (.barra-lista): los chips a la izquierda y el buscador a la derecha, en una sola fila. *@
                <div class="empresa360-barra">
                    <div class="empresa360-chips" role="group" aria-label="@Textos["EtiquetaFiltros"]">
                        @Chip(FiltroTrabajadores.Todos, Textos["ChipTodos", r.Total])
                        @Chip(FiltroTrabajadores.SinDocumentacionValida, Textos["ChipSinValida", r.SinDocumentacionValida])
                        @Chip(FiltroTrabajadores.PorVencer, Textos["ChipPorVencer", r.PorVencer])
                        @Chip(FiltroTrabajadores.AlDia, Textos["ChipAlDia", r.AlDia])
                    </div>
                    <BuscadorLista Placeholder="@Textos["BuscadorTrabajadores"]" Valor="@_busqueda" ValorChanged="BuscarAsync" />
                </div>
                @* Delegación, Oficio y «Agrupar»: solo si la Empresa tiene catálogo, o si hay una agrupación activa (que así
                   siempre se puede quitar). Las opciones son las de ESTA Empresa. *@
                @if (OfrecerPastillasDeCatalogo)
                {
                    <div class="empresa360-pastillas" role="group" aria-label="@Textos["EtiquetaFiltrosCatalogo"]">
                        @if (TieneDelegacionesEmpresa)
                        {
                            <PastillaFiltro Etiqueta="@Textos["EtiquetaDelegacionEmpresaFiltro"]" TextoTodos="@Textos["OpcionTodasLasDelegacionesEmpresa"]" Valor="@_delegacionId"
                                            ValorChanged="CambiarDelegacionEmpresaAsync" Opciones="OpcionesDelegacionEmpresa" />
                        }
                        @if (TieneOficios)
                        {
                            <PastillaFiltro Etiqueta="@Textos["EtiquetaOficioFiltro"]" TextoTodos="@Textos["OpcionTodosLosOficios"]" Valor="@_oficioId"
                                            ValorChanged="CambiarOficioAsync" Opciones="OpcionesOficio" />
                        }
                        <PastillaFiltro Etiqueta="@Textos["EtiquetaAgrupar"]" TextoTodos="@Textos["OpcionSinAgrupar"]" Valor="@_agrupar"
                                        ValorChanged="CambiarAgrupacionAsync" Opciones="OpcionesAgrupacion" Keytip="A" />
                    </div>
                }

                @if (TotalDelFiltro == 0)
                {
                    <p class="empresa360-vacio-filtrado">
                        @Textos["NingunoConFiltro"]
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace" OnClick="QuitarFiltrosAsync">@Textos["QuitarFiltros"]</Boton>
                    </p>
                }
                else
                {
                    @foreach (var (tituloGrupo, filasGrupo) in GruposDeFilas())
                    {
                    @if (tituloGrupo is not null)
                    {
                        <h3 class="empresa360-grupo" data-grupo="@tituloGrupo" data-agrupar="@_agrupar">@tituloGrupo<span class="empresa360-grupo-recuento"> · @filasGrupo.Count</span></h3>
                    }
                    <ListaRelaciones Etiqueta="@(tituloGrupo ?? Textos["ListaTrabajadores"])">
                        @foreach (var trabajador in filasGrupo)
                        {
                            <FilaRelacion @key="trabajador.Id" Nombre="@NombreCompleto(trabajador)" Href="@($"/trabajadores/{trabajador.Id}")"
                                          Iniciales="@Iniciales(NombreCompleto(trabajador))" OnAbrir360="() => AbrirTrabajador(trabajador)">
                                <Detalle>
                                    @if (string.IsNullOrWhiteSpace(trabajador.Dni))
                                    {
                                        <text>—</text>
                                    }
                                    else
                                    {
                                        <text>@Textos["PrefijoDni"] </text><BotonCopiar Valor="@trabajador.Dni" Texto="@trabajador.Dni" EnLinea="true"
                                                     Etiqueta="@Textos["ElDni"]" NombreAccesible="@Textos["CopiarDni", trabajador.Dni]" />
                                    }
                                </Detalle>
                                <Derecha>
                                    @* Cifra de la maqueta: documentos al día / documentos registrados del trabajador. *@
                                    @if (MotivoIncidenciasUi.RegistradosVigentes(trabajador.DocumentosVigentes, trabajador.DocumentosEsperados) is { } cifra)
                                    {
                                        <span class="empresa360-cifra-trabajador" aria-label="@MotivoIncidenciasUi.RegistradosVigentesAccesible(trabajador.DocumentosVigentes, trabajador.DocumentosEsperados)">@cifra</span>
                                    }
                                    <Badge Tono="EstadoDocumentoUi.TonoDocumental(trabajador.EstadoDocumental, trabajador.VencidoSinBloqueo)" Tamano="TamanoBadge.Pequeno">
                                        @EstadoDocumentoUi.TextoDocumental(trabajador.EstadoDocumental)
                                    </Badge>
                                </Derecha>
                            </FilaRelacion>
                        }
                    </ListaRelaciones>
                    }
                    <p class="empresa360-pie">
                        @Textos["PieMostrando", _filas.Count, TotalDelFiltro]
                    </p>
                    @if (TotalPaginas > 1)
                    {
                        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="TotalDelFiltro"
                                         Etiqueta="@Textos["PaginadorEtiqueta"]" PaginaActualChanged="CambiarPaginaAsync" />
                    }
                }
            }
        </section>
    };

    /// <summary>
    /// Chip de filtro. La aclaración (lo que el recuento no incluye) va en el <c>title</c>:
    /// es el único sitio donde el producto la dice ahora que la cabecera ya no pinta indicadores.
    /// </summary>
    private RenderFragment Chip(FiltroTrabajadores filtro, string texto, string? aclaracion = null) => __builder =>
    {
        <button type="button" class="empresa360-chip" aria-pressed="@(_filtro == filtro ? "true" : "false")"
                title="@aclaracion" @onclick="() => CambiarFiltroAsync(filtro)">@texto</button>
    };

    private RenderFragment PestanaDeClientes => __builder =>
    {
        <section class="empresa360-seccion">
            <p class="empresa360-apoyo empresa360-apoyo-pestana">@Textos["ClientesApoyo"]</p>
            @if (_errorClientes)
            {
                <EstadoVacio Titulo="@Textos["ErrorClientes"]" Descripcion="@Textos["ErrorSeccionDescripcion"]">
                    <Accion>
                        <Boton Variante="VarianteBoton.Primario" OnClick="CargarClientesAsync">@Textos["Reintentar"]</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else if (_clientes is null)
            {
                <EstadoCargando Filas="3" />
            }
            else if (_clientes.Count == 0)
            {
                <EstadoVacio Titulo="@Textos["VacioClientesTitulo"]" Descripcion="@Textos["VacioClientesDescripcion"]" />
            }
            else
            {
                <ListaRelaciones Etiqueta="@Textos["ListaClientes"]">
                    @foreach (var cliente in _clientes)
                    {
                        <FilaRelacion @key="cliente.Id" Nombre="@cliente.RazonSocial" Href="@($"/clientes/{cliente.Id}")"
                                      NombreIcono="clientes" OnAbrir360="() => AbrirCliente(cliente)">
                            <Detalle>@(string.IsNullOrWhiteSpace(cliente.Cif) ? "—" : cliente.Cif)</Detalle>
                        </FilaRelacion>
                    }
                </ListaRelaciones>
            }
        </section>
    };
}
