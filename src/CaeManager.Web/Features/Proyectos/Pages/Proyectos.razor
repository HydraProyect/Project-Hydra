@page "/proyectos"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Proyectos.Queries.ObtenerProyectoPorId
@using CaeManager.Application.Proyectos.Queries.ObtenerProyectos
@using CaeManager.Application.Proyectos.Queries.ObtenerTecnicosProyecto
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Proyectos.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosProyectos> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <CabeceraListado Titulo="@Textos["TituloPagina"]"
                     Contador="@(_resolviendoEmpresa || _sinEmpresaSeleccionada || _cargando || _errorCarga || _clienteSeleccionadoId == Guid.Empty || _cargandoProyectos || _errorProyectos ? null : (int?)ProyectosVisibles.Count)">
        <Primaria>
            @if (_clienteSeleccionadoId != Guid.Empty && !_cargando && !_errorCarga)
            {
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirNuevoProyecto">@Textos["BotonNuevoProyecto"]</Boton></SoloConEscritura>
            }
        </Primaria>
    </CabeceraListado>
    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           proyectos de los Clientes empresariales de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="proyectos" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion><Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Textos["BotonReintentar"]</Boton></Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="3" />
    }
    else
    {
        <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync"
                      PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                      HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                      FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                      OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar">
            <Pastillas>
                @* La opción vacía pide elegir un Cliente empresarial: nunca representa todos. *@
                <PastillaFiltro @key="_versionSelectorCliente" @ref="_selectorClienteEmpresarial" Etiqueta="@Textos["EtiquetaCliente"]"
                                Valor="@(_clienteSeleccionadoId == Guid.Empty ? string.Empty : _clienteSeleccionadoId.ToString())"
                                ValorChanged="OnClienteSeleccionadoAsync" Opciones="OpcionesClienteListado" OfrecerTodos="false" />
            </Pastillas>
            <Chips>
                @if (!string.IsNullOrWhiteSpace(_busqueda))
                {
                    <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["AriaQuitarBusqueda"]" OnQuitar="QuitarBusquedaAsync" />
                }
            </Chips>
        </BarraFiltros>
        <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                                   OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
        @if (_clienteSeleccionadoId != Guid.Empty && _proyectos.Count > 0)
        {
            @* Franja de estado: sustituye a la pastilla «Estado». Viaja en la URL como «estado» y cada botón dice
               cuántos Proyectos hay, con la búsqueda aplicada. Con los dos botones marcados se ven todos. *@
            <FranjaEstado Opciones="OpcionesEstado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                          Recuentos="RecuentosPorEstado" />
        }
        @if (_clienteSeleccionadoId == Guid.Empty)
        {
            @* CrearProyectoCommand exige un Cliente empresarial y un Centro vinculado
               a él: sin esa elección no se muestra la lista ni se ofrece el alta. *@
            <EstadoVacio NombreIcono="clientes" Titulo="@Textos["SinClienteTitulo"]"
                         Descripcion="@Textos["SinClienteDescripcion"]" />
        }
        else if (_cargandoProyectos)
        {
            <EstadoCargando Filas="4" />
        }
        else if (_errorProyectos)
        {
            <EstadoVacio NombreIcono="error-circulo" Titulo="@Textos["ErrorProyectosTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
                <Accion><Boton Variante="VarianteBoton.Primario" OnClick="CargarDatosClienteAsync">@Textos["BotonReintentar"]</Boton></Accion>
            </EstadoVacio>
        }
        else if (_proyectos.Count == 0)
        {
            @* Va ANTES que el vacío por filtro a propósito: la lista del cliente
               llega entera (ObtenerProyectosQuery no pagina) y los filtros se
               aplican en memoria, así que aquí la pantalla SÍ sabe que el
               cliente no tiene ninguno — con filtro o sin él. *@
            <EstadoVacio NombreIcono="proyectos" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion><SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirNuevoProyecto">@Textos["BotonNuevoProyecto"]</Boton></SoloConEscritura></Accion>
            </EstadoVacio>
        }
        else if (ProyectosVisibles.Count == 0 && HayFiltrosActivos)
        {
            @* Distinto de "Sin proyectos": ofrecer "crea el primero" a quien
               acaba de filtrar lo manda a duplicar una obra que ya existe. La
               copia puede afirmar que el cliente SÍ tiene proyectos porque la
               rama anterior ya descartó la lista vacía: el filtrado es en
               memoria sobre la lista completa del cliente. *@
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltroTitulo"]"
                         Descripcion="@Textos["VacioFiltroDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else
        {


            <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

            <div class="contenedor-tabla-proyectos">
                <table class="tabla-datos tabla-proyectos">
                    <thead>
                        <tr>
                            <th>@Textos["ListaProyecto"]</th>
                            <th>@Textos["ListaPlazo"]</th>
                            <th>@Textos["ColumnaTecnicos"]</th>
                            <th class="col-plazo-transcurrido">@Textos["ListaPlazoTranscurrido"]</th>
                            <th>@Textos["EtiquetaEstado"]</th>
                            <th class="col-acciones"><span class="texto-solo-lectores">@Textos["ColumnaAcciones"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proyecto in ProyectosVisibles)
                        {
                            @* Patrón de listados: la fila no lleva menú «⋯». Un clic en cualquier punto de la
                               fila abre la vista rápida (el panel lateral), igual que Enter sobre la fila
                               enfocada; los controles de dentro —nombre, recuento de técnicos, icono 360—
                               hacen lo suyo y no dejan subir el clic. *@
                            <tr class="@ClaseFila(proyecto)" @onclick="() => AbrirDetalleDesdeLaFilaAsync(proyecto.Id)">
                                <td>
                                    <span class="proyecto-nombre-centro">
                                        @* El nombre es el destino de teclado del clic en la fila (la fila no es focable con Tab). *@
                                        <button type="button" class="enlace-nombre-fila nombre-proyecto nombre-abre-vista-rapida"
                                                @onclick="() => AbrirDetalleConAvisoAsync(proyecto.Id)" @onclick:stopPropagation="true">@proyecto.Nombre</button>
                                        <span class="proyecto-centro">@proyecto.CentroNombre</span>
                                    </span>
                                </td>
                                <td class="celda-fecha-proyecto">
                                    <span class="proyecto-plazo">
                                        <span><span class="texto-solo-lectores">@Textos["EtiquetaInicio"]: </span>@proyecto.FechaInicio.ToString("dd/MM/yyyy")</span>
                                        @if (proyecto.FechaFinPrevista is { } fin)
                                        {
                                            <span aria-hidden="true">→</span>
                                            <span><span class="texto-solo-lectores">@Textos["EtiquetaFinPrevisto"]: </span>@fin.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="fin-indefinido">@Textos["ListaSinFechaFinPrevista"]</span>
                                        }
                                    </span>
                                </td>
                                <td class="celda-tecnicos-proyecto">
                                    @if (proyecto.TecnicosActivos.Count > 0)
                                    {
                                        @* El recuento esconde una lista: la ventana de contexto la enseña al pasar el
                                           cursor o al enfocarlo, y cada técnico abre el panel en la pestaña «Técnicos».
                                           Interactiva, la ventana corta su clic para el @onclick de la fila; del oyente «pulsarFila» la excluye atajos-lista.js. *@
                                        <VentanaContexto Etiqueta="@TextoTecnicosActivos(proyecto.TecnicosActivos.Count)"
                                                         Titulo="@Textos["VentanaTecnicosTitulo"]"
                                                         Colocacion="VentanaContextoColocacion.AbajoCentro"
                                                         Interactiva="true"
                                                         Pie="@Textos["VentanaTecnicosPie"]">
                                            <Disparador>@proyecto.TecnicosActivos.Count</Disparador>
                                            <Detalle>
                                                @foreach (var tecnico in proyecto.TecnicosActivos)
                                                {
                                                    <VentanaContextoElemento Ayuda="@Textos["VentanaTecnicoAyuda"]" AlPulsar="() => AbrirDetalleEnTecnicosAsync(proyecto.Id)">
                                                        @tecnico.NombreCompleto
                                                    </VentanaContextoElemento>
                                                }
                                            </Detalle>
                                        </VentanaContexto>
                                    }
                                    else
                                    {
                                        <span class="celda-sin-recuento">0</span>
                                    }
                                </td>
                                @* La barra ocupa el hueco del cumplimiento de los demás listados, en azul de
                                   marca: mide tiempo, no conformidad. Sin fin previsto no hay plazo que medir. *@
                                <td class="col-plazo-transcurrido">
                                    <BarraCumplimiento Porcentaje="PorcentajeDelPlazo(proyecto)" Marca="true"
                                                       Etiqueta="@EtiquetaPlazoTranscurrido(proyecto)" />
                                </td>
                                <td>
                                    @if (proyecto.EstaAbierto)
                                    {
                                        <EstadoFila Correcto="true" Texto="@Textos["BadgeAbierto"]" />
                                    }
                                    else
                                    {
                                        <EstadoFila Tono="TonoBadge.Neutro" Texto="@Textos["BadgeCerrado"]" />
                                    }
                                </td>
                                @* Dónde quedó cada acción del menú «⋯» que tenía la fila: «Detalles» es el clic en
                                   la fila; «Abrir página», este icono 360; «Cerrar proyecto», «Reabrir» y «Eliminar»,
                                   el pie del panel (Proyectos no tiene selección múltiple: D1, 2026-10-08). *@
                                <td class="col-acciones">
                                    <Boton360 Nombre="@proyecto.Nombre" Href="@($"/proyectos/{proyecto.Id}")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_proyectoSeleccionadoId is not null)
{
    @* Panel lateral de detalle, la vista rápida de la fila: sin scrim, la lista sigue
       usable detrás. Proyecto no es una EntidadWorkspace, así que el panel es de esta
       página y no del Context Workspace: aquí se edita (lápiz de la cabecera, tecla «e»),
       se cierra, se reabre y se elimina el proyecto. La página Proyecto 360 es el
       detalle completo; a ella lleva el icono 360 de la cabecera y el de la fila. *@
    <aside class="panel-proyecto" role="complementary" aria-label="@Textos["AriaPanelDetalle"]">
        <div class="cabecera-panel-proyecto">
            <div class="texto-cabecera-panel-proyecto">
                <span class="etiqueta-cabecera-panel-proyecto">@Textos["EtiquetaCabeceraPanel"]</span>
                <span class="nombre-cabecera-panel-proyecto">@(_detalle?.Nombre ?? (_cargandoDetalle ? Textos["Cargando"].Value : Textos["DetalleNoDisponible"].Value))</span>
                @if (_detalle is not null)
                {
                    <div class="meta-cabecera-panel-proyecto">
                        @if (_detalle.EstaAbierto)
                        {
                            <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">@Textos["BadgeAbierto"]</Badge>
                        }
                        else
                        {
                            <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno">@Textos["BadgeCerrado"]</Badge>
                        }
                        <span>@_detalle.CentroNombre · @TextoTecnicosActivos(_detalle.TecnicosActivos)</span>
                    </div>
                }
            </div>
            @if (_detalle is not null && !_cargandoDetalle)
            {
                @if (!_editandoInfo)
                {
                    @* El lápiz vive en la cabecera en todas las pestañas (patrón de listados: la fila no
                       lleva menú y editar se hace desde el panel, también con la tecla «e»). Desde otra
                       pestaña lleva primero a «Información», que es donde está el formulario. *@
                    <SoloConEscritura>
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="IniciarEdicionInfo"
                               aria-label="@Textos["AriaEditarProyecto"]" title="@Textos["TituloEditarConAtajo"]">
                            <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
                        </Boton>
                    </SoloConEscritura>
                }
                <Boton360 Nombre="@_detalle.Nombre" Href="@($"/proyectos/{_detalle.Id}")" />
            }
            <button type="button" class="cerrar-panel-proyecto" aria-label="@Textos["AriaCerrarPanel"]" @onclick="CerrarDetalleConAvisoAsync"><Icono Nombre="cerrar" /></button>
        </div>

        <div class="cuerpo-panel-proyecto">
            @if (_cargandoDetalle)
            {
                <EstadoCargando Filas="3" />
            }
            else if (_detalle is null)
            {
                <p class="aviso-error">@Textos["ErrorCargaDetalleProyecto"]</p>
            }
            else
            {
                <Pestanas Definiciones="PestanasDetalle" PestanaActiva="@_pestanaDetalle" PestanaActivaChanged="CambiarPestanaDetalleAsync" EtiquetaGrupo="@Textos["EtiquetaSecciones"]">
                    @if (_pestanaDetalle == "informacion")
                    {
                        @if (!_editandoInfo)
                        {
                            <div class="rejilla-info-proyecto">
                                <CampoInfo Etiqueta="@Textos["EtiquetaCliente"]" Valor="@_detalle.ClienteRazonSocial" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaCentro"]" Valor="@_detalle.CentroNombre" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaInicio"]" Valor="@_detalle.FechaInicio.ToString("dd/MM/yyyy")" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaFinPrevisto"]" Valor="@(_detalle.FechaFinPrevista?.ToString("dd/MM/yyyy") ?? Textos["FinIndefinido"].Value)" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaEstado"]" Valor="@(_detalle.EstaAbierto ? Textos["BadgeAbierto"].Value : Textos["EstadoCerradoConFecha", _detalle.FechaCierreReal!].Value)" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaTecnicosActivos"]" Valor="@_detalle.TecnicosActivos.ToString()" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaDocumentosGestionados"]" Valor="@_detalle.DocumentosGestionados.ToString()" />
                                <CampoInfo Etiqueta="@Textos["EtiquetaDiasAbiertos"]" Valor="@DiasAbiertos(_detalle.FechaInicio, _detalle.FechaCierreReal, Hoy)?.ToString()" />
                            </div>
                            <div class="notas-proyecto">
                                <span class="titulo-notas-proyecto">@Textos["EtiquetaNotas"]</span>
                                <p class="texto-notas-proyecto">@(string.IsNullOrWhiteSpace(_detalle.Notas) ? Textos["SinNotas"].Value : _detalle.Notas)</p>
                            </div>
                        }
                        else
                        {
                            @if (_editError is not null)
                            {
                                <p class="aviso-error">@_editError</p>
                            }
                            <div class="rejilla-formulario">
                                <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_editNombre" ValorChanged="v => _editNombre = v"
                                            MensajeError="@(_editErrores.GetValueOrDefault("Nombre"))" />
                                <CampoTexto Etiqueta="@Textos["EtiquetaFinPrevistoOpcional"]" Type="date" Valor="@_editFechaFinPrevista" ValorChanged="v => _editFechaFinPrevista = v" />
                                <CampoTexto Etiqueta="@Textos["EtiquetaNotas"]" Valor="@_editNotas" ValorChanged="v => _editNotas = v" />
                            </div>
                            <div class="acciones-formulario">
                                <Boton Variante="VarianteBoton.Primario" OnClick="GuardarEdicionInfoAsync" Cargando="_guardando">@Textos["BotonGuardar"]</Boton>
                                <Boton OnClick="CancelarEdicionInfo" Variante="VarianteBoton.Secundario">@Textos["BotonCancelar"]</Boton>
                            </div>
                        }
                    }
                    else if (_pestanaDetalle == "tecnicos")
                    {
                        @if (_cargandoTecnicos)
                        {
                            <EstadoCargando Filas="2" />
                        }
                        else if (_tecnicos.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["VacioTecnicosTitulo"]" Descripcion="@Textos["VacioTecnicosDescripcion"]" />
                        }
                        else
                        {
                            <ul class="lista-tecnicos-proyecto">
                                @foreach (var tecnico in _tecnicos)
                                {
                                    <li class="fila-tecnico-proyecto">
                                        <span class="datos-tecnico-proyecto">
                                            <span class="nombre-tecnico-proyecto">@tecnico.TrabajadorNombreCompleto</span>
                                            <span class="meta-tecnico-proyecto">@MetaTecnico(tecnico)</span>
                                        </span>
                                        @if (tecnico.EstaActivo)
                                        {
                                            <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">@Textos["BadgeActivo"]</Badge>
                                            <SoloConEscritura><button type="button" class="baja-tecnico-proyecto" @onclick="() => PedirDarDeBajaTecnico(tecnico)">@Textos["BotonDarDeBaja"]</button></SoloConEscritura>
                                        }
                                        else
                                        {
                                            <Badge Tono="TonoBadge.Neutro" Tamano="TamanoBadge.Pequeno">@Textos["BadgeDeBaja"]</Badge>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                        @if (_mostrarFormularioTecnico)
                        {
                            @if (_errorTecnico is not null)
                            {
                                <p class="aviso-error">@_errorTecnico</p>
                            }
                            <div class="rejilla-formulario">
                                <CampoSelect Etiqueta="@Textos["EtiquetaTecnico"]" Valor="@_nuevoTecnicoTrabajadorId" ValorChanged="v => _nuevoTecnicoTrabajadorId = v">
                                    <option value="">@Textos["OpcionElegirTecnico"]</option>
                                    @foreach (var trabajador in EtiquetasSelectorTrabajador.Construir(_trabajadoresDisponibles))
                                    {
                                        <option value="@trabajador.Id">@trabajador.Texto</option>
                                    }
                                </CampoSelect>
                                <CampoTexto Etiqueta="@Textos["EtiquetaFechaAlta"]" Type="date" Valor="@_nuevoTecnicoFechaAlta" ValorChanged="v => _nuevoTecnicoFechaAlta = v" />
                            </div>
                            <div class="acciones-formulario">
                                <Boton Variante="VarianteBoton.Primario" OnClick="AsignarTecnicoAsync" Cargando="_guardando">@Textos["BotonAsignar"]</Boton>
                                <Boton OnClick="() => _mostrarFormularioTecnico = false" Variante="VarianteBoton.Secundario">@Textos["BotonCancelar"]</Boton>
                            </div>
                        }
                        else
                        {
                            <SoloConEscritura>
                                <div class="acciones-seccion">
                                    <Boton OnClick="AbrirFormularioTecnicoAsync" Variante="VarianteBoton.Secundario">@Textos["BotonAsignarTecnico"]</Boton>
                                </div>
                            </SoloConEscritura>
                        }
                    }
                    else
                    {
                        <PestanaDocumentacion Ambito="AmbitoAplicacion.Proyecto" PropietarioId="_detalle.Id" />
                        <p class="texto-vacio-seccion">@Textos["AyudaAdjuntarDocumento"]</p>
                        <a class="enlace-documentos-proyecto" href="documentos?Ambito=Proyecto">@Textos["EnlaceIrADocumentos"]</a>
                    }
                </Pestanas>
            }
        </div>

        @if (_detalle is not null && !_cargandoDetalle && !_editandoInfo)
        {
            @* Cerrar, reabrir y eliminar son ICommand: AutorizacionEscrituraBehavior los deniega a
               Consulta, así que no se le ofrecen. «Editar» es el lápiz de la cabecera. *@
            <SoloConEscritura>
                <div class="pie-panel-proyecto">
                    @if (_detalle.EstaAbierto)
                    {
                        <Boton OnClick="() => AbrirCerrarConfirmAsync(_detalle.Id)" Variante="VarianteBoton.Secundario">@Textos["AccionCerrarProyecto"]</Boton>
                    }
                    else
                    {
                        <Boton OnClick="() => AbrirReabrirConfirmAsync(_detalle.Id)" Variante="VarianteBoton.Secundario">@Textos["AccionReabrirProyecto"]</Boton>
                    }
                    @* Proyectos no tiene selección múltiple: «Eliminar» vive en el pie del panel (D1, 2026-10-08). *@
                    <Boton OnClick="() => AbrirEliminarAsync(_detalle.Id, _detalle.Nombre)" Variante="VarianteBoton.Destructivo">@Textos["MenuEliminar"]</Boton>
                </div>
            </SoloConEscritura>
        }
    </aside>
}

<Drawer @ref="_drawerProyecto" HayCambios="() => HayCambiosEnElDrawer" Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerNuevoTitulo"]" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoSelect Etiqueta="@Textos["EtiquetaCentro"]" Valor="@_nuevoCentroId" ValorChanged="v => _nuevoCentroId = v">
            <option value="">@Textos["OpcionElegirCentro"]</option>
            @foreach (var centro in _centrosDisponibles)
            {
                <option value="@centro.Id">@centro.Nombre</option>
            }
        </CampoSelect>

        <CampoTexto Etiqueta="@Textos["EtiquetaNombreProyecto"]" Valor="@_nuevoNombre" ValorChanged="v => _nuevoNombre = v"
                    MensajeError="@(_erroresCampo.GetValueOrDefault("Nombre"))" />

        <CampoTexto Etiqueta="@Textos["EtiquetaFechaInicio"]" Type="date" Valor="@_nuevaFechaInicio" ValorChanged="v => _nuevaFechaInicio = v" />

        <CampoTexto Etiqueta="@Textos["EtiquetaFinPrevistoOpcionalAlta"]" Type="date" Valor="@_nuevaFechaFinPrevista" ValorChanged="v => _nuevaFechaFinPrevista = v" />

        <CampoTexto Etiqueta="@Textos["EtiquetaNotas"]" Valor="@_nuevasNotas" ValorChanged="v => _nuevasNotas = v" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Primario" OnClick="CrearProyectoAsync" Cargando="_guardando">@Textos["BotonCrearProyecto"]</Boton>
        <Boton OnClick="() => _drawerProyecto?.SolicitarCierreAsync() ?? Task.CompletedTask" Variante="VarianteBoton.Secundario">@Textos["BotonCancelar"]</Boton>
    </Pie>
</Drawer>

@* «Cerrar proyecto» es un formulario de un campo (la fecha de cierre): ModalFormulario (guardián propio, «Cancelar» como la X, primario único
   con su estado, aviso del formulario y aviso de navegación vienen del kit; fuera del ámbito del detalle, como el Modal anterior). *@
<ModalFormulario Visible="_mostrarCerrarConfirm" VisibleChanged="v => _mostrarCerrarConfirm = v" Titulo="@Textos["AccionCerrarProyecto"]"
                 HayCambios="() => HayCambiosEnElModalDeCierre" Guardando="_guardando" MensajeError="@_errorCierre"
                 OnGuardar="ConfirmarCerrarAsync" TextoGuardar="@Textos["AccionCerrarProyecto"]" TextoCancelar="@Textos["BotonCancelar"]">
    <p>@Textos["ModalCerrarExplicacion"]</p>
    <CampoTexto Etiqueta="@Textos["EtiquetaFechaCierre"]" Type="date" Valor="@_fechaCierre" ValorChanged="v => { _fechaCierre = v; _errorCierre = null; }" />
</ModalFormulario>

<DialogoConfirmacion
    Visible="_confirmarReabrirVisible"
    VisibleChanged="v => _confirmarReabrirVisible = v"
    Titulo="@Textos["ConfirmarReabrirTitulo"]"
    Mensaje="@Textos["ConfirmarReabrirMensaje", _nombreAReabrir, _fechaCierreAReabrir?.ToString("dd/MM/yyyy") ?? string.Empty].Value"
    TextoBotonConfirmar="@Textos["AccionReabrirProyecto"]"
    EnProgreso="_reabriendo"
    OnConfirmar="ConfirmarReabrirAsync" />

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["ConfirmarEliminarTitulo"]"
    Mensaje="@Textos["ConfirmarEliminarMensaje", _nombreAEliminar]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<DialogoConfirmacion
    Visible="_tecnicoADarDeBaja is not null"
    VisibleChanged="CerrarConfirmacionBajaTecnico"
    Titulo="@Textos["ConfirmarBajaTecnicoTitulo"]"
    Mensaje="@MensajeConfirmarBajaTecnico"
    TextoBotonConfirmar="@Textos["BotonDarDeBaja"]"
    EnProgreso="_dandoDeBajaTecnico"
    OnConfirmar="ConfirmarBajaTecnicoAsync" />

<CascadingValue Value="_ambitoDetalle" IsFixed="true">
    <AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CerrarFormulariosDescartando" />
</CascadingValue>
</LimiteDeErrores>

@code {
    private Drawer? _drawerProyecto;
    // De instancia, no static: las etiquetas salen del localizador inyectado.
    private IReadOnlyList<PestanaDefinicion>? _pestanasDetalle;

    private IReadOnlyList<PestanaDefinicion> PestanasDetalle => _pestanasDetalle ??=
    [
        new("informacion", Textos["PestanaInformacion"]),
        new("tecnicos", Textos["PestanaTecnicos"]),
        new("documentos", Textos["PestanaDocumentos"])
    ];
}
