@page "/incidencias"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Incidencias.Commands.CrearIncidencia
@using CaeManager.Application.Incidencias.Commands.EditarIncidencia
@using CaeManager.Application.Incidencias.Commands.EliminarIncidencia
@using CaeManager.Application.Incidencias.Commands.EliminarIncidencias
@using CaeManager.Application.Incidencias.Commands.MarcarResueltaIncidencia
@using CaeManager.Application.Incidencias.Queries.ObtenerIncidenciaPorId
@using CaeManager.Application.Incidencias.Queries.ObtenerIncidencias
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Incidencias
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Components.Workspace
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService

<PageTitle>Incidencias — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <CabeceraPagina Titulo="Incidencias" Kicker="Operación">
        <Acciones>
            <a class="enlace-exportar" href="/incidencias/exportar.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Exportar a Excel</a>
            <Boton OnClick="AbrirCrearAsync">+ Nueva incidencia</Boton>
        </Acciones>
    </CabeceraPagina>

    <div class="barra-filtros">
        <CampoTexto Placeholder="Buscar por centro, trabajador o descripción…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <FiltroEstado Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync" Opciones="OpcionesEstado" TextoTodos="Todas" />
    </div>

    @* El valor del filtro de estado vive dentro de un desplegable cerrado: sin
       el chip, una lista de incidencias abiertas se lee como la lista de todas.
       La búsqueda no lleva chip porque ya se ve escrita en su propio campo. *@
    @if (!string.IsNullOrWhiteSpace(_estadoFiltro))
    {
        <div class="chips-filtros">
            <span class="chips-filtros-indicador" aria-hidden="true"><Icono Nombre="filtro" Tamano="TamanoIcono.Pequeno" /></span>
            <span class="chip-filtro">
                @EtiquetaFiltroEstado
                <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroEstadoAsync" aria-label="Quitar el filtro de estado"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
            </span>
        </div>
    }

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <div role="alert">
            <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)"
                         Titulo="No pudimos cargar las incidencias" Descripcion="Intenta nuevamente en unos segundos.">
                <Accion>
                    <Boton OnClick="ReintentarAsync">Reintentar</Boton>
                </Accion>
            </EstadoVacio>
        </div>
    }
    else
    {
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            <Extra>
                @if (MostrarRecuento)
                {
                    <span class="recuento-incidencias">@TextoRecuento</span>
                }
                @if (_elementosPagina.Count > 0)
                {
                    <span class="atajos-incidencias">
                        Atajos: <kbd>j</kbd> / <kbd>k</kbd> mover · <kbd>x</kbd> marcar · <kbd>Enter</kbd> abrir el centro
                    </span>
                }
            </Extra>
        </BarraHerramientasLista>

        @if (MostrarEsqueleto)
        {
            <EstadoCargando Filas="6" />
        }

        <div style="display:@(OcultarTabla ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="IncidenciaListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="Seleccionar la página" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@($"Seleccionar la incidencia de {context.CentroNombre} del {context.FechaOcurrencia:dd/MM/yyyy}")" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Centro" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.CentroNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Centro, context.CentroId, context.CentroNombre, "informacion")'>
                        @context.CentroNombre
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="Trabajador" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.TrabajadorNombre))">
                    @if (context.TrabajadorId is null)
                    {
                        @:—
                    }
                    else
                    {
                        <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Trabajador, context.TrabajadorId!.Value, context.TrabajadorNombre!, "informacion")'>
                            @context.TrabajadorNombre
                        </button>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Tipo" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Tipo))">@ObtenerEtiquetaTipo(context.Tipo)</TemplateColumn>
                <TemplateColumn Title="Gravedad" Align="Align.Center" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Gravedad))">
                    <Badge Tono="@GravedadTono(context.Gravedad)">@ObtenerEtiquetaGravedad(context.Gravedad)</Badge>
                </TemplateColumn>
                <TemplateColumn Title="Fecha" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.FechaOcurrencia))">@context.FechaOcurrencia.ToString("dd/MM/yyyy")</TemplateColumn>
                <TemplateColumn Title="Estado" Align="Align.Center" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Resuelta))">
                    <Badge Tono="@(context.Resuelta ? TonoBadge.Exito : TonoBadge.Advertencia)">
                        @(context.Resuelta ? "Resuelta" : "Sin resolver")
                    </Badge>
                </TemplateColumn>
                <TemplateColumn Title="Acciones" Align="Align.End">
                    <MenuAcciones>
                        <ItemMenuAccion OnClick="() => CambiarResueltaAsync(context.Id, !context.Resuelta)">
                            @(context.Resuelta ? "Reabrir" : "Marcar resuelta")
                        </ItemMenuAccion>
                        <ItemMenuAccion OnClick="() => AbrirEditarAsync(context.Id)">
                            Editar
                        </ItemMenuAccion>
                        <ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.CentroNombre)">
                            Eliminar
                        </ItemMenuAccion>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="incidencia(s)" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "todavía no hay incidencias", y aquí la diferencia
               cambia una conclusión de seguridad: filtrar por "Sin resolver" y
               leer que no hay ninguna incidencia registrada hace creer que
               nunca ha pasado nada, cuando el cero solo dice que no queda
               ninguna abierta.

               La copia no afirma que HAYA incidencias registradas (el mockup Gen 2
               sí lo hace): el filtrado es de servidor y solo devuelve el total ya
               filtrado, así que la pantalla no puede saberlo. *@
            <EstadoVacio NombreIcono="filtro" Titulo="Ninguna incidencia con estos filtros"
                         Descripcion="Ninguna coincide con la búsqueda ni con el estado seleccionado.">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio NombreIcono="incidencias" Titulo="Todavía no hay incidencias" Descripcion="Registra la primera incidencia operativa de un centro.">
                <Accion>
                    <Boton OnClick="AbrirCrearAsync">+ Nueva incidencia</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? "Nueva incidencia" : "Editar incidencia")" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        @if (_editandoId is null)
        {
            <CampoSelect Etiqueta="Centro" Valor="@_centroId" ValorChanged="v => _centroId = v">
                <option value="">Selecciona un centro…</option>
                @foreach (var centro in _centrosDisponibles)
                {
                    <option value="@centro.Id">@centro.Nombre (@centro.ClienteRazonSocial — @centro.EmpresaRazonSocial)</option>
                }
            </CampoSelect>
        }
        else
        {
            @* El Centro solo se elige al crear: EditarIncidenciaCommand no lo lleva. *@
            <div class="campo">
                <label>Centro</label>
                <p class="texto-vacio-seccion">@_centroNombreEnEdicion</p>
            </div>
        }

        <CampoSelect Etiqueta="Trabajador (opcional)" Valor="@_trabajadorId" ValorChanged="v => _trabajadorId = v">
            <option value="">Ninguno — incidencia general del centro</option>
            @foreach (var trabajador in _trabajadoresDisponibles)
            {
                <option value="@trabajador.Id">@trabajador.NombreCompleto (@trabajador.Dni)</option>
            }
        </CampoSelect>

        <div class="campos-en-par">
            <CampoSelect Etiqueta="Tipo" Valor="@_tipo" ValorChanged="v => _tipo = v">
                <option value="@nameof(TipoIncidencia.Accidente)">Accidente</option>
                <option value="@nameof(TipoIncidencia.Incumplimiento)">Incumplimiento</option>
            </CampoSelect>

            <CampoSelect Etiqueta="Gravedad" Valor="@_gravedad" ValorChanged="v => _gravedad = v">
                <option value="@nameof(GravedadIncidencia.Leve)">Leve</option>
                <option value="@nameof(GravedadIncidencia.Grave)">Grave</option>
                <option value="@nameof(GravedadIncidencia.MuyGrave)">Muy grave</option>
            </CampoSelect>
        </div>

        <CampoTexto Etiqueta="Fecha de ocurrencia" Type="date" Valor="@_fechaOcurrencia" ValorChanged="v => _fechaOcurrencia = v" />
        <CampoTextarea Etiqueta="Descripción" Placeholder="Qué pasó, dónde y quién lo detectó" Valor="@_descripcion" ValorChanged="v => _descripcion = v" Filas="4" MensajeError="@ObtenerError(nameof(CrearIncidenciaCommand.Descripcion))" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar la incidencia de {_centroAEliminar}?")"
    Mensaje="Se ocultará de las listas activas."
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} incidencia(s)?")"
    Mensaje="Se ocultarán de las listas activas."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
