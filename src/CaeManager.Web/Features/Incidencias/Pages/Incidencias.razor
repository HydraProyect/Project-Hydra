@page "/incidencias"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Incidencias.Commands.CrearIncidencia
@using CaeManager.Application.Incidencias.Commands.EditarIncidencia
@using CaeManager.Application.Incidencias.Commands.EliminarIncidencia
@using CaeManager.Application.Incidencias.Commands.EliminarIncidencias
@using CaeManager.Application.Incidencias.Commands.MarcarResueltaIncidencia
@using CaeManager.Application.Incidencias.Queries.ObtenerIncidenciaPorId
@using CaeManager.Application.Incidencias.Queries.ObtenerIncidencias
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Incidencias
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Incidencias.Recursos
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosIncidencias> Textos
@inject IStringLocalizer<CaeManager.Web.Recursos.TextosComunes> ComunesListados

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina lista-design">
    <CabeceraListado Titulo="@Textos["TituloPagina"]" Contador="@(_cargando || _errorCarga ? null : (int?)_totalElementos)"
                     SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple"
                     >
        <Menu>
            <CaeManager.Web.Exportacion.EntradasExportar Ruta="/incidencias/exportar.xlsx" />
        </Menu>
        <Primaria>
            <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">@Textos["BotonNuevaIncidencia"]</Boton></SoloConEscritura>
        </Primaria>
    </CabeceraListado>

    @* El estado se filtra en la franja (Sin resolver / Resueltas), que ya dice cuál está marcado: sin pastillas. El fragmento
       vacío mantiene la barra en modo pastillas. *@
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["PlaceholderBusqueda"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar"
                  VistaRecordada="_vistaRecordada">
        <Pastillas></Pastillas>
        <Estados>
            <FranjaEstado Opciones="OpcionesEstado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                          TextoTodos="@Textos["OpcionTodas"]" EtiquetaAccesible="@Textos["EtiquetaEstado"]" />
        </Estados>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["AriaQuitarBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
            }
        </Chips>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                               OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Incidencias"
                             ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <div role="alert">
            <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)"
                         Titulo="@Textos["ErrorCargaListaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Primario" OnClick="ReintentarAsync">@Textos["BotonReintentar"]</Boton>
                </Accion>
            </EstadoVacio>
        </div>
    }
    else
    {
        @if (MostrarEsqueleto)
        {
            <EstadoCargando Filas="6" />
        }

        @* La rejilla se monta siempre (es la que pide los datos): se esconde mientras no haya filas que enseñar. *@
        @TarjetaListado.RenderizarMaqueta(@<text>
            <div style="display:@(OcultarTabla ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="IncidenciaListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@(Textos["AriaSeleccionarIncidencia", context.CentroNombre, context.FechaOcurrencia.ToString("dd/MM/yyyy")])" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                @* Primera columna del patrón de listados (maqueta de Incidencias): el tipo y debajo su código INC-xxxxxxxx, derivado
                   del Id como VIS- en Visitas (no es un dato guardado). *@
                <TemplateColumn Title="@Textos["ColumnaIncidencia"]" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Tipo))">
                    <span class="incidencia-tipo-codigo">
                        <span class="incidencia-nombre-tipo">@ObtenerEtiquetaTipo(context.Tipo)</span>
                        <span class="incidencia-referencia"><BotonCopiar EnLinea="true" ConfirmarConIcono="true" Texto="@ReferenciaIncidencia(context.Id)" Valor="@context.Id.ToString()" NombreAccesible="@Textos["CopiarReferenciaIncidencia", ObtenerEtiquetaTipo(context.Tipo)]" /></span>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaCentro"]" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.CentroNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Centro, context.CentroId, context.CentroNombre, "informacion")'>
                        @context.CentroNombre
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaTrabajador"]" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.TrabajadorNombre))">
                    @if (context.TrabajadorId is null)
                    {
                        @:—
                    }
                    else
                    {
                        <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Trabajador, context.TrabajadorId!.Value, context.TrabajadorNombre!, "informacion")'>
                            @context.TrabajadorNombre
                        </button>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaGravedad"]" Align="Align.Center" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Gravedad))">
                    <Badge Tono="@GravedadTono(context.Gravedad)">@ObtenerEtiquetaGravedad(context.Gravedad)</Badge>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaFecha"]" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.FechaOcurrencia))">@context.FechaOcurrencia.ToString("dd/MM/yyyy")</TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaEstado"]" Align="Align.Center" Sortable="true" SortBy="@(GridSort<IncidenciaListaDto>.ByAscending(i => i.Resuelta))">
                    <Badge Tono="@(context.Resuelta ? TonoBadge.Exito : TonoBadge.Advertencia)">
                        @(context.Resuelta ? Textos["EstadoResuelta"].Value : Textos["EstadoSinResolver"].Value)
                    </Badge>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaAcciones"]" Align="Align.End">
                    <MenuAcciones>
                        <SoloConEscritura><ItemMenuAccion OnClick="() => CambiarResueltaAsync(context.Id, !context.Resuelta)">
                            @(context.Resuelta ? Textos["AccionReabrir"].Value : Textos["AccionMarcarResuelta"].Value)
                        </ItemMenuAccion></SoloConEscritura>
                        <SoloConEscritura><ItemMenuAccion OnClick="() => AbrirEditarAsync(context.Id)">
                            @Textos["AccionEditar"]
                        </ItemMenuAccion></SoloConEscritura>
                        <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.CentroNombre)">
                            @Textos["AccionEliminar"]
                        </ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>
            </div>
        </text>, PieDelListado)

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "todavía no hay incidencias", y aquí la diferencia
               cambia una conclusión de seguridad: filtrar por "Sin resolver" y
               leer que no hay ninguna incidencia registrada hace creer que
               nunca ha pasado nada, cuando el cero solo dice que no queda
               ninguna abierta.

               La copia no afirma que HAYA incidencias registradas (el mockup Gen 2
               sí lo hace): el filtrado es de servidor y solo devuelve el total ya
               filtrado, así que la pantalla no puede saberlo. *@
            <EstadoVacio NombreIcono="filtro" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio NombreIcono="incidencias" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">@Textos["BotonNuevaIncidencia"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync"
                 Titulo="@(_editandoId is null ? Textos["DrawerTituloNueva"].Value : Textos["DrawerTituloEditar"].Value)"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    @if (_editandoId is null)
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaCentro"]" Valor="@_centroId" ValorChanged="v => _centroId = v">
            <option value="">@Textos["OpcionSeleccionaCentro"]</option>
            @foreach (var centro in _centrosDisponibles)
            {
                <option value="@centro.Id">@centro.Nombre (@centro.ClienteRazonSocial — @centro.EmpresaRazonSocial)</option>
            }
        </CampoSelect>
    }
    else
    {
        @* El Centro solo se elige al crear: EditarIncidenciaCommand no lo lleva. *@
        <div class="campo">
            <label>@Textos["EtiquetaCentro"]</label>
            <p class="texto-vacio-seccion">@_centroNombreEnEdicion</p>
        </div>
    }

    <CampoSelect Etiqueta="@Textos["EtiquetaTrabajadorOpcional"]" Valor="@_trabajadorId" ValorChanged="v => _trabajadorId = v">
        <option value="">@Textos["OpcionNingunTrabajador"]</option>
        @foreach (var trabajador in EtiquetasSelectorTrabajador.Construir(_trabajadoresDisponibles))
        {
            <option value="@trabajador.Id">@trabajador.Texto</option>
        }
    </CampoSelect>

    <div class="campos-en-par">
        <CampoSelect Etiqueta="@Textos["EtiquetaTipo"]" Valor="@_tipo" ValorChanged="v => _tipo = v">
            <option value="@nameof(TipoIncidencia.Accidente)">@Textos["TipoAccidente"]</option>
            <option value="@nameof(TipoIncidencia.Incumplimiento)">@Textos["TipoIncumplimiento"]</option>
        </CampoSelect>

        <CampoSelect Etiqueta="@Textos["EtiquetaGravedad"]" Valor="@_gravedad" ValorChanged="v => _gravedad = v">
            <option value="@nameof(GravedadIncidencia.Leve)">@Textos["GravedadLeve"]</option>
            <option value="@nameof(GravedadIncidencia.Grave)">@Textos["GravedadGrave"]</option>
            <option value="@nameof(GravedadIncidencia.MuyGrave)">@Textos["GravedadMuyGrave"]</option>
        </CampoSelect>
    </div>

    <CampoTexto Etiqueta="@Textos["EtiquetaFechaOcurrencia"]" Type="date" Valor="@_fechaOcurrencia" ValorChanged="v => _fechaOcurrencia = v" />
    <CampoTextarea Etiqueta="@Textos["EtiquetaDescripcion"]" Placeholder="@Textos["PlaceholderDescripcion"]" Valor="@_descripcion" ValorChanged="v => _descripcion = v" Filas="4" MensajeError="@ObtenerError(nameof(CrearIncidenciaCommand.Descripcion))" />
</DrawerFormulario>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["ConfirmarEliminarTitulo", _centroAEliminar]"
    Mensaje="@Textos["ConfirmarEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

@* La única acción del lote es eliminar (ICommand que AutorizacionEscrituraBehavior deniega a
   Consulta): la barra no se le ofrece. La palanca de selección múltiple sigue visible porque
   vive en la cabecera, compartida y con contenido de lectura, y seleccionar no escribe. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@Textos["ConfirmarEliminarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

</LimiteDeErrores>

@code {
    private RenderFragment? PieDelListado => _errorCarga || (_cargando && _totalElementos == 0) ? null : @<text>
        <PaginadorSimple PresentacionMaqueta="true" ElementosEnPagina="_elementosPagina.Count" PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                         Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                         TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync">
            <Centro><LeyendaAtajosLista Omitir="@(["e"])" /></Centro>
        </PaginadorSimple>
    </text>;
}
