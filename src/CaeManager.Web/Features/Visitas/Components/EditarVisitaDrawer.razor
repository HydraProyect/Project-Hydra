@*
    Edición de una Visita desde su página 360. Mismos campos, validaciones y
    comando (EditarVisitaCommand, con la versión leída al abrir) que la rama de
    edición del formulario del listado (Visitas.razor): el Centro va fijo y la
    lista de trabajadores no se filtra por el Centro, igual que allí al editar.

    No lleva la casilla «Marcar como avisado al titular del Centro» del
    formulario del listado: allí su valor no viaja a ningún comando, y en esta
    página la marca se cambia con el interruptor del lateral
    (MarcarNotificadoClienteCommand).
*@
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Visitas.Commands.EditarVisita
@using CaeManager.Application.Visitas.Queries.ObtenerVisitaPorId
@using CaeManager.Web.Features.Visitas.Recursos
@using FluentValidation
@using MediatR
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosVisitas> Textos

<DrawerFormulario Visible="Visible" VisibleChanged="VisibleChanged"
                 Titulo="@Textos["DrawerTituloEditar"]" Cargando="_cargando"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <div class="campo">
        <label>@Textos["EtiquetaCentro"]</label>
        <p class="texto-vacio-seccion">@_centroNombre</p>
    </div>

    <CampoTexto Etiqueta="@Textos["EtiquetaFechaInicio"]" Type="date" Valor="@_fechaInicio" ValorChanged="v => _fechaInicio = v" />
    <CampoTexto Etiqueta="@Textos["EtiquetaFechaFin"]" Type="date" Valor="@_fechaFin" ValorChanged="v => _fechaFin = v" />
    <CampoTexto Etiqueta="@Textos["EtiquetaHoraEntrada"]" Type="time"
                Valor="@_horaEstimadaAcceso" ValorChanged="v => _horaEstimadaAcceso = v" />

    <SelectorMultiple @ref="_selectorTrabajadores"
                       Etiqueta="@Textos["EtiquetaTrabajadoresQueEntran"]"
                       Elementos="@TrabajadoresSelector"
                       Seleccionados="@_trabajadorIdsSeleccionados"
                       OnAlternar="args => AlternarTrabajador(args.Id, args.Marcado)"
                       TextoVacio="@Textos["SelectorTrabajadoresVacio"]"
                       MensajeError="@ErrorTrabajadores" />

    <CampoTextarea Etiqueta="@Textos["EtiquetaNotas"]" Valor="@_notas" ValorChanged="v => _notas = v" Filas="3" />
</DrawerFormulario>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public Guid VisitaId { get; set; }

    /// <summary>Tras guardar: la página recarga la Visita.</summary>
    [Parameter] public EventCallback OnGuardada { get; set; }

    /// <summary>La Visita ya no existe o dejó de ser visible: la página recarga y lo dice.</summary>
    [Parameter] public EventCallback OnNoEncontrada { get; set; }

    private IReadOnlyList<TrabajadorSelectorDto> _trabajadoresDisponibles = [];
    private SelectorMultiple? _selectorTrabajadores;
    private bool _cargando;
    private bool _guardando;
    private bool _abierto;
    private int _carga;
    private Guid _version;
    private string _centroNombre = string.Empty;
    private string _fechaInicio = string.Empty;
    private string _fechaFin = string.Empty;
    private string _horaEstimadaAcceso = string.Empty;
    private HashSet<Guid> _trabajadorIdsSeleccionados = [];
    private string _notas = string.Empty;
    private string? _instantaneaAlAbrir;
    private string? _mensajeErrorFormulario;
    private Dictionary<string, string> _erroresCampo = new();

    private IReadOnlyList<ElementoSeleccionable> TrabajadoresSelector => EtiquetasSelectorTrabajador.Construir(_trabajadoresDisponibles)
        .Select(e => new ElementoSeleccionable(e.Id, e.Texto)).ToList();
    private string? ErrorTrabajadores => _erroresCampo.GetValueOrDefault("TrabajadorIds");

    private bool HayCambiosSinGuardar =>
        Visible && _instantaneaAlAbrir is not null && Instantanea() != _instantaneaAlAbrir;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible == _abierto)
            return;

        _abierto = Visible;
        if (Visible)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        // Reabrir mientras la carga anterior sigue en vuelo: la respuesta tardía no rellena el formulario.
        var carga = ++_carga;
        _cargando = true;
        _instantaneaAlAbrir = null;
        _mensajeErrorFormulario = null;
        _erroresCampo = new Dictionary<string, string>();

        try
        {
            var trabajadores = await Mediator.Send(new ObtenerTrabajadoresParaSelectorQuery(AlcanceSelectorTrabajadores.BaseGeneralDelTenant));
            var visita = await Mediator.Send(new ObtenerVisitaPorIdQuery(VisitaId));
            if (carga != _carga)
                return;

            if (visita is null)
            {
                ToastService.Mostrar(Textos["ToastVisitaNoEncontrada"], TonoToast.Error);
                await VisibleChanged.InvokeAsync(false);
                await OnNoEncontrada.InvokeAsync();
                return;
            }

            _trabajadoresDisponibles = trabajadores;
            _version = visita.Version;
            _centroNombre = $"{visita.CentroNombre} ({visita.ClienteRazonSocial} — {visita.EmpresaRazonSocial})";
            _fechaInicio = visita.FechaInicio.ToString("yyyy-MM-dd");
            _fechaFin = visita.FechaFin.ToString("yyyy-MM-dd");
            _horaEstimadaAcceso = visita.HoraEstimadaAcceso?.ToString("HH:mm") ?? string.Empty;
            _trabajadorIdsSeleccionados = visita.TrabajadorIds.ToHashSet();
            _notas = visita.Notas ?? string.Empty;
            _instantaneaAlAbrir = Instantanea();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (carga != _carga)
                return;

            ToastService.Mostrar(Textos["ToastErrorDetalle"], TonoToast.Error);
            await VisibleChanged.InvokeAsync(false);
        }
        finally
        {
            if (carga == _carga)
                _cargando = false;
        }
    }

    private void AlternarTrabajador(Guid trabajadorId, bool seleccionado)
    {
        _erroresCampo.Remove("TrabajadorIds");
        if (seleccionado)
            _trabajadorIdsSeleccionados.Add(trabajadorId);
        else
            _trabajadorIdsSeleccionados.Remove(trabajadorId);
    }

    private string Instantanea() => string.Join('\u001f',
        _fechaInicio, _fechaFin, _horaEstimadaAcceso, string.Join(',', _trabajadorIdsSeleccionados.Order()), _notas);

    private async Task GuardarAsync()
    {
        _guardando = true;
        _mensajeErrorFormulario = null;
        _erroresCampo = new Dictionary<string, string>();

        try
        {
            // Sin trabajadores el comando se rechazaría igualmente: se avisa junto a la lista y
            // con un toast, porque con el cuerpo del drawer desplazado el aviso de arriba no se ve.
            if (_trabajadorIdsSeleccionados.Count == 0)
            {
                _erroresCampo["TrabajadorIds"] = Textos["ErrorSeleccionaTrabajador"];
                ToastService.Mostrar(Textos["ErrorSeleccionaTrabajador"], TonoToast.Error);
                if (_selectorTrabajadores is not null)
                    await _selectorTrabajadores.EnfocarAsync();
                return;
            }

            if (!DateOnly.TryParse(_fechaInicio, out var fechaInicio) || !DateOnly.TryParse(_fechaFin, out var fechaFin))
            {
                _mensajeErrorFormulario = Textos["ErrorFechasNoValidas"];
                return;
            }

            var notas = string.IsNullOrWhiteSpace(_notas) ? null : _notas;
            TimeOnly? horaEstimada = TimeOnly.TryParse(_horaEstimadaAcceso, out var hora) ? hora : null;

            var resultado = await Mediator.Send(new EditarVisitaCommand(
                VisitaId, fechaInicio, fechaFin, _trabajadorIdsSeleccionados.ToList(), notas, _version, horaEstimada));

            if (resultado.EsFallido)
            {
                _mensajeErrorFormulario = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar(Textos["ToastActualizada"], TonoToast.Exito);
            _instantaneaAlAbrir = null;
            await VisibleChanged.InvokeAsync(false);
            await OnGuardada.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            _erroresCampo = ex.Errors
                .GroupBy(e => e.PropertyName)
                .ToDictionary(g => g.Key, g => g.First().ErrorMessage);

            // Los errores de campo sin sitio propio en el formulario también deben verse.
            var sinCampo = _erroresCampo.Where(e => e.Key != "TrabajadorIds").Select(e => e.Value).FirstOrDefault();
            if (sinCampo is not null)
                _mensajeErrorFormulario = sinCampo;
            ToastService.Mostrar(ErrorTrabajadores ?? sinCampo ?? Textos["ErrorGuardar"], TonoToast.Error);
        }
        catch (Exception)
        {
            _mensajeErrorFormulario = Textos["ErrorGuardar"];
        }
        finally
        {
            _guardando = false;
        }
    }
}
