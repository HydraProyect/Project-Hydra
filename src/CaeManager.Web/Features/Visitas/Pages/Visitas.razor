@page "/visitas"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Visitas.Commands.CrearVisita
@using CaeManager.Application.Visitas.Commands.EditarVisita
@using CaeManager.Application.Visitas.Commands.EliminarVisita
@using CaeManager.Application.Visitas.Commands.EliminarVisitas
@using CaeManager.Application.Visitas.Commands.MarcarNotificadoCliente
@using CaeManager.Application.Visitas.Queries.ObtenerDetalleVisita
@using CaeManager.Application.Visitas.Queries.ObtenerVisitaPorId
@using CaeManager.Application.Visitas.Queries.ObtenerVisitas
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Common
@using CaeManager.Application.Visitas.Queries.ObtenerDocumentacionVisita
@using CaeManager.Domain.Documentos
@using CaeManager.Domain.Visitas
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Visitas
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService

<PageTitle>Visitas — @Marca.Nombre</PageTitle>

@*
    Gen 2 (Visitas TALVEG.dc.html). Vocabulario: los datos traen
    NotificadoCliente / ClienteRazonSocial, pero representan a la Empresa
    titular del Centro de Trabajo. En el texto visible se dice «titular» o
    «empresa titular», nunca «cliente» a secas; los nombres de código son
    deuda terminológica y no se renombran aquí.
*@
<div class="contenedor-pagina">
    <CabeceraPagina Kicker="Operación" Titulo="Visitas">
        <Acciones>
            <Boton OnClick="AbrirCrearAsync">+ Nueva visita</Boton>
        </Acciones>
    </CabeceraPagina>

    <div class="barra-filtros">
        <CampoTexto Placeholder="Buscar por centro, titular o empresa…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <label class="filtro-critico">
            <input type="checkbox" @bind="_soloActivas" @bind:after="RecargarAsync" /> Solo activas
        </label>
        <label class="filtro-critico">
            <input type="checkbox" @bind="_soloUrgentes" @bind:after="RecargarAsync" /> Solo urgentes
        </label>
        <CampoSelect Etiqueta="Notificada a la empresa titular" Valor="@_filtroNotificado" ValorChanged="FiltrarPorNotificadoAsync">
            <option value="">Todas</option>
            <option value="si">Sí</option>
            <option value="no">No</option>
        </CampoSelect>
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar las visitas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="RecargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @* El grid se mantiene siempre montado (solo se oculta con CSS) para que la
           referencia @@ref siga siendo válida y RefreshDataAsync funcione incluso al
           pasar de 0 a 1 elementos — ver Clientes.razor.cs. *@
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            <Extra>
                @if (!_cargando && _totalElementos > 0)
                {
                    <span class="visitas-recuento">@TextoRecuento</span>
                }
                @* Lo que la pantalla puede afirmar, comprobado en
                   ObtenerVisitasQueryHandler: la urgencia se calcula en cada
                   consulta con la fecha de hoy y las fechas de la visita
                   (CalculadoraUrgenciaVisita). El mockup dice «recalculada cada
                   hora sobre la fecha de entrada»: no hay tal proceso horario, y
                   la calculadora no mira la hora de entrada. *@
                <span class="visitas-nota-sistema">
                    <span class="visitas-nota-sistema-punto" aria-hidden="true"></span>
                    Urgencia calculada al cargar la lista, sobre las fechas de cada visita
                </span>
            </Extra>
        </BarraHerramientasLista>

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="VisitaListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Centro" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.CentroNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Centro, context.CentroId, context.CentroNombre, "informacion")'>
                        @context.CentroNombre
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="Titular del centro / Empresa" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.ClienteRazonSocial))">
                    <span class="visitas-celda-apilada">
                        <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Cliente, context.ClienteId, context.ClienteRazonSocial, "informacion")'>
                            @context.ClienteRazonSocial
                        </button>
                        <button type="button" class="enlace-nombre-fila visitas-celda-secundaria" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Empresa, context.EmpresaId, context.EmpresaRazonSocial, "informacion")'>
                            @context.EmpresaRazonSocial
                        </button>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="Fechas" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.FechaInicio))">
                    @TextoFechas(context.FechaInicio, context.FechaFin)
                </TemplateColumn>
                <TemplateColumn Title="Trabajadores" Align="Align.Center">
                    @context.TotalTrabajadores
                </TemplateColumn>
                <TemplateColumn Title="Urgencia" Align="Align.Center">
                    @* Los cuatro valores de NivelUrgenciaVisita, «Normal» incluido:
                       una celda vacía no distingue «normal» de «sin calcular». *@
                    <Badge Tono="NivelUrgenciaVisitaUi.Tono(context.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(context.NivelUrgencia)</Badge>
                </TemplateColumn>
                @* El mockup lleva el origen solo al detalle; aquí se conserva
                   también en la lista porque ya existía y se ordena por él. *@
                <TemplateColumn Title="Origen" Align="Align.Center" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.Origen))">
                    <Badge Tono="TonoOrigen(context.Origen)">@TextoOrigen(context.Origen)</Badge>
                </TemplateColumn>
                <TemplateColumn Title="Documentación" Align="Align.Center">
                    @if (context.DocumentacionCompleta)
                    {
                        <Badge Tono="TonoBadge.Exito">Completa</Badge>
                    }
                    else
                    {
                        <Badge Tono="TonoBadge.Peligro">Por gestionar</Badge>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Notificada a la empresa titular" Align="Align.Center" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.NotificadoCliente))">
                    <input type="checkbox" role="switch" class="visitas-interruptor" checked="@context.NotificadoCliente"
                           aria-label="@($"Notificada a la empresa titular: {context.CentroNombre}, {TextoFechas(context.FechaInicio, context.FechaFin)}")"
                           disabled="@_marcandoNotificado.Contains(context.Id)"
                           @onchange="e => AlternarNotificadoAsync(context.Id, e.Value is bool marcado && marcado)" />
                </TemplateColumn>
                <TemplateColumn Title="Acciones" Align="Align.End">
                    <MenuAcciones>
                        <ItemMenuAccion OnClick="() => AbrirDetalleAsync(context.Id)">
                            Ver
                        </ItemMenuAccion>
                        <ItemMenuAccion OnClick="() => AbrirEditarAsync(context.Id)">
                            Editar
                        </ItemMenuAccion>
                        <ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.CentroNombre)">
                            Eliminar
                        </ItemMenuAccion>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="visita(s)" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @* TRES estados vacíos, no dos, y la razón es que "Solo activas" viene
           MARCADO de fábrica (_soloActivas = true). El patrón de dos estados que
           usan las demás listas no se traslada aquí:

           - contarlo como filtro dejaría "Todavía no hay visitas" inalcanzable,
             porque siempre habría un filtro puesto;
           - no contarlo haría que esa misma frase mintiera a quien sí tiene
             visitas, pero todas finalizadas.

           Cada uno de los tres dice algo que es cierto, y ofrece la salida que
           corresponde. *@
        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            <EstadoVacio NombreIcono="vacio" Titulo="Ninguna visita con estos filtros"
                         Descripcion="Ninguna coincide con la búsqueda ni con los filtros de urgencia o notificación.">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando && _soloActivas)
        {
            @* Sin más filtros que el de fábrica: puede haber visitas finalizadas
               detrás. Decir "crea la primera" aquí sería falso, y ofrecer
               "quitar los filtros" señalaría algo que el usuario no puso. *@
            <EstadoVacio NombreIcono="vacio" Titulo="No hay visitas activas"
                         Descripcion="Puede haber visitas ya finalizadas: la lista llega filtrada por «Solo activas».">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="VerTambienFinalizadasAsync">Ver también las finalizadas</Boton>
                    <Boton OnClick="AbrirCrearAsync">+ Nueva visita</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="Todavía no hay visitas programadas" Descripcion="Crea la primera visita para empezar a llevar el control de accesos programados.">
                <Accion>
                    <Boton OnClick="AbrirCrearAsync">+ Nueva visita</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? "Nueva visita" : "Editar visita")" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        @if (_sugerenciaVisitaResumen is not null)
        {
            <div class="alerta-info">Prellenado desde un correo: @_sugerenciaVisitaResumen — revisa los datos y elige los trabajadores antes de guardar.</div>
        }

        @if (_editandoId is null)
        {
            <CampoSelect Etiqueta="Centro" Valor="@_centroId" ValorChanged="v => _centroId = v">
                <option value="">Selecciona un centro…</option>
                @foreach (var centro in _centrosDisponibles)
                {
                    <option value="@centro.Id">@centro.Nombre (@centro.ClienteRazonSocial — @centro.EmpresaRazonSocial)</option>
                }
            </CampoSelect>
        }
        else
        {
            <div class="campo">
                <label>Centro</label>
                <p class="texto-vacio-seccion">@_centroNombreEnEdicion</p>
            </div>
        }

        <CampoTexto Etiqueta="Fecha de inicio" Type="date" Valor="@_fechaInicio" ValorChanged="v => _fechaInicio = v" />
        <CampoTexto Etiqueta="Fecha de fin" Type="date" Valor="@_fechaFin" ValorChanged="v => _fechaFin = v" />
        <CampoTexto Etiqueta="Hora de entrada (opcional — si se deja vacía se asume la apertura de la jornada)" Type="time"
                    Valor="@_horaEstimadaAcceso" ValorChanged="v => _horaEstimadaAcceso = v" />

        <SelectorMultiple Etiqueta="Trabajadores que entran"
                           Elementos="@_trabajadoresDisponiblesSelector"
                           Seleccionados="@_trabajadorIdsSeleccionados"
                           OnAlternar="args => AlternarTrabajador(args.Id, args.Marcado)"
                           TextoVacio="Todavía no hay trabajadores creados." />

        <label class="campo-checkbox">
            <input type="checkbox" @bind="_notificadoCliente" /> Notificada a la empresa titular del centro
        </label>

        <CampoTextarea Etiqueta="Notas" Valor="@_notas" ValorChanged="v => _notas = v" Filas="3" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<Drawer Visible="_detalleVisible" VisibleChanged="v => _detalleVisible = v" Titulo="Detalle de la visita">
    <ChildContent>
        @if (_cargandoDetalle)
        {
            <EstadoCargando Filas="4" />
        }
        else if (_detalle is not null)
        {
            <div class="visitas-detalle-cabecera">
                <span class="visitas-detalle-centro">@_detalle.CentroNombre</span>
                <div class="visitas-detalle-marcas">
                    @if (_filaDetalle is { } filaUrgencia)
                    {
                        <Badge Tono="NivelUrgenciaVisitaUi.Tono(filaUrgencia.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(filaUrgencia.NivelUrgencia)</Badge>
                    }
                    <span class="visitas-detalle-fechas">@TextoFechas(_detalle.FechaInicio, _detalle.FechaFin)</span>
                </div>
            </div>

            <dl class="visitas-detalle-campos">
                <div class="visitas-detalle-campo">
                    <dt>Titular del centro</dt>
                    <dd>@_detalle.ClienteRazonSocial</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>Empresa</dt>
                    <dd>@_detalle.EmpresaRazonSocial</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>Entrada</dt>
                    <dd>@(_detalle.HoraEstimadaAcceso is { } horaAcceso ? horaAcceso.ToString("HH:mm") : "Sin hora fijada")</dd>
                </div>
                @if (_filaDetalle is { } filaOrigen)
                {
                    <div class="visitas-detalle-campo">
                        <dt>Origen</dt>
                        <dd>@TextoOrigen(filaOrigen.Origen)</dd>
                    </div>
                }
                <div class="visitas-detalle-campo">
                    <dt>Trabajadores</dt>
                    <dd>@_detalle.Trabajadores.Count</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>Notificada a la empresa titular</dt>
                    <dd>@(_detalle.NotificadoCliente ? "Sí" : "No")</dd>
                </div>
            </dl>

            @if (_detalle.Tramo is { } tramo)
            {
                <div class="campo">
                    <label>Antelación</label>
                    <p class="texto-vacio-seccion">
                        <Badge Tono="@AntelacionVisitaUi.Tono(tramo)">@AntelacionVisitaUi.Texto(tramo)</Badge>
                        @AntelacionVisitaUi.TextoAtribucion(_detalle.Atribucion)
                    </p>
                    <p class="texto-vacio-seccion">
                        Aviso recibido con @AntelacionVisitaUi.Horas(_detalle.AntelacionNominalHoras) de antelación;
                        el expediente quedó completo @AntelacionVisitaUi.Horas(_detalle.AntelacionEfectivaHoras) antes de la entrada.
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_detalle.Notas))
            {
                <div class="campo">
                    <label>Notas</label>
                    <p class="texto-vacio-seccion">@_detalle.Notas</p>
                </div>
            }

            <h3 class="detalle-visita-subtitulo">Comprobación previa</h3>
            @if (_cargandoDocumentacion)
            {
                <EstadoCargando Filas="3" />
            }
            else if (_errorDocumentacion)
            {
                <EstadoVacio Titulo="No pudimos cargar la documentación" Descripcion="Intenta nuevamente en unos segundos.">
                    <Accion>
                        <Boton OnClick="ReintentarDocumentacionAsync">Reintentar</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else if (_documentacion is not null)
            {
                @if (ResumenComprobacion(_documentacion) is { } resumen)
                {
                    <p class="visitas-detalle-resumen">@resumen</p>
                }

                <SeccionColapsable Titulo="Documentación de la empresa">
                    <Encabezado>
                        <Badge Tono="EstadoDocumentoUi.Tono(_documentacion.Empresa.PeorEstado)">@EstadoDocumentoUi.Texto(_documentacion.Empresa.PeorEstado)</Badge>
                    </Encabezado>
                    <ChildContent>
                        @if (_documentacion.Empresa.Documentos.Count == 0)
                        {
                            <EstadoVacio Titulo="Todo en orden" Descripcion="No hay documentación de empresa pendiente para este centro." />
                        }
                        else
                        {
                            <ul class="workspace-lista-entidades">
                                @foreach (var item in _documentacion.Empresa.Documentos)
                                {
                                    <FilaEntidadRelacionada
                                        @key="item.TipoDocumentoId"
                                        Titulo="@item.TipoDocumentoNombre"
                                        Subtitulo="@(item.FechaVencimiento is null ? "—" : $"Vence: {item.FechaVencimiento:dd/MM/yyyy}")"
                                        OnClic="() => AbrirDocumento(item)">
                                        <Badge Tono="EstadoDocumentoUi.Tono(item.Estado)">@EstadoDocumentoUi.Texto(item.Estado)</Badge>
                                    </FilaEntidadRelacionada>
                                }
                            </ul>
                        }
                    </ChildContent>
                </SeccionColapsable>

                <h3 class="detalle-visita-subtitulo">Trabajadores que entran (@_documentacion.Trabajadores.Count)</h3>
                @if (_documentacion.Trabajadores.Count == 0)
                {
                    <EstadoVacio Titulo="Sin trabajadores" Descripcion="Esta visita todavía no tiene trabajadores asignados." />
                }
                else
                {
                    @foreach (var trabajador in TrabajadoresPorSeveridad(_documentacion))
                    {
                        <SeccionColapsable @key="trabajador.TrabajadorId" Titulo="@($"{trabajador.NombreCompleto} ({trabajador.Dni}) — {trabajador.EmpleadorNombre}")">
                            <Encabezado>
                                <Badge Tono="EstadoDocumentoUi.Tono(trabajador.Documentacion.PeorEstado)">@EstadoDocumentoUi.Texto(trabajador.Documentacion.PeorEstado)</Badge>
                            </Encabezado>
                            <ChildContent>
                                @if (trabajador.Documentacion.Documentos.Count == 0)
                                {
                                    <EstadoVacio Titulo="Todo en orden" Descripcion="No hay documentación pendiente para este centro." />
                                }
                                else
                                {
                                    <ul class="workspace-lista-entidades">
                                        @foreach (var item in trabajador.Documentacion.Documentos)
                                        {
                                            <FilaEntidadRelacionada
                                                @key="item.TipoDocumentoId"
                                                Titulo="@item.TipoDocumentoNombre"
                                                Subtitulo="@(item.FechaVencimiento is null ? "—" : $"Vence: {item.FechaVencimiento:dd/MM/yyyy}")"
                                                OnClic="() => AbrirDocumento(item)">
                                                <Badge Tono="EstadoDocumentoUi.Tono(item.Estado)">@EstadoDocumentoUi.Texto(item.Estado)</Badge>
                                            </FilaEntidadRelacionada>
                                        }
                                    </ul>
                                }
                            </ChildContent>
                        </SeccionColapsable>
                    }
                }
            }
        }
    </ChildContent>
    <Pie>
        @if (_detalle is not null && !_cargandoDetalle)
        {
            @* Solo cambia la marca: MarcarNotificadoClienteCommand no envía
               ningún aviso, así que el texto no puede prometer uno. *@
            <Boton Cargando="_marcandoNotificadoDetalle" OnClick="AlternarNotificadoDesdeDetalleAsync">
                @(_detalle.NotificadoCliente ? "Quitar la marca de notificada" : "Marcar como notificada")
            </Boton>
            <Boton Variante="VarianteBoton.Secundario" OnClick="EditarDesdeDetalleAsync">Editar</Boton>
        }
        else
        {
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _detalleVisible = false">Cerrar</Boton>
        }
    </Pie>
</Drawer>

<VisorDocumento Visible="_visorVisible" VisibleChanged="v => _visorVisible = v" DocumentoId="_visorDocumentoId" Titulo="@_visorTitulo" />

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar la visita a {_centroAEliminar}?")"
    Mensaje="Se ocultará de las listas activas."
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} visita(s)?")"
    Mensaje="Se ocultarán de las listas activas."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />
