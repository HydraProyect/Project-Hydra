@page "/visitas"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Visitas.Commands.CrearVisita
@using CaeManager.Application.Visitas.Commands.EditarVisita
@using CaeManager.Application.Visitas.Commands.CancelarVisita
@using CaeManager.Application.Visitas.Commands.CancelarVisitas
@using CaeManager.Application.Visitas.Commands.ReactivarVisita
@using CaeManager.Application.Visitas.Commands.MarcarNotificadoCliente
@using CaeManager.Application.Visitas.Commands.AnadirTrabajadorAVisita
@using CaeManager.Application.Visitas.Commands.QuitarTrabajadorDeVisita
@using CaeManager.Application.Visitas.Queries.ObtenerCandidatosTrabajadorVisita
@using CaeManager.Application.Visitas.Queries.ObtenerDetalleVisita
@using CaeManager.Application.Visitas.Queries.ObtenerVisitaPorId
@using CaeManager.Application.Visitas.Queries.ObtenerVisitas
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Common
@using CaeManager.Application.Visitas.Queries.ObtenerDocumentacionVisita
@using CaeManager.Domain.Documentos
@using CaeManager.Domain.Visitas
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Visitas.Components
@using CaeManager.Web.Features.Visitas
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.Visitas.Recursos
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosVisitas> Textos
@inject IStringLocalizer<TextosComunes> Comunes

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

@*
    Gen 2 (Visitas TALVEG.dc.html). Vocabulario: los datos traen
    NotificadoCliente / ClienteRazonSocial, pero representan a la Empresa
    titular del Centro de Trabajo. En el texto visible se dice «titular» o
    «empresa titular», nunca «cliente» a secas; los nombres de código son
    deuda terminológica y no se renombran aquí.
*@
<div class="contenedor-pagina">
    <CabeceraPagina Kicker="@Textos["Kicker"]" Titulo="@Textos["TituloPagina"]">
        <Acciones>
            <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync" data-keytip="N">@Textos["BotonNuevaVisita"]</Boton></SoloConEscritura>
        </Acciones>
    </CabeceraPagina>

    <div class="barra-filtros">
        <CampoTexto Placeholder="@Textos["PlaceholderBusqueda"]" Valor="@_busqueda" ValorChanged="BuscarAsync" data-keytip="F" />
        <label class="filtro-critico">
            <input type="checkbox" @bind="_soloActivas" @bind:after="CambiarSoloActivasAsync" /> @Textos["FiltroSoloActivas"]
        </label>
        <label class="filtro-critico">
            <input type="checkbox" @bind="_soloUrgentes" @bind:after="CambiarSoloUrgentesAsync" /> @Textos["FiltroSoloUrgentes"]
        </label>
        <CampoSelect Etiqueta="@Textos["EtiquetaNotificadaTitular"]" Valor="@_filtroNotificado" ValorChanged="FiltrarPorNotificadoAsync">
            <option value="">@Textos["OpcionTodas"]</option>
            <option value="si">@Textos["OpcionSi"]</option>
            <option value="no">@Textos["OpcionNo"]</option>
        </CampoSelect>
        @* No es un filtro (no recorta la lista): por eso no cuenta en HayFiltrosActivos. *@
        <CampoSelect Etiqueta="@Textos["EtiquetaOrden"]" Valor="@_orden" ValorChanged="OrdenarAsync">
            <option value="">@Textos["OpcionOrdenFechas"]</option>
            <option value="documentacion">@Textos["OpcionOrdenDocumentacion"]</option>
        </CampoSelect>
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @* El grid se mantiene siempre montado (solo se oculta con CSS) para que la
           referencia @@ref siga siendo válida y RefreshDataAsync funcione incluso al
           pasar de 0 a 1 elementos — ver Clientes.razor.cs. *@
        <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple">
            <Extra>
                @if (!_cargando && _totalElementos > 0)
                {
                    <span class="visitas-recuento">@TextoRecuento</span>
                }
                @* Lo que la pantalla puede afirmar, comprobado en
                   ObtenerVisitasQueryHandler: la urgencia se calcula en cada
                   consulta con la fecha de hoy y las fechas de la visita
                   (CalculadoraUrgenciaVisita). El mockup dice «recalculada cada
                   hora sobre la fecha de entrada»: no hay tal proceso horario, y
                   la calculadora no mira la hora de entrada. *@
                <span class="visitas-nota-sistema">
                    <span class="visitas-nota-sistema-punto" aria-hidden="true"></span>
                    @Textos["NotaUrgenciaCalculada"]
                </span>
            </Extra>
        </BarraHerramientasLista>

        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="VisitaListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarVisita", context.EmpresaRazonSocial, context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="@Textos["EtiquetaCentro"]" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.CentroNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Centro, context.CentroId, context.CentroNombre, "informacion")'>
                        @context.CentroNombre
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaTitularEmpresa"]" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.ClienteRazonSocial))">
                    <span class="visitas-celda-apilada">
                        <button type="button" class="enlace-nombre-fila" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Cliente, context.ClienteId, context.ClienteRazonSocial, "informacion")'>
                            @context.ClienteRazonSocial
                        </button>
                        <button type="button" class="enlace-nombre-fila visitas-celda-secundaria" @onclick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Empresa, context.EmpresaId, context.EmpresaRazonSocial, "informacion")'>
                            @context.EmpresaRazonSocial
                        </button>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaFechas"]" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.FechaInicio))">
                    @* Patrón de listados (2026-10-08): la fila no lleva menú «⋯» y se pulsa entera. QuickGrid no
                       ofrece clic de fila: «fila-pulsable» (RowClass) y «nombre-abre-vista-rapida» son el contrato
                       con el oyente de atajos-lista.js, que pulsa este botón cuando el clic cae en un punto de la
                       fila sin control. Una Visita no tiene nombre: la identifican el Centro y sus fechas, y los
                       nombres del Centro, del titular y de la Empresa ya abren cada uno su panel, así que el botón
                       de la vista rápida (destino de teclado) son las fechas. *@
                    <span class="visitas-celda-apilada">
                        <button type="button" class="enlace-nombre-fila nombre-abre-vista-rapida"
                                aria-label="@Textos["AriaAbrirVistaRapidaVisita", context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]"
                                @onclick="() => AbrirDetalleAsync(context.Id)">@TextoFechas(context.FechaInicio, context.FechaFin)</button>
                        @if (!context.EstaCancelada)
                        {
                            <span class="visitas-celda-secundaria">@TextoPlazo(context)</span>
                        }
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaTrabajadores"]" Align="Align.Center">
                    @{
                        var nombres = context.Trabajadores ?? [];
                    }
                    @* El recuento abre el desglose de quién entra; pulsar a uno lleva a la pestaña
                       Trabajadores del panel, que es donde se añade o se quita. *@
                    <VentanaContexto Interactiva="true"
                                     Deshabilitada="@(nombres.Count == 0)"
                                     Colocacion="VentanaContextoColocacion.AbajoCentro"
                                     Etiqueta="@Textos["AriaTrabajadoresVisita", context.TotalTrabajadores]"
                                     Titulo="@Textos["VentanaTrabajadoresTitulo"]"
                                     Pie="@Textos["VentanaTrabajadoresPie"]"
                                     class="visitas-recuento-trabajadores">
                        <Disparador>@context.TotalTrabajadores</Disparador>
                        <Detalle>
                            @foreach (var nombre in nombres)
                            {
                                <VentanaContextoElemento Ayuda="@Textos["VentanaTrabajadoresAyuda"]"
                                                         AlPulsar="() => AbrirDetalleAsync(context.Id, PestanaTrabajadores)">@nombre</VentanaContextoElemento>
                            }
                        </Detalle>
                    </VentanaContexto>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaUrgencia"]" Align="Align.Center">
                    @* Los cuatro valores de NivelUrgenciaVisita, «Normal» incluido:
                       una celda vacía no distingue «normal» de «sin calcular». *@
                    <span class="visitas-celda-apilada">
                        <Badge Tono="NivelUrgenciaVisitaUi.Tono(context.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(context.NivelUrgencia)</Badge>
                        @if (context.Tramo is { } tramo)
                        {
                            @* Misma matriz y mismo vocabulario que el detalle (AntelacionVisitaUi);
                               null = sin solicitud de origen medida o expediente aún incompleto. *@
                            <span title="@TituloTramo(context)" data-antelacion-tramo="@tramo">
                                <Badge Tono="@AntelacionVisitaUi.Tono(tramo)">@AntelacionVisitaUi.Texto(tramo)</Badge>
                            </span>
                        }
                    </span>
                </TemplateColumn>
                @* El mockup lleva el origen solo al detalle; aquí se conserva
                   también en la lista porque ya existía y se ordena por él. *@
                <TemplateColumn Title="@Textos["EtiquetaOrigen"]" Align="Align.Center" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.Origen))">
                    <Badge Tono="TonoOrigen(context.Origen)">@TextoOrigen(context.Origen)</Badge>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaDocumentacion"]" Class="col-estado">
                    @if (context.EstaCancelada)
                    {
                        @* FS-11: una Visita cancelada no tiene documentación que gestionar; el motivo va en el title. *@
                        <span title="@context.MotivoCancelacion"><Badge Tono="TonoBadge.Neutro">@Textos["BadgeCancelada"]</Badge></span>
                    }
                    else if (!context.CentroRequiereGestionCae)
                    {
                        @* P1-X2: ni «Gestionada» (verde falso) ni «Por gestionar» (pendiente que no existe). *@
                        <Badge Tono="TonoBadge.Neutro">@Textos["BadgeSinGestionCae"]</Badge>
                    }
                    else if (context.DocumentacionGestionadaEnUtc is { } gestionadaEn)
                    {
                        @* Estado guardado en la Visita: se envió el paquete o se marcó a mano. *@
                        <EstadoFila Correcto="true" Texto="@Textos["BadgeDocumentacionGestionada"]"
                                    Titulo="@Textos["TituloDocumentacionGestionadaEl", CaeManager.Domain.Common.DiaDeNegocio.De(gestionadaEn)]" />
                    }
                    else
                    {
                        @* «Por gestionar» aunque los documentos estén vigentes: el title dice si ya se puede enviar o falta papel. *@
                        <span title="@(context.DocumentacionCompleta ? Textos["TituloPorGestionarDocumentosVigentes"] : Textos["TituloPorGestionarFaltanDocumentos"])"><Badge Tono="TonoBadge.Peligro">@Textos["BadgeDocumentacionPorGestionar"]</Badge></span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaNotificadaTitular"]" Align="Align.Center" Sortable="true" SortBy="@(GridSort<VisitaListaDto>.ByAscending(v => v.NotificadoCliente))">
                    @* El interruptor es a la vez el dato y el disparador de MarcarNotificadoClienteCommand
                       (ICommand que AutorizacionEscrituraBehavior deniega a Consulta). Ocultarlo, como hace
                       SoloConEscritura, dejaría la columna sin dato: a Consulta se le pinta deshabilitado. *@
                    <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionNotificada">
                        <Authorized>
                            <input type="checkbox" role="switch" class="visitas-interruptor" checked="@context.NotificadoCliente"
                                   title="@Textos["AyudaNotificadaSoloMarca"]"
                                   aria-label="@Textos["AriaNotificadaTitular", context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]"
                                   disabled="@(context.EstaCancelada || _marcandoNotificado.Contains(context.Id))"
                                   @onchange="e => AlternarNotificadoAsync(context.Id, e.Value is bool marcado && marcado)" />
                        </Authorized>
                        <NotAuthorized>
                            <input type="checkbox" role="switch" class="visitas-interruptor" checked="@context.NotificadoCliente"
                                   title="@Textos["AyudaNotificadaSoloMarca"]"
                                   aria-label="@Textos["AriaNotificadaTitular", context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]"
                                   disabled />
                        </NotAuthorized>
                    </AuthorizeView>
                </TemplateColumn>
                @* Sin menú «⋯». Lo que hacía ese menú: «Ver» es el clic en la fila, sus fechas o Enter;
                   «Editar», el lápiz de la cabecera del panel y la tecla «e»; «Cancelar visita», la selección
                   múltiple (☑ de la barra o tecla «x»), con su pregunta, su motivo y su «Deshacer»; «Reactivar»
                   es la acción rápida de la fila cancelada y sigue en el pie del panel. El icono lleva a la
                   página Visita 360 (/visitas/{id}). *@
                <TemplateColumn Title="" Align="Align.End">
                    <span class="visitas-celda-acciones">
                        @if (context.EstaCancelada)
                        {
                            @* FS-11: reactivar se ofrece a los mismos roles que cancelar; la autorización
                               real, con el alcance de cartera, está en AutorizacionCancelacionVisita. *@
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                       aria-label="@Textos["AriaReactivarVisita", context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]"
                                       OnClick="() => AbrirReactivar(context.Id, context.Version, context.CentroNombre)">@Textos["AccionReactivar"]</Boton>
                            </SoloConEscritura>
                        }
                        <Boton360 Nombre="@Textos["NombreVisitaPara360", context.CentroNombre, TextoFechas(context.FechaInicio, context.FechaFin)]" Href="@($"/visitas/{context.Id}")" />
                    </span>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @* TRES estados vacíos, no dos, y la razón es que "Solo activas" viene
           MARCADO de fábrica (_soloActivas = true). El patrón de dos estados que
           usan las demás listas no se traslada aquí:

           - contarlo como filtro dejaría "Todavía no hay visitas" inalcanzable,
             porque siempre habría un filtro puesto;
           - no contarlo haría que esa misma frase mintiera a quien sí tiene
             visitas, pero todas finalizadas.

           Cada uno de los tres dice algo que es cierto, y ofrece la salida que
           corresponde. *@
        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltroTitulo"]"
                         Descripcion="@Textos["VacioFiltroDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando && _soloActivas)
        {
            @* Sin más filtros que el de fábrica: puede haber visitas finalizadas
               detrás. Decir "crea la primera" aquí sería falso, y ofrecer
               "quitar los filtros" señalaría algo que el usuario no puso. *@
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioActivasTitulo"]"
                         Descripcion="@Textos["VacioActivasDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="VerTambienFinalizadasAsync">@Textos["BotonVerFinalizadas"]</Boton>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" OnClick="AbrirCrearAsync">@Textos["BotonNuevaVisita"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="@Textos["VacioInicialTitulo"]" Descripcion="@Textos["VacioInicialDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" OnClick="AbrirCrearAsync">@Textos["BotonNuevaVisita"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync"
                 Titulo="@(_editandoId is null ? Textos["DrawerTituloNueva"].Value : Textos["DrawerTituloEditar"].Value)"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@(_erroresCampo.Count > 0)" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    @if (_sugerenciaVisitaResumen is not null)
    {
        <div class="alerta-info">@Textos["AvisoPrellenado", _sugerenciaVisitaResumen]</div>
    }

    @if (_editandoId is null)
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaCentro"]" Valor="@_centroId" ValorChanged="AlCambiarCentroAsync">
            <option value="">@Textos["OpcionSeleccionaCentro"]</option>
            @foreach (var centro in _centrosDisponibles)
            {
                <option value="@centro.Id">@centro.Nombre (@centro.ClienteRazonSocial — @centro.EmpresaRazonSocial)</option>
            }
        </CampoSelect>
    }
    else
    {
        <div class="campo">
            <label>@Textos["EtiquetaCentro"]</label>
            <p class="texto-vacio-seccion">@_centroNombreEnEdicion</p>
        </div>
    }

    <CampoTexto Etiqueta="@Textos["EtiquetaFechaInicio"]" Type="date" Valor="@_fechaInicio" ValorChanged="v => _fechaInicio = v" />
    <CampoTexto Etiqueta="@Textos["EtiquetaFechaFin"]" Type="date" Valor="@_fechaFin" ValorChanged="v => _fechaFin = v" />
    <CampoTexto Etiqueta="@Textos["EtiquetaHoraEntrada"]" Type="time"
                Valor="@_horaEstimadaAcceso" ValorChanged="v => _horaEstimadaAcceso = v" />

    @if (_avisoCentroSinAsignados)
    {
        <div class="alerta-info" role="status">@Textos["AvisoCentroSinTrabajadoresAsignados"]</div>
    }

    <SelectorMultiple @ref="_selectorTrabajadores"
                       Relacionados="@_trabajadoresRelacionados"
                       SoloRelacionados="@_soloRelacionados"
                       SoloRelacionadosChanged="v => _soloRelacionados = v"
                       Etiqueta="@Textos["EtiquetaTrabajadoresQueEntran"]"
                       Elementos="@_trabajadoresDisponiblesSelector"
                       Seleccionados="@_trabajadorIdsSeleccionados"
                       OnAlternar="args => AlternarTrabajador(args.Id, args.Marcado)"
                       TextoVacio="@Textos["SelectorTrabajadoresVacio"]"
                       MensajeError="@_errorTrabajadores" />

    <label class="campo-checkbox">
        <input type="checkbox" @bind="_notificadoCliente" /> @Textos["CasillaNotificadaTitularCentro"]
    </label>

    <CampoTextarea Etiqueta="@Textos["EtiquetaNotas"]" Valor="@_notas" ValorChanged="v => _notas = v" Filas="3" />
</DrawerFormulario>

<Drawer Visible="_detalleVisible" VisibleChanged="v => _detalleVisible = v" Titulo="@Textos["DetalleTitulo"]">
    <ChildContent>
        @if (_cargandoDetalle)
        {
            <EstadoCargando Filas="4" />
        }
        else if (_detalle is not null)
        {
            <div class="visitas-detalle-cabecera">
                <div class="visitas-detalle-titulo">
                    <span class="visitas-detalle-centro">@_detalle.CentroNombre</span>
                    @if (!_detalle.EstaCancelada)
                    {
                        @* El lápiz vive en la cabecera, a la vista en las tres pestañas (patrón de listados: la fila
                           no lleva menú). Abre el mismo formulario que «Editar» del pie y que la tecla «e» sobre la
                           fila enfocada. EditarVisitaCommand es un ICommand denegado a Consulta: no se le ofrece.
                           Una Visita cancelada no se edita; se reactiva. *@
                        <SoloConEscritura>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="EditarDesdeDetalleAsync"
                                   aria-label="@Textos["AriaEditarVisita"]" title="@Textos["AccionEditar"]">
                                <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
                            </Boton>
                        </SoloConEscritura>
                    }
                </div>
                <div class="visitas-detalle-marcas">
                    @if (_filaDetalle is { } filaUrgencia)
                    {
                        <Badge Tono="NivelUrgenciaVisitaUi.Tono(filaUrgencia.NivelUrgencia)">@NivelUrgenciaVisitaUi.Texto(filaUrgencia.NivelUrgencia)</Badge>
                    }
                    <span class="visitas-detalle-fechas">@TextoFechas(_detalle.FechaInicio, _detalle.FechaFin)</span>
                </div>
                @* El Drawer es la consulta rápida; la Visita tiene además su página 360. *@
                <a class="visitas-detalle-pagina" href="@($"/visitas/{_detalle.Id}")">@Textos["DetalleAbrirPagina"]</a>
            </div>

            @* Tres pestañas, como el resto de paneles de listado: la cabecera (Centro, urgencia y fechas) queda fija encima. *@
            <Pestanas Definiciones="PestanasDetalle" PestanaActiva="@_pestanaDetalle" PestanaActivaChanged="CambiarPestanaDetalle"
                      EtiquetaGrupo="@Textos["PestanasDetalleEtiqueta"]">
            @if (_pestanaDetalle == PestanaTrabajadores)
            {
                @*
                    Quién entra, con alta y baja sin abrir «Editar». Las dos escrituras son ICommand
                    (AnadirTrabajadorAVisitaCommand / QuitarTrabajadorDeVisitaCommand) con la autorización y
                    el alcance de EditarVisitaCommand; a Consulta y en una Visita cancelada la lista queda
                    de solo lectura.
                *@
                @if (_detalle.Trabajadores.Count == 0)
                {
                    <p class="texto-vacio-seccion">@Textos["TrabajadoresPanelVacio"]</p>
                }
                else
                {
                    <ul class="visitas-trabajadores-lista" aria-label="@Textos["TrabajadoresPanelLista"]">
                        @foreach (var trabajador in _detalle.Trabajadores)
                        {
                            <li @key="trabajador.Id" class="visitas-trabajador-fila">
                                <span class="visitas-trabajador-nombre">@trabajador.NombreCompleto</span>
                                @if (!_detalle.EstaCancelada)
                                {
                                    <SoloConEscritura>
                                        <button type="button" class="visitas-trabajador-quitar"
                                                aria-label="@Textos["AriaQuitarTrabajador", trabajador.NombreCompleto]"
                                                title="@(_detalle.Trabajadores.Count == 1 ? Textos["AyudaQuitarUltimoTrabajador"].Value : Textos["AyudaQuitarTrabajador"].Value)"
                                                disabled="@(_detalle.Trabajadores.Count == 1 || _cambiandoTrabajadores)"
                                                @onclick="() => AbrirQuitarTrabajador(trabajador)">
                                            <Icono Nombre="menos" Tamano="TamanoIcono.Pequeno" />
                                        </button>
                                    </SoloConEscritura>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (!_detalle.EstaCancelada)
                {
                    <SoloConEscritura>
                        @if (_selectorCandidatosVisible)
                        {
                            <SelectorCandidatoTrabajador Candidatos="_candidatos" Deshabilitado="_cambiandoTrabajadores"
                                                         AlElegir="AnadirTrabajadorAsync" AlVolver="CerrarSelectorCandidatos" />
                        }
                        else
                        {
                            <Boton Variante="VarianteBoton.Secundario" Cargando="_cargandoCandidatos" Deshabilitado="_cambiandoTrabajadores"
                                   OnClick="AbrirAnadirTrabajadorAsync">@Textos["BotonAnadirTrabajador"]</Boton>
                        }
                    </SoloConEscritura>
                }
            }
            else if (_pestanaDetalle == PestanaInformacion)
            {
            <dl class="visitas-detalle-campos">
                <div class="visitas-detalle-campo">
                    <dt>@Textos["DetalleTitularCentro"]</dt>
                    <dd>@_detalle.ClienteRazonSocial</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>@Textos["DetalleEmpresa"]</dt>
                    <dd>@_detalle.EmpresaRazonSocial</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>@Textos["DetalleEntrada"]</dt>
                    <dd>@(_detalle.HoraEstimadaAcceso is { } horaAcceso ? horaAcceso.ToString("HH:mm") : Textos["DetalleSinHora"].Value)</dd>
                </div>
                @if (_filaDetalle is { } filaOrigen)
                {
                    <div class="visitas-detalle-campo">
                        <dt>@Textos["EtiquetaOrigen"]</dt>
                        <dd>@TextoOrigen(filaOrigen.Origen)</dd>
                    </div>
                }
                <div class="visitas-detalle-campo">
                    <dt>@Textos["EtiquetaTrabajadores"]</dt>
                    <dd>@_detalle.Trabajadores.Count</dd>
                </div>
                <div class="visitas-detalle-campo">
                    <dt>@Textos["EtiquetaNotificadaTitular"]</dt>
                    <dd>@(_detalle.NotificadoCliente ? Textos["OpcionSi"].Value : Textos["OpcionNo"].Value)</dd>
                </div>
                @if (_detalle is { CentroRequiereGestionCae: true, EstaCancelada: false })
                {
                    <div class="visitas-detalle-campo visitas-detalle-campo-ancho">
                        <dt>@Textos["ColumnaDocumentacion"]</dt>
                        <dd class="visitas-detalle-documentacion">
                            <span>@TextoDocumentacionGestionada(_detalle)</span>
                            @* Salida manual de «Por gestionar»: lo gestionado fuera de TALVEG (portal del
                               titular, otro correo). Vive junto al dato y no en el pie: con «Marcar como
                               notificada» y «Editar», un tercer botón no cabe en el ancho del panel. *@
                            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionMarca">
                                @if (_detalle.DocumentacionGestionadaEnUtc is null)
                                {
                                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Cargando="_marcandoDocumentacionGestionada" OnClick="MarcarDocumentacionGestionadaAsync">@Textos["BotonMarcarDocumentacionGestionada"]</Boton>
                                }
                                else
                                {
                                    @* Deshacer: una marca puesta por error vuelve a «Por gestionar». *@
                                    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Cargando="_marcandoDocumentacionGestionada" OnClick="QuitarMarcaDocumentacionGestionadaAsync">@Textos["BotonQuitarMarcaDocumentacionGestionada"]</Boton>
                                }
                            </AuthorizeView>
                        </dd>
                    </div>
                }
            </dl>

            @if (_detalle.Tramo is { } tramo)
            {
                <div class="campo">
                    <label>@Textos["DetalleAntelacion"]</label>
                    <p class="texto-vacio-seccion">
                        <Badge Tono="@AntelacionVisitaUi.Tono(tramo)">@AntelacionVisitaUi.Texto(tramo)</Badge>
                        @AntelacionVisitaUi.TextoAtribucion(_detalle.Atribucion)
                    </p>
                    <p class="texto-vacio-seccion">
                        @Textos["DetalleAntelacionHoras", AntelacionVisitaUi.Horas(_detalle.AntelacionNominalHoras), AntelacionVisitaUi.Horas(_detalle.AntelacionEfectivaHoras)]
                    </p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_detalle.Notas))
            {
                <div class="campo">
                    <label>@Textos["EtiquetaNotas"]</label>
                    <p class="texto-vacio-seccion">@_detalle.Notas</p>
                </div>
            }

            @if (_detalle.EstaCancelada)
            {
                @* Se dice también aquí, que es donde se abre el panel: en «Documentación» no hay nada que gestionar. *@
                <p class="texto-vacio-seccion">@Textos["DetalleCanceladaSinAcciones"]</p>
            }
            }
            else if (_detalle.EstaCancelada)
            {
                @* FS-11: una Visita cancelada no pide acceso, ni se avisa, ni se comprueba su documentación. *@
                <p class="texto-vacio-seccion">@Textos["DetalleCanceladaSinAcciones"]</p>
            }
            else if (!_detalle.CentroRequiereGestionCae)
            {
                @*
                    P1-X2: el Centro no requiere gestión CAE, así que no hay
                    comprobación previa que hacer. En su lugar, el aviso de la
                    visita listo para copiar y pegar en un correo — sin M365
                    (D-1) y sin DNI ni datos sensibles (#856): lo compone
                    ObtenerAvisoVisitaQuery, no la página.
                *@
                <h3 class="detalle-visita-subtitulo">@Textos["SubtituloAvisoVisita"]</h3>
                <p class="texto-vacio-seccion">@Textos["AvisoVisitaExplicacion"]</p>
                @if (_cargandoAviso)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_aviso is null)
                {
                    <p class="alerta-formulario" role="alert">@(_errorAviso ?? Textos["ErrorAvisoVisita"].Value)</p>
                }
                else
                {
                    <div class="visitas-aviso">
                        <p class="visitas-aviso-asunto">@_aviso.Asunto</p>
                        <pre class="visitas-aviso-cuerpo">@_aviso.Cuerpo</pre>
                        <BotonCopiar Valor="@TextoAvisoParaCopiar(_aviso)" Etiqueta="@Textos["AvisoVisitaEtiquetaCopiar"]" Texto="@Textos["AvisoVisitaCopiar"]" />
                    </div>
                }
            }
            else
            {
            @if (_detalle.CentroGestionadoPorCorreo)
            {
                @*
                    P1-X1: el Centro se gestiona por correo, no por una
                    plataforma. El correo de solicitud de acceso para copiar y
                    el zip con la documentación vigente para adjuntarlo a mano —
                    sin M365 (D-1), mismo patrón que el aviso de P1-X2. El texto
                    lo compone ObtenerSolicitudAccesoCorreoQuery; el zip lo sirve
                    /visitas/{id}/paquete-documental.zip, que autoriza y registra
                    el acceso a los documentos sensibles.
                *@
                <h3 class="detalle-visita-subtitulo">@Textos["SubtituloSolicitudAccesoCorreo"]</h3>
                <p class="texto-vacio-seccion">@Textos["SolicitudAccesoCorreoExplicacion"]</p>
                @if (_cargandoSolicitudCorreo)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_solicitudCorreo is null)
                {
                    <p class="alerta-formulario" role="alert">@(_errorSolicitudCorreo ?? Textos["ErrorSolicitudAccesoCorreo"].Value)</p>
                }
                else
                {
                    <div class="visitas-aviso visitas-solicitud-correo">
                        <p class="visitas-aviso-destinatarios">@Textos["SolicitudAccesoCorreoPara"] @_solicitudCorreo.Destinatarios</p>
                        <p class="visitas-aviso-asunto">@_solicitudCorreo.Asunto</p>
                        <pre class="visitas-aviso-cuerpo">@_solicitudCorreo.Cuerpo</pre>
                        <div class="visitas-aviso-acciones">
                            <BotonCopiar Valor="@TextoSolicitudParaCopiar(_solicitudCorreo)" Etiqueta="@Textos["SolicitudAccesoCorreoEtiquetaCopiar"]" Texto="@Textos["SolicitudAccesoCorreoCopiar"]" />
                            @* Decisión del 2026-10-08: el rol Consulta conserva «Copiar solicitud»; enviar y
                               descargar el ZIP son de quien escribe. Aquí solo se dejan de pintar: quien lo
                               decide es ObtenerPaqueteDocumentalVisitaQuery, que le niega el paquete. *@
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Secundario" Cargando="_preparandoEnvioPaquete" OnClick="AbrirEnviarPaquetePorCorreoAsync">@Textos["EnviarPaquetePorCorreo"]</Boton>
                                <Boton Variante="VarianteBoton.Secundario" Href="@RutaPaqueteDocumental(_detalle.Id)" download data-enhance-nav="false">@Textos["DescargarPaqueteDocumental"]</Boton>
                            </SoloConEscritura>
                        </div>
                        @if (_avisoEnvioPaquete is not null)
                        {
                            <p class="alerta-formulario" role="alert">@_avisoEnvioPaquete</p>
                        }
                    </div>
                }
            }

            <h3 class="detalle-visita-subtitulo">@Textos["SubtituloComprobacionPrevia"]</h3>
            @if (_cargandoDocumentacion)
            {
                <EstadoCargando Filas="3" />
            }
            else if (_errorDocumentacion)
            {
                <EstadoVacio Titulo="@Textos["ErrorDocumentacionTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
                    <Accion>
                        <Boton Variante="VarianteBoton.Primario" OnClick="ReintentarDocumentacionAsync">@Comunes["Reintentar"]</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else if (_documentacion is not null)
            {
                @if (ResumenComprobacion(_documentacion) is { } resumen)
                {
                    <p class="visitas-detalle-resumen">@resumen</p>
                }

                <SeccionColapsable Titulo="@Textos["SeccionDocumentacionEmpresa"]">
                    <Encabezado>
                        <Badge Tono="EstadoDocumentoUi.Tono(_documentacion.Empresa.PeorEstado)">@EstadoDocumentoUi.Texto(_documentacion.Empresa.PeorEstado)</Badge>
                    </Encabezado>
                    <ChildContent>
                        @if (_documentacion.Empresa.Documentos.Count == 0)
                        {
                            <EstadoVacio Titulo="@Textos["VacioDocumentosTitulo"]" Descripcion="@Textos["VacioDocumentosEmpresaDescripcion"]" />
                        }
                        else
                        {
                            <ul class="workspace-lista-entidades">
                                @foreach (var item in _documentacion.Empresa.Documentos)
                                {
                                    <FilaEntidadRelacionada
                                        @key="item.TipoDocumentoId"
                                        Titulo="@item.TipoDocumentoNombre"
                                        Subtitulo="@(item.FechaVencimiento is null ? "—" : Textos["SubtituloVence", item.FechaVencimiento].Value)"
                                        OnClic="() => AbrirDocumento(item)">
                                        <Badge Tono="EstadoDocumentoUi.Tono(item.Estado)">@EstadoDocumentoUi.Texto(item.Estado)</Badge>
                                    </FilaEntidadRelacionada>
                                }
                            </ul>
                        }
                    </ChildContent>
                </SeccionColapsable>

                <h3 class="detalle-visita-subtitulo">@Textos["SubtituloTrabajadoresQueEntran", _documentacion.Trabajadores.Count]</h3>
                @if (_documentacion.Trabajadores.Count == 0)
                {
                    <EstadoVacio Titulo="@Textos["VacioTrabajadoresTitulo"]" Descripcion="@Textos["VacioTrabajadoresDescripcion"]" />
                }
                else
                {
                    @foreach (var trabajador in TrabajadoresPorSeveridad(_documentacion))
                    {
                        <SeccionColapsable @key="trabajador.TrabajadorId" Titulo="@($"{trabajador.NombreCompleto} — {trabajador.EmpleadorNombre}")">
                            <Encabezado>
                                <Badge Tono="EstadoDocumentoUi.Tono(trabajador.Documentacion.PeorEstado)">@EstadoDocumentoUi.Texto(trabajador.Documentacion.PeorEstado)</Badge>
                            </Encabezado>
                            <ChildContent>
                                @if (trabajador.Documentacion.Documentos.Count == 0)
                                {
                                    <EstadoVacio Titulo="@Textos["VacioDocumentosTitulo"]" Descripcion="@Textos["VacioDocumentosTrabajadorDescripcion"]" />
                                }
                                else
                                {
                                    <ul class="workspace-lista-entidades">
                                        @foreach (var item in trabajador.Documentacion.Documentos)
                                        {
                                            <FilaEntidadRelacionada
                                                @key="item.TipoDocumentoId"
                                                Titulo="@item.TipoDocumentoNombre"
                                                Subtitulo="@(item.FechaVencimiento is null ? "—" : Textos["SubtituloVence", item.FechaVencimiento].Value)"
                                                OnClic="() => AbrirDocumento(item)">
                                                <Badge Tono="EstadoDocumentoUi.Tono(item.Estado)">@EstadoDocumentoUi.Texto(item.Estado)</Badge>
                                            </FilaEntidadRelacionada>
                                        }
                                    </ul>
                                }
                            </ChildContent>
                        </SeccionColapsable>
                    }
                }
            }
            }
            </Pestanas>
        }
    </ChildContent>
    <Pie>
        @if (_detalle is { EstaCancelada: true } && !_cargandoDetalle)
        {
            @* FS-11: una Visita cancelada no se edita ni se marca; se reactiva (solo quien puede). *@
            <span class="visitas-cancelada-aviso" role="status">
                @(string.IsNullOrWhiteSpace(_detalle.MotivoCancelacion) ? Textos["DetalleCancelada"].Value : Textos["DetalleCanceladaMotivo", _detalle.MotivoCancelacion].Value)
            </span>
            <SoloConEscritura>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => AbrirReactivar(_detalle.Id, _detalle.Version, _detalle.CentroNombre)">@Textos["AccionReactivar"]</Boton>
            </SoloConEscritura>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _detalleVisible = false">@Textos["BotonCerrar"]</Boton>
        }
        else if (_detalle is not null && !_cargandoDetalle)
        {
            @* Solo cambia la marca: MarcarNotificadoClienteCommand no envía
               ningún aviso, así que el texto no puede prometer uno. *@
            @* Marcar notificada y Editar son ICommand que AutorizacionEscrituraBehavior deniega a
               Consulta: no se le ofrecen, y el pie no queda vacío, le queda Cerrar. *@
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionPie">
                <Authorized>
                    <Boton Variante="VarianteBoton.Primario" Cargando="_marcandoNotificadoDetalle" OnClick="AlternarNotificadoDesdeDetalleAsync">
                        @(_detalle.NotificadoCliente ? Textos["BotonQuitarMarcaNotificada"].Value : Textos["BotonMarcarNotificada"].Value)
                    </Boton>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="EditarDesdeDetalleAsync">@Textos["AccionEditar"]</Boton>
                </Authorized>
                <NotAuthorized>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="() => _detalleVisible = false">@Textos["BotonCerrar"]</Boton>
                </NotAuthorized>
            </AuthorizeView>
        }
        else
        {
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => _detalleVisible = false">@Textos["BotonCerrar"]</Boton>
        }
    </Pie>
</Drawer>

<VisorDocumento Visible="_visorVisible" VisibleChanged="v => _visorVisible = v" DocumentoId="_visorDocumentoId" Titulo="@_visorTitulo" />

@* Quitar un Trabajador pregunta antes: el patrón «Deshacer» de los listados (Listados 5/7) aún no está en main. *@
<DialogoConfirmacion
    Visible="_confirmarQuitarTrabajadorVisible"
    VisibleChanged="v => _confirmarQuitarTrabajadorVisible = v"
    Titulo="@Textos["ConfirmarQuitarTrabajadorTitulo", _trabajadorAQuitar?.NombreCompleto ?? string.Empty]"
    Mensaje="@Textos["ConfirmarQuitarTrabajadorMensaje"]"
    TextoBotonConfirmar="@Textos["BotonQuitarTrabajador"]"
    TextoBotonDescartar="@Textos["BotonVolver"]"
    EnProgreso="_cambiandoTrabajadores"
    OnConfirmar="ConfirmarQuitarTrabajadorAsync" />

<DialogoConfirmacion
    Visible="_confirmarReactivarVisible"
    VisibleChanged="v => _confirmarReactivarVisible = v"
    HayCambios="() => HayMotivoSinConfirmar(_confirmarReactivarVisible, _motivoReactivacion)"
    Titulo="@Textos["ConfirmarReactivarTitulo", _centroAReactivar]"
    Mensaje="@Textos["ConfirmarReactivarMensaje"]"
    TextoBotonConfirmar="@Textos["AccionReactivar"]"
    TextoBotonDescartar="@Textos["BotonVolver"]"
    VarianteConfirmar="VarianteBoton.Primario"
    EnProgreso="_reactivando"
    OnConfirmar="ConfirmarReactivarAsync">
    <CampoTextarea Etiqueta="@Textos["EtiquetaMotivoOpcional"]" Valor="@_motivoReactivacion" ValorChanged="v => _motivoReactivacion = v" Filas="2" />
</DialogoConfirmacion>

@* Cancelar una Visita solo se hace desde aquí, también cuando es una sola (la fila no lleva menú): pregunta, admite
   motivo y ofrece «Deshacer». La única acción del lote es cancelar (ICommand que AutorizacionEscrituraBehavior deniega a
   Consulta): la barra no se le ofrece. La palanca de selección múltiple sigue visible porque
   vive en BarraHerramientasLista, compartida y con contenido de lectura, y seleccionar no escribe. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_cancelandoLote" TextoAccion="@Textos["BotonCancelarSeleccionadas"]" TextoLimpiar="@Textos["BotonQuitarSeleccion"]"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="AbrirCancelarLote" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarCancelarLoteVisible"
    VisibleChanged="v => _confirmarCancelarLoteVisible = v"
    HayCambios="() => HayMotivoSinConfirmar(_confirmarCancelarLoteVisible, _motivoCancelacion)"
    Titulo="@Textos["ConfirmarCancelarLoteTitulo", _seleccionados.Count]"
    Mensaje="@Textos["ConfirmarCancelarLoteMensaje"]"
    TextoBotonConfirmar="@Textos["BotonCancelarSeleccionadas"]"
    TextoBotonDescartar="@Textos["BotonVolver"]"
    EnProgreso="_cancelandoLote"
    OnConfirmar="ConfirmarCancelarLoteAsync">
    <CampoTextarea Etiqueta="@Textos["EtiquetaMotivoOpcional"]" Valor="@_motivoCancelacion" ValorChanged="v => _motivoCancelacion = v" Filas="2" />
</DialogoConfirmacion>

@* Salir de la pantalla con un «Motivo (opcional)» escrito en alguno de los dos diálogos de confirmación pregunta; el cierre
   del propio diálogo (X, Escape, fondo, «Volver») lo pregunta el DialogoConfirmacion con ese mismo HayCambios. *@
<AvisoCambiosSinGuardar HayCambios="HayMotivoEnAlgunDialogo" AlDescartar="CerrarDialogosDescartando" />

@* Enviar el paquete por correo: el compositor de Comunicaciones llega con el contacto del Centro, el asunto y el cuerpo de
   la solicitud (los compone ObtenerSolicitudAccesoCorreoQuery) y el ZIP adjunto. Nada sale hasta que el Gestor CAE pulsa «Enviar». *@
<RedactarMensajeDrawer Visible="_composerPaqueteVisible" VisibleChanged="v => _composerPaqueteVisible = v"
                       DestinatariosIniciales="@_solicitudCorreo?.Destinatarios" AsuntoInicial="@_solicitudCorreo?.Asunto"
                       CuerpoInicial="@_solicitudCorreo?.Cuerpo" Adjunto="_adjuntoPaquete"
                       RutaDescargaAdjunto="@(_detalle is null ? null : RutaPaqueteDocumental(_detalle.Id))"
                       EnviarCon="EnviarPaqueteDeLaVisitaAsync" OnEnviado="AlEnviarPaqueteAsync" />

</LimiteDeErrores>
