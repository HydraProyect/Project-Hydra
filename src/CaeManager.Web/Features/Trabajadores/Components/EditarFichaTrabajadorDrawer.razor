@using CaeManager.Application.Trabajadores
@using CaeManager.Domain.Trabajadores
@using CaeManager.Application.Trabajadores.Commands.EditarFichaTrabajador
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadorPorId
@using CaeManager.Domain.Common
@using CaeManager.Web.Features.Trabajadores.Recursos
@using FluentValidation
@using MediatR
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosTrabajadores> Textos

<DrawerFormulario Visible="Visible" VisibleChanged="VisibleChanged" Titulo="@Textos["FichaEditarTitulo"]"
    Cargando="_cargando" HayCambios="() => Visible && _lista && _instantanea.Difiere(Instantanea())"
    Guardando="_guardando" MensajeError="@_error" HayErroresDeCampo="@HayErroresDelPasoVisible"
    MotivoGuardarDeshabilitado="@(!_lista ? Textos["FichaNoDisponible"].Value : null)" OnGuardar="GuardarAsync"
    TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]"
    Pasos="@(_cargando || _lista ? PasosEdicion : null)" PasoActual="@_paso" PasosCompletados="_pasosVistos"
    EtiquetaPasos="@Textos["EtiquetaPasosEditar"]" OnPasoSeleccionado="IrAPaso" OnSiguiente="SiguienteAsync" OnAtras="Atras">
    @* Edición en pasos («Panel Formulario TALVEG»), los mismos que el alta (Lo básico, Trabajo y Contacto) más «Situación» para lo que
       el alta no pide. Solo cambia la presentación: no hay un comando por paso, «Guardar» (o «Guardar y terminar» desde un paso
       intermedio) envía el EditarFichaTrabajadorCommand único con todo, y un error de campo lleva al paso donde está el campo. *@
    @if (_paso == PasoBasico)
    {
        <CampoTexto Etiqueta="@Textos["CorregirDocumentoEtiqueta"]" Valor="@_documento" ValorChanged="CambiarDocumento" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.Documento))" />
        @if (_documento != _documentoCargado && CriterioDocumentoIdentidadTrabajador.Clasificar(_documento).SeGuardaComoPasaporte)
        {
            <p class="texto-ayuda-campo">@CriterioDocumentoIdentidadTrabajador.AvisoPasaporte</p>
        }
        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.Nombre))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaApellidos"]" Valor="@_apellidos" ValorChanged="v => _apellidos = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.Apellidos))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaFechaNacimiento"]" Type="date" Valor="@_nacimiento" ValorChanged="v => _nacimiento = v" FechaNoValidaChanged="v => MarcarFechaNoValida(nameof(EditarFichaTrabajadorCommand.FechaNacimiento), v)" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.FechaNacimiento))" />
        <CampoTexto Etiqueta="@Textos["FichaNacionalidad"]" Valor="@_nacionalidad" ValorChanged="v => _nacionalidad = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.Nacionalidad))" />
    }
    else if (_paso == PasoTrabajo)
    {
        @* Oficio y Delegación (decisión de Chris, 2026-10-18): solo con un Trabajador de Empresa; el Oficio ocupa el sitio del
           Puesto. El de una Subcontrata sigue con el Puesto en texto. *@
        @if (_empresaId is { } empresaDelCatalogo)
        {
            <SelectorDelegacionEmpresaYOficio EmpresaId="empresaDelCatalogo"
                                       OficioId="@_oficioId" OficioIdChanged="v => _oficioId = v"
                                       DelegacionEmpresaId="@_delegacionId" DelegacionEmpresaIdChanged="v => _delegacionId = v"
                                       PuestoActual="@_puesto" />
        }
        else
        {
            <CampoTexto Etiqueta="@Textos["FichaPuesto"]" Valor="@_puesto" ValorChanged="v => _puesto = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.Puesto))" />
        }
        <CampoSelect Etiqueta="@Textos["EtiquetaTipoContratacion"]" Valor="@_tipoContratacion" ValorChanged="v => _tipoContratacion = v">
            <option value="CuentaAjena">@Textos["TipoContratacionCuentaAjena"]</option>
            <option value="Autonomo">@Textos["TipoContratacionAutonomo"]</option>
            <option value="Voluntario">@Textos["TipoContratacionVoluntario"]</option>
        </CampoSelect>
        <CampoTexto Etiqueta="@Textos["FichaTipoVinculo"]" Valor="@_vinculo" ValorChanged="v => _vinculo = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.TipoVinculo))" />
        <CampoTexto Etiqueta="@Textos["FichaAltaEmpresa"]" Type="date" Valor="@_alta" ValorChanged="v => _alta = v" FechaNoValidaChanged="v => MarcarFechaNoValida(nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa), v)" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa))" />
        <CampoTexto Etiqueta="@Textos["FichaBaja"]" Type="date" Valor="@_baja" ValorChanged="v => _baja = v" FechaNoValidaChanged="v => MarcarFechaNoValida(nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa), v)" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa))" />
    }
    else if (_paso == PasoContacto)
    {
        @* El contacto de emergencia solo se edita si el servidor lo envió (ContactoEmergenciaVisible): sin él no hay paso, la orden
           lleva ContactoEmergencia = null y no lo toca, en vez de borrarlo con unos campos que el lector no pudo ver. *@
        <CampoTexto Etiqueta="@Textos["FichaContactoEmergencia"]" Valor="@_emergenciaNombre" ValorChanged="v => _emergenciaNombre = v" MensajeError="@Error(CampoEmergenciaNombre)" />
        <CampoTexto Etiqueta="@Textos["FichaTelefonoEmergencia"]" Type="tel" Valor="@_emergenciaTelefono" ValorChanged="v => _emergenciaTelefono = v" MensajeError="@Error(CampoEmergenciaTelefono)" />
    }
    else
    {
        <CampoTexto Etiqueta="@Textos["FichaAfiliacion"]" Valor="@_afiliacion" ValorChanged="v => _afiliacion = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.NumeroAfiliacionSeguridadSocial))" />
        <CampoTexto Etiqueta="@Textos["FichaFiguraRnt"]" Valor="@_rnt" ValorChanged="v => _rnt = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.FiguraEnRnt))" />
        <CampoTexto Etiqueta="@Textos["FichaTipoPermiso"]" Valor="@_permiso" ValorChanged="v => _permiso = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.TipoPermisoTrabajo))" />
        <CampoTexto Etiqueta="@Textos["FichaCaduca"]" Type="date" Valor="@_caducidad" ValorChanged="v => _caducidad = v" FechaNoValidaChanged="v => MarcarFechaNoValida(nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo), v)" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo))" />
        <CampoTexto Etiqueta="@Textos["FichaMotivo"]" Valor="@_motivo" ValorChanged="v => _motivo = v" MensajeError="@Error(nameof(EditarFichaTrabajadorCommand.MotivoPermisoTrabajo))" />
        @* «Trabajador extranjero (cobrable)» (decisión de Chris, 2026-10-20): con la misma política que el contacto de
           emergencia. La casilla enseña el valor efectivo; si no se toca, la orden no la cambia, y si se deja igual que lo
           que dice el documento, se quita la marca a mano y vuelve a decidir el documento. *@
        @if (_conExtranjeroCobrable)
        {
            <label class="campo-checkbox" data-campo="extranjero-cobrable">
                <input type="checkbox" checked="@_extranjeroCobrable" @onchange="e => _extranjeroCobrable = e.Value is true" />
                @Textos["FichaExtranjeroCobrable"]
            </label>
            <p class="texto-ayuda-campo" data-ayuda="extranjero-cobrable">@Textos[_extranjeroCobrablePorDocumento ? "FichaExtranjeroCobrableDocumentoSi" : "FichaExtranjeroCobrableDocumentoNo"]</p>
        }
    }
</DrawerFormulario>

@code {
    [Parameter] public Guid TrabajadorId { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback OnGuardada { get; set; }

    private const string CampoEmergenciaNombre =
        nameof(EditarFichaTrabajadorCommand.ContactoEmergencia) + "." + nameof(ContactoEmergenciaTrabajador.Nombre);
    private const string CampoEmergenciaTelefono =
        nameof(EditarFichaTrabajadorCommand.ContactoEmergencia) + "." + nameof(ContactoEmergenciaTrabajador.Telefono);

    private bool _abierto, _cargando, _guardando, _lista, _conContactoEmergencia;
    private bool _conExtranjeroCobrable, _extranjeroCobrable, _extranjeroCobrableCargado, _extranjeroCobrablePorDocumento, _extranjeroCobrablePorDocumentoCargado;
    private int _generacion;
    private Guid _id, _version;
    private Guid? _empresaId;
    private string _oficioId = "", _delegacionId = "", _oficioIdCargado = "", _delegacionIdCargado = "";
    private string _afiliacion = "", _puesto = "", _nacimiento = "", _nacionalidad = "",
        _vinculo = "", _tipoContratacion = "CuentaAjena", _alta = "", _baja = "", _rnt = "", _permiso = "", _caducidad = "", _motivo = "",
        _emergenciaNombre = "", _emergenciaTelefono = "";
    private string _nombre = "", _apellidos = "", _documento = "", _documentoCargado = "";
    private string? _error;
    private Dictionary<string, string> _errores = [];
    private readonly InstantaneaFormulario _instantanea = new();
    private readonly CancellationTokenSource _ciclo = new();

    private string? Error(string campo) => _errores.GetValueOrDefault(campo);
    private string Instantanea() => System.Text.Json.JsonSerializer.Serialize(new
    {
        _nombre, _apellidos, _documento, _afiliacion, _puesto, _nacimiento, _nacionalidad, _vinculo, _tipoContratacion, _alta, _baja, _rnt, _permiso, _caducidad, _motivo,
        _emergenciaNombre, _emergenciaTelefono, _oficioId, _delegacionId, _extranjeroCobrable
    });

    /// <summary>
    /// Sin tocar la casilla, null: no se cambia. Si se cambió y coincide con lo que dice el documento, la marca a mano
    /// se quita (vuelve a decidir el documento); si lo contradice, se fija a mano.
    /// </summary>
    private MarcaExtranjeroCobrableTrabajador? CambioExtranjeroCobrable() =>
        !_conExtranjeroCobrable || (_documento == _documentoCargado && _extranjeroCobrable == _extranjeroCobrableCargado)
            ? null
            : new MarcaExtranjeroCobrableTrabajador(_extranjeroCobrable == _extranjeroCobrablePorDocumento ? null : _extranjeroCobrable);

    private void CambiarDocumento(string valor)
    {
        _documento = valor;
        if (valor == _documentoCargado)
        {
            // Volver al documento cargado restaura la casilla tal como estaba: así no se envía una marca a mano que nadie tocó.
            _extranjeroCobrablePorDocumento = _extranjeroCobrablePorDocumentoCargado;
            _extranjeroCobrable = _extranjeroCobrableCargado;
            return;
        }
        _extranjeroCobrablePorDocumento = CriterioDocumentoIdentidadTrabajador.Clasificar(valor).SeGuardaComoPasaporte;
        _extranjeroCobrable = _extranjeroCobrablePorDocumento;
    }

    // Edición en pasos: las claves, el paso de cada campo del comando y la navegación. «Contacto» solo existe si el servidor
    // envió el contacto de emergencia (sin él no habría nada que editar en el paso).
    private const string PasoBasico = "basico";
    private const string PasoTrabajo = "trabajo";
    private const string PasoContacto = "contacto";
    private const string PasoSituacion = "situacion";

    private string _paso = PasoBasico;
    private readonly HashSet<string> _pasosVistos = [];

    private IReadOnlyList<PasoDefinicion> PasosEdicion =>
        _conContactoEmergencia
            ?
            [
                new(PasoBasico, Textos["PasoAltaBasico"]),
                new(PasoTrabajo, Textos["PasoAltaTrabajo"]),
                new(PasoContacto, Textos["PasoAltaContacto"]),
                new(PasoSituacion, Textos["PasoEditarSituacion"]),
            ]
            :
            [
                new(PasoBasico, Textos["PasoAltaBasico"]),
                new(PasoTrabajo, Textos["PasoAltaTrabajo"]),
                new(PasoSituacion, Textos["PasoEditarSituacion"]),
            ];

    private int IndicePaso => Math.Max(0, PasosEdicion.ToList().FindIndex(p => p.Clave == _paso));

    /// <summary>El paso de cada campo del comando; nulo si el campo no es de ningún paso (Id, Versión).</summary>
    private string? PasoDelCampo(string campo) => campo switch
    {
        nameof(EditarFichaTrabajadorCommand.Documento) or nameof(EditarFichaTrabajadorCommand.Nombre)
            or nameof(EditarFichaTrabajadorCommand.Apellidos) or nameof(EditarFichaTrabajadorCommand.FechaNacimiento)
            or nameof(EditarFichaTrabajadorCommand.Nacionalidad) => PasoBasico,
        nameof(EditarFichaTrabajadorCommand.Puesto) or nameof(EditarFichaTrabajadorCommand.TipoContratacion)
            or nameof(EditarFichaTrabajadorCommand.TipoVinculo) or nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa)
            or nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa) => PasoTrabajo,
        CampoEmergenciaNombre or CampoEmergenciaTelefono => PasoContacto,
        nameof(EditarFichaTrabajadorCommand.NumeroAfiliacionSeguridadSocial) or nameof(EditarFichaTrabajadorCommand.FiguraEnRnt)
            or nameof(EditarFichaTrabajadorCommand.TipoPermisoTrabajo) or nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo)
            or nameof(EditarFichaTrabajadorCommand.MotivoPermisoTrabajo) => PasoSituacion,
        _ => null,
    };

    /// <summary>Errores de los campos que se ven ahora: los de otro paso no bloquean Escape ni el clic fuera sin que nadie los vea.</summary>
    private bool HayErroresDelPasoVisible => _errores.Keys.Any(campo => PasoDelCampo(campo) == _paso);

    /// <summary>
    /// «Siguiente» no avanza con campos del paso en error: valida con las reglas del comando (las mismas que «Guardar») y solo
    /// se queda con los errores de los campos del paso; el paso no se da por visto hasta que está bien.
    /// </summary>
    private Task SiguienteAsync()
    {
        var pasos = PasosEdicion;
        var indice = IndicePaso;
        if (indice >= pasos.Count - 1) return Task.CompletedTask;

        foreach (var campo in _errores.Keys.Where(c => PasoDelCampo(c) == _paso).ToList()) _errores.Remove(campo);
        var fallos = Validar().Where(f => PasoDelCampo(f.PropertyName) == _paso).ToList();
        if (fallos.Count > 0)
        {
            // Se suman a los de otros pasos que dejó un «Guardar» anterior: no se pierden por pulsar «Siguiente».
            foreach (var fallo in fallos.GroupBy(f => f.PropertyName)) _errores[fallo.Key] = fallo.First().ErrorMessage;
            return Task.CompletedTask;
        }

        _pasosVistos.Add(_paso);
        CambiarDePaso(pasos[indice + 1].Clave);
        return Task.CompletedTask;
    }

    private void Atras()
    {
        var indice = IndicePaso;
        if (indice > 0) CambiarDePaso(PasosEdicion[indice - 1].Clave);
    }

    private void IrAPaso(string clave) => CambiarDePaso(clave);

    /// <summary>
    /// Al dejar un paso sus campos se destruyen y con ellos el texto que no era una fecha: al volver, el campo nace con el
    /// valor del formulario y no tiene nada que señalar. La marca y su aviso se quitan, y la fecha vuelve a la que se cargó
    /// (el campo había entregado «»): abandonar una fecha a medias no puede borrar la guardada sin que nadie lo vea.
    /// </summary>
    private void CambiarDePaso(string clave)
    {
        if (clave == _paso) return;
        foreach (var campo in _fechasNoValidas.Where(c => PasoDelCampo(c) == _paso).ToList())
        {
            RestaurarFechaCargada(campo);
            _fechasNoValidas.Remove(campo);
            _errores.Remove(campo);
        }

        _paso = clave;
    }

    private void RestaurarFechaCargada(string campo)
    {
        var cargada = _fechasCargadas.GetValueOrDefault(campo, "");
        switch (campo)
        {
            case nameof(EditarFichaTrabajadorCommand.FechaNacimiento): _nacimiento = cargada; break;
            case nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa): _alta = cargada; break;
            case nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa): _baja = cargada; break;
            case nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo): _caducidad = cargada; break;
        }
    }

    /// <summary>Las fechas tal como se cargaron (ISO o «»), a las que vuelve un campo que se deja con texto no válido.</summary>
    private readonly Dictionary<string, string> _fechasCargadas = [];

    private void AnotarErrores(IEnumerable<FluentValidation.Results.ValidationFailure> fallos) =>
        _errores = fallos.GroupBy(f => f.PropertyName).ToDictionary(g => g.Key, g => g.First().ErrorMessage);

    /// <summary>Tras un guardado con errores de campo, el formulario se queda en el primer paso que tenga uno.</summary>
    private void IrAlPrimerPasoConError()
    {
        // Una fecha no válida solo puede estar en el paso visible (CambiarDePaso la quita al salir): si la hay, el formulario se
        // queda ahí, porque ir a otro paso descartaría el texto que la persona está corrigiendo.
        if (_fechasNoValidas.Any(c => PasoDelCampo(c) == _paso)) return;
        var conError = _errores.Keys.Select(PasoDelCampo).Where(p => p is not null).ToHashSet();
        var primero = PasosEdicion.FirstOrDefault(p => conError.Contains(p.Clave));
        if (primero is not null) CambiarDePaso(primero.Clave);
        else if (_errores.Count > 0 && _error is null) _error = _errores.Values.First();
    }

    /// <summary>Las fechas que no se pueden leer y las reglas del comando, sobre lo escrito ahora.</summary>
    private List<FluentValidation.Results.ValidationFailure> Validar()
    {
        var fallos = new List<FluentValidation.Results.ValidationFailure>();
        var comando = Comando(fallos);
        fallos.AddRange(new EditarFichaTrabajadorCommandValidator().Validate(comando).Errors);
        return fallos;
    }

    /// <summary>
    /// Campos de fecha cuyo texto no es una fecha entera: CampoTexto Type="date" los entrega como «» (lo que daba el campo
    /// nativo), y sin esto guardar la ficha borraría la fecha que la persona cree estar corrigiendo.
    /// </summary>
    private readonly HashSet<string> _fechasNoValidas = [];

    private void MarcarFechaNoValida(string campo, bool noValida)
    {
        if (noValida) _fechasNoValidas.Add(campo);
        else _fechasNoValidas.Remove(campo);
    }

    private DateOnly? Fecha(string valor, string campo, List<FluentValidation.Results.ValidationFailure> fallos)
    {
        if (_fechasNoValidas.Contains(campo))
        {
            fallos.Add(new FluentValidation.Results.ValidationFailure(campo, Textos["FichaFechaInvalida"]));
            return null;
        }

        if (string.IsNullOrWhiteSpace(valor)) return null;
        if (DateOnly.TryParseExact(valor, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var fecha)) return fecha;
        fallos.Add(new FluentValidation.Results.ValidationFailure(campo, Textos["FichaFechaInvalida"]));
        return null;
    }

    private EditarFichaTrabajadorCommand Comando(List<FluentValidation.Results.ValidationFailure> fallos) =>
        new(_id, _version,
            _afiliacion,
            _puesto,
            Fecha(_nacimiento, nameof(EditarFichaTrabajadorCommand.FechaNacimiento), fallos),
            _nacionalidad,
            _vinculo,
            Fecha(_alta, nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa), fallos),
            Fecha(_baja, nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa), fallos),
            _rnt,
            _permiso,
            Fecha(_caducidad, nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo), fallos),
            _motivo,
            Enum.Parse<CaeManager.Domain.Trabajadores.TipoContratacion>(_tipoContratacion),
            _conContactoEmergencia ? new ContactoEmergenciaTrabajador(_emergenciaNombre, _emergenciaTelefono) : null,
            // Con Empresa, los dos Ids tal como los muestra el formulario (vacío = quitarlos), pero solo si cambiaron:
            // sin cambio va null y el servidor no exige gestionar la Empresa (quien ve al Trabajador solo por una
            // Asignación guarda el resto de la ficha). El servidor copia el nombre del Oficio en el Puesto. Con
            // Subcontrata, null: no se tocan.
            _empresaId is null || (_oficioId == _oficioIdCargado && _delegacionId == _delegacionIdCargado)
                ? null
                : new DelegacionEmpresaYOficioDeTrabajador(
                    Guid.TryParse(_delegacionId, out var delegacion) ? delegacion : null,
                    Guid.TryParse(_oficioId, out var oficio) ? oficio : null),
            CambioExtranjeroCobrable(), _nombre, _apellidos,
            _documento == _documentoCargado ? null : _documento);

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible)
        {
            if (_abierto) ++_generacion;
            _abierto = false;
            return;
        }
        if (_abierto && _id == TrabajadorId) return;
        _abierto = true;
        _id = TrabajadorId;
        var generacion = ++_generacion;
        _cargando = true;
        _guardando = _lista = false;
        _error = null;
        _errores.Clear();
        _fechasNoValidas.Clear();
        _paso = PasoBasico;
        _pasosVistos.Clear();
        try
        {
            var detalle = await Mediator.Send(new ObtenerTrabajadorPorIdQuery(_id), _ciclo.Token);
            if (generacion != _generacion) return;
            if (detalle is null) { _error = Textos["FichaNoDisponible"]; return; }
            _version = detalle.Version;
            _nombre = detalle.Nombre;
            _apellidos = detalle.Apellidos;
            _documento = _documentoCargado = detalle.Dni ?? "";
            _afiliacion = detalle.NumeroAfiliacionSeguridadSocial ?? "";
            _puesto = detalle.Puesto ?? "";
            _empresaId = detalle.EmpresaId;
            _oficioId = _oficioIdCargado = detalle.OficioEmpresaId?.ToString() ?? "";
            _delegacionId = _delegacionIdCargado = detalle.DelegacionEmpresaId?.ToString() ?? "";
            _nacimiento = detalle.FechaNacimiento?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
            _nacionalidad = detalle.Nacionalidad ?? "";
            _vinculo = detalle.TipoVinculo ?? "";
            _tipoContratacion = detalle.TipoContratacion.ToString();
            _alta = detalle.FechaAltaEmpresa?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
            _baja = detalle.FechaBajaEmpresa?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
            _rnt = detalle.FiguraEnRnt ?? "";
            _permiso = detalle.TipoPermisoTrabajo ?? "";
            _caducidad = detalle.CaducidadPermisoTrabajo?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
            _motivo = detalle.MotivoPermisoTrabajo ?? "";
            _conContactoEmergencia = detalle.ContactoEmergenciaVisible;
            _emergenciaNombre = detalle.ContactoEmergenciaNombre ?? "";
            _emergenciaTelefono = detalle.ContactoEmergenciaTelefono ?? "";
            _conExtranjeroCobrable = detalle.ExtranjeroCobrableVisible;
            _extranjeroCobrablePorDocumento = _extranjeroCobrablePorDocumentoCargado = detalle.ExtranjeroCobrablePorDocumento;
            _extranjeroCobrable = _extranjeroCobrableCargado = detalle.MarcaExtranjeroCobrable ?? detalle.ExtranjeroCobrablePorDocumento;
            _fechasCargadas[nameof(EditarFichaTrabajadorCommand.FechaNacimiento)] = _nacimiento;
            _fechasCargadas[nameof(EditarFichaTrabajadorCommand.FechaAltaEmpresa)] = _alta;
            _fechasCargadas[nameof(EditarFichaTrabajadorCommand.FechaBajaEmpresa)] = _baja;
            _fechasCargadas[nameof(EditarFichaTrabajadorCommand.CaducidadPermisoTrabajo)] = _caducidad;
            _instantanea.Fijar(Instantanea());
            _lista = true;
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception) { if (generacion == _generacion) _error = Textos["FichaNoDisponible"]; }
        finally { if (generacion == _generacion) _cargando = false; }
    }

    private async Task GuardarAsync()
    {
        if (!_lista || _guardando || !Visible) return;
        var generacion = _generacion;
        _guardando = true;
        _errores.Clear();
        _error = null;
        try
        {
            var fallos = new List<FluentValidation.Results.ValidationFailure>();
            var comando = Comando(fallos);
            fallos.AddRange(new EditarFichaTrabajadorCommandValidator().Validate(comando).Errors);
            if (fallos.Count > 0) throw new ValidationException(fallos);
            var resultado = await Mediator.Send(comando, _ciclo.Token);
            if (generacion != _generacion) return;
            if (resultado.EsFallido)
            {
                // La versión original se conserva: el borrador nunca se reenvía con una versión no revisada.
                _error = resultado.Error.Mensaje;
                if (PasoDelCodigoDeError(resultado.Error.Codigo) is { } pasoDelError) CambiarDePaso(pasoDelError);
                return;
            }
            _instantanea.Fijar(Instantanea());
            ToastService.Mostrar(Textos["FichaGuardada"], TonoToast.Exito);
            await VisibleChanged.InvokeAsync(false);
            await OnGuardada.InvokeAsync();
        }
        catch (ValidationException ex)
        {
            if (generacion == _generacion)
            {
                AnotarErrores(ex.Errors);
                IrAlPrimerPasoConError();
            }
        }
        catch (OperationCanceledException) when (_ciclo.IsCancellationRequested) { }
        catch (Exception) { if (generacion == _generacion) _error = Textos["FichaErrorGuardar"]; }
        finally { if (generacion == _generacion) _guardando = false; }
    }

    public void Dispose()
    {
        ++_generacion;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }
}
