@*
    Panel de Trabajador para el Context Workspace. Pestañas: Información,
    Documentación, Vehículos, Historial. Es también la vista rápida del listado
    /trabajadores (sustituyó a TrabajadorPreviewDrawer): por eso lleva en la
    cabecera el icono 360 a la página completa y, en Información, la
    documentación base como referencia.

    "Citas" se retiró (Project-Hydra-Negocio/tecnico/docs/ux-audit/05-trabajadores-vehiculos.md H3): un
    enlace a una pantalla "Próximamente" contradice CatalogoMenuLateral ("un
    enlace a una pantalla que todavía no existe es peor que no tener el
    enlace") — vuelve cuando exista la entidad de dominio real. "Vehículos"
    muestra los de la Empresa/Subcontrata del trabajador como información
    contextual — Vehiculo no tiene relación directa con Trabajador en el
    modelo (misma decisión que ya existía para no conectar Vehiculo con
    Visita).
*@
@using CaeManager.Application.Trabajadores.Commands.EditarTrabajador
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadorPorId
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculos
@using CaeManager.Domain.Documentos
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Trabajadores.Recursos
@using CaeManager.Web.Recursos
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject ToastService ToastService
@inject IStringLocalizer<TextosTrabajadores> Textos
@inject IStringLocalizer<TextosComunes> Comunes

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="@Textos["ErrorCargaTrabajadorTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarCabeceraAsync">@Comunes["Reintentar"]</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.Nombre @_detalle.Apellidos</h2>
        @if (!_editandoInformacion)
        {
            @* El lápiz vive en la cabecera en todas las pestañas (patrón de listados: la fila no
               lleva menú y editar se hace desde el panel, también con la tecla «e»). Desde otra
               pestaña lleva primero a «Información», que es donde está el formulario.
               Editar acaba en EditarTrabajadorCommand, ICommand denegado a Consulta. *@
            <SoloConEscritura>
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="EditarDesdeCabeceraAsync"
                       aria-label="@Textos["AriaEditarInformacion"]" title="@Textos["TituloEditarConAtajo"]">
                    <Icono Nombre="editar" Tamano="TamanoIcono.Pequeno" />
                </Boton>
            </SoloConEscritura>
        }
        @* Icono 360 del catálogo: lleva a la página completa de Trabajador 360. *@
        <Boton360 Nombre="@($"{_detalle.Nombre} {_detalle.Apellidos}")" Href="@($"/trabajadores/{_detalle.Id}")" />
    </div>

    @* PestanaActiva con @: el parámetro es string, y sin @ Razor le pasa el literal "PestanaActiva" (ninguna pestaña quedaba marcada como activa). *@
    <Pestanas Definiciones="_pestanas" PestanaActiva="@PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="@Textos["AriaSeccionesTrabajador"]">
        @switch (PestanaActiva)
        {
            case "informacion":
                @if (_editandoInformacion)
                {
                    @if (_mensajeErrorInformacion is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorInformacion</div>
                    }
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="DNI" Valor="@_detalle.Dni" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaEmpleador"]" Valor="@_detalle.EmpleadorNombre" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombreInfo" ValorChanged="v => _nombreInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Nombre))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaApellidos"]" Valor="@_apellidosInfo" ValorChanged="v => _apellidosInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Apellidos))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaAlias"]" Valor="@_aliasInfo" ValorChanged="v => _aliasInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Alias))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaPuestoOficio"]" Valor="@_puestoInfo" ValorChanged="v => _puestoInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Puesto))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaEmail"]" Type="email" Valor="@_emailInfo" ValorChanged="v => _emailInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Email))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaTelefonoWhatsapp"]" Type="tel" Placeholder="+34 600 00 00 00" Valor="@_telefonoInfo" ValorChanged="v => _telefonoInfo = v" MensajeError="@ObtenerErrorInformacion(nameof(EditarTrabajadorCommand.Telefono))" />
                        <CampoTexto Etiqueta="@Textos["EtiquetaFechaNacimiento"]" Type="date" Valor="@_fechaNacimientoInfo" ValorChanged="v => _fechaNacimientoInfo = v" />
                        <CampoTextarea Etiqueta="@Textos["EtiquetaObservaciones"]" Valor="@_observacionesInfo" ValorChanged="v => _observacionesInfo = v" Filas="3" />
                    </div>
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_guardandoInformacion" OnClick="CancelarEdicionInformacion">@Textos["BotonCancelar"]</Boton>
                        <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Cargando="_guardandoInformacion" OnClick="GuardarInformacionAsync">@Textos["BotonGuardar"]</Boton>
                    </div>
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="@Textos["EtiquetaNombreCompleto"]" Valor="@($"{_detalle.Nombre} {_detalle.Apellidos}")" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaAlias"]" Valor="@_detalle.Alias" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaPuestoOficio"]" Valor="@_detalle.Puesto" />
                        <CampoInfo Etiqueta="DNI" Valor="@_detalle.Dni" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaEmpleador"]" Valor="@_detalle.EmpleadorNombre" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaEmail"]" Valor="@_detalle.Email" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaTelefono"]" Valor="@_detalle.Telefono" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaFechaNacimiento"]" Valor="@(_detalle.FechaNacimiento?.ToString("dd/MM/yyyy"))" />
                        <CampoInfo Etiqueta="@Textos["EtiquetaObservaciones"]" Valor="@_detalle.Observaciones" />
                    </div>
                    @* Los cuatro documentos de la documentación base, como referencia: lo que la
                       vista rápida anterior del listado enseñaba encima de las pestañas. *@
                    <PanelDocumentacionBase TrabajadorId="EntidadId" />
                }
                break;

            case "documentacion":
                <PestanaDocumentacion Ambito="AmbitoAplicacion.Trabajador" PropietarioId="EntidadId" />
                break;

            case "vehiculos":
                @if (_cargandoVehiculos)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorVehiculos)
                {
                    <EstadoVacio Titulo="@Textos["ErrorCargaVehiculosTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
                        <Accion>
                            <Boton Variante="VarianteBoton.Primario" OnClick="CargarVehiculosAsync">@Comunes["Reintentar"]</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else if (_vehiculos is { Count: 0 })
                {
                    <EstadoVacio Titulo="@Textos["VacioVehiculosTitulo"]" Descripcion="@Textos["VacioVehiculosDescripcion"]" />
                }
                else if (_vehiculos is not null)
                {
                    <p class="workspace-nota-contextual">@Textos["NotaVehiculos"]</p>
                    <ul class="workspace-lista-entidades">
                        @foreach (var vehiculo in _vehiculos)
                        {
                            <FilaEntidadRelacionada
                                @key="vehiculo.Id"
                                Titulo="@($"{vehiculo.Nombre} ({vehiculo.NumeroPlaca})")"
                                Subtitulo="@vehiculo.Modelo"
                                OnClic="() => AbrirVehiculoAsync(vehiculo)" />
                        }
                    </ul>
                }
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Trabajador" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@* P1-E2b: la edición en línea de Información vive en el panel, no en la pestaña: cambiar de pestaña no la pierde
   y no pregunta, por eso el aviso va fuera de <Pestanas>. Abrir otra ficha, volver, el
   breadcrumb o cerrar el panel sí la pierden: el Context Workspace pregunta a este aviso
   antes. Fuera del if/else, para que recargar la cabecera tras guardar no lo desmonte. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CancelarEdicionInformacion" />

@code {
    private IReadOnlyList<PestanaDefinicion> _pestanas =>
    [
        new("informacion", Textos["PestanaInformacion"]),
        new("documentacion", Textos["EtiquetaDocumentacion"]),
        new("vehiculos", Textos["PestanaVehiculos"]),
        new("historial", Textos["PestanaHistorial"])
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private TrabajadorDetalleDto? _detalle;
    private bool _cargando = true;
    private bool _error;
    private Guid _idCargado;
    private int _cargaCabecera;

    private IReadOnlyList<VehiculoListaDto>? _vehiculos;
    private bool _cargandoVehiculos;
    private bool _errorVehiculos;

    /// <summary>
    /// Edición in situ de "Información" (Centro 360, Project-Hydra-Negocio/tecnico/docs/ux-audit/PLAN-EJECUCION-UX.md
    /// § 0.10) — sustituye al Drawer de "Editar" de <c>/trabajadores</c>,
    /// retirado. DNI y Empleador no entran: no forman parte de
    /// <see cref="EditarTrabajadorCommand"/> — el DNI es la identidad del
    /// trabajador y el empleador solo se fija al crear.
    /// </summary>
    private bool _editandoInformacion;
    private string _nombreInfo = string.Empty;
    private string _apellidosInfo = string.Empty;
    private string _aliasInfo = string.Empty;
    private string _puestoInfo = string.Empty;
    private string _emailInfo = string.Empty;
    private string _telefonoInfo = string.Empty;
    private string _fechaNacimientoInfo = string.Empty;
    private string _observacionesInfo = string.Empty;

    private readonly InstantaneaFormulario _instantaneaInformacion = new();

    /// <summary>P1-E2b: la edición en línea de Información comparada con cómo se abrió.</summary>
    private bool HayCambiosSinGuardar =>
        _editandoInformacion && _instantaneaInformacion.Difiere(ValoresInformacion());

    private object?[] ValoresInformacion() =>
        [_nombreInfo, _apellidosInfo, _aliasInfo, _puestoInfo, _emailInfo, _telefonoInfo, _fechaNacimientoInfo, _observacionesInfo];
    private bool _guardandoInformacion;
    private string? _mensajeErrorInformacion;
    private Dictionary<string, string> _erroresInformacion = new();

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    protected override void OnInitialized() => WorkspaceService.OnEdicionSolicitada += AlSolicitarEdicion;

    public void Dispose() => WorkspaceService.OnEdicionSolicitada -= AlSolicitarEdicion;

    private void AlSolicitarEdicion() => InvokeAsync(async () =>
    {
        await AtenderEdicionSolicitadaAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Tecla «e» de un listado (<c>ContextWorkspaceService.AbrirEnEdicionAsync</c>): equivale
    /// a pulsar el lápiz de la cabecera. Solo se consume con el detalle ya cargado; si llega
    /// antes, la atiende el final de la carga. El lápiz va dentro de <c>SoloConEscritura</c>,
    /// así que aquí se repite su misma condición: un rol de Consulta no entra en edición.
    /// </summary>
    private async Task AtenderEdicionSolicitadaAsync()
    {
        if (_detalle is null || _detalle.Id != EntidadId)
            return;
        if (!WorkspaceService.ConsumirEdicionSolicitada(EntidadWorkspace.Trabajador, EntidadId))
            return;
        if (_editandoInformacion || EstadoAutenticacion is null)
            return;

        var usuario = (await EstadoAutenticacion).User;
        if (!CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv.Split(',').Any(usuario.IsInRole))
            return;

        await EditarDesdeCabeceraAsync();
    }

    private async Task EditarDesdeCabeceraAsync()
    {
        if (PestanaActiva != "informacion")
            await PestanaActivaChanged.InvokeAsync("informacion");

        IniciarEdicionInformacion();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId != _idCargado)
        {
            _idCargado = EntidadId;
            _vehiculos = null;
            _errorVehiculos = false;
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }

        if (PestanaActiva == "vehiculos" && _vehiculos is null && !_errorVehiculos && !_cargandoVehiculos && _detalle is not null)
            await CargarVehiculosAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        // Abrir la vista rápida de A y enseguida la de B lanza dos cargas. Si la de A vuelve la
        // última, sin esto el panel titulado por B enseñaría —y dejaría editar— los datos de A.
        var carga = ++_cargaCabecera;
        var id = EntidadId;
        _cargando = true;
        _error = false;

        try
        {
            var detalle = await Mediator.Send(new ObtenerTrabajadorPorIdQuery(id));
            if (carga != _cargaCabecera) return;
            _detalle = detalle;
        }
        catch (Exception)
        {
            if (carga != _cargaCabecera) return;
            _error = true;
            // Una petición de edición («e») no sobrevive a la carga fallida: si se quedara
            // pendiente, un reintento con éxito entraría en edición sin que nadie lo pida.
            WorkspaceService.ConsumirEdicionSolicitada(EntidadWorkspace.Trabajador, id);
        }

        _cargando = false;
        if (!_error)
            await AtenderEdicionSolicitadaAsync();
    }

    private async Task CargarVehiculosAsync()
    {
        var idSolicitado = EntidadId;
        var empresaId = _detalle!.EmpresaId;
        var subcontrataId = _detalle.SubcontrataId;
        _cargandoVehiculos = true;
        _errorVehiculos = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerVehiculosQuery(
                Busqueda: null, EmpresaId: empresaId, SubcontrataId: subcontrataId, TamanoPagina: 50));
            if (idSolicitado == EntidadId)
                _vehiculos = resultado.Elementos;
        }
        catch (Exception)
        {
            if (idSolicitado == EntidadId)
                _errorVehiculos = true;
        }
        finally
        {
            if (idSolicitado == EntidadId)
                _cargandoVehiculos = false;
        }
    }

    private Task AbrirVehiculoAsync(VehiculoListaDto vehiculo) =>
        WorkspaceService.NavegarAAsync(EntidadWorkspace.Vehiculo, vehiculo.Id, vehiculo.Nombre, "informacion");

    private void IniciarEdicionInformacion()
    {
        if (_detalle is null) return;

        _nombreInfo = _detalle.Nombre;
        _apellidosInfo = _detalle.Apellidos;
        _aliasInfo = _detalle.Alias ?? string.Empty;
        _puestoInfo = _detalle.Puesto ?? string.Empty;
        _emailInfo = _detalle.Email ?? string.Empty;
        _telefonoInfo = _detalle.Telefono ?? string.Empty;
        _fechaNacimientoInfo = _detalle.FechaNacimiento?.ToString("yyyy-MM-dd") ?? string.Empty;
        _observacionesInfo = _detalle.Observaciones ?? string.Empty;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();
        _editandoInformacion = true;
        _instantaneaInformacion.Fijar(ValoresInformacion());
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private string? ObtenerErrorInformacion(string campo) => _erroresInformacion.GetValueOrDefault(campo);

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null) return;

        _guardandoInformacion = true;
        _mensajeErrorInformacion = null;
        _erroresInformacion = new Dictionary<string, string>();

        try
        {
            var email = string.IsNullOrWhiteSpace(_emailInfo) ? null : _emailInfo;
            var telefono = string.IsNullOrWhiteSpace(_telefonoInfo) ? null : _telefonoInfo;
            var observaciones = string.IsNullOrWhiteSpace(_observacionesInfo) ? null : _observacionesInfo;
            var alias = string.IsNullOrWhiteSpace(_aliasInfo) ? null : _aliasInfo;
            var puesto = string.IsNullOrWhiteSpace(_puestoInfo) ? null : _puestoInfo;
            var fechaNacimiento = DateOnly.TryParse(_fechaNacimientoInfo, out var fecha) ? fecha : (DateOnly?)null;

            var resultado = await Mediator.Send(new EditarTrabajadorCommand(
                _detalle.Id, _nombreInfo, _apellidosInfo, fechaNacimiento, email, observaciones, alias, telefono, puesto, _detalle.Version));

            if (resultado.EsFallido)
            {
                _mensajeErrorInformacion = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar(Textos["ToastActualizado"], TonoToast.Exito);
            _editandoInformacion = false;
            await CargarCabeceraAsync();
        }
        catch (ValidationException ex)
        {
            _erroresInformacion = ex.Errors
                .GroupBy(e => e.PropertyName)
                .ToDictionary(g => g.Key, g => g.First().ErrorMessage);
        }
        catch (Exception)
        {
            _mensajeErrorInformacion = Textos["ErrorGuardar"];
        }
        finally
        {
            _guardandoInformacion = false;
        }
    }
}
