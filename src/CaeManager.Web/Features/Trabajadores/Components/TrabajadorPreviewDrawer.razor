@*
    Drawer ligero de vista previa — mismo patrón que ClientePreviewDrawer/
    EmpresaPreviewDrawer, extendido a Trabajadores por decisión explícita del
    usuario. Sin Application nuevo: ObtenerTrabajadorPorIdQuery ya cubre
    todos los campos de Información. Sin "Contacto principal" (a diferencia
    de Cliente/Empresa): TipoPropietarioAgenda no incluye Trabajador — la
    persona ES el contacto, no tiene una agenda propia que mostrar.
    Documentación/Historial reutilizan PestanaDocumentacion/PestanaHistorial.
*@
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadorPorId
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Trabajadores.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosTrabajadores> Textos

@if (Visible)
{
    <aside class="drawer-preview-trabajador" role="complementary" aria-label="@Textos["AriaVistaPrevia"]">
        <div class="cabecera-preview-trabajador">
            <div class="texto-cabecera-preview-trabajador">
                <span class="etiqueta-cabecera-preview-trabajador">@Textos["EtiquetaCabeceraPreview"]</span>
                <span class="nombre-cabecera-preview-trabajador">@(_detalle is null ? Textos["TextoCargando"].Value : $"{_detalle.Nombre} {_detalle.Apellidos}")</span>
            </div>
            <button type="button" class="boton-cerrar-preview-trabajador" aria-label="@Textos["AriaCerrar"]" @onclick="Cerrar"><Icono Nombre="cerrar" /></button>
        </div>

        <div class="cuerpo-preview-trabajador">
        <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" EtiquetaGrupo="@Textos["AriaSeccionesTrabajador"]">
            @if (_cargando && _pestanaActiva == "informacion")
            {
                <EstadoCargando Filas="3" />
            }
            else if (_pestanaActiva == "informacion" && _detalle is not null)
            {
                <div class="rejilla-info-preview-trabajador">
                    <div class="celda-info-preview-trabajador"><span>DNI</span><strong>@_detalle.Dni</strong></div>
                    <div class="celda-info-preview-trabajador"><span>@Textos["EtiquetaEmpleador"]</span><strong>@_detalle.EmpleadorNombre</strong></div>
                    <div class="celda-info-preview-trabajador"><span>@Textos["EtiquetaPuesto"]</span><strong>@(_detalle.Puesto ?? "—")</strong></div>
                    <div class="celda-info-preview-trabajador"><span>@Textos["EtiquetaAlias"]</span><strong>@(_detalle.Alias ?? "—")</strong></div>
                    <div class="celda-info-preview-trabajador"><span>@Textos["EtiquetaEmail"]</span><strong>@(_detalle.Email ?? "—")</strong></div>
                    <div class="celda-info-preview-trabajador"><span>@Textos["EtiquetaTelefono"]</span><strong>@(_detalle.Telefono ?? "—")</strong></div>
                </div>
            }

            @if (_pestanaActiva == "documentacion" && TrabajadorId is { } trabajadorIdDocs)
            {
                <PestanaDocumentacion Ambito="AmbitoAplicacion.Trabajador" PropietarioId="trabajadorIdDocs" />
                <button type="button" class="enlace-ver-todo-preview-trabajador" @onclick="AbrirTrabajador360">
                    @Textos["BotonVerTrabajador360"]
                </button>
            }

            @if (_pestanaActiva == "historial" && TrabajadorId is { } trabajadorIdHist)
            {
                <PestanaHistorial EntidadTipo="Trabajador" EntidadId="trabajadorIdHist" />
            }
        </Pestanas>
        </div>

        <div class="pie-preview-trabajador">
            <Boton OnClick="AbrirTrabajador360">@Textos["BotonVerTrabajador360"]</Boton>
            <span class="nota-pie-preview-trabajador">@Textos["NotaPiePreview"]</span>
        </div>
    </aside>
}

@code {
    private IReadOnlyList<PestanaDefinicion> Pestanas =>
        [new("informacion", Textos["PestanaInformacion"]), new("documentacion", Textos["EtiquetaDocumentacion"]), new("historial", Textos["PestanaHistorial"])];
}
