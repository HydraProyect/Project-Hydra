@*
    Trabajador 360 (Parte XVI PROMPT 04) — ver comentario de cabecera en el
    .razor.cs para el porqué de lo que esta página NO reimplementa.
*@
@page "/trabajadores/{TrabajadorId:guid}"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Asignaciones.Queries.ObtenerAsignacionesDocumentacionPorCentro
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Application.Trabajadores.Queries.ObtenerDocumentacionPorCentroDeTrabajador
@using CaeManager.Domain.Documentos
@using CaeManager.Domain.Gestiones
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Trabajadores.Components

<LimiteDeErrores Pagina="this">
<PageTitle>@(NombreCompleto ?? Textos["TituloDetalleSinNombre"].Value) — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["AriaMigas"]" />

    @if (_error)
    {
        <EstadoVacio Titulo="@Textos["DetalleErrorTitulo"]" Descripcion="@Textos["DetalleErrorDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">@Comunes["Reintentar"]</Boton>
                <EnlaceProfundoOtraEmpresa />
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="5" />
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera de identidad en tarjeta (patrón de las páginas 360, como
            Centro 360 y Empresa 360): anillo a la izquierda, identidad en la
            línea de datos —DNI, empleador con su icono 360 y el peor estado—
            y a la derecha la acción principal con el resto en el menú «⋯».
            El nombre del empleador abre su consulta rápida; el icono 360,
            su página.
        *@
        <CabeceraIdentidad Titulo="@(NombreCompleto ?? string.Empty)">
            <Anillo>
                <AnilloCumplimiento Porcentaje="Cumplimiento" Tamano="TamanoAnillo.Cabecera"
                                     Etiqueta="@(Textos["AnilloCumplimiento", Cumplimiento?.ToString() ?? string.Empty])" />
            </Anillo>
            <JuntoAlTitulo>
                @if (!string.IsNullOrWhiteSpace(_detalle.Alias))
                {
                    <span class="trabajador360-alias">(@_detalle.Alias)</span>
                }
            </JuntoAlTitulo>
            @* Maqueta 17-10: dos líneas bajo el nombre («DNI» y el DNI copiable sin dos puntos · empleador, y debajo las pastillas de estado); sin «Trabajador» sobre el nombre. *@
            <Datos>
              <div class="trabajador360-datos">
               <div class="trabajador360-meta">
                <span>
                    @Textos["FichaRotuloDni"]
                    @{ var dni = _detalle.Dni ?? string.Empty; }
                    <BotonCopiar EnLinea="true" ConfirmarConIcono="true" Valor="@dni" Texto="@dni" Etiqueta="@Textos["FichaCopiarDni"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarDni"], dni]" />
                </span>
                <span aria-hidden="true">·</span>
                <span>
                    <button type="button" class="enlace-nombre-fila" @onclick="AbrirEmpleador">@_detalle.EmpleadorNombre</button>
                    @if (PaginaEmpleador is { } paginaEmpleador)
                    {
                        <Boton360 Nombre="@_detalle.EmpleadorNombre" Href="@paginaEmpleador" />
                    }
                </span>
               </div>
               <div class="trabajador360-indicadores">
                @if (PeorEstadoGlobal is { } peorEstado)
                {
                    <Badge Tono="EstadoDocumentoUi.Tono(peorEstado)">@EstadoDocumentoUi.Texto(peorEstado)</Badge>
                }
                @* El estado de arriba puede ser otro más grave (un vencido): lo exigido y sin documento se nombra aparte,
                   para que nadie lea la ficha como al día mientras falte un Tipo que un Centro le exige. *@
                @if (MotivoIncidenciasUi.FaltanTipos(TiposFaltantes) is { } faltan)
                {
                    <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">@faltan</Badge>
                }
                @if (CentroMasUrgente is { } centroUrgente && TieneIncidencias(centroUrgente))
                {
                    var incidenciasCentro = Incidencias(centroUrgente);
                    <VentanaContexto Etiqueta="@(incidenciasCentro == 1 ? Textos["VentanaIncidenciasUno", centroUrgente.CentroNombre] : Textos["VentanaIncidenciasVarios", incidenciasCentro, centroUrgente.CentroNombre])"
                                     Titulo="@(Textos["VentanaProblemaUrgente", centroUrgente.CentroNombre])">
                        <Disparador>
                            <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">
                                @(incidenciasCentro == 1 ? Textos["BadgeIncidenciasCentroUno", centroUrgente.CentroNombre] : Textos["BadgeIncidenciasCentroVarios", incidenciasCentro, centroUrgente.CentroNombre])
                            </Badge>
                        </Disparador>
                        <Detalle>
                            @foreach (var documento in centroUrgente.Documentos.Where(EsIncidencia))
                            {
                                <span class="ventana-linea">@documento.TipoDocumentoNombre — @EstadoDocumentoUi.Texto(documento.Estado, documento.EnToleranciaHasta)</span>
                            }
                        </Detalle>
                    </VentanaContexto>
                }
                @if (TotalSinConfirmar != 0)
                {
                    <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">@Textos["AvisoVigenciaSinConfirmar", TotalSinConfirmar]</Badge>
                }
               </div>
              </div>
            </Datos>
            <Acciones>
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="SubirDocumentoAsync">@Textos["BotonSubirDocumento"]</Boton></SoloConEscritura>
                @* Las tres acciones del menú son escrituras: a Consulta no se le deja el «⋯» con el menú vacío. *@
                <SoloConEscritura>
                    <MenuAcciones ConBorde="true" EtiquetaAccesible="@Comunes["MasAcciones"]">
                        <ItemMenuAccion OnClick="AbrirInformacion">@Textos["AccionEditar"]</ItemMenuAccion>
                        <ItemMenuAccion OnClick="ReclamarFaltantesAsync">@Textos["AccionReclamarFaltantes"]</ItemMenuAccion>
                        <ItemMenuAccion OnClick="AbrirCrearGestionAsync">@Textos["AccionCrearGestion"]</ItemMenuAccion>
                    </MenuAcciones>
                </SoloConEscritura>
            </Acciones>
        </CabeceraIdentidad>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral"]">
            <ChildContent>
        <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestana" EtiquetaGrupo="@Textos["AriaSeccionesTrabajador360"]" Pagina360="true">
            @switch (_pestanaActiva)
            {
                case PestanaOperacion:
                    <PanelDocumentacionBase TrabajadorId="TrabajadorId" OnCorregirDocumento="EditarDocumentoAsync" OnSubirFaltante="SubirFaltanteAsync" />
                    @*
                        Franja «Por vencer» (decisión del propietario 2026-09-24,
                        Q3 = (a)): los documentos del trabajador en Próximo o
                        Urgente, con el umbral ámbar del tenant. Va después de la
                        documentación base en Operación. Sin ninguno,
                        la franja no se pinta.
                    *@
                    @if (DocumentosPorVencer is { Count: > 0 } porVencer)
                    {
                        <div class="separador-ambito">@Textos["SeparadorPorVencer"]</div>
                        <div class="trabajador360-por-vencer">
                            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["SeparadorPorVencer"]">
                                @foreach (var documento in porVencer)
                                {
                                    var pideGestionar = EstadoDocumentoFicha360.PideGestionar(documento.Estado);
                                    <FilaRelacion @key="documento.Id" Nombre="@documento.TipoDocumentoNombre" Tono="@EstadoDocumentoFicha360.TonoFila(documento.Estado)">
                                        <Detalle>@(" ")@Textos["VenceEl", TextoVence(documento.FechaVencimiento, documento.Estado)]</Detalle>
                                        <Estado><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></Estado>
                                        <Acciones>
                                            @if (pideGestionar)
                                            {
                                                <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre)" OnClick="() => EditarDocumentoAsync(documento.Id)">@EstadoDocumentoFicha360.TextoAccion</Boton></SoloConEscritura>
                                            }
                                        </Acciones>
                                    </FilaRelacion>
                                }
                            </ListaRelaciones>
                        </div>
                    }

                    @*
                        Gestiones pendientes (solo si hay, 04 § 6 — un
                        vacío nunca se presenta como éxito, pero tampoco se muestra
                        un bloque vacío sin motivo: si no hay ninguna, el bloque
                        entero no aparece).
                    *@
                    @if (_cargandoGestiones)
                    {
                        <div class="separador-ambito">@Textos["SeparadorGestionesPendientes"]</div>
                        <EstadoCargando Filas="2" />
                    }
                    else if (_gestionesPendientes.Count > 0)
                    {
                        <div class="separador-ambito">@Textos["SeparadorGestionesPendientes"]</div>
                        <div class="tabla-documentos-requeridos" role="table" aria-label="@Textos["SeparadorGestionesPendientes"]">
                            <div class="documentos-requeridos-cabecera" role="row">
                                <span role="columnheader">@Textos["ColumnaGestion"]</span>
                                <span role="columnheader">@Textos["ColumnaCentro"]</span>
                                <span role="columnheader">@Textos["ColumnaCreada"]</span>
                                <span role="columnheader" class="columna-accion">@Textos["ColumnaAccion"]</span>
                            </div>
                            @foreach (var gestion in _gestionesPendientes)
                            {
                                <div class="fila-documento-requerido" role="row" @key="gestion.Id">
                                    <span class="celda-documento-nombre" role="cell">@gestion.TipoDocumentoNombre</span>
                                    <span role="cell">@gestion.CentroNombre</span>
                                    <span role="cell">@gestion.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")</span>
                                    <span class="columna-accion" role="cell">
                                        @* CompletarGestionCommand es ICommand, denegado a Consulta. *@
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                   Cargando="_completandoGestion.Contains(gestion.Id)"
                                                   OnClick="() => CompletarGestionAsync(gestion.Id)">
                                                @Textos["AccionCompletar"]
                                            </Boton>
                                        </SoloConEscritura>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    break;

                case PestanaCentros:
                    @*
                        Ámbito 1: Documentación por centro (completo — es lo que se
                        opera aquí, a diferencia de la pestaña "Documentación" plana
                        del Workspace Panel). Acordeón por centro, mismo lenguaje que
                        AcordeonAsignacionesCentro pero con Centro como sujeto en vez
                        de Trabajador.
                    *@
                    @if (_centros.Count == 0)
                    {
                        <EstadoVacio Titulo="@Textos["VacioAsignacionesTitulo"]" Descripcion="@Textos["VacioAsignacionesDescripcion"]" />
                    }
                    else
                    {
                        <div class="separador-ambito">@Textos["SeparadorDocumentacionPorCentro"]</div>
                        @*
                            Mockup Gen 2 § Centros: lo primero que hay que
                            entender de esta lista es por qué el mismo
                            trabajador puede estar completo en una fila y
                            bloqueado en la de al lado.
                        *@
                        <p class="texto-descriptivo">
                            @Textos["TextoExigenciaPorCentro"]
                        </p>
                        <div class="trabajador360-centros">
                            <FranjaEstado Opciones="OpcionesCentros" Valor="@string.Join(',', _estadosCentros)" ValorChanged="CambiarEstadoCentros"
                                          Recuentos="RecuentosCentros" TotalTodos="_centros.Count" />
                            <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["PestanaCentros"]">
                                <Encabezado>@Textos[_centros.Count == 1 ? "ResumenCentroOrdenado" : "ResumenCentrosOrdenados", CentrosVisibles.Count, _centros.Count]</Encabezado>
                                <ChildContent>
                                @if (CentrosVisibles.Count == 0)
                                {
                                    <p class="texto-vacio-seccion" role="status">@Textos["CentrosVacioFiltros360"]</p>
                                }
                                @foreach (var centro in CentrosVisibles)
                                {
                                    var incidencias = Incidencias(centro);
                                    var sinConfirmarCentro = SinConfirmar(centro);
                                    <FilaRelacion @key="centro.CentroId" Nombre="@centro.CentroNombre" NombreIcono="centros"
                                                  OnNombre="() => AlternarExpansionCentro(centro.CentroId)"
                                                  Tono="@TonoDocumentoEnCentro(centro.PeorEstado)"
                                                  Desplegada="@_expandidosCentro.Contains(centro.CentroId)"
                                                  DesplegadaChanged="_ => AlternarExpansionCentro(centro.CentroId)">
                                        @* Maqueta 17-10: la línea secundaria dice el Cliente empresarial, «Asignado desde el …», el resumen y,
                                           al final y en la misma línea, «Dar de baja de este centro» (antes, una columna de acciones que lo cortaba). *@
                                        <Detalle>
                                            @centro.ClienteRazonSocial ·
                                            <span class="trabajador360-centro-alta">@Textos["AsignadoDesdeEl", centro.FechaAlta.ToString("dd/MM/yyyy")]</span> ·
                                            @(centro.Cumplimiento.Requeridos == 0
                                                ? Textos["ResumenSinExigencia"]
                                                : Textos["ResumenExigidosCorrectos", centro.Cumplimiento.AlDia, centro.Cumplimiento.Requeridos])
                                            <SoloConEscritura>
                                                <span aria-hidden="true"> · </span>
                                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="trabajador360-centro-baja accion-fila-enlace"
                                                       OnClick="() => AbrirBajaAsignacionConfirm(centro.AsignacionId, centro.CentroNombre)">
                                                    @Textos["AccionDarDeBajaDeCentro"]
                                                </Boton>
                                            </SoloConEscritura>
                                        </Detalle>
                                        <Estado>
                                            <Badge Tono="EstadoDocumentoUi.Tono(centro.PeorEstado)" Tamano="TamanoBadge.Pequeno">
                                                @(incidencias == 0
                                                    ? (sinConfirmarCentro != 0 ? Textos["BadgeAlDiaSinConfirmar"] : Textos["BadgeCompleto"])
                                                    : incidencias == 1 ? Textos["IncidenciasUno"] : Textos["IncidenciasVarios", incidencias])
                                            </Badge>
                                        </Estado>
                                        <Acciones>
                                            <Boton360 Nombre="@centro.CentroNombre" Href="@($"/centros/{centro.CentroId}")" />
                                        </Acciones>
                                        <Desplegable>
                                            @if (centro.Documentos.Count == 0)
                                            {
                                                <p class="texto-vacio-seccion">@Textos["TextoCentroSinExigencia"]</p>
                                            }
                                            else
                                            {
                                                <ListaRelaciones EnTarjeta="true" Etiqueta="@(Textos["AriaDocumentacionExigida", centro.CentroNombre])">
                                                    @foreach (var documento in centro.Documentos.OrderBy(d => SeveridadEstadoDocumento.Rango(d.Estado)).ThenBy(d => d.TipoDocumentoNombre, StringComparer.CurrentCulture))
                                                    {
                                                        <AuthorizeView Context="autorizacionDocumento">
                                                            <ChildContent Context="autorizacion">
                                                                <FilaRelacion Compacta="true" Nombre="@documento.TipoDocumentoNombre"
                                                                              Tono="@TonoDocumentoEnCentro(documento.Estado)"
                                                                              OnNombre="@(CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv.Split(',').Any(autorizacion.User.IsInRole) ? EventCallback.Factory.Create(this, () => GestionarDocumentoAsync(documento)) : default)">
                                                                    <Detalle>
                                                                        <CaeManager.Web.Features.Documentos.Components.LineaPlataformaYReclamacion
                                                                            Acreditaciones="documento.AcreditacionesEnElCentro" UltimaReclamacion="documento.UltimaReclamacion" Estado="documento.Estado" />
                                                                    </Detalle>
                                                                    <Cifra>
                                                                        <span class="trabajador360-solo-lectores">@Textos["ColumnaVigencia"]: </span>
                                                                        <TextoFechaCopiable Fecha="documento.FechaVencimiento" Class="@EstadoDocumentoUi.ClaseCeldaVigencia(documento.Estado)">
                                                                            @DetalleVigenciaDocumentoUi.DeFicha360(documento.Estado, documento.FechaVencimiento, documento.TipoDocumentoNombre)
                                                                        </TextoFechaCopiable>
                                                                    </Cifra>
                                                                    <Estado><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado, documento.EnToleranciaHasta)</Badge></Estado>
                                                                    <Acciones>
                                                                        @* Todo documento lleva «Gestionar»; Vigente y Sin caducidad, en tono secundario. *@
                                                                        @if (EstadoDocumentoFicha360.PideGestionar(documento.Estado))
                                                                        {
                                                                            <SoloConEscritura>
                                                                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="@EstadoDocumentoFicha360.ClaseGestionar(documento.Estado, "accion-fila-enlace")"
                                                                                       aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre)"
                                                                                       OnClick="() => GestionarDocumentoAsync(documento)">
                                                                                    @EstadoDocumentoFicha360.TextoAccion
                                                                                </Boton>
                                                                            </SoloConEscritura>
                                                                        }
                                                                    </Acciones>
                                                                </FilaRelacion>
                                                            </ChildContent>
                                                        </AuthorizeView>
                                                    }
                                                </ListaRelaciones>
                                            }
                                        </Desplegable>
                                    </FilaRelacion>
                                }
                                </ChildContent>
                            </ListaRelaciones>
                        </div>
                    }
                    break;

                case PestanaDocumentacion:
                    @*
                        Documentación del trabajador a día de hoy (decisión del
                        propietario 2026-09-24, Q1–Q4 = (a)). Dos bloques:
                        1. Todos sus documentos, con la fecha del documento y
                           su caducidad; los que no caducan dicen «Sin
                           caducidad» (Q4).
                        2. Lo exigido solo en algunos Centros de trabajo, por
                           par Trabajador–Centro (Q2): la fecha de renovación es
                           la caducidad del documento, igual en todos (Q1).
                    *@
                    @if (_cargandoDocumentos)
                    {
                        <EstadoCargando Filas="4" />
                    }
                    else if (_errorDocumentos)
                    {
                        <EstadoVacio Titulo="@Textos["DocumentacionErrorTitulo"]" Descripcion="@Textos["DocumentacionErrorDescripcion"]"
                                     NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
                            <Accion>
                                <Boton Variante="VarianteBoton.Primario" OnClick="CargarDocumentosAsync">@Comunes["Reintentar"]</Boton>
                            </Accion>
                        </EstadoVacio>
                    }
                    else
                    {
                        <div class="separador-ambito">@Textos["SeparadorDocumentosTrabajador"]</div>
                        @if (_documentos.Count == 0)
                        {
                            <p class="texto-vacio-seccion">@Textos["SinDocumentos"]</p>
                            <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="SubirDocumentoAsync">@Textos["BotonSubirDocumento"]</Boton></SoloConEscritura>
                        }
                        else
                        {
                            <div class="trabajador360-documentos">
                                <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["SeparadorDocumentosTrabajador"]">
                                    <Encabezado>@Textos[_totalDocumentos == 1 ? "ResumenDocumentoOrdenado" : "ResumenDocumentosOrdenados", _documentos.Count, _totalDocumentos]</Encabezado>
                                    <ChildContent>
                                    @foreach (var documento in DocumentosOrdenados)
                                    {
                                        var pideGestionar = EstadoDocumentoFicha360.PideGestionar(documento.Estado);
                                        <FilaRelacion @key="documento.Id" Nombre="@documento.TipoDocumentoNombre" Tono="@EstadoDocumentoFicha360.TonoFila(documento.Estado)">
                                            <Cifra><span>@Textos["ColumnaVence"]: </span><span class="trabajador360-vigencia @EstadoDocumentoUi.ClaseAvisoVigenciaSinConfirmar(documento.Estado)">@TextoVence(documento.FechaVencimiento, documento.Estado)</span></Cifra>
                                            <Estado><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></Estado>
                                            <Detalle>
                                                <span>@Textos["ColumnaFechaDocumento"]: <span class="trabajador360-emision">@documento.FechaEmision.ToString("dd/MM/yyyy")</span></span>
                                                <LineaPlataformaYReclamacion Acreditaciones="documento.Acreditaciones" Estado="documento.Estado" />
                                            </Detalle>
                                            <Acciones>
                                                @if (pideGestionar)
                                                {
                                                    <SoloConEscritura><Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" class="@EstadoDocumentoFicha360.ClaseGestionar(documento.Estado)" aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre)" OnClick="() => EditarDocumentoAsync(documento.Id)">@EstadoDocumentoFicha360.TextoAccion</Boton></SoloConEscritura>
                                                }
                                            </Acciones>
                                        </FilaRelacion>
                                    }
                                    </ChildContent>
                                </ListaRelaciones>
                            </div>
                        }

                        <div class="separador-ambito">@Textos["SeparadorExigidosEnCentros"]</div>
                        <p class="texto-descriptivo">@Textos["TextoExigidosEnCentros"]</p>
                        @if (ExigenciasPropiasDeCentros is { Count: > 0 } exigencias)
                        {
                            <div class="trabajador360-exigencias">
                                <ListaRelaciones EnTarjeta="true" Etiqueta="@Textos["SeparadorExigidosEnCentros"]">
                                    @{ var claves = new ClavesDeHermanos(); }
                                    @foreach (var exigencia in exigencias)
                                    {
                                        <FilaRelacion @key="claves.De((exigencia.CentroId, exigencia.Documento.TipoDocumentoId))" Nombre="@exigencia.Documento.TipoDocumentoNombre" Tono="@EstadoDocumentoFicha360.TonoFila(exigencia.Documento.Estado)">
                                            <Detalle>
                                                <span class="trabajador360-exigencia-centro"><a href="@($"/centros/{exigencia.CentroId}")">@exigencia.CentroNombre</a> @Textos["DelClienteEmpresarial", exigencia.ClienteRazonSocial]</span> ·
                                                @if (exigencia.Documento.DocumentoId is null)
                                                {
                                                    <span>@Textos["SinDocumentoExigido"]</span>
                                                }
                                                else
                                                {
                                                    @($"{Textos["ColumnaRenovarAntes"]} ")
                                                }
                                                <span aria-hidden="@(exigencia.Documento.DocumentoId is null)" class="trabajador360-vigencia @(exigencia.Documento.DocumentoId is null ? "trabajador360-solo-lectores" : null) @EstadoDocumentoUi.ClaseAvisoVigenciaSinConfirmar(exigencia.Documento.Estado)">@TextoVence(exigencia.Documento.FechaVencimiento, exigencia.Documento.Estado)</span>
                                            </Detalle>
                                            <Cifra><span class="trabajador360-solo-lectores">@Textos["ColumnaFechaDocumento"]: </span><span class="trabajador360-emision">@(exigencia.FechaEmision is { } emision ? emision.ToString("dd/MM/yyyy") : "—")</span></Cifra>
                                            <Estado><Badge Tono="EstadoDocumentoUi.Tono(exigencia.Documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(exigencia.Documento.Estado, exigencia.Documento.EnToleranciaHasta)</Badge></Estado>
                                        </FilaRelacion>
                                    }
                                </ListaRelaciones>
                            </div>
                        }
                        else
                        {
                            <p class="texto-vacio-seccion">@Textos["SinExigenciasPropias"]</p>
                        }
                    }
                    break;

                case PestanaFicha:
                    <CajasFicha Cajas="CajasDeFicha" />
                    break;

                case PestanaHistorial:
                    <PestanaHistorial EntidadTipo="Trabajador" EntidadId="TrabajadorId" />
                    break;
            }
        </Pestanas>
            </ChildContent>
            <Lateral>
                @*
                    Lo que era la pestaña «Contactos» (decisión del propietario
                    2026-09-24, punto 3): los datos de contacto del propio
                    trabajador, copiables, y la agenda de su empleador. Teléfono,
                    Correo y, como en la maqueta Trabajador 360 del 17-10, el
                    contacto de emergencia (nombre y teléfono copiable; decisión de
                    Chris, 2026-10-18). Dirección y firma de documentos NO se
                    construyen. El contacto solo llega a quien lee la nota interna
                    (ContactoEmergenciaVisible); al Usuario de Cliente, nunca. Sin
                    ningún dato no se pinta la tarjeta.
                *@
                @if (!string.IsNullOrWhiteSpace(_detalle.Telefono) || !string.IsNullOrWhiteSpace(_detalle.Email)
                     || !string.IsNullOrWhiteSpace(_detalle.ContactoEmergenciaNombre) || !string.IsNullOrWhiteSpace(_detalle.ContactoEmergenciaTelefono))
                {
                    <Tarjeta Titulo="@Textos["SeparadorDatosTrabajador"]" Compacta="true">
                        <dl class="trabajador360-contactos">
                            @if (!string.IsNullOrWhiteSpace(_detalle.Telefono))
                            {
                                <div class="trabajador360-contacto">
                                    <dt class="trabajador360-contacto-clave">@Textos["EtiquetaTelefono"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.Telefono</span>
                                        <BotonCopiar Valor="@_detalle.Telefono" Etiqueta="@Textos["FichaCopiarTelefono"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarTelefono"]]" />
                                    </dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.Email))
                            {
                                <div class="trabajador360-contacto">
                                    <dt class="trabajador360-contacto-clave">@Textos["EtiquetaCorreo"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.Email</span>
                                        <BotonCopiar Valor="@_detalle.Email" Etiqueta="@Textos["FichaCopiarCorreo"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarCorreo"]]" />
                                    </dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.ContactoEmergenciaNombre))
                            {
                                <div class="trabajador360-contacto" data-contacto="emergencia-nombre">
                                    <dt class="trabajador360-contacto-clave">@Textos["FichaContactoEmergencia"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.ContactoEmergenciaNombre</span>
                                    </dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.ContactoEmergenciaTelefono))
                            {
                                <div class="trabajador360-contacto" data-contacto="emergencia-telefono">
                                    <dt class="trabajador360-contacto-clave">@Textos["FichaTelefonoEmergencia"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.ContactoEmergenciaTelefono</span>
                                        <BotonCopiar Valor="@_detalle.ContactoEmergenciaTelefono" Etiqueta="@Textos["FichaCopiarTelefonoEmergencia"]" NombreAccesible="@Textos["FichaCopiarNombreAccesible", Textos["FichaCopiarTelefonoEmergencia"]]" />
                                    </dd>
                                </div>
                            }
                        </dl>
                    </Tarjeta>
                }
                @if (_detalle.EmpresaId is not null || _detalle.SubcontrataId is not null)
                {
                    <Tarjeta Titulo="@Textos["SeparadorAgendaEmpleador"]" Compacta="true">
                        <div class="trabajador360-agenda">
                            @if (_detalle.EmpresaId is { } empresaIdContactos)
                            {
                                <PestanaAgendaContactos VacioCompacto="true" Tipo="TipoPropietarioAgenda.Empresa" PropietarioId="empresaIdContactos" />
                            }
                            else if (_detalle.SubcontrataId is { } subcontrataIdContactos)
                            {
                                <PestanaAgendaContactos VacioCompacto="true" Tipo="TipoPropietarioAgenda.Subcontrata" PropietarioId="subcontrataIdContactos" />
                            }
                        </div>
                    </Tarjeta>
                }

                @* Nota interna: el servidor decide si el lector es del equipo (NotaInternaVisible); a un usuario de
                   Cliente no le llega ni la tarjeta vacía. *@
                @if (_detalle.NotaInternaVisible)
                {
                    <NotaInternaEditable @key="_detalle.Id" Texto="@_detalle.Notas" Guardar="GuardarNotaInternaAsync" OnGuardada="RecargarTrasNotaInternaAsync" />
                }
            </Lateral>
        </CuerpoConLateral>
    }
</div>

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

@* Los dos modales de la ficha son ModalFormulario: cada uno con su guardián, su estado de «guardando», su aviso fijo (el rechazo del servidor) y el
   motivo por el que «Crear» o «Reclamar» están deshabilitados (antes eran primarios mudos). Cada kit trae su aviso de navegación. *@
<ModalFormulario Visible="_crearGestionVisible" VisibleChanged="v => { if (v || !_creandoGestion) _crearGestionVisible = v; }" Titulo="@Textos["ModalCrearGestionTitulo"]"
                 HayCambios="() => HayCambiosCrearGestion" Guardando="_creandoGestion" MensajeError="@_errorCrearGestion"
                 MotivoGuardarDeshabilitado="@(string.IsNullOrEmpty(_tipoDocumentoParaGestion) ? Textos["MotivoCrearGestionSinTipo"].Value : null)"
                 OnGuardar="ConfirmarCrearGestionAsync" TextoGuardar="@Textos["BotonCrear"]" TextoCancelar="@Textos["BotonCancelar"]">
    <p class="workspace-nota-contextual">@Textos["NotaCrearGestion"]</p>
    <CampoSelect Etiqueta="@Textos["EtiquetaTipoDocumento"]" Valor="@_tipoDocumentoParaGestion" ValorChanged="v => { _tipoDocumentoParaGestion = v; _errorCrearGestion = null; }">
        <option value="">@Textos["OpcionSeleccionaTipoDocumento"]</option>
        @foreach (var tipo in _tiposDocumentoDisponibles)
        {
            <option value="@tipo.Id">@tipo.Nombre</option>
        }
    </CampoSelect>
</ModalFormulario>

@* Confirmación de «Gestionar» (reclamar): se abre siempre, con uno o con varios Clientes empresariales, y no se envía
   nada hasta pulsar «Reclamar» (es un correo a un tercero). *@
@* FS-13: la baja de una asignación se confirma y se puede deshacer desde el aviso. *@
<DialogoConfirmacion
    Visible="_confirmarBajaAsignacionVisible"
    VisibleChanged="v => _confirmarBajaAsignacionVisible = v"
    Titulo="@Textos["ConfirmarBajaAsignacionTitulo"]"
    Mensaje="@Textos["ConfirmarBajaAsignacionMensaje", NombreCompleto ?? string.Empty, _centroABajar].Value"
    TextoBotonConfirmar="@Textos["AccionDarDeBaja"]"
    EnProgreso="_asignacionABajar is { } enCurso && _dandoDeBajaAsignacion.Contains(enCurso)"
    OnConfirmar="ConfirmarBajaAsignacionAsync" />

<ModalFormulario Visible="_reclamarFaltantesVisible" VisibleChanged="v => { if (v || !_reclamandoFaltantes) _reclamarFaltantesVisible = v; }" Titulo="@Textos["ModalReclamarTitulo"]"
                 HayCambios="() => HayCambiosReclamar" Guardando="_reclamandoFaltantes" MensajeError="@_errorReclamar"
                 MotivoGuardarDeshabilitado="@(_clientesSeleccionadosReclamar.Count == 0 ? Textos["MotivoReclamarSinCliente"].Value : null)"
                 OnGuardar="ConfirmarReclamarFaltantesAsync" TextoGuardar="@Textos["BotonReclamar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <p class="workspace-nota-contextual">
        @if (_clientesReclamables.Count == 1)
        {
            @Textos["NotaReclamarUno", NombreCompleto ?? string.Empty, _clientesReclamables[0].ClienteRazonSocial]
        }
        else
        {
            @Textos["NotaReclamarVarios", NombreCompleto ?? string.Empty]
        }
    </p>
    <fieldset class="reclamacion-destinatarios" disabled="@_reclamandoFaltantes">
        <legend>@Textos["LeyendaClientesEmpresariales"]</legend>
        @foreach (var cliente in _clientesReclamables)
        {
            <label class="campo-checkbox" @key="cliente.ClienteId">
                <input type="checkbox"
                       checked="@_clientesSeleccionadosReclamar.Contains(cliente.ClienteId)"
                       @onchange="e => AlternarClienteReclamar(cliente.ClienteId, (bool)e.Value!)" />
                <span>@cliente.ClienteRazonSocial</span>
                <span class="reclamacion-motivo">@(cliente.DocumentoIds.Count == 1 ? Textos["DocumentosPendientesUno"] : Textos["DocumentosPendientesVarios", cliente.DocumentoIds.Count])</span>
            </label>
        }
    </fieldset>
</ModalFormulario>
@* Trabajador de Empresa: «Reclamar faltantes» va a su Empresa empleadora, por Delegación, con el cajón de «Gestionar». *@
<CaeManager.Web.Features.Bandeja.Components.DrawerReclamacionLote
    Visible="_reclamacionEmpresaVisible" VisibleChanged="v => _reclamacionEmpresaVisible = v"
    AmbitosDisponibles="@(new[] { AmbitoAplicacion.Trabajador, AmbitoAplicacion.Empresa })"
    AmbitoInicial="AmbitoAplicacion.Trabajador" EntidadIdInicial="TrabajadorId" IncluirPendientesSinFecha="true" />
@if (_detalle is not null)
{
    <SoloConEscritura>
        <EditarFichaTrabajadorDrawer @key="TrabajadorId" TrabajadorId="TrabajadorId" Visible="_editorFichaVisible"
            VisibleChanged="v => _editorFichaVisible = v" OnGuardada="CargarAsync" />
    </SoloConEscritura>
}
</LimiteDeErrores>

@code {
    // El permiso de trabajo solo llega a quien puede leerlo (ObtenerTrabajadorPorIdQuery, decisión del 2026-10-15): al
    // Usuario de Cliente se le retira la caja entera en vez de enseñarle una caja vacía que parecería «sin permiso».
    private IReadOnlyList<CajaFicha> CajasDeFicha => _detalle?.PermisoTrabajoVisible == true
        ? [new("altas-plataforma", CajaAltasPlataforma), new("vinculo-empresa", CajaVinculoEmpresa), new("permiso-trabajo", CajaPermisoTrabajo)]
        : [new("altas-plataforma", CajaAltasPlataforma), new("vinculo-empresa", CajaVinculoEmpresa)];

    private RenderFragment AccionEditarFicha => @<SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _editorFichaVisible = true">@Textos["FichaEditarEnlace"]</Boton></SoloConEscritura>;

    private RenderFragment CajaAltasPlataforma => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaDatosAltas"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaAfiliacion"]">
                            @if (FormatoAfiliacion(detalle.NumeroAfiliacionSeguridadSocial) is { } valor)
                            {
                                <BotonCopiar Valor="@valor" Texto="@valor" Etiqueta="@Textos["FichaCopiarAfiliacion"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarAfiliacion"], valor]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaPuesto"]" Valor="@detalle.Puesto" />
                        <DatoRejilla Etiqueta="@Textos["EtiquetaFechaNacimiento"]">
                            @if (detalle.FechaNacimiento?.ToString("dd/MM/yyyy") is { } valor)
                            {
                                <BotonCopiar Valor="@valor" Texto="@valor" Etiqueta="@Textos["FichaCopiarNacimiento"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarNacimiento"], valor]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaNacionalidad"]" Valor="@detalle.Nacionalidad" />
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaVinculoEmpresa => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaVinculoEmpresa"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaTipoVinculo"]" Valor="@detalle.TipoVinculo" />
                        <DatoRejilla Etiqueta="@Textos["FichaAltaEmpresa"]">
                            @if (detalle.FechaAltaEmpresa?.ToString("dd/MM/yyyy") is { } valor)
                            {
                                <BotonCopiar Valor="@valor" Texto="@valor" Etiqueta="@Textos["FichaCopiarAltaEmpresa"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarAltaEmpresa"], valor]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaBaja"]">
                            @if (detalle.FechaBajaEmpresa?.ToString("dd/MM/yyyy") is { } valor)
                            {
                                <BotonCopiar Valor="@valor" Texto="@valor" Etiqueta="@Textos["FichaCopiarBajaEmpresa"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarBajaEmpresa"], valor]" />
                            }
                            else if (detalle.FechaAltaEmpresa is not null)
                            {
                                @* Maqueta: «Sigue de alta». Solo con un alta informada; sin ella no hay vínculo que afirmar. *@
                                <span>@Textos["FichaSigueDeAlta"]</span>
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaFiguraRnt"]" Valor="@detalle.FiguraEnRnt" />
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

    private RenderFragment CajaPermisoTrabajo => __builder =>
    {
        if (_detalle is { } detalle)
        {
            <Tarjeta Titulo="@Textos["FichaPermisoTrabajo"]" Compacta="true">
                <AccionesHeader>@AccionEditarFicha</AccionesHeader>
                <ChildContent>
                    <RejillaDatos>
                        <DatoRejilla Etiqueta="@Textos["FichaTipoPermiso"]" Valor="@detalle.TipoPermisoTrabajo" Ancho="true" />
                        <DatoRejilla Etiqueta="@Textos["FichaCaduca"]">
                            @if (detalle.CaducidadPermisoTrabajo?.ToString("dd/MM/yyyy") is { } valor)
                            {
                                <BotonCopiar Valor="@valor" Texto="@valor" Etiqueta="@Textos["FichaCopiarCaducidadPermiso"]" NombreAccesible="@Textos["FichaCopiarNombreAccesibleConValor", Textos["FichaCopiarCaducidadPermiso"], valor]" />
                            }
                            else { <span>—</span> }
                        </DatoRejilla>
                        <DatoRejilla Etiqueta="@Textos["FichaMotivo"]" Valor="@detalle.MotivoPermisoTrabajo" />
                    </RejillaDatos>
                </ChildContent>
            </Tarjeta>
        }
    };

}
