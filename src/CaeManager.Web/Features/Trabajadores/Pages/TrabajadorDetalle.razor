@*
    Trabajador 360 (Parte XVI PROMPT 04) — ver comentario de cabecera en el
    .razor.cs para el porqué de lo que esta página NO reimplementa.
*@
@page "/trabajadores/{TrabajadorId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Application.Asignaciones.Queries.ObtenerAsignacionesDocumentacionPorCentro
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Application.Trabajadores.Queries.ObtenerDocumentacionPorCentroDeTrabajador
@using CaeManager.Domain.Documentos
@using CaeManager.Domain.Gestiones
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components

<PageTitle>@(NombreCompleto ?? Textos["TituloDetalleSinNombre"].Value) — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <Breadcrumb Elementos="Miguero" ElementoSeleccionadoChanged="IrABreadcrumb" EtiquetaNavegacion="@Textos["AriaMigas"]" />

    @if (_error)
    {
        <EstadoVacio Titulo="@Textos["DetalleErrorTitulo"]" Descripcion="@Textos["DetalleErrorDescripcion"]">
            <Accion>
                <Boton OnClick="CargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="5" />
    }
    else if (_detalle is not null)
    {
        @*
            Cabecera plana, como Empresa 360 y Cliente 360 (decisión del
            propietario 2026-09-24, opción C): el anillo a la izquierda de la
            identidad, la entradilla con el DNI y el empleador, y a la derecha
            la acción principal con el resto en el menú «⋯».
        *@
        <CabeceraPagina Titulo="@(NombreCompleto ?? string.Empty)" Kicker="@Textos["Kicker"]">
            <Inicio>
                <AnilloCumplimiento Porcentaje="Cumplimiento" Tamano="TamanoAnillo.Cabecera"
                                     Etiqueta="@(Textos["AnilloCumplimiento", Cumplimiento?.ToString() ?? string.Empty])" />
            </Inicio>
            <JuntoAlTitulo>
                @if (!string.IsNullOrWhiteSpace(_detalle.Alias))
                {
                    <span class="trabajador360-alias">(@_detalle.Alias)</span>
                }
            </JuntoAlTitulo>
            <Descripcion>
                DNI: <b>@_detalle.Dni</b>
                <BotonCopiar Valor="@_detalle.Dni" Etiqueta="@Textos["EtiquetaCopiarDni"]" />
                · <button type="button" class="enlace-nombre-fila" @onclick="AbrirEmpleador">@_detalle.EmpleadorNombre</button>
                <span class="trabajador360-indicadores">
                    @if (PeorEstadoGlobal is { } peorEstado)
                    {
                        <Badge Tono="EstadoDocumentoUi.Tono(peorEstado)">@EstadoDocumentoUi.Texto(peorEstado)</Badge>
                    }
                    @if (CentroMasUrgente is { PeorEstado: not EstadoDocumento.Vigente } centroUrgente)
                    {
                        var incidenciasCentro = centroUrgente.Documentos.Count(d => d.Estado != EstadoDocumento.Vigente);
                        <VentanaContexto Etiqueta="@(incidenciasCentro == 1 ? Textos["VentanaIncidenciasUno", centroUrgente.CentroNombre] : Textos["VentanaIncidenciasVarios", incidenciasCentro, centroUrgente.CentroNombre])"
                                         Titulo="@(Textos["VentanaProblemaUrgente", centroUrgente.CentroNombre])">
                            <Disparador>
                                <Badge Tono="TonoBadge.Peligro" Tamano="TamanoBadge.Pequeno">
                                    @(incidenciasCentro == 1 ? Textos["BadgeIncidenciasCentroUno", centroUrgente.CentroNombre] : Textos["BadgeIncidenciasCentroVarios", incidenciasCentro, centroUrgente.CentroNombre])
                                </Badge>
                            </Disparador>
                            <Detalle>
                                @foreach (var documento in centroUrgente.Documentos.Where(d => d.Estado != EstadoDocumento.Vigente))
                                {
                                    <span class="ventana-linea">@documento.TipoDocumentoNombre — @EstadoDocumentoUi.Texto(documento.Estado)</span>
                                }
                            </Detalle>
                        </VentanaContexto>
                    }
                </span>
            </Descripcion>
            <Acciones>
                <span class="trabajador360-acciones">
                    <SoloConEscritura><Boton Deshabilitado="DocumentoMasUrgente is null" OnClick="SubirDocumentoMasUrgenteAsync">@Textos["BotonSubirDocumento"]</Boton></SoloConEscritura>
                    <MenuAcciones>
                        <SoloConEscritura><ItemMenuAccion OnClick="AbrirInformacion">@Textos["AccionEditar"]</ItemMenuAccion></SoloConEscritura>
                        <SoloConEscritura><ItemMenuAccion OnClick="ReclamarFaltantesAsync">@Textos["AccionReclamarFaltantes"]</ItemMenuAccion></SoloConEscritura>
                        <SoloConEscritura><ItemMenuAccion OnClick="AbrirCrearGestionAsync">@Textos["AccionCrearGestion"]</ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </span>
            </Acciones>
        </CabeceraPagina>

        <CuerpoConLateral EtiquetaLateral="@Textos["EtiquetaLateral"]">
            <ChildContent>
        <Pestanas Definiciones="Pestanas" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="v => _pestanaActiva = v" EtiquetaGrupo="@Textos["AriaSeccionesTrabajador360"]">
            @switch (_pestanaActiva)
            {
                case "operacion":
                    @*
                        Franja «Por vencer» (decisión del propietario 2026-09-24,
                        Q3 = (a)): los documentos del trabajador en Próximo o
                        Urgente, con el umbral ámbar del tenant. Va antes que los
                        Centros porque es lo que hay que renovar ya. Sin ninguno,
                        la franja no se pinta.
                    *@
                    @if (DocumentosPorVencer is { Count: > 0 } porVencer)
                    {
                        <div class="separador-ambito">@Textos["SeparadorPorVencer"]</div>
                        <ul class="trabajador360-por-vencer" aria-label="@Textos["SeparadorPorVencer"]">
                            @foreach (var documento in porVencer)
                            {
                                <li class="trabajador360-por-vencer-fila" @key="documento.Id">
                                    <span class="trabajador360-por-vencer-nombre">@documento.TipoDocumentoNombre</span>
                                    <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado)</Badge>
                                    <span class="trabajador360-por-vencer-fecha">@Textos["VenceEl", TextoVence(documento.FechaVencimiento, documento.Estado)]</span>
                                </li>
                            }
                        </ul>
                    }

                    @*
                        Ámbito 1: Documentación por centro (completo — es lo que se
                        opera aquí, a diferencia de la pestaña "Documentación" plana
                        del Workspace Panel). Acordeón por centro, mismo lenguaje que
                        AcordeonAsignacionesCentro pero con Centro como sujeto en vez
                        de Trabajador.
                    *@
                    @if (_centros.Count == 0)
                    {
                        <EstadoVacio Titulo="@Textos["VacioAsignacionesTitulo"]" Descripcion="@Textos["VacioAsignacionesDescripcion"]" />
                    }
                    else
                    {
                        <div class="separador-ambito">@Textos["SeparadorDocumentacionPorCentro"]</div>
                        @*
                            Mockup Gen 2 § Operación: lo primero que hay que
                            entender de esta lista es por qué el mismo
                            trabajador puede estar completo en una fila y
                            bloqueado en la de al lado.
                        *@
                        <p class="texto-descriptivo">
                            @Textos["TextoExigenciaPorCentro"]
                        </p>
                        <div class="trabajador360-centros">
                            @foreach (var centro in _centros)
                            {
                                var expandido = _expandidosCentro.Contains(centro.CentroId);
                                var alDia = centro.Documentos.Count(d => d.Estado == EstadoDocumento.Vigente);
                                var incidencias = centro.Documentos.Count(d => d.Estado != EstadoDocumento.Vigente);
                                <div class="trabajador360-centro @(incidencias > 0 ? "trabajador360-centro-con-incidencia" : null)" @key="centro.CentroId">
                                    <div class="trabajador360-centro-cabecera">
                                        @*
                                            Un solo botón con el chevron y las dos líneas: el nombre
                                            accesible sale del contenido, así que no lleva aria-label
                                            que pudiera decir otra cosa que lo que se lee.
                                        *@
                                        <button type="button" class="trabajador360-centro-disparador"
                                                aria-expanded="@(expandido ? "true" : "false")"
                                                @onclick="() => AlternarExpansionCentro(centro.CentroId)">
                                            <span class="trabajador360-centro-chevron @(expandido ? "trabajador360-centro-chevron-abierta" : null)">
                                                <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                                            </span>
                                            <span class="trabajador360-centro-identidad">
                                                <span class="trabajador360-centro-nombre">@centro.CentroNombre</span>
                                                <span class="trabajador360-centro-resumen">
                                                    @centro.ClienteRazonSocial ·
                                                    @(centro.Documentos.Count == 0
                                                        ? Textos["ResumenSinExigencia"]
                                                        : Textos["ResumenExigidosCorrectos", alDia, centro.Documentos.Count])
                                                </span>
                                            </span>
                                        </button>
                                        <Badge Tono="EstadoDocumentoUi.Tono(centro.PeorEstado)" Tamano="TamanoBadge.Pequeno">
                                            @(incidencias == 0
                                                ? Textos["BadgeCompleto"]
                                                : incidencias == 1 ? Textos["IncidenciasUno"] : Textos["IncidenciasVarios", incidencias])
                                        </Badge>
                                        <a class="trabajador360-centro-360" href="@($"/centros/{centro.CentroId}")"
                                           title="@Textos["TituloAbrirCentro360"]"
                                           aria-label="@(Textos["AriaAbrirCentro360", centro.CentroNombre])">
                                            <Icono Nombre="centros" Tamano="TamanoIcono.Pequeno" />
                                        </a>
                                    </div>
                                    @if (expandido)
                                    {
                                        <div class="trabajador360-centro-detalle">
                                            @if (centro.Documentos.Count == 0)
                                            {
                                                <p class="texto-vacio-seccion">@Textos["TextoCentroSinExigencia"]</p>
                                            }
                                            else
                                            {
                                                <div class="tabla-documentos-requeridos" role="table" aria-label="@(Textos["AriaDocumentacionExigida", centro.CentroNombre])">
                                                    <div class="documentos-requeridos-cabecera" role="row">
                                                        <span role="columnheader">@Textos["ColumnaDocumento"]</span>
                                                        <span role="columnheader">@Textos["ColumnaEstado"]</span>
                                                        <span role="columnheader">@Textos["ColumnaVigencia"]</span>
                                                        <span role="columnheader" class="columna-accion">@Textos["ColumnaAccion"]</span>
                                                    </div>
                                                    @foreach (var documento in centro.Documentos)
                                                    {
                                                        <div class="fila-documento-requerido" role="row" @key="documento.TipoDocumentoId">
                                                            <span class="celda-documento-nombre" role="cell">
                                                                @* El nombre abre el mismo drawer de gestión que la columna de acción, que Consulta no puede usar:
                                                                   a Consulta se le pinta como texto. *@
                                                                <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv" Context="autorizacionNombre">
                                                                    <Authorized>
                                                                        <button type="button" class="enlace-nombre-fila" @onclick="() => GestionarDocumentoAsync(documento)">
                                                                            @documento.TipoDocumentoNombre
                                                                        </button>
                                                                    </Authorized>
                                                                    <NotAuthorized>@documento.TipoDocumentoNombre</NotAuthorized>
                                                                </AuthorizeView>
                                                            </span>
                                                            <span role="cell">
                                                                <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">
                                                                    @EstadoDocumentoUi.Texto(documento.Estado)
                                                                </Badge>
                                                            </span>
                                                            <span role="cell">
                                                                <TextoFechaCopiable Fecha="documento.FechaVencimiento" Class="celda-documento-vigencia">
                                                                    @(documento.FechaVencimiento is { } vence ? vence.ToString("dd/MM/yyyy") : "—")
                                                                </TextoFechaCopiable>
                                                            </span>
                                                            <span class="columna-accion" role="cell">
                                                                @* Abre DrawerGestionDocumento, que solo crea o renueva (ICommand denegados a
                                                                   Consulta) — también cuando el rótulo dice «Ver». Igual que «Subir documento». *@
                                                                <SoloConEscritura>
                                                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                                           OnClick="() => GestionarDocumentoAsync(documento)">
                                                                        @(documento.DocumentoId is null ? Textos["AccionSubir"] : documento.Estado == EstadoDocumento.Vigente ? Textos["AccionVer"] : Textos["AccionRenovar"])
                                                                    </Boton>
                                                                </SoloConEscritura>
                                                            </span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @*
                            Ámbito 2: Asignaciones (compacto) — mismos centros de
                            arriba, sin volver a consultar el servidor: es el mismo
                            AsignacionId/CentroNombre/ClienteRazonSocial/FechaAlta ya
                            cargado para la Documentación por centro.
                        *@
                        <div class="separador-ambito">@Textos["SeparadorAsignaciones"]</div>
                        <div class="tabla-documentos-requeridos" role="table" aria-label="@Textos["AriaAsignacionesActivas"]">
                            <div class="documentos-requeridos-cabecera" role="row">
                                <span role="columnheader">@Textos["ColumnaCentro"]</span>
                                <span role="columnheader">@Textos["ColumnaClienteEmpresarial"]</span>
                                <span role="columnheader">@Textos["ColumnaDesde"]</span>
                                <span role="columnheader" class="columna-accion">@Textos["ColumnaAccion"]</span>
                            </div>
                            @foreach (var centro in _centros)
                            {
                                <div class="fila-documento-requerido" role="row" @key="centro.AsignacionId">
                                    <span class="celda-documento-nombre" role="cell">@centro.CentroNombre</span>
                                    <span role="cell">@centro.ClienteRazonSocial</span>
                                    <span role="cell">@centro.FechaAlta.ToString("dd/MM/yyyy")</span>
                                    <span class="columna-accion" role="cell">
                                        @* DarDeBajaAsignacionesCommand es ICommand, denegado a Consulta. La celda se
                                           queda (vacía) para no desalinear la rejilla con la cabecera. *@
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                   OnClick="() => DarDeBajaAsignacionAsync(centro.AsignacionId)">
                                                @Textos["AccionDarDeBaja"]
                                            </Boton>
                                        </SoloConEscritura>
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    @*
                        Ámbito 3: Gestiones pendientes (solo si hay, 04 § 6 — un
                        vacío nunca se presenta como éxito, pero tampoco se muestra
                        un bloque vacío sin motivo: si no hay ninguna, el bloque
                        entero no aparece).
                    *@
                    @if (_cargandoGestiones)
                    {
                        <div class="separador-ambito">@Textos["SeparadorGestionesPendientes"]</div>
                        <EstadoCargando Filas="2" />
                    }
                    else if (_gestionesPendientes.Count > 0)
                    {
                        <div class="separador-ambito">@Textos["SeparadorGestionesPendientes"]</div>
                        <div class="tabla-documentos-requeridos" role="table" aria-label="@Textos["SeparadorGestionesPendientes"]">
                            <div class="documentos-requeridos-cabecera" role="row">
                                <span role="columnheader">@Textos["ColumnaGestion"]</span>
                                <span role="columnheader">@Textos["ColumnaCentro"]</span>
                                <span role="columnheader">@Textos["ColumnaCreada"]</span>
                                <span role="columnheader" class="columna-accion">@Textos["ColumnaAccion"]</span>
                            </div>
                            @foreach (var gestion in _gestionesPendientes)
                            {
                                <div class="fila-documento-requerido" role="row" @key="gestion.Id">
                                    <span class="celda-documento-nombre" role="cell">@gestion.TipoDocumentoNombre</span>
                                    <span role="cell">@gestion.CentroNombre</span>
                                    <span role="cell">@gestion.CreadoEnUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                    <span class="columna-accion" role="cell">
                                        @* CompletarGestionCommand es ICommand, denegado a Consulta. *@
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                                   Cargando="_completandoGestion.Contains(gestion.Id)"
                                                   OnClick="() => CompletarGestionAsync(gestion.Id)">
                                                @Textos["AccionCompletar"]
                                            </Boton>
                                        </SoloConEscritura>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    break;

                case "documentacion":
                    @*
                        Documentación del trabajador a día de hoy (decisión del
                        propietario 2026-09-24, Q1–Q4 = (a)). Dos bloques:
                        1. Todos sus documentos, con la fecha del documento y
                           su caducidad; los que no caducan dicen «Sin
                           caducidad» (Q4).
                        2. Lo exigido solo en algunos Centros de trabajo, por
                           par Trabajador–Centro (Q2): la fecha de renovación es
                           la caducidad del documento, igual en todos (Q1).
                    *@
                    @if (_cargandoDocumentos)
                    {
                        <EstadoCargando Filas="4" />
                    }
                    else if (_errorDocumentos)
                    {
                        <EstadoVacio Titulo="@Textos["DocumentacionErrorTitulo"]" Descripcion="@Textos["DocumentacionErrorDescripcion"]"
                                     NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
                            <Accion>
                                <Boton OnClick="CargarDocumentosAsync">@Comunes["Reintentar"]</Boton>
                            </Accion>
                        </EstadoVacio>
                    }
                    else
                    {
                        <div class="separador-ambito">@Textos["SeparadorDocumentosTrabajador"]</div>
                        @if (_documentos.Count == 0)
                        {
                            <p class="texto-vacio-seccion">@Textos["SinDocumentos"]</p>
                        }
                        else
                        {
                            <div class="tabla-documentos-requeridos trabajador360-documentos" role="table" aria-label="@Textos["SeparadorDocumentosTrabajador"]">
                                <div class="documentos-requeridos-cabecera" role="row">
                                    <span role="columnheader">@Textos["ColumnaDocumento"]</span>
                                    <span role="columnheader">@Textos["ColumnaEstado"]</span>
                                    <span role="columnheader">@Textos["ColumnaFechaDocumento"]</span>
                                    <span role="columnheader">@Textos["ColumnaVence"]</span>
                                </div>
                                @foreach (var documento in DocumentosOrdenados)
                                {
                                    <div class="fila-documento-requerido" role="row" @key="documento.Id">
                                        <span class="celda-documento-nombre" role="cell">@documento.TipoDocumentoNombre</span>
                                        <span role="cell">
                                            <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado)</Badge>
                                        </span>
                                        <span role="cell">@documento.FechaEmision.ToString("dd/MM/yyyy")</span>
                                        <span role="cell">@TextoVence(documento.FechaVencimiento, documento.Estado)</span>
                                    </div>
                                }
                            </div>
                            @if (_totalDocumentos > _documentos.Count)
                            {
                                <p class="texto-descriptivo">@Textos["MostrandoDocumentos", _documentos.Count, _totalDocumentos]</p>
                            }
                        }

                        <div class="separador-ambito">@Textos["SeparadorExigidosEnCentros"]</div>
                        <p class="texto-descriptivo">@Textos["TextoExigidosEnCentros"]</p>
                        @if (ExigenciasPropiasDeCentros is { Count: > 0 } exigencias)
                        {
                            <div class="tabla-documentos-requeridos trabajador360-exigencias" role="table" aria-label="@Textos["SeparadorExigidosEnCentros"]">
                                <div class="documentos-requeridos-cabecera" role="row">
                                    <span role="columnheader">@Textos["ColumnaDocumento"]</span>
                                    <span role="columnheader">@Textos["ColumnaCentroTrabajo"]</span>
                                    <span role="columnheader">@Textos["ColumnaEstado"]</span>
                                    <span role="columnheader">@Textos["ColumnaFechaDocumento"]</span>
                                    <span role="columnheader">@Textos["ColumnaRenovarAntes"]</span>
                                </div>
                                @foreach (var exigencia in exigencias)
                                {
                                    <div class="fila-documento-requerido" role="row" @key="(exigencia.CentroId, exigencia.Documento.TipoDocumentoId)">
                                        <span class="celda-documento-nombre" role="cell">@exigencia.Documento.TipoDocumentoNombre</span>
                                        <span role="cell" class="trabajador360-exigencia-centro">
                                            <a href="@($"/centros/{exigencia.CentroId}")">@exigencia.CentroNombre</a>
                                            <span class="trabajador360-exigencia-cliente">@Textos["DelClienteEmpresarial", exigencia.ClienteRazonSocial]</span>
                                        </span>
                                        <span role="cell">
                                            <Badge Tono="EstadoDocumentoUi.Tono(exigencia.Documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(exigencia.Documento.Estado)</Badge>
                                        </span>
                                        <span role="cell">@(exigencia.FechaEmision is { } emision ? emision.ToString("dd/MM/yyyy") : "—")</span>
                                        <span role="cell">@TextoVence(exigencia.Documento.FechaVencimiento, exigencia.Documento.Estado)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="texto-vacio-seccion">@Textos["SinExigenciasPropias"]</p>
                        }
                    }
                    break;

                case "historial":
                    <PestanaHistorial EntidadTipo="Trabajador" EntidadId="TrabajadorId" />
                    break;
            }
        </Pestanas>
            </ChildContent>
            <Lateral>
                @*
                    Lo que era la pestaña «Contactos» (decisión del propietario
                    2026-09-24, punto 3): los datos de contacto del propio
                    trabajador, copiables, y la agenda de su empleador. Solo
                    Teléfono y Correo, los únicos que trae TrabajadorDetalleDto:
                    Dirección y contacto de emergencia NO existen en ningún DTO y
                    no se inventan. Sin ninguno de los dos no se pinta la tarjeta.
                *@
                @if (!string.IsNullOrWhiteSpace(_detalle.Telefono) || !string.IsNullOrWhiteSpace(_detalle.Email))
                {
                    <Tarjeta Titulo="@Textos["SeparadorDatosTrabajador"]" Compacta="true">
                        <dl class="trabajador360-contactos">
                            @if (!string.IsNullOrWhiteSpace(_detalle.Telefono))
                            {
                                <div class="trabajador360-contacto">
                                    <dt class="trabajador360-contacto-clave">@Textos["EtiquetaTelefono"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.Telefono</span>
                                        <BotonCopiar Valor="@_detalle.Telefono" Etiqueta="@Textos["EtiquetaCopiarTelefono"]" />
                                    </dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detalle.Email))
                            {
                                <div class="trabajador360-contacto">
                                    <dt class="trabajador360-contacto-clave">@Textos["EtiquetaCorreo"]</dt>
                                    <dd class="trabajador360-contacto-valor">
                                        <span class="trabajador360-contacto-texto">@_detalle.Email</span>
                                        <BotonCopiar Valor="@_detalle.Email" Etiqueta="@Textos["EtiquetaCopiarCorreo"]" />
                                    </dd>
                                </div>
                            }
                        </dl>
                    </Tarjeta>
                }
                @if (_detalle.EmpresaId is not null || _detalle.SubcontrataId is not null)
                {
                    <Tarjeta Titulo="@Textos["SeparadorAgendaEmpleador"]" Compacta="true">
                        <div class="trabajador360-agenda">
                            @if (_detalle.EmpresaId is { } empresaIdContactos)
                            {
                                <PestanaAgendaContactos Tipo="TipoPropietarioAgenda.Empresa" PropietarioId="empresaIdContactos" />
                            }
                            else if (_detalle.SubcontrataId is { } subcontrataIdContactos)
                            {
                                <PestanaAgendaContactos Tipo="TipoPropietarioAgenda.Subcontrata" PropietarioId="subcontrataIdContactos" />
                            }
                        </div>
                    </Tarjeta>
                }
            </Lateral>
        </CuerpoConLateral>
    }
</div>

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

<Modal Visible="_crearGestionVisible" VisibleChanged="v => _crearGestionVisible = v" Titulo="@Textos["ModalCrearGestionTitulo"]" CerrarAlHacerClicFuera="!_creandoGestion">
    <ChildContent>
        <p class="workspace-nota-contextual">@Textos["NotaCrearGestion"]</p>
        <CampoSelect Etiqueta="@Textos["EtiquetaTipoDocumento"]" Valor="@_tipoDocumentoParaGestion" ValorChanged="v => _tipoDocumentoParaGestion = v">
            <option value="">@Textos["OpcionSeleccionaTipoDocumento"]</option>
            @foreach (var tipo in _tiposDocumentoDisponibles)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
            }
        </CampoSelect>
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_creandoGestion" OnClick="() => _crearGestionVisible = false">@Textos["BotonCancelar"]</Boton>
        <Boton Cargando="_creandoGestion" Deshabilitado="string.IsNullOrEmpty(_tipoDocumentoParaGestion)" OnClick="ConfirmarCrearGestionAsync">@Textos["BotonCrear"]</Boton>
    </Pie>
</Modal>

@* Solo aparece cuando el trabajador tiene asignaciones activas en Centros de
   más de un Cliente empresarial a la vez — con uno solo, ReclamarFaltantesAsync
   envía directo. *@
<Modal Visible="_reclamarFaltantesVisible" VisibleChanged="v => _reclamarFaltantesVisible = v"
       Titulo="@Textos["ModalReclamarTitulo"]" CerrarAlHacerClicFuera="!_reclamandoFaltantes">
    <ChildContent>
        <p class="workspace-nota-contextual">
            @Textos["NotaReclamarVarios", NombreCompleto ?? string.Empty]
        </p>
        <fieldset class="reclamacion-destinatarios">
            <legend>@Textos["LeyendaClientesEmpresariales"]</legend>
            @foreach (var cliente in _clientesReclamables)
            {
                <label class="campo-checkbox" @key="cliente.ClienteId">
                    <input type="checkbox"
                           checked="@_clientesSeleccionadosReclamar.Contains(cliente.ClienteId)"
                           @onchange="e => AlternarClienteReclamar(cliente.ClienteId, (bool)e.Value!)" />
                    <span>@cliente.ClienteRazonSocial</span>
                    <span class="reclamacion-motivo">@(cliente.DocumentoIds.Count == 1 ? Textos["DocumentosPendientesUno"] : Textos["DocumentosPendientesVarios", cliente.DocumentoIds.Count])</span>
                </label>
            }
        </fieldset>
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_reclamandoFaltantes" OnClick="() => _reclamarFaltantesVisible = false">@Textos["BotonCancelar"]</Boton>
        <Boton Cargando="_reclamandoFaltantes" Deshabilitado="_clientesSeleccionadosReclamar.Count == 0" OnClick="ConfirmarReclamarFaltantesAsync">@Textos["BotonReclamar"]</Boton>
    </Pie>
</Modal>
