@page "/trabajadores"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Application.Trabajadores.Commands.CrearTrabajador
@using CaeManager.Application.Trabajadores.Commands.EditarTrabajador
@using CaeManager.Application.Trabajadores.Commands.EliminarTrabajador
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadorPorId
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadores
@using CaeManager.Application.Alertas
@using CaeManager.Application.Asignaciones.Commands.CrearAsignaciones
@using CaeManager.Application.Asignaciones.Queries.ObtenerDocumentosFaltantesParaAsignacion
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratasParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using CaeManager.Web.Features.Trabajadores.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject ContextWorkspaceService WorkspaceService

<LimiteDeErrores Pagina="this">
<PageTitle>@TituloPagina — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina lista-design">
    @* Lista 1:1 con «Lista Trabajadores TALVEG.dc.html» del export de Design (DDL-083, 2026-10-18), con el mismo molde que
       Empresas: cabecera de una línea (CabeceraListado) con el contador, el conmutador ☑ de selección múltiple, el icono ⤓
       de exportación de la vista filtrada, ⌨, el menú ⋯ y UNA acción primaria. El título lo sigue decidiendo el perfil
       de vocabulario del Tenant y si el usuario es del Tenant propietario («Mis trabajadores» solo en Cliente Directo propio).

       Sin antetítulo de grupo ni rótulo de la empresa gestionada: el selector de la barra lateral ya
       dice cuál es. El estado vacío sin empresa elegida (4a) sigue más abajo.

       D-15: con alcance cero la lista no puede existir, así que ni se exporta (daría un fichero
       vacío), ni se ofrece el alta, ni la selección. La selección solo alimenta la barra de lote
       (eliminar, asignar a centro), toda ella escritura: Consulta no ve el ☑. *@
    @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa && _parametrosInicializados)
    {
        <CabeceraListado Titulo="@TituloPagina" Contador="@(_cargando || _errorCarga ? null : _totalElementos)"
                         SeleccionMultiple="_seleccionMultiple"
                         SeleccionMultipleChanged="@(_puedeEscribir && !_alcanceCero ? EventCallback.Factory.Create<bool>(this, AlternarSeleccionMultiple) : default)"
                         RutaExportar="@(_alcanceCero ? null : "/trabajadores/exportar.xlsx")" CriteriosExportar="CriteriosExportar" Menu="@(!_alcanceCero ? MenuExportarTodo : null)">
            <Primaria>
                @if (!_alcanceCero)
                {
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">@Textos["BotonNuevoTrabajador"]</Boton></SoloConEscritura>
                }
            </Primaria>
        </CabeceraListado>
    }
    else
    {
        <CabeceraListado Titulo="@TituloPagina" />
    }

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           datos de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    @* Barra de filtros en modo pastillas: el buscador «Filtrar esta pantalla» (tecla f), las
       pastillas «Empresa» y «Centro», y «Filtros guardados» con la lista guardada y
       «Guardar filtro». Debajo, la franja de estados, los chips y «Limpiar todo». A la derecha, la agrupación
       «Por Empresa» y «Expandir todo».

       - El buscador busca en nombre, apellidos, DNI y alias (ObtenerTrabajadoresQuery).
       - «Documentación» viaja en la URL como «estado».
       - «Empresa» lleva dentro también las subcontratas: son dos parámetros distintos de la
         consulta (EmpresaId, SubcontrataId) y se excluyen, así que una sola pastilla dice la
         verdad. Las subcontratas llevan «(subcontrata)» detrás del nombre.
       - «Centro» viaja en la URL como «centro» y deja a quienes tienen una Asignación activa en
         ese Centro. Ofrece los Centros que el usuario ya puede ver (ObtenerCentrosParaSelectorQuery,
         el mismo alcance que la consulta comprueba: un Centro fuera de él no devuelve a nadie).
       - Sin pastilla «Actividad» (Chris, 2026-10-18): el voluntario inactivo sigue marcado en su fila, pero ya no se filtra.
       - La maqueta dibuja además el filtro por «Cliente»: la consulta no sabe filtrar
         por él, y una pastilla que no filtra nada mentiría. *@
    @* D-15: sin alcance (Asignación de Cartera) no hay lista que filtrar, guardar ni seleccionar. *@
    @if (!_alcanceCero)
    {
    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  OnGuardarFiltro="AbrirGuardarFiltro" FiltrosGuardados="OpcionesFiltrosGuardados"
                  OnAplicarFiltroGuardado="AplicarFiltroGuardadoAsync"
                  OnBorrarFiltroGuardado="PedirEliminarFiltroGuardado"
                  VistaRecordada="_vistaRecordada">
        <Pastillas>
            <PastillaFiltro Etiqueta="@Textos["EtiquetaEmpresa"]" TextoTodos="@Textos["OpcionTodas"]" Valor="@ValorFiltroEmpleador"
                            ValorChanged="CambiarFiltroEmpleadorAsync" Opciones="OpcionesFiltroEmpleador" />
            <PastillaFiltro Etiqueta="@Textos["EtiquetaCentro"]" TextoTodos="@Textos["OpcionTodosLosCentros"]" Valor="@_filtroCentroId"
                            ValorChanged="FiltrarPorCentroAsync" Opciones="OpcionesFiltroCentro" />
            @* Delegación y Oficio son del catálogo de UNA Empresa: solo hay pastilla con la Empresa elegida (o la única que
               emplea a Trabajadores visibles) y con algo que ofrecer. Un Trabajador de Subcontrata no casa con ninguna. *@
            @if (OfrecerPastillaDeDelegacionEmpresa)
            {
                <PastillaFiltro Etiqueta="@Textos["EtiquetaDelegacionEmpresa"]" TextoTodos="@Textos["OpcionTodasLasDelegacionesEmpresa"]" Valor="@_filtroDelegacionEmpresaId"
                                ValorChanged="FiltrarPorDelegacionEmpresaAsync" Opciones="OpcionesFiltroDelegacionEmpresa" />
            }
            @if (OfrecerPastillaDeOficio)
            {
                <PastillaFiltro Etiqueta="@Textos["EtiquetaOficio"]" TextoTodos="@Textos["OpcionTodosLosOficios"]" Valor="@_filtroOficioId"
                                ValorChanged="FiltrarPorOficioAsync" Opciones="OpcionesFiltroOficio" />
            }
        </Pastillas>
        <Estados>
            <FranjaEstado Opciones="EstadoDocumentoUi.FranjaDocumental" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                  Recuentos="_recuentosPorEstado" />
        </Estados>
        <Herramientas>
            <PastillaFiltro Etiqueta="@Textos["EtiquetaAgrupar"]" TextoTodos="@Textos["OpcionSinAgrupar"]" Valor="@ValorAgrupacion"
                            ValorChanged="CambiarAgrupacionAsync" Opciones="OpcionesAgrupacion" Keytip="A" />
            @if (HayFilasDesplegables)
            {
                <BarraHerramientasLista TodosExpandidos="TodosExpandidos" OnAlternarTodos="AlternarTodosExpandidos" />
            }
        </Herramientas>
        @* Lo que está filtrando se ve y se quita de uno en uno: el valor de cada pastilla vive
           dentro de un menú cerrado, y sin esto no hay forma de ver desde fuera por qué la lista
           está recortada. *@
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["AriaQuitarFiltroBusqueda"]" OnQuitar="QuitarFiltroBusquedaAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroEmpresaId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroEmpresa" EtiquetaAccesible="@Textos["AriaQuitarFiltroEmpresa"]" OnQuitar="QuitarFiltroEmpresaAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroSubcontrataId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroSubcontrata" EtiquetaAccesible="@Textos["AriaQuitarFiltroSubcontrata"]" OnQuitar="QuitarFiltroSubcontrataAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroCentroId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroCentro" EtiquetaAccesible="@Textos["AriaQuitarFiltroCentro"]" OnQuitar="QuitarFiltroCentroAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroDelegacionEmpresaId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroDelegacionEmpresa" EtiquetaAccesible="@Textos["AriaQuitarFiltroDelegacionEmpresa"]" OnQuitar="QuitarFiltroDelegacionEmpresaAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_filtroOficioId))
            {
                <ChipFiltro Etiqueta="@EtiquetaFiltroOficio" EtiquetaAccesible="@Textos["AriaQuitarFiltroOficio"]" OnQuitar="QuitarFiltroOficioAsync" />
            }
        </Chips>
    </BarraFiltros>
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Trabajadores"
                             ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    @* La franja de estados conserva la semántica de «Documentación»: admite varios estados a la vez, viaja en la
       URL como «estado» (estados de código separados por coma) y cada botón dice cuántas filas hay, con los
       demás filtros aplicados. «Por vencer» reúne Urgente y Próximo. *@

    }

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)"
                     Titulo="@Textos["ErrorCargaListaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && _elementosPagina.Count == 0)
    {
        <EstadoCargando Filas="6" />
    }
    else if (_elementosPagina.Count == 0 && HayFiltrosActivos)
    {
        @* Distinto de "aún no hay trabajadores": aquí hay filtros
           puestos —búsqueda, documentación, empresa o subcontrata— y
           ofrecer "crea el primero" a quien ha filtrado lo manda a dar de
           alta un trabajador que probablemente ya existe, con el DNI
           duplicado que eso arrastra.

           La copia no afirma que HAYA trabajadores dados de alta: el
           filtrado es de servidor y solo devuelve el total ya filtrado. *@
        <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_elementosPagina.Count == 0)
    {
        @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
        <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
            <EstadoVacio NombreIcono="trabajadores" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="AbrirCrearAsync">@Textos["BotonNuevoTrabajador"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        </VacioSegunAlcance>
    }
    else
    {
        @* Marco de la lista del mockup: una sola tarjeta con la cabecera de columnas arriba y las filas separadas por una
           línea. Sin roles de tabla ni QuickGrid, como Empresas: la fila se despliega y QuickGrid no soporta filas
           expandibles. Los rótulos «Trabajador», «Empresa» y «Documentación» ordenan (el orden vive en la URL). *@
        @TarjetaListado.Renderizar(@<text>
            <div class="marco-lista-trabajadores">
            <div class="@ClaseRejilla("cabecera-columnas-trabajadores")">
                @if (_seleccionMultiple)
                {
                    <span class="seleccion-trabajador"><input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" /></span>
                }
                <span></span>
                @(CabeceraOrdenable(nameof(TrabajadorListaDto.Apellidos), Textos["ListaColumnaTrabajador"]))
                @(CabeceraOrdenable(nameof(TrabajadorListaDto.EmpleadorNombre), Textos["ListaColumnaEmpleador"]))
                <span class="col-registrados-vigentes">@Textos["ListaColumnaRegistradosVigentes"]</span>
                @(CabeceraOrdenable(nameof(TrabajadorListaDto.EstadoDocumental), Textos["ListaColumnaEstadoDocumental"], "col-estado"))
                <span></span>
            </div>

            <div class="lista-filas-acordeon" aria-busy="@(_cargando ? "true" : "false")">
                @foreach (var (context, grupo, cantidadGrupo) in FilasConGrupo())
                {
                    @if (grupo is not null)
                    {
                        @* Título del grupo «Por Empresa», «Por Delegación» o «Por Oficio» (maqueta de Trabajadores): su nombre y cuántos Trabajadores suyos hay en esta página. *@
                        <div class="cabecera-grupo-trabajadores" data-grupo-empresa="@(_agrupar == "empresa" ? grupo : null)" data-grupo="@grupo" data-agrupar="@_agrupar">
                            @grupo<span class="cabecera-grupo-trabajadores-recuento">@(TotalPaginas > 1 ? Textos["RecuentoGrupoEnEstaPagina", cantidadGrupo].Value : $"· {cantidadGrupo}")</span>
                        </div>
                    }
                    <div class="@ClaseTarjeta(context)" @key="context.Id">
                        @{ var expandido = context.Incidencias.Count > 0 && EstaExpandido(context); }
                        @* Patrón de listados: la fila no lleva menú «⋯». Un clic en cualquier punto de la fila abre la
                           vista rápida (el panel del Context Workspace), igual que Enter sobre la fila enfocada; los
                           controles de dentro —casilla, desplegable, DNI copiable, icono 360— hacen lo suyo y no dejan
                           subir el clic. *@
                        <div class="@(ClaseRejilla("tarjeta-fila-acordeon-cabecera") + " fila-pulsable")"
                             @onclick="() => AbrirVistaRapidaAsync(context.Id)">
                            @if (_seleccionMultiple)
                            {
                                <span class="seleccion-trabajador"><input type="checkbox" aria-label="@(Textos["AriaSeleccionarTrabajador", NombreCompleto(context)])" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" @onclick:stopPropagation="true" /></span>
                            }
                            @if (context.Incidencias.Count > 0)
                            {
                                <button type="button" class="@("boton-expandir-fila" + (expandido ? " boton-expandir-fila-abierta" : ""))"
                                        aria-label="@Textos["DesplegarIncidenciasTrabajador", NombreCompleto(context)]" aria-expanded="@(expandido ? "true" : "false")"
                                        @onclick="() => AlternarExpansion(context.Id)" @onclick:stopPropagation="true">
                                    <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                                </button>
                            }
                            else
                            {
                                <span></span>
                            }
                            @* Celda «Trabajador»: «Nombre Apellidos» (abre la vista rápida) con, si es voluntario sin evento, su pastilla, y
                               debajo el DNI, sin prefijo, copiable con un clic, sin abrir la fila. *@
                            <span class="celda-identidad-trabajador">
                                <span class="celda-trabajador">
                                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida"
                                            aria-label="@Textos["AbrirVistaRapidaDe", NombreCompleto(context)]"
                                            @onclick="() => AbrirVistaRapidaAsync(context.Id)" @onclick:stopPropagation="true"><TextoResaltado Texto="@context.Nombre" Termino="@_busqueda" />@(" ")<TextoResaltado Texto="@context.Apellidos" Termino="@_busqueda" /></button>
                                    @if (context.VoluntarioInactivo)
                                    {
                                        <span class="voluntario-inactivo" title="@Textos["VoluntarioInactivoAyuda"]">@Textos["VoluntarioInactivo"]</span>
                                    }
                                    @* Oficio del catálogo de su Empresa, como etiqueta (decisión de Chris, 2026-10-18). Sin Oficio no hay etiqueta. *@
                                    @if (!string.IsNullOrWhiteSpace(context.OficioNombre))
                                    {
                                        <span class="etiqueta-oficio-trabajador" data-oficio title="@Textos["OficioEtiquetaAyuda"]">@context.OficioNombre</span>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(context.Dni))
                                {
                                    <span class="celda-trabajador-dni">
                                        <BotonCopiar EnLinea="true" Valor="@context.Dni" Texto="@context.Dni" TerminoResaltado="@_busqueda" Etiqueta="@Textos["EtiquetaCopiarDni"]"
                                                     NombreAccesible="@Textos["CopiarDni", context.Dni]" />
                                    </span>
                                }
                            </span>
                            <span class="celda-empresa-trabajador">@context.EmpleadorNombre</span>
                            <span class="col-registrados-vigentes">
                                <span class="celda-registrados-vigentes">
                                    <BarraCumplimiento Porcentaje="@PorcentajeRegistradosVigentes(context)"
                                                       Texto="@MotivoIncidenciasUi.RegistradosVigentes(context.DocumentosVigentes, context.DocumentosRegistrados)"
                                                       Etiqueta="@MotivoIncidenciasUi.RegistradosVigentesAccesible(context.DocumentosVigentes, context.DocumentosRegistrados)" />
                                </span>
                            </span>
                            @{
                                // Lo exigido y sin documento no está entre los documentos registrados: el estado de la fila
                                // nunca puede decir «Sin incidencias» mientras falte un Tipo que un Centro le exige.
                                var estadoFila = EstadoDocumentoUi.ConFaltantes(context.EstadoDocumental, context.DocumentosFaltantes.Count > 0);
                            }
                            <span class="col-estado celda-estado-trabajador"><EstadoFila Tono="EstadoDocumentoUi.TonoDocumental(estadoFila)" Texto="@EstadoDocumentoUi.TextoDocumental(estadoFila)" Correcto="EstadoDocumentoUi.EsCorrecto(estadoFila)" Motivo="@MotivoIncidenciasUi.Texto(context.Incidencias, context.DocumentosFaltantes, CaeManager.Domain.Common.DiaDeNegocio.Hoy())" /></span>
                            <div class="tarjeta-fila-acordeon-acciones acciones-trabajador">
                                <Boton360 Nombre="@NombreCompleto(context)" Href="@($"/trabajadores/{context.Id}")" />
                            </div>
                        </div>
                        @if (expandido)
                        {
                            @* La fila desplegada son los documentos que piden trabajo, cada uno con la única acción «Gestionar»
                               (maqueta de Trabajadores; regla 8 de LEEME-AUTORIDAD: un solo verbo para todo lo que necesita
                               el trabajo del Gestor CAE). Son las incidencias que ya trae la fila: no cuestan otra consulta y
                               se corrigen con el mismo formulario de siempre (CorreccionIncidenciaDocumental). Quien solo
                               consulta ve los documentos sin el botón: no se le ofrece un formulario que el comando le va a
                               denegar. *@
                            <div class="@("tarjeta-fila-acordeon-contenido" + (_seleccionMultiple ? " contenido-con-seleccion" : string.Empty))">
                                <ul class="documentos-pendientes-trabajador" data-pieza="documentos-pendientes">
                                    @foreach (var incidencia in context.Incidencias)
                                    {
                                        <li class="@(SubcajaIncidenciasDocumentales.Coincide(incidencia, _busqueda) ? "documento-pendiente-trabajador coincidencia-incidencia" : "documento-pendiente-trabajador")" @key="incidencia.DocumentoId">
                                            <span class="documento-pendiente-nombre"><TextoResaltado Texto="@MotivoIncidenciasUi.NombreDeTipo(incidencia)" Termino="@_busqueda" /></span>
                                            <Badge Tono="EstadoDocumentoUi.TonoDeSeveridad(incidencia.Estado)">@EstadoDocumentoUi.Texto(incidencia.Estado)</Badge>
                                            <span class="documento-pendiente-detalle"><TextoResaltado Texto="@DetalleDelDocumento(incidencia)" Termino="@_busqueda" /></span>
                                            @if (_puedeEscribir)
                                            {
                                                <button type="button" class="documento-pendiente-gestionar" data-accion="gestionar"
                                                        aria-label="@Textos["GestionarDocumentoAccesible", MotivoIncidenciasUi.NombreDeTipo(incidencia), NombreCompleto(context)]"
                                                        @onclick="() => CorregirIncidenciaAsync(context, incidencia)">@Textos["Gestionar"]</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>
            </div>
        </text>, PieDelListado)
    }
    @if (!_errorCarga && !_cargando && _elementosPagina.Count == 0)
    {
        @TarjetaListado.RenderizarMaqueta(null, PieDelListadoVacio)
    }
    }
</div>

@* Corrección de una incidencia desde la subcaja desplegada. Monta su formulario al primer uso. *@
<CorreccionIncidenciaDocumental @ref="_correccion" OnCorregida="RefrescarTrasCorreccionAsync" />

<DrawerFormulario Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerNuevoTitulo"]"
                 HayCambios="() => HayCambiosAlta" Guardando="_guardando" MensajeError="@_mensajeErrorFormulario"
                 HayErroresDeCampo="@HayErroresDelPasoVisible" OnGuardar="GuardarAsync"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]"
                 Pasos="PasosAlta" PasoActual="@_pasoAlta" PasosCompletados="_pasosAltaVistos" EtiquetaPasos="@Textos["EtiquetaPasosAlta"]"
                 OnPasoSeleccionado="AltaIrAPaso" OnSiguiente="AltaSiguienteAsync" OnAtras="AltaAtras">
    @if (_pasoAlta == PasoAltaBasico)
    {
    <div class="campo">
        <label>@Textos["EtiquetaEmpleador"]</label>
        <div class="lista-seleccion-multiple">
            <label class="campo-checkbox">
                <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "empresa")" @onchange="SeleccionarTipoEmpresa" />
                @Textos["EtiquetaEmpresa"]
            </label>
            <label class="campo-checkbox">
                <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "subcontrata")" @onchange="SeleccionarTipoSubcontrata" />
                @Textos["EtiquetaSubcontrata"]
            </label>
        </div>
    </div>

    @if (_tipoEmpleador == "empresa" && _resolverEmpresaEnSilencio)
    {
        @* DDL-076: perfil Cliente Directo con una única Empresa — sin
           selector, pedirle que confirme que él es él en un desplegable
           de un solo elemento no aporta nada. *@
        <CampoInfo Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresasDisponibles[0].RazonSocial" />
    }
    else if (_tipoEmpleador == "empresa")
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresaId" ValorChanged="AlElegirEmpresa">
            <option value="">@Textos["OpcionSeleccionaEmpresa"]</option>
            @foreach (var empresa in _empresasDisponibles)
            {
                <option value="@empresa.Id">@empresa.RazonSocial</option>
            }
        </CampoSelect>
    }
    else
    {
        <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_subcontrataId" ValorChanged="AlElegirSubcontrata">
            <option value="">@Textos["OpcionSeleccionaSubcontrata"]</option>
            @foreach (var subcontrata in _subcontratasDisponibles)
            {
                <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
            }
        </CampoSelect>
    }

    <CampoTexto Etiqueta="@Textos["EtiquetaDocumentoIdentidad"]" Valor="@_dni" ValorChanged="v => _dni = v" OnBlur="ValidarDniAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Dni))" />
    @if (PistaDni is not null)
    {
        <p class="pista-documento pista-documento-@ToneDni">@PistaDni</p>
    }

    <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Nombre))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaApellidos"]" Valor="@_apellidos" ValorChanged="v => _apellidos = v" OnBlur="ValidarApellidosAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Apellidos))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaAliasOpcional"]" Placeholder="@Textos["PlaceholderAlias"]" Valor="@_alias" ValorChanged="v => _alias = v" OnBlur="ValidarAliasAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Alias))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaFechaNacimiento"]" Type="date" Valor="@_fechaNacimiento" ValorChanged="v => _fechaNacimiento = v" />
    }
    else if (_pasoAlta == PasoAltaTrabajo)
    {
    @* Oficio y Delegación (decisión de Chris, 2026-10-18): el Oficio ocupa el sitio del Puesto y los dos salen del catálogo
       de la Empresa elegida. El Trabajador de una Subcontrata no los tiene y sigue con el Puesto en texto. *@
    if (EmpresaElegidaParaCatalogo is { } empresaDelCatalogo)
    {
        <SelectorDelegacionEmpresaYOficio EmpresaId="empresaDelCatalogo"
                                   OficioId="@_oficioId" OficioIdChanged="v => _oficioId = v"
                                   DelegacionEmpresaId="@_delegacionId" DelegacionEmpresaIdChanged="v => _delegacionId = v" />
    }
    else
    {
        <CampoTexto Etiqueta="@Textos["EtiquetaPuestoOpcional"]" Placeholder="@Textos["PlaceholderPuesto"]" Valor="@_puesto" ValorChanged="v => _puesto = v" OnBlur="ValidarPuestoAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Puesto))" />
    }
    <CampoSelect Etiqueta="@Textos["EtiquetaTipoContratacion"]" Valor="@_tipoContratacion" ValorChanged="v => _tipoContratacion = v">
        <option value="CuentaAjena">@Textos["TipoContratacionCuentaAjena"]</option>
        <option value="Autonomo">@Textos["TipoContratacionAutonomo"]</option>
        <option value="Voluntario">@Textos["TipoContratacionVoluntario"]</option>
    </CampoSelect>
    <CampoTextarea Etiqueta="@Textos["EtiquetaObservaciones"]" Valor="@_observaciones" ValorChanged="v => _observaciones = v" Filas="3" />
    }
    else
    {
    <CampoTexto Etiqueta="@Textos["EtiquetaEmail"]" Type="email" Valor="@_email" ValorChanged="v => _email = v" OnBlur="ValidarEmailAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Email))" />
    <CampoTexto Etiqueta="@Textos["EtiquetaTelefonoWhatsapp"]" Type="tel" Placeholder="+34 600 00 00 00" Valor="@_telefono" ValorChanged="v => _telefono = v" OnBlur="ValidarTelefonoAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Telefono))" />
    }
</DrawerFormulario>

@* Eliminar seleccionados (EliminarTrabajadoresCommand) y Asignar a centro (CrearAsignacionesCommand)
   son ICommand denegados a Consulta; «Cancelar» sin ellos no tiene nada que cancelar. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true">
        <AccionesExtra>
            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirAsignarCentroAsync">
                @Textos["BotonAsignarACentro"]
            </Boton>
        </AccionesExtra>
    </BarraAccionesLote>
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@(Textos["DialogoEliminarLoteTitulo", _seleccionados.Count])"
    Mensaje="@Textos["DialogoEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

@* Borrar un filtro guardado pregunta antes: no se puede deshacer. Mismo patrón que Clientes empresariales. *@
<DialogoConfirmacion
    Visible="_filtroGuardadoAEliminar is not null"
    VisibleChanged="CambiarVisibilidadBorradoFiltroGuardado"
    Titulo="@Textos["FiltroGuardadoBorrarTitulo", _filtroGuardadoAEliminar?.Nombre ?? string.Empty]"
    Mensaje="@Textos["FiltroGuardadoBorrarMensaje"]"
    TextoBotonConfirmar="@Textos["FiltroGuardadoBorrarBoton"]"
    EnProgreso="_eliminandoFiltroGuardado"
    OnConfirmar="ConfirmarEliminarFiltroGuardadoAsync" />

<Modal @ref="_modalAsignarCentro" HayCambios="() => HayCambiosSinGuardar" Visible="_asignarCentroVisible" VisibleChanged="v => { if (!v) CerrarAsignarCentro(); }" Titulo="@(Textos["ModalAsignarCentroTitulo", _seleccionados.Count])" CerrarAlHacerClicFuera="!_asignandoLote">
    <ChildContent>
        <CampoBuscarSelect
            Etiqueta="@Textos["EtiquetaCentro"]"
            Marcador="@Textos["PlaceholderCentro"]"
            Valor="@_centroIdParaAsignar"
            ValorChanged="CambiarCentroParaAsignarAsync"
            Opciones="@OpcionesCentrosParaAsignar" />

        <CampoTexto Etiqueta="@Textos["EtiquetaFechaAlta"]" Type="date" Valor="@_fechaAltaParaAsignar" ValorChanged="v => _fechaAltaParaAsignar = v" />

        @* La comprobación es una lectura aparte, hecha al elegir el centro:
           CrearAsignacionesCommand ni la repite ni se detiene por documentos.
           Por eso el aviso habla en pasado (lo que faltaba al comprobarlo) y
           no promete qué quedará al confirmar. *@
        @if (_documentosFaltantesParaAsignar.Count > 0)
        {
            <div class="alerta-preflight-asignacion" role="status">
                <p>
                    @Textos["PreflightFaltaban"] <strong>@Textos["PreflightDocumentosQueSePiden", _documentosFaltantesParaAsignar.Count]</strong>:
                </p>
                <ul>
                    @foreach (var faltante in _documentosFaltantesParaAsignar.Take(5))
                    {
                        <li>@faltante.TrabajadorNombre — @faltante.TipoDocumentoNombre</li>
                    }
                </ul>
                @if (_documentosFaltantesParaAsignar.Count > 5)
                {
                    <p>@Textos["PreflightYMas", _documentosFaltantesParaAsignar.Count - 5]</p>
                }
                <p>@Textos["PreflightNota"]</p>
            </div>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_asignandoLote" OnClick="() => _modalAsignarCentro?.SolicitarCierreAsync() ?? Task.CompletedTask">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_asignandoLote" OnClick="ConfirmarAsignarCentroAsync">
            @(_documentosFaltantesParaAsignar.Count > 0 ? Textos["BotonAsignarIgualmente"] : Textos["BotonAsignar"])
        </Boton>
    </Pie>
</Modal>

@* «Guardar filtro» es un formulario de un campo: ModalFormulario (guardián, «Cancelar», «Guardar» único con su motivo y estado, aviso
   del formulario y aviso de navegación vienen del kit; «Asignar a centro» sigue en su Modal y en el aviso de la página). *@
<ModalFormulario Visible="_mostrarGuardarFiltro" VisibleChanged="v => { if (!v) CerrarModalGuardarFiltro(); }" Titulo="@Textos["ModalGuardarFiltroTitulo"]"
                 Ancho="AnchoModal.Pequeno" HayCambios="() => HayCambiosFiltro" Guardando="_guardandoFiltro"
                 MensajeError="@_mensajeErrorFiltro" OnGuardar="GuardarFiltroActualAsync"
                 MotivoGuardarDeshabilitado="@(string.IsNullOrWhiteSpace(_nombreFiltroNuevo) ? Textos["GuardarFiltroSinNombre"].Value : null)"
                 TextoGuardar="@Textos["BotonGuardar"]" TextoCancelar="@Textos["BotonCancelar"]">
    <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombreFiltroNuevo" ValorChanged="v => { _nombreFiltroNuevo = v; _mensajeErrorFiltro = null; }" Placeholder="@Textos["PlaceholderNombreFiltro"]" />
</ModalFormulario>

<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CerrarFormulariosDescartando" />
</LimiteDeErrores>

@code {
    private RenderFragment PieDelListado => PieSegun(false);

    // Sin trabajadores el pie sigue visible debajo de la tarjeta, con la presentación de la maqueta anterior
    // (regla compartida de los listados, ListadosPieSiempreVisibleTests).
    private RenderFragment PieDelListadoVacio => PieSegun(true);

    // Un solo montaje de la leyenda de atajos (LeyendaAtajosListaAdopcionTests): lo único que cambia es la presentación del pie.
    private RenderFragment PieSegun(bool presentacionMaqueta) => @<text>
        @if (!_errorCarga && (!_cargando || _totalElementos > 0))
        {
            <PaginadorSimple PresentacionMaqueta="presentacionMaqueta" PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                  PaginaActualChanged="CambiarPaginaAsync"
                                  TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" ElementosEnPagina="_elementosPagina.Count">
                    <Centro><LeyendaAtajosLista /></Centro>
                </PaginadorSimple>
        }
    </text>;
}

@code {
    private RenderFragment MenuExportarTodo => @<CaeManager.Web.Exportacion.EntradasExportar Ruta="/trabajadores/exportar.xlsx" />;
}

@code {
    // Rótulo de columna que ordena. Sin roles de tabla (la lista no lo es), así que el sentido del orden lo dice la
    // flecha de la clase y el nombre accesible del botón. Agrupada «Por Empresa» manda el orden del grupo: ninguna columna lo marca.
    private RenderFragment CabeceraOrdenable(string propiedad, string titulo, string clase = "") => @<span class="@(clase + (!Agrupado && _orden.Propiedad == propiedad ? (_orden.Direccion == SortDirection.Descending ? " col-sort-desc" : " col-sort-asc") : ""))">
        <button type="button" class="col-title" title="@Textos["OrdenarPorColumna"]" @onclick="() => OrdenarAsync(propiedad)"><span class="col-title-text">@titulo</span></button>
    </span>;
}
