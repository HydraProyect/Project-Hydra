@page "/trabajadores"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Application.Trabajadores.Commands.CrearTrabajador
@using CaeManager.Application.Trabajadores.Commands.EditarTrabajador
@using CaeManager.Application.Trabajadores.Commands.EliminarTrabajador
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadorPorId
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadores
@using CaeManager.Application.Alertas
@using CaeManager.Application.Asignaciones.Commands.CrearAsignaciones
@using CaeManager.Application.Asignaciones.Queries.ObtenerDocumentosFaltantesParaAsignacion
@using CaeManager.Application.Centros.Queries.ObtenerCentrosParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Subcontratas.Queries.ObtenerSubcontratasParaSelector
@using CaeManager.Application.Common
@using FluentValidation
@using MediatR
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Trabajadores.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject ContextWorkspaceService WorkspaceService

<PageTitle>@TituloPagina — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Cabecera Gen 2 (Lista Trabajadores TALVEG.dc.html): h1 sin kicker ni
       entradilla, con Exportar y el alta a la derecha. El título sigue
       dependiendo del perfil de vocabulario del tenant («Mis trabajadores» en
       Cliente Directo), que es lo que el propio mockup pide con su selector de
       perfil. *@
    <CabeceraPagina Titulo="@TituloPagina">
        <Acciones>
            <a class="enlace-exportar" href="/trabajadores/exportar.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlaceExportarExcel"]</a>
            <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoTrabajador"]</Boton></SoloConEscritura>
        </Acciones>
    </CabeceraPagina>

    @* Barra de trabajo sobre una superficie, como en el mockup: buscar,
       documentación, empleador y «Selección múltiple» en una sola fila. La
       selección múltiple sube aquí desde BarraHerramientasLista, igual que en
       Centros: mismo método, otra colocación.

       El mockup dibuja además «Todos los centros». No se pinta:
       ObtenerTrabajadoresQuery no acepta un filtro por Centro, y un
       desplegable que no filtra nada mentiría. Tampoco se funden Empresa y
       Subcontrata en un solo desplegable: son dos parámetros distintos de la
       consulta. Los filtros guardados no salen en el mockup y se conservan. *@
    <div class="barra-trabajo-centros barra-trabajo-trabajadores">
        <CampoTexto Placeholder="@Textos["PlaceholderBusqueda"]" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <FiltroEstado Etiqueta="@Textos["EtiquetaDocumentacion"]" TextoTodos="@Textos["OpcionTodas"]" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoAsync"
                      Opciones="EstadoDocumentoUi.OpcionesDocumentales" />
        <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_filtroEmpresaId" ValorChanged="FiltrarPorEmpresaAsync">
            <option value="">@Textos["OpcionTodasEmpresas"]</option>
            @foreach (var empresa in _empresasDisponibles)
            {
                <option value="@empresa.Id">@empresa.RazonSocial</option>
            }
        </CampoSelect>
        <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_filtroSubcontrataId" ValorChanged="FiltrarPorSubcontrataAsync">
            <option value="">@Textos["OpcionTodasSubcontratas"]</option>
            @foreach (var subcontrata in _subcontratasDisponibles)
            {
                <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
            }
        </CampoSelect>
        @if (_filtrosGuardados.Count > 0)
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaFiltrosGuardados"]" Valor="" ValorChanged="AplicarFiltroGuardadoAsync">
                <option value="">@Textos["OpcionAplicarFiltro"]</option>
                @foreach (var filtro in _filtrosGuardados)
                {
                    <option value="@filtro.Id">@filtro.Nombre</option>
                }
            </CampoSelect>
        }
        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
               OnClick="() => AlternarSeleccionMultiple(!_seleccionMultiple)"
               aria-pressed="@(_seleccionMultiple ? "true" : "false")">
            @Textos["BotonSeleccionMultiple"]
        </Boton>
        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _mostrarGuardarFiltro = true">
            @Textos["BotonGuardarFiltro"]
        </Boton>
    </div>

    @* Mismo bloque que Clientes y Empresas. Aquí importa más que en ninguna
       otra lista: son CUATRO filtros y tres de ellos viven dentro de
       desplegables cerrados, así que sin esto no hay forma de ver desde fuera
       por qué la lista está recortada. *@
    @if (HayFiltrosActivos)
    {
        <div class="chips-filtros">
            <span class="chips-filtros-indicador" aria-hidden="true"><Icono Nombre="filtro" Tamano="TamanoIcono.Pequeno" /></span>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <span class="chip-filtro">
                    @Textos["ChipBusqueda", _busqueda]
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroBusquedaAsync" aria-label="@Textos["AriaQuitarFiltroBusqueda"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(_estadoFiltro))
            {
                <span class="chip-filtro">
                    @EtiquetaFiltroEstado
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroEstadoAsync" aria-label="@Textos["AriaQuitarFiltroDocumentacion"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(_filtroEmpresaId))
            {
                <span class="chip-filtro">
                    @EtiquetaFiltroEmpresa
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroEmpresaAsync" aria-label="@Textos["AriaQuitarFiltroEmpresa"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(_filtroSubcontrataId))
            {
                <span class="chip-filtro">
                    @EtiquetaFiltroSubcontrata
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroSubcontrataAsync" aria-label="@Textos["AriaQuitarFiltroSubcontrata"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
        </div>
    }

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)"
                     Titulo="@Textos["ErrorCargaListaTitulo"]" Descripcion="@Textos["ErrorCargaDetalle"]">
            <Accion>
                <Boton OnClick="RecargarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (_cargando && _totalElementos == 0)
        {
            <EstadoCargando Filas="8" />
        }

        @* La rejilla se monta siempre (es la que pide los datos a
           ProveerElementosAsync): se esconde mientras no haya filas que
           enseñar, y en su lugar se ve el esqueleto o el estado vacío que
           toque. *@
        <div style="display:@(_totalElementos == 0 ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="TrabajadorListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                @if (_seleccionMultiple)
                {
                    @* La casilla de cabecera solo marca los de la página
                       visible, y su nombre accesible lo dice. *@
                    <TemplateColumn Title="" Align="Align.Center">
                        <HeaderTemplate Context="columna">
                            <input type="checkbox" aria-label="@Textos["AriaSeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                        </HeaderTemplate>
                        <ChildContent>
                            <input type="checkbox" aria-label="@(Textos["AriaSeleccionarTrabajador", NombreCompleto(context)])" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="@Textos["EtiquetaApellidos"]" Sortable="true" SortBy="@(GridSort<TrabajadorListaDto>.ByAscending(t => t.Apellidos))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => AbrirPreview(context.Id)'>
                        @context.Apellidos
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["EtiquetaNombre"]" Sortable="true" SortBy="@(GridSort<TrabajadorListaDto>.ByAscending(t => t.Nombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick='() => AbrirPreview(context.Id)'>
                        @context.Nombre
                    </button>
                </TemplateColumn>
                <PropertyColumn Property="@(t => t.Dni)" Title="DNI" Sortable="true" />
                <PropertyColumn Property="@(t => t.EmpleadorNombre)" Title="@Textos["ColumnaEmpleador"]" Sortable="true" />
                <TemplateColumn Title="@Textos["EtiquetaDocumentacion"]" Sortable="true" SortBy="@(GridSort<TrabajadorListaDto>.ByAscending(t => t.EstadoDocumental))">
                    <Badge Tono="EstadoDocumentoUi.TonoDocumental(context.EstadoDocumental)">
                        @EstadoDocumentoUi.TextoDocumental(context.EstadoDocumental)
                    </Badge>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaAcciones"]" Align="Align.End">
                    <MenuAcciones>
                        <ItemMenuAccion OnClick='() => AbrirPreview(context.Id)'>
                            @Textos["AccionDetalles"]
                        </ItemMenuAccion>
                        @* Hasta ahora Trabajador 360 solo se alcanzaba abriendo antes la
                           vista previa. Es la opción que el propio mockup marca como
                           recomendada de las tres que plantea, y no cuesta dato ni
                           componente nuevos: la ruta /trabajadores/{id} ya existe. *@
                        <ItemMenuAccion OnClick='() => AbrirTrabajador360(context.Id)'>
                            @Textos["AccionAbrirTrabajador360"]
                        </ItemMenuAccion>
                        <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, NombreCompleto(context))">
                            @Textos["AccionEliminar"]
                        </ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "aún no hay trabajadores": aquí hay cuatro filtros
               puestos —búsqueda, documentación, empresa y subcontrata— y
               ofrecer "crea el primero" a quien ha filtrado lo manda a dar de
               alta un trabajador que probablemente ya existe, con el DNI
               duplicado que eso arrastra.

               La copia no afirma que HAYA trabajadores dados de alta: el
               filtrado es de servidor y solo devuelve el total ya filtrado. *@
            <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio NombreIcono="trabajadores" Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoTrabajador"]</Boton></SoloConEscritura>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@Textos["DrawerNuevoTitulo"]" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <div class="campo">
            <label>@Textos["EtiquetaEmpleador"]</label>
            <div class="lista-seleccion-multiple">
                <label class="campo-checkbox">
                    <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "empresa")" @onchange="SeleccionarTipoEmpresa" />
                    @Textos["EtiquetaEmpresa"]
                </label>
                <label class="campo-checkbox">
                    <input type="radio" name="tipo-empleador" checked="@(_tipoEmpleador == "subcontrata")" @onchange="SeleccionarTipoSubcontrata" />
                    @Textos["EtiquetaSubcontrata"]
                </label>
            </div>
        </div>

        @if (_tipoEmpleador == "empresa" && _resolverEmpresaEnSilencio)
        {
            @* DDL-076: perfil Cliente Directo con una única Empresa — sin
               selector, pedirle que confirme que él es él en un desplegable
               de un solo elemento no aporta nada. *@
            <CampoInfo Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresasDisponibles[0].RazonSocial" />
        }
        else if (_tipoEmpleador == "empresa")
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaEmpresa"]" Valor="@_empresaId" ValorChanged="v => _empresaId = v">
                <option value="">@Textos["OpcionSeleccionaEmpresa"]</option>
                @foreach (var empresa in _empresasDisponibles)
                {
                    <option value="@empresa.Id">@empresa.RazonSocial</option>
                }
            </CampoSelect>
        }
        else
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaSubcontrata"]" Valor="@_subcontrataId" ValorChanged="v => _subcontrataId = v">
                <option value="">@Textos["OpcionSeleccionaSubcontrata"]</option>
                @foreach (var subcontrata in _subcontratasDisponibles)
                {
                    <option value="@subcontrata.Id">@subcontrata.RazonSocial</option>
                }
            </CampoSelect>
        }

        <CampoTexto Etiqueta="@Textos["EtiquetaDocumentoIdentidad"]" Valor="@_dni" ValorChanged="v => _dni = v" OnBlur="ValidarDniAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Dni))" />
        @if (PistaDni is not null)
        {
            <p class="pista-documento pista-documento-@ToneDni">@PistaDni</p>
        }

        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" OnBlur="ValidarNombreAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Nombre))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaApellidos"]" Valor="@_apellidos" ValorChanged="v => _apellidos = v" OnBlur="ValidarApellidosAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Apellidos))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaAliasOpcional"]" Placeholder="@Textos["PlaceholderAlias"]" Valor="@_alias" ValorChanged="v => _alias = v" OnBlur="ValidarAliasAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Alias))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaPuestoOpcional"]" Placeholder="@Textos["PlaceholderPuesto"]" Valor="@_puesto" ValorChanged="v => _puesto = v" OnBlur="ValidarPuestoAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Puesto))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaFechaNacimiento"]" Type="date" Valor="@_fechaNacimiento" ValorChanged="v => _fechaNacimiento = v" />
        <CampoTexto Etiqueta="@Textos["EtiquetaEmail"]" Type="email" Valor="@_email" ValorChanged="v => _email = v" OnBlur="ValidarEmailAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Email))" />
        <CampoTexto Etiqueta="@Textos["EtiquetaTelefonoWhatsapp"]" Type="tel" Placeholder="+34 600 00 00 00" Valor="@_telefono" ValorChanged="v => _telefono = v" OnBlur="ValidarTelefonoAsync" MensajeError="@ObtenerError(nameof(CrearTrabajadorCommand.Telefono))" />
        <CampoTextarea Etiqueta="@Textos["EtiquetaObservaciones"]" Valor="@_observaciones" ValorChanged="v => _observaciones = v" Filas="3" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            @Textos["BotonGuardar"]
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@(Textos["DialogoEliminarTitulo", _nombreAEliminar])"
    Mensaje="@Textos["DialogoEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true">
    <AccionesExtra>
        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="AbrirAsignarCentroAsync">
            @Textos["BotonAsignarACentro"]
        </Boton>
    </AccionesExtra>
</BarraAccionesLote>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@(Textos["DialogoEliminarLoteTitulo", _seleccionados.Count])"
    Mensaje="@Textos["DialogoEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<TrabajadorPreviewDrawer TrabajadorId="_previewTrabajadorId" Visible="_previewVisible" VisibleChanged="v => _previewVisible = v" />

<Modal Visible="_asignarCentroVisible" VisibleChanged="v => { if (!v) CerrarAsignarCentro(); }" Titulo="@(Textos["ModalAsignarCentroTitulo", _seleccionados.Count])" CerrarAlHacerClicFuera="!_asignandoLote">
    <ChildContent>
        <CampoBuscarSelect
            Etiqueta="@Textos["EtiquetaCentro"]"
            Marcador="@Textos["PlaceholderCentro"]"
            Valor="@_centroIdParaAsignar"
            ValorChanged="CambiarCentroParaAsignarAsync"
            Opciones="@OpcionesCentrosParaAsignar" />

        <CampoTexto Etiqueta="@Textos["EtiquetaFechaAlta"]" Type="date" Valor="@_fechaAltaParaAsignar" ValorChanged="v => _fechaAltaParaAsignar = v" />

        @* La comprobación es una lectura aparte, hecha al elegir el centro:
           CrearAsignacionesCommand ni la repite ni se detiene por documentos.
           Por eso el aviso habla en pasado (lo que faltaba al comprobarlo) y
           no promete qué quedará al confirmar. *@
        @if (_documentosFaltantesParaAsignar.Count > 0)
        {
            <div class="alerta-preflight-asignacion" role="status">
                <p>
                    @Textos["PreflightFaltaban"] <strong>@Textos["PreflightDocumentosQueSePiden", _documentosFaltantesParaAsignar.Count]</strong>:
                </p>
                <ul>
                    @foreach (var faltante in _documentosFaltantesParaAsignar.Take(5))
                    {
                        <li>@faltante.TrabajadorNombre — @faltante.TipoDocumentoNombre</li>
                    }
                </ul>
                @if (_documentosFaltantesParaAsignar.Count > 5)
                {
                    <p>@Textos["PreflightYMas", _documentosFaltantesParaAsignar.Count - 5]</p>
                }
                <p>@Textos["PreflightNota"]</p>
            </div>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_asignandoLote" OnClick="CerrarAsignarCentro">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Cargando="_asignandoLote" OnClick="ConfirmarAsignarCentroAsync">
            @(_documentosFaltantesParaAsignar.Count > 0 ? Textos["BotonAsignarIgualmente"] : Textos["BotonAsignar"])
        </Boton>
    </Pie>
</Modal>

<Modal Visible="_mostrarGuardarFiltro" VisibleChanged="v => _mostrarGuardarFiltro = v" Titulo="@Textos["ModalGuardarFiltroTitulo"]" CerrarAlHacerClicFuera="!_guardandoFiltro">
    <ChildContent>
        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombreFiltroNuevo" ValorChanged="v => _nombreFiltroNuevo = v" Placeholder="@Textos["PlaceholderNombreFiltro"]" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoFiltro" OnClick="() => _mostrarGuardarFiltro = false">@Textos["BotonCancelar"]</Boton>
        <Boton Cargando="_guardandoFiltro" OnClick="GuardarFiltroActualAsync">@Textos["BotonGuardar"]</Boton>
    </Pie>
</Modal>
