@* Panel del Actor de Plataforma TALVEG: da de alta Operadores CAE externos (organización) y sus Tenants
   propietarios. Se monta dentro de /delegaciones solo cuando el usuario tiene AdminPlataforma global; la
   autoridad real vive en los comandos, esto es presentación. *@
<section class="operadores-cae" aria-label="Operadores CAE externos">
    <div class="operadores-cae-cabecera">
        <div>
            <h2 class="operadores-cae-titulo">Operadores CAE externos</h2>
            <p class="operadores-cae-nota">
                Da de alta la organización que presta servicio CAE y los Tenants propietarios que va a operar.
                Nadie queda como Gestor CAE hasta que el Operador asigne su cartera.
                @TextosAutorizar["NotaEnlacePlataforma"]
            </p>
        </div>
        <Boton Variante="VarianteBoton.Primario" OnClick="AbrirNuevoOperador">Nuevo Operador CAE externo</Boton>
    </div>

    @if (_error)
    {
        <p class="operadores-cae-error" role="alert">No pudimos cargar los Operadores CAE externos.</p>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_operadores.Count == 0)
    {
        <p class="operadores-cae-nota">Todavía no hay ningún Operador CAE externo.</p>
    }
    else
    {
        <div class="operadores-cae-lista">
            @foreach (var operador in _operadores)
            {
                <Tarjeta Class="operadores-cae-tarjeta">
                    <div class="operadores-cae-fila">
                        <div>
                            <h3 class="operadores-cae-nombre">@operador.Nombre</h3>
                            <p class="operadores-cae-nota">
                                @(operador.TenantsPropietarios.Count == 0
                                    ? "Sin Tenants propietarios asignados."
                                    : string.Join(" · ", operador.TenantsPropietarios.Select(t => t.Nombre)))
                            </p>
                        </div>
                        <div class="operadores-cae-acciones">
                            <BotonCopiar Valor="@EnlaceDeAutorizacion(operador)"
                                         Texto="@TextosAutorizar["CopiarEnlace"]"
                                         Etiqueta="@TextosAutorizar["EtiquetaEnlace"]" />
                            <Boton Variante="VarianteBoton.Secundario" OnClick="() => AbrirNuevoTenant(operador)">
                                Crear Tenant propietario
                            </Boton>
                        </div>
                    </div>
                </Tarjeta>
            }
        </div>
    }
</section>

<Modal @ref="_modalContenedor" HayCambios="() => HayCambiosSinGuardar" Visible="_modal is not ModalActivo.Ninguno"
       VisibleChanged="v => CerrarModal(v)"
       Titulo="@TituloModal"
       CerrarAlHacerClicFuera="!_enCurso">
    <ChildContent>
        @if (_modal is ModalActivo.Operador)
        {
            <p>@TextosAutorizar["AltaIntro"]</p>
        }
        else if (_operadorDestino is not null)
        {
            <p>Se creará un Tenant propietario nuevo, vacío, que operará «@_operadorDestino.Nombre».</p>
        }
        <CampoTexto Etiqueta="@EtiquetaNombre"
                    Valor="@_nombre"
                    ValorChanged="v => _nombre = v"
                    Placeholder="@PlaceholderNombre" />
        @if (_modal is ModalActivo.Operador)
        {
            <CampoTexto Etiqueta="@TextosAutorizar["AltaEtiquetaCorreoAdministrador"]"
                        Type="email"
                        Valor="@_emailAdministrador"
                        ValorChanged="v => _emailAdministrador = v" />
            <CampoTexto Etiqueta="@TextosAutorizar["AltaEtiquetaNombreAdministrador"]"
                        Valor="@_nombreAdministrador"
                        ValorChanged="v => _nombreAdministrador = v" />
        }
        @if (_errorFormulario is not null)
        {
            <p class="operadores-cae-error" role="alert">@_errorFormulario</p>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_enCurso" OnClick="() => _modalContenedor?.SolicitarCierreAsync() ?? Task.CompletedTask">Cancelar</Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_enCurso" OnClick="ConfirmarAsync">Crear</Boton>
    </Pie>
</Modal>

@* El enlace de activación del primer Administrador. Este flujo no envía correo (el enlace manual es la
   contingencia decidida para el alta de un Tenant): quien da el alta lo copia y se lo hace llegar. Sin clic
   fuera: cerrarlo por descuido deja el enlace sin copiar, y esta pantalla no lo vuelve a enseñar. *@
<Modal Visible="@(_activacion is not null)"
       VisibleChanged="@(v => { if (!v) _activacion = null; })"
       Titulo="@TextosAutorizar["AltaCreadoTitulo"]"
       CerrarAlHacerClicFuera="false">
    <ChildContent>
        @if (_activacion is not null)
        {
            <p>@TextosAutorizar["AltaCreadoResumen", _activacion.NombreOperador, _activacion.NombreAdministrador, _activacion.EmailAdministrador]</p>
            <p>@TextosAutorizar["AltaEnlaceInstrucciones", MinutosCaducidadActivacion]</p>
            <p class="operadores-cae-enlace">@_activacion.Enlace</p>
            <p class="operadores-cae-nota">@TextosAutorizar["AltaCuentaSinContrasena"]</p>
        }
    </ChildContent>
    <Pie>
        <BotonCopiar Valor="@(_activacion?.Enlace ?? string.Empty)"
                     Texto="@TextosAutorizar["AltaCopiarEnlace"]"
                     Etiqueta="@TextosAutorizar["AltaEtiquetaEnlace"]" />
        <Boton Variante="VarianteBoton.Primario" OnClick="() => _activacion = null">@TextosAutorizar["AltaHecho"]</Boton>
    </Pie>
</Modal>

<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CerrarModalDescartando" />
