@page "/delegaciones"
@rendermode InteractiveServer
@attribute [Authorize]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase

<LimiteDeErrores Pagina="this">
@if (!IntegradaEnConfiguracion)
{
    <PageTitle>@TextosLista["Titulo"] — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina delegaciones-pantalla lista-design">
    @if (IntegradaEnConfiguracion)
    {
        <CabeceraPagina Titulo="@TextosLista["Titulo"]" Integrada="true">
            <Acciones>@AccionesCabeceraLista</Acciones>
        </CabeceraPagina>
    }
    else
    {
        <CabeceraListado Titulo="@TextosLista["Titulo"]" Contador="@(_cargando || _error ? null : (int?)_delegaciones.Count)">
            <Primaria>@AccionesCabeceraLista</Primaria>
        </CabeceraListado>
    }
    @if (PuedeAutorizarOperador)
    {
        <div class="delegaciones-autorizas-tu" role="note">
            <strong>@TextosAutorizar["NotaTitulo"]</strong>
            <span>@TextosAutorizar["NotaCuerpo"]</span>
        </div>
        <CaeManager.Web.Features.EncargoDeAdministracion.EncargoAdministracionPanel />
    }

    <CaeManager.Web.Features.EncargoDeAdministracion.AvisoAdministraPorEncargo />

    @if (PuedeGestionar)
    {
        <OperadoresCaeExternosPanel />
    }

    @if (OperandoWorkspaceAjeno)
    {
        <div class="delegaciones-aviso-ajeno" role="note">
            Estás consultando una organización ajena. Las delegaciones se gestionan desde la organización de origen.
            @TextosAutorizar["AvisoAjenaSoloLasQueLaAfectan"]
        </div>
    }

    <BarraFiltros Busqueda="@(BusquedaLista ?? string.Empty)" BusquedaChanged="BuscarListaAsync"
                  PlaceholderBuscador="@TextosLista["Buscar"]" HayFiltrosActivos="HayFiltrosActivos"
                  OnLimpiarTodo="LimpiarFiltrosListaAsync"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar"
                  VistaRecordada="_vistaRecordada">
        <Pastillas>
            <PastillaFiltro Etiqueta="@TextosLista["Tipo"]" Valor="@TipoLista" Opciones="TiposLista" ValorChanged="CambiarTipoListaAsync" />
        </Pastillas>
        <Estados>
            <FranjaEstado Opciones="EstadosLista" Valor="@EstadoLista" ValorChanged="CambiarEstadoListaAsync"
                          Recuentos="RecuentosLista" TextoTodos="@TextosLista["Todas"]" />
        </Estados>
        <Herramientas>
            <PastillaFiltro Etiqueta="@TextosLista["Agrupar"]" TextoTodos="@TextosLista["SinAgrupar"]" Valor="@AgrupacionLista"
                            Keytip="A" Opciones="AgrupacionesLista" ValorChanged="CambiarAgrupacionListaAsync" />
        </Herramientas>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@CaeManager.Application.Configuracion.Commands.GuardarFiltro.PantallasConFiltrosGuardados.AsignacionesDeOperacion"
                              ParametrosDeVista="ParametrosDeVista" OnAplicar="AplicarVistaListaAsync" AlCambiar="StateHasChanged" />
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.AsignacionesDeOperacion"
                            ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaListaAsync" AlCambiar="StateHasChanged" />
    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar las delegaciones"
                     Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @TarjetaListado.RenderizarMaqueta(@<text>
        @if (_cargando)
        {
            <EstadoCargando Filas="3" />
        }
        else if (FilasFiltradas.Count == 0)
        {
            @if (HayFiltrosActivos)
            {
                <EstadoVacio Titulo="@TextosLista["SinResultados"]" Descripcion="@TextosLista["SinResultadosDescripcion"]" />
            }
            else
            {
                <EstadoVacio Titulo="@TextosLista["SinAsignaciones"]"
                             Descripcion="@(OperandoWorkspaceAjeno ? TextosAutorizar["VacioOtraOrganizacion"] : TextosLista["SinAsignacionesDescripcion"])" />
            }
        }
        else
        {
        <table class="tabla-datos delegaciones-lista" aria-label="@TextosLista["Titulo"]">
            <thead><tr>
                <th scope="col">@TextosLista["Organizacion"]</th><th scope="col">@TextosLista["Tipo"]</th><th scope="col">@TextosLista["Permiso"]</th><th scope="col">@TextosLista["Estado"]</th>
            </tr></thead>
            <tbody>
            @{ var claves = new ClavesDeHermanos(); }
            @foreach (var bloque in BloquesLista)
            {
                var delegacion = bloque.Fila;
                @if (bloque.Cabecera is { } grupo)
                {
                    <tr><td colspan="4">
                        <CabeceraGrupoLista Nombre="@grupo.Nombre" Total="grupo.Total" Abierto="bloque.Abierto" OnAlternar="() => AlternarGrupoLista(grupo.Clave)" />
                    </td></tr>
                }
                @if (bloque.Oculta) { continue; }
                <tr @key="delegacion.Id" class="delegaciones-fila">
                    <td><button type="button" class="delegaciones-abrir" aria-expanded="@(_detallesLista.Contains(delegacion.Id) ? "true" : "false")" @onclick="() => AlternarDetalleLista(delegacion.Id)">
                        <Icono Nombre="@(_detallesLista.Contains(delegacion.Id) ? "chevron" : "siguiente")" Tamano="TamanoIcono.Pequeno" />
                        <TextoResaltado Texto="@NombreLista(delegacion)" Termino="@BusquedaLista" />
                    </button><div class="delegaciones-fecha">@TextosLista["Alta"] @delegacion.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")</div></td>
                    <td>@TextosLista[TipoDeLista(delegacion)]</td>
                    <td>@(delegacion.EsSoporte ? PermisoSoporteLista(delegacion) : TextoPersonasLista(delegacion.Operadores.Count))</td>
                    <td><span class="estado-fila"><Badge Tono="@TonoEstadoLista(delegacion)">@TextoEstadoLista(delegacion)</Badge></span></td>
                </tr>
                @if (_detallesLista.Contains(delegacion.Id))
                {
                <tr class="delegaciones-detalle" @key="claves.De((delegacion.Id, true))"><td colspan="4">
                <div class="delegaciones-tarjeta">
                    <div class="delegaciones-tarjeta-cabecera">
                        <div>
                            <div class="delegaciones-etiquetas">
                                <Badge Tono="@(delegacion.EsSoporte ? TonoBadge.Info : TonoBadge.Neutro)">
                                    @TextosLista[TipoDeLista(delegacion)]
                                </Badge>
                                <Badge Tono="@TonoEstadoLista(delegacion)">
                                    @TextoEstadoLista(delegacion)
                                </Badge>
                            </div>
                            <h2 class="delegaciones-titulo">
                                @TituloDe(delegacion.SomosLaConsultora, delegacion.ClienteNombre, delegacion.ConsultoraNombre)
                            </h2>
                            <p class="delegaciones-fecha">
                                @TextosLista["Alta"] @delegacion.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")
                            </p>
                        </div>
                        @if (delegacion.EsSoporte && delegacion.AccesoVigente)
                        {
                            <div class="delegaciones-ventana">
                                <span>Ventana abierta</span>
                                @if (delegacion.ExpiraEnUtc is { } expira)
                                {
                                    <strong>Hasta @expira.EnHoraPeninsular().ToString("dd/MM/yyyy HH:mm")</strong>
                                }
                            </div>
                        }
                    </div>

                    @if (delegacion.EsSoporte && delegacion.AccesoVigente)
                    {
                        <p class="delegaciones-motivo"><strong>Motivo registrado:</strong> @delegacion.MotivoActivacion</p>
                    }
                    else if (delegacion.EsSoporte)
                    {
                        <p class="delegaciones-nota">@(delegacion.VentanaCaducada ? "La última ventana de soporte terminó." : "No hay una ventana de soporte abierta.")</p>
                    }
                    else if (!delegacion.Activa)
                    {
                        <p class="delegaciones-nota">El acceso está retirado. Los datos se conservan y solo un Administrador de la organización propietaria de los datos puede reactivarlo.</p>
                    }

                    @if (delegacion.Operadores.Count == 0)
                    {
                        @* FS-20: a una delegación de Operador CAE externo las personas no las añade
                           esta pantalla, las pone el propio Operador CAE externo con una Asignación de
                           Cartera desde /usuarios. El vacío dice quién decide y, a quien puede, le da
                           el enlace. *@
                        @if (delegacion.EsSoporte || !delegacion.Activa)
                        {
                            <p class="delegaciones-sin-personas">Sin personas autorizadas todavía.</p>
                        }
                        else if (delegacion.SomosLaConsultora)
                        {
                            <p class="delegaciones-sin-personas" data-testid="sin-personas-operador">
                                @TextosAutorizar["SinPersonasOperador", delegacion.ClienteNombre]
                                @if (OperandoWorkspaceAjeno)
                                {
                                    @TextosAutorizar["SinPersonasOperadorQuien"]
                                }
                                else
                                {
                                    <AuthorizeView Roles="@RolesQueAsignanCartera" Context="autorizacionCartera">
                                        <Authorized>
                                            <a href="/usuarios">@TextosAutorizar["SinPersonasOperadorEnlace"]</a>
                                        </Authorized>
                                        <NotAuthorized>
                                            @TextosAutorizar["SinPersonasOperadorQuien"]
                                        </NotAuthorized>
                                    </AuthorizeView>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="delegaciones-sin-personas" data-testid="sin-personas-propietario">
                                @TextosAutorizar["SinPersonasPropietario", delegacion.ConsultoraNombre]
                            </p>
                        }
                    }
                    else
                    {
                        <div class="delegaciones-tabla-marco"
                             role="region"
                             aria-label="Personas autorizadas">
                            <TarjetaListado>
                    <Contenido>
<table class="tabla-datos delegaciones-tabla">
                                <thead>
                                    <tr>
                                        <th>Persona</th>
                                        <th>Rol CAE</th>
                                        @if (!OperandoWorkspaceAjeno)
                                        {
                                            <th>Acción</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var operador in delegacion.Operadores.Take(_personasCompletas.Contains(delegacion.Id) ? int.MaxValue : 3))
                                    {
                                        <tr>
                                            <td class="@(EsUsuarioNoResuelto(operador.UsuarioId) ? "delegaciones-persona-no-resuelta" : null)">
                                                @NombreDeUsuario(operador.UsuarioId)
                                            </td>
                                            <td>@RolCaeMostrado(operador)</td>
                                            @if (!OperandoWorkspaceAjeno)
                                            {
                                                <td>
                                                    <Boton Tamano="TamanoBoton.Pequeno"
                                                           Variante="VarianteBoton.Fantasma"
                                                           OnClick="() => PedirRetirarOperador(delegacion.Id, operador)"
                                                           Cargando="@EstaProcesando(operador.AsignacionId)">
                                                        Retirar
                                                    </Boton>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                    </Contenido>
                </TarjetaListado>
                        </div>
                    }

                    @if (delegacion.Operadores.Count > 3 && !_personasCompletas.Contains(delegacion.Id))
                    {
                        <Boton Variante="VarianteBoton.Fantasma" OnClick="() => _personasCompletas.Add(delegacion.Id)">@TextosLista["VerRestantes", delegacion.Operadores.Count - 3]</Boton>
                    }
                    <div class="delegaciones-pie">
                        @if (delegacion.EsSoporte)
                        {
                            <Boton Tamano="TamanoBoton.Pequeno"
                                   Variante="VarianteBoton.Fantasma"
                                   OnClick="() => VerActividadAsync(delegacion)">
                                Ver actividad registrada
                            </Boton>
                        }
                        @if (!OperandoWorkspaceAjeno)
                        {
                            <div class="delegaciones-acciones">
                                @if (delegacion.EsSoporte && delegacion.AccesoVigente)
                                {
                                    @if (PuedeAdministrarAccesoSoporte(delegacion.SomosLaConsultora))
                                    {
                                        <Boton Tamano="TamanoBoton.Pequeno"
                                               Variante="VarianteBoton.Destructivo"
                                               OnClick="() => CerrarAccesoSoporteAsync(delegacion)"
                                               Cargando="@EstaProcesando(delegacion.Id)">
                                            Cerrar acceso
                                        </Boton>
                                    }
                                }
                                else if (delegacion.EsSoporte)
                                {
                                    @if (PuedeAdministrarAccesoSoporte(delegacion.SomosLaConsultora))
                                    {
                                        <Boton Tamano="TamanoBoton.Pequeno"
                                               Variante="VarianteBoton.Secundario"
                                               OnClick="() => AbrirFormularioSoporte(delegacion)">
                                            Abrir acceso
                                        </Boton>
                                    }
                                }
                                else if (delegacion.Activa)
                                {
                                    @* Revoca el equipo del Operador CAE externo con alcance sobre el Tenant
                                       propietario (decisiones del 2026-10-26): el botón se pinta solo a
                                       quien puede usarlo. *@
                                    @if (PuedeRevocar(delegacion.Id))
                                    {
                                        <Boton Tamano="TamanoBoton.Pequeno"
                                               Variante="VarianteBoton.Destructivo"
                                               OnClick="() => { if (!EstaProcesando(delegacion.Id)) { PrepararEntidad(delegacion.Id); _delegacionARevocar = delegacion; } }">
                                            Revocar acceso
                                        </Boton>
                                    }
                                }
                                else if (PuedeReactivar(delegacion.Id))
                                {
                                    <Boton Tamano="TamanoBoton.Pequeno"
                                           Variante="VarianteBoton.Secundario"
                                           OnClick="() => ReactivarAsync(delegacion)"
                                           Cargando="@EstaProcesando(delegacion.Id)">
                                        Reactivar
                                    </Boton>
                                }
                            </div>
                        }
                    </div>
                </div>
                </td></tr>
                }
            }
            </tbody>
        </table>
        }
        </text>, PieLista)
    }
    @if (!_cargando && !_error && _accesosSoporteTalveg is not null && !OperandoWorkspaceAjeno)
    {
        <section class="accesos-soporte-talveg" aria-labelledby="titulo-accesos-soporte-talveg">
            <h2 id="titulo-accesos-soporte-talveg" class="accesos-soporte-talveg-titulo">@TextosAccesos["SeccionTitulo"]</h2>
            <p class="accesos-soporte-talveg-descripcion">@TextosAccesos["SeccionDescripcion"]</p>
            @if (_accesosSoporteTalveg.Count == 0)
            {
                <EstadoVacio Titulo="@TextosAccesos["Vacio"]" />
            }
            else
            {
                <TarjetaListado>
                    <Contenido>
<table class="tabla-datos accesos-soporte-talveg-tabla">
                    <thead>
                        <tr>
                            <th>@TextosAccesos["ColumnaQuien"]</th>
                            <th>@TextosAccesos["ColumnaTipo"]</th>
                            <th>@TextosAccesos["ColumnaMotivo"]</th>
                            <th>@TextosAccesos["ColumnaTicket"]</th>
                            <th>@TextosAccesos["ColumnaVentana"]</th>
                            <th>@TextosAccesos["ColumnaEstado"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var acceso in _accesosSoporteTalveg)
                        {
                            <tr>
                                <td>@TextosAccesos["ValorQuien"]</td>
                                <td>@TextoTipoAcceso(acceso.Capacidad)</td>
                                <td>@acceso.Motivo</td>
                                <td>@(acceso.Ticket ?? TextosAccesos["SinTicket"])</td>
                                <td>@TextoVentanaAcceso(acceso)</td>
                                <td><Badge Tono="@TonoEstadoAcceso(acceso.Estado)">@TextoEstadoAcceso(acceso.Estado)</Badge></td>
                            </tr>
                        }
                    </tbody>
                </table>
                    </Contenido>
                </TarjetaListado>
            }
        </section>
    }
</div>

<Drawer Visible="_verActividadDe is not null"
        VisibleChanged="v => CerrarActividad(v)"
        Titulo="Actividad de soporte registrada">
    @if (_cargandoActividad)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_actividad.Count == 0)
    {
        <EstadoVacio Titulo="Sin actividad registrada"
                     Descripcion="No hay actividad disponible para esta delegación." />
    }
    else
    {
        <div class="delegaciones-actividad-cabecera">Soporte · @_verActividadDe?.ClienteNombre</div>
        <TarjetaListado>
                    <Contenido>
<table class="tabla-datos delegaciones-tabla">
            <thead>
                <tr>
                    <th>Cuándo</th>
                    <th>Qué</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registro in _actividad)
                {
                    <tr>
                        <td>@registro.OcurridaEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@DescribirTipo(registro.Tipo)</td>
                        <td>@registro.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
                    </Contenido>
                </TarjetaListado>
    }
</Drawer>

@* Los tres formularios de la página son ModalFormulario: guardián propio, «Cancelar» como la X, primario único con su estado, aviso del
   formulario (el error del servidor o de validación, fuera del cuerpo desplazable) y aviso de navegación vienen del kit. *@
<ModalFormulario Visible="_delegacionSoporteAAbrir is not null" VisibleChanged="v => CerrarFormularioSoporte(v)"
                 Titulo="Abrir acceso de soporte" HayCambios="() => HayCambiosSoporte"
                 Guardando="@EstaProcesando(_delegacionSoporteAAbrir?.Id)" MensajeError="@_errorSoporte"
                 OnGuardar="AbrirAccesoSoporteAsync" TextoGuardar="Abrir acceso" TextoCancelar="Cancelar">
    @if (_delegacionSoporteAAbrir is not null)
    {
        <p>El acceso a <strong>@_delegacionSoporteAAbrir.ClienteNombre</strong> queda registrado en su actividad.</p>
        <CampoTexto Etiqueta="Motivo"
                    Valor="@_motivoSoporte"
                    ValorChanged="v => { _motivoSoporte = v; _errorSoporte = null; }"
                    Placeholder="Incidencia o petición que justifica la entrada" />
        <CampoTexto Etiqueta="Horas de acceso (máximo 4)"
                    Type="number"
                    Valor="@_horasSoporte"
                    ValorChanged="v => { _horasSoporte = v; _errorSoporte = null; }" />
        <CampoSelect Etiqueta="Permisos"
                     Valor="@_rolSoporte"
                     ValorChanged="v => { _rolSoporte = v; _errorSoporte = null; }">
            <option value="Consulta">Solo lectura</option>
            <option value="GestorCae">Acceso con modificación</option>
            <option value="CoordinadorCae">Acceso con modificación avanzado</option>
        </CampoSelect>
    }
</ModalFormulario>

<DialogoConfirmacion Visible="@(_delegacionARevocar is not null)"
                     VisibleChanged="CerrarRevocacion"
                     Titulo="Revocar el acceso"
                     Mensaje="@MensajeRevocacion"
                     TextoBotonConfirmar="Revocar acceso"
                     EnProgreso="@EstaProcesando(_delegacionARevocar?.Id)"
                     OnConfirmar="RevocarAsync" />

<DialogoConfirmacion Visible="@(_operadorARetirar is not null)"
                     VisibleChanged="CerrarRetirada"
                     Titulo="@TextosAutorizar["RetirarTitulo"]"
                     Mensaje="@MensajeRetirada"
                     TextoBotonConfirmar="@TextosAutorizar["RetirarConfirmar"]"
                     EnProgreso="@EstaProcesando(_operadorARetirar?.Operador.AsignacionId)"
                     OnConfirmar="RetirarOperadorAsync" />

<ModalFormulario Visible="_mostrarNuevaDelegacion" VisibleChanged="v => CerrarFormularioNueva(v)"
                 Titulo="Nueva delegación" HayCambios="() => HayCambiosNueva"
                 Guardando="_creandoDelegacion" MensajeError="@_errorNuevaDelegacion"
                 OnGuardar="CrearDelegacionAsync" TextoGuardar="Crear" TextoCancelar="Cancelar">
    <p>Se creará una organización nueva y quedará delegada a la tuya de inmediato.</p>
    <CampoTexto Etiqueta="Nombre de la organización"
                Valor="@_nombreClienteNuevo"
                ValorChanged="v => { _nombreClienteNuevo = v; _errorNuevaDelegacion = null; }"
                Placeholder="Constructora Ejemplo S.L." />
</ModalFormulario>

<ModalFormulario Visible="_mostrarAutorizarOperador" VisibleChanged="v => CerrarAutorizarOperador(v)"
                 Titulo="@TextosAutorizar["AccionAutorizar"]" HayCambios="() => HayCambiosOperador"
                 Guardando="_autorizandoOperador" MensajeError="@_errorAutorizarOperador"
                 OnGuardar="AutorizarOperadorAsync" AlDescartarPorNavegacion="AlDescartarAutorizarPorNavegacion"
                 TextoGuardar="@TextosAutorizar["Autorizar"]" TextoCancelar="@TextosAutorizar["Cancelar"]">
    @if (_operadorSugerido)
    {
        <p class="delegaciones-sugerencia">@TextosAutorizar["Sugerencia"]</p>
    }
    <CampoTexto Etiqueta="@TextosAutorizar["EtiquetaOperador"]"
                Valor="@_busquedaOperador"
                ValorChanged="BuscarOperadorAsync"
                Placeholder="@TextosAutorizar["MarcadorBusqueda"]" />
    @if (_operadorCandidato is { } candidato)
    {
        <div class="delegaciones-candidatos" role="listbox" aria-label="@TextosAutorizar["ListaCandidatos"]">
            <button type="button"
                    role="option"
                    aria-selected="@(_operadorSeleccionado ? "true" : "false")"
                    class="delegaciones-candidato @(_operadorSeleccionado ? "delegaciones-candidato-seleccionado" : null)"
                    @onclick="SeleccionarOperador">
                <span>@candidato.Nombre</span>
                @if (_operadorSeleccionado)
                {
                    <span aria-hidden="true">✓</span>
                }
            </button>
        </div>
    }
    else if (_busquedaSinResultado)
    {
        <p class="delegaciones-nota-modal">@TextosAutorizar["SinResultado", _busquedaOperador.Trim()]</p>
    }
    <p class="delegaciones-nota-modal">@TextosAutorizar["NotaPropiedad"]</p>
</ModalFormulario>
</LimiteDeErrores>

@code {
    private RenderFragment AccionesCabeceraLista => @<text>
        @if (PuedeGestionar)
        {
            <Boton Variante="VarianteBoton.Primario" OnClick="AbrirFormularioNuevaDelegacion">Nueva delegación</Boton>
        }
        @if (PuedeAutorizarOperador)
        {
            <Boton Variante="VarianteBoton.Primario" OnClick="AbrirAutorizarOperador">@TextosAutorizar["AccionAutorizar"]</Boton>
        }
    </text>;

    private RenderFragment? PieLista => _error || (_cargando && _delegaciones.Count == 0) ? null : @<text>
        <PaginadorSimple PresentacionMaqueta="true" Etiqueta="@TextosLista["Titulo"]"
                         TotalElementos="FilasFiltradas.Count" ElementosEnPagina="FilasVisiblesLista.Count" PaginaActual="_paginaLista"
                         TotalPaginas="TotalPaginasLista" TamanoPagina="_tamanoLista"
