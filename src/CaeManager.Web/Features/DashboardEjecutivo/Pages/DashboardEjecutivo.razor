@page "/dashboard-ejecutivo"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using ApexCharts
@using CaeManager.Application.Dashboard.Catalogo

<PageTitle>Dashboard Ejecutivo — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="dashboard-cabecera">
        <span class="dashboard-kicker">Dashboard Ejecutivo</span>
        <h1 class="titulo-pagina">Tu cartera, con los KPI que elijas</h1>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar el Dashboard Ejecutivo" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_valores is null || _seleccionGuardada is null)
    {
        <EstadoCargando Filas="2" />
    }
    else
    {
        <SeccionColapsable Titulo="Personalizar" ExpandidaPorDefecto="@(_seleccionGuardada.Count == 0)">
            <div class="rejilla-categorias-kpi">
                @foreach (var categoria in CatalogoKpis.Todos.GroupBy(k => k.Categoria))
                {
                    <div class="categoria-kpi">
                        <h3 class="categoria-kpi-titulo">@categoria.Key</h3>
                        @foreach (var kpi in categoria)
                        {
                            <label class="checkbox-kpi" title="@kpi.Descripcion">
                                <input type="checkbox"
                                       checked="@_seleccionEnEdicion.Contains(kpi.Codigo)"
                                       @onchange="@(e => AlternarSeleccion(kpi.Codigo, (bool)e.Value!))" />
                                @kpi.Titulo
                            </label>
                        }
                    </div>
                }
            </div>
            <Boton OnClick="GuardarSeleccionAsync" Cargando="_guardando">Guardar selección</Boton>
        </SeccionColapsable>

        var seleccionados = _seleccionGuardada
            .Where(codigo => CatalogoKpis.Todos.Any(k => k.Codigo == codigo))
            .Select(codigo => CatalogoKpis.Todos.First(k => k.Codigo == codigo))
            .ToList();
        var tiles = seleccionados.Where(k => k.TipoRender is TipoRenderKpi.TileNumerico or TipoRenderKpi.TilePorcentajeConTono).ToList();
        var graficos = seleccionados.Where(k => k.TipoRender is TipoRenderKpi.GraficoDonut or TipoRenderKpi.GraficoBarras
            or TipoRenderKpi.TablaRiesgo or TipoRenderKpi.BarraComparativa).ToList();

        @if (seleccionados.Count == 0)
        {
            <EstadoVacio Titulo="Todavía no has elegido ningún KPI" Descripcion="Marca al menos uno en el panel de arriba y guarda la selección." />
        }
        else
        {
            @if (tiles.Count > 0)
            {
                <div class="rejilla-kpis-criticos">
                    @foreach (var kpi in tiles)
                    {
                        <TarjetaMetrica Etiqueta="@kpi.Titulo" Valor="@ValorTile(kpi.Codigo)" Tono="@TonoTile(kpi.Codigo)" />
                    }
                </div>
            }

            @foreach (var kpi in graficos)
            {
                <Tarjeta Titulo="@kpi.Titulo">
                    @if (kpi.Codigo == CatalogoKpis.SemaforoDocumental)
                    {
                        <ApexChart TItem="SegmentoGraficoDto" Height="280">
                            <ApexPointSeries TItem="SegmentoGraficoDto" Items="_semaforoDocumental"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(s => s.Etiqueta)"
                                             YValue="@(s => s.Valor)" />
                        </ApexChart>
                    }
                    else if (kpi.Codigo == CatalogoKpis.IncidenciasPorGravedad)
                    {
                        @if (_incidenciasPorGravedad.Count == 0)
                        {
                            <p class="texto-vacio-seccion">No hay incidencias registradas.</p>
                        }
                        else
                        {
                            <ApexChart TItem="SegmentoGraficoDto" Height="280" Options="OpcionesBarraHorizontal">
                                <ApexPointSeries TItem="SegmentoGraficoDto" Items="_incidenciasPorGravedad"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(s => s.Etiqueta)"
                                                 YValue="@(s => s.Valor)" />
                            </ApexChart>
                        }
                    }
                    else if (kpi.Codigo == CatalogoKpis.CentrosConMenorCumplimiento)
                    {
                        @if (_centrosConMenorCumplimiento.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Ningún centro tiene todavía documentación obligatoria de trabajador que evaluar.</p>
                        }
                        else
                        {
                            <ApexChart TItem="SegmentoGraficoDto" Height="280" Options="OpcionesBarraHorizontal">
                                <ApexPointSeries TItem="SegmentoGraficoDto" Items="_centrosConMenorCumplimiento"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(s => s.Etiqueta)"
                                                 YValue="@(s => s.Valor)" />
                            </ApexChart>
                        }
                    }
                    else if (kpi.Codigo == CatalogoKpis.EmpresasConMasRiesgo)
                    {
                        @if (_empresasEnRiesgo.Count == 0)
                        {
                            <p class="texto-vacio-seccion">Ninguna empresa tiene documentación urgente o vencida.</p>
                        }
                        else
                        {
                            <table class="tabla-datos">
                                <thead>
                                    <tr>
                                        <th>Empresa</th>
                                        <th>Vencidos</th>
                                        <th>Urgentes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var empresa in _empresasEnRiesgo)
                                    {
                                        <tr class="fila-clicable" @onclick="() => IrAEmpresa(empresa.EmpresaRazonSocial)">
                                            <td>@empresa.EmpresaRazonSocial</td>
                                            <td><Badge Tono="TonoBadge.Peligro">@empresa.DocumentosVencidos</Badge></td>
                                            <td><Badge Tono="TonoBadge.Advertencia">@empresa.DocumentosUrgentes</Badge></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else if (kpi.Codigo == CatalogoKpis.AutomaticoVsManual)
                    {
                        @if (TotalAprobaciones == 0)
                        {
                            <p class="texto-vacio-seccion">Todavía no hay documentos verificados por IA.</p>
                        }
                        else
                        {
                            <div class="barra-comparativa" role="img" aria-label="@($"{PorcentajeAutomatica}% de las gestiones fueron automáticas, {PorcentajeManual}% manuales")">
                                @if (PorcentajeAutomatica > 0)
                                {
                                    <div class="barra-comparativa-segmento barra-comparativa-automatica" style="width:@(PorcentajeAutomatica)%"></div>
                                }
                                @if (PorcentajeManual > 0)
                                {
                                    <div class="barra-comparativa-segmento barra-comparativa-manual" style="width:@(PorcentajeManual)%"></div>
                                }
                            </div>
                            <ul class="barra-comparativa-leyenda">
                                <li class="barra-comparativa-item">
                                    <span class="barra-comparativa-punto barra-comparativa-automatica"></span>
                                    Automáticas — @_estadisticasAprobacion!.Automaticas (@PorcentajeAutomatica%)
                                </li>
                                <li class="barra-comparativa-item">
                                    <span class="barra-comparativa-punto barra-comparativa-manual"></span>
                                    Manuales — @_estadisticasAprobacion.Manuales (@PorcentajeManual%)
                                </li>
                            </ul>
                        }
                    }
                </Tarjeta>
            }
        }
    }
</div>
