@page "/importacion"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Web.Features.Importacion
@using CaeManager.Web.Features.Importacion.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosImportacion> Textos

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>@TituloPagina — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    @if (EsImportacionDocumentos)
    {
        <div class="ruta-importacion ruta-importacion-documentos">
            <a class="enlace-volver-importacion" href="/documentos"><Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlaceMigaDocumentos"]</a>
            <span class="miga-importacion"><span aria-hidden="true">/</span> <span class="miga-importacion-actual">@Textos["TituloImportarDocumentos"]</span></span>
        </div>
    }
    @* Cabecera Gen 2. Con ?plantilla=clientes o ?plantilla=combinada —los
       enlaces de Clientes y los marcadores /clientes/importar y
       /clientes/importar-combinado, que redirigen aquí— es la de los mockups
       «Importar Clientes» e «Importar Combinado»: vuelta a Clientes, ruta y
       título propios, y en la Combinada su entradilla. Sin ellos, la de
       «Importar datos». Las filas de esas plantillas son Clientes
       empresariales del Tenant, no Clientes comerciales TALVEG. *@
    @if (DesdeClientes && !IntegradaEnConfiguracion)
    {
        <div class="ruta-importacion">
            <a class="enlace-volver-importacion" href="/clientes"><Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlaceVolverClientes"]</a>
            <span class="miga-importacion">
                @Textos["MigaNegocio"] <span class="miga-importacion-flecha" aria-hidden="true">→</span>
                @Textos["MigaClientes"] <span class="miga-importacion-flecha" aria-hidden="true">→</span>
                <span class="miga-importacion-actual">@TituloPagina</span>
            </span>
        </div>
    }

    <CabeceraPagina Titulo="@TituloPagina" Kicker="@(IntegradaEnConfiguracion ? null : EsImportacionDocumentos ? Textos["KickerCicloDocumental"].Value : Textos["KickerConfiguracion"].Value)" Integrada="IntegradaEnConfiguracion"
                    Descripcion="@(EsCombinadaDesdeClientes ? EntradillaCombinada : null)" />

    @if (EsImportacionDocumentos)
    {
        <div class="acciones-contexto-documentos">
            <a href="/importacion">@Textos["EnlaceVerPlantillas"]</a>
        </div>
    }

    <nav class="pasos-importacion" aria-label="@Textos["AriaProgresoImportacion"]">
        @for (var i = 0; i < ClavesPasos.Count; i++)
        {
            var numero = i + 1;
            var actual = numero == _step;
            var completado = numero < _step;
            var alcanzable = numero <= _pasoMaximoAlcanzado;
            <button type="button" class="@($"paso-importacion {(actual ? "paso-importacion-actual" : "")} {(completado ? "paso-importacion-completado" : "")}")"
                    disabled="@(!alcanzable)" @onclick="() => IrAPaso(numero)" aria-current="@(actual ? "step" : null)">
                <span class="paso-importacion-marca">
                    @if (completado)
                    {
                        <Icono Nombre="check" Tamano="TamanoIcono.Pequeno" />
                    }
                    else
                    {
                        @numero
                    }
                </span>
                @Textos[ClavesPasos[i]]
            </button>
            @if (numero < ClavesPasos.Count)
            {
                <span class="paso-importacion-flecha" aria-hidden="true">→</span>
            }
        }
    </nav>

    @if (_step == 1)
    {
        <div class="rejilla-paso1">
            <div class="columna-plantillas">
                <h2 class="titulo-seccion-importacion" id="titulo-plantillas-importacion" tabindex="-1" @ref="_tituloPaso">@Textos["TituloElegirPlantilla"]</h2>
                @* Elegir plantilla es una elección exclusiva entre cuatro: patrón
                   radiogroup de WAI-ARIA, como la biblioteca de Reportes, y no
                   botones con aria-pressed (que anuncian conmutadores
                   independientes). Una sola parada de tabulador (la marcada lleva
                   tabindex="0", las demás "-1"); las flechas, circulares, MARCAN
                   la plantilla destino —con el mismo descarte del plan que el
                   clic— y le mueven el foco. Cada opción es un <button>, así que
                   Enter y Espacio la activan como el clic sin manejador propio.
                   El enlace de la plantilla en blanco va FUERA del botón: dentro
                   de un radio sus hijos son presentacionales y el enlace
                   desaparecería del árbol de accesibilidad. *@
                <div class="rejilla-plantillas" role="radiogroup" aria-labelledby="titulo-plantillas-importacion">
                    @for (var i = 0; i < Plantillas.Count; i++)
                    {
                        var indice = i;
                        var plantilla = Plantillas[indice];
                        var seleccionada = plantilla.Id == _plantillaId;
                        <div class="@($"tarjeta-plantilla {(seleccionada ? "tarjeta-plantilla-seleccionada" : "")}")" data-plantilla="@plantilla.Id">
                            <button type="button" role="radio" class="opcion-tarjeta-plantilla"
                                    aria-checked="@(seleccionada ? "true" : "false")" tabindex="@(seleccionada ? "0" : "-1")"
                                    aria-labelledby="@($"titulo-plantilla-{plantilla.Id}")"
                                    aria-describedby="@($"descripcion-plantilla-{plantilla.Id} limite-plantilla-{plantilla.Id}")"
                                    @ref="_referenciasPlantillas[indice]"
                                    @onclick="() => SeleccionarPlantilla(plantilla.Id)"
                                    @onkeydown="e => ManejarTeclaPlantilla(e, indice)">
                                <span class="cabecera-tarjeta-plantilla">
                                    <span class="icono-tarjeta-plantilla" aria-hidden="true"><Icono Nombre="@plantilla.NombreIcono" Tamano="TamanoIcono.Pequeno" /></span>
                                    <span class="titulo-tarjeta-plantilla" id="@($"titulo-plantilla-{plantilla.Id}")">@Textos[plantilla.ClaveTitulo]</span>
                                </span>
                                <span class="descripcion-tarjeta-plantilla" id="@($"descripcion-plantilla-{plantilla.Id}")">@Textos[plantilla.ClaveDescripcion]</span>
                                <span class="limite-tarjeta-plantilla" id="@($"limite-plantilla-{plantilla.Id}")">@Textos["LimiteTamanoPlantilla", plantilla.TamanoMaximoBytes / (1024 * 1024)]</span>
                            </button>
                            @if (plantilla.RutaPlantillaBlanco is not null)
                            {
                                <a href="@plantilla.RutaPlantillaBlanco" class="enlace-plantilla-blanco"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlacePlantillaBlanco"]</a>
                            }
                        </div>
                    }
                </div>
                <div class="acciones-formulario acciones-derecha">
                    <Boton OnClick="ContinuarAAnalizar">@Textos["BotonContinuarConPlantilla", Textos[PlantillaActual.ClaveNombreCorto].Value]</Boton>
                </div>
            </div>

            <aside class="panel-historial-importacion">
                <div class="cabecera-panel-historial">@Textos["CabeceraHistorial"]</div>
                @if (_cargandoHistorial)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_historial.Count == 0)
                {
                    <p class="vacio-historial-importacion">@Textos["HistorialVacio"]</p>
                }
                else
                {
                    @foreach (var item in _historial)
                    {
                        <div class="item-historial-importacion">
                            <div class="fila-item-historial">
                                <span class="plantilla-item-historial">@item.Plantilla</span>
                                <span class="fecha-item-historial">@item.EjecutadaEnUtc.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                            </div>
                            <span class="detalle-item-historial">
                                @NombreUsuario(item.EjecutadaPorUsuarioId) ·
                                @if (item.Exitosa)
                                {
                                    <span class="resultado-exito-historial">@Textos["HistorialResultadoExito", item.TotalCreados, item.TotalAdvertencias]</span>
                                }
                                else
                                {
                                    <span class="resultado-fallo-historial">@Textos["HistorialResultadoFallo", item.MensajeError ?? string.Empty]</span>
                                }
                            </span>
                        </div>
                    }
                }
            </aside>
        </div>
    }
    else if (_step == 2)
    {
        <div class="columna-paso-ancho">
            <h2 class="titulo-seccion-importacion" tabindex="-1" @ref="_tituloPaso">@Textos["TituloSubeArchivo"]</h2>

            @if (EsImportacionDocumentos)
            {
                <section class="contexto-plantilla-documentos" aria-label="@Textos["AriaPlantillaDocumentos"]">
                    <div>
                        <h3>@Textos["TituloContextoPlantillaDocumentos"]</h3>
                        <p>@Textos["PlantillaDocumentosDescripcion"]</p>
                    </div>
                    <a href="/documentos/plantilla.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> @Textos["EnlacePlantillaBlanco"]</a>
                </section>
                <div class="rejilla-alcance-documentos">
                    <section class="tarjeta-alcance-documentos">
                        <h3>@Textos["TituloQueHace"]</h3>
                        <ul>
                            <li>@Textos["QueHaceCrea"]</li>
                            <li>@Textos["QueHaceCruza"]</li>
                            <li>@Textos["QueHaceConstancia"]</li>
                        </ul>
                    </section>
                    <section class="tarjeta-alcance-documentos tarjeta-alcance-documentos-limitacion">
                        <h3>@Textos["TituloNoHace"]</h3>
                        <ul>
                            <li>@Textos["NoHaceAltas"]</li>
                            <li>@Textos["NoHacePdf"]</li>
                            <li>@Textos["NoHaceVencimiento"]</li>
                        </ul>
                    </section>
                </div>
            }

            <ZonaSoltarArchivo Titulo="@Textos["ZonaSoltarTitulo", Textos[PlantillaActual.ClaveTitulo].Value]"
                                FormatosTexto="@Textos["ZonaSoltarFormatos", PlantillaActual.TamanoMaximoBytes / (1024 * 1024)]"
                                Accept=".xlsx" Cargando="_analizando" NombreArchivoActual="@_nombreArchivo"
                                OnChange="ManejarArchivoSeleccionadoAsync" />

            @* .alerta-formulario es SOLO el error de lectura: el E2E
               (Ayudas.GuionEstadoDelAnalisis) la toma como desenlace «error»
               del análisis. Ningún otro aviso de este paso puede llevarla. *@
            @if (_mensajeError is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeError</div>
            }

            @* ProgresoConMensajes no anuncia nada por sí mismo (igual que en
               Reportes): la región existe SIEMPRE en este paso —vacía mientras no
               se analiza— para que el lector de pantalla ya la esté vigilando
               cuando aparezca el progreso. *@
            <div class="region-progreso-analisis" role="status" aria-live="polite">
                <ProgresoConMensajes Visible="_analizando" Mensajes="MensajesAnalizando" />
            </div>

            @if (EsPlantillaClientes)
            {
                <section class="columnas-plantilla-importacion" aria-labelledby="columnas-plantilla-clientes-titulo">
                    <h3 id="columnas-plantilla-clientes-titulo" class="cabecera-columnas-plantilla">@Textos["TituloColumnasHoja", NombreHojaClientes]</h3>
                    <div class="tabla-columnas-plantilla-envoltorio">
                        <table class="tabla-datos">
                            <thead>
                                <tr>
                                    <th scope="col">@Textos["ColumnaColumna"]</th>
                                    <th scope="col">@Textos["ColumnaEjemplo"]</th>
                                    <th scope="col">@Textos["ColumnaObligatoria"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var columna in ColumnasPlantillaClientes)
                                {
                                    <tr data-columna-plantilla>
                                        <td class="nombre-columna-plantilla">@columna.Nombre</td>
                                        <td class="ejemplo-columna-plantilla">@columna.Ejemplo</td>
                                        <td><Badge Tono="@(columna.Obligatoria ? TonoBadge.Exito : TonoBadge.Neutro)">@(columna.Obligatoria ? Textos["ValorSi"].Value : Textos["ValorNo"].Value)</Badge></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="nota-columnas-plantilla">
                        @Textos["NotaColumnasPlantilla", MarcadorFilaEjemplo, ColumnaCriticoCorta, ValorCriticoSi]
                    </p>
                </section>
            }

            @* Mockup «Importar Combinado», paso 2: las cuatro hojas en el orden
               en que el lector las resuelve. Mismo papel que las columnas de
               la hoja «Clientes» de arriba, para la otra plantilla con hojas
               fijas. *@
            @if (EsPlantillaCombinada)
            {
                <section class="hojas-combinada-importacion" aria-labelledby="hojas-combinada-titulo">
                    <h3 id="hojas-combinada-titulo" class="titulo-hojas-combinada">@Textos["TituloHojasCombinada"]</h3>
                    <ol class="rejilla-hojas-combinada">
                        @foreach (var hoja in HojasCombinada)
                        {
                            <li class="tarjeta-hoja-combinada" data-hoja-combinada="@hoja.Nombre">
                                <span class="cabecera-hoja-combinada">
                                    <span class="numero-hoja-combinada" aria-hidden="true">@hoja.Numero</span>
                                    <span class="nombre-hoja-combinada">@hoja.Nombre</span>
                                </span>
                                <span class="columnas-hoja-combinada">@string.Join(" · ", hoja.Columnas)</span>
                                <span class="regla-hoja-combinada">@Textos[hoja.ClaveRegla]</span>
                            </li>
                        }
                    </ol>
                    <p class="nota-hojas-combinada">
                        @Textos["NotaHojasCombinada", NombreHojaClientes]
                    </p>
                </section>
            }

            <div class="acciones-formulario acciones-entre">
                @if (!EsImportacionDocumentos)
                {
                    <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(1)">@Textos["BotonCambiarPlantilla"]</Boton>
                }
                <Boton Deshabilitado="!TienePlan" OnClick="ContinuarARevisarPlan">@Textos["BotonVerPlan"]</Boton>
            </div>
        </div>
    }
    else if (_step == 3)
    {
        <div class="columna-paso-ancho">
            <div class="cabecera-revision-plan">
                <h2 class="titulo-seccion-importacion" tabindex="-1" @ref="_tituloPaso">@Textos["TituloRevisarPlan"]</h2>
                <span class="detalle-revision-plan">@Textos["DetalleRevisionPlan", _nombreArchivo ?? string.Empty]</span>
            </div>

            @if (CombinadaSinNadaNuevo)
            {
                @* Mockup «Importar Combinado», estado «Nada nuevo que crear»:
                   ni badges ni lista, porque no hay nada que listar. Los
                   botones de abajo siguen: el paso 4 es donde se elige
                   reemplazar para actualizar lo que ya existe. *@
                <EstadoVacio Titulo="@Textos["TituloSinNadaNuevo"]"
                             Descripcion="@TextoSinNadaNuevo" NombreIcono="importar" />
            }
            else
            {
            <div class="badges-resumen-plan">
                <Badge Tono="TonoBadgeCrear" title="@TituloBadgeCrear">@Textos["BadgeSeCrearan", TotalACrear]</Badge>
                @if (_planCombinada is not null)
                {
                    <Badge Tono="TonoBadge.Neutro" title="@Textos["TituloBadgeReutilizados"]">@Textos["BadgeReutilizados", TotalReutilizados]</Badge>
                }
                <Badge Tono="TonoBadge.Advertencia">@Textos["BadgeConAviso", TotalAdvertencias]</Badge>
                <Badge Tono="TonoBadge.Peligro">@Textos["BadgeSeOmitiran", TotalOmitidos]</Badge>
            </div>

            @* El mockup, en su modo «Fiel al código de hoy», pinta aquí el
               defecto: el plan cuenta altas de Cliente empresarial y Centro que
               la escritura no hará. Se dice al usuario en su idioma, sin
               nombres de clases; el recuento de arriba sigue siendo el del
               análisis. La «Propuesta corregida» del mockup (recontar esas
               filas como «No se creará») no se hace aquí: corregir el recuento
               es del análisis, no de la pantalla. *@
            @if (AltasClienteCentroQueNoSeHaran > 0)
            {
                <div class="aviso-altas-importacion" role="note">
                    <span class="icono-aviso-altas"><Icono Nombre="advertencia" /></span>
                    <div>
                        <p class="titulo-aviso-altas">@TituloAvisoAltas</p>
                        <p class="detalle-aviso-altas">@TextoFilasClienteCentroQueSeOmitiran @Textos["IndicacionAltaManual"]</p>
                    </div>
                </div>
            }

            @* Combinada: árbol de lo que se va a crear (por defecto, como el
               mockup) o la lista plana de siempre. El árbol solo enseña altas
               y reutilizados; los avisos y omitidos, que la lista plana ya
               traía, se siguen enseñando debajo en vez de desaparecer. *@
            @if (_planCombinada is not null)
            {
                <div class="vistas-plan-importacion" role="group" aria-label="@Textos["AriaVistaPlan"]">
                    <button type="button" class="@ClaseVistaPlan(true)" aria-pressed="@(_vistaArbolPlan ? "true" : "false")"
                            @onclick="() => _vistaArbolPlan = true">@Textos["BotonVistaArbol"]</button>
                    <button type="button" class="@ClaseVistaPlan(false)" aria-pressed="@(_vistaArbolPlan ? "false" : "true")"
                            @onclick="() => _vistaArbolPlan = false">@Textos["BotonVistaLista"]</button>
                </div>
            }

            @if (_planCombinada is { } planArbol && _vistaArbolPlan)
            {
                <ArbolPlanImportacion Plan="planArbol" />

                @if (planArbol.Advertencias.Count > 0)
                {
                    <h3 class="titulo-items-plan">@Textos["TituloAvisosConteo", planArbol.Advertencias.Count]</h3>
                    <div class="tabla-plan-importacion-envoltorio">
                        <TablaItemsImportacion Items="planArbol.Advertencias" Tono="TonoBadge.Advertencia" />
                    </div>
                }

                @if (planArbol.Omitidos.Count > 0)
                {
                    <h3 class="titulo-items-plan">@Textos["TituloOmitidosConteo", planArbol.Omitidos.Count]</h3>
                    <div class="tabla-plan-importacion-envoltorio">
                        <TablaItemsImportacion Items="planArbol.Omitidos" Tono="TonoBadge.Peligro" />
                    </div>
                }
            }
            else
            {
                <div class="tabla-plan-importacion-envoltorio">
                    <table class="tabla-datos">
                        <thead>
                            <tr>
                                <th>@Textos["ColumnaEntidad"]</th>
                                <th>@Textos["ColumnaAccion"]</th>
                                <th>@Textos["ColumnaMotivo"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in ProyectarFilas())
                            {
                                <tr>
                                    <td>@fila.Entidad</td>
                                    <td><Badge Tono="fila.Tono">@fila.Accion</Badge></td>
                                    <td>@fila.Motivo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            }

            <div class="acciones-formulario acciones-entre">
                <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(2)">@Textos["BotonVolverArchivo"]</Boton>
                <Boton OnClick="ContinuarAConfirmar">@Textos["BotonContinuarConfirmar"]</Boton>
            </div>
        </div>
    }
    else if (_step == 4)
    {
        <div class="columna-paso-estrecho">
            <h2 class="titulo-seccion-importacion" tabindex="-1" @ref="_tituloPaso">@Textos["TituloConfirmarImportacion"]</h2>

            <div class="tarjeta-confirmacion-importacion">
                <div class="aviso-confirmacion-importacion">
                    <span class="punto-aviso-confirmacion"></span>
                    <div>
                        <p class="titulo-aviso-confirmacion">@TituloConfirmacion</p>
                        <p class="detalle-aviso-confirmacion">@DetalleConfirmacion</p>
                    </div>
                </div>

                @if (_planCombinada is not null)
                {
                    <label class="opcion-reemplazar-importacion">
                        <input type="checkbox" @bind="_reemplazarExistentes" />
                        @Textos["OpcionReemplazar"]
                    </label>

                    @if (_reemplazarExistentes)
                    {
                        <div class="aviso-reemplazar-importacion" role="note">
                            <span class="icono-aviso-reemplazar"><Icono Nombre="advertencia" /></span>
                            <p class="texto-aviso-reemplazar">@TextoAvisoReemplazar</p>
                        </div>
                    }
                }

                <label class="casilla-confirmacion-importacion">
                    <input type="checkbox" @bind="_confirmado" />
                    @Textos["CasillaConfirmacion"]
                </label>
            </div>

            @if (_mensajeError is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeError</div>
            }

            <div class="acciones-formulario acciones-entre">
                <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(3)">@Textos["BotonRevisarElPlan"]</Boton>
                <Boton Deshabilitado="!_confirmado" Cargando="_importando" OnClick="SolicitarImportacion">@Textos["BotonImportarAhora"]</Boton>
            </div>
        </div>
    }
    else if (_step == 5)
    {
        <div class="columna-paso-estrecho">
            <h2 class="titulo-seccion-importacion" tabindex="-1" @ref="_tituloPaso">@Textos["TituloReporte"]</h2>

            <div class="tarjeta-reporte-importacion">
                <div class="cabecera-reporte-importacion">
                    <span class="icono-exito-reporte"><Icono Nombre="check" Tamano="TamanoIcono.Medio" /></span>
                    <span class="titulo-reporte-importacion">@Textos["TituloImportacionCompletada"]</span>
                </div>

                <div class="rejilla-reporte-importacion">
                    @if (_resultadoSimple is { } rs)
                    {
                        <TarjetaMetrica Etiqueta="@Textos["MetricaCreados"]" Valor="@((rs.ClientesCreados + rs.CentrosCreados + rs.EmpresasCreadas + rs.TrabajadoresCreados + rs.DocumentosCreados + rs.AsignacionesCreadas).ToString())" Tono="TonoBadge.Exito" />
                        <TarjetaMetrica Etiqueta="@Textos["MetricaAvisos"]" Valor="@rs.Advertencias.Count.ToString()" Tono="TonoBadge.Advertencia" />
                        <TarjetaMetrica Etiqueta="@Textos["MetricaOmitidos"]" Valor="@rs.Omitidos.Count.ToString()" Tono="TonoBadge.Peligro" />
                    }
                    else if (_resultadoCombinada is { } rc)
                    {
                        <TarjetaMetrica Etiqueta="@Textos["MetricaCreados"]" Valor="@((rc.ClientesCreados + rc.EmpresasCreadas + rc.CentrosCreados + rc.TrabajadoresCreados).ToString())" Tono="TonoBadge.Exito" />
                        <TarjetaMetrica Etiqueta="@Textos["MetricaActualizados"]" Valor="@((rc.ClientesActualizados + rc.EmpresasActualizadas + rc.CentrosActualizados + rc.TrabajadoresActualizados).ToString())" />
                        <TarjetaMetrica Etiqueta="@Textos["MetricaAvisos"]" Valor="@rc.Advertencias.Count.ToString()" Tono="TonoBadge.Advertencia" />
                        <TarjetaMetrica Etiqueta="@Textos["MetricaOmitidos"]" Valor="@rc.Omitidos.Count.ToString()" Tono="TonoBadge.Peligro" />
                    }
                </div>

                @{
                    var advertenciasReporte = _resultadoSimple?.Advertencias ?? _resultadoCombinada?.Advertencias ?? [];
                    var omitidosReporte = _resultadoSimple?.Omitidos ?? _resultadoCombinada?.Omitidos ?? [];
                }

                @if (advertenciasReporte.Count > 0)
                {
                    <h3 class="titulo-seccion-importacion">@Textos["TituloAvisosConteo", advertenciasReporte.Count]</h3>
                    <TablaItemsImportacion Items="advertenciasReporte" Tono="TonoBadge.Advertencia" />
                }

                @if (omitidosReporte.Count > 0)
                {
                    <h3 class="titulo-seccion-importacion">@Textos["TituloOmitidosConteo", omitidosReporte.Count]</h3>
                    <TablaItemsImportacion Items="omitidosReporte" Tono="TonoBadge.Peligro" />
                }

                <span class="nota-reporte-importacion">@Textos["NotaReporte"]</span>

                <div class="acciones-formulario">
                    <Boton OnClick="EmpezarDeNuevo">@Textos["BotonNuevaImportacion"]</Boton>
                    @* Salida del mockup: el propio motivo del handler dice
                       «créalo manualmente en Clientes» sin llevar a ninguna
                       parte. /clientes?accion=crear abre el alta de Cliente
                       empresarial de la lista (Clientes.razor.cs, Accion). *@
                    @if (EsPlantillaClientes && omitidosReporte.Count > 0)
                    {
                        <Boton Variante="VarianteBoton.Secundario" Href="/clientes?accion=crear">@Textos["BotonAltaClienteManual"]</Boton>
                    }
                    @* Salida del mockup «Importar Combinado». /clientes lista las
                       Empresas con papel de Cliente empresarial (ObtenerClientesQuery,
                       EsCritico != null), que es lo que crea la hoja «Clientes». *@
                    @if (_resultadoCombinada is not null)
                    {
                        <Boton Variante="VarianteBoton.Secundario" Href="/clientes">@Textos["BotonVerClientesEmpresariales"]</Boton>
                    }
                </div>
            </div>
        </div>
    }

    <DialogoConfirmacion Visible="_mostrarDialogoImportar" VisibleChanged="CambiarVisibilidadDialogoImportar"
                         Titulo="@Textos["DialogoTitulo"]" Mensaje="@MensajeDialogoImportar"
                         TextoBotonConfirmar="@Textos["DialogoBotonConfirmar"]" EnProgreso="_importando" OnConfirmar="ConfirmarImportacionAsync" />
</div>
