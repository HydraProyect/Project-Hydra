@page "/importacion"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Web.Features.Importacion

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>@TituloPagina — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    @* Cabecera Gen 2. Con ?plantilla=clientes —el enlace «Importar clientes»
       de Clientes y el marcador /clientes/importar, que redirige aquí— es la
       del mockup «Importar Clientes TALVEG.dc.html»: vuelta a Clientes, ruta
       y título propios. Sin él, la de «Importar datos». Las filas de esa
       plantilla son Clientes empresariales del Tenant, no Clientes
       comerciales TALVEG. *@
    @if (_desdeClientes && !IntegradaEnConfiguracion)
    {
        <div class="ruta-importacion">
            <a class="enlace-volver-importacion" href="/clientes"><Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> Volver a Clientes</a>
            <span class="miga-importacion">
                Negocio <span class="miga-importacion-flecha" aria-hidden="true">→</span>
                Clientes <span class="miga-importacion-flecha" aria-hidden="true">→</span>
                <span class="miga-importacion-actual">@TituloPagina</span>
            </span>
        </div>
    }

    <CabeceraPagina Titulo="@TituloPagina" Kicker="@(IntegradaEnConfiguracion ? null : "Configuración")" Integrada="IntegradaEnConfiguracion" />

    <nav class="pasos-importacion" aria-label="Progreso de la importación">
        @for (var i = 0; i < NombresPasos.Count; i++)
        {
            var numero = i + 1;
            var actual = numero == _step;
            var completado = numero < _step;
            var alcanzable = numero <= _pasoMaximoAlcanzado;
            <button type="button" class="@($"paso-importacion {(actual ? "paso-importacion-actual" : "")} {(completado ? "paso-importacion-completado" : "")}")"
                    disabled="@(!alcanzable)" @onclick="() => IrAPaso(numero)" aria-current="@(actual ? "step" : null)">
                <span class="paso-importacion-marca">
                    @if (completado)
                    {
                        <Icono Nombre="check" Tamano="TamanoIcono.Pequeno" />
                    }
                    else
                    {
                        @numero
                    }
                </span>
                @NombresPasos[i]
            </button>
            @if (numero < NombresPasos.Count)
            {
                <span class="paso-importacion-flecha" aria-hidden="true">→</span>
            }
        }
    </nav>

    @if (_step == 1)
    {
        <div class="rejilla-paso1">
            <div class="columna-plantillas">
                <h2 class="titulo-seccion-importacion" id="titulo-plantillas-importacion">Elige una plantilla</h2>
                @* Elegir plantilla es una elección exclusiva entre cuatro: patrón
                   radiogroup de WAI-ARIA, como la biblioteca de Reportes, y no
                   botones con aria-pressed (que anuncian conmutadores
                   independientes). Una sola parada de tabulador (la marcada lleva
                   tabindex="0", las demás "-1"); las flechas, circulares, MARCAN
                   la plantilla destino —con el mismo descarte del plan que el
                   clic— y le mueven el foco. Cada opción es un <button>, así que
                   Enter y Espacio la activan como el clic sin manejador propio.
                   El enlace de la plantilla en blanco va FUERA del botón: dentro
                   de un radio sus hijos son presentacionales y el enlace
                   desaparecería del árbol de accesibilidad. *@
                <div class="rejilla-plantillas" role="radiogroup" aria-labelledby="titulo-plantillas-importacion">
                    @for (var i = 0; i < Plantillas.Count; i++)
                    {
                        var indice = i;
                        var plantilla = Plantillas[indice];
                        var seleccionada = plantilla.Id == _plantillaId;
                        <div class="@($"tarjeta-plantilla {(seleccionada ? "tarjeta-plantilla-seleccionada" : "")}")" data-plantilla="@plantilla.Id">
                            <button type="button" role="radio" class="opcion-tarjeta-plantilla"
                                    aria-checked="@(seleccionada ? "true" : "false")" tabindex="@(seleccionada ? "0" : "-1")"
                                    aria-labelledby="@($"titulo-plantilla-{plantilla.Id}")"
                                    aria-describedby="@($"descripcion-plantilla-{plantilla.Id} limite-plantilla-{plantilla.Id}")"
                                    @ref="_referenciasPlantillas[indice]"
                                    @onclick="() => SeleccionarPlantilla(plantilla.Id)"
                                    @onkeydown="e => ManejarTeclaPlantilla(e, indice)">
                                <span class="cabecera-tarjeta-plantilla">
                                    <span class="icono-tarjeta-plantilla" aria-hidden="true">@plantilla.Icono</span>
                                    <span class="titulo-tarjeta-plantilla" id="@($"titulo-plantilla-{plantilla.Id}")">@plantilla.Titulo</span>
                                </span>
                                <span class="descripcion-tarjeta-plantilla" id="@($"descripcion-plantilla-{plantilla.Id}")">@plantilla.Descripcion</span>
                                <span class="limite-tarjeta-plantilla" id="@($"limite-plantilla-{plantilla.Id}")">.xlsx · máx. @(plantilla.TamanoMaximoBytes / (1024 * 1024)) MB</span>
                            </button>
                            @if (plantilla.RutaPlantillaBlanco is not null)
                            {
                                <a href="@plantilla.RutaPlantillaBlanco" class="enlace-plantilla-blanco"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Descargar plantilla en blanco</a>
                            }
                        </div>
                    }
                </div>
                <div class="acciones-formulario acciones-derecha">
                    <Boton OnClick="ContinuarAAnalizar">Continuar con @PlantillaActual.Titulo</Boton>
                </div>
            </div>

            <aside class="panel-historial-importacion">
                <div class="cabecera-panel-historial">Historial de importaciones</div>
                @if (_cargandoHistorial)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_historial.Count == 0)
                {
                    <p class="vacio-historial-importacion">Todavía no se ha ejecutado ninguna importación.</p>
                }
                else
                {
                    @foreach (var item in _historial)
                    {
                        <div class="item-historial-importacion">
                            <div class="fila-item-historial">
                                <span class="plantilla-item-historial">@item.Plantilla</span>
                                <span class="fecha-item-historial">@item.EjecutadaEnUtc.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                            </div>
                            <span class="detalle-item-historial">
                                @NombreUsuario(item.EjecutadaPorUsuarioId) ·
                                @if (item.Exitosa)
                                {
                                    <span class="resultado-exito-historial">@item.TotalCreados creados · @item.TotalAdvertencias avisos</span>
                                }
                                else
                                {
                                    <span class="resultado-fallo-historial">Fallida — @item.MensajeError</span>
                                }
                            </span>
                        </div>
                    }
                }
            </aside>
        </div>
    }
    else if (_step == 2)
    {
        <div class="columna-paso-ancho">
            <h2 class="titulo-seccion-importacion">Sube el archivo</h2>

            <ZonaSoltarArchivo Titulo="@($"Arrastra el archivo de {PlantillaActual.Titulo}")"
                                FormatosTexto="@($".xlsx · máx. {PlantillaActual.TamanoMaximoBytes / (1024 * 1024)} MB · el análisis no escribe nada")"
                                Accept=".xlsx" Cargando="_analizando" NombreArchivoActual="@_nombreArchivo"
                                OnChange="ManejarArchivoSeleccionadoAsync" />

            @* .alerta-formulario es SOLO el error de lectura: el E2E
               (Ayudas.GuionEstadoDelAnalisis) la toma como desenlace «error»
               del análisis. Ningún otro aviso de este paso puede llevarla. *@
            @if (_mensajeError is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeError</div>
            }

            <ProgresoConMensajes Visible="_analizando" Mensajes="MensajesAnalizando" />

            @if (EsPlantillaClientes)
            {
                <section class="columnas-plantilla-importacion" aria-labelledby="columnas-plantilla-clientes-titulo">
                    <h3 id="columnas-plantilla-clientes-titulo" class="cabecera-columnas-plantilla">Columnas que espera la hoja «Clientes»</h3>
                    <div class="tabla-columnas-plantilla-envoltorio">
                        <table class="tabla-datos">
                            <thead>
                                <tr>
                                    <th scope="col">Columna</th>
                                    <th scope="col">Ejemplo</th>
                                    <th scope="col">Obligatoria</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var columna in ColumnasPlantillaClientes)
                                {
                                    <tr data-columna-plantilla>
                                        <td class="nombre-columna-plantilla">@columna.Nombre</td>
                                        <td class="ejemplo-columna-plantilla">@columna.Ejemplo</td>
                                        <td><Badge Tono="@(columna.Obligatoria ? TonoBadge.Exito : TonoBadge.Neutro)">@(columna.Obligatoria ? "Sí" : "No")</Badge></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="nota-columnas-plantilla">
                        La fila de ejemplo, la que empieza por «EJEMPLO», se ignora. La lectura termina en la primera
                        fila sin nombre: lo que haya debajo no se lee. «Crítico» solo cuenta como sí con una C.
                    </p>
                </section>
            }

            <div class="acciones-formulario acciones-entre">
                <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(1)">← Cambiar plantilla</Boton>
                <Boton Deshabilitado="!TienePlan" OnClick="ContinuarARevisarPlan">Ver plan de importación</Boton>
            </div>
        </div>
    }
    else if (_step == 3)
    {
        <div class="columna-paso-ancho">
            <div class="cabecera-revision-plan">
                <h2 class="titulo-seccion-importacion">Revisar plan</h2>
                <span class="detalle-revision-plan">@_nombreArchivo · nada escrito todavía</span>
            </div>

            <div class="badges-resumen-plan">
                <Badge Tono="TonoBadgeCrear" title="@TituloBadgeCrear">@TotalACrear se crearán</Badge>
                <Badge Tono="TonoBadge.Advertencia">@TotalAdvertencias con aviso</Badge>
                <Badge Tono="TonoBadge.Peligro">@TotalOmitidos se omitirán</Badge>
            </div>

            @* El mockup, en su modo «Fiel al código de hoy», pinta aquí el
               defecto: el plan cuenta altas de Cliente empresarial y Centro que
               la escritura no hará. Se dice al usuario en su idioma, sin
               nombres de clases; el recuento de arriba sigue siendo el del
               análisis. La «Propuesta corregida» del mockup (recontar esas
               filas como «No se creará») no se hace aquí: corregir el recuento
               es del análisis, no de la pantalla. *@
            @if (AltasClienteCentroQueNoSeHaran > 0)
            {
                <div class="aviso-altas-importacion" role="note">
                    <span class="icono-aviso-altas"><Icono Nombre="advertencia" /></span>
                    <div>
                        <p class="titulo-aviso-altas">@TituloAvisoAltas</p>
                        <p class="detalle-aviso-altas">@TextoFilasClienteCentroQueSeOmitiran Dalos de alta a mano en Clientes y Centros.</p>
                    </div>
                </div>
            }

            <div class="tabla-plan-importacion-envoltorio">
                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th>Entidad</th>
                            <th>Acción</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in ProyectarFilas())
                        {
                            <tr>
                                <td>@fila.Entidad</td>
                                <td><Badge Tono="fila.Tono">@fila.Accion</Badge></td>
                                <td>@fila.Motivo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="acciones-formulario acciones-entre">
                <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(2)">← Volver al archivo</Boton>
                <Boton OnClick="ContinuarAConfirmar">Continuar a confirmar</Boton>
            </div>
        </div>
    }
    else if (_step == 4)
    {
        <div class="columna-paso-estrecho">
            <h2 class="titulo-seccion-importacion">Confirmar importación</h2>

            <div class="tarjeta-confirmacion-importacion">
                <div class="aviso-confirmacion-importacion">
                    <span class="punto-aviso-confirmacion"></span>
                    <div>
                        <p class="titulo-aviso-confirmacion">@TituloConfirmacion</p>
                        <p class="detalle-aviso-confirmacion">@DetalleConfirmacion</p>
                    </div>
                </div>

                @if (_planCombinada is not null)
                {
                    <label class="opcion-reemplazar-importacion">
                        <input type="checkbox" @bind="_reemplazarExistentes" />
                        Reemplazar los campos ya rellenados de los registros existentes (por defecto solo se completa lo vacío)
                    </label>
                }

                <label class="casilla-confirmacion-importacion">
                    <input type="checkbox" @bind="_confirmado" />
                    He revisado el plan y quiero escribir estos datos
                </label>
            </div>

            @if (_mensajeError is not null)
            {
                <div class="alerta-formulario" role="alert">@_mensajeError</div>
            }

            <div class="acciones-formulario acciones-entre">
                <Boton Variante="VarianteBoton.Secundario" OnClick="() => IrAPaso(3)">← Revisar el plan</Boton>
                <Boton Deshabilitado="!_confirmado" Cargando="_importando" OnClick="SolicitarImportacion">Importar ahora</Boton>
            </div>
        </div>
    }
    else if (_step == 5)
    {
        <div class="columna-paso-estrecho">
            <h2 class="titulo-seccion-importacion">Reporte</h2>

            <div class="tarjeta-reporte-importacion">
                <div class="cabecera-reporte-importacion">
                    <span class="icono-exito-reporte"><Icono Nombre="check" Tamano="TamanoIcono.Medio" /></span>
                    <span class="titulo-reporte-importacion">Importación completada</span>
                </div>

                <div class="rejilla-reporte-importacion">
                    @if (_resultadoSimple is { } rs)
                    {
                        <TarjetaMetrica Etiqueta="Creados" Valor="@((rs.ClientesCreados + rs.CentrosCreados + rs.EmpresasCreadas + rs.TrabajadoresCreados + rs.DocumentosCreados + rs.AsignacionesCreadas).ToString())" Tono="TonoBadge.Exito" />
                        <TarjetaMetrica Etiqueta="Avisos" Valor="@rs.Advertencias.Count.ToString()" Tono="TonoBadge.Advertencia" />
                        <TarjetaMetrica Etiqueta="Omitidos" Valor="@rs.Omitidos.Count.ToString()" Tono="TonoBadge.Peligro" />
                    }
                    else if (_resultadoCombinada is { } rc)
                    {
                        <TarjetaMetrica Etiqueta="Creados" Valor="@((rc.ClientesCreados + rc.EmpresasCreadas + rc.CentrosCreados + rc.TrabajadoresCreados).ToString())" Tono="TonoBadge.Exito" />
                        <TarjetaMetrica Etiqueta="Actualizados" Valor="@((rc.ClientesActualizados + rc.EmpresasActualizadas + rc.CentrosActualizados + rc.TrabajadoresActualizados).ToString())" />
                        <TarjetaMetrica Etiqueta="Avisos" Valor="@rc.Advertencias.Count.ToString()" Tono="TonoBadge.Advertencia" />
                        <TarjetaMetrica Etiqueta="Omitidos" Valor="@rc.Omitidos.Count.ToString()" Tono="TonoBadge.Peligro" />
                    }
                </div>

                @{
                    var advertenciasReporte = _resultadoSimple?.Advertencias ?? _resultadoCombinada?.Advertencias ?? [];
                    var omitidosReporte = _resultadoSimple?.Omitidos ?? _resultadoCombinada?.Omitidos ?? [];
                }

                @if (advertenciasReporte.Count > 0)
                {
                    <h3 class="titulo-seccion-importacion">Avisos (@advertenciasReporte.Count)</h3>
                    <TablaItemsImportacion Items="advertenciasReporte" Tono="TonoBadge.Advertencia" />
                }

                @if (omitidosReporte.Count > 0)
                {
                    <h3 class="titulo-seccion-importacion">Omitidos (@omitidosReporte.Count)</h3>
                    <TablaItemsImportacion Items="omitidosReporte" Tono="TonoBadge.Peligro" />
                }

                <span class="nota-reporte-importacion">Este reporte queda guardado en el historial de importaciones (paso 1).</span>

                <div class="acciones-formulario">
                    <Boton OnClick="EmpezarDeNuevo">Nueva importación</Boton>
                    @* Salida del mockup: el propio motivo del handler dice
                       «créalo manualmente en Clientes» sin llevar a ninguna
                       parte. /clientes?accion=crear abre el alta de Cliente
                       empresarial de la lista (Clientes.razor.cs, Accion). *@
                    @if (EsPlantillaClientes && omitidosReporte.Count > 0)
                    {
                        <Boton Variante="VarianteBoton.Secundario" Href="/clientes?accion=crear">Dar de alta un Cliente empresarial a mano</Boton>
                    }
                </div>
            </div>
        </div>
    }

    <DialogoConfirmacion Visible="_mostrarDialogoImportar" VisibleChanged="CambiarVisibilidadDialogoImportar"
                         Titulo="¿Importar este archivo?" Mensaje="@MensajeDialogoImportar"
                         TextoBotonConfirmar="Sí, importar" EnProgreso="_importando" OnConfirmar="ConfirmarImportacionAsync" />
</div>
