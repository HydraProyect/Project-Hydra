@using CaeManager.Application.Importacion
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Features.Importacion.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosImportacion> Textos

<table class="tabla-datos">
    <thead>
        <tr>
            <th>@Textos["ColumnaHoja"]</th>
            <th>@Textos["ColumnaFila"]</th>
            <th>@Textos["ColumnaElemento"]</th>
            <th>@Textos["ColumnaMotivo"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            <tr>
                <td><Badge Tono="Tono">@item.Hoja</Badge></td>
                <td>@(item.Fila == 0 ? "—" : item.Fila.ToString())</td>
                <td>@item.Descripcion</td>
                <td>@item.Motivo</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ItemImportacionDto> Items { get; set; } = [];
    [Parameter] public TonoBadge Tono { get; set; } = TonoBadge.Neutro;
}
