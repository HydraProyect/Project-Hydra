@page "/gestiones"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Gestiones.Commands.CompletarGestion
@using CaeManager.Application.Gestiones.Commands.EliminarGestion
@using CaeManager.Application.Gestiones.Queries.ObtenerGestiones
@using CaeManager.Application.Common
@using CaeManager.Domain.Gestiones
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Gestiones.Recursos
@using Microsoft.Extensions.Localization
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosGestiones> Textos

<LimiteDeErrores Pagina="this">
<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Sin alta: las gestiones se crean desde los caminos ya existentes. *@
    <CabeceraListado Titulo="@Textos["TituloPagina"]" Contador="@(_cargando || _errorCarga ? null : (int?)_totalElementos)">
        <Menu>
            <CaeManager.Web.Exportacion.EntradasExportar Ruta="/gestiones/exportar.xlsx" Total="@(_cargando || _errorCarga ? null : (int?)_totalElementos)" Criterios="CriteriosExportar" />
        </Menu>
    </CabeceraListado>

    <BarraFiltros Busqueda="@_busqueda" BusquedaChanged="BuscarAsync"
                  PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                  HayFiltrosActivos="HayFiltrosActivos" OnLimpiarTodo="LimpiarFiltrosAsync"
                  FiltrosGuardados="_filtrosGuardados.Opciones" OnGuardarFiltro="_filtrosGuardados.AbrirGuardar"
                  OnAplicarFiltroGuardado="_filtrosGuardados.AplicarAsync" OnBorrarFiltroGuardado="_filtrosGuardados.PedirBorrar"
                  VistaRecordada="_vistaRecordada">
        @* Sin pastillas desde que el estado se filtra en la franja; el fragmento vacío mantiene la barra en modo pastillas. *@
        <Pastillas></Pastillas>
        <Chips>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <ChipFiltro Etiqueta="@Textos["ChipBusqueda", _busqueda]" EtiquetaAccesible="@Textos["AriaQuitarBusqueda"]" OnQuitar="QuitarBusquedaAsync" />
            }
        </Chips>
    </BarraFiltros>
    <FiltrosGuardadosDeListado Conexion="_filtrosGuardados" Pantalla="@PantallaDeFiltrosGuardados" ParametrosDeVista="ParametrosDeVista"
                               OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Gestiones"
                             ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
    @* Franja de estado: sustituye a la pastilla «Estado». Viaja en la URL como «estado» y cada botón dice
       cuántas Gestiones hay, con la búsqueda aplicada. Con los dos botones marcados se ven todas. *@
    <FranjaEstado Opciones="OpcionesEstado" Valor="@_filtroEstado" ValorChanged="FiltrarPorEstadoAsync"
                  Recuentos="_recuentosPorEstado" TextoTodos="@Textos["FiltroTodas"]" />
    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />
    @if (_errorCarga)
    {
        <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)"
                     Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">@Textos["BotonReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (_cargando && _totalElementos == 0)
        {
            <EstadoCargando Filas="6" />
        }

        @* La rejilla se monta siempre (es la que pide los datos): se esconde
           mientras no haya filas que enseñar, y en su lugar se ve el esqueleto
           o el estado vacío que toque. *@
        <div style="display:@(_totalElementos == 0 ? "none" : "block")">
            <QuickGrid @key="_orden.Version" @ref="_grid" TGridItem="GestionListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                <TemplateColumn @ref="_columnaTrabajador" Title="@Textos[_ordenTrabajadorPorCentro ? "ListaTrabajadorPorCentro" : "ColumnaTrabajador"]"
                                Sortable="true" SortBy="@(_ordenTrabajadorPorCentro ? OrdenCentroListado : OrdenTrabajadorListado)"
                                IsDefaultSortColumn="@_orden.Es("trabajador", "centro")" InitialSortDirection="_orden.Direccion">
                    <ColumnOptions>
                        <div class="gestiones-opciones-orden" data-opciones-orden>
                            <button type="button" @onclick="() => CambiarCampoOrdenTrabajador(false)">@Textos["ListaOrdenarTrabajador"]</button>
                            <button type="button" @onclick="() => CambiarCampoOrdenTrabajador(true)">@Textos["ListaOrdenarCentro"]</button>
                        </div>
                    </ColumnOptions>
                    <ChildContent Context="context">
                        <span class="gestion-trabajador-centro">
                            <button type="button" class="enlace-nombre-fila nombre-abre-vista-rapida" @onclick="() => AbrirVistaRapida(context)">@context.TrabajadorNombre</button>
                            <button type="button" class="enlace-nombre-fila gestion-centro" @onclick="() => AbrirVistaRapida(context)">@context.CentroNombre</button>
                        </span>
                    </ChildContent>
                </TemplateColumn>
                @* Orden de columnas del patrón de listados: Trabajador (con su Centro debajo) · Tipo de documento ·
                   Creada · Estado, y al final el hueco de acción rápida. La segunda columna dice «Tipo de documento»
                   y no «Documento»: una Gestión referencia un Tipo de documento, no un Documento (Gestion.cs). *@
                <PropertyColumn Property="@(g => g.TipoDocumentoNombre)" Title="@Textos["ListaTipoDocumento"]" Sortable="true" Class="gestion-tipo-documento"
                                IsDefaultSortColumn="@_orden.Es("tipo")" InitialSortDirection="_orden.Direccion" />
                @* La fecha es el día de negocio (hora peninsular) del instante de creación, el mismo día que
                   enseña la vista rápida y del que sale el motivo «Abierta hace N días»; se ordena por el instante. *@
                <TemplateColumn Title="@Textos["ColumnaCreada"]" Class="gestion-creada" Sortable="true" SortBy="OrdenCreadaListado"
                                IsDefaultSortColumn="@_orden.Es("creada")" InitialSortDirection="_orden.Direccion">
                    @(context.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy"))
                </TemplateColumn>
                @* El motivo dice cuánto lleva abierta la Gestión pendiente; la completada no lleva motivo. *@
                <TemplateColumn Title="@Textos["ColumnaEstado"]" Class="col-estado" Sortable="true" IsDefaultSortColumn="@_orden.Es("estado")" InitialSortDirection="_orden.Direccion" SortBy="@(GridSort<GestionListaDto>.ByAscending(g => g.Estado))">
                    <EstadoFila Tono="@TonoEstado(context.Estado)" Texto="@TextoEstado(context.Estado)"
                                Correcto="@(context.Estado == EstadoGestion.Completada)" Motivo="@MotivoEstado(context)" />
                </TemplateColumn>
                @* Patrón de listados (2026-10-08): la fila no lleva menú «⋯». Su hueco de acción rápida es
                   completar o reabrir; la vista rápida se abre con un clic en la fila, el nombre o Enter, y
                   «Eliminar» vive en el pie de la vista rápida (decisión D1: esta pantalla no tiene selección
                   múltiple). Sin icono 360: una Gestión no tiene página propia (decisión D7). *@
                <TemplateColumn Title="@Textos["ColumnaAcciones"]" Align="Align.End">
                    <SoloConEscritura>
                        @if (context.Estado == EstadoGestion.Pendiente)
                        {
                            <button type="button" class="gestion-completar" disabled="@_cambiandoEstado.Contains(context.Id)"
                                    @onclick="() => CambiarEstadoAsync(context.Id, true)">
                                <span aria-hidden="true">✓</span> @Textos["ListaCompletar"]
                            </button>
                        }
                        else
                        {
                            <button type="button" class="gestion-reabrir" disabled="@_cambiandoEstado.Contains(context.Id)"
                                    @onclick="() => CambiarEstadoAsync(context.Id, false)">
                                @Textos["AccionReabrir"]
                            </button>
                        }
                    </SoloConEscritura>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "sin gestiones", y aquí el texto sin filtrar es
               además una explicación de cómo se generan: leída con "Completadas"
               puesto, hace creer que el mecanismo no funciona — cuando el cero
               solo dice que ninguna se ha completado todavía.

               El mockup dice «Hay gestiones en la cartera, pero ninguna
               coincide»: no se copia, porque el filtrado es de servidor y la
               consulta solo devuelve el total ya filtrado — esta pantalla no
               sabe si hay gestiones sin filtro. *@
            <EstadoVacio NombreIcono="filtro" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            @* El botón lleva adonde lleva «Mi trabajo» en el menú, y se ofrece a quien el menú se lo
               ofrece: las dos reglas se leen de CatalogoMenuLateral, no se repiten aquí. Gestiones
               la ve también el rol Consulta, al que las páginas de Mi trabajo deniegan el acceso. *@
            <AuthorizeView Roles="@CatalogoMenuLateral.RolesDeMiTrabajo">
                <Authorized>
                    <EstadoVacio Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                        <Accion>
                            <Boton Variante="VarianteBoton.Secundario"
                                   Href="@(_rutaMiTrabajo ?? CatalogoMenuLateral.RutaMiTrabajo(variosTenants: false))">@Textos["BotonIrAMiTrabajo"]</Boton>
                        </Accion>
                    </EstadoVacio>
                </Authorized>
                <NotAuthorized>
                    <EstadoVacio Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]" />
                </NotAuthorized>
            </AuthorizeView>
        }
    }
</div>

@* Vista rápida (Gestiones TALVEG.dc.html). Antes el nombre del Trabajador y
   el del Centro abrían directamente su Context Workspace; ahora abren esto
   primero y los dos 360 quedan a un clic desde aquí — mismo patrón que
   Vehículos y Subcontratas.

   Todo sale de la FILA (GestionListaDto): no hay consulta por Id de Gestion,
   y así el panel no puede discrepar de la fila que tiene al lado. Frente al
   mockup faltan dos cosas que la fila no trae:
   - «Origen»: la Gestion guarda MensajeOrigenId, pero el DTO no lo expone.
     El mockup pone «Bandeja» a todas, y la ficha del Trabajador también las
     crea: pintarlo sería inventarlo.
   - «Por qué existe esta gestión»: la Gestion tiene Notas, que el DTO
     tampoco expone (el propio mockup lo marca como hueco).
   Y «Ver el documento» no se copia: la Gestion no referencia ningún
   Documento (Gestion.cs), solo su tipo. Lo que sí existe es la documentación
   del Trabajador, y a eso lleva el enlace. *@
@if (_vistaRapida is { } vista)
{
    <aside class="vista-rapida-gestion" role="complementary" aria-label="@Textos["AriaVistaRapida"]">
        <div class="cabecera-vista-rapida-gestion">
            <div class="texto-cabecera-vista-rapida-gestion">
                <span class="etiqueta-vista-rapida-gestion">@Textos["EtiquetaVistaRapida"]</span>
                <span class="nombre-vista-rapida-gestion">@vista.TrabajadorNombre</span>
                <span class="meta-vista-rapida-gestion">
                    <Badge Tono="@TonoEstado(vista.Estado)" Tamano="TamanoBadge.Pequeno">@TextoEstado(vista.Estado)</Badge>
                    <span>@Textos["VistaRapidaCreadaEl", vista.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy")]</span>
                </span>
            </div>
            <button type="button" class="boton-cerrar-vista-rapida-gestion" aria-label="@Textos["AriaCerrarVistaRapida"]" @onclick="CerrarVistaRapida"><Icono Nombre="cerrar" /></button>
        </div>

        <div class="cuerpo-vista-rapida-gestion">
            <div class="rejilla-vista-rapida-gestion">
                <div class="celda-vista-rapida-gestion vista-rapida-centro"><span>@Textos["ColumnaCentro"]</span><strong>@vista.CentroNombre</strong></div>
                <div class="celda-vista-rapida-gestion vista-rapida-tipo-documento"><span>@Textos["ListaTipoDocumento"]</span><strong>@vista.TipoDocumentoNombre</strong></div>
                <div class="celda-vista-rapida-gestion"><span>@Textos["ColumnaCreada"]</span><strong>@(vista.CreadoEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy"))</strong></div>
            </div>

            <div class="enlaces-vista-rapida-gestion">
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Trabajador, vista.TrabajadorId, vista.TrabajadorNombre, "informacion")'>
                    @Textos["EnlaceTrabajador360"]
                </button>
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Centro, vista.CentroId, vista.CentroNombre, "informacion")'>
                    @Textos["EnlaceCentro360"]
                </button>
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Trabajador, vista.TrabajadorId, vista.TrabajadorNombre, "documentacion")'>
                    @Textos["EnlaceDocumentacionTrabajador"]
                </button>
            </div>
        </div>

        @* Completar, reabrir y eliminar son ICommand: AutorizacionEscrituraBehavior los deniega
           a Consulta, así que no se le ofrecen (los botones rápidos de la fila van envueltos igual). *@
        <SoloConEscritura>
            <div class="pie-vista-rapida-gestion">
                <Boton Variante="VarianteBoton.Primario" Cargando="_cambiandoEstado.Contains(vista.Id)" OnClick="() => CambiarEstadoAsync(vista.Id, vista.Estado != EstadoGestion.Completada)">
                    @(vista.Estado == EstadoGestion.Completada ? Textos["BotonReabrirGestion"] : Textos["AccionMarcarCompletada"])
                </Boton>
                <Boton Variante="VarianteBoton.Destructivo" Deshabilitado="_cambiandoEstado.Contains(vista.Id)" OnClick="() => AbrirEliminar(vista.Id)">@Textos["AccionEliminar"]</Boton>
            </div>
        </SoloConEscritura>
    </aside>
}

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["DialogoEliminarTitulo"]"
    Mensaje="@Textos["DialogoEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />
</LimiteDeErrores>
