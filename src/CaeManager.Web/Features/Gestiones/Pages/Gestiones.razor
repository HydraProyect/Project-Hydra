@page "/gestiones"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using CaeManager.Application.Gestiones.Commands.CompletarGestion
@using CaeManager.Application.Gestiones.Commands.EliminarGestion
@using CaeManager.Application.Gestiones.Queries.ObtenerGestiones
@using CaeManager.Application.Common
@using CaeManager.Domain.Gestiones
@using CaeManager.Web.Components.Workspace
@using CaeManager.Web.Features.Gestiones.Recursos
@using Microsoft.Extensions.Localization
@using MediatR
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ContextWorkspaceService WorkspaceService
@inject IStringLocalizer<TextosGestiones> Textos

<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Cabecera Gen 2 (Gestiones TALVEG.dc.html). Sin «+ Nueva gestión»: esta
       pantalla no da de alta, igual que antes.

       El mockup pinta a la derecha «Se crean solas al detectar un documento
       nuevo», y eso NO es lo que hace el código: CrearGestionesParaTrabajador
       solo se envía desde un botón —el de la sugerencia de la IA en la
       Bandeja de Comunicaciones, o el de la ficha del Trabajador—, y el
       propio Bandeja.razor.cs dice que «el clic en el botón ya es la
       confirmación explícita exigida». Nada las crea solas, así que la frase
       no se copia. *@
    <CabeceraPagina Titulo="@Textos["TituloPagina"]" Kicker="@Textos["Kicker"]" />

    <div class="barra-filtros">
        <CampoTexto Placeholder="@Textos["PlaceholderBusqueda"]" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <FiltroEstado Valor="@_filtroEstado" ValorChanged="FiltrarPorEstadoAsync" Opciones="OpcionesEstado" TextoTodos="@Textos["FiltroTodas"]" />
    </div>

    @* Lo que está filtrando se ve y se quita (mismo bloque que Empresas y
       Subcontratas). El chip de estado quita también el ?estado= de la URL:
       OnParametersSet lo repondría si solo se quitara en memoria. *@
    @if (HayFiltrosActivos)
    {
        <div class="chips-filtros">
            <span class="chips-filtros-indicador" aria-hidden="true"><Icono Nombre="filtro" Tamano="TamanoIcono.Pequeno" /></span>
            @if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                <span class="chip-filtro">
                    @Textos["ChipBusqueda", _busqueda]
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarBusquedaAsync" aria-label="@Textos["AriaQuitarBusqueda"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(_filtroEstado))
            {
                <span class="chip-filtro">
                    @TextoChipEstado
                    <button type="button" class="chip-filtro-quitar" @onclick="QuitarFiltroEstadoAsync" aria-label="@Textos["AriaQuitarFiltroEstado"]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
        </div>
    }

    @if (_errorCarga)
    {
        <EstadoVacio NombreIcono="error-circulo" AcentoIcono="var(--color-danger-700)" FondoIcono="var(--color-danger-50)"
                     Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
            <Accion>
                <Boton OnClick="RecargarAsync">@Textos["BotonReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        @if (_totalElementos > 0)
        {
            @* El total lo da la consulta ya filtrada: es el número de
               coincidencias, no el de gestiones de la cartera. *@
            <span class="conteo-gestiones">@TextoConteo</span>
        }

        @if (_cargando && _totalElementos == 0)
        {
            <EstadoCargando Filas="6" />
        }

        @* La rejilla se monta siempre (es la que pide los datos): se esconde
           mientras no haya filas que enseñar, y en su lugar se ve el esqueleto
           o el estado vacío que toque. *@
        <div style="display:@(_totalElementos == 0 ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="GestionListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                <TemplateColumn Title="@Textos["ColumnaTrabajador"]" Sortable="true" SortBy="@(GridSort<GestionListaDto>.ByAscending(g => g.TrabajadorNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick="() => AbrirVistaRapida(context)">
                        @context.TrabajadorNombre
                    </button>
                </TemplateColumn>
                <TemplateColumn Title="@Textos["ColumnaCentro"]" Sortable="true" SortBy="@(GridSort<GestionListaDto>.ByAscending(g => g.CentroNombre))">
                    <button type="button" class="enlace-nombre-fila" @onclick="() => AbrirVistaRapida(context)">
                        @context.CentroNombre
                    </button>
                </TemplateColumn>
                <PropertyColumn Property="@(g => g.TipoDocumentoNombre)" Title="@Textos["ColumnaDocumento"]" Sortable="true" />
                <TemplateColumn Title="@Textos["ColumnaEstado"]" Align="Align.Center" Sortable="true" SortBy="@(GridSort<GestionListaDto>.ByAscending(g => g.Estado))">
                    <Badge Tono="@TonoEstado(context.Estado)">@TextoEstado(context.Estado)</Badge>
                </TemplateColumn>
                <PropertyColumn Property="@(g => g.CreadoEnUtc)" Format="dd/MM/yyyy" Title="@Textos["ColumnaCreada"]" Sortable="true" />
                <TemplateColumn Title="@Textos["ColumnaAcciones"]" Align="Align.End">
                    <MenuAcciones>
                        <SoloConEscritura><ItemMenuAccion OnClick="() => CambiarEstadoAsync(context.Id, context.Estado != EstadoGestion.Completada)">
                            @(context.Estado == EstadoGestion.Completada ? Textos["AccionReabrir"] : Textos["AccionMarcarCompletada"])
                        </ItemMenuAccion></SoloConEscritura>
                        <ItemMenuAccion OnClick="() => AbrirVistaRapida(context)">
                            @Textos["AccionVistaRapida"]
                        </ItemMenuAccion>
                        <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id)">
                            @Textos["AccionEliminar"]
                        </ItemMenuAccion></SoloConEscritura>
                    </MenuAcciones>
                </TemplateColumn>
            </QuickGrid>

            <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                              Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="CambiarPaginaAsync"
                              TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
        </div>

        @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
        {
            @* Distinto de "sin gestiones", y aquí el texto sin filtrar es
               además una explicación de cómo se generan: leída con "Completadas"
               puesto, hace creer que el mecanismo no funciona — cuando el cero
               solo dice que ninguna se ha completado todavía.

               El mockup dice «Hay gestiones en la cartera, pero ninguna
               coincide»: no se copia, porque el filtrado es de servidor y la
               consulta solo devuelve el total ya filtrado — esta pantalla no
               sabe si hay gestiones sin filtro. *@
            <EstadoVacio NombreIcono="filtro" Titulo="@Textos["VacioFiltrosTitulo"]"
                         Descripcion="@Textos["VacioFiltrosDescripcion"]">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
                </Accion>
            </EstadoVacio>
        }
        else if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="@Textos["VacioTitulo"]" Descripcion="@Textos["VacioDescripcion"]">
                <Accion>
                    @* /bandeja es «Mi trabajo» en el menú (NavMenu.razor). *@
                    <Boton Variante="VarianteBoton.Secundario" Href="bandeja">@Textos["BotonIrAMiTrabajo"]</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

@* Vista rápida (Gestiones TALVEG.dc.html). Antes el nombre del Trabajador y
   el del Centro abrían directamente su Context Workspace; ahora abren esto
   primero y los dos 360 quedan a un clic desde aquí — mismo patrón que
   Vehículos y Subcontratas.

   Todo sale de la FILA (GestionListaDto): no hay consulta por Id de Gestion,
   y así el panel no puede discrepar de la fila que tiene al lado. Frente al
   mockup faltan dos cosas que la fila no trae:
   - «Origen»: la Gestion guarda MensajeOrigenId, pero el DTO no lo expone.
     El mockup pone «Bandeja» a todas, y la ficha del Trabajador también las
     crea: pintarlo sería inventarlo.
   - «Por qué existe esta gestión»: la Gestion tiene Notas, que el DTO
     tampoco expone (el propio mockup lo marca como hueco).
   Y «Ver el documento» no se copia: la Gestion no referencia ningún
   Documento (Gestion.cs), solo su tipo. Lo que sí existe es la documentación
   del Trabajador, y a eso lleva el enlace. *@
@if (_vistaRapida is { } vista)
{
    <aside class="vista-rapida-gestion" role="complementary" aria-label="@Textos["AriaVistaRapida"]">
        <div class="cabecera-vista-rapida-gestion">
            <div class="texto-cabecera-vista-rapida-gestion">
                <span class="etiqueta-vista-rapida-gestion">@Textos["EtiquetaVistaRapida"]</span>
                <span class="nombre-vista-rapida-gestion">@vista.TrabajadorNombre</span>
                <span class="meta-vista-rapida-gestion">
                    <Badge Tono="@TonoEstado(vista.Estado)" Tamano="TamanoBadge.Pequeno">@TextoEstado(vista.Estado)</Badge>
                    <span>@Textos["VistaRapidaCreadaEl", vista.CreadoEnUtc.ToString("dd/MM/yyyy")]</span>
                </span>
            </div>
            <button type="button" class="boton-cerrar-vista-rapida-gestion" aria-label="@Textos["AriaCerrarVistaRapida"]" @onclick="CerrarVistaRapida"><Icono Nombre="cerrar" /></button>
        </div>

        <div class="cuerpo-vista-rapida-gestion">
            <div class="rejilla-vista-rapida-gestion">
                <div class="celda-vista-rapida-gestion"><span>@Textos["ColumnaCentro"]</span><strong>@vista.CentroNombre</strong></div>
                <div class="celda-vista-rapida-gestion"><span>@Textos["ColumnaDocumento"]</span><strong>@vista.TipoDocumentoNombre</strong></div>
                <div class="celda-vista-rapida-gestion"><span>@Textos["ColumnaCreada"]</span><strong>@vista.CreadoEnUtc.ToString("dd/MM/yyyy")</strong></div>
            </div>

            <div class="enlaces-vista-rapida-gestion">
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Trabajador, vista.TrabajadorId, vista.TrabajadorNombre, "informacion")'>
                    @Textos["EnlaceTrabajador360"]
                </button>
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Centro, vista.CentroId, vista.CentroNombre, "informacion")'>
                    @Textos["EnlaceCentro360"]
                </button>
                <button type="button" class="enlace-vista-rapida-gestion" @onclick='() => AbrirWorkspaceAsync(EntidadWorkspace.Trabajador, vista.TrabajadorId, vista.TrabajadorNombre, "documentacion")'>
                    @Textos["EnlaceDocumentacionTrabajador"]
                </button>
            </div>
        </div>

        <div class="pie-vista-rapida-gestion">
            <Boton Cargando="_cambiandoEstado.Contains(vista.Id)" OnClick="() => CambiarEstadoAsync(vista.Id, vista.Estado != EstadoGestion.Completada)">
                @(vista.Estado == EstadoGestion.Completada ? Textos["BotonReabrirGestion"] : Textos["AccionMarcarCompletada"])
            </Boton>
            <Boton Variante="VarianteBoton.Destructivo" Deshabilitado="_cambiandoEstado.Contains(vista.Id)" OnClick="() => AbrirEliminar(vista.Id)">@Textos["AccionEliminar"]</Boton>
        </div>
    </aside>
}

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@Textos["DialogoEliminarTitulo"]"
    Mensaje="@Textos["DialogoEliminarMensaje"]"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />
