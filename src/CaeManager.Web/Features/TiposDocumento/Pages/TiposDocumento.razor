@page "/tipos-documento"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inherits CaeManager.Web.Components.PaginaIntegrableConfiguracionBase
@using CaeManager.Application.TiposDocumento.Commands.CrearTipoDocumento
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.TiposDocumento.Recursos
@using CaeManager.Web.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosTiposDocumento> Textos
@inject IStringLocalizer<TextosComunes> Comunes

@if (!IntegradaEnConfiguracion)
{
    <PageTitle>@Textos["TituloPestana"] — @Marca.Nombre</PageTitle>
}

<div class="@ClaseContenedorPagina">
    <CabeceraPagina Titulo="@Textos["TituloCabecera"]" Integrada="@IntegradaEnConfiguracion">
        <Descripcion>
            @* El mockup remite los ajustes de Nivel 2 a «la configuración
               documental de cada cliente», una pantalla que no existe: lo único
               que se afina por cliente es la lectura IA, y lo que pide cada
               centro se decide en sus propios requisitos. *@
            <Badge Tamano="TamanoBadge.Pequeno">@Textos["BadgeNivelGlobal"]</Badge>
            @Textos["DescripcionAntesEnlace"]
            <a href="@RutaLecturaIaPorCliente">@Textos["EnlaceLecturaIaCliente"]</a>@Textos["DescripcionTrasEnlace"]
        </Descripcion>
        <Acciones>
            <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoTipo"]</Boton></SoloConEscritura>
        </Acciones>
    </CabeceraPagina>

    <div class="barra-filtros barra-filtros-tipos">
        <CampoTexto Placeholder="@Textos["PlaceholderBusqueda"]" aria-label="@Textos["AriaBusqueda"]"
                    Valor="@_terminoBusqueda" ValorChanged="BuscarAsync" />

        <CampoSelect Etiqueta="@Textos["FiltroCliente"]" Valor="@_clienteFiltroId" ValorChanged="CambiarClienteFiltroAsync">
            <option value="">@Textos["OpcionTodosClientes"]</option>
            @foreach (var cliente in _clientesFiltroDisponibles)
            {
                <option value="@cliente.Id">@cliente.RazonSocial</option>
            }
        </CampoSelect>

        <CampoSelect Etiqueta="@Textos["FiltroEmpresa"]" Valor="@_empresaFiltroId" ValorChanged="CambiarEmpresaFiltroAsync" Deshabilitado="@string.IsNullOrEmpty(_clienteFiltroId)">
            <option value="">@Textos["OpcionTodasEmpresas"]</option>
            @foreach (var empresa in _empresasFiltroDisponibles)
            {
                <option value="@empresa.Id">@empresa.RazonSocial</option>
            }
        </CampoSelect>

        <CampoSelect Etiqueta="@Textos["FiltroCentro"]" Valor="@_centroFiltroId" ValorChanged="CambiarCentroFiltroAsync" Deshabilitado="@string.IsNullOrEmpty(_empresaFiltroId)">
            <option value="">@Textos["OpcionTodosCentros"]</option>
            @foreach (var centro in _centrosFiltroDisponibles)
            {
                <option value="@centro.Id">@centro.Nombre</option>
            }
        </CampoSelect>
    </div>

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]">
            <Accion>
                <Boton OnClick="ReintentarAsync">@Comunes["Reintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando && !_listaPintada)
    {
        @* El esqueleto solo sale cuando no hay nada que enseñar: en la carga
           inicial y al reintentar tras un error. Al filtrar o al guardar la
           tabla se queda en su sitio, marcada como ocupada. *@
        <EstadoCargando Filas="6" />
    }
    else if (_tipos.Count == 0 && HayFiltrosActivos)
    {
        @* La tabla vacía no decía nada: con cuatro filtros puestos —búsqueda,
           cliente, empresa y centro— salían las cabeceras y ninguna fila, y
           quien acababa de escribir "TC2" mal no tenía forma de saber si el
           tipo no existe o si es el filtro. Ofrecerle "+ Nuevo tipo" ahí lo
           manda a duplicar un tipo de documento que ya está dado de alta.

           La copia no afirma que HAYA tipos: el filtrado es de servidor y la
           consulta devuelve solo el total ya filtrado. *@
        <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltrosTitulo"]"
                     Descripcion="@Textos["VacioFiltrosDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["BotonQuitarFiltros"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_tipos.Count == 0)
    {
        <EstadoVacio NombreIcono="tipos-documento" Titulo="@Textos["VacioCatalogoTitulo"]"
                     Descripcion="@Textos["VacioCatalogoDescripcion"]">
            <Accion>
                <SoloConEscritura><Boton OnClick="AbrirCrearAsync">@Textos["BotonNuevoTipo"]</Boton></SoloConEscritura>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

        <div class="tabla-tipos-marco" aria-busy="@(_cargando ? "true" : "false")">
            <table class="tabla-datos tabla-tipos">
                <thead>
                    <tr>
                        <th scope="col" class="col-orden">@Textos["ColumnaOrden"]</th>
                        <th scope="col">@Textos["ColumnaNombre"]</th>
                        <th scope="col" class="col-ambito">@Textos["ColumnaAmbito"]</th>
                        <th scope="col" class="col-vigencia">@Textos["ColumnaVigencia"]</th>
                        <th scope="col" class="col-vencimiento">@Textos["ColumnaVencimiento"]</th>
                        @* "Exigencia", no "Obligatorio": desde que EsObligatorio se
                           partió en Requerido × NaturalezaJuridica, esta celda ya no
                           responde sí/no — dice con qué autoridad se pide (obligación
                           legal, práctica del sector, requisito de cliente…). *@
                        <th scope="col" class="col-exigencia">@Textos["ColumnaExigencia"]</th>
                        <th scope="col" class="col-lectura">@Textos["ColumnaLecturaIa"]</th>
                        <th scope="col" class="col-deteccion">@Textos["ColumnaDeteccion"]</th>
                        <th scope="col" class="col-verificacion">@Textos["ColumnaVerificacion"]</th>
                        <th scope="col" class="col-oficial">@Textos["ColumnaOficial"]</th>
                        <th scope="col" class="col-acciones"><span class="solo-lectores">@Textos["ColumnaAcciones"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tipo in TiposDePagina)
                    {
                        <tr @key="tipo.Id" class="@ClaseFila(tipo.Id)">
                            <td class="celda-orden">@tipo.Orden</td>
                            <td>
                                <span class="nombre-tipo">@tipo.Nombre</span>
                                @if (tipo.Aliases.Count > 0)
                                {
                                    <span class="alias-tipo">@string.Join(", ", tipo.Aliases)</span>
                                }
                            </td>
                            <td>@TextoAmbito(tipo.AmbitoAplicacion)</td>
                            <td class="@(tipo.VigenciaMeses is null ? "celda-vigencia celda-sin-valor" : "celda-vigencia")">@TextoVigencia(tipo.VigenciaMeses)</td>
                            <td>
                                @if (tipo.AplicaVencimientoAutomatico)
                                {
                                    <Badge Tono="TonoBadge.Exito">@Textos["BadgeAfirmativo"]</Badge>
                                }
                                else
                                {
                                    <Badge>@Textos["BadgeNegativo"]</Badge>
                                }
                            </td>
                            <td>
                                @* El badge dice CON QUÉ AUTORIDAD se pide, no
                                   "Obligatorio" a secas: llamar obligación a
                                   una práctica del sector es exactamente lo
                                   que esta taxonomía existe para impedir. *@
                                <Badge Tono="@TonoExigencia(tipo.Requerido, tipo.Naturaleza)"
                                       title="@AyudaExigencia(tipo.Requerido, tipo.Naturaleza)">@TextoExigencia(tipo.Requerido, tipo.Naturaleza)</Badge>
                            </td>
                            <td>@CeldaInterruptor(tipo, CampoEnLinea.LecturaIa, Textos["NombreInterruptorLecturaIa"], AyudaLecturaIa)</td>
                            <td>
                                @if (tipo.AmbitoAplicacion == AmbitoAplicacion.Empresa)
                                {
                                    @CeldaInterruptor(tipo, CampoEnLinea.DeteccionTrabajadores, Textos["NombreInterruptorDeteccion"], AyudaDeteccionTrabajadores)
                                }
                                else
                                {
                                    <span class="celda-no-aplica">@Textos["CeldaNoAplica"]</span>
                                }
                            </td>
                            <td>
                                @if (tipo.AmbitoAplicacion == AmbitoAplicacion.Trabajador)
                                {
                                    @CeldaInterruptor(tipo, CampoEnLinea.VerificacionIa, Textos["NombreInterruptorVerificacion"], AyudaVerificacionIa)
                                }
                                else
                                {
                                    <span class="celda-no-aplica">@Textos["CeldaNoAplica"]</span>
                                }
                            </td>
                            <td>
                                @if (tipo.AmbitoAplicacion is AmbitoAplicacion.Empresa or AmbitoAplicacion.Cliente)
                                {
                                    var claveOficial = new ClaveCambio(tipo.Id, CampoEnLinea.DocumentoOficial);
                                    <div class="celda-oficial">
                                        <select @key="GeneracionDe(claveOficial)" class="select-oficial"
                                                title="@Textos["TooltipSelectOficial"]"
                                                aria-label="@Textos["AriaSelectOficial", tipo.Nombre]"
                                                value="@tipo.PerfilDocumentoOficial" disabled="@_pendientes.Contains(claveOficial)"
                                                @onchange="e => CambiarPerfilDocumentoOficialAsync(tipo.Id, e.Value?.ToString())">
                                            <option value="@PerfilDocumentoOficial.Ninguno">—</option>
                                            <option value="@PerfilDocumentoOficial.CorrienteTgss">@Textos["OpcionOficialTgss"]</option>
                                            <option value="@PerfilDocumentoOficial.CorrienteAeat">@Textos["OpcionOficialAeat"]</option>
                                            <option value="@PerfilDocumentoOficial.Ita">ITA</option>
                                            <option value="@PerfilDocumentoOficial.Rnt">RNT</option>
                                            <option value="@PerfilDocumentoOficial.Rlc">RLC</option>
                                        </select>
                                        @if (TextoAvisoCambio(claveOficial) is { } avisoOficial)
                                        {
                                            <span class="@ClaseAvisoCambio(claveOficial)">@avisoOficial</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="celda-no-aplica">@Textos["CeldaNoAplica"]</span>
                                }
                            </td>
                            <td class="celda-acciones">
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                       aria-label="@Textos["AriaEditar", tipo.Nombre]" OnClick="() => AbrirEditarAsync(tipo.Id)">
                                    @Textos["BotonEditar"]
                                </Boton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <PaginadorSimple PaginaActual="_pagina" TotalPaginas="TotalPaginas" TotalElementos="_tipos.Count"
                          Etiqueta="@Textos["EtiquetaPaginador"]" PaginaActualChanged="IrAPaginaAsync"
                          TamanoPagina="_tamanoPagina" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? Textos["DrawerTituloNuevo"].Value : Textos["DrawerTituloEditar"].Value)" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        <p class="nivel-drawer">@Textos["NivelDrawer"]</p>

        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        <CampoTexto Etiqueta="@Textos["EtiquetaNombre"]" Valor="@_nombre" ValorChanged="v => _nombre = v" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.Nombre))" />

        <div class="bloque-campo">
            @* Sin for= a propósito: los E2E piden GetByLabel("Nombre"), y un
               «Nombres alternativos» asociado al input casaría también. El input
               lleva su propio aria-label. *@
            <span class="etiqueta-campo">@Textos["EtiquetaAlias"] <span class="etiqueta-pista">@Textos["PistaAlias"]</span></span>
            <div class="fila-alias">
                <input class="input-alias" aria-label="@Textos["AriaAliasNuevo"]" placeholder="@Textos["PlaceholderAlias"]"
                       value="@_aliasNuevo" @oninput="e => _aliasNuevo = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="ManejarTeclaAliasAsync" />
                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="AgregarAlias">
                    @Textos["BotonAnadirAlias"]
                </Boton>
            </div>
            @if (_aliasesSeleccionados.Count > 0)
            {
                <div class="chips-filtros">
                    @foreach (var alias in _aliasesSeleccionados)
                    {
                        <span class="chip-filtro">
                            @alias
                            <button type="button" class="chip-filtro-quitar" @onclick="() => QuitarAlias(alias)" aria-label="@Textos["AriaQuitarAlias", alias]"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                        </span>
                    }
                </div>
            }
        </div>

        @if (_editandoId is null)
        {
            <CampoSelect Etiqueta="@Textos["EtiquetaAmbitoAplicacion"]" Valor="@_ambito.ToString()" ValorChanged="v => _ambito = Enum.Parse<AmbitoAplicacion>(v)">
                <option value="@nameof(AmbitoAplicacion.Trabajador)">@Textos["AmbitoTrabajador"]</option>
                <option value="@nameof(AmbitoAplicacion.Cliente)">@Textos["AmbitoCliente"]</option>
                <option value="@nameof(AmbitoAplicacion.Empresa)">@Textos["AmbitoEmpresa"]</option>
                <option value="@nameof(AmbitoAplicacion.Vehiculo)">@Textos["AmbitoVehiculo"]</option>
                <option value="@nameof(AmbitoAplicacion.Proyecto)">@Textos["AmbitoProyecto"]</option>
            </CampoSelect>
        }
        else
        {
            <div class="bloque-campo ambito-fijo">
                <span class="etiqueta-campo">@Textos["EtiquetaAmbitoAplicacion"]</span>
                <span class="ambito-fijo-valor">@TextoAmbito(_ambito)</span>
                <span class="pista-campo">@Textos["PistaAmbitoFijo"]</span>
            </div>
        }

        <div class="bloque-vencimiento">
            <label class="campo-checkbox">
                <input type="checkbox" @bind="_aplicaVencimientoAutomatico" /> @Textos["CheckVencimientoAutomatico"]
            </label>
            @if (_aplicaVencimientoAutomatico)
            {
                <div class="sangria-vigencia">
                    <CampoTexto Etiqueta="@Textos["EtiquetaVigenciaMeses"]" Type="number" Valor="@_vigenciaMeses" ValorChanged="v => _vigenciaMeses = v" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.VigenciaMeses))" />
                </div>
            }
        </div>

        <fieldset class="bloque-exigencia">
            <legend>@Textos["LeyendaExigencia"]</legend>
            <CampoSelect Etiqueta="@Textos["EtiquetaSePide"]" Valor="@_requerido.ToString()" ValorChanged="v => _requerido = Enum.Parse<RequisitoDocumental>(v)">
                <option value="@nameof(RequisitoDocumental.No)">@Textos["RequeridoNo"]</option>
                <option value="@nameof(RequisitoDocumental.Si)">@Textos["RequeridoSi"]</option>
                <option value="@nameof(RequisitoDocumental.Condicional)">@Textos["OpcionRequeridoCondicional"]</option>
            </CampoSelect>
            <CampoSelect Etiqueta="@Textos["EtiquetaAutoridad"]" Valor="@_naturaleza.ToString()" ValorChanged="v => _naturaleza = Enum.Parse<NaturalezaJuridica>(v)">
                <option value="@nameof(NaturalezaJuridica.ObligacionLegal)">@Textos["NaturalezaObligacionLegal"]</option>
                <option value="@nameof(NaturalezaJuridica.ObligacionCondicionada)">@Textos["NaturalezaObligacionCondicionada"]</option>
                <option value="@nameof(NaturalezaJuridica.PracticaSector)">@Textos["NaturalezaPracticaSector"]</option>
                <option value="@nameof(NaturalezaJuridica.RequisitoCliente)">@Textos["NaturalezaRequisitoCliente"]</option>
                <option value="@nameof(NaturalezaJuridica.Recomendacion)">@Textos["OpcionNaturalezaRecomendacion"]</option>
            </CampoSelect>
            <p class="vista-previa-exigencia">
                @Textos["VistaPreviaExigencia"]
                <Badge Tono="@TonoExigencia(_requerido, _naturaleza)">@TextoExigencia(_requerido, _naturaleza)</Badge>
            </p>
        </fieldset>

        <CampoTexto Etiqueta="@Textos["EtiquetaOrden"]" Type="number" Valor="@_orden" ValorChanged="v => _orden = v" />
        @if (_editandoId is null)
        {
            <p class="pista-campo pista-orden">@PistaOrden</p>
        }

        <CampoTextarea Etiqueta="@Textos["EtiquetaNotas"]" Valor="@_notas" ValorChanged="v => _notas = v" Filas="3" />
        <CampoTextarea Etiqueta="@Textos["EtiquetaDescripcion"]" Valor="@_descripcion" ValorChanged="v => _descripcion = v" Filas="3" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.Descripcion))" />
        <CampoTextarea Etiqueta="@Textos["EtiquetaCriterios"]" Valor="@_criteriosValidacion" ValorChanged="v => _criteriosValidacion = v" Filas="4" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.CriteriosValidacion))" />
        <p class="pista-campo pista-criterios">
            @Textos["PistaCriterios"]
        </p>
        <CampoTexto Etiqueta="@Textos["EtiquetaSeSolicitaA"]" Valor="@_seSolicitaA" ValorChanged="v => _seSolicitaA = v" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.SeSolicitaA))" />
        <CampoTextarea Etiqueta="@Textos["EtiquetaObservaciones"]" Valor="@_observaciones" ValorChanged="v => _observaciones = v" Filas="3" MensajeError="@ObtenerError(nameof(CrearTipoDocumentoCommand.Observaciones))" />

        @if (_ambito == AmbitoAplicacion.Trabajador)
        {
            @* El mockup rotula esto «vacío = aplica en todos». Solo es verdad
               cuando «¿Se pide?» es «Sí, siempre»: un centro sin fila propia
               sigue el valor general (ResolucionTipoDocumentoCentro.Aplica), así
               que con «No se pide» dejarlo vacío significa que no lo pide
               ninguno. El resumen de abajo dice lo que pasa de verdad. *@
            <div class="bloque-campo bloque-centros">
                <span class="etiqueta-campo">@Textos["EtiquetaCentrosExpresos"] <span class="etiqueta-pista">@Textos["PistaCentrosExpresos"]</span></span>
                @if (_centrosDisponibles.Count == 0)
                {
                    <p class="texto-vacio-seccion">@Textos["SinCentrosCreados"]</p>
                }
                else
                {
                    <div class="lista-centros">
                        @foreach (var centro in _centrosDisponibles)
                        {
                            <label class="opcion-centro">
                                <input type="checkbox"
                                       checked="@_centroIdsSeleccionados.Contains(centro.Id)"
                                       @onchange="e => AlternarCentro(centro.Id, e.Value is bool marcado && marcado)" />
                                <span class="opcion-centro-texto">
                                    <span>@centro.Nombre</span>
                                    <span class="opcion-centro-contexto">@centro.ClienteRazonSocial — @centro.EmpresaRazonSocial</span>
                                </span>
                            </label>
                        }
                    </div>
                    <p class="pista-campo resumen-centros">@ResumenCentros</p>
                }
            </div>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            @Textos["BotonCancelar"]
        </Boton>
        <Boton Cargando="_guardando" OnClick="GuardarAsync">
            @Textos["BotonGuardar"]
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion Visible="_confirmacionVisible"
                     VisibleChanged="v => _confirmacionVisible = v"
                     Titulo="@Textos["ConfirmacionTitulo"]"
                     Mensaje="@_mensajeConfirmacion"
                     TextoBotonConfirmar="@Textos["ConfirmacionBoton"]"
                     EnProgreso="_guardando"
                     OnConfirmar="ConfirmarGuardadoAsync" />

@code {
    /// <summary>
    /// Interruptor de una fila. Sigue siendo un <c>&lt;input type="checkbox"&gt;</c>
    /// —con <c>role="switch"</c> y aspecto de interruptor por CSS— y no un
    /// <c>&lt;button&gt;</c> como en el mockup: <c>FlujoCicloDocumentalTests</c>
    /// localiza la celda por su <c>title</c>, marca su <c>input</c> y espera a
    /// que el texto de la celda sea exactamente «Activa». Por eso el texto
    /// dice «Guardando…» mientras el comando viaja: «Activa» solo puede
    /// aparecer cuando ya está persistido.
    /// </summary>
    private RenderFragment CeldaInterruptor(TipoDocumentoListaDto tipo, CampoEnLinea campo, string nombre, string ayuda) => __builder =>
    {
        var clave = new ClaveCambio(tipo.Id, campo);
        var activa = ValorEnLinea(tipo, campo);
        var pendiente = _pendientes.Contains(clave);
        <label class="celda-interruptor" title="@ayuda">
            <input @key="GeneracionDe(clave)" type="checkbox" role="switch" class="interruptor-tipo"
                   aria-label="@Textos["AriaInterruptor", nombre, tipo.Nombre]"
                   checked="@activa" disabled="@pendiente"
                   @onchange="() => AlternarAsync(tipo.Id, campo)" />
            <span class="@ClaseAvisoCambio(clave)">@(TextoAvisoCambio(clave) ?? (activa ? Textos["InterruptorActivo"].Value : Textos["InterruptorInactivo"].Value))</span>
        </label>
    };
}
