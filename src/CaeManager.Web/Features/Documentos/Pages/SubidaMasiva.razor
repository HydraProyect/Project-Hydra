@page "/documentos/subida-masiva"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae},{CaeManager.Infrastructure.Identity.Roles.GestorCae},{CaeManager.Infrastructure.Identity.Roles.Consulta}")]
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Subida múltiple — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina subida-masiva">
    <nav class="miga-subida-masiva" aria-label="Miga de pan">
        <a href="/documentos">Documentos</a><span aria-hidden="true">/</span><span aria-current="page">Subida múltiple</span>
    </nav>
    <CabeceraPagina Titulo="Subida múltiple de documentos" Kicker="Ciclo documental">
        <Descripcion>Arrastra o selecciona varios archivos (PDF, JPG, PNG, Word) o un único .zip con varios dentro. Solo documentos de Trabajador. Detectamos automáticamente el trabajador y el tipo de documento de cada archivo; si estamos muy seguros, se crea directamente; si no, queda abajo para confirmar.</Descripcion>
        <Acciones><a class="enlace-exportar" href="/documentos/importar">Importar desde Excel</a><a class="enlace-exportar" href="/documentos/revision-ia">Revisión IA →</a></Acciones>
    </CabeceraPagina>

    @if (_esSoloLectura)
    {
        <EstadoVacio
            Titulo="Solo lectura"
            Descripcion="Tu rol de Consulta permite ver este flujo, pero no crear documentos desde aquí."
            NombreIcono="seguridad" />
    }
    else
    {
        <section class="zona-subida-masiva" aria-label="Seleccionar archivos">
            <Icono Nombre="adjunto" Tamano="TamanoIcono.Grande" />
            <h2>Arrastra aquí los documentos de trabajador</h2>
            <p>PDF · JPG · PNG · DOCX · ZIP — hasta 60 archivos, 10 MB cada uno</p>
            <ZonaSoltarArchivo Titulo="Seleccionar archivos" OnChange="ManejarArchivosSeleccionadosAsync" Multiple="true" Accept=".pdf,.jpg,.jpeg,.png,.docx,.zip" FormatosTexto="PDF · JPG · PNG · DOCX · ZIP" Cargando="_procesandoLote" />
            <span class="aviso-memoria-subida">Nada se guarda hasta que el archivo se resuelve o lo confirmas.</span>
        </section>
    }

    @if (_items.Count > 0)
    {
        <section class="progreso-subida-masiva" aria-label="Progreso del lote">
            <div class="progreso-subida-masiva-cabecera"><strong>@ArchivosLeidos de @TotalRecibidos archivos leídos</strong><span>@(HayArchivosEnCurso ? $"{ArchivosEnCurso} en curso — puedes resolver los ambiguos mientras tanto" : "Lote terminado")</span></div>
            <div class="barra-progreso-subida" role="progressbar" aria-valuemin="0" aria-valuemax="@TotalRecibidos" aria-valuenow="@ArchivosLeidos"><span style="width: @PorcentajeProgreso%"></span></div>
            <div class="resumen-subida-masiva">
                <Badge Tono="TonoBadge.Exito">@TotalCreados creados</Badge><Badge Tono="TonoBadge.Advertencia">@TotalPendientes pendiente(s) por confirmar</Badge><Badge Tono="TonoBadge.Neutro">@TotalDescartados descartados</Badge><Badge Tono="TonoBadge.Peligro">@TotalErrores con error</Badge>
                <span class="ayuda-auto-creacion">Se crean solos los que la IA resuelve con 95 % o más de confianza.</span>
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="LimpiarResueltos">Limpiar creados y descartados</Boton>
            </div>
        </section>
        <section class="panel-lote-subida-masiva" aria-label="Archivos del lote">
            <header><span>Archivos del lote</span>@foreach (var filtro in Filtros) { <button type="button" class="@(filtro.Valor == _filtro ? "filtro-lote activo" : "filtro-lote")" aria-pressed="@(filtro.Valor == _filtro)" @onclick="() => _filtro = filtro.Valor">@filtro.Etiqueta</button> }</header>
            @if (ItemsFiltrados.Count == 0)
            { <div class="estado-vacio-lote"><h2>Ningún archivo con este filtro</h2><p>El lote tiene archivos, pero ninguno en ese estado.</p><Boton Variante="VarianteBoton.Secundario" OnClick="() => _filtro = FiltroTodos">Ver todos</Boton></div> }
            else
            {
                <ul class="lista-items-subida-masiva">
                    @foreach (var item in ItemsFiltrados)
                    {
                        <li @key="item.ClaveLocal" class="item-subida-masiva">
                            <div class="item-subida-masiva-fila">
                                @if (item.MiniaturaBase64 is not null) { <img class="miniatura-subida-masiva" src="@($"data:image/png;base64,{item.MiniaturaBase64}")" alt="Miniatura de @item.NombreArchivo" /> }
                                else { <div class="miniatura-subida-masiva miniatura-subida-masiva-vacia"><Icono Nombre="documentos" /></div> }
                                <div class="item-subida-masiva-info"><span class="item-subida-masiva-nombre">@item.NombreArchivo</span><div class="item-subida-masiva-badges"><Badge Tono="@ObtenerTonoEstado(item.Estado)">@ObtenerEtiquetaEstado(item)</Badge>@if (item.Confianza is { } confianza) { <Badge Tono="@TonoConfianza(confianza)">@confianza% confianza IA</Badge> }</div>@if (item.MensajeError is not null) { <span class="item-subida-masiva-error">@item.MensajeError</span> }</div>
                                <div class="item-subida-masiva-acciones">
                                    @if (!_esSoloLectura && item.Estado == EstadoItem.PendienteConfirmar) { <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="() => AlternarExpandido(item)">@(item.Expandido ? "Ocultar" : "Confirmar…")</Boton><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => Descartar(item)">Descartar</Boton> }
                                    else if (item.Estado is EstadoItem.Error or EstadoItem.Descartado) { <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => QuitarDeLaLista(item)">Quitar de la lista</Boton> }
                                </div>
                            </div>
                            @if (!_esSoloLectura && item.Expandido && item.Estado == EstadoItem.PendienteConfirmar)
                            {
                                <div class="item-subida-masiva-confirmacion">
                                    @if (item.ContenidoPdf is not null) { <iframe class="previsualizacion-documento" src="@ConstruirDataUriPdf(item.ContenidoPdf)" title="Vista previa de @item.NombreArchivo"></iframe> }
                                    <div class="item-subida-masiva-formulario">
                                        <CampoBuscarSelect Etiqueta="Trabajador" Marcador="Escribe un nombre o DNI para buscar…" Valor="@item.TrabajadorId" ValorChanged="v => item.TrabajadorId = v" Opciones="@OpcionesTrabajadores" />
                                        <CampoSelect Etiqueta="Tipo de documento" Valor="@item.TipoDocumentoId" ValorChanged="v => item.TipoDocumentoId = v"><option value="">Selecciona un tipo de documento…</option>@foreach (var tipo in _tiposDisponibles) { <option value="@tipo.Id">@tipo.Nombre</option> }</CampoSelect>
                                        <CampoTexto Etiqueta="Fecha de emisión" Type="date" Valor="@item.FechaEmision" ValorChanged="v => item.FechaEmision = v" />
                                        @if (RequiereVencimientoManual(item)) { <CampoTexto Etiqueta="Fecha de vencimiento" Type="date" Valor="@item.FechaVencimientoManual" ValorChanged="v => item.FechaVencimientoManual = v" /> }
                                        <div class="acciones-formulario"><Boton Cargando="@item.Confirmando" OnClick="() => ConfirmarAsync(item)">Confirmar y crear</Boton></div>
                                    </div>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    }
    else if (_procesandoLote)
    { <section class="esqueleto-lote-subida-masiva" aria-busy="true" aria-label="Procesando el lote"><span>Convirtiendo a PDF y leyendo cada archivo…</span>@for (var i = 0; i < 5; i++) { <div></div> }</section> }
</div>
