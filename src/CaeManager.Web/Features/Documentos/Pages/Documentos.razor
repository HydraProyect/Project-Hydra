@page "/documentos"
@rendermode InteractiveServer
@using CaeManager.Application.Documentos.Commands.CrearDocumento
@using CaeManager.Application.Documentos.Commands.EliminarDocumento
@using CaeManager.Application.Documentos.Commands.RenovarDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculosParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject IFileStorageService AlmacenamientoArchivos
@inject IConversorWordPdfService ConversorWordPdf
@inject ContextWorkspaceService WorkspaceService
@inject ILogger<Documentos> Logger

<PageTitle>Documentos — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Documentos</h1>
        <div class="acciones-cabecera">
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                <a class="enlace-exportar" href="/documentos/importar">Importar documentos</a>
            </AuthorizeView>
            <a class="enlace-exportar" href="/documentos/subida-masiva">Subida múltiple</a>
            <Boton OnClick="AbrirCrearAsync">+ Nuevo documento</Boton>
        </div>
    </div>

    <div class="barra-filtros">
        <CampoTexto Placeholder="Buscar por propietario o tipo de documento…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
        <CampoSelect Etiqueta="Ámbito" Valor="@_ambitoFiltro" ValorChanged="CambiarAmbitoFiltroAsync">
            <option value="">Todos</option>
            <option value="@nameof(AmbitoAplicacion.Trabajador)">Trabajador</option>
            <option value="@nameof(AmbitoAplicacion.Cliente)">Cliente</option>
            <option value="@nameof(AmbitoAplicacion.Empresa)">Empresa</option>
            <option value="@nameof(AmbitoAplicacion.Vehiculo)">Vehículo</option>
            <option value="@nameof(AmbitoAplicacion.Proyecto)">Proyecto</option>
        </CampoSelect>
        <CampoSelect Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoFiltroAsync">
            <option value="">Todos</option>
            <option value="@nameof(EstadoDocumento.Vencido)">Vencido</option>
            <option value="@nameof(EstadoDocumento.Urgente)">Urgente</option>
            <option value="@nameof(EstadoDocumento.Proximo)">Próximo</option>
            <option value="@nameof(EstadoDocumento.Vigente)">Vigente</option>
            <option value="@nameof(EstadoDocumento.NoAplica)">No aplica</option>
        </CampoSelect>
        @if (_filtrosGuardados.Count > 0)
        {
            <CampoSelect Etiqueta="" Valor="" ValorChanged="AplicarFiltroGuardadoAsync">
                <option value="">Filtros guardados…</option>
                @foreach (var filtro in _filtrosGuardados)
                {
                    <option value="@filtro.Id">@filtro.Nombre</option>
                }
            </CampoSelect>
        }
        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _mostrarGuardarFiltro = true">
            Guardar filtro
        </Boton>
    </div>

    <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

    @if (_errorCarga)
    {
        <EstadoVacio Titulo="No pudimos cargar los documentos" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="RecargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
            <QuickGrid @ref="_grid" TGridItem="DocumentoListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                <TemplateColumn Title="" Align="Align.Center">
                    <HeaderTemplate Context="columna">
                        <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                    </HeaderTemplate>
                    <ChildContent>
                        <input type="checkbox" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                    </ChildContent>
                </TemplateColumn>
                <PropertyColumn Property="@(d => d.PropietarioNombre)" Title="Propietario" Sortable="true" />
                <TemplateColumn Title="Ámbito">
                    <Badge>@context.Ambito</Badge>
                </TemplateColumn>
                <PropertyColumn Property="@(d => d.TipoDocumentoNombre)" Title="Tipo de documento" />
                <PropertyColumn Property="@(d => d.FechaEmision)" Format="dd/MM/yyyy" Title="Emisión" />
                <TemplateColumn Title="Vencimiento">
                    @(context.FechaVencimiento is null ? "—" : context.FechaVencimiento.Value.ToString("dd/MM/yyyy"))
                </TemplateColumn>
                <TemplateColumn Title="Estado">
                    <Badge Tono="EstadoDocumentoUi.Tono(context.Estado)">@EstadoDocumentoUi.Texto(context.Estado)</Badge>
                </TemplateColumn>
                <TemplateColumn Title="Archivo">
                    @if (context.ArchivoUrl is not null)
                    {
                        <a href="/documentos/@context.Id/archivo" target="_blank">Ver PDF</a>
                    }
                    else
                    {
                        <span class="detalle-tecnico">Sin adjunto</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Acciones" Align="Align.End">
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Documento, context.Id, context.TipoDocumentoNombre, "informacion")'>
                        Ver
                    </Boton>
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEditarAsync(context.Id)">
                        Renovar
                    </Boton>
                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirEliminar(context.Id, context.PropietarioNombre, context.TipoDocumentoNombre)">
                        Eliminar
                    </Boton>
                </TemplateColumn>
            </QuickGrid>

            <div class="paginador">
                <Paginator State="_paginacion" />
            </div>
        </div>

        @if (_totalElementos == 0 && !_cargando)
        {
            <EstadoVacio Titulo="Aún no hay documentos" Descripcion="Sube el primero para empezar a controlar vigencias.">
                <Accion>
                    <Boton OnClick="AbrirCrearAsync">+ Nuevo documento</Boton>
                </Accion>
            </EstadoVacio>
        }
    }
</div>

<Drawer Visible="_drawerVisible" VisibleChanged="CerrarDrawerAsync" Titulo="@(_editandoId is null ? "Nuevo documento" : "Renovar documento")" CerrarAlHacerClicFuera="@(_mensajeErrorFormulario is null && _erroresCampo.Count == 0 && !_guardando)">
    <ChildContent>
        @if (_mensajeErrorFormulario is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeErrorFormulario</div>
        }

        @if (_editandoId is null)
        {
            <CampoSelect Etiqueta="¿A quién pertenece?" Valor="@_ambitoAplicacion" ValorChanged="CambiarAmbitoAsync">
                <option value="@nameof(AmbitoAplicacion.Trabajador)">Trabajador</option>
                <option value="@nameof(AmbitoAplicacion.Cliente)">Cliente</option>
                <option value="@nameof(AmbitoAplicacion.Empresa)">Empresa</option>
                <option value="@nameof(AmbitoAplicacion.Vehiculo)">Vehículo</option>
                <option value="@nameof(AmbitoAplicacion.Proyecto)">Proyecto</option>
            </CampoSelect>

            @if (_ambitoAplicacion == nameof(AmbitoAplicacion.Trabajador))
            {
                <CampoBuscarSelect
                    Etiqueta="Trabajador"
                    Marcador="Escribe un nombre o DNI para buscar…"
                    Valor="@_trabajadorId"
                    ValorChanged="CambiarTrabajadorSeleccionado"
                    Opciones="@OpcionesTrabajadores" />
                @if (_detectandoCampos)
                {
                    <span class="detalle-tecnico">Leyendo el archivo para sugerir trabajador y tipo de documento…</span>
                }
                @if (_aliasSugerido is not null)
                {
                    <div class="workspace-nota-contextual">
                        El documento identifica a este trabajador como "@_aliasSugerido", que no coincide con su nombre registrado.
                        <div class="workspace-tarjeta-requisito-acciones">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _aliasSugerido = null" Deshabilitado="_asignandoAliasSugerido">
                                Descartar
                            </Boton>
                            <Boton Tamano="TamanoBoton.Pequeno" OnClick="AceptarAliasSugeridoAsync" Cargando="_asignandoAliasSugerido">
                                Añadir como alias
                            </Boton>
                        </div>
                    </div>
                }
            }
            else if (_ambitoAplicacion == nameof(AmbitoAplicacion.Cliente))
            {
                <CampoSelect Etiqueta="Cliente" Valor="@_clienteId" ValorChanged="v => _clienteId = v">
                    <option value="">Selecciona un cliente…</option>
                    @foreach (var cliente in _clientesDisponibles)
                    {
                        <option value="@cliente.Id">@cliente.RazonSocial</option>
                    }
                </CampoSelect>
            }
            else if (_ambitoAplicacion == nameof(AmbitoAplicacion.Empresa))
            {
                <CampoSelect Etiqueta="Empresa" Valor="@_empresaId" ValorChanged="v => _empresaId = v">
                    <option value="">Selecciona una empresa…</option>
                    @foreach (var empresa in _empresasDisponibles)
                    {
                        <option value="@empresa.Id">@empresa.RazonSocial</option>
                    }
                </CampoSelect>
            }
            else if (_ambitoAplicacion == nameof(AmbitoAplicacion.Vehiculo))
            {
                <CampoSelect Etiqueta="Vehículo" Valor="@_vehiculoId" ValorChanged="v => _vehiculoId = v">
                    <option value="">Selecciona un vehículo…</option>
                    @foreach (var vehiculo in _vehiculosDisponibles)
                    {
                        <option value="@vehiculo.Id">@vehiculo.Nombre (@vehiculo.NumeroPlaca)</option>
                    }
                </CampoSelect>
            }
            else
            {
                <CampoSelect Etiqueta="Proyecto" Valor="@_proyectoId" ValorChanged="v => _proyectoId = v">
                    <option value="">Selecciona un proyecto…</option>
                    @foreach (var proyecto in _proyectosDisponibles)
                    {
                        <option value="@proyecto.Id">@proyecto.Nombre (@proyecto.ClienteRazonSocial — @proyecto.CentroNombre)</option>
                    }
                </CampoSelect>
            }

            @if (_tiposDisponibles.Count == 0)
            {
                <p class="texto-vacio-seccion">Todavía no hay ningún tipo de documento de este ámbito — créalo primero desde Tipos de Documento.</p>
            }
            else
            {
                <CampoSelect Etiqueta="Tipo de documento" Valor="@_tipoDocumentoId" ValorChanged="CambiarTipoDocumento">
                    <option value="">Selecciona un tipo de documento…</option>
                    @foreach (var tipo in _tiposDisponibles)
                    {
                        <option value="@tipo.Id">@tipo.Nombre</option>
                    }
                </CampoSelect>
            }
        }
        else
        {
            <div class="campo">
                <label>Ámbito</label>
                <span>@_ambitoAplicacion</span>
            </div>
            <div class="campo">
                <label>Propietario</label>
                <span>@_propietarioNombreSoloLectura</span>
            </div>
            <div class="campo">
                <label>Tipo de documento</label>
                <span>@_tipoDocumentoNombreSoloLectura</span>
            </div>
        }

        @if (TieneGlosario)
        {
            <div class="glosario-tipo-documento">
                @if (!string.IsNullOrWhiteSpace(_glosarioDescripcion))
                {
                    <p><strong>Descripción:</strong> @_glosarioDescripcion</p>
                }
                @if (!string.IsNullOrWhiteSpace(_glosarioCriteriosValidacion))
                {
                    <p><strong>Criterios de validación:</strong> @_glosarioCriteriosValidacion</p>
                }
                @if (!string.IsNullOrWhiteSpace(_glosarioSeSolicitaA))
                {
                    <p><strong>Se solicita a:</strong> @_glosarioSeSolicitaA</p>
                }
                @if (!string.IsNullOrWhiteSpace(_glosarioObservaciones))
                {
                    <p><strong>Observaciones:</strong> @_glosarioObservaciones</p>
                }
            </div>
        }

        <CampoTexto Etiqueta="Fecha de emisión" Type="date" Valor="@_fechaEmision" ValorChanged="v => _fechaEmision = v" />

        @if (RequiereVencimientoManual)
        {
            <div class="campo-con-boton">
                <CampoTexto Etiqueta="Fecha de vencimiento" Type="date" Valor="@_fechaVencimientoManual" ValorChanged="v => _fechaVencimientoManual = v" />
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="CopiarFechaEmisionAVencimiento">
                    Copiar fecha de emisión
                </Boton>
            </div>
            <p class="texto-vacio-seccion">Este tipo de documento no calcula el vencimiento automáticamente — indícalo a mano.</p>
        }

        <div class="campo">
            <label>Archivo (PDF, JPG, PNG o Word, máx. 10 MB por archivo)</label>
            <InputFile OnChange="ManejarArchivoSeleccionadoAsync" multiple accept=".pdf,application/pdf,.jpg,.jpeg,.png,image/jpeg,image/png,.docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            <p class="texto-vacio-seccion">Puedes seleccionar varios archivos a la vez (p. ej. varias fotos) — se combinan automáticamente en un solo PDF.</p>
            @if (_subiendoArchivo)
            {
                <span class="detalle-tecnico">Procesando…</span>
            }
            else if (_archivoUrl is not null)
            {
                <span class="detalle-tecnico">Archivo adjuntado correctamente.</span>
            }
        </div>

        <CampoTextarea Etiqueta="Comentarios" Valor="@_comentarios" ValorChanged="v => _comentarios = v" Filas="3" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardando" OnClick="() => CerrarDrawerAsync(false)">
            Cancelar
        </Boton>
        <Boton Deshabilitado="_subiendoArchivo" Cargando="_guardando" OnClick="GuardarAsync">
            Guardar
        </Boton>
    </Pie>
</Drawer>

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar este documento?")"
    Mensaje="@($"{_tipoDocumentoAEliminar} de {_propietarioAEliminar} se ocultará de las listas activas. Podrás recuperarlo desde Auditoría.")"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<DialogoConfirmacion
    Visible="_confirmarVigenciaAnteriorVisible"
    VisibleChanged="v => _confirmarVigenciaAnteriorVisible = v"
    Titulo="La nueva fecha de emisión es anterior a la actual"
    Mensaje="El documento que estás subiendo tiene una vigencia anterior a la del que ya estaba registrado — comprueba que sea el archivo correcto antes de continuar."
    TextoBotonConfirmar="Continuar de todas formas"
    EnProgreso="_procesandoConfirmacionVigencia"
    OnConfirmar="ConfirmarGuardarConVigenciaAnteriorAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} documento(s)?")"
    Mensaje="Se ocultarán de las listas activas. Podrás recuperarlos desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<Modal Visible="_mostrarGuardarFiltro" VisibleChanged="v => _mostrarGuardarFiltro = v" Titulo="Guardar filtro actual" CerrarAlHacerClicFuera="!_guardandoFiltro">
    <ChildContent>
        <CampoTexto Etiqueta="Nombre" Valor="@_nombreFiltroNuevo" ValorChanged="v => _nombreFiltroNuevo = v" Placeholder="Vencidos de trabajadores" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoFiltro" OnClick="() => _mostrarGuardarFiltro = false">Cancelar</Boton>
        <Boton Cargando="_guardandoFiltro" OnClick="GuardarFiltroActualAsync">Guardar</Boton>
    </Pie>
</Modal>
