@page "/documentos"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Application.Documentos.Commands.CrearDocumento
@using CaeManager.Application.Documentos.Commands.EliminarDocumento
@using CaeManager.Application.Documentos.Commands.RenovarDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculosParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject IFileStorageService AlmacenamientoArchivos
@inject IConversorWordPdfService ConversorWordPdf
@inject ContextWorkspaceService WorkspaceService
@inject ILogger<Documentos> Logger

<PageTitle>Documentos — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @*
        Cabecera Gen 2: el mockup pone sobre el título el antetítulo del ciclo
        al que pertenece la pantalla. "Exportar a Excel" no está en el mockup y
        se queda: un mockup omite comportamiento, no lo deroga.
    *@
    <CabeceraPagina Titulo="Documentos" Kicker="Ciclo documental">
        <Descripcion>
            Controla la vigencia y la disponibilidad documental por titular documental. La vista inicial prioriza lo que requiere atención.
        </Descripcion>
        <Acciones>
            <a class="enlace-exportar" href="/documentos/exportar.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Exportar a Excel</a>
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                <a class="enlace-exportar" href="/documentos/importar">Importar documentos</a>
            </AuthorizeView>
            <SoloConEscritura><a class="enlace-exportar" href="/documentos/subida-masiva">Subida múltiple</a></SoloConEscritura>
            <SoloConEscritura><Boton OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton></SoloConEscritura>
        </Acciones>
    </CabeceraPagina>

    <Pestanas Definiciones="PestanasDocumentos" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestana" EtiquetaGrupo="Secciones de documentos">
        @if (_pestanaActiva == "plataforma")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <PlataformaTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Plataformas CAE" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "reclamaciones")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <ReclamacionesTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Reclamaciones" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "sugerencias")
        {
            <SugerenciasPreventivasTab />
        }
        else if (_pestanaActiva == "revision-ia")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <RevisionIaTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Revisión IA" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "plantillas")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <PlantillasTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Plantillas" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else
        {
            <section class="control-documental" aria-label="Control de la lista documental">
                <div class="control-documental-contexto">
                    <div>
                        <h2>Prioridad documental</h2>
                        <p>Filtra primero las vigencias que requieren una decisión; después, acota por titular documental, ámbito o tipo.</p>
                    </div>
                    <div class="control-documental-estado" role="group" aria-label="Filtrar por estado documental">
                        <button type="button" class="filtro-estado filtro-estado-todos @(_estadoFiltro.Length == 0 ? "filtro-estado-activo" : null)" aria-pressed="@(_estadoFiltro.Length == 0 ? "true" : "false")" @onclick="() => CambiarEstadoFiltroAsync(string.Empty)">Todos</button>
                        <button type="button" class="filtro-estado filtro-estado-vencido @(_estadoFiltro == nameof(EstadoDocumento.Vencido) ? "filtro-estado-activo" : null)" aria-pressed="@(_estadoFiltro == nameof(EstadoDocumento.Vencido) ? "true" : "false")" @onclick="() => CambiarEstadoFiltroAsync(nameof(EstadoDocumento.Vencido))">Vencidos</button>
                        <button type="button" class="filtro-estado filtro-estado-urgente @(_estadoFiltro == nameof(EstadoDocumento.Urgente) ? "filtro-estado-activo" : null)" aria-pressed="@(_estadoFiltro == nameof(EstadoDocumento.Urgente) ? "true" : "false")" @onclick="() => CambiarEstadoFiltroAsync(nameof(EstadoDocumento.Urgente))">Urgentes</button>
                        <button type="button" class="filtro-estado filtro-estado-proximo @(_estadoFiltro == nameof(EstadoDocumento.Proximo) ? "filtro-estado-activo" : null)" aria-pressed="@(_estadoFiltro == nameof(EstadoDocumento.Proximo) ? "true" : "false")" @onclick="() => CambiarEstadoFiltroAsync(nameof(EstadoDocumento.Proximo))">Próximos</button>
                        <button type="button" class="filtro-estado filtro-estado-vigente @(_estadoFiltro == nameof(EstadoDocumento.Vigente) ? "filtro-estado-activo" : null)" aria-pressed="@(_estadoFiltro == nameof(EstadoDocumento.Vigente) ? "true" : "false")" @onclick="() => CambiarEstadoFiltroAsync(nameof(EstadoDocumento.Vigente))">Vigentes</button>
                    </div>
                </div>

                <div class="barra-filtros barra-filtros-documentos">
                    <CampoTexto Placeholder="Buscar por titular documental o tipo…" aria-label="Buscar por titular documental o tipo de documento" Valor="@_busqueda" ValorChanged="BuscarAsync" />
                <CampoSelect Etiqueta="Ámbito" Valor="@_ambitoFiltro" ValorChanged="CambiarAmbitoFiltroAsync">
                    <option value="">Todos</option>
                    <option value="@nameof(AmbitoAplicacion.Trabajador)">Trabajador</option>
                    <option value="@nameof(AmbitoAplicacion.Cliente)">Cliente</option>
                    <option value="@nameof(AmbitoAplicacion.Empresa)">Empresa</option>
                    <option value="@nameof(AmbitoAplicacion.Vehiculo)">Vehículo</option>
                    <option value="@nameof(AmbitoAplicacion.Proyecto)">Proyecto</option>
                </CampoSelect>
                <CampoSelect Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoFiltroAsync">
                    <option value="">Todos</option>
                    <option value="@nameof(EstadoDocumento.Vencido)">Vencido</option>
                    <option value="@nameof(EstadoDocumento.Urgente)">Urgente</option>
                    <option value="@nameof(EstadoDocumento.Proximo)">Próximo</option>
                    <option value="@nameof(EstadoDocumento.Vigente)">Vigente</option>
                    <option value="@nameof(EstadoDocumento.SinCaducidad)">Sin caducidad</option>
                </CampoSelect>
                @if (_filtrosGuardados.Count > 0)
                {
                    <CampoSelect Etiqueta="" Valor="" ValorChanged="AplicarFiltroGuardadoAsync">
                        <option value="">Filtros guardados…</option>
                        @foreach (var filtro in _filtrosGuardados)
                        {
                            <option value="@filtro.Id">@filtro.Nombre</option>
                        }
                    </CampoSelect>
                }
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _mostrarGuardarFiltro = true">
                    Guardar filtro
                </Boton>
                </div>
            </section>

            <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

            @if (_errorCarga)
            {
                <EstadoVacio Titulo="No pudimos cargar los documentos" Descripcion="Intenta nuevamente en unos segundos.">
                    <Accion>
                        <Boton OnClick="RecargarAsync">Reintentar</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else
            {
                <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple" />

                <div class="marco-lista-documentos" style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")" aria-busy="@(_cargando ? "true" : "false")">
                    <div class="cabecera-lista-documentos">
                        <div>
                            <h2>Documentos registrados</h2>
                            <p>Ordenados por prioridad de vigencia. Puedes ordenar cualquier columna para revisar un conjunto concreto.</p>
                        </div>
                        @if (_totalConocido is { } total)
                        {
                            <span class="resultado-documental" aria-live="polite">@total @(total == 1 ? "documento" : "documentos")</span>
                        }
                    </div>
                    <div class="tabla-documentos-desplazable">
                    <QuickGrid @ref="_grid" TGridItem="DocumentoListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos tabla-documentos" RowClass="ObtenerClaseFila">
                        @if (_seleccionMultiple)
                        {
                            <TemplateColumn Title="" Align="Align.Center">
                                <HeaderTemplate Context="columna">
                                    <input type="checkbox" aria-label="Seleccionar los documentos de esta página" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                                </HeaderTemplate>
                                <ChildContent>
                                    <input type="checkbox" aria-label="@($"Seleccionar {context.TipoDocumentoNombre} de {context.PropietarioNombre}, emisión {context.FechaEmision:dd/MM/yyyy}")" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                                </ChildContent>
                            </TemplateColumn>
                        }
                        <TemplateColumn Title="Titular documental" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.PropietarioNombre))">
                            <span class="documento-titular">@context.PropietarioNombre</span>
                            <span class="documento-contexto">@context.Ambito</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Documento" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.TipoDocumentoNombre))">
                            <span class="documento-tipo">@context.TipoDocumentoNombre</span>
                            <span class="documento-contexto">Emitido el @context.FechaEmision.ToString("dd/MM/yyyy")</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Vigencia" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.Estado))">
                            <Badge Tono="EstadoDocumentoUi.Tono(context.Estado)" ConIcono>@EstadoDocumentoUi.Texto(context.Estado)</Badge>
                            @* Sin FechaEmision: fuera de Detección/Revisión IA solo la vigencia es
                               copiable (P9, 2026-09-18); la emisión ya tiene su propia columna arriba,
                               sin Alt+clic. *@
                            <span class="documento-contexto"><TextoFechaCopiable Fecha="context.FechaVencimiento">@(context.FechaVencimiento is null ? "Sin vencimiento" : $"Vence el {context.FechaVencimiento.Value:dd/MM/yyyy}")</TextoFechaCopiable></span>
                        </TemplateColumn>
                        <TemplateColumn Title="Plataformas CAE">
                            @if (context.Acreditaciones.Count == 0)
                            {
                                <span class="detalle-tecnico">—</span>
                            }
                            else
                            {
                                <BadgesAcreditacion Acreditaciones="context.Acreditaciones" />
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Archivo y acciones" Align="Align.End">
                            @if (context.ArchivoUrl is not null)
                            {
                                <a href="/documentos/@context.Id/archivo" target="_blank">Ver PDF</a>
                            }
                            else
                            {
                                <span class="detalle-tecnico">Sin adjunto</span>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Align="Align.End">
                            <MenuAcciones>
                                <ItemMenuAccion OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Documento, context.Id, context.TipoDocumentoNombre, "informacion")'>
                                    Ver
                                </ItemMenuAccion>
                                <SoloConEscritura><ItemMenuAccion OnClick="() => _drawerGestion.AbrirEditarAsync(context.Id)">
                                    Renovar
                                </ItemMenuAccion></SoloConEscritura>
                                <SoloConEscritura><ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.PropietarioNombre, context.TipoDocumentoNombre)">
                                    Eliminar
                                </ItemMenuAccion></SoloConEscritura>
                            </MenuAcciones>
                        </TemplateColumn>
                    </QuickGrid>
                    </div>

                    <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                      Etiqueta="documento(s)" PaginaActualChanged="CambiarPaginaAsync"
                                      TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
                </div>

                @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
                {
            @* Distinto de "aún no hay X": son dos situaciones opuestas y llevan
               a acciones opuestas. Ofrecer "crea el primero" a quien acaba de
               filtrar lo manda a duplicar algo que ya existe.

               La copia no afirma que HAYA registros dados de alta: el filtrado
               es de servidor y la consulta solo devuelve el total ya filtrado,
               así que la pantalla no sabe cuántos hay sin filtro. *@
                    <EstadoVacio NombreIcono="vacio" Titulo="Ningún documento con estos filtros"
                                 Descripcion="Ninguno coincide con la búsqueda ni con los filtros de ámbito y estado.">
                        <Accion>
                            <Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">Quitar los filtros</Boton>
                        </Accion>
                    </EstadoVacio>
                }
                else                 @if (_totalElementos == 0 && !_cargando)
                {
                    <EstadoVacio NombreIcono="documentos" Titulo="Aún no hay documentos" Descripcion="Sube el primero para empezar a controlar vigencias.">
                        <Accion>
                            <SoloConEscritura><Boton OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton></SoloConEscritura>
                        </Accion>
                    </EstadoVacio>
                }
            }
        }
    </Pestanas>
</div>

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar este documento?")"
    Mensaje="@($"{_tipoDocumentoAEliminar} de {_propietarioAEliminar} se ocultará de las listas activas. Podrás deshacerlo desde el aviso que aparecerá.")"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} documento(s)?")"
    Mensaje="Se ocultarán de las listas activas. Podrás recuperarlos desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<Modal Visible="_mostrarGuardarFiltro" VisibleChanged="v => _mostrarGuardarFiltro = v" Titulo="Guardar filtro actual" CerrarAlHacerClicFuera="!_guardandoFiltro">
    <ChildContent>
        <CampoTexto Etiqueta="Nombre" Valor="@_nombreFiltroNuevo" ValorChanged="v => _nombreFiltroNuevo = v" Placeholder="Vencidos de trabajadores" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoFiltro" OnClick="() => _mostrarGuardarFiltro = false">Cancelar</Boton>
        <Boton Cargando="_guardandoFiltro" OnClick="GuardarFiltroActualAsync">Guardar</Boton>
    </Pie>
</Modal>
