@page "/documentos"
@rendermode InteractiveServer
@attribute [Authorize]
@using CaeManager.Application.Documentos.Commands.CrearDocumento
@using CaeManager.Application.Documentos.Commands.EliminarDocumento
@using CaeManager.Application.Documentos.Commands.RenovarDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculosParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@inject IMediator Mediator
@inject ToastService ToastService
@inject ICurrentUserService CurrentUserService
@inject IFileStorageService AlmacenamientoArchivos
@inject IConversorWordPdfService ConversorWordPdf
@inject ContextWorkspaceService WorkspaceService
@inject ILogger<Documentos> Logger

<PageTitle>Documentos — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Documentos</h1>
        <div class="acciones-cabecera">
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                <a class="enlace-exportar" href="/importacion?plantilla=documentos">Importar documentos</a>
            </AuthorizeView>
            <a class="enlace-exportar" href="/documentos/subida-masiva">Subida múltiple</a>
            <Boton OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton>
        </div>
    </div>

    <Pestanas Definiciones="_pestanasDocumentos" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="v => _pestanaActiva = v" EtiquetaGrupo="Secciones de documentos">
        @if (_pestanaActiva == "plataforma")
        {
            <PlataformaTab />
        }
        else if (_pestanaActiva == "reclamaciones")
        {
            <ReclamacionesTab />
        }
        else if (_pestanaActiva == "sugerencias")
        {
            <SugerenciasPreventivasTab />
        }
        else
        {
            <div class="barra-filtros">
                <CampoTexto Placeholder="Buscar por propietario o tipo de documento…" Valor="@_busqueda" ValorChanged="BuscarAsync" />
                <CampoSelect Etiqueta="Ámbito" Valor="@_ambitoFiltro" ValorChanged="CambiarAmbitoFiltroAsync">
                    <option value="">Todos</option>
                    <option value="@nameof(AmbitoAplicacion.Trabajador)">Trabajador</option>
                    <option value="@nameof(AmbitoAplicacion.Cliente)">Cliente</option>
                    <option value="@nameof(AmbitoAplicacion.Empresa)">Empresa</option>
                    <option value="@nameof(AmbitoAplicacion.Vehiculo)">Vehículo</option>
                    <option value="@nameof(AmbitoAplicacion.Proyecto)">Proyecto</option>
                </CampoSelect>
                <CampoSelect Etiqueta="Estado" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoFiltroAsync">
                    <option value="">Todos</option>
                    <option value="@nameof(EstadoDocumento.Vencido)">Vencido</option>
                    <option value="@nameof(EstadoDocumento.Urgente)">Urgente</option>
                    <option value="@nameof(EstadoDocumento.Proximo)">Próximo</option>
                    <option value="@nameof(EstadoDocumento.Vigente)">Vigente</option>
                    <option value="@nameof(EstadoDocumento.SinCaducidad)">Sin caducidad</option>
                </CampoSelect>
                @if (_filtrosGuardados.Count > 0)
                {
                    <CampoSelect Etiqueta="" Valor="" ValorChanged="AplicarFiltroGuardadoAsync">
                        <option value="">Filtros guardados…</option>
                        @foreach (var filtro in _filtrosGuardados)
                        {
                            <option value="@filtro.Id">@filtro.Nombre</option>
                        }
                    </CampoSelect>
                }
                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => _mostrarGuardarFiltro = true">
                    Guardar filtro
                </Boton>
            </div>

            <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

            @if (_errorCarga)
            {
                <EstadoVacio Titulo="No pudimos cargar los documentos" Descripcion="Intenta nuevamente en unos segundos.">
                    <Accion>
                        <Boton OnClick="RecargarAsync">Reintentar</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else
            {
                <BarraHerramientasLista SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="AlternarSeleccionMultiple" />

                <div style="display:@(_totalElementos == 0 && !_cargando ? "none" : "block")">
                    <QuickGrid @ref="_grid" TGridItem="DocumentoListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="tabla-datos" RowClass="ObtenerClaseFila">
                        @if (_seleccionMultiple)
                        {
                            <TemplateColumn Title="" Align="Align.Center">
                                <HeaderTemplate Context="columna">
                                    <input type="checkbox" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" />
                                </HeaderTemplate>
                                <ChildContent>
                                    <input type="checkbox" checked="@_seleccionados.Contains(context.Id)" @onchange="e => AlternarSeleccion(context.Id, (bool)e.Value!)" />
                                </ChildContent>
                            </TemplateColumn>
                        }
                        <PropertyColumn Property="@(d => d.PropietarioNombre)" Title="Propietario" Sortable="true" />
                        <TemplateColumn Title="Ámbito" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.Ambito))">
                            <Badge>@context.Ambito</Badge>
                        </TemplateColumn>
                        <PropertyColumn Property="@(d => d.TipoDocumentoNombre)" Title="Tipo de documento" Sortable="true" />
                        <PropertyColumn Property="@(d => d.FechaEmision)" Format="dd/MM/yyyy" Title="Emisión" Sortable="true" />
                        <TemplateColumn Title="Vencimiento" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.FechaVencimiento))">
                            @(context.FechaVencimiento is null ? "—" : context.FechaVencimiento.Value.ToString("dd/MM/yyyy"))
                        </TemplateColumn>
                        <TemplateColumn Title="Estado" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.Estado))">
                            <Badge Tono="EstadoDocumentoUi.Tono(context.Estado)">@EstadoDocumentoUi.Texto(context.Estado)</Badge>
                        </TemplateColumn>
                        <TemplateColumn Title="Plataformas">
                            @if (context.Acreditaciones.Count == 0)
                            {
                                <span class="detalle-tecnico">—</span>
                            }
                            else
                            {
                                <BadgesAcreditacion Acreditaciones="context.Acreditaciones" />
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Archivo">
                            @if (context.ArchivoUrl is not null)
                            {
                                <a href="/documentos/@context.Id/archivo" target="_blank">Ver PDF</a>
                            }
                            else
                            {
                                <span class="detalle-tecnico">Sin adjunto</span>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Align="Align.End">
                            <MenuAcciones>
                                <ItemMenuAccion OnClick='() => WorkspaceService.AbrirAsync(EntidadWorkspace.Documento, context.Id, context.TipoDocumentoNombre, "informacion")'>
                                    Ver
                                </ItemMenuAccion>
                                <ItemMenuAccion OnClick="() => _drawerGestion.AbrirEditarAsync(context.Id)">
                                    Renovar
                                </ItemMenuAccion>
                                <ItemMenuAccion Destructivo="true" OnClick="() => AbrirEliminar(context.Id, context.PropietarioNombre, context.TipoDocumentoNombre)">
                                    Eliminar
                                </ItemMenuAccion>
                            </MenuAcciones>
                        </TemplateColumn>
                    </QuickGrid>

                    <PaginadorSimple PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                      Etiqueta="documento(s)" PaginaActualChanged="CambiarPaginaAsync"
                                      TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" />
                </div>

                @if (_totalElementos == 0 && !_cargando)
                {
                    <EstadoVacio Titulo="Aún no hay documentos" Descripcion="Sube el primero para empezar a controlar vigencias.">
                        <Accion>
                            <Boton OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton>
                        </Accion>
                    </EstadoVacio>
                }
            }
        }
    </Pestanas>
</div>

<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" />

<DialogoConfirmacion
    Visible="_confirmarEliminarVisible"
    VisibleChanged="v => _confirmarEliminarVisible = v"
    Titulo="@($"¿Eliminar este documento?")"
    Mensaje="@($"{_tipoDocumentoAEliminar} de {_propietarioAEliminar} se ocultará de las listas activas. Podrás deshacerlo desde el aviso que aparecerá.")"
    EnProgreso="_eliminando"
    OnConfirmar="ConfirmarEliminarAsync" />

<BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                    OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} documento(s)?")"
    Mensaje="Se ocultarán de las listas activas. Podrás recuperarlos desde Auditoría."
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

<Modal Visible="_mostrarGuardarFiltro" VisibleChanged="v => _mostrarGuardarFiltro = v" Titulo="Guardar filtro actual" CerrarAlHacerClicFuera="!_guardandoFiltro">
    <ChildContent>
        <CampoTexto Etiqueta="Nombre" Valor="@_nombreFiltroNuevo" ValorChanged="v => _nombreFiltroNuevo = v" Placeholder="Vencidos de trabajadores" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_guardandoFiltro" OnClick="() => _mostrarGuardarFiltro = false">Cancelar</Boton>
        <Boton Cargando="_guardandoFiltro" OnClick="GuardarFiltroActualAsync">Guardar</Boton>
    </Pie>
</Modal>
