@page "/documentos"
@rendermode InteractiveServer
@inherits CaeManager.Web.Components.PaginaInteractiva
@attribute [Authorize]
@using CaeManager.Web.Features.Documentos.Recursos
@using CaeManager.Application.Documentos.Commands.CrearDocumento
@using CaeManager.Application.Documentos.Commands.RenovarDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Application.Trabajadores.Queries.ObtenerTrabajadoresParaSelector
@using CaeManager.Application.Clientes.Queries.ObtenerClientesParaSelector
@using CaeManager.Application.Empresas.Queries.ObtenerEmpresasParaSelector
@using CaeManager.Application.Vehiculos.Queries.ObtenerVehiculosParaSelector
@using CaeManager.Application.Common
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using FluentValidation
@using MediatR
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.QuickGrid
@using CaeManager.Web.Features.IncorporacionCartera.Components
@inject IMediator Mediator
@inject ToastService ToastService
@inject IFileStorageService AlmacenamientoArchivos
@inject IConversorWordPdfService ConversorWordPdf
@inject ContextWorkspaceService WorkspaceService
@inject ILogger<Documentos> Logger

<LimiteDeErrores Pagina="this">
<PageTitle>Documentos — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    @* Fase 1: el selector lateral ya identifica la Empresa seleccionada; las seis pestañas conservan su comportamiento. *@
    <CabeceraListado Titulo="Documentos"
                     Contador="@(_pestanaActiva == "listado" && !_sinEmpresaSeleccionada && !_resolviendoEmpresa && !_cargando && !_errorCarga ? _totalElementos : (int?)null)"
                     SeleccionMultiple="_seleccionMultiple"
                     SeleccionMultipleChanged="@(_puedeEscribir && _pestanaActiva == "listado" && !_sinEmpresaSeleccionada && !_resolviendoEmpresa && !_alcanceCero ? EventCallback.Factory.Create<bool>(this, AlternarSeleccionMultiple) : default)"
                     Menu="@(!_sinEmpresaSeleccionada && !_resolviendoEmpresa ? MenuCabecera : null)"
                     RutaExportar="@(!_sinEmpresaSeleccionada && !_resolviendoEmpresa ? "/documentos/exportar.xlsx" : null)" CriteriosExportar="CriteriosExportar">
        <Primaria>
            @if (!_sinEmpresaSeleccionada && !_resolviendoEmpresa && !_alcanceCero)
            {
                @* D-30: Plantillas conserva su propia primaria «+ Nueva plantilla»; el alta documental sigue secundaria. *@
                <SoloConEscritura><Boton Variante="@(_pestanaActiva == "plantillas" ? VarianteBoton.Secundario : VarianteBoton.Primario)" OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton></SoloConEscritura>
            }
        </Primaria>
    </CabeceraListado>

    @if (_resolviendoEmpresa)
    {
        <EstadoCargando Filas="3" />
    }
    else if (_sinEmpresaSeleccionada)
    {
        @* Estado 4a del mockup: quien gestiona empresas externas y no tiene ninguna elegida no ve los
           datos de su organización presentados como si fueran de su cartera. *@
        <EstadoVacio NombreIcono="empresas" Titulo="@Textos["SinEmpresaTitulo"]"
                     Descripcion="@Textos["SinEmpresaDescripcion"]" />
    }
    else
    {
    <Pestanas Definiciones="PestanasDocumentos" PestanaActiva="@_pestanaActiva" PestanaActivaChanged="CambiarPestana" EtiquetaGrupo="Secciones de documentos">
        @if (_pestanaActiva == "plataforma")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <PlataformaTab @ref="_plataformaTab" AcreditacionId="AcreditacionId"
                                   OnSubirVersionCorregida="AbrirVersionCorregidaAsync" />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Plataformas CAE" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "reclamaciones")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <ReclamacionesTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Reclamaciones" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "sugerencias")
        {
            <SugerenciasPreventivasTab />
        }
        else if (_pestanaActiva == "revision-ia")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <RevisionIaTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Revisión IA" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else if (_pestanaActiva == "plantillas")
        {
            <AuthorizeView Roles="@RolesDeGestionDocumental">
                <Authorized>
                    <PlantillasTab />
                </Authorized>
                <NotAuthorized>
                    <SinPermisoEnSeccion Seccion="Plantillas" />
                </NotAuthorized>
            </AuthorizeView>
        }
        else
        {
            <BarraFiltros PresentacionMaqueta="false" Contador="@(_pestanaActiva == "listado" && !_sinEmpresaSeleccionada && !_resolviendoEmpresa && !_cargando && !_errorCarga ? _totalElementos : (int?)null)" SeleccionMultiple="_seleccionMultiple" SeleccionMultipleChanged="@(_puedeEscribir && _pestanaActiva == "listado" && !_sinEmpresaSeleccionada && !_resolviendoEmpresa && !_alcanceCero ? EventCallback.Factory.Create<bool>(this, AlternarSeleccionMultiple) : default)" Busqueda="@_busqueda" BusquedaChanged="BuscarAsync" PlaceholderBuscador="@Textos["ListaFiltrarPlaceholder"]"
                          HayFiltrosActivos="HayFiltrosActivos"
                          OnLimpiarTodo="LimpiarFiltrosAsync"
                          OnGuardarFiltro="AbrirGuardarFiltro"
                          FiltrosGuardados="OpcionesFiltrosGuardados" OnAplicarFiltroGuardado="AplicarFiltroGuardadoAsync"
                          OnBorrarFiltroGuardado="PedirEliminarFiltroGuardado"
                          MasFiltrosActivos="@(!string.IsNullOrEmpty(_plataformaFiltro))"
                          VistaRecordada="_vistaRecordada">
                <Pastillas>
                    <PastillaFiltro PresentacionCampo="false" Etiqueta="@Textos["ListaFiltroAmbito"]" TextoTodos="@Textos["ListaTodos"]" Valor="@_ambitoFiltro"
                                    ValorChanged="CambiarAmbitoFiltroAsync" Opciones="OpcionesAmbitoListado" />
                    <PastillaEntidadAsociadaDocumento Valor="@(Guid.TryParse(_propietarioFiltro, out var entidadSeleccionada) ? entidadSeleccionada : (Guid?)null)"
                                                      Ambito="@(Enum.TryParse<AmbitoAplicacion>(_ambitoFiltro, out var ambitoSeleccionado) ? ambitoSeleccionado : (AmbitoAplicacion?)null)"
                                                      ValorChanged="CambiarEntidadAsociadaAsync" />
                    <PastillaFiltro Etiqueta="@Textos["ListaPortal"]" TextoTodos="@Textos["ListaTodas"]" Valor="@_plataformaFiltro"
                                    ValorChanged="CambiarPlataformaFiltroAsync" Opciones="_opcionesPlataforma" />
                </Pastillas>
                <MasFiltros>
                    <FranjaEstado Opciones="EstadoDocumentoUi.FranjaDeDocumentos" Valor="@_estadoFiltro" ValorChanged="CambiarEstadoFiltroAsync"
                                  Recuentos="_recuentosPorEstado" />
                    <PastillaFiltro Etiqueta="@Textos["ListaFiltroTipo"]" TextoTodos="@Textos["ListaTodos"]" Valor="@_tipoFiltro"
                                    ValorChanged="CambiarTipoFiltroAsync" Opciones="_opcionesTipo" />
                </MasFiltros>
                <Herramientas>
                    <MenuAcciones Etiqueta="@Textos[_agruparPorAmbito ? "AgruparPorAmbitoEtiqueta" : "AgruparNo"]" Pastilla="true">
                        <ItemMenuAccion Marcado="@(!_agruparPorAmbito)" OnClick="() => CambiarAgrupacionAsync(false)">@Textos["SinAgrupar"]</ItemMenuAccion>
                        <ItemMenuAccion Marcado="_agruparPorAmbito" OnClick="() => CambiarAgrupacionAsync(true)">@Textos["PorAmbito"]</ItemMenuAccion>
                    </MenuAcciones>
                </Herramientas>
                <Chips>
                    @if (!string.IsNullOrWhiteSpace(_busqueda))
                    {
                        <ChipFiltro Etiqueta="@EtiquetaFiltroBusqueda" EtiquetaAccesible="@Textos["QuitarFiltroBusqueda"]" OnQuitar="() => BuscarAsync(string.Empty)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_ambitoFiltro))
                    {
                        <ChipFiltro Etiqueta="@EtiquetaFiltroAmbito" EtiquetaAccesible="@Textos["QuitarFiltroAmbito"]" OnQuitar="() => CambiarAmbitoFiltroAsync(string.Empty)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_tipoFiltro))
                    {
                        <ChipFiltro Etiqueta="@EtiquetaFiltroTipo" EtiquetaAccesible="@Textos["QuitarFiltroTipo"]" OnQuitar="() => CambiarTipoFiltroAsync(string.Empty)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_plataformaFiltro))
                    {
                        <ChipFiltro Etiqueta="@EtiquetaFiltroPlataforma" EtiquetaAccesible="@Textos["QuitarFiltroPlataforma"]" OnQuitar="() => CambiarPlataformaFiltroAsync(string.Empty)" />
                    }
                    @if (!string.IsNullOrWhiteSpace(_propietarioFiltro))
                    {
                        <ChipFiltro Etiqueta="@Textos["ChipPropietario"]" EtiquetaAccesible="@Textos["QuitarFiltroPropietario"]" OnQuitar="() => CambiarEntidadAsociadaAsync(null)" />
                    }
                </Chips>
            </BarraFiltros>
            @* Bajo la pestaña del listado: la vista recordada es la de esta rejilla, no la de las otras pestañas.
               Retirada la página no se monta: pediría la vista recordada de una página que ya no existe
               (misma guarda que el proveedor de la rejilla). *@
            @if (!_desechado)
            {
                <VistaRecordadaDeListado Conexion="_vistaRecordada" Pantalla="@CaeManager.Application.Configuracion.PantallasConVistaRecordada.Documentos"
                                         ParametrosDeVista="ParametrosDeVista" ParametroDeBusqueda="q" OnAplicar="AplicarVistaGuardadaAsync" AlCambiar="StateHasChanged" />
            }

            @* Selector desplegable de estado: conserva la semántica de la franja para «Estado». Admite varios estados a la vez, viaja en la URL
               como «Estado» (estados de código separados por coma) y cada botón dice cuántos Documentos hay, con
               los demás filtros aplicados. «Por vencer» reúne Urgente y Próximo. *@


            <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />

            @if (_errorCarga)
            {
                <EstadoVacio Titulo="No pudimos cargar los documentos" Descripcion="Intenta nuevamente en unos segundos.">
                    <Accion>
                        <Boton Variante="VarianteBoton.Primario" OnClick="RecargarAsync">Reintentar</Boton>
                    </Accion>
                </EstadoVacio>
            }
            else
            {
                @if (_cargando)
                {
                    <EstadoCargando Filas="6" />
                }
                @TarjetaListado.RenderizarMaqueta(@<text>
                <div style="display:@(_cargando || (_totalElementos == 0 && !HayFiltrosActivos) ? "none" : "block")">
                        <div class="documentos-tabla-desplazable" tabindex="0" role="region" aria-label="@Textos["TablaDesplazableEtiqueta"]" @onkeydown="CerrarOrdenConTecla">
                        @if (_opcionesOrdenVisible is not null)
                        {
                            <div class="documentos-orden-superposicion" @onclick="() => _opcionesOrdenVisible = null"></div>
                        }
                        <table class="@($"tabla-datos documentos-tabla-visible {(_agruparPorAmbito ? "documentos-tabla-agrupada" : null)}")">
                            <thead><tr>
                                @if (_seleccionMultiple)
                                {
                                    <th scope="col"><input type="checkbox" aria-label="@Textos["SeleccionarPagina"]" checked="@TodosSeleccionados" @onchange="e => AlternarSeleccionTodos((bool)e.Value!)" /></th>
                                }
                                @if (HayDestinos) { <th scope="col"><span class="documentos-solo-lectores">@Textos["ListaDestino"]</span></th> }
                                <th scope="col" aria-sort="@AriaOrdenGrupo("tipo")"><button type="button" class="col-title documentos-orden-grupo" @onclick="() => OrdenarGrupoAsync(_columnaTipo)">@Textos["ListaDocumento"]</button></th>
                                <th scope="col" aria-sort="@AriaOrdenGrupo("entidad", "ambito")">
                                    <button type="button" class="col-title documentos-orden-grupo" @onclick="() => OrdenarGrupoAsync(_columnaEntidadAsociada)">@Textos[_ordenEntidadAsociadaPorAmbito ? "ListaEntidadAsociadaPorAmbito" : "ListaPropietario"]</button>
                                    <button type="button" class="documentos-opciones-boton" aria-label="@Textos["ListaOrdenarEntidadAsociada"]" aria-expanded="@(_opcionesOrdenVisible == ColumnaOrdenListado.EntidadAsociada ? "true" : "false")" @onclick="() => _opcionesOrdenVisible = _opcionesOrdenVisible == ColumnaOrdenListado.EntidadAsociada ? null : ColumnaOrdenListado.EntidadAsociada"><Icono Nombre="mas-opciones" Tamano="TamanoIcono.Pequeno" /></button>
                                    @if (_opcionesOrdenVisible == ColumnaOrdenListado.EntidadAsociada)
                                    {
                                        <div class="documentos-opciones-orden" data-opciones-orden>
                                            <button type="button" @onclick="() => CambiarCampoOrdenEntidadAsociada(false)">@Textos["ListaOrdenarEntidadAsociada"]</button>
                                            <button type="button" @onclick="() => CambiarCampoOrdenEntidadAsociada(true)">@Textos["ListaOrdenarAmbito"]</button>
                                        </div>
                                    }
                                </th>
                                <th scope="col" aria-sort="@AriaOrdenGrupo("vencimiento", "emision")">
                                    <button type="button" class="col-title documentos-orden-grupo" @onclick="() => OrdenarGrupoAsync(_columnaVigencia)">@Textos[_ordenVigenciaPorEmision ? "ListaVigenciaPorEmision" : "ListaVence"]</button>
                                    <button type="button" class="documentos-opciones-boton" aria-label="@Textos["ListaOrdenarVencimiento"]" aria-expanded="@(_opcionesOrdenVisible == ColumnaOrdenListado.Vigencia ? "true" : "false")" @onclick="() => _opcionesOrdenVisible = _opcionesOrdenVisible == ColumnaOrdenListado.Vigencia ? null : ColumnaOrdenListado.Vigencia"><Icono Nombre="mas-opciones" Tamano="TamanoIcono.Pequeno" /></button>
                                    @if (_opcionesOrdenVisible == ColumnaOrdenListado.Vigencia)
                                    {
                                        <div class="documentos-opciones-orden" data-opciones-orden>
                                            <button type="button" @onclick="() => CambiarCampoOrdenVigencia(true)">@Textos["ListaOrdenarEmision"]</button>
                                            <button type="button" @onclick="() => CambiarCampoOrdenVigencia(false)">@Textos["ListaOrdenarVencimiento"]</button>
                                        </div>
                                    }
                                </th>
                                <th scope="col" aria-sort="@AriaOrdenGrupo("estado")"><button type="button" class="col-title documentos-orden-grupo" @onclick="() => OrdenarGrupoAsync(_columnaEstado)">@Textos["ListaEstado"]</button></th>
                                <th scope="col">@Textos["ListaPlataformas"]</th><th scope="col">@Textos["ListaArchivo"]</th><th scope="col">@Textos["ListaAcciones"]</th>
                            </tr></thead>
                            @if (_totalElementos == 0 && !_cargando && HayFiltrosActivos)
                            {
                                <tbody><tr class="documentos-vacio-filtro"><td colspan="@(7 + (_seleccionMultiple ? 1 : 0) + (HayDestinos ? 1 : 0))">
                                    <EstadoVacio NombreIcono="vacio" Titulo="@Textos["VacioFiltroTituloDesign"]">
                                        <Accion><Boton Variante="VarianteBoton.Secundario" OnClick="LimpiarFiltrosAsync">@Textos["VacioFiltroQuitarDesign"]</Boton></Accion>
                                    </EstadoVacio>
                                </td></tr></tbody>
                            }
                            @{ var clavesGrupos = new ClavesDeHermanos(); }
                            @foreach (var grupo in _elementosPagina.GroupBy(documento => _agruparPorAmbito ? documento.Ambito : default))
                            {
                                <tbody @key="clavesGrupos.De(grupo.Key)">
                                    @{ var grupoAbierto = !_agruparPorAmbito || _gruposAbiertos.EstaAbierto(grupo.Key.ToString()); }
                                    @if (_agruparPorAmbito)
                                    {
                                        @* Grupo «Por Ámbito» plegable (bloque 1 de CAMBIOS-SESION 2026-10-21): nace plegado, con «· N» y,
                                           plegado, la pastilla roja de los Documentos en rojo. *@
                                        <tr class="documentos-cabecera-grupo"><th colspan="@(7 + (_seleccionMultiple ? 1 : 0) + (HayDestinos ? 1 : 0))" scope="rowgroup">
                                            <CabeceraGrupoLista Nombre="@EtiquetaAmbitoListado(grupo.Key)" Total="grupo.Count()" Incidencias="grupo.Count(EsFilaRoja)"
                                                                Abierto="grupoAbierto" OnAlternar="() => AlternarGrupo(grupo.Key.ToString())" />
                                        </th></tr>
                                    }
                                    @{ var clavesFilas = new ClavesDeHermanos(); }
                                    @foreach (var documento in grupoAbierto ? grupo : Enumerable.Empty<DocumentoListaDto>())
                                    {
                                        <tr @key="clavesFilas.De((documento.Id, false))" class="@ObtenerClaseFila(documento)">
                                            @if (_seleccionMultiple)
                                            {
                                                <td><input type="checkbox" aria-label="@Textos["SeleccionarDocumento", documento.TipoDocumentoNombre, documento.PropietarioNombre, documento.FechaEmision.ToString("dd/MM/yyyy")]" checked="@_seleccionados.Contains(documento.Id)" @onchange="e => AlternarSeleccion(documento.Id, (bool)e.Value!)" /></td>
                                            }
                                            @if (HayDestinos)
                                            {
                                                <td class="documentos-celda-expandir">
                                                    @if (documento.DestinosEnCentros?.Count > 0)
                                                    {
                                                        <button type="button" class="documentos-expandir" aria-label="@Textos[_documentosAbiertos.Contains(documento.Id) ? "DocumentoContraer" : "DocumentoExpandir", documento.TipoDocumentoNombre]" aria-expanded="@(_documentosAbiertos.Contains(documento.Id) ? "true" : "false")" @onclick="() => AlternarDocumento(documento.Id)" @onclick:stopPropagation="true"><Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" /></button>
                                                    }
                                                </td>
                                            }
                                            <td>@CeldaDocumento(documento)</td><td>@CeldaPropietario(documento)</td><td>@CeldaVigencia(documento)</td><td class="col-estado">@CeldaEstado(documento)</td><td>@CeldaPlataformas(documento)</td><td>@CeldaArchivo(documento)</td><td>@CeldaAcciones(documento)</td>
                                        </tr>
                                        @if (_documentosAbiertos.Contains(documento.Id) && documento.DestinosEnCentros?.Count > 0)
                                        {
                                            <tr @key="clavesFilas.De((documento.Id, true))" class="documentos-fila-hijos"><td colspan="@(7 + (_seleccionMultiple ? 1 : 0) + (HayDestinos ? 1 : 0))">
                                                <div class="documentos-hijos" role="list" aria-label="@Textos["ListaDestino"]">
                                                    @{ var clavesDestinos = new ClavesDeHermanos(); }
                                                    @foreach (var destino in VerRestantes.Recortar(documento.DestinosEnCentros, _destinosCompletos.Contains(documento.Id)))
                                                    {
                                                        <div class="documentos-hijo" role="listitem" @key="clavesDestinos.De((destino.CentroId, destino.PlataformaNombre))">
                                                            <a class="documentos-hijo-centro" href="@($"/centros/{destino.CentroId}")">@destino.CentroNombre</a>
                                                            <EstadoFila Tono="EstadoDocumentoUi.Tono(destino.Estado)" Texto="@EstadoDocumentoUi.Texto(destino.Estado)" Correcto="EstadoDocumentoUi.EsCorrecto(destino.Estado)" Motivo="@MotivoDestino(destino, documento)" />
                                                            <span class="documentos-hijo-contexto">@destino.ClienteNombre · @destino.PlataformaNombre</span>
                                                            <SoloConEscritura><Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="@($"documentos-accion-rapida {(EstadoDocumentoUi.EsCorrecto(destino.Estado) ? "documentos-accion-correcta" : null)}")" aria-label="@Textos["GestionarAria", documento.TipoDocumentoNombre, destino.CentroNombre]" OnClick="() => _drawerGestion.AbrirEditarAsync(documento.Id)">@Textos["Gestionar"]</Boton></SoloConEscritura>
                                                        </div>
                                                    }
                                                </div>
                                                <VerRestantes Total="documento.DestinosEnCentros.Count" Completa="_destinosCompletos.Contains(documento.Id)"
                                                              OnVerRestantes="() => _destinosCompletos.Add(documento.Id)" />
                                            </td></tr>
                                        }
                                    }
                                </tbody>
                            }
                        </table>
                        <div hidden>
                        <QuickGrid @key="_orden.Version" @ref="_grid" TGridItem="DocumentoListaDto" ItemsProvider="_proveedorElementos" Pagination="_paginacion" Class="documentos-proveedor">
                            <TemplateColumn @ref="_columnaTipo" Title="@Textos["ListaDocumento"]" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.TipoDocumentoNombre))" IsDefaultSortColumn="@_orden.Es("tipo")" InitialSortDirection="_orden.Direccion"><ChildContent></ChildContent></TemplateColumn>
                            <TemplateColumn @ref="_columnaEntidadAsociada" Title="@Textos["ListaPropietario"]" Sortable="true" SortBy="@(_ordenEntidadAsociadaPorAmbito ? OrdenAmbitoListado : OrdenEntidadAsociadaListado)" IsDefaultSortColumn="@_orden.Es("entidad", "ambito")" InitialSortDirection="_orden.Direccion">
                                <ColumnOptions></ColumnOptions><ChildContent></ChildContent>
                            </TemplateColumn>
                            <TemplateColumn @ref="_columnaVigencia" Title="@Textos["ListaVence"]" Sortable="true" SortBy="@(_ordenVigenciaPorEmision ? OrdenEmisionListado : OrdenVencimientoListado)" IsDefaultSortColumn="@_orden.Es("vencimiento", "emision")" InitialSortDirection="_orden.Direccion">
                                <ColumnOptions></ColumnOptions><ChildContent></ChildContent>
                            </TemplateColumn>
                            <TemplateColumn @ref="_columnaEstado" Title="@Textos["ListaEstado"]" Sortable="true" SortBy="@(GridSort<DocumentoListaDto>.ByAscending(d => d.Estado))" IsDefaultSortColumn="@_orden.Es("estado")" InitialSortDirection="_orden.Direccion"><ChildContent></ChildContent></TemplateColumn>
                        </QuickGrid>
                        </div>
                        </div>

                </div>
</text>, PieDelListado)

                @if (_totalElementos == 0 && !_cargando && !HayFiltrosActivos)
                {
                    @* Con alcance cero no se invita a crear lo que quizá ya existe fuera de la cartera (P0-9a, FS-05). *@
                    <VacioSegunAlcance @bind-AlcanceCero="_alcanceCero">
                        <EstadoVacio NombreIcono="documentos" Titulo="@Textos["VacioTituloDesign"]" Descripcion="@Textos["VacioDescripcionDesign"]">
                            <Accion>
                                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" OnClick="() => _drawerGestion.AbrirCrearAsync()">+ Nuevo documento</Boton></SoloConEscritura>
                            </Accion>
                        </EstadoVacio>
                    </VacioSegunAlcance>
                }
            }
        }
    </Pestanas>
    }
</div>


<DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="ManejarDocumentoGuardadoAsync" OnCerrado="LimpiarEnlaceProfundoDeUrl" />

<VisorDocumento Visible="_visorVisible" VisibleChanged="v => _visorVisible = v" DocumentoId="_visorDocumentoId" Titulo="@_visorTitulo" />

@* El lote solo elimina: tanto la selección múltiple como su barra requieren un rol con escritura. *@
<SoloConEscritura>
    <BarraAccionesLote Cantidad="_seleccionados.Count" Eliminando="_eliminandoLote"
                        OnLimpiar="() => _seleccionados.Clear()" OnEliminar="() => _confirmarEliminarLoteVisible = true" />
</SoloConEscritura>

<DialogoConfirmacion
    Visible="_confirmarEliminarLoteVisible"
    VisibleChanged="v => _confirmarEliminarLoteVisible = v"
    Titulo="@($"¿Eliminar {_seleccionados.Count} documento(s)?")"
    Mensaje="@Textos["ConfirmarEliminarLoteMensaje"]"
    EnProgreso="_eliminandoLote"
    OnConfirmar="ConfirmarEliminarLoteAsync" />

@* Borrar un filtro guardado pregunta antes: no se puede deshacer. Mismo patrón que Clientes empresariales. *@
<DialogoConfirmacion
    Visible="_filtroGuardadoAEliminar is not null"
    VisibleChanged="CambiarVisibilidadBorradoFiltroGuardado"
    Titulo="@Textos["FiltroGuardadoBorrarTitulo", _filtroGuardadoAEliminar?.Nombre ?? string.Empty]"
    Mensaje="@Textos["FiltroGuardadoBorrarMensaje"]"
    TextoBotonConfirmar="@Textos["FiltroGuardadoBorrarBoton"]"
    EnProgreso="_eliminandoFiltroGuardado"
    OnConfirmar="ConfirmarEliminarFiltroGuardadoAsync" />

@* «Guardar filtro» es un formulario de un campo: ModalFormulario (guardián, «Cancelar», «Guardar» único con su motivo y estado, aviso
   del formulario y aviso de navegación vienen del kit). Fuera de <Pestanas>, a nivel de página: el nombre del filtro no es de
   ninguna pestaña, y registrarlo en su ámbito haría preguntar al cambiar de pestaña. *@
<ModalFormulario Visible="_mostrarGuardarFiltro" VisibleChanged="CerrarModalGuardarFiltro" Titulo="Guardar filtro actual"
                 Ancho="AnchoModal.Pequeno" HayCambios="() => HayCambiosSinGuardar" Guardando="_guardandoFiltro"
                 MensajeError="@_mensajeErrorFiltro" OnGuardar="GuardarFiltroActualAsync"
                 MotivoGuardarDeshabilitado="@(string.IsNullOrWhiteSpace(_nombreFiltroNuevo) ? Textos["GuardarFiltroSinNombre"].Value : null)"
                 TextoGuardar="Guardar" TextoCancelar="Cancelar">
    <CampoTexto Etiqueta="Nombre" Valor="@_nombreFiltroNuevo" ValorChanged="v => { _nombreFiltroNuevo = v; _mensajeErrorFiltro = null; }" Placeholder="Vencidos de trabajadores" />
</ModalFormulario>

</LimiteDeErrores>

@code {
    private RenderFragment MenuCabecera => __builder =>
    {
        @if (HayDestinos)
        {
            <ItemMenuAccion OnClick="ExpandirTodos">@Textos["ExpandirTodo"]</ItemMenuAccion>
            <ItemMenuAccion OnClick="ContraerTodos">@Textos["ContraerTodo"]</ItemMenuAccion>
        }
        <CaeManager.Web.Exportacion.EntradasExportar Ruta="/documentos/exportar.xlsx" />
        <SoloConEscritura>
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/documentos/importar")'>Importar documentos</ItemMenuAccion>
            </AuthorizeView>
            <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/documentos/subida-masiva")'>Subida múltiple</ItemMenuAccion>
        </SoloConEscritura>
    };
}

@code {
    private RenderFragment? PieDelListado => _errorCarga || (_cargando && _totalElementos == 0) ? null : @<text>
        @if (!_errorCarga && (!_cargando || _totalElementos > 0))
        {
            <PaginadorSimple PresentacionMaqueta="true" PaginaActual="@(_paginacion.CurrentPageIndex + 1)" TotalPaginas="TotalPaginas" TotalElementos="_totalElementos"
                                          PaginaActualChanged="CambiarPaginaAsync"
                                          TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" ElementosEnPagina="ElementosVisibles.Count">
                    <Centro><LeyendaAtajosLista Omitir="@(["e"])" /></Centro>
                </PaginadorSimple>
        }
    </text>;
}

@code {
    private RenderFragment<DocumentoListaDto> CeldaDocumento => context => @<text>
                                <span class="documentos-propietario">
                                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@context.TipoDocumentoNombre" Termino="@_busqueda" /></button>
                                    <span class="documentos-ambito">@EtiquetaAmbitoListado(context.Ambito)</span>
                                </span>
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaPropietario => context => @<text>
                                    <span class="documentos-propietario">
                                        <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@context.PropietarioNombre" Termino="@_busqueda" /></button>
                                        <span class="documentos-ambito">@EtiquetaAmbitoListado(context.Ambito)</span>
                                    </span>
                                
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaVigencia => context => @<text>
                                    <span class="documentos-vigencia">
                                        @if (context.FechaVencimiento is null)
                                        {
                                            <span>@Textos["ListaEmitido", context.FechaEmision.ToString("dd/MM/yyyy")]</span>
                                        }
                                        else
                                        {
                                            <span>@context.FechaEmision.ToString("dd/MM/yyyy")</span>
                                            <span aria-hidden="true"> → </span>
                                            @* Un clic copia el vencimiento; Alt + clic, la emisión (decisión del 2026-10-08).
                                               La emisión se sigue pintando como texto: el botón es solo el vencimiento. *@
                                            <TextoFechaCopiable Fecha="context.FechaVencimiento" FechaEmision="context.FechaEmision">@context.FechaVencimiento.Value.ToString("dd/MM/yyyy")</TextoFechaCopiable>
                                        }
                                    </span>
                                
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaEstado => context => @<text>
                                <EstadoFila Tono="EstadoDocumentoUi.Tono(context.Estado)" Texto="@EstadoDocumentoUi.Texto(context.Estado)"
                                            Correcto="EstadoDocumentoUi.EsCorrecto(context.Estado)"
                                            Motivo="@EstadoDocumentoUi.MotivoDeDocumento(context.Estado, context.FechaVencimiento, _hoy)" />
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaPlataformas => context => @<text>
                                @if (context.Acreditaciones.Count == 0)
                                {
                                    <span class="detalle-tecnico">—</span>
                                }
                                else
                                {
                                    @* La ventana repite lo que la celda ya dice (plataforma y estado), una línea por
                                       plataforma; pulsar una abre la vista rápida del documento en «Validación». *@
                                    <VentanaContexto Interactiva="true"
                                                     Colocacion="ColocacionVentanaPlataformas(context.Id)"
                                                     Etiqueta="@Textos["VentanaPlataformasEtiqueta", context.Acreditaciones.Count]"
                                                     Titulo="@Textos["VentanaPlataformasTitulo"]"
                                                     class="documentos-plataformas">
                                        <Disparador><BadgesAcreditacion Acreditaciones="context.Acreditaciones" /></Disparador>
                                        <Detalle>
                                            @foreach (var acreditacion in context.Acreditaciones)
                                            {
                                                <VentanaContextoElemento @key="acreditacion.Id"
                                                                         Secundario="@EstadoAcreditacionUi.Texto(acreditacion.Estado)"
                                                                         Ayuda="@Textos["VentanaPlataformasAyuda"]"
                                                                         AlPulsar="() => AbrirPanelAsync(context.Id, PestanaValidacion)">@acreditacion.NombrePlataforma</VentanaContextoElemento>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaArchivo => context => @<text>
                                @if (context.ArchivoUrl is not null)
                                {
                                    @* Botón y no enlace: abre el visor en un modal (VisorDocumento) sin salir de la lista.
                                       «Abrir en pestaña nueva» sigue dentro del propio visor. *@
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                           aria-label="@Textos["VerPdfAria", context.TipoDocumentoNombre, context.PropietarioNombre]"
                                           OnClick="() => AbrirVisor(context)">@Textos["VerPdf"]</Boton>
                                }
                                else
                                {
                                    <span class="detalle-tecnico">Sin adjunto</span>
                                }
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaAcciones => context => @<text>
                                <span class="documentos-acciones-fila">
                                    <SoloConEscritura>
                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                               class="@($"documentos-accion-rapida {(EstadoDocumentoUi.EsCorrecto(context.Estado) ? "documentos-accion-correcta" : null)}")"
                                               aria-label="@Textos["GestionarAria", context.TipoDocumentoNombre, context.PropietarioNombre]"
                                               OnClick="() => _drawerGestion.AbrirEditarAsync(context.Id)">
                                            @Textos["Gestionar"]
                                        </Boton>
                                    </SoloConEscritura>
                                    @if (context.TipoDocumentoId != Guid.Empty)
                                    {
                                        <AuthorizeView Roles="@TipoDocumentoDetalle.RolesDeLaPagina" Context="autorizacion">
                                            <Boton360 Nombre="@context.TipoDocumentoNombre" Href="@($"/documentos/tipos/{context.TipoDocumentoId}")" />
                                        </AuthorizeView>
                                    }
                                </span>
                            
    </text>;
}

@code {
    private TemplateColumn<DocumentoListaDto>? _columnaTipo;
    private TemplateColumn<DocumentoListaDto>? _columnaEstado;

    private Task OrdenarGrupoAsync(ColumnBase<DocumentoListaDto>? columna) =>
        _grid is not null && columna is not null ? _grid.SortByColumnAsync(columna) : Task.CompletedTask;

    private string AriaOrdenGrupo(params string[] campos) =>
        !_orden.Es(campos) ? "none" : _orden.Direccion == SortDirection.Descending ? "descending" : "ascending";
}
