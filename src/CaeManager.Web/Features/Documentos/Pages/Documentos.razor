                <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/documentos/importar")'>Importar documentos</ItemMenuAccion>
            </AuthorizeView>
            <ItemMenuAccion OnClick='() => NavigationManager.NavigateTo("/documentos/subida-masiva")'>Subida múltiple</ItemMenuAccion>
        </SoloConEscritura>
    };
}

@code {
    private RenderFragment? PieDelListado => _errorCarga || (_cargando && _totalElementos == 0) ? null : @<text>
        @if (!_errorCarga && (!_cargando || _totalElementos > 0))
        {
            @* Agrupada se piden todas las filas filtradas de una vez (hasta el tope): sin flechas ni tamaño de página, porque
               no hay página 2 que no repita la 1 ni paginador que corte grupos (maqueta P-1, «Agrupar por»); el pie dice
               cuántas filas y Documentos hay, y si el universo pasa del tope, se avisa debajo. *@
            <PaginadorSimple PresentacionMaqueta="@(_totalElementos == 0)" PaginaActual="@(PieAgrupado ? 1 : _paginacion.CurrentPageIndex + 1)" TotalPaginas="@(PieAgrupado ? 1 : TotalPaginas)" TotalElementos="_totalElementos"
                                          PaginaActualChanged="CambiarPaginaAsync" TextoFilasMostradas="@(PieAgrupado ? TextoPieAgrupado : null)"
                                          OpcionesTamanoPagina="@(PieAgrupado ? SinTamanosDePagina : TamanosDePagina)"
                                          TamanoPagina="_paginacion.ItemsPerPage" TamanoPaginaChanged="CambiarTamanoPaginaAsync" ElementosEnPagina="ElementosVisibles.Count">
                    <Centro><LeyendaAtajosLista Omitir="@(["e"])" /></Centro>
                </PaginadorSimple>
            @if (PieAgrupado && AgrupadaSuperaElTope)
            {
                <p class="documentos-aviso-tope" role="status" data-testid="documentos-aviso-tope">
                    @Textos["PieAgrupadoTope", AgrupacionDeLista.TamanoPaginaAgrupada, _totalElementos]
                </p>
            }
        }
    </text>;
}

@code {
    private RenderFragment<DocumentoListaDto> CeldaDocumento => context => @<text>
                                <span class="documentos-propietario">
                                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@context.TipoDocumentoNombre" Termino="@_busqueda" /></button>
                                    <span class="documentos-ambito">@EtiquetaAmbitoListado(context.Ambito)</span>
                                </span>
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaPropietario => context => @<text>
                                    <span class="documentos-propietario">
                                        <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida documentos-propietario-nombre" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@context.PropietarioNombre" Termino="@_busqueda" /></button>
                                        @CeldaPlataformas(context)
                                    </span>
                                
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaVigencia => context => @<text>
                                    <span class="documentos-vigencia">
                                        @if (context.FechaVencimiento is null)
                                        {
                                            <span>@Textos[context.Estado == EstadoDocumento.SinCaducidad ? "ListaNoCaduca" : "ListaVencimientoSinConfirmar"]</span>
                                            <span class="documentos-vigencia-subtitulo">@Textos["ListaEmisionFecha", context.FechaEmision.ToString("dd/MM/yyyy")]</span>
                                        }
                                        else
                                        {
                                            <TextoFechaCopiable Fecha="context.FechaVencimiento" FechaEmision="context.FechaEmision">@context.FechaVencimiento.Value.ToString("dd/MM/yyyy")</TextoFechaCopiable>
                                            <span class="documentos-vigencia-subtitulo">@SubtituloVencimiento(context)</span>
                                        }
                                    </span>
                                
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaEstado => context => @<text>
                                <EstadoFila Tono="EstadoDocumentoUi.Tono(context.Estado)" Texto="@EstadoDocumentoUi.Texto(context.Estado)"
                                            Correcto="EstadoDocumentoUi.EsCorrecto(context.Estado)"
                                            Motivo="@MotivoDeLaFila(context)" />
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaPlataformas => context => @<text>
                                @* Sin plataformas no se pinta nada: una segunda línea con «—» no aporta y estira la fila. *@
                                @if (context.Acreditaciones.Count > 0)
                                {
                                    @* La ventana repite lo que la celda ya dice (plataforma y estado), una línea por
                                       plataforma; pulsar una abre la vista rápida del documento en «Validación». *@
                                    <VentanaContexto Interactiva="true"
                                                     Colocacion="ColocacionVentanaPlataformas(context.Id)"
                                                     Etiqueta="@Textos["VentanaPlataformasEtiqueta", context.Acreditaciones.Count]"
                                                     Titulo="@Textos["VentanaPlataformasTitulo"]"
                                                     class="documentos-plataformas">
                                        @* D-22 (artboard Main): una línea por Plataforma CAE, «logo Nombre · Validada». Es el mismo estado
                                           que ve el Usuario de Cliente: sin motivo ni «Abrir portal», que viven en la ventana y la vista rápida. *@
                                        <Disparador>
                                            <span class="documentos-plats">
                                                @foreach (var acreditacion in PlataformasDeLaFila(context))
                                                {
                                                    @ChipPlataforma(acreditacion)
                                                }
                                            </span>
                                        </Disparador>
                                        <Detalle>
                                            @foreach (var acreditacion in context.Acreditaciones)
                                            {
                                                <VentanaContextoElemento @key="acreditacion.Id"
                                                                         Secundario="@EstadoAcreditacionUi.Texto(acreditacion.Estado)"
                                                                         Ayuda="@Textos["VentanaPlataformasAyuda"]"
                                                                         AlPulsar="() => AbrirPanelAsync(context.Id, PestanaValidacion)">@acreditacion.NombrePlataforma</VentanaContextoElemento>
                                            }
                                        </Detalle>
                                    </VentanaContexto>
                                }
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaArchivo => context => @<text>
                                @if (context.ArchivoUrl is not null)
                                {
                                    @* Botón y no enlace: abre el visor en un modal (VisorDocumento) sin salir de la lista.
                                       «Abrir en pestaña nueva» sigue dentro del propio visor. *@
                                    @* «Ver» es la acción secundaria de la fila, de enlace como en las fichas 360; «Gestionar» es la principal. *@
                                    <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace documentos-accion-ver"
                                           aria-label="@Textos["VerPdfAria", context.TipoDocumentoNombre, context.PropietarioNombre]"
                                           OnClick="() => AbrirVisor(context)">@Textos["ListaVer"]</Boton>
                                }
                                else
                                {
                                    <span class="detalle-tecnico">@Textos["ListaSinAdjunto"]</span>
                                }
                            
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaAcciones => context => @<text>
                                <span class="documentos-acciones-fila">
                                    @CeldaArchivo(context)
                                    @if (AcreditacionDeLaFila(context) is { } acreditacionDeLaFila
                                         && ReglasAccionesAcreditacion.HayAlgunaAccion(acreditacionDeLaFila.Estado, PuedeGestionarAcreditacion(context), acreditacionDeLaFila.UrlAccesoCanal))
                                    {
                                        @* D-18: por Plataforma CAE la fila lleva solo «Acreditación ▾», sin el botón suelto «Gestionar» (artboard
                                           Agrupar-plataforma). El menú es de quien escribe (SoloConEscritura, dentro de MenuAcreditacion); «Subir versión
                                           corregida» abre el drawer del Documento. «Abrir portal» lleva la dirección del canal de ESTA acreditación. *@
                                        <MenuAcreditacion @key="acreditacionDeLaFila.Id" Estado="acreditacionDeLaFila.Estado"
                                                          PlataformaNombre="@NombreDeGrupo(context.Grupo!.Clave)" PropietarioNombre="@context.PropietarioNombre"
                                                          UrlPortal="@acreditacionDeLaFila.UrlAccesoCanal" PuedeGestionar="@PuedeGestionarAcreditacion(context)"
                                                          OnAccion="accion => ManejarAccionAcreditacionAsync(context, accion)" />
                                    }
                                    else
                                    {
                                        @* Sin agrupar, por Cliente empresarial, por tipo, en el grupo sin vínculo y en una fila cuyo menú quedaría vacío,
                                           «Gestionar» sigue siendo la acción principal. *@
                                        <SoloConEscritura>
                                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                   class="@($"documentos-accion-rapida {(EstadoDocumentoUi.EsCorrecto(context.Estado) ? "documentos-accion-correcta" : null)}")"
                                                   aria-label="@Textos["GestionarAria", context.TipoDocumentoNombre, context.PropietarioNombre]"
                                                   OnClick="() => _drawerGestion.AbrirEditarAsync(context.Id)">
                                                @Textos["Gestionar"]
                                            </Boton>
                                        </SoloConEscritura>
                                    }
                                    @* Por tipo de documento el 360 va en la cabecera del grupo («Tipo 360»), no en cada fila. *@
                                    @if (context.TipoDocumentoId != Guid.Empty && !AgrupadaPorTipo)
                                    {
                                        <AuthorizeView Roles="@TipoDocumentoDetalle.RolesDeLaPagina" Context="autorizacion">
                                            <Boton360 Nombre="@context.TipoDocumentoNombre" Href="@($"/documentos/tipos/{context.TipoDocumentoId}")" />
                                        </AuthorizeView>
                                    }
                                </span>

    </text>;

    /// <summary>
    /// Quien puede recibir «Abrir portal» y ver el motivo literal de rechazo: todos los roles del Tenant salvo Cliente, el
    /// mismo corte que ObtenerCentroIdsParaGestionAsync. El rol Cliente sí ve el estado en la plataforma (opción B, 2026-11-12).
    /// </summary>
    private const string RolesQueAbrenPortal = ReglasAccionesAcreditacion.RolesQueAbrenPortal;

    /// <summary>
    /// Columnas de la tabla, más la de selección y la de expandir. Las cinco de siempre (Documento, Propietario, Vence, Estado,
    /// Acciones); por Plataforma CAE siete (Propietario, Nombre en la plataforma, Cliente empresarial, Vence, Estado documental,
    /// Estado en la plataforma, Acciones); por tipo cinco (Propietario, Plataformas CAE, Vence, Estado documental, Acciones).
    /// </summary>
    private int ColumnasTabla => (AgrupadaPorPlataforma ? 7 : 5) + (_seleccionMultiple ? 1 : 0) + (MostrarDestinos ? 1 : 0) + (RevisionIaActiva ? 1 : 0);

    /// <summary>
    /// «Revisión IA» (artboard Filtro-revision-ia): barra de confianza y «Confianza N %» de la revisión pendiente del Documento.
    /// Solo existe con el filtro «Pendiente de revisión IA» aplicado, y entonces el servidor ya solo manda la confianza a los roles con
    /// acceso a la cola; aun así, una fila sin confianza (revisión de un Documento sin pendiente propia) no pinta nada.
    /// </summary>
    private RenderFragment<DocumentoListaDto> CeldaRevisionIa => context => @<text>
                                @if (context.ConfianzaRevisionIa is { } confianza)
                                {
                                    <span class="documentos-confianza" data-testid="documentos-confianza">
                                        <span class="documentos-confianza-barra" aria-hidden="true"><i class="@($"documentos-confianza-relleno documentos-confianza-relleno-{TonoConfianza(confianza)}")" style="@($"width:{Math.Clamp(confianza, 0, 100)}%")"></i></span>
                                        @Textos["RevIaConfianzaN", confianza]
                                    </span>
                                }
    </text>;

    /// <summary>
    /// «Estado en la plataforma» de la fila por Plataforma CAE (P-1, D-54): el estado de esa acreditación y, si está rechazada,
    /// «Motivo: …» en una línea cortada con «…» y el motivo entero en el tooltip. El Cliente empresarial del canal tiene
    /// columna propia. Una fila del grupo «Sin Plataforma CAE» no tiene acreditación y no pinta nada.
    /// </summary>
    private RenderFragment<DocumentoListaDto> CeldaEnPlataforma => context => @<text>
                                @if (context.Grupo?.Acreditacion is { } acreditacion)
                                {
                                    <span class="documentos-en-plataforma">
                                        <Badge Tono="TonoEnPlataforma(acreditacion)" Tamano="TamanoBadge.Pequeno">@TextoEnPlataforma(acreditacion)</Badge>
                                        @if (acreditacion.Estado == EstadoAcreditacion.Rechazada && !string.IsNullOrWhiteSpace(acreditacion.UltimoMotivoRechazo))
                                        {
                                            @* El rol Cliente ve el estado, no el motivo (decisión de Chris del 2026-11-12, opción B): el
                                               servidor ya no se lo manda; la página tampoco lo pinta aunque llegara. *@
                                            <AuthorizeView Roles="@RolesQueAbrenPortal" Context="autorizacionMotivo">
                                                <span class="documentos-en-plataforma-motivo" title="@Textos["EnPlataformaMotivo", acreditacion.UltimoMotivoRechazo]">@Textos["EnPlataformaMotivo", acreditacion.UltimoMotivoRechazo]</span>
                                            </AuthorizeView>
                                        }
                                    </span>
                                }
    </text>;

    /// <summary>Propietario sin las insignias de Plataformas CAE: por Plataforma CAE ya es el grupo, y por tipo tiene columna propia.</summary>
    private RenderFragment<DocumentoListaDto> CeldaPropietarioSolo => context => @<text>
                                    <span class="documentos-propietario">
                                        @* D-54: una línea cortada con «…» y el nombre entero en el tooltip. *@
                                        <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida documentos-propietario-nombre" title="@context.PropietarioNombre" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@context.PropietarioNombre" Termino="@_busqueda" /></button>
                                    </span>
    </text>;

    /// <summary>
    /// «Nombre en la plataforma» (D-54): una sola línea, cortada con «…», con el nombre entero y el tipo de TALVEG en el tooltip.
    /// Abre la vista rápida, como el nombre del Documento en el resto de agrupaciones.
    /// </summary>
    private RenderFragment<DocumentoListaDto> CeldaNombreEnPlataforma => context => @<text>
                                    <button type="button" class="enlace-nombre-fila nombre-fila-entidad nombre-abre-vista-rapida documentos-nombre-una-linea" title="@TituloNombreEnPlataforma(context)" @onclick="() => AbrirPanelAsync(context.Id)"><TextoResaltado Texto="@NombreEnPlataforma(context)" Termino="@_busqueda" /></button>
    </text>;

    private RenderFragment<DocumentoListaDto> CeldaClienteEmpresarial => context => @<text>
                                    @if (context.Grupo?.Acreditacion is { } acreditacion)
                                    {
                                        <span class="documentos-cliente-empresarial" title="@acreditacion.ClienteEmpresarialNombre">@acreditacion.ClienteEmpresarialNombre</span>
                                    }
    </text>;

    /// <summary>
    /// «Plataformas CAE» de la fila por tipo (D-54): logotipo pequeño (o el icono genérico), nombre y el estado de cada
    /// acreditación del Documento, en una línea. Sin acreditaciones, vacío.
    /// </summary>
    private RenderFragment<DocumentoListaDto> CeldaPlataformasDelTipo => context => @<text>
                                    @if (context.Acreditaciones.Count > 0)
                                    {
                                        <span class="documentos-plats documentos-plataformas-tipo" title="@TituloPlataformasDelTipo(context)">
                                            @foreach (var acreditacion in PlataformasDeLaFila(context))
                                            {
                                                @ChipPlataforma(acreditacion)
                                            }
                                        </span>
                                    }
    </text>;

    /// <summary>
    /// Una Plataforma CAE de un Documento, como en los artboards: logotipo de 16 px, nombre y «· Estado» en gris, con la inicial
    /// en mayúscula (D-22: «Validada» en todas partes). Sin motivo de rechazo ni «Abrir portal».
    /// </summary>
    private RenderFragment ChipPlataforma(AcreditacionResumenDto acreditacion) => @<span class="documentos-plat" @key="acreditacion.Id">
        @LogoOIcono(LogoDePlataformaPorNombre(acreditacion.NombrePlataforma), grande: false)
        <span class="documentos-plat-nombre">@acreditacion.NombrePlataforma</span>
        <span class="documentos-plat-estado">· @EstadoAcreditacionUi.TextoCapitalizado(acreditacion.Estado)</span>
    </span>;

    /// <summary>
    /// El logotipo de la Plataforma CAE (de decoración: el nombre va al lado) o, sin logotipo, el icono genérico. Como en los
    /// artboards: cuadrado con borde de 1 px y radio de 3 px, de 22 px en la cabecera del grupo y de 16 px en la fila.
    /// </summary>
    private static RenderFragment LogoOIcono(string? ruta, bool grande = true) => @<text>
        @if (ruta is not null)
        {
            <img class="@($"documentos-logo-plataforma {(grande ? "documentos-logo-plataforma-medio" : "documentos-logo-plataforma-pequeno")}")" src="@ruta" alt="" aria-hidden="true" loading="lazy" />
        }
        else
        {
            <span class="documentos-logo-plataforma documentos-logo-plataforma-generico" aria-hidden="true"><Icono Nombre="plataforma" Tamano="@(grande ? TamanoIcono.Medio : TamanoIcono.Pequeno)" /></span>
        }
    </text>;

    /// <summary>
    /// Cabecera de un grupo «Por tipo de documento» (D-54): icono de documentos, el tipo, «Ámbito · N documentos», los
    /// recuentos de vencidos, urgentes y por vencer de sus Documentos y «Tipo 360» (solo roles de gestión, como el
    /// botón 360 de la fila). Los nombres por Plataforma CAE (B2) no existen todavía como dato y no se pintan.
    /// </summary>
    private RenderFragment CabeceraGrupoPorTipo(string clave, List<DocumentoListaDto> filas, bool abierto)
    {
        var primera = filas[0];
        var nombre = NombreDelTipo(primera);
        var ambitos = string.Join(", ", filas.Select(f => f.Ambito).Distinct().Order().Select(EtiquetaAmbitoListado));
        var subtitulo = Textos["GrupoTipoSubtitulo", ambitos, Textos[filas.Count == 1 ? "GrupoDocumentoUno" : "GrupoDocumentos", filas.Count].Value].Value;
        return @<tr class="documentos-cabecera-grupo documentos-cabecera-grupo-tipo" data-grupo="@clave"><th colspan="@ColumnasTabla" scope="rowgroup">
            <div class="documentos-cabecera-vinculo">
                @* Una sola línea (artboard Agrupar-tipo): nombre en 600, «Trabajador · 3 documentos» en gris, insignias y «Tipo 360 ↗» a la derecha. *@
                <CabeceraGrupoLista Maqueta="true" Nombre="@nombre" Total="filas.Count" Resumen="ResumenDeTipo(filas)" Subtitulo="@subtitulo"
                                    Abierto="abierto" OnAlternar="() => AlternarGrupoPorVinculo(clave)">
                    <Marca><span class="documentos-logo-plataforma documentos-logo-plataforma-generico" aria-hidden="true"><Icono Nombre="documentos" Tamano="TamanoIcono.Medio" /></span></Marca>
                </CabeceraGrupoLista>
                @if (primera.TipoDocumentoId != Guid.Empty)
                {
                    <span class="documentos-cabecera-vinculo-acciones">
                        <AuthorizeView Roles="@TipoDocumentoDetalle.RolesDeLaPagina" Context="autorizacionTipo">
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="documentos-tipo-360"
                                   Href="@($"/documentos/tipos/{primera.TipoDocumentoId}")"
                                   aria-label="@Textos["GrupoTipo360Etiqueta", nombre]">@Textos["GrupoTipo360"]<Icono Nombre="abrir" Tamano="TamanoIcono.Pequeno" /></Boton>
                        </AuthorizeView>
                    </span>
                }
            </div>
        </th></tr>;
    }

    /// <summary>
    /// Cabecera de un grupo por Plataforma CAE o por Cliente empresarial (P-1): nombre, recuentos del servidor sobre todo el
    /// universo filtrado (un cero no se pinta) y, por Plataforma CAE, «Anotar vigencia (N)» con filas «Sin vigencia»
    /// (con la selección múltiple inactiva, todas las del grupo; activa, solo las marcadas) (solo con escritura, el mismo
    /// comando y la misma autorización que la pestaña Plataformas CAE) y
    /// «Abrir portal» con la dirección del canal, solo http(s), en pestaña nueva.
    /// </summary>
    private RenderFragment CabeceraGrupoPorVinculo(string clave, List<DocumentoListaDto> filas, bool abierto)
    {
        var resumen = ResumenDe(clave);
        var nombre = NombreDeGrupo(clave);
        var esGrupoSin = clave == ObtenerDocumentosQuery.GrupoSin;
        // Solo con el grupo abierto: plegado, sus filas no se ven y no se anota lo que no se ve (una selección hecha en otro grupo).
        var anotables = AgrupadaPorPlataforma && abierto ? SinVigenciaAnotables(filas) : [];
        var portal = AgrupadaPorPlataforma && !esGrupoSin ? UrlPortalCae.Normalizar(resumen?.UrlPortal) : null;
        var total = resumen?.Total ?? filas.Count;
        var documentos = Textos[total == 1 ? "GrupoDocumentoUno" : "GrupoDocumentos", total].Value;
        // «Sin Cliente» no tiene a quién nombrar, pero sigue diciendo cuántos Documentos agrupa (con Maqueta ya no hay «· N»).
        var subtitulo = AgrupadaPorPlataforma ? (esGrupoSin ? documentos : null)
            : esGrupoSin ? documentos
            : Textos["GrupoClienteEmpresarialDocumentos", documentos].Value;
        return @<tr class="documentos-cabecera-grupo documentos-cabecera-grupo-vinculo" data-grupo="@clave"><th colspan="@ColumnasTabla" scope="rowgroup">
            <div class="documentos-cabecera-vinculo">
                <CabeceraGrupoLista Maqueta="true" Nombre="@nombre" Total="total" EnPagina="filas.Count" Resumen="ResumenVisible(resumen)"
                                    Subtitulo="@subtitulo" Abierto="abierto" OnAlternar="() => AlternarGrupoPorVinculo(clave)">
                    <Marca>
                        @if (esGrupoSin)
                        {
                            @* «Sin Plataforma CAE» y «Sin Cliente» no llevan icono (artboards). *@
                        }
                        else if (AgrupadaPorPlataforma)
                        {
                            @* Logotipo de la Plataforma CAE; sin marca en el repositorio, el icono genérico (como Metacontratas en el artboard). *@
                            @LogoOIcono(LogoDePlataformaPorId(clave))
                        }
                        else
                        {
                            <span class="documentos-logo-plataforma documentos-logo-plataforma-generico" aria-hidden="true"><Icono Nombre="clientes" Tamano="TamanoIcono.Medio" /></span>
                        }
                    </Marca>
                </CabeceraGrupoLista>
                @if (anotables.Count > 0 || portal is not null)
                {
                    <span class="documentos-cabecera-vinculo-acciones">
                        @if (anotables.Count > 0)
                        {
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" class="documentos-anotar-vigencia"
                                       OnClick="() => _anotarVigencia.Abrir(anotables, nombre)">@Textos["GrupoAnotarVigencia", anotables.Count]</Boton>
                            </SoloConEscritura>
                        }
                        @if (portal is not null)
                        {
                            @* La dirección del canal, nunca la credencial: igual que en la pestaña Plataformas CAE. El servidor ya
                               no la manda al rol Cliente (lee, no opera); la página tampoco la ofrece aunque llegara. *@
                            <AuthorizeView Roles="@RolesQueAbrenPortal" Context="autorizacionPortal">
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="documentos-abrir-portal"
                                       Href="@portal" target="_blank" rel="noopener noreferrer"
                                       aria-label="@TextosPlataformaAcreditacion.Formato("AbrirPortalEtiqueta", nombre)">@Textos["GrupoAbrirPortal"]<Icono Nombre="abrir" Tamano="TamanoIcono.Pequeno" /></Boton>
                            </AuthorizeView>
                        }
                    </span>
                }
            </div>
        </th></tr>;
    }
}

@code {
    private TemplateColumn<DocumentoListaDto>? _columnaTipo;
    private TemplateColumn<DocumentoListaDto>? _columnaEstado;

    private Task OrdenarGrupoAsync(ColumnBase<DocumentoListaDto>? columna) =>
        _grid is not null && columna is not null ? _grid.SortByColumnAsync(columna) : Task.CompletedTask;

    private string AriaOrdenGrupo(params string[] campos) =>
        !_orden.Es(campos) ? "none" : _orden.Direccion == SortDirection.Descending ? "descending" : "ascending";
}
