@page "/documentos/importar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inject NavigationManager Navigation

@code {
    // La entrada documental abre el paso 2 del asistente unificado.
    // (/importacion, Features/Importacion/Pages/Importacion.razor — Plantillas["documentos"]).
    // Se redirige en vez de eliminar la ruta para no romper un marcador guardado.
    protected override void OnInitialized() =>
        Navigation.NavigateTo("/importacion?plantilla=documentos&flujo=documentos", forceLoad: true, replace: true);
}
