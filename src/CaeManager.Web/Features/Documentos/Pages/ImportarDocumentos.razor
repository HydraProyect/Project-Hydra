@page "/documentos/importar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@using CaeManager.Web.Features.Importacion

<PageTitle>Importar documentos — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Importar documentos</h1>
        <a class="enlace-exportar" href="/documentos/plantilla.xlsx"><Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> Descargar plantilla</a>
    </div>
    <p class="descripcion-importacion">
        Sube en bloque las fechas de emisión de documentos ya conocidas: descarga la plantilla, complétala
        (DNI, tipo de documento y fecha de emisión por fila) y súbela aquí. El trabajador y el tipo de
        documento deben existir ya en el sistema. Se analiza primero sin escribir nada — revisa qué se va a
        crear antes de confirmar.
    </p>

    @if (_resultado is null)
    {
        <Tarjeta Titulo="1. Selecciona el archivo" Class="tarjeta-importacion">
            <InputFile OnChange="ManejarArchivoSeleccionadoAsync" accept=".xlsx" />
            @if (_nombreArchivo is not null)
            {
                <p class="nombre-archivo">@_nombreArchivo</p>
            }
        </Tarjeta>

        @if (_mensajeError is not null)
        {
            <div class="alerta-formulario" role="alert">@_mensajeError</div>
        }

        @if (_analizando)
        {
            <ProgresoConMensajes Visible="true" Mensajes="MensajesAnalizando" />
        }
        else if (_plan is not null)
        {
            <Tarjeta Titulo="2. Revisa el plan de importación" Class="tarjeta-importacion">
                <div class="rejilla-resumen-importacion">
                    <TarjetaMetrica Etiqueta="Documentos nuevos" Valor="@_plan.Documentos.Count(d => !d.YaExiste).ToString()" />
                    <TarjetaMetrica Etiqueta="Ya existían" Valor="@_plan.Documentos.Count(d => d.YaExiste).ToString()" />
                </div>

                @if (_plan.Omitidos.Count > 0)
                {
                    <h3 class="titulo-seccion-importacion">Omitidos (@_plan.Omitidos.Count) — no se importan</h3>
                    <TablaItemsImportacion Items="_plan.Omitidos" Tono="TonoBadge.Peligro" />
                }

                @if (_plan.Documentos.Count == 0)
                {
                    <p class="texto-vacio-seccion">No se encontró ninguna fila para importar.</p>
                }
                else
                {
                    <div class="acciones-formulario">
                        <Boton OnClick="ConfirmarImportacionAsync" Cargando="_importando">Confirmar importación</Boton>
                    </div>

                    <ProgresoConMensajes Visible="_importando" Mensajes="MensajesImportando" />
                }
            </Tarjeta>
        }
    }
    else
    {
        <Tarjeta Titulo="Importación completada" Class="tarjeta-importacion">
            <div class="rejilla-resumen-importacion">
                <TarjetaMetrica Etiqueta="Documentos creados" Valor="@_resultado.DocumentosCreados.ToString()" Tono="TonoBadge.Exito" />
            </div>

            @if (_resultado.Omitidos.Count > 0)
            {
                <h3 class="titulo-seccion-importacion">Omitidos (@_resultado.Omitidos.Count)</h3>
                <TablaItemsImportacion Items="_resultado.Omitidos" Tono="TonoBadge.Peligro" />
            }

            <div class="acciones-formulario">
                <Boton Variante="VarianteBoton.Secundario" OnClick="EmpezarDeNuevo">Nueva importación</Boton>
                <a class="enlace-volver" href="/documentos">Volver a Documentos</a>
            </div>
        </Tarjeta>
    }
</div>
