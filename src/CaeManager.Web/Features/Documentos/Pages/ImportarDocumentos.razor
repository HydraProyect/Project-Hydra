@page "/documentos/importar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = CaeManager.Infrastructure.Identity.Roles.Administrador)]
@inject NavigationManager Navigation

@code {
    // La plantilla de Documentos es hoy el paso 1 del asistente unificado
    // (/importacion, Features/Importacion/Pages/Importacion.razor — Plantillas["documentos"]).
    // Se redirige en vez de eliminar la ruta para no romper un marcador guardado (H-1).
    protected override void OnInitialized() =>
        Navigation.NavigateTo("/importacion?plantilla=documentos", forceLoad: true, replace: true);
}
