@*
    Selector del tipo de documento con búsqueda y agrupado (D-31 del recorrido en
    vivo del 2026-10-01): un <select> plano de ~45 tipos obligaba a recorrerlos
    todos. Es un solo control, el combobox del kit (CampoSelectAvanzado): se escribe
    en él y la misma lista se filtra mientras se escribe (por nombre y alias, sin
    distinguir mayúsculas ni tildes). Los grupos dicen cuánto pesa cada tipo: lo que
    se pide siempre, lo que depende de la actividad y el resto; el grupo que el
    filtro vacía desaparece. El tipo elegido sigue en el disparador mientras se busca,
    así que escribir no vacía la selección.
*@
@using CaeManager.Application.TiposDocumento.Queries.ObtenerTiposDocumento
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosSelectorTipoDocumento> Textos

<CampoSelectAvanzado Etiqueta="@Textos["EtiquetaTipo"]" Marcador="@Textos["OpcionVacia"]"
                     Valor="@Valor" ValorChanged="ValorChanged" Opciones="@_opciones"
                     TextoSinResultados="@Textos["SinCoincidencias"]" />

@code {
    private IReadOnlyList<OpcionSelect> _opciones = [];
    private IReadOnlyList<TipoDocumentoListaDto>? _tiposDeOpciones;

    [Parameter, EditorRequired] public IReadOnlyList<TipoDocumentoListaDto> Tipos { get; set; } = [];
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_tiposDeOpciones, Tipos)) return;

        _tiposDeOpciones = Tipos;
        _opciones = Opciones(Tipos, clave => Textos[clave]);
    }

    /// <summary>
    /// Las opciones del combobox, agrupadas por <see cref="RequisitoDocumental"/> (siempre, según actividad, otros) y
    /// ordenadas dentro de cada grupo por orden y nombre. Los alias viajan para que el filtro también los encuentre.
    /// </summary>
    internal static IReadOnlyList<OpcionSelect> Opciones(IReadOnlyList<TipoDocumentoListaDto> tipos, Func<string, string> texto) =>
        new (RequisitoDocumental Requisito, string Rotulo)[]
            {
                (RequisitoDocumental.Si, texto("GrupoSiempre")),
                (RequisitoDocumental.Condicional, texto("GrupoCondicional")),
                (RequisitoDocumental.No, texto("GrupoOtros")),
            }
            .SelectMany(g => tipos.Where(t => t.Requerido == g.Requisito).OrderBy(t => t.Orden).ThenBy(t => t.Nombre)
                .Select(t => new OpcionSelect(t.Id.ToString(), t.Nombre, Grupo: g.Rotulo, Alias: t.Aliases)))
            .ToList();
}
