@*
    Pestaña "Reclamaciones" de /documentos (Parte XVI PROMPT 03: "seguimiento",
    tabla de lotes YA ENVIADOS). Por defecto muestra ese historial
    (ObtenerReclamacionesEnviadasQuery); la subvista "+ Nueva reclamación" (pestaña) revela la
    vista de COMPONER/ENVIAR que ya existía aquí (MVP1, decisión del usuario
    2026-08-08: agrupa por Cliente los Documentos de sus Trabajadores que
    vencen en los próximos 3 meses o ya vencieron, para reclamarlos en un
    único correo por Cliente en vez de uno por Documento) — no se sustituye,
    se reordena: el historial es lo que se consulta más a menudo, componer
    es la excepción puntual.

    La columna "Recordatorios" del mockup queda deliberadamente fuera: exige
    una entidad nueva persistida (RecordatorioReclamacion, hija de
    ReclamacionDocumental — que es append-only por diseño explícito, no
    admite un contador mutable) más su migración y comando de envío. Es una
    decisión de alcance aparte, no se inventa un contador falso.
*@
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Application.Reclamaciones.Commands.EnviarReclamacion
@using CaeManager.Application.Reclamaciones.Commands.EnviarReclamacionEmpresa
@using CaeManager.Application.Reclamaciones.Commands.EnviarReclamacionEmpresaEmpleadora
@using CaeManager.Application.Reclamaciones.Queries.ObtenerLoteReclamacionPorFiltro
@using CaeManager.Application.Reclamaciones
@using CaeManager.Application.Reclamaciones.Queries.ObtenerReclamacionesEnviadas
@using CaeManager.Application.Reclamaciones.Commands.PrepararVistaPreviaReclamacion
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@using CaeManager.Infrastructure.Comunicaciones
@using Microsoft.Extensions.Options
@implements IDisposable
@inject IStringLocalizer<TextosDocumentos> Textos
@inject IMediator Mediator
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationState
@inject IOptions<ComunicacionesOptions> OpcionesComunicaciones

<Pestanas Definiciones="Subvistas" PestanaActiva="@_vista" PestanaActivaChanged="CambiarVistaAsync" EtiquetaGrupo="Reclamaciones">
@if (_vista == "historial")
{
    @* Flujos 04 (maqueta 20-10): el historial se presenta con título y una línea que dice qué es. *@
    <div class="reclamaciones-historial-cabecera">
        <h3>@Textos["RecHistorialTitulo"]</h3>
        <p class="texto-vacio-seccion">@Textos["RecHistorialSubtitulo"]</p>
    </div>
    @if (_cargandoHistorial)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_errorHistorial)
    {
        <EstadoVacio Titulo="@Textos["RecHistorialErrorTitulo"]" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarHistorialAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_historial.Count == 0)
    {
        <EstadoVacio Titulo="@Textos["RecHistorialVacioTitulo"]" Descripcion="@Textos[_puedeEscribir ? "RecHistorialVacioDetalle" : "RecHistorialVacioDetalleLectura"]" />
    }
    else
    {
        <div class="tabla-documentos-requeridos" role="table" aria-label="Reclamaciones enviadas">
            <div class="documentos-requeridos-cabecera" role="row">
                <span role="columnheader">Destinatario</span>
                <span role="columnheader">Enviada</span>
                <span role="columnheader">Documentos</span>
                <span role="columnheader">Estado</span>
                <span role="columnheader" class="columna-accion">Acción</span>
            </div>
            @foreach (var reclamacion in _historial)
            {
                <div class="fila-documento-requerido" role="row" @key="reclamacion.Id">
                    <span class="celda-documento-nombre" role="cell">
                        @reclamacion.TitularRazonSocial
                        <span class="fila-trabajador-fraccion">@reclamacion.DestinatarioEmail</span>
                    </span>
                    <span role="cell">@reclamacion.FechaEnvioUtc.EnHoraPeninsular().ToString("dd/MM/yyyy HH:mm")</span>
                    <span role="cell">@reclamacion.TotalDocumentos</span>
                    <span role="cell">
                        @if (reclamacion.SinRespuesta is null)
                        {
                            <span class="detalle-tecnico">Sin buzón conectado</span>
                        }
                        else if (reclamacion.SinRespuesta.Value)
                        {
                            <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">Sin respuesta</Badge>
                        }
                        else
                        {
                            <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Respondida</Badge>
                        }
                    </span>
                    <span class="columna-accion" role="cell">
                        @* Un lote a la Empresa empleadora cuyos Trabajadores ya no caen en una
                           misma Delegación no puede reenviarse tal cual: no se ofrece. *@
                        @if (reclamacion.Reenviable)
                        {
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                       Cargando="_reenviandoId == reclamacion.Id" OnClick="() => AbrirRevisionReenvioAsync(reclamacion)">
                                    Reclamar de nuevo
                                </Boton>
                            </SoloConEscritura>
                        }
                        @* Con el módulo apagado (Comunicaciones:Activo) /comunicaciones redirige a
                           «no encontrado»: no se ofrece, igual que el menú oculta su entrada. *@
                        @if (reclamacion.ConversacionId is not null && OpcionesComunicaciones.Value.Activo)
                        {
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                   OnClick='() => NavigationManager.NavigateTo($"/comunicaciones?conversacion={reclamacion.ConversacionId}")'>
                                Ver hilo
                            </Boton>
                        }
                    </span>
                </div>
            }
        </div>

        <PaginadorSimple PaginaActual="_paginaHistorial" TotalPaginas="TotalPaginasHistorial" TotalElementos="_totalHistorial"
                          Etiqueta="reclamación(es)" PaginaActualChanged="CambiarPaginaHistorialAsync"
                          TamanoPagina="_tamanoPaginaHistorial" TamanoPaginaChanged="CambiarTamanoPaginaHistorialAsync" />
    }
}
else if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error)
{
    <EstadoVacio Titulo="No pudimos cargar las reclamaciones" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_lotes.Count == 0)
{
    <EstadoVacio Titulo="Nada pendiente de reclamar" Descripcion="Ningún Cliente tiene documentos que venzan en los próximos 3 meses." />
}
else
{
    var clavesLotes = new ClavesDeHermanos();
    @foreach (var lote in _lotes)
    {
        var seleccionados = _seleccionPorLote[lote.Clave];
        var enviando = _enviandoLote == lote.Clave;

        <Tarjeta @key="clavesLotes.De(lote.Clave)" Titulo="@lote.TituloVisible" Class="tarjeta-reclamacion">
            <AccionesHeader>
                <SoloConEscritura><Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Deshabilitado="@(seleccionados.Count == 0 || ContactosMarcados(lote.Clave).Count == 0)"
                       Cargando="enviando" OnClick="() => AbrirRevision(lote)"
                       title="@TituloBotonEnviar(lote, seleccionados.Count)">
                    Enviar reclamación (@seleccionados.Count)
                </Boton></SoloConEscritura>
            </AccionesHeader>

            <ChildContent>
                <p class="texto-vacio-seccion">
                    @(lote.UltimaReclamacionFechaUtc is null
                        ? "Nunca reclamado."
                        : $"Última reclamación: {FormatearHaceTiempo(lote.UltimaReclamacionFechaUtc.Value)}.")
                    @* Lleva a la bandeja filtrada por este cliente, no al hilo
                       concreto: el deep-link a una conversación no existe todavía
                       (hueco declarado en Project-Hydra-Negocio/tecnico/05_WORKSPACE_PATTERNS.md § 3.6) y no se
                       finge aquí. Solo se ofrece si la última reclamación llegó a
                       tener conversación y el módulo de Comunicaciones está activo. *@
                    @if (lote.UltimaReclamacionConversacionId is not null && lote.EmpresaEmpleadora is null && OpcionesComunicaciones.Value.Activo)
                    {
                        <a href="@($"/comunicaciones?cliente={lote.TitularId}")">Ver en Comunicaciones</a>
                    }
                </p>

                @* A quién se le pide: la agenda del cliente (y la del centro, si
                   la reclamación va acotada a uno), nunca los usuarios de
                   portal — ver IResolucionDestinatariosAgendaService. La lista
                   sale marcada entera: desmarcar es la excepción, no el paso
                   obligatorio. *@
                @* Un Trabajador de Empresa se reclama a su Empresa empleadora: la tarjeta dice a qué Delegación va, o que va a la agenda de la Empresa. *@
                @if (lote.EmpresaEmpleadora is { } destino)
                {
                    <p class="reclamacion-motivo reclamacion-destino-delegacion">
                        @(destino.DelegacionEmpresaNombre is { } delegacion
                            ? Textos["RecDestinoDelegacionEmpresa", delegacion].Value
                            : Textos["RecDestinoEmpresa"].Value)
                    </p>
                }
                @if (lote.Destinatarios is not { Count: > 0 })
                {
                    <div class="alerta-formulario" role="alert">
                        @(EsLoteDeDelegacionEmpresa(lote)
                            ? Textos["RecDelegacionEmpresaSinContactoVisible"].Value
                            : "No hay ningún contacto en la agenda al que reclamar esta documentación.")
                        @if (!EsLoteDeDelegacionEmpresa(lote))
                        {
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                       OnClick="() => AbrirAltaContacto(lote)">
                                    <Icono Nombre="contacto" Tamano="TamanoIcono.Pequeno" /> Añadir contacto
                                </Boton>
                            </SoloConEscritura>
                        }
                    </div>
                }
                else
                {
                    <fieldset class="reclamacion-destinatarios">
                        <legend>Se solicita a</legend>
                        @foreach (var destinatario in lote.Destinatarios)
                        {
                            <label class="campo-checkbox" @key="destinatario.ContactoId">
                                <input type="checkbox"
                                       checked="@ContactosMarcados(lote.Clave).Contains(destinatario.ContactoId)"
                                       @onchange="e => AlternarContacto(lote.Clave, destinatario.ContactoId, (bool)e.Value!)" />
                                <span>@destinatario.Nombre — @destinatario.Email</span>
                                <span class="reclamacion-motivo">@string.Join(", ", destinatario.MotivoTipos)</span>
                            </label>
                        }
                        @if (!EsLoteDeDelegacionEmpresa(lote))
                        {
                            <SoloConEscritura>
                                <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                       OnClick="() => AbrirAltaContacto(lote)">
                                    <Icono Nombre="contacto" Tamano="TamanoIcono.Pequeno" /> Añadir contacto
                                </Boton>
                            </SoloConEscritura>
                        }
                    </fieldset>
                }

                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Trabajador</th>
                            <th>Documento</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var documento in lote.Documentos)
                        {
                            <tr @key="documento.DocumentoId">
                                <td>
                                    <input type="checkbox" aria-label="@($"Incluir {documento.TipoDocumentoNombre} de {documento.TrabajadorNombre}, vencimiento {documento.FechaVencimiento:dd/MM/yyyy}, en la reclamación")" checked="@seleccionados.Contains(documento.DocumentoId)"
                                           @onchange="e => AlternarSeleccion(lote.Clave, documento.DocumentoId, (bool)e.Value!)" />
                                </td>
                                <td>@documento.TrabajadorNombre</td>
                                <td>@documento.TipoDocumentoNombre</td>
                                <td>@documento.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" ConIcono>@EstadoDocumentoUi.Texto(documento.Estado)</Badge></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ChildContent>
        </Tarjeta>
    }
}
</Pestanas>

@* Revisión previa al envío (D-01): un correo externo no se puede deshacer, así
   que antes de mandarlo se enseñan destinatarios, asunto y texto exactos (el
   asunto y el cuerpo salen de las mismas funciones que usa el handler) y hace
   falta una confirmación explícita. *@
<Modal Visible="_loteEnRevision is not null" VisibleChanged="CerrarRevision" Titulo="@Textos["RecRevisionTitulo"]"
       Ancho="AnchoModal.Grande" CerrarAlHacerClicFuera="_enviandoLote is null">
    <ChildContent>
        @if (_loteEnRevision is { } revisado)
        {
            var destinatariosRevision = DestinatariosMarcados(revisado);
            <dl class="reclamacion-revision">
                <dt>@Textos["RecRevisionPara"]</dt>
                <dd>@string.Join(", ", destinatariosRevision.Select(d => $"{d.Nombre} <{d.Email}>"))</dd>
                <dt>@Textos["RecRevisionAsunto"]</dt>
                <dd>@EnviarReclamacionCommandHandler.ConstruirAsunto(revisado.TitularNombre)</dd>
                <dt>@Textos["RecRevisionTexto"]</dt>
                <dd class="reclamacion-revision-cuerpo">@((MarkupString)CuerpoRevision(revisado))</dd>
            </dl>
            <p class="texto-vacio-seccion">@Textos["RecRevisionAviso", destinatariosRevision.Count]</p>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_enviandoLote is not null" OnClick="() => CerrarRevision(false)">@Textos["RecVolver"]</Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="_enviandoLote is not null" OnClick="ConfirmarEnvioAsync">@Textos["RecConfirmarEnviar"]</Boton>
    </Pie>
</Modal>

@* «Reclamar de nuevo» también es un correo externo no deshacible: misma revisión
   completa, pero con lo que resuelve el propio envío (PrepararVistaPreviaReclamacionCommand
   llama a la misma implementación que el handler de envío). *@
<Modal Visible="_vistaPreviaReenvio is not null" VisibleChanged="CerrarRevisionReenvio" Titulo="@Textos["RecReenvioTitulo"]"
       Ancho="AnchoModal.Grande" CerrarAlHacerClicFuera="_reenviandoId is null">
    <ChildContent>
        @if (_vistaPreviaReenvio is { } previa)
        {
            <dl class="reclamacion-revision">
                <dt>@Textos["RecRevisionPara"]</dt>
                <dd>@string.Join(", ", previa.Destinatarios.Select(d => $"{d.Nombre} <{d.Email}>"))</dd>
                <dt>@Textos["RecRevisionAsunto"]</dt>
                <dd>@previa.Asunto</dd>
                <dt>@Textos["RecRevisionTexto"]</dt>
                <dd class="reclamacion-revision-cuerpo">@((MarkupString)previa.CuerpoHtml)</dd>
            </dl>
            @* Flujos 04: aviso de irreversibilidad, ámbar y sin «Deshacer» al enviar. *@
            <div class="aviso-irreversible" role="note">
                <strong>@Textos["RecReenvioAvisoTitulo"]</strong>
                @* Con el módulo apagado (Comunicaciones:Activo) no hay hilo donde quede: no se promete. *@
                <span>@Textos[OpcionesComunicaciones.Value.Activo ? "RecReenvioAvisoTexto" : "RecReenvioAvisoTextoSinComunicaciones"]</span>
            </div>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_reenviandoId is not null" OnClick="() => CerrarRevisionReenvio(false)">@Textos["RecReenvioCancelar"]</Boton>
        @* El diálogo solo se abre desde «Reclamar de nuevo» (SoloConEscritura); se envuelve también aquí para que el rol de Consulta nunca vea un «Enviar reclamación» habilitado. *@
        <SoloConEscritura><Boton Variante="VarianteBoton.Primario" Cargando="_reenviandoId is not null" OnClick="ConfirmarReenvioAsync">@Textos["RecReenvioEnviar"]</Boton></SoloConEscritura>
    </Pie>
</Modal>

@* Alta inline: el gestor que ve que falta el destinatario lo crea sin salir
   de la pantalla y la lista se recarga con él ya resuelto. *@
<ModalContactoAgenda Visible="_altaContactoVisible" VisibleChanged="v => _altaContactoVisible = v"
                     Tipo="_tipoAgendaAltaContacto" PropietarioId="_titularAltaContacto"
                     PredeterminadoPorDefecto="true" OnGuardado="_ => CargarAsync()" />

@code {
    private string _vista = "historial";
    private bool _puedeEscribir;

    /// <summary>
    /// D-30: «Enviadas» (subvista) y «+ Nueva reclamación» (subvista de redactar, no una acción que
    /// ejecuta nada) eran dos botones idénticos entre sí; ahora son pestañas. La de redactar solo
    /// existe si el rol puede escribir (misma lista que SoloConEscritura).
    /// </summary>
    private IReadOnlyList<PestanaDefinicion> Subvistas => _puedeEscribir
        ? [new("historial", "Enviadas"), new("componer", "+ Nueva reclamación")]
        : [new("historial", "Enviadas")];
    private bool _cargandoHistorial = true;
    private bool _errorHistorial;
    private IReadOnlyList<ReclamacionEnviadaDto> _historial = [];
    private int _paginaHistorial = 1;
    private int _tamanoPaginaHistorial = 20;
    private int _totalHistorial;
    private Guid? _reenviandoId;
    private bool _componerCargadoUnaVez;

    private int TotalPaginasHistorial => Math.Max(1, (int)Math.Ceiling(_totalHistorial / (double)_tamanoPaginaHistorial));

    private bool _cargando = true;
    private bool _error;
    private IReadOnlyList<LoteReclamacionAgrupadoDto> _lotes = [];
    private readonly Dictionary<string, HashSet<Guid>> _seleccionPorLote = [];
    private readonly Dictionary<string, HashSet<Guid>> _contactosPorLote = [];
    private string? _enviandoLote;
    private bool _altaContactoVisible;
    private Guid _titularAltaContacto;
    private TipoPropietarioAgenda _tipoAgendaAltaContacto = TipoPropietarioAgenda.Cliente;

    // --- Ciclo de vida ---------------------------------------------------

    /// <summary>
    /// Se cancela al retirarse la pestaña: las consultas en curso dejan de
    /// trabajar para nadie y ninguna respuesta tardía repinta un componente ya
    /// desechado. Mismo patrón que <c>Documentos.razor.cs</c>.
    ///
    /// <para>
    /// Su <c>Token</c> se lee SIEMPRE antes del primer <c>await</c> del método
    /// que lo usa. Leerlo después deja que un <see cref="Dispose"/> intermedio
    /// lo haya desechado, y la lectura lanzaría <see cref="ObjectDisposedException"/>
    /// en una continuación donde nadie la recoge.
    /// </para>
    /// </summary>
    private readonly CancellationTokenSource _ciclo = new();
    private bool _desechado;

    /// <summary>
    /// Número de la última carga del historial. Cada carga captura el suyo
    /// ANTES del <c>await</c> y, al volver, solo escribe estado si sigue
    /// siendo la vigente: sin esto, la respuesta de una página ya abandonada
    /// (paginar rápido, o un reenvío que recarga al terminar) podía pisar la
    /// lista y el total de la pregunta que sí se está mirando.
    /// </summary>
    private int _cargaHistorialVigente;

    /// <summary>Misma idea que <see cref="_cargaHistorialVigente"/>, para la vista de componer/enviar.</summary>
    private int _cargaLotesVigente;

    public void Dispose()
    {
        if (_desechado)
            return;

        _desechado = true;
        _ciclo.Cancel();
        _ciclo.Dispose();
    }

    /// <summary>La respuesta del historial es de la pregunta vigente y la pestaña sigue viva.</summary>
    private bool EsVigenteHistorial(int carga) => !_desechado && carga == _cargaHistorialVigente;

    /// <summary>La respuesta de los lotes es de la pregunta vigente y la pestaña sigue viva.</summary>
    private bool EsVigenteLotes(int carga) => !_desechado && carga == _cargaLotesVigente;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        _puedeEscribir = CaeManager.Infrastructure.Identity.Roles.ConEscrituraCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(usuario.IsInRole);
        await CargarHistorialAsync();
    }

    /// <summary>La vista de componer/enviar carga sus lotes (recorre todos los clientes del tenant) solo la primera vez que se entra a ella, no en cada carga de la pestaña.</summary>
    private async Task CambiarVistaAsync(string vista)
    {
        _vista = vista;

        if (vista == "componer" && !_componerCargadoUnaVez)
        {
            _componerCargadoUnaVez = true;
            await CargarAsync();
        }
    }

    private async Task CargarHistorialAsync()
    {
        // El número de carga y el token se leen ANTES del await: leer
        // _ciclo.Token después dejaría que un Dispose intermedio lo hubiera
        // desechado, y la lectura lanzaría ObjectDisposedException en una
        // continuación que nadie observa.
        var carga = ++_cargaHistorialVigente;
        var token = _ciclo.Token;

        _cargandoHistorial = true;
        _errorHistorial = false;
        StateHasChanged();

        try
        {
            var resultado = await Mediator.Send(new ObtenerReclamacionesEnviadasQuery(_paginaHistorial, _tamanoPaginaHistorial), token);

            // La respuesta de una página ya abandonada no puede pisar la
            // lista ni el total de la pregunta que sí se está mirando.
            if (!EsVigenteHistorial(carga))
                return;

            _historial = resultado.Elementos;
            _totalHistorial = resultado.TotalElementos;
        }
        catch (Exception) when (!EsVigenteHistorial(carga))
        {
            // Una carga superada que falla (incluida la cancelación al
            // desecharse la pestaña) no es un error de la vigente.
        }
        catch (Exception)
        {
            _errorHistorial = true;
        }
        finally
        {
            if (EsVigenteHistorial(carga))
                _cargandoHistorial = false;
        }
    }

    private Task CambiarPaginaHistorialAsync(int pagina)
    {
        _paginaHistorial = pagina;
        return CargarHistorialAsync();
    }

    private Task CambiarTamanoPaginaHistorialAsync(int tamano)
    {
        _tamanoPaginaHistorial = tamano;
        _paginaHistorial = 1;
        return CargarHistorialAsync();
    }

    private async Task ReclamarDeNuevoAsync(ReclamacionEnviadaDto reclamacion, IReadOnlyList<Guid> contactoIds, string nombresDestinatarios)
    {
        // La guarda se comprueba AL ENTRAR, no al salir: el botón deshabilitado
        // no basta porque el segundo clic ya viajaba cuando se deshabilitó.
        if (_reenviandoId is not null || _desechado)
            return;

        // El token se lee antes del primer await, igual que en CargarHistorialAsync.
        var token = _ciclo.Token;
        _reenviandoId = reclamacion.Id;
        try
        {
            // El historial mezcla los dos titulares (Cliente y Empresa), así que
            // el reenvío se despacha por el ámbito que trae la propia fila: usar
            // EnviarReclamacionCommand para una reclamación de titular Empresa
            // buscaría documentos de Trabajador de un Cliente que no existe y
            // fallaría con "ninguno sigue siendo reclamable". Con titular Empresa,
            // lo pedido de sus Trabajadores («Gestionar») vuelve a su Delegación por
            // su propio comando: el de documentos de empresa no aceptaría esas líneas.
            var resultado = reclamacion.EmpresaEmpleadora is { } destino
                ? await Mediator.Send(new EnviarReclamacionEmpresaEmpleadoraCommand(reclamacion.TitularId, destino.DelegacionEmpresaId, reclamacion.DocumentoIds, contactoIds, reclamacion.Pendientes), token)
                : reclamacion.AmbitoTitular == AmbitoAplicacion.Empresa
                    ? await Mediator.Send(new EnviarReclamacionEmpresaCommand(reclamacion.TitularId, reclamacion.DocumentoIds, contactoIds, reclamacion.Pendientes), token)
                    : await Mediator.Send(new EnviarReclamacionCommand(reclamacion.TitularId, reclamacion.DocumentoIds, CentroId: null, ContactoIdsSeleccionados: contactoIds, Pendientes: reclamacion.Pendientes), token);

            // La pestaña pudo desecharse mientras el comando estaba en vuelo:
            // ni el toast ni la recarga pertenecen a un componente ya retirado.
            if (_desechado)
                return;

            if (resultado.EsFallido)
            {
                ToastService.MostrarError(resultado.Error);
                // Envío parcial: el fallo nombra a quien no la recibió, pero la
                // parte entregada ya está en el historial y tiene que verse.
                if (resultado.Error.Codigo == RegistroEnvioReclamacionService.CodigoEnvioParcial)
                    await CargarHistorialAsync();
                return;
            }

            // Sin «Deshacer»: el correo ya ha salido. Dice a quién llegó (la persona de la agenda), no solo la Empresa.
            ToastService.Mostrar(Textos["RecReenvioToast", nombresDestinatarios].Value, TonoToast.Exito);
            await CargarHistorialAsync();
        }
        finally
        {
            _reenviandoId = null;
        }
    }

    private async Task CargarAsync()
    {
        var carga = ++_cargaLotesVigente;
        var token = _ciclo.Token;

        _cargando = true;
        _error = false;
        StateHasChanged();

        try
        {
            // Los documentos de un Trabajador de Empresa se reclaman a su Empresa empleadora (decisión de Chris, 2026-10-18),
            // igual que en «Gestionar»; los de Subcontrata siguen yendo al Cliente.
            var lotes = await Mediator.Send(
                new ObtenerLoteReclamacionPorFiltroQuery(new FiltroLoteDocumental(AmbitoAplicacion.Trabajador, [], null), PorEmpresaEmpleadora: true), token);

            // La respuesta de una recarga ya abandonada no puede pisar los
            // lotes ni la selección de la pregunta que sí se está mirando.
            if (!EsVigenteLotes(carga))
                return;

            _lotes = lotes;
            _seleccionPorLote.Clear();
            _contactosPorLote.Clear();
            foreach (var lote in _lotes)
            {
                _seleccionPorLote[lote.Clave] = lote.Documentos.Select(d => d.DocumentoId).ToHashSet();
                _contactosPorLote[lote.Clave] =
                    (lote.Destinatarios ?? []).Select(d => d.ContactoId).ToHashSet();
            }
        }
        catch (Exception) when (!EsVigenteLotes(carga))
        {
            // Una carga superada que falla (incluida la cancelación al
            // desecharse la pestaña) no es un error de la vigente.
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            if (EsVigenteLotes(carga))
                _cargando = false;
        }
    }

    private void AlternarSeleccion(string claveLote, Guid documentoId, bool seleccionado)
    {
        var seleccionados = _seleccionPorLote[claveLote];
        if (seleccionado) seleccionados.Add(documentoId);
        else seleccionados.Remove(documentoId);
    }

    private HashSet<Guid> ContactosMarcados(string claveLote) =>
        _contactosPorLote.TryGetValue(claveLote, out var marcados) ? marcados : [];

    private void AlternarContacto(string claveLote, Guid contactoId, bool marcado)
    {
        if (!_contactosPorLote.TryGetValue(claveLote, out var marcados))
            _contactosPorLote[claveLote] = marcados = [];

        if (marcado) marcados.Add(contactoId);
        else marcados.Remove(contactoId);
    }

    /// <summary>El contacto nace en la agenda de quien recibe el lote: la Empresa empleadora o el Cliente. Un lote a una Delegación no admite alta: su contacto es el de la Delegación.</summary>
    private void AbrirAltaContacto(LoteReclamacionAgrupadoDto lote)
    {
        _titularAltaContacto = lote.TitularId;
        _tipoAgendaAltaContacto = lote.EmpresaEmpleadora is not null ? TipoPropietarioAgenda.Empresa : TipoPropietarioAgenda.Cliente;
        _altaContactoVisible = true;
    }

    private static bool EsLoteDeDelegacionEmpresa(LoteReclamacionAgrupadoDto lote) => lote.EmpresaEmpleadora?.DelegacionEmpresaId is not null;

    private LoteReclamacionAgrupadoDto? _loteEnRevision;
    private ReclamacionEnviadaDto? _reclamacionAReenviar;

    private ReclamacionPreparada? _vistaPreviaReenvio;
    private bool _cargandoVistaPrevia;

    private async Task AbrirRevisionReenvioAsync(ReclamacionEnviadaDto reclamacion)
    {
        if (_cargandoVistaPrevia || _reenviandoId is not null || _desechado)
            return;

        var token = _ciclo.Token;
        _cargandoVistaPrevia = true;
        try
        {
            var previa = await Mediator.Send(
                new PrepararVistaPreviaReclamacionCommand(
                    reclamacion.AmbitoTitular, reclamacion.TitularId, reclamacion.DocumentoIds, reclamacion.Pendientes, reclamacion.EmpresaEmpleadora), token);

            if (_desechado)
                return;

            // Si el envío fallaría (documentos ya renovados, sin acceso, sin
            // destinatario) la vista previa falla con el mismo error: se dice
            // aquí y no se abre una revisión de algo que no saldría.
            if (previa.EsFallido)
            {
                ToastService.MostrarError(previa.Error);
                return;
            }

            _reclamacionAReenviar = reclamacion;
            _vistaPreviaReenvio = previa.Valor;
        }
        finally
        {
            _cargandoVistaPrevia = false;
        }
    }

    private void CerrarRevisionReenvio(bool visible)
    {
        if (!visible && _reenviandoId is null)
        {
            _vistaPreviaReenvio = null;
            _reclamacionAReenviar = null;
        }
    }

    /// <summary>
    /// D-02: el botón deshabilitado dice por qué. Sin documentos marcados o sin
    /// destinatario marcado no se puede enviar; sin título el motivo solo
    /// estaba en el aviso de abajo.
    /// </summary>
    private string? TituloBotonEnviar(LoteReclamacionAgrupadoDto lote, int documentos)
    {
        if (lote.Destinatarios is not { Count: > 0 })
            return Textos["RecBotonSinContacto"].Value;
        if (ContactosMarcados(lote.Clave).Count == 0)
            return Textos["RecBotonMarcaDestinatario"].Value;
        if (documentos == 0)
            return Textos["RecBotonMarcaDocumento"].Value;
        return null;
    }

    private List<DestinatarioReclamacion> DestinatariosMarcados(LoteReclamacionAgrupadoDto lote)
    {
        var marcados = ContactosMarcados(lote.Clave);
        return (lote.Destinatarios ?? [])
            .Where(d => marcados.Contains(d.ContactoId))
            .Select(d => new DestinatarioReclamacion(d.Nombre, d.Email))
            .ToList();
    }

    private sealed record DestinatarioReclamacion(string Nombre, string Email);

    private string CuerpoRevision(LoteReclamacionAgrupadoDto lote)
    {
        // TryGetValue: una recarga concurrente vacía el diccionario con el modal abierto.
        if (!_seleccionPorLote.TryGetValue(lote.Clave, out var seleccionados))
            return string.Empty;

        // Mismo saludo que el del envío a la Empresa empleadora: la Empresa y, entre paréntesis, la Delegación.
        return EnviarReclamacionCommandHandler.ConstruirCuerpoHtml(
            lote.EmpresaEmpleadora?.DelegacionEmpresaNombre is { } delegacion ? $"{lote.TitularNombre} ({delegacion})" : lote.TitularNombre,
            lote.Documentos
                .Where(d => seleccionados.Contains(d.DocumentoId))
                .Select(d => (d.TrabajadorNombre ?? string.Empty, d.TipoDocumentoNombre, d.FechaVencimiento)));
    }

    private void AbrirRevision(LoteReclamacionAgrupadoDto lote)
    {
        if (_enviandoLote is not null || _desechado)
            return;
        if (_seleccionPorLote[lote.Clave].Count == 0 || ContactosMarcados(lote.Clave).Count == 0)
            return;

        _loteEnRevision = lote;
    }

    private void CerrarRevision(bool visible)
    {
        if (!visible && _enviandoLote is null)
            _loteEnRevision = null;
    }

    private async Task ConfirmarReenvioAsync()
    {
        var reclamacion = _reclamacionAReenviar;
        // Un segundo clic con el envío en vuelo no cierra nada: el diálogo sigue
        // mostrando el progreso hasta que termina el primero.
        if (reclamacion is null || _vistaPreviaReenvio is null || _reenviandoId is not null)
            return;

        // Se envía a QUIEN enseñó la revisión, no a lo que la agenda resuelva en este
        // instante: un contacto añadido entre la vista previa y el clic no recibe el
        // correo sin haberse mostrado, y uno que ya no resuelve hace fallar el envío
        // entero (ContactosDesactualizados), igual que en «Enviar reclamación».
        IReadOnlyList<Guid> contactoIds = [.. _vistaPreviaReenvio.Destinatarios.Select(d => d.ContactoId)];
        var nombresDestinatarios = string.Join(", ", _vistaPreviaReenvio.Destinatarios.Select(d => d.Nombre).Where(n => !string.IsNullOrWhiteSpace(n)));
        if (string.IsNullOrWhiteSpace(nombresDestinatarios))
            nombresDestinatarios = reclamacion.TitularRazonSocial;

        try
        {
            await ReclamarDeNuevoAsync(reclamacion, contactoIds, nombresDestinatarios);
        }
        finally
        {
            _reclamacionAReenviar = null;
            _vistaPreviaReenvio = null;
        }
    }

    private async Task ConfirmarEnvioAsync()
    {
        var lote = _loteEnRevision;
        if (lote is null || _enviandoLote is not null)
            return;

        try
        {
            await EnviarAsync(lote);
        }
        finally
        {
            _loteEnRevision = null;
        }
    }

    private async Task EnviarAsync(LoteReclamacionAgrupadoDto lote)
    {
        // La guarda se comprueba AL ENTRAR, no al salir: el botón deshabilitado
        // no basta porque el segundo clic ya viajaba cuando se deshabilitó.
        if (_enviandoLote is not null || _desechado)
            return;

        var documentoIds = _seleccionPorLote[lote.Clave].ToList();
        if (documentoIds.Count == 0) return;

        var contactoIds = ContactosMarcados(lote.Clave).ToList();
        if (contactoIds.Count == 0) return;

        // El token se lee antes del primer await, igual que en CargarAsync.
        var token = _ciclo.Token;
        _enviandoLote = lote.Clave;
        try
        {
            var resultado = lote.EmpresaEmpleadora is { } destino
                ? await Mediator.Send(new EnviarReclamacionEmpresaEmpleadoraCommand(
                    lote.TitularId, destino.DelegacionEmpresaId, documentoIds, contactoIds), token)
                : await Mediator.Send(new EnviarReclamacionCommand(
                    lote.TitularId, documentoIds, CentroId: null, ContactoIdsSeleccionados: contactoIds), token);

            // La pestaña pudo desecharse mientras el comando estaba en vuelo:
            // ni el toast ni la recarga pertenecen a un componente ya retirado.
            if (_desechado)
                return;

            if (resultado.EsFallido)
            {
                ToastService.MostrarError(resultado.Error);
                if (resultado.Error.Codigo == RegistroEnvioReclamacionService.CodigoEnvioParcial)
                    await CargarAsync();
                return;
            }

            ToastService.Mostrar($"Reclamación enviada a {lote.TitularNombre}.", TonoToast.Exito);
            await CargarAsync();
        }
        finally
        {
            _enviandoLote = null;
        }
    }

    private static string FormatearHaceTiempo(DateTime fechaUtc)
    {
        var dias = (int)(DateTime.UtcNow - fechaUtc).TotalDays;
        return dias switch
        {
            <= 0 => "hoy",
            1 => "hace 1 día",
            _ => $"hace {dias} días"
        };
    }
