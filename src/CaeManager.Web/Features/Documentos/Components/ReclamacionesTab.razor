@*
    Pestaña "Reclamaciones" de /documentos (Parte XVI PROMPT 03: "seguimiento",
    tabla de lotes YA ENVIADOS). Por defecto muestra ese historial
    (ObtenerReclamacionesEnviadasQuery); "+ Nueva reclamación" revela la
    vista de COMPONER/ENVIAR que ya existía aquí (MVP1, decisión del usuario
    2026-08-08: agrupa por Cliente los Documentos de sus Trabajadores que
    vencen en los próximos 3 meses o ya vencieron, para reclamarlos en un
    único correo por Cliente en vez de uno por Documento) — no se sustituye,
    se reordena: el historial es lo que se consulta más a menudo, componer
    es la excepción puntual.

    La columna "Recordatorios" del mockup queda deliberadamente fuera: exige
    una entidad nueva persistida (RecordatorioReclamacion, hija de
    ReclamacionDocumental — que es append-only por diseño explícito, no
    admite un contador mutable) más su migración y comando de envío. Es una
    decisión de alcance aparte, no se inventa un contador falso.
*@
@using CaeManager.Application.Contactos.Queries.ObtenerAgendaContactos
@using CaeManager.Application.Reclamaciones.Commands.EnviarReclamacion
@using CaeManager.Application.Reclamaciones.Queries.ObtenerLoteReclamacion
@using CaeManager.Application.Reclamaciones.Queries.ObtenerReclamacionesEnviadas
@using CaeManager.Domain.Documentos
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<div class="acordeon-asignaciones-cabecera">
    <Boton Variante="@(_vista == "historial" ? VarianteBoton.Secundario : VarianteBoton.Fantasma)" Tamano="TamanoBoton.Pequeno"
           OnClick='() => CambiarVistaAsync("historial")' aria-pressed="@(_vista == "historial" ? "true" : "false")">
        Enviadas
    </Boton>
    <Boton Variante="@(_vista == "componer" ? VarianteBoton.Secundario : VarianteBoton.Fantasma)" Tamano="TamanoBoton.Pequeno"
           OnClick='() => CambiarVistaAsync("componer")' aria-pressed="@(_vista == "componer" ? "true" : "false")">
        + Nueva reclamación
    </Boton>
</div>

@if (_vista == "historial")
{
    @if (_cargandoHistorial)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_errorHistorial)
    {
        <EstadoVacio Titulo="No pudimos cargar las reclamaciones enviadas" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarHistorialAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_historial.Count == 0)
    {
        <EstadoVacio Titulo="Todavía no se ha enviado ninguna reclamación" Descripcion='Los lotes que envíes desde "+ Nueva reclamación" aparecerán aquí.' />
    }
    else
    {
        <div class="tabla-documentos-requeridos" role="table" aria-label="Reclamaciones enviadas">
            <div class="documentos-requeridos-cabecera" role="row">
                <span role="columnheader">Destinatario</span>
                <span role="columnheader">Enviada</span>
                <span role="columnheader">Documentos</span>
                <span role="columnheader">Estado</span>
                <span role="columnheader" class="columna-accion">Acción</span>
            </div>
            @foreach (var reclamacion in _historial)
            {
                <div class="fila-documento-requerido" role="row" @key="reclamacion.Id">
                    <span class="celda-documento-nombre" role="cell">
                        @reclamacion.ClienteRazonSocial
                        <span class="fila-trabajador-fraccion">@reclamacion.DestinatarioEmail</span>
                    </span>
                    <span role="cell">@reclamacion.FechaEnvioUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    <span role="cell">@reclamacion.TotalDocumentos</span>
                    <span role="cell">
                        @if (reclamacion.SinRespuesta is null)
                        {
                            <span class="detalle-tecnico">Sin buzón conectado</span>
                        }
                        else if (reclamacion.SinRespuesta.Value)
                        {
                            <Badge Tono="TonoBadge.Advertencia" Tamano="TamanoBadge.Pequeno">Sin respuesta</Badge>
                        }
                        else
                        {
                            <Badge Tono="TonoBadge.Exito" Tamano="TamanoBadge.Pequeno">Respondida</Badge>
                        }
                    </span>
                    <span class="columna-accion" role="cell">
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                               Cargando="_reenviandoId == reclamacion.Id" OnClick="() => ReclamarDeNuevoAsync(reclamacion)">
                            Reclamar de nuevo
                        </Boton>
                        @if (reclamacion.ConversacionId is not null)
                        {
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                                   OnClick='() => NavigationManager.NavigateTo($"/comunicaciones?conversacion={reclamacion.ConversacionId}")'>
                                Ver hilo
                            </Boton>
                        }
                    </span>
                </div>
            }
        </div>

        <PaginadorSimple PaginaActual="_paginaHistorial" TotalPaginas="TotalPaginasHistorial" TotalElementos="_totalHistorial"
                          Etiqueta="reclamación(es)" PaginaActualChanged="CambiarPaginaHistorialAsync"
                          TamanoPagina="_tamanoPaginaHistorial" TamanoPaginaChanged="CambiarTamanoPaginaHistorialAsync" />
    }
}
else if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error)
{
    <EstadoVacio Titulo="No pudimos cargar las reclamaciones" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_lotes.Count == 0)
{
    <EstadoVacio Titulo="Nada pendiente de reclamar" Descripcion="Ningún cliente tiene documentos que venzan en los próximos 3 meses." />
}
else
{
    @foreach (var lote in _lotes)
    {
        var seleccionados = _seleccionPorCliente[lote.ClienteId];
        var enviando = _enviandoClienteId == lote.ClienteId;

        <Tarjeta @key="lote.ClienteId" Titulo="@lote.RazonSocialCliente" Class="tarjeta-reclamacion">
            <AccionesHeader>
                <Boton Tamano="TamanoBoton.Pequeno" Deshabilitado="@(seleccionados.Count == 0 || ContactosMarcados(lote.ClienteId).Count == 0)"
                       Cargando="enviando" OnClick="() => EnviarAsync(lote)">
                    Enviar reclamación (@seleccionados.Count)
                </Boton>
            </AccionesHeader>

            <ChildContent>
                <p class="texto-vacio-seccion">
                    @(lote.UltimaReclamacionFechaUtc is null
                        ? "Nunca reclamado."
                        : $"Última reclamación: {FormatearHaceTiempo(lote.UltimaReclamacionFechaUtc.Value)}.")
                    @* Lleva a la bandeja filtrada por este cliente, no al hilo
                       concreto: el deep-link a una conversación no existe todavía
                       (hueco declarado en 05_WORKSPACE_PATTERNS.md § 3.6) y no se
                       finge aquí. Solo se ofrece si la última reclamación llegó a
                       tener conversación. *@
                    @if (lote.UltimaReclamacionConversacionId is not null)
                    {
                        <a href="@($"/comunicaciones?cliente={lote.ClienteId}")">Ver en Comunicaciones</a>
                    }
                </p>

                @* A quién se le pide: la agenda del cliente (y la del centro, si
                   la reclamación va acotada a uno), nunca los usuarios de
                   portal — ver IResolucionDestinatariosAgendaService. La lista
                   sale marcada entera: desmarcar es la excepción, no el paso
                   obligatorio. *@
                @if (lote.Destinatarios is not { Count: > 0 })
                {
                    <div class="alerta-formulario" role="alert">
                        No hay ningún contacto en la agenda al que reclamar esta documentación.
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                               OnClick="() => AbrirAltaContacto(lote.ClienteId)">
                            Añadir contacto
                        </Boton>
                    </div>
                }
                else
                {
                    <fieldset class="reclamacion-destinatarios">
                        <legend>Se solicita a</legend>
                        @foreach (var destinatario in lote.Destinatarios)
                        {
                            <label class="campo-checkbox" @key="destinatario.ContactoId">
                                <input type="checkbox"
                                       checked="@ContactosMarcados(lote.ClienteId).Contains(destinatario.ContactoId)"
                                       @onchange="e => AlternarContacto(lote.ClienteId, destinatario.ContactoId, (bool)e.Value!)" />
                                <span>@destinatario.Nombre — @destinatario.Email</span>
                                <span class="reclamacion-motivo">@string.Join(", ", destinatario.MotivoTipos)</span>
                            </label>
                        }
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                               OnClick="() => AbrirAltaContacto(lote.ClienteId)">
                            Añadir contacto
                        </Boton>
                    </fieldset>
                }

                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Trabajador</th>
                            <th>Documento</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var documento in lote.Documentos)
                        {
                            <tr @key="documento.DocumentoId">
                                <td>
                                    <input type="checkbox" checked="@seleccionados.Contains(documento.DocumentoId)"
                                           @onchange="e => AlternarSeleccion(lote.ClienteId, documento.DocumentoId, (bool)e.Value!)" />
                                </td>
                                <td>@documento.TrabajadorNombre</td>
                                <td>@documento.TipoDocumentoNombre</td>
                                <td>@documento.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </ChildContent>
        </Tarjeta>
    }
}

@* Alta inline: el gestor que ve que falta el destinatario lo crea sin salir
   de la pantalla y la lista se recarga con él ya resuelto. *@
<ModalContactoAgenda Visible="_altaContactoVisible" VisibleChanged="v => _altaContactoVisible = v"
                     Tipo="TipoPropietarioAgenda.Cliente" PropietarioId="_clienteAltaContacto"
                     PredeterminadoPorDefecto="true" OnGuardado="_ => CargarAsync()" />

@code {
    private string _vista = "historial";
    private bool _cargandoHistorial = true;
    private bool _errorHistorial;
    private IReadOnlyList<ReclamacionEnviadaDto> _historial = [];
    private int _paginaHistorial = 1;
    private int _tamanoPaginaHistorial = 20;
    private int _totalHistorial;
    private Guid? _reenviandoId;
    private bool _componerCargadoUnaVez;

    private int TotalPaginasHistorial => Math.Max(1, (int)Math.Ceiling(_totalHistorial / (double)_tamanoPaginaHistorial));

    private bool _cargando = true;
    private bool _error;
    private IReadOnlyList<LoteReclamacionClienteDto> _lotes = [];
    private readonly Dictionary<Guid, HashSet<Guid>> _seleccionPorCliente = [];
    private readonly Dictionary<Guid, HashSet<Guid>> _contactosPorCliente = [];
    private Guid? _enviandoClienteId;
    private bool _altaContactoVisible;
    private Guid _clienteAltaContacto;

    protected override Task OnInitializedAsync() => CargarHistorialAsync();

    /// <summary>La vista de componer/enviar carga sus lotes (recorre todos los clientes del tenant) solo la primera vez que se entra a ella, no en cada carga de la pestaña.</summary>
    private async Task CambiarVistaAsync(string vista)
    {
        _vista = vista;

        if (vista == "componer" && !_componerCargadoUnaVez)
        {
            _componerCargadoUnaVez = true;
            await CargarAsync();
        }
    }

    private async Task CargarHistorialAsync()
    {
        _cargandoHistorial = true;
        _errorHistorial = false;
        StateHasChanged();

        try
        {
            var resultado = await Mediator.Send(new ObtenerReclamacionesEnviadasQuery(_paginaHistorial, _tamanoPaginaHistorial));
            _historial = resultado.Elementos;
            _totalHistorial = resultado.TotalElementos;
        }
        catch (Exception)
        {
            _errorHistorial = true;
        }
        finally
        {
            _cargandoHistorial = false;
        }
    }

    private Task CambiarPaginaHistorialAsync(int pagina)
    {
        _paginaHistorial = pagina;
        return CargarHistorialAsync();
    }

    private Task CambiarTamanoPaginaHistorialAsync(int tamano)
    {
        _tamanoPaginaHistorial = tamano;
        _paginaHistorial = 1;
        return CargarHistorialAsync();
    }

    private async Task ReclamarDeNuevoAsync(ReclamacionEnviadaDto reclamacion)
    {
        _reenviandoId = reclamacion.Id;
        try
        {
            var resultado = await Mediator.Send(new EnviarReclamacionCommand(reclamacion.ClienteId, reclamacion.DocumentoIds));
            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"Reclamación reenviada a {reclamacion.ClienteRazonSocial}.", TonoToast.Exito);
            await CargarHistorialAsync();
        }
        finally
        {
            _reenviandoId = null;
        }
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = false;
        StateHasChanged();

        try
        {
            _lotes = await Mediator.Send(new ObtenerLoteReclamacionQuery());
            _seleccionPorCliente.Clear();
            _contactosPorCliente.Clear();
            foreach (var lote in _lotes)
            {
                _seleccionPorCliente[lote.ClienteId] = lote.Documentos.Select(d => d.DocumentoId).ToHashSet();
                _contactosPorCliente[lote.ClienteId] =
                    (lote.Destinatarios ?? []).Select(d => d.ContactoId).ToHashSet();
            }
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AlternarSeleccion(Guid clienteId, Guid documentoId, bool seleccionado)
    {
        var seleccionados = _seleccionPorCliente[clienteId];
        if (seleccionado) seleccionados.Add(documentoId);
        else seleccionados.Remove(documentoId);
    }

    private HashSet<Guid> ContactosMarcados(Guid clienteId) =>
        _contactosPorCliente.TryGetValue(clienteId, out var marcados) ? marcados : [];

    private void AlternarContacto(Guid clienteId, Guid contactoId, bool marcado)
    {
        if (!_contactosPorCliente.TryGetValue(clienteId, out var marcados))
            _contactosPorCliente[clienteId] = marcados = [];

        if (marcado) marcados.Add(contactoId);
        else marcados.Remove(contactoId);
    }

    private void AbrirAltaContacto(Guid clienteId)
    {
        _clienteAltaContacto = clienteId;
        _altaContactoVisible = true;
    }

    private async Task EnviarAsync(LoteReclamacionClienteDto lote)
    {
        var documentoIds = _seleccionPorCliente[lote.ClienteId].ToList();
        if (documentoIds.Count == 0) return;

        var contactoIds = ContactosMarcados(lote.ClienteId).ToList();
        if (contactoIds.Count == 0) return;

        _enviandoClienteId = lote.ClienteId;
        try
        {
            var resultado = await Mediator.Send(new EnviarReclamacionCommand(
                lote.ClienteId, documentoIds, CentroId: null, ContactoIdsSeleccionados: contactoIds));
            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar($"Reclamación enviada a {lote.RazonSocialCliente}.", TonoToast.Exito);
            await CargarAsync();
        }
        finally
        {
            _enviandoClienteId = null;
        }
    }

    private static string FormatearHaceTiempo(DateTime fechaUtc)
    {
        var dias = (int)(DateTime.UtcNow - fechaUtc).TotalDays;
        return dias switch
        {
            <= 0 => "hoy",
            1 => "hace 1 día",
            _ => $"hace {dias} días"
        };
    }
}
