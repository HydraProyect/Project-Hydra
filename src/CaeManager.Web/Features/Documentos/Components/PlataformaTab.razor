@*
    Drill-down real de "Pendiente por plataforma" (cierra el hallazgo P-04 de
    la auditoría de producto 2026-08-16 — mockup "Documentos TALVEG",
    pestaña Plataforma): Inicio ya dice "Nalanda: 14 pendientes de subir · 3
    rechazados", pero hasta ahora no había ningún sitio para ver CUÁLES son
    esos 14 documentos ni marcarlos — solo el recuento existía.
    Proveedor → Cliente → Documento, con las tres acciones reales del mockup.
*@
@using CaeManager.Application.Documentos.Commands.ConfirmarVigenciaAcreditacion
@using CaeManager.Application.Documentos.Commands.MarcarAcreditacionAceptada
@using CaeManager.Application.Documentos.Commands.MarcarAcreditacionRechazada
@using CaeManager.Application.Documentos.Commands.MarcarAcreditacionSubida
@using CaeManager.Application.Documentos.Queries.ObtenerAcreditacionesPorProveedor
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Components.DesignSystem
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService

@if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error)
{
    <EstadoVacio Titulo="No pudimos cargar el estado por plataforma" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_proveedores.Count == 0)
{
    <EstadoVacio Titulo="Todo acreditado." Descripcion="No hay documentos pendientes de subir ni rechazados en ningún portal." />
}
else
{
    <div class="plataforma-tab">
        @foreach (var proveedor in _proveedores)
        {
            <div class="plataforma-proveedor" @key="proveedor.ProveedorPlataformaCaeId">
                <div class="plataforma-proveedor-cabecera">
                    <span class="plataforma-proveedor-nombre"><Icono Nombre="plataforma" Tamano="TamanoIcono.Pequeno" /> @proveedor.ProveedorNombre</span>
                    <span class="plataforma-proveedor-resumen">
                        @ContarPendientes(proveedor) pendiente@(ContarPendientes(proveedor) == 1 ? "" : "s") de subir
                        <span class="plataforma-separador">·</span>
                        <span class="plataforma-rechazados">@ContarRechazados(proveedor) rechazado@(ContarRechazados(proveedor) == 1 ? "" : "s")</span>
                    </span>
                </div>
                @foreach (var cliente in proveedor.Clientes)
                {
                    <div class="plataforma-cliente" @key="cliente.ClienteId">
                        <div class="plataforma-cliente-cabecera">@cliente.ClienteNombre</div>
                        @foreach (var documento in cliente.Documentos)
                        {
                            <div class="plataforma-fila-documento" @key="documento.AcreditacionId">
                                <span class="plataforma-documento-propietario">@documento.PropietarioNombre</span>
                                <span class="plataforma-documento-tipo">@documento.TipoDocumentoNombre</span>
                                <span class="plataforma-documento-estado">
                                    <Badge Tono="@(documento.Estado == EstadoAcreditacion.Rechazada ? TonoBadge.Peligro : TonoBadge.Advertencia)">
                                        @EstadoAcreditacionUi.TextoCapitalizado(documento.Estado)
                                    </Badge>
                                    @if (documento.UltimoMotivoRechazo is { Length: > 0 } motivo)
                                    {
                                        <VentanaContexto Etiqueta="@($"Motivo del rechazo: {motivo}")" Titulo="Motivo del rechazo">
                                            <Disparador>
                                                <span class="plataforma-motivo-rechazo" aria-hidden="true">?</span>
                                            </Disparador>
                                            <Detalle>
                                                <span class="ventana-linea">@motivo</span>
                                            </Detalle>
                                        </VentanaContexto>
                                    }
                                </span>
                                <span class="plataforma-documento-acciones">
                                    @* Una acreditación aceptada ya no se sube ni se
                                       acepta otra vez: lo único que queda por hacer con
                                       ella es decir hasta cuándo vale en la plataforma. *@
                                    @if (documento.Estado == EstadoAcreditacion.Aceptada)
                                    {
                                        <span class="plataforma-vigencia">@TextoVigencia(documento)</span>
                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                               OnClick="() => AbrirVigencia(documento.AcreditacionId)">
                                            Anotar vigencia…
                                        </Boton>
                                    }
                                    else
                                    {
                                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                               Cargando="@(_procesando == documento.AcreditacionId)"
                                               OnClick="() => MarcarSubidoAsync(documento.AcreditacionId)">
                                            Marcar subido
                                        </Boton>
                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno"
                                               OnClick="() => MarcarAceptadoAsync(documento.AcreditacionId)">
                                            Marcar aceptado
                                        </Boton>
                                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" OnClick="() => AbrirRechazo(documento.AcreditacionId)">
                                            Marcar rechazado…
                                        </Boton>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<Modal Visible="_vigenciaVisible" VisibleChanged="v => _vigenciaVisible = v" Titulo="@(_soloVigencia ? "Anotar vigencia" : "Marcar como aceptado")" CerrarAlHacerClicFuera="!_confirmandoVigencia">
    <ChildContent>
        @* Se pregunta aquí, y no en una pantalla aparte, porque este es el
           momento en que el Gestor CAE lo sabe: acaba de mirar la plataforma.
           "Todavía no lo sé" es una respuesta válida y se guarda como tal: lo
           que no puede pasar es que se confunda con "no caduca", porque
           entonces el semáforo del Centro daría verde sin saberlo nadie. *@
        <CampoSelect Etiqueta="¿Hasta cuándo vale en esta plataforma?" Valor="@_estadoVigencia"
                     ValorChanged="v => _estadoVigencia = v">
            <option value="@nameof(EstadoVigenciaEnPlataforma.VenceEnFecha)">Vence en una fecha</option>
            <option value="@nameof(EstadoVigenciaEnPlataforma.NoVenceAqui)">Aquí no caduca</option>
            <option value="@nameof(EstadoVigenciaEnPlataforma.SinConfirmar)">Todavía no lo sé</option>
        </CampoSelect>

        @if (_estadoVigencia == nameof(EstadoVigenciaEnPlataforma.VenceEnFecha))
        {
            <CampoTexto Etiqueta="Fecha de vencimiento" Type="date" Valor="@_fechaVigencia"
                        ValorChanged="v => _fechaVigencia = v" MensajeError="@_errorVigencia" />
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_confirmandoVigencia" OnClick="() => _vigenciaVisible = false">Cancelar</Boton>
        <Boton Cargando="_confirmandoVigencia" OnClick="ConfirmarAceptadoAsync">@(_soloVigencia ? "Guardar vigencia" : "Marcar aceptado")</Boton>
    </Pie>
</Modal>

<Modal Visible="_rechazoVisible" VisibleChanged="v => _rechazoVisible = v" Titulo="Marcar como rechazado" CerrarAlHacerClicFuera="!_rechazando">
    <ChildContent>
        <CampoSelect Etiqueta="Causa del rechazo" Valor="@_causaRechazo" ValorChanged="v => _causaRechazo = v">
            @foreach (var causa in Enum.GetValues<CausaRechazoAcreditacion>())
            {
                <option value="@causa">@CausaRechazoAcreditacionUi.Texto(causa)</option>
            }
        </CampoSelect>
        <CampoTextarea Etiqueta="Detalle" Valor="@_motivoRechazo" ValorChanged="v => _motivoRechazo = v"
                        Placeholder="Texto literal del portal, si lo hay" Filas="3" MensajeError="@_errorMotivo" />
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_rechazando" OnClick="() => _rechazoVisible = false">Cancelar</Boton>
        <Boton Cargando="_rechazando" OnClick="ConfirmarRechazoAsync">Marcar rechazado</Boton>
    </Pie>
</Modal>

@code {
    private bool _cargando = true;
    private bool _error;
    private IReadOnlyList<ProveedorAcreditacionesDto> _proveedores = [];
    private Guid? _procesando;

    private bool _vigenciaVisible;
    private bool _soloVigencia;
    private bool _confirmandoVigencia;
    private Guid _acreditacionIdVigencia;
    private string _estadoVigencia = nameof(EstadoVigenciaEnPlataforma.VenceEnFecha);
    private string _fechaVigencia = string.Empty;
    private string? _errorVigencia;

    private bool _rechazoVisible;
    private bool _rechazando;
    private Guid _acreditacionIdRechazo;
    private string _causaRechazo = nameof(CausaRechazoAcreditacion.Ilegible);
    private string _motivoRechazo = string.Empty;
    private string? _errorMotivo;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = false;
        StateHasChanged();

        try
        {
            // Se piden también las aceptadas: esta es la única pantalla desde la
            // que se puede anotar o corregir hasta cuándo vale un documento en
            // una plataforma, así que dejarlas fuera las volvería ilocalizables.
            _proveedores = await Mediator.Send(new ObtenerAcreditacionesPorProveedorQuery(IncluirAceptadas: true));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private static int ContarPendientes(ProveedorAcreditacionesDto proveedor) =>
        proveedor.Clientes.Sum(c => c.Documentos.Count(d => d.Estado == EstadoAcreditacion.PendienteDeSubir));

    private static int ContarRechazados(ProveedorAcreditacionesDto proveedor) =>
        proveedor.Clientes.Sum(c => c.Documentos.Count(d => d.Estado == EstadoAcreditacion.Rechazada));

    private async Task MarcarSubidoAsync(Guid acreditacionId)
    {
        _procesando = acreditacionId;
        StateHasChanged();

        var resultado = await Mediator.Send(new MarcarAcreditacionSubidaCommand(acreditacionId));
        _procesando = null;

        if (resultado.EsFallido)
        {
            ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
            return;
        }

        ToastService.Mostrar("Marcado como subido.", TonoToast.Exito);
        await CargarAsync();
    }

    private void MarcarAceptadoAsync(Guid acreditacionId) => AbrirModalVigencia(acreditacionId, yaAceptada: false);

    private void AbrirVigencia(Guid acreditacionId) => AbrirModalVigencia(acreditacionId, yaAceptada: true);

    private void AbrirModalVigencia(Guid acreditacionId, bool yaAceptada)
    {
        _acreditacionIdVigencia = acreditacionId;
        _soloVigencia = yaAceptada;
        _estadoVigencia = nameof(EstadoVigenciaEnPlataforma.VenceEnFecha);
        _fechaVigencia = string.Empty;
        _errorVigencia = null;
        _vigenciaVisible = true;
    }

    private static string TextoVigencia(AcreditacionDrillDownDto documento) => documento.EstadoVigencia switch
    {
        // El rótulo no puede decir "venció" sin mirar la fecha: ahora la lista
        // trae también las que siguen vigentes.
        EstadoVigenciaEnPlataforma.VenceEnFecha when documento.FechaVencimientoEnPlataforma < DateOnly.FromDateTime(DateTime.UtcNow) =>
            $"Venció el {documento.FechaVencimientoEnPlataforma:dd/MM/yyyy} en esta plataforma",
        EstadoVigenciaEnPlataforma.VenceEnFecha =>
            $"Vale hasta el {documento.FechaVencimientoEnPlataforma:dd/MM/yyyy}",
        EstadoVigenciaEnPlataforma.NoVenceAqui => "Aquí no caduca",
        _ => "Falta confirmar hasta cuándo vale aquí"
    };

    private async Task ConfirmarAceptadoAsync()
    {
        _errorVigencia = null;

        var vigencia = VigenciaElegida();
        if (vigencia is null)
        {
            // Sin fecha legible no se manda nada: dejar pasar el "vence en
            // fecha" vacío lo guardaría como SinConfirmar, y el Gestor se
            // quedaría creyendo que anotó una fecha que no está.
            _errorVigencia = "Escribe la fecha hasta la que vale, o elige otra opción.";
            return;
        }

        _confirmandoVigencia = true;
        // Dos comandos porque son dos cosas distintas: una acredita el documento
        // en la plataforma, la otra solo corrige un dato de una acreditación que
        // ya estaba aceptada. Mezclarlas volvería a marcar como aceptada algo que
        // ya lo estaba, escribiendo un hecho que no ha ocurrido.
        var resultado = _soloVigencia
            ? await Mediator.Send(new ConfirmarVigenciaAcreditacionCommand(_acreditacionIdVigencia, vigencia.Value))
            : await Mediator.Send(new MarcarAcreditacionAceptadaCommand(_acreditacionIdVigencia, vigencia.Value));
        _confirmandoVigencia = false;

        if (resultado.EsFallido)
        {
            ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
            return;
        }

        _vigenciaVisible = false;
        // El aviso dice qué se ha guardado, no solo que se guardó algo: esta
        // pantalla lista lo que falta subir, así que en cuanto se marca aceptado
        // la fila desaparece y el Gestor CAE no tiene dónde volver a mirarlo.
        ToastService.Mostrar(TextoDeLoGuardado(vigencia.Value, _soloVigencia), TonoToast.Exito);
        await CargarAsync();
    }

    private static string TextoDeLoGuardado(VigenciaEnPlataforma vigencia, bool soloVigencia)
    {
        var encabezado = soloVigencia ? "Vigencia anotada." : "Marcado como aceptado.";

        return vigencia.Estado switch
        {
            EstadoVigenciaEnPlataforma.VenceEnFecha =>
                $"{encabezado} Vale hasta el {vigencia.FechaVencimiento:dd/MM/yyyy} en esta plataforma.",
            EstadoVigenciaEnPlataforma.NoVenceAqui =>
                $"{encabezado} En esta plataforma no caduca.",
            _ => $"{encabezado} Queda pendiente confirmar hasta cuándo vale aquí."
        };
    }

    private VigenciaEnPlataforma? VigenciaElegida()
    {
        if (_estadoVigencia == nameof(EstadoVigenciaEnPlataforma.NoVenceAqui))
            return VigenciaEnPlataforma.NoVenceAqui;

        if (_estadoVigencia == nameof(EstadoVigenciaEnPlataforma.SinConfirmar))
            return VigenciaEnPlataforma.SinConfirmar;

        return DateOnly.TryParse(_fechaVigencia, out var fecha) ? VigenciaEnPlataforma.VenceEl(fecha) : null;
    }

    private void AbrirRechazo(Guid acreditacionId)
    {
        _acreditacionIdRechazo = acreditacionId;
        _causaRechazo = nameof(CausaRechazoAcreditacion.Ilegible);
        _motivoRechazo = string.Empty;
        _errorMotivo = null;
        _rechazoVisible = true;
    }

    private async Task ConfirmarRechazoAsync()
    {
        if (string.IsNullOrWhiteSpace(_motivoRechazo))
        {
            _errorMotivo = "Describe el motivo del rechazo.";
            return;
        }

        _rechazando = true;
        _errorMotivo = null;

        try
        {
            var causa = Enum.Parse<CausaRechazoAcreditacion>(_causaRechazo);
            var resultado = await Mediator.Send(new MarcarAcreditacionRechazadaCommand(_acreditacionIdRechazo, causa, _motivoRechazo));

            if (resultado.EsFallido)
            {
                ToastService.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
                return;
            }

            ToastService.Mostrar("Marcado como rechazado.", TonoToast.Exito);
            _rechazoVisible = false;
            await CargarAsync();
        }
        finally
        {
            _rechazando = false;
        }
    }
}
