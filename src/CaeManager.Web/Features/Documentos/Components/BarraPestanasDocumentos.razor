@using CaeManager.Web.Components.Layout
@using CaeManager.Web.Features.Documentos.Recursos
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject NavigationManager Navegacion
@inject IStringLocalizer<TextosDocumentos> Textos

@*
    LA barra de pestañas de la sección Documentos: la misma en todas sus pantallas (Documentos, /incidencias y la
    pantalla heredada /documentos/revision-ia), en el mismo sitio —bajo el título y las acciones de la página— y con
    el estilo de <Pestanas>. Cada pantalla la pinta envolviendo su contenido (que queda dentro del panel de la
    pestaña activa) y dice cuál es la activa; el marco ya no pinta una segunda barra de sección sobre Documentos
    (ver BarraSeccion y CatalogoSeccionesMenu).

    Los Ids son estables y viajan en la URL (<c>/documentos?pestana=</c>): no se tocan al cambiar un rótulo.
    «Incidencias» es una pantalla hermana, no una vista de Documentos: su pestaña lleva a /incidencias y solo se
    ofrece a los roles que esa pantalla abre (CatalogoSeccionesMenu.RolesDeIncidencias, los de su [Authorize]).
    La barra solo señala: cada pantalla de destino se autoriza por su cuenta y una pestaña nunca concede nada.
*@
<Pestanas Definiciones="Definiciones" PestanaActiva="@PestanaActiva" PestanaActivaChanged="CambiarAsync"
          EtiquetaGrupo="@Textos["PestanasEtiquetaGrupo"]">
    @ChildContent
</Pestanas>

@code {
    public const string IdEstado = "listado";
    public const string IdPlataformas = "plataforma";
    public const string IdReclamaciones = "reclamaciones";
    public const string IdPreventivo = "sugerencias";
    public const string IdRevisionIa = "revision-ia";
    public const string IdPlantillas = "plantillas";
    public const string IdIncidencias = "incidencias";

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    /// <summary>Id de la pestaña activa de la pantalla que pinta la barra.</summary>
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = IdEstado;

    /// <summary>
    /// La pantalla Documentos cambia de vista sin navegar: recibe aquí el Id elegido (todos salvo «Incidencias»,
    /// que siempre sale a su pantalla). Sin delegado —las pantallas hermanas— elegir una pestaña navega a ella.
    /// </summary>
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    /// <summary>Recuento de la pestaña «Estado»: solo lo conoce quien tiene la lista cargada (Documentos).</summary>
    [Parameter] public ContadorPestana? ContadorEstado { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _puedeVerIncidencias;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null) return;
        var usuario = (await EstadoAutenticacion).User;
        _puedeVerIncidencias = CatalogoSeccionesMenu.RolesDeIncidencias.Split(',').Any(usuario.IsInRole);
    }

    private IReadOnlyList<PestanaDefinicion> Definiciones
    {
        get
        {
            // Los Ids son estables; los rótulos van alineados al mockup Gen 2 salvo dos, que el contrato
            // terminológico manda sobre el diseño: «Plataformas CAE» y no «Por plataforma» («plataforma» a secas es
            // el plano Plataforma del ADR-011, el acceso excepcional desde TALVEG; aquí se habla de la Plataforma CAE
            // externa) y «Plantillas», que el mockup no dibuja pero la pantalla ya tiene. «correo» y «reloj» son los
            // glifos más cercanos del catálogo para Reclamaciones y Preventivo.
            List<PestanaDefinicion> pestanas =
            [
                new(IdEstado, Textos["PestanaEstado"].Value, "documentos") { Contador = ContadorEstado },
                new(IdPlataformas, Textos["PestanaPlataformasCae"].Value, "plataforma"),
                new(IdReclamaciones, Textos["PestanaReclamaciones"].Value, "correo"),
                new(IdPreventivo, Textos["PestanaPreventivo"].Value, "reloj"),
                new(IdRevisionIa, Textos["PestanaRevisionIa"].Value, "ia"),
                new(IdPlantillas, Textos["PestanaPlantillas"].Value, "plantilla"),
            ];

            if (_puedeVerIncidencias)
                pestanas.Add(new(IdIncidencias, Textos["PestanaIncidencias"].Value, "incidencias"));

            return pestanas;
        }
    }

    private async Task CambiarAsync(string id)
    {
        if (id != IdIncidencias && PestanaActivaChanged.HasDelegate)
        {
            await PestanaActivaChanged.InvokeAsync(id);
            return;
        }

        Navegacion.NavigateTo(RutaDe(id));
    }

    /// <summary>Destino de cada pestaña cuando la pantalla actual no es Documentos.</summary>
    internal static string RutaDe(string id) => id switch
    {
        IdEstado => "/documentos",
        IdIncidencias => "/incidencias",
        _ => $"/documentos?pestana={id}",
    };
}
