@*
    Panel de Documento para el Context Workspace. Pestañas: Información,
    Versiones, Validación, Historial.

    Versiones sigue siendo funcionalidad futura (versionado de archivos).
    Validación muestra el resultado de la validación oficial automática
    (firma digital + cotejo — ver ValidacionDocumentoOficialService) cuando
    el tipo tiene perfil oficial; el flujo de aprobación manual con
    validador/fecha/motivo sigue pendiente como concepto aparte.
*@
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerValidacionOficialDocumento
@using CaeManager.Domain.Documentos
@using MediatR
@inject IMediator Mediator

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar el documento" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton OnClick="CargarCabeceraAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else
{
    <div class="workspace-cabecera-entidad">
        <h2 class="workspace-titulo-entidad">@_detalle.TipoDocumentoNombre</h2>
        <Badge>@_detalle.Ambito</Badge>
    </div>

    <Pestanas Definiciones="_pestanas" PestanaActiva="PestanaActiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones del documento">
        @switch (PestanaActiva)
        {
            case "informacion":
                <div class="workspace-grupo-campos">
                    <CampoInfo Etiqueta="Propietario" Valor="@_detalle.PropietarioNombre" />
                    <CampoInfo Etiqueta="Tipo de documento" Valor="@_detalle.TipoDocumentoNombre" />
                    <CampoInfo Etiqueta="Fecha de emisión" Valor="@_detalle.FechaEmision.ToString("dd/MM/yyyy")" />
                    <CampoInfo Etiqueta="Fecha de vencimiento" Valor="@(_detalle.FechaVencimiento?.ToString("dd/MM/yyyy") ?? (_detalle.TipoDocumentoAplicaVencimientoAutomatico ? null : "No aplica"))" />
                    <CampoInfo Etiqueta="Comentarios" Valor="@_detalle.Comentarios" />
                    <CampoInfo Etiqueta="Archivo">
                        @if (_detalle.ArchivoUrl is not null)
                        {
                            <a href="/documentos/@EntidadId/archivo" target="_blank">Ver PDF</a>
                        }
                        else
                        {
                            <span class="campo-info-vacio">Sin adjunto</span>
                        }
                    </CampoInfo>
                </div>
                break;

            case "versiones":
                <EstadoVacio Titulo="Próximamente" Descripcion="@($"El versionado de archivos de un documento (v1, v2, v3…) todavía no está disponible en {Marca.Nombre}.")" />
                break;

            case "validacion":
                @if (_cargandoValidacion)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_validacion is null)
                {
                    <EstadoVacio Titulo="Sin validación automática" Descripcion="Este documento no ha pasado por la validación de documento oficial — su tipo no tiene perfil oficial asignado, o el análisis todavía no ha terminado." />
                }
                else
                {
                    <div class="workspace-grupo-campos">
                        <CampoInfo Etiqueta="Nivel de confianza">
                            <Badge Tono="@TonoDeNivel(_validacion.NivelConfianza)">@TextoDeNivel(_validacion.NivelConfianza)</Badge>
                        </CampoInfo>
                        <CampoInfo Etiqueta="Decisión">
                            <Badge Tono="@(_validacion.Decision == DecisionValidacionOficial.AutoValidado ? TonoBadge.Exito : TonoBadge.Advertencia)">
                                @(_validacion.Decision switch
                                {
                                    DecisionValidacionOficial.AutoValidado => "Auto-validado",
                                    DecisionValidacionOficial.RevisionRequerida => "Revisión requerida",
                                    _ => "Sin firma válida",
                                })
                            </Badge>
                        </CampoInfo>
                        @if (!string.IsNullOrWhiteSpace(_validacion.Motivos))
                        {
                            <CampoInfo Etiqueta="Motivos" Valor="@_validacion.Motivos" />
                        }
                        <CampoInfo Etiqueta="Código de verificación (CEA/CSV)" Valor="@_validacion.CodigoVerificacion" />
                        <CampoInfo Etiqueta="CIF detectado" Valor="@_validacion.CifDetectado" />
                        <CampoInfo Etiqueta="Fecha de emisión detectada" Valor="@_validacion.FechaEmisionDetectada?.ToString("dd/MM/yyyy")" />
                        <CampoInfo Etiqueta="Periodo detectado" Valor="@_validacion.PeriodoDetectado" />
                        <CampoInfo Etiqueta="Validado el" Valor="@_validacion.CreadaEnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")" />
                    </div>

                    @if (_validacion.Firmas.Count > 0)
                    {
                        <h3 class="workspace-subtitulo">Firmas del archivo</h3>
                        <div class="workspace-grupo-campos">
                            @foreach (var firma in _validacion.Firmas)
                            {
                                <CampoInfo Etiqueta="@($"Firma {firma.Indice + 1}")">
                                    <Badge Tono="@(firma.Estado == EstadoFirmaPdf.Valida ? TonoBadge.Exito : firma.Estado == EstadoFirmaPdf.Invalida ? TonoBadge.Peligro : TonoBadge.Neutro)">
                                        @(firma.Estado == EstadoFirmaPdf.Valida ? "Íntegra" : firma.Estado == EstadoFirmaPdf.Invalida ? "Inválida" : "No soportada")
                                    </Badge>
                                    <span class="detalle-tecnico">
                                        @(firma.FirmanteNombre ?? "Firmante no registrado")@(firma.FirmanteNif is not null ? $" ({firma.FirmanteNif})" : "")
                                        — emitido por @firma.EmisorCertificado
                                        @(firma.FechaFirmaUtc is not null ? $" · {firma.FechaFirmaUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}" : "")
                                        @(firma.TieneSelloDeTiempo ? " · con sello de tiempo" : "")
                                    </span>
                                    @if (firma.MotivoInvalidez is not null)
                                    {
                                        <span class="detalle-tecnico">@firma.MotivoInvalidez</span>
                                    }
                                </CampoInfo>
                            }
                        </div>
                    }
                }
                break;

            case "firma":
                <FirmaEnCampoTab EntidadId="EntidadId" />
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Documento" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@code {
    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas =
    [
        new("informacion", "Información"),
        new("versiones", "Versiones"),
        new("validacion", "Validación"),
        new("firma", "Firma"),
        new("historial", "Historial")
    ];

    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private DocumentoDetalleDto? _detalle;
    private ValidacionOficialDocumentoDto? _validacion;
    private bool _cargando = true;
    private bool _cargandoValidacion = true;
    private bool _error;
    private Guid _idCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId == _idCargado)
            return;

        _idCargado = EntidadId;
        await CargarCabeceraAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        _cargando = true;
        _cargandoValidacion = true;
        _error = false;

        try
        {
            _detalle = await Mediator.Send(new ObtenerDocumentoPorIdQuery(EntidadId));
            _validacion = await Mediator.Send(new ObtenerValidacionOficialDocumentoQuery(EntidadId));
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
            _cargandoValidacion = false;
        }
    }

    private static TonoBadge TonoDeNivel(NivelConfianzaDocumental nivel) => nivel switch
    {
        NivelConfianzaDocumental.VerificadoOficialmente or NivelConfianzaDocumental.FirmaValida => TonoBadge.Exito,
        NivelConfianzaDocumental.FirmaValidaSinRevocacion => TonoBadge.Info,
        NivelConfianzaDocumental.Manipulado => TonoBadge.Peligro,
        NivelConfianzaDocumental.FirmaIntegraEmisorNoConfiable => TonoBadge.Advertencia,
        _ => TonoBadge.Neutro,
    };

    private static string TextoDeNivel(NivelConfianzaDocumental nivel) => nivel switch
    {
        NivelConfianzaDocumental.VerificadoOficialmente => "Verificado oficialmente",
        NivelConfianzaDocumental.FirmaValida => "Firma válida",
        NivelConfianzaDocumental.FirmaValidaSinRevocacion => "Firma válida (revocación no comprobada)",
        NivelConfianzaDocumental.FirmaIntegraEmisorNoConfiable => "Firma íntegra, emisor no reconocido",
        NivelConfianzaDocumental.Manipulado => "Documento manipulado",
        _ => "Sin firma digital",
    };
}
