@using CaeManager.Web.Features.Documentos.Recursos
@using CaeManager.Web.Features.Bandeja.Components
@using CaeManager.Application.Documentos.Commands.RenovarDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentoPorId
@using CaeManager.Application.Documentos.Queries.ObtenerAcreditacionesDelDocumento
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Application.Documentos.Queries.ObtenerValidacionOficialDocumento
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Components.DesignSystem
@using FluentValidation
@using MediatR
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IMediator Mediator
@inject Microsoft.Extensions.Localization.IStringLocalizer<TextosDocumentos> TextosDocumento
@inject IServiceProvider ServiceProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Recursos.TextosComunes> Comunes
@inject Microsoft.Extensions.Logging.ILogger<DocumentoWorkspacePanel> Logger

@if (_cargando)
{
    <EstadoCargando Filas="4" />
}
else if (!_error && _detalle is null)
{
    @* La consulta devolvió null: la ficha no está en el Tenant activo (o no existe; mismo estado, § 4.5). Se cierra el panel con un toast; sin «Reintentar». *@
    <PanelNoEncontrado />
}
else if (_error || _detalle is null)
{
    <EstadoVacio Titulo="No pudimos cargar el documento" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion><Boton Variante="VarianteBoton.Primario" OnClick="ReintentarAsync">Reintentar</Boton></Accion>
    </EstadoVacio>
}
else
{
    <div class="cabecera-documento-360">
        <span class="icono-documento-360"><Icono Nombre="documentos" /></span>
        <div class="texto-cabecera-documento-360">
            <span class="kicker-documento-360">Documento · Ámbito @_detalle.Ambito</span>
            <h2 class="workspace-titulo-entidad titulo-documento-360">@_detalle.TipoDocumentoNombre</h2>
            <div class="meta-documento-360">
                <span>@_detalle.PropietarioNombre</span>
                @if (_detalle.FechaVencimiento is { } vencimiento)
                {
                    <span>· vence el @vencimiento.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>
        @* La consulta rápida lleva a la página completa del Documento (Documento 360). *@
        <Boton360 Nombre="@_detalle.TipoDocumentoNombre" Href="@($"/documentos/{EntidadId}")" />

    </div>

    @* Historial (D8 del diseño del documento efectivo): un enlace a un Id que otro documento sustituyó llega aquí, y
       dice por quién y lleva al vigente. El historial no se edita: no hay «Renovar» sobre él. *@
    @if (_detalle.SustitutoId is { } vigenteId)
    {
        <div class="aviso-historial-documento-360" role="status">
            @TextosDocumento["Documento360AvisoHistorial", _detalle.SustituidoEn?.EnHoraPeninsular().ToString("dd/MM/yyyy") ?? ""]
            <a href="/documentos?documentoId=@vigenteId">@TextosDocumento["Documento360VerVigente"]</a>
        </div>
    }

    <Pestanas Definiciones="_pestanas" PestanaActiva="@PestanaEfectiva" PestanaActivaChanged="PestanaActivaChanged" EtiquetaGrupo="Secciones del documento">
        @switch (PestanaEfectiva)
        {
            case "informacion":
                @if (_editandoInformacion)
                {
                    @if (_mensajeErrorInformacion is not null)
                    {
                        <div class="alerta-formulario" role="alert">@_mensajeErrorInformacion</div>
                    }
                    <div class="formulario-documento-360">
                        <CampoTexto Etiqueta="Fecha de emisión" Type="date" Valor="@_fechaEmisionEditada" ValorChanged="v => _fechaEmisionEditada = v"
                                    FechaNoValida="_emisionNoValida" FechaNoValidaChanged="v => _emisionNoValida = v" />
                        @if (!_detalle.TipoDocumentoAplicaVencimientoAutomatico)
                        {
                            @* FechaNoValidaChanged: un vencimiento a medias llega como «» y RenovarDocumentoCommand lo
                               guardaría como «sin vencimiento». *@
                            <CampoTexto Etiqueta="Fecha de vencimiento" Type="date" Valor="@_fechaVencimientoEditada" ValorChanged="v => _fechaVencimientoEditada = v"
                                        FechaNoValida="_vencimientoNoValido" FechaNoValidaChanged="AlCambiarVencimientoNoValido" />
                            @* Sin fecha y sin marcar, la vigencia queda «sin confirmar»: marcar
                               es la única forma de declarar que el documento no caduca. *@
                            <label class="campo-checkbox">
                                <input type="checkbox" checked="@_noCaducaEditado" @onchange="e => _noCaducaEditado = e.Value is bool m && m" />
                                @TextosVigenciaDocumento.Texto("NoCaduca")
                            </label>
                        }
                        <CampoTextarea Etiqueta="Comentarios" Valor="@_comentariosEditados" ValorChanged="v => _comentariosEditados = v" Filas="3" />
                    </div>
                    <div class="workspace-acciones-edicion">
                        <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Deshabilitado="_guardandoInformacion" OnClick="CancelarEdicionInformacion">Cancelar</Boton>
                        <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" Cargando="_guardandoInformacion" OnClick="GuardarInformacionAsync">Guardar fechas y comentarios (sin sustituir el archivo)</Boton>
                    </div>
                }
                else
                {
                    <div class="rejilla-info-documento-360">
                        <div class="celda-info-documento-360"><span>Propietario</span><strong>@_detalle.PropietarioNombre</strong></div>
                        <div class="celda-info-documento-360"><span>Tipo de documento</span><strong>@_detalle.TipoDocumentoNombre</strong></div>
                        <div class="celda-info-documento-360"><span>Fecha de emisión</span><strong>@_detalle.FechaEmision.ToString("dd/MM/yyyy")</strong></div>
                        @* Sin FechaEmision: en este panel solo la vigencia es copiable (P9,
                           2026-09-18); la emisión ya tiene su propia celda arriba, sin Alt+clic.
                           El listado sí lo ofrece desde la decisión del 2026-10-08. *@
                        <div class="celda-info-documento-360"><span>Fecha de vencimiento</span><strong><TextoFechaCopiable Fecha="_detalle.FechaVencimiento">@(_detalle.FechaVencimiento?.ToString("dd/MM/yyyy") ?? (_detalle.EstadoVigencia == EstadoVigenciaDocumento.NoCaduca ? "Sin caducidad" : TextosVigenciaDocumento.Texto("SinConfirmar")))</TextoFechaCopiable></strong></div>
                        <div class="celda-info-documento-360 celda-info-documento-360-ancha"><span>Comentarios</span><strong>@(_detalle.Comentarios ?? "—")</strong></div>
                        <div class="celda-info-documento-360 celda-info-documento-360-ancha">
                            <span>Archivo</span>
                            @if (_detalle.ArchivoUrl is not null)
                            {
                                @* D-24: «Descargar PDF» primero y «Ver» (el visor del listado) después, separados por «·» (CSS). *@
                                <span class="archivo-documento-360">
                                    <a href="/documentos/@EntidadId/archivo" target="_blank" download>@TextosDocumento["Documento360DescargarPdf"]</a>
                                    <button type="button" class="ver-archivo-documento-360" data-accion="ver-pdf"
                                            aria-label="@TextosDocumento["VerPdfAria", _detalle.TipoDocumentoNombre, _detalle.PropietarioNombre]"
                                            @onclick="() => _visorVisible = true">@TextosDocumento["ListaVer"]</button>
                                </span>
                            }
                            else
                            {
                                <strong>Sin adjunto</strong>
                            }
                        </div>
                    </div>
                    @* RenovarDocumentoCommand es ICommand: AutorizacionEscrituraBehavior lo deniega a Consulta. *@
                    <SoloConEscritura>
                        <div class="acciones-documento-360">
                            @if (_detalle.SustitutoId is null)
                            {
                                <Boton Variante="VarianteBoton.Secundario" OnClick="IniciarEdicionInformacion">Renovar</Boton>
                            }
                            @* «Reclamar» (mockup Documento 360) reutiliza la reclamación de la Bandeja,
                               con el titular del documento preseleccionado: el gestor revisa qué se
                               reclama y a quién antes de enviar. Solo Trabajador y Empresa tienen
                               camino de reclamación (agenda + comando de envío). *@
                            @if (TitularReclamable is not null)
                            {
                                <Boton Variante="VarianteBoton.Secundario" OnClick="() => _reclamacionVisible = true">@TextosDocumento["Documento360Reclamar"]</Boton>
                            }
                        </div>
                    </SoloConEscritura>
                    @SeccionPlataformasCae
                }
                break;

            case "validacion":
                @if (_cargandoValidacion)
                {
                    <EstadoCargando Filas="3" />
                }
                else if (_errorValidacion)
                {
                    <EstadoVacio Titulo="@TextosDocumento["ValidacionOficialErrorTitulo"]" Descripcion="Intenta nuevamente en unos segundos.">
                        <Accion><Boton Variante="VarianteBoton.Secundario" OnClick="CargarValidacionAsync">Reintentar</Boton></Accion>
                    </EstadoVacio>
                }
                else if (_validacion is null)
                {
                    <EstadoVacio Titulo="Sin validación automática" Descripcion="Este documento no ha pasado por la validación de documento oficial — su tipo no tiene perfil oficial asignado, o el análisis todavía no ha terminado." />
                }
                else
                {
                    <div class="rejilla-info-documento-360">
                        <div class="celda-info-documento-360"><span>Nivel de confianza</span><Badge Tono="@TonoDeNivel(_validacion.NivelConfianza)">@TextoDeNivel(_validacion.NivelConfianza)</Badge></div>
                        <div class="celda-info-documento-360"><span>Decisión</span><Badge Tono="@(_validacion.Decision == DecisionValidacionOficial.AutoValidado ? TonoBadge.Exito : TonoBadge.Advertencia)">@TextoDeDecision(_validacion.Decision)</Badge></div>
                        @if (!string.IsNullOrWhiteSpace(_validacion.Motivos))
                        {
                            <div class="celda-info-documento-360 celda-info-documento-360-ancha"><span>Motivos</span><strong>@_validacion.Motivos</strong></div>
                        }
                        <div class="celda-info-documento-360"><span>Código de verificación (CEA/CSV)</span><strong>@(_validacion.CodigoVerificacionDisponible ? (_validacion.CodigoVerificacion ?? "—") : TextosDocumento["ValidacionOficialCodigoNoDisponibleSoporte"])</strong></div>
                        <div class="celda-info-documento-360"><span>CIF detectado</span><strong>@(_validacion.CifDetectado ?? "—")</strong></div>
                        <div class="celda-info-documento-360"><span>Fecha de emisión detectada</span><strong>@(_validacion.FechaEmisionDetectada?.ToString("dd/MM/yyyy") ?? "—")</strong></div>
                        <div class="celda-info-documento-360"><span>Periodo detectado</span><strong>@(_validacion.PeriodoDetectado ?? "—")</strong></div>
                        <div class="celda-info-documento-360 celda-info-documento-360-ancha"><span>Verificado el</span><strong>@_validacion.CreadaEnUtc.EnHoraPeninsular().ToString("dd/MM/yyyy HH:mm")</strong></div>
                    </div>
                    @if (_validacion.Firmas.Count > 0)
                    {
                        <h3 class="workspace-subtitulo">Firmas del archivo</h3>
                        <div class="firmas-documento-360">
                            @foreach (var firma in _validacion.Firmas)
                            {
                                <div class="firma-documento-360">
                                    <strong>Firma @(firma.Indice + 1)</strong>
                                    <Badge Tono="@(firma.Estado == EstadoFirmaPdf.Valida ? TonoBadge.Exito : firma.Estado == EstadoFirmaPdf.Invalida ? TonoBadge.Peligro : TonoBadge.Neutro)">@(firma.Estado == EstadoFirmaPdf.Valida ? "Íntegra" : firma.Estado == EstadoFirmaPdf.Invalida ? "Inválida" : "No soportada")</Badge>
                                    <span>@(firma.FirmanteNombre ?? "Firmante no registrado")@(firma.FirmanteNif is not null ? $" ({firma.FirmanteNif})" : "") · emitido por @firma.EmisorCertificado</span>
                                    @if (firma.MotivoInvalidez is not null) { <span>@firma.MotivoInvalidez</span> }
                                </div>
                            }
                        </div>
                    }
                }
                break;

            case "firma":
                <FirmaEnCampoTab EntidadId="EntidadId" />
                break;

            case "historial":
                <PestanaHistorial EntidadTipo="Documento" EntidadId="EntidadId" />
                break;
        }
    </Pestanas>
}

@* P1-E2b: la renovación en línea vive en el panel, no en la pestaña: cambiar de pestaña no la pierde
   y no pregunta, por eso el aviso va fuera de <Pestanas>. Abrir otra ficha, volver, el
   breadcrumb o cerrar el panel sí la pierden: el Context Workspace pregunta a este aviso
   antes. Fuera del if/else, para que recargar la cabecera tras guardar no lo desmonte. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CancelarEdicionInformacion" />

@if (TitularReclamable is { } titular)
{
    @* @key por titular: el selector del cajón se inicializa una sola vez, así que otro
       titular es otra instancia, nunca la anterior con su filtro. *@
    <DrawerReclamacionLote @key="titular" Visible="_reclamacionVisible" VisibleChanged="v => _reclamacionVisible = v"
                           AmbitosDisponibles="@(new[] { AmbitoAplicacion.Trabajador, AmbitoAplicacion.Empresa })"
                           AmbitoInicial="titular.Ambito" EntidadIdInicial="titular.EntidadId" />
}

@* D-24: «Ver» abre el mismo visor que el listado; se monta solo mientras está abierto. *@
@if (_visorVisible && _detalle is not null)
{
    <VisorDocumento Visible="true" VisibleChanged="v => _visorVisible = v" DocumentoId="EntidadId"
                    Titulo="@($"{_detalle.TipoDocumentoNombre} — {_detalle.PropietarioNombre}")" />
}

@* D-23: los diálogos del menú «Acreditación ▾» son los del listado (ModalesAcreditacion, AnotarVigenciaEnBloque y
   PanelGestionarAcreditacion), no una copia. Solo existen para quien escribe y si hay alguna acreditación que mostrar. *@
@if (_acreditaciones is { Acreditaciones.Count: > 0 } && !EnHistorial)
{
    <SoloConEscritura>
        <ModalesAcreditacion @ref="_modalesAcreditacion" OnCambio="AlCambiarAcreditacionAsync" />
        <AnotarVigenciaEnBloque @ref="_anotarVigencia" OnAnotado="AlCambiarAcreditacionAsync" />
    </SoloConEscritura>
}
@if (_acreditacionAGestionar is { } gestion && _detalle is not null && _acreditaciones is not null && PropietarioGestionable is { } propietarioId)
{
    <PanelGestionarAcreditacion @bind-Visible="_panelAcreditacionVisible"
                                DocumentoNombre="@_detalle.TipoDocumentoNombre" PropietarioNombre="@_detalle.PropietarioNombre"
                                EsDeEmpresa="@(_detalle.Ambito == AmbitoAplicacion.Empresa)" PropietarioId="propietarioId"
                                CentroNombre="@gestion.CentroNombre" EstadoTalveg="_acreditaciones.EstadoDocumental" FechaVencimiento="_detalle.FechaVencimiento"
                                Acreditaciones="@([new AcreditacionResumenDto(gestion.Id, gestion.PlataformaNombre, gestion.Estado)])"
                                OnGuardado="AlCambiarAcreditacionAsync" />
}
@* «Subir versión corregida» abre el drawer del Documento, como en el listado. Se monta al pedirlo: no todos los hosts del panel
   registran el almacenamiento de archivos que el drawer necesita. *@
@if (_drawerVersionMontado)
{
    <DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="AlGuardarVersionCorregidaAsync" />
}

@code {
    /// <summary>
    /// D-23 (artboard Vista-rapida): «Plataformas CAE · N» con cada acreditación del Documento: la Plataforma CAE con su logotipo,
    /// el nombre del tipo, su contexto (Cliente empresarial · Centro), el estado en femenino, el motivo si lo hay y el menú
    /// «Acreditación ▾». El nombre que cada Plataforma CAE da al tipo (B2) todavía no existe: se pinta el del tipo, que es lo que
    /// el artboard dibuja cuando coinciden. El motivo y la dirección del portal llegan ya cortados por el servidor
    /// (ObtenerAcreditacionesDelDocumentoQuery); el menú es de quien escribe (SoloConEscritura dentro de MenuAcreditacion).
    /// </summary>
    private RenderFragment SeccionPlataformasCae => @<text>
        @if (_detalle is not null && _acreditaciones is { Acreditaciones.Count: > 0 } plataformas)
        {
        <section class="plataformas-documento-360" aria-label="@TextosDocumento["VistaRapidaPlataformasCae"]" data-seccion="plataformas-cae">
            <h3 class="titulo-plataformas-documento-360">
                <Icono Nombre="plataforma" Tamano="TamanoIcono.Pequeno" />
                @TextosDocumento["VistaRapidaPlataformasCae"]
                <span class="cuenta-plataformas-documento-360">@TextosDocumento["VistaRapidaPlataformasCaeCuenta", plataformas.Acreditaciones.Count]</span>
            </h3>
            <ul class="lista-plataformas-documento-360">
                @foreach (var acreditacion in plataformas.Acreditaciones)
                {
                    <li class="acreditacion-documento-360" @key="acreditacion.Id" data-acreditacion="@acreditacion.Id">
                        <span class="datos-acreditacion-documento-360">
                            <span class="plataforma-acreditacion-documento-360">
                                @if (acreditacion.PlataformaCodigo is { } codigo && CaeManager.Web.Features.Dashboard.LogoPlataforma.Ruta(codigo) is { } logo)
                                {
                                    <img class="logo-plataforma-documento-360" src="@logo" alt="" aria-hidden="true" loading="lazy" />
                                }
                                else
                                {
                                    <span class="logo-plataforma-documento-360 logo-plataforma-documento-360-generico" aria-hidden="true"><Icono Nombre="plataforma" Tamano="TamanoIcono.Pequeno" /></span>
                                }
                                <strong>@acreditacion.PlataformaNombre</strong>
                            </span>
                            <span class="tipo-acreditacion-documento-360">@_detalle.TipoDocumentoNombre</span>
                            <span class="contexto-acreditacion-documento-360">@TextosDocumento["VistaRapidaContextoAcreditacion", acreditacion.ClienteEmpresarialNombre, acreditacion.CentroNombre]</span>
                        </span>
                        @* Un Documento en el historial (sustituido) es inmutable, como «Renovar» arriba: sus acreditaciones se leen
                           pero no se gestionan desde aquí. El contenedor solo existe para quien escribe, así no reserva columna. *@
                        @if (!EnHistorial && ReglasAccionesAcreditacion.HayAlgunaAccion(acreditacion.Estado, PropietarioGestionable is not null, acreditacion.UrlAccesoCanal))
                        {
                            <SoloConEscritura>
                                <span class="menu-acreditacion-documento-360">
                                    <MenuAcreditacion Estado="acreditacion.Estado" PlataformaNombre="@acreditacion.PlataformaNombre"
                                                      PropietarioNombre="@_detalle.PropietarioNombre" UrlPortal="@acreditacion.UrlAccesoCanal"
                                                      PuedeGestionar="@(PropietarioGestionable is not null)"
                                                      OnAccion="accion => ManejarAccionAcreditacionAsync(acreditacion, accion)" />
                                </span>
                            </SoloConEscritura>
                        }
                        <span class="estado-acreditacion-documento-360">
                            <Badge Tono="EstadoAcreditacionUi.TonoEnPlataforma(acreditacion.Estado, acreditacion.SinVigencia)" Tamano="TamanoBadge.Pequeno">@TextoEnPlataforma(acreditacion)</Badge>
                            @if (acreditacion.Estado == EstadoAcreditacion.Rechazada && !string.IsNullOrWhiteSpace(acreditacion.UltimoMotivoRechazo))
                            {
                                @* El rol Cliente ve el estado, no el motivo (opción B, 2026-11-12): el servidor ya no se lo manda y la
                                   pantalla tampoco lo pinta aunque llegara, como en el listado. *@
                                <AuthorizeView Roles="@ReglasAccionesAcreditacion.RolesQueAbrenPortal" Context="autorizacionMotivo">
                                    <span class="motivo-acreditacion-documento-360">@TextosDocumento["EnPlataformaMotivo", acreditacion.UltimoMotivoRechazo]</span>
                                </AuthorizeView>
                            }
                        </span>
                    </li>
                }
            </ul>
        </section>
        }
    </text>;

    private AcreditacionesDelDocumentoDto? _acreditaciones;
    private int _cargaAcreditaciones;
    private ModalesAcreditacion? _modalesAcreditacion;
    private AnotarVigenciaEnBloque? _anotarVigencia;
    private DrawerGestionDocumento? _drawerGestion;
    private bool _drawerVersionMontado, _abrirVersionPendiente, _visorVisible, _panelAcreditacionVisible;

    /// <summary>La acreditación que abre «Gestionar acreditación…» del menú de la sección (D-18).</summary>
    private AcreditacionDelDocumentoDto? _acreditacionAGestionar;

    /// <summary>
    /// «Gestionar acreditación…» enlaza con la ficha 360 de una Empresa o de un Trabajador, como en el listado
    /// (Documentos.PuedeGestionarAcreditacion): para el resto de Propietarios no se ofrece.
    /// </summary>
    /// <summary>El Documento abierto ya está sustituido por otra versión (historial, D5/D8): se lee, no se gestiona.</summary>
    private bool EnHistorial => _detalle?.SustitutoId is not null;

    private Guid? PropietarioGestionable => _detalle switch
    {
        { Ambito: AmbitoAplicacion.Trabajador, TrabajadorId: { } trabajadorId } => trabajadorId,
        { Ambito: AmbitoAplicacion.Empresa, EmpresaId: { } empresaId } => empresaId,
        _ => null,
    };

    private string TextoEnPlataforma(AcreditacionDelDocumentoDto acreditacion) => acreditacion.SinVigencia
        ? TextosDocumento["EstadoPlataformaSinVigencia"].Value
        : EstadoAcreditacionUi.TextoCapitalizado(acreditacion.Estado);

    private async Task CargarAcreditacionesAsync()
    {
        var carga = ++_cargaAcreditaciones; var id = EntidadId;
        try
        {
            var acreditaciones = await Mediator.Send(new ObtenerAcreditacionesDelDocumentoQuery(id), _cancelacion);
            if (carga != _cargaAcreditaciones) return;
            _acreditaciones = acreditaciones;
        }
        catch (OperationCanceledException) when (_cancelacion.IsCancellationRequested)
        {
            // El panel se cerró: no es un fallo.
        }
        catch (Exception ex)
        {
            // La sección es complementaria: sin ella el panel sigue siendo útil, así que no hay estado de error propio. Si falla
            // la releída tras una acción, se conserva la lista anterior (al cambiar de Documento ya se vació en ReiniciarParaNuevaEntidad).
            if (carga != _cargaAcreditaciones) return;
            Logger.LogWarning(ex, "No se pudieron leer las acreditaciones del Documento {DocumentoId}.", id);
        }
    }

    /// <summary>
    /// Despacha la opción del menú «Acreditación ▾» de la sección a los mismos diálogos y Commands que el listado (D-18).
    /// No decide ninguna autorización: cada Command comprueba la suya (D-3).
    /// </summary>
    private async Task ManejarAccionAcreditacionAsync(AcreditacionDelDocumentoDto acreditacion, AccionAcreditacion accion)
    {
        if (_detalle is null) return;
        switch (accion)
        {
            case AccionAcreditacion.SubirVersionCorregida:
                _drawerVersionMontado = true;
                _abrirVersionPendiente = true;
                break;
            case AccionAcreditacion.MarcarSubido:
                if (_modalesAcreditacion is not null) await _modalesAcreditacion.MarcarSubidoAsync(acreditacion.Id);
                break;
            case AccionAcreditacion.MarcarValidado:
                _modalesAcreditacion?.AbrirValidado(acreditacion.Id);
                break;
            case AccionAcreditacion.MarcarRechazado:
                _modalesAcreditacion?.AbrirRechazo(acreditacion.Id, acreditacion.PlataformaNombre, _detalle.TipoDocumentoNombre, _detalle.PropietarioNombre);
                break;
            case AccionAcreditacion.AnotarVigencia:
                _anotarVigencia?.Abrir([acreditacion.Id], acreditacion.PlataformaNombre);
                break;
            case AccionAcreditacion.Gestionar:
                _acreditacionAGestionar = acreditacion;
                _panelAcreditacionVisible = true;
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_abrirVersionPendiente || _drawerGestion is null) return;
        _abrirVersionPendiente = false;
        await _drawerGestion.AbrirEditarAsync(EntidadId);
    }

    /// <summary>Tras marcar, anotar o gestionar una acreditación: la sección se relee y el listado de detrás repinta la fila.</summary>
    private async Task AlCambiarAcreditacionAsync()
    {
        var id = EntidadId;
        ServiceProvider.GetService<ContextWorkspaceService>()?.NotificarEntidadGuardada(EntidadWorkspace.Documento, id);
        if (id != EntidadId) return;
        await CargarAcreditacionesAsync();
    }

    /// <summary>La versión corregida sustituye el archivo: se relee todo el panel, no solo la sección.</summary>
    private async Task AlGuardarVersionCorregidaAsync()
    {
        ServiceProvider.GetService<ContextWorkspaceService>()?.NotificarEntidadGuardada(EntidadWorkspace.Documento, EntidadId);
        await CargarTodoAsync();
    }

    private static readonly IReadOnlyList<PestanaDefinicion> _pestanas = [new("informacion", "Información"), new("validacion", "Validación"), new("firma", "Firma"), new("historial", "Historial")];
    [Parameter, EditorRequired] public Guid EntidadId { get; set; }
    [Parameter, EditorRequired] public string PestanaActiva { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PestanaActivaChanged { get; set; }

    private readonly CancellationTokenSource _ciclo = new();
    private CancellationToken _cancelacion;
    private DocumentoDetalleDto? _detalle;
    private bool _reclamacionVisible;

    /// <summary>A quién se reclama este documento: su Trabajador o su Empresa titular; null en el resto de ámbitos.</summary>
    private (AmbitoAplicacion Ambito, Guid EntidadId)? TitularReclamable => _detalle switch
    {
        { Ambito: AmbitoAplicacion.Trabajador, TrabajadorId: { } trabajadorId } => (AmbitoAplicacion.Trabajador, trabajadorId),
        { Ambito: AmbitoAplicacion.Empresa, EmpresaId: { } empresaId } => (AmbitoAplicacion.Empresa, empresaId),
        _ => null,
    };
    private ValidacionOficialDocumentoDto? _validacion;
    private bool _cargando = true, _cargandoValidacion = true, _errorValidacion, _error, _editandoInformacion, _guardandoInformacion;
    private string _fechaEmisionEditada = string.Empty, _fechaVencimientoEditada = string.Empty, _comentariosEditados = string.Empty;
    private bool _noCaducaEditado;

    /// <summary>El vencimiento tiene un texto que no es una fecha entera: Guardar no envía «sin vencimiento» por error.</summary>
    private bool _vencimientoNoValido;

    /// <summary>
    /// La emisión tiene un texto que no es una fecha entera. Su valor ya es «» (Guardar lo rechaza y el vencimiento
    /// automático no se calcula de la emisión anterior); la marca da el aviso de corregirla y cuenta como cambio.
    /// </summary>
    private bool _emisionNoValida;
    private readonly InstantaneaFormulario _instantaneaInformacion = new();

    // Al volver a ser una fecha entera (o quedar vacío), el aviso «no es una fecha» de un envío anterior ya no es cierto.
    private void AlCambiarVencimientoNoValido(bool noValido)
    {
        _vencimientoNoValido = noValido;
        if (!noValido && _mensajeErrorInformacion == Comunes["CampoFechaCorregirAntes"])
            _mensajeErrorInformacion = null;
    }

    /// <summary>
    /// P1-E2b: la renovación en línea (fechas y comentarios) comparada con cómo se abrió. Un vencimiento a medias no cambia el
    /// valor del formulario («»), pero es texto que se pierde al salir.
    /// </summary>
    private bool HayCambiosSinGuardar =>
        _editandoInformacion && (_instantaneaInformacion.Difiere(ValoresInformacion()) || _vencimientoNoValido || _emisionNoValida);

    private object?[] ValoresInformacion() => [_fechaEmisionEditada, _fechaVencimientoEditada, _noCaducaEditado, _comentariosEditados];
    private string? _mensajeErrorInformacion;
    private Guid _idCargado;
    private int _generacion, _cargaCabecera, _cargaValidacion;

    private string PestanaEfectiva => _pestanas.Any(p => p.Id == PestanaActiva) ? PestanaActiva : _pestanas[0].Id;

    protected override void OnInitialized() => _cancelacion = _ciclo.Token;

    protected override async Task OnParametersSetAsync()
    {
        if (EntidadId == _idCargado) return;
        _idCargado = EntidadId;
        ReiniciarParaNuevaEntidad();
        await CargarTodoAsync();
    }

    private void ReiniciarParaNuevaEntidad()
    {
        _generacion++; _cargaCabecera++; _cargaValidacion++;
        _detalle = null; _validacion = null; _errorValidacion = false; _error = false; _cargando = true; _cargandoValidacion = true;
        _editandoInformacion = false; _guardandoInformacion = false; _mensajeErrorInformacion = null;
        // El panel se reutiliza al cambiar de documento: una reclamación abierta era la
        // del documento anterior y no puede quedarse abierta contra otro titular.
        _reclamacionVisible = false;
        // Lo mismo para la sección «Plataformas CAE», el visor y los diálogos de acreditación del documento anterior.
        _cargaAcreditaciones++; _acreditaciones = null; _visorVisible = false;
        _acreditacionAGestionar = null; _panelAcreditacionVisible = false; _abrirVersionPendiente = false;
    }

    private Task ReintentarAsync() => _cargando ? Task.CompletedTask : CargarTodoAsync();

    private async Task CargarTodoAsync()
    {
        var generacion = _generacion;
        await CargarCabeceraAsync();
        if (generacion != _generacion || _detalle is null) return;
        await CargarAcreditacionesAsync();
        if (generacion != _generacion) return;
        await CargarValidacionAsync();
    }

    private async Task CargarCabeceraAsync()
    {
        var carga = ++_cargaCabecera; var id = EntidadId;
        _cargando = true; _error = false;
        try
        {
            var detalle = await Mediator.Send(new ObtenerDocumentoPorIdQuery(id), _cancelacion);
            if (carga != _cargaCabecera) return;
            _detalle = detalle;
        }
        catch (OperationCanceledException) when (_cancelacion.IsCancellationRequested)
        {
            // El panel se cerró: no es un fallo.
        }
        catch (Exception ex)
        {
            if (carga != _cargaCabecera) return;
            _error = true;
            Logger.LogError(ex, "No se pudo cargar la ficha del Documento {DocumentoId}.", id);
        }
        finally
        {
            if (carga == _cargaCabecera) _cargando = false;
        }
    }

    private async Task CargarValidacionAsync()
    {
        var carga = ++_cargaValidacion; var id = EntidadId;
        _cargandoValidacion = true; _errorValidacion = false;
        try
        {
            var validacion = await Mediator.Send(new ObtenerValidacionOficialDocumentoQuery(id), _cancelacion);
            if (carga != _cargaValidacion) return;
            _validacion = validacion;
        }
        catch (OperationCanceledException) when (_cancelacion.IsCancellationRequested)
        {
            // El panel se cerró: no es un fallo.
        }
        catch (Exception ex)
        {
            // Sin esto «Sin validación automática» sería indistinguible de una lectura fallida.
            if (carga != _cargaValidacion) return;
            _errorValidacion = true;
            Logger.LogError(ex, "No se pudo leer la validación oficial del Documento {DocumentoId}.", id);
        }
        finally
        {
            if (carga == _cargaValidacion) _cargandoValidacion = false;
        }
    }

    private void IniciarEdicionInformacion()
    {
        if (_detalle is null) return;
        // Este panel corrige el mismo registro sin sustituir el archivo: conserva ambas fechas.
        _fechaEmisionEditada = _detalle.FechaEmision.ToString("yyyy-MM-dd");
        _fechaVencimientoEditada = _detalle.FechaVencimiento?.ToString("yyyy-MM-dd") ?? string.Empty;
        // Editar solo fechas o comentarios no puede perder la confirmación
        // de «no caduca»: se precarga y viaja de vuelta en el comando.
        _noCaducaEditado = _detalle.EstadoVigencia == EstadoVigenciaDocumento.NoCaduca;
        _comentariosEditados = _detalle.Comentarios ?? string.Empty;
        _mensajeErrorInformacion = null;
        _vencimientoNoValido = false;
        _emisionNoValida = false;
        _editandoInformacion = true;
        _instantaneaInformacion.Fijar(ValoresInformacion());
    }

    private void CancelarEdicionInformacion() => _editandoInformacion = false;

    private async Task GuardarInformacionAsync()
    {
        if (_detalle is null || _guardandoInformacion) return;
        var generacion = _generacion; var detalle = _detalle;
        _guardandoInformacion = true; _mensajeErrorInformacion = null;
        try
        {
            if (_emisionNoValida || !DateOnly.TryParse(_fechaEmisionEditada, out var fechaEmision))
            {
                _mensajeErrorInformacion = _emisionNoValida ? Comunes["CampoFechaCorregirAntes"] : "Introduce una fecha de emisión válida.";
                return;
            }
            if (_vencimientoNoValido && !detalle.TipoDocumentoAplicaVencimientoAutomatico)
            {
                _mensajeErrorInformacion = Comunes["CampoFechaCorregirAntes"];
                return;
            }
            var fechaVencimiento = DateOnly.TryParse(_fechaVencimientoEditada, out var fecha) ? fecha : (DateOnly?)null;
            if (fechaVencimiento is not null && _noCaducaEditado)
            {
                _mensajeErrorInformacion = TextosVigenciaDocumento.Texto("ErrorFechaYNoCaduca");
                return;
            }
            var resultado = await Mediator.Send(new RenovarDocumentoCommand(detalle.Id, fechaEmision, fechaVencimiento, null, string.IsNullOrWhiteSpace(_comentariosEditados) ? null : _comentariosEditados, detalle.Version,
                NoCaduca: !detalle.TipoDocumentoAplicaVencimientoAutomatico && _noCaducaEditado));
            if (resultado.EsFallido)
            {
                if (generacion == _generacion) _mensajeErrorInformacion = resultado.Error.Mensaje;
                else Avisar($"No pudimos renovar {detalle.TipoDocumentoNombre}: {resultado.Error.Mensaje}", TonoToast.Error);
                return;
            }
            // El guardado ya es firme aunque el panel haya pasado a otra ficha: el listado que
            // tenga esta fila a la vista la vuelve a pedir y la sustituye en sitio.
            ServiceProvider.GetService<ContextWorkspaceService>()?.NotificarEntidadGuardada(EntidadWorkspace.Documento, detalle.Id);
            Avisar($"{detalle.TipoDocumentoNombre}: fechas y comentarios actualizados; el archivo no se ha sustituido.", TonoToast.Exito);
            if (generacion != _generacion) return;
            _editandoInformacion = false;
            await CargarTodoAsync();
        }
        catch (ValidationException ex)
        {
            var mensaje = ex.Errors.FirstOrDefault()?.ErrorMessage ?? "Revisa los datos de la renovación.";
            if (generacion == _generacion) _mensajeErrorInformacion = mensaje;
            else Avisar($"No pudimos renovar {detalle.TipoDocumentoNombre}: {mensaje}", TonoToast.Error);
        }
        catch (Exception)
        {
            const string mensaje = "No pudimos guardar la renovación. Intenta nuevamente en unos segundos.";
            if (generacion == _generacion) _mensajeErrorInformacion = mensaje;
            else Avisar($"No pudimos renovar {detalle.TipoDocumentoNombre}. Intenta nuevamente en unos segundos.", TonoToast.Error);
        }
        finally
        {
            if (generacion == _generacion) _guardandoInformacion = false;
        }
    }

    private static TonoBadge TonoDeNivel(NivelConfianzaDocumental nivel) => ValidacionOficialUi.TonoDeNivel(nivel);
    private static string TextoDeNivel(NivelConfianzaDocumental nivel) => ValidacionOficialUi.TextoDeNivel(nivel);
    private string TextoDeDecision(DecisionValidacionOficial decision) => decision switch { DecisionValidacionOficial.AutoValidado => TextosDocumento["ValDecisionVerificadoAutomaticamente"], DecisionValidacionOficial.RevisionRequerida => "Revisión requerida", _ => "Sin firma válida" };

    private void Avisar(string mensaje, TonoToast tono) => ServiceProvider.GetService<ToastService>()?.Mostrar(mensaje, tono);

    public void Dispose()
    {
        _generacion++; _cargaCabecera++; _cargaValidacion++; _cargaAcreditaciones++;
        _ciclo.Cancel(); _ciclo.Dispose();
    }
}
