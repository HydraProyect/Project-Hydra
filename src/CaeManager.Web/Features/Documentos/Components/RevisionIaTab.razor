@using CaeManager.Application.Documentos.Queries.ObtenerRevisionesIaPendientes
@using CaeManager.Application.Documentos.Commands.CorregirRevisionIaDocumento
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Features.Documentos.Recursos
@using Microsoft.Extensions.Localization
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosDocumentos> Textos

<section class="revision-ia" aria-label="Revisiones IA pendientes">
    <div class="revision-ia-introduccion">
        <p>
            Documentos donde la verificación automática por IA detectó confianza baja o una discrepancia con lo introducido al subirlos.
            Revisa cada caso: nada se corrige automáticamente.
        </p>
        <div class="revision-ia-reglas" aria-label="Criterios de la cola">
            <span>Ordenadas por confianza ascendente</span>
            <span>@Textos["RevIaReglaBloque"]</span>
        </div>
    </div>
    @if (_fallosBloque.Count > 0)
    {
        <div class="revision-ia-resultado" role="status">
            <strong>@Textos["RevIaFallosTitulo", _fallosBloque.Count]</strong>
            <ul>
                @foreach (var fallo in _fallosBloque)
                {
                    <li>@fallo.Propietario · @fallo.Tipo — @fallo.Motivo</li>
                }
            </ul>
            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="CerrarFallosBloque">@Textos["RevIaCerrar"]</Boton>
        </div>
    }
    @if (_errorCarga)
    {
        <EstadoVacio
            Titulo="No pudimos cargar las revisiones"
            Descripcion="Intenta nuevamente en unos segundos. Ninguna revisión se ha resuelto.">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_revisiones.Count == 0)
    {
        <EstadoVacio
            Titulo="Sin revisiones pendientes"
            Descripcion="No hay documentos pendientes de revisión IA." />
    }
    else if (RevisionesVisibles.Count == 0)
    {
        <EstadoVacio
            Titulo="Ningún resultado con este filtro"
            Descripcion="Hay revisiones en la cola, pero ninguna cumple el filtro activo.">
            <Accion>
                <Boton Variante="VarianteBoton.Secundario" OnClick="QuitarFiltro">
                    Quitar el filtro
                </Boton>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <div class="revision-ia-acciones">
            <span>
                @RevisionesVisibles.Count @(RevisionesVisibles.Count == 1 ? "extracción pendiente" : "extracciones pendientes")
            </span>
            <div class="revision-ia-seleccion">
                <CampoSelect Etiqueta="@Textos["RevIaConfianzaDesde"]" Valor="@_confianzaMinima.ToString()" ValorChanged="CambiarConfianzaMinima" Deshabilitado="_operacionEnCurso">
                    @foreach (var minima in ConfianzasMinimas)
                    {
                        <option value="@minima">@minima %</option>
                    }
                </CampoSelect>
                <Boton
                    Variante="VarianteBoton.Secundario"
                    Deshabilitado="@(RevisionesSeleccionadas.Count == 0 || _operacionEnCurso)"
                    OnClick="PrepararConfirmacionLote">
                    @Textos["RevIaAceptarSeleccionadas", RevisionesSeleccionadas.Count]
                </Boton>
            </div>
            <p class="revision-ia-ayuda-seleccion">
                @Textos["RevIaAyudaSeleccion"]
            </p>
        </div>
        <div class="revision-ia-contenido">
            <aside class="revision-ia-cola" aria-label="Extracciones por revisar">
                <header>
                    <strong>Extracciones por revisar</strong>
                    <span>@RevisionesVisibles.Count pendientes</span>
                </header>
                <div class="revision-ia-filtros" aria-label="Filtrar revisiones">
                    @foreach (var filtro in Filtros)
                    {
                        <button
                            type="button"
                            class="@ClaseFiltro(filtro)"
                            aria-pressed="@(_filtro == filtro)"
                            @onclick="() => CambiarFiltro(filtro)">
                            @TextoFiltro(filtro)
                        </button>
                    }
                </div>
                @foreach (var revision in RevisionesVisibles)
                {
                    var aceptable = EsAceptableEnBloque(revision);
                    <div class="revision-ia-fila-selector">
                    <input
                        type="checkbox"
                        class="revision-ia-casilla"
                        checked="@_seleccion.Contains(revision.Id)"
                        disabled="@(!aceptable || _operacionEnCurso)"
                        title="@(aceptable ? Textos["RevIaCasillaIncluir"] : Textos["RevIaCasillaManual", EtiquetaTratamiento(revision)])"
                        aria-label="@Textos["RevIaCasillaEtiqueta", revision.PropietarioNombre, revision.TipoDocumentoNombre]"
                        @onchange="e => AlternarSeleccion(revision, e.Value is true)" />
                    <button
                        type="button"
                        class="@ClaseRevision(revision)"
                        aria-pressed="@(RevisionSeleccionada?.Id == revision.Id)"
                        @onclick="() => SeleccionarRevision(revision.Id)">
                        <span class="revision-ia-fila-cabecera">
                            <strong>@revision.PropietarioNombre</strong>
                            <em>@Ambito(revision)</em>
                        </span>
                        <span>@revision.TipoDocumentoNombre</span>
                        <span class="revision-ia-confianza">
                            <span>Confianza @revision.ConfianzaGeneral %</span>
                            <span class="revision-ia-confianza-barra">
                                <span
                                    class="@(
                                        "revision-ia-confianza-relleno revision-ia-confianza-relleno-" +
                                        TonoConfianza(revision.ConfianzaGeneral).ToString().ToLowerInvariant())"
                                    style="width:@(revision.ConfianzaGeneral)%">
                                </span>
                            </span>
                            <small>@EtiquetaTratamiento(revision)</small>
                        </span>
                    </button>
                    </div>
                }
            </aside>
            @if (RevisionSeleccionada is { } seleccionada)
            {
                <article class="revision-ia-detalle">
                    <header class="revision-ia-detalle-cabecera">
                        <div>
                            <h2>@seleccionada.PropietarioNombre</h2>
                            <p>@seleccionada.TipoDocumentoNombre</p>
                        </div>
                        <span class="@("revision-ia-estado revision-ia-estado-" + TonoConfianza(seleccionada.ConfianzaGeneral).ToString().ToLowerInvariant())">
                            @EtiquetaTratamiento(seleccionada)
                        </span>
                    </header>
                    <div class="revision-ia-detalle-cuerpo">
                        <div class="revision-ia-vista-documento">
                            <Boton
                                Variante="VarianteBoton.Secundario"
                                Tamano="TamanoBoton.Pequeno"
                                OnClick="() => AlternarPrevisualizacion(seleccionada.DocumentoId)">
                                @(_documentoIdExpandido == seleccionada.DocumentoId ? "Ocultar documento" : "Ver documento")
                            </Boton>
                            @if (_documentoIdExpandido == seleccionada.DocumentoId)
                            {
                                <iframe
                                    class="previsualizacion-documento"
                                    src="@($"/documentos/{seleccionada.DocumentoId}/archivo")"
                                    title="Vista previa del documento">
                                </iframe>
                            }
                        </div>
                        <div class="revision-ia-lectura">
                            <div class="revision-ia-motivo">
                                <h3>Por qué requiere revisión</h3>
                                <p>@seleccionada.Motivo</p>
                            </div>
                            <dl>
                                <div>
                                    <dt>Tipo de documento</dt>
                                    <dd>Introducido: @seleccionada.TipoDocumentoNombre</dd>
                                    <dd>Leído: @(seleccionada.TipoDetectado ?? "No determinado")</dd>
                                </div>
                                <div>
                                    <dt>Fecha de emisión</dt>
                                    <dd>Introducida: @Fecha(seleccionada.FechaEmisionIntroducida)</dd>
                                    <dd>Leída: @Fecha(seleccionada.FechaEmisionDetectada)</dd>
                                </div>
                                <div>
                                    <dt>Fecha de vencimiento</dt>
                                    <dd>Introducida: @Fecha(seleccionada.FechaVencimientoIntroducida)</dd>
                                    <dd>Leída: @Fecha(seleccionada.FechaVencimientoDetectada)</dd>
                                </div>
                                <div>
                                    <dt>Firma</dt>
                                    <dd>Introducida: No se solicita al subir</dd>
                                    <dd>Leída: @Firma(seleccionada.TieneFirmaDetectada)</dd>
                                </div>
                                <div>
                                    <dt>Páginas del documento</dt>
                                    <dd>@(seleccionada.NumeroPaginas?.ToString() ?? "No disponibles")</dd>
                                </div>
                                <div>
                                    <dt>Región de firma</dt>
                                    <dd>No disponible en la extracción actual</dd>
                                </div>
                            </dl>
                            @if (seleccionada.FechaEmisionDetectada is not null)
                            {
                                <p class="revision-ia-consecuencia">
                                    Al aceptar, se aplicará la fecha de emisión detectada y se recalculará el vencimiento cuando el tipo de documento lo haga automáticamente.
                                </p>
                            }
                            else
                            {
                                <p class="revision-ia-consecuencia">
                                    No se puede aceptar la detección porque la IA no detectó una fecha de emisión que aplicar.
                                </p>
                            }
                            <div class="revision-ia-acciones-detalle">
                                <Boton
                                    Variante="VarianteBoton.Primario"
                                    Deshabilitado="@(seleccionada.FechaEmisionDetectada is null)"
                                    Cargando="@(_procesandoId == seleccionada.Id)"
                                    OnClick="() => AceptarDeteccionAsync(seleccionada.Id)">
                                    Aceptar detección
                                </Boton>
                                <Boton
                                    Variante="VarianteBoton.Secundario"
                                    Cargando="@(_procesandoId == seleccionada.Id)"
                                    OnClick="PrepararCorreccionManual">
                                    Corregir a mano…
                                </Boton>
                                <Boton
                                    Variante="VarianteBoton.Secundario"
                                    Cargando="@(_procesandoId == seleccionada.Id)"
                                    OnClick="PrepararDescartar">
                                    Descartar la lectura
                                </Boton>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
<Drawer @ref="_drawerCorreccion" HayCambios="() => HayCambiosSinGuardar" Visible="_correccionManualVisible" VisibleChanged="v => _correccionManualVisible = v" Titulo="Corregir a mano" CerrarAlHacerClicFuera="@(!_operacionEnCurso)">
    <ChildContent>
        @if (RevisionSeleccionada is { } seleccionada)
        {
            <p>@seleccionada.PropietarioNombre · @seleccionada.TipoDocumentoNombre</p>
            <CampoTexto Etiqueta="Fecha de emisión" Type="date" Valor="@_fechaEmisionManual" ValorChanged="v => _fechaEmisionManual = v" MensajeError="@_errorFechaManual" />
            <p class="revision-ia-consecuencia">La IA leyó: @Fecha(seleccionada.FechaEmisionDetectada)</p>
            <p class="revision-ia-consecuencia">Guardar corrige la fecha y cierra el aviso en una sola operación. El vencimiento se recalcula solo cuando el tipo lo hace automáticamente.</p>
        }
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_operacionEnCurso" OnClick="() => _drawerCorreccion?.SolicitarCierreAsync() ?? Task.CompletedTask">Cancelar</Boton>
        <Boton Variante="VarianteBoton.Primario" Cargando="@(_procesandoId == _revisionIdSeleccionada)" OnClick="CorregirSeleccionadaAsync">Guardar y cerrar el aviso</Boton>
    </Pie>
</Drawer>
<DialogoConfirmacion
    Visible="_confirmacionLoteVisible"
    VisibleChanged="v => _confirmacionLoteVisible = v"
    Titulo="@Textos["RevIaDialogoTitulo"]"
    Mensaje="@Textos["RevIaDialogoMensaje", RevisionesSeleccionadas.Count]"
    TextoBotonConfirmar="@Textos["RevIaDialogoConfirmar"]"
    EnProgreso="_confirmandoLote"
    OnConfirmar="AceptarSeleccionadasAsync" />
<DialogoConfirmacion
    Visible="_confirmacionDescartarVisible"
    VisibleChanged="v => _confirmacionDescartarVisible = v"
    Titulo="Descartar la lectura de la IA"
    Mensaje="El aviso se cerrará y el documento se conservará sin aplicar la detección."
    TextoBotonConfirmar="Descartar la lectura"
    EnProgreso="@(_procesandoId is not null)"
    OnConfirmar="ResolverSeleccionadaAsync" />

@* P1-E2: salir con la corrección manual de la fecha a medias pregunta antes; confirmar la
   salida cierra la corrección. Va al final para quedar encima de los demás diálogos. *@
<AvisoCambiosSinGuardar HayCambios="() => HayCambiosSinGuardar" AlDescartar="CerrarCorreccionManual" />
