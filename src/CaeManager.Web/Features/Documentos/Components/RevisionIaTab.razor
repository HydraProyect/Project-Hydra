@using CaeManager.Application.Documentos.Queries.ObtenerRevisionesIaPendientes
@using CaeManager.Application.Documentos.Commands.CorregirRevisionIaDocumento
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Features.Documentos.Recursos
@using Microsoft.Extensions.Localization
@using MediatR
@inject IMediator Mediator
@inject ToastService ToastService
@inject IJSRuntime Js
@inject IStringLocalizer<TextosDocumentos> Textos

@*
    Revisión IA (decisión D-49, artboard «Revision-ia» del lienzo «Documentos · listado sin pestañas»): pantalla propia. El
    documento ocupa la parte izquierda (se carga solo al seleccionar, ver el iframe más abajo) y la revisión va en un lateral fijo —desplegable de pendientes con «1 de N ‹ ›»,
    motivo, campos en lista corta y las tres decisiones—. El nombre RevisionIaTab es de cuando era una pestaña de
    Documentos; la PR que retire la barra de pestañas puede renombrarlo.
*@
<section class="revision-ia" aria-label="@Textos["RevIaSeccionAria"]">
    <div class="revision-ia-cabecera">
        <div class="revision-ia-cabecera-textos">
            <a class="revision-ia-volver" href="/documentos">@Textos["RevIaVolver"]</a>
            <div class="revision-ia-titular">
                <h1 class="titulo-pagina">@Textos["PestanaRevisionIa"]</h1>
                @if (_revisiones.Count > 0)
                {
                    <Badge Tono="TonoBadge.Advertencia">@_revisiones.Count</Badge>
                }
            </div>
        </div>
        <div class="revision-ia-acciones-cabecera">
            @* Los dos destinos son de Administrador (AuditoriaIa.razor y SeleccionarClienteLecturaIa.razor):
               a quien no lo es, el enlace le llevaría a «Acceso denegado». *@
            <AuthorizeView Roles="@CaeManager.Infrastructure.Identity.Roles.Administrador">
                <div class="revision-ia-enlaces">
                    <a href="/auditoria-ia">@Textos["RevIaVerAuditoria"]</a>
                    <a href="/configuracion/lectura-ia">@Textos["RevIaConfigurarLectura"]</a>
                </div>
            </AuthorizeView>
            @if (!_cargando && !_errorCarga && ConfirmablesEnBloque.Count > 0)
            {
                <SoloConEscritura>
                    <Boton Variante="VarianteBoton.Secundario" Deshabilitado="_operacionEnCurso" OnClick="PrepararConfirmacionLote">
                        @TextoConfirmarTodos
                    </Boton>
                </SoloConEscritura>
            }
        </div>
    </div>
    @if (_fallosBloque.Count > 0)
    {
        <div class="revision-ia-resultado" role="status">
            <strong>@Textos["RevIaFallosTitulo", _fallosBloque.Count]</strong>
            <ul>
                @foreach (var fallo in _fallosBloque)
                {
                    <li>@fallo.Propietario · @fallo.Tipo — @fallo.Motivo</li>
                }
            </ul>
            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" OnClick="CerrarFallosBloque">@Textos["RevIaCerrar"]</Boton>
        </div>
    }
    @if (_errorCarga)
    {
        <EstadoVacio
            Titulo="@Textos["RevIaErrorTitulo"]"
            Descripcion="@Textos["RevIaErrorDescripcion"]">
            <Accion>
                <Boton Variante="VarianteBoton.Primario" OnClick="() => CargarAsync()">@Textos["RevIaReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_cargando)
    {
        <EstadoCargando Filas="4" />
    }
    else if (_revisiones.Count == 0)
    {
        <div class="revision-ia-tarjeta">
            <EstadoVacio
                Titulo="@(_revisadas > 0 ? Textos["RevIaTerminadoTitulo"].Value : Textos["RevIaSinPendientesTitulo"].Value)"
                Descripcion="@DescripcionSinPendientes">
                <Accion>
                    <Boton Variante="VarianteBoton.Secundario" Href="/documentos">@Textos["RevIaVolver"]</Boton>
                </Accion>
            </EstadoVacio>
        </div>
    }
    else
    {
        <AtajosListaTeclado OnAtajo="ManejarAtajoAsync" />
        <div class="revision-ia-tarjeta">
            <div class="revision-ia-contenido">
                <div class="revision-ia-pdf">
                    @if (RevisionSeleccionada is { } actual)
                    {
                        <div class="revision-ia-pdf-barra">
                            <strong>@actual.TipoDocumentoNombre</strong>
                            @if (actual.NumeroPaginas is > 0 and var paginas)
                            {
                                <span class="revision-ia-mudo">@(paginas == 1 ? Textos["RevIaUnaPagina"].Value : string.Format(Textos["RevIaNPaginas"].Value, paginas))</span>
                            }
                            <span class="revision-ia-pdf-barra-der">
                                <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno" Href="@($"/documentos/{actual.DocumentoId}/archivo")" download target="_blank" rel="noopener">@Textos["RevIaDescargar"]</Boton>
                            </span>
                        </div>
                        @* D-49: el documento de la revisión seleccionada se carga solo, por la ruta de la revisión: el servidor sirve
                           el Documento de esa revisión pendiente: cada acceso del visor de Revisión IA a un Documento sensible
                           deja una fila de tipo Revisión IA, igual que cada Apertura; cuenta para la señal de extracción masiva.
                           «Descargar» sigue en /documentos/{id}/archivo, como
                           Apertura. El @key con el Id de la revisión impide que se vea el documento de otra al cambiar de selección. *@
                        <iframe
                            @key="actual.Id"
                            class="previsualizacion-documento"
                            src="@($"/documentos/revision-ia/{actual.Id}/archivo")"
                            title="@string.Format(Textos["RevIaDocumentoAria"].Value, actual.PropietarioNombre, actual.TipoDocumentoNombre)">
                        </iframe>
                    }
                    else
                    {
                        <p class="revision-ia-pdf-vacio">@Textos["RevIaEligeRevision"]</p>
                    }
                </div>
                <aside class="revision-ia-lateral" aria-label="@Textos["RevIaLateralAria"]" @onkeydown="TeclaEnLateral">
                    <div class="revision-ia-selector">
                        <span class="revision-ia-ancla">
                            <button
                                type="button"
                                class="revision-ia-selector-boton"
                                @ref="_botonSelector"
                                aria-controls="revision-ia-pop"
                                aria-expanded="@(_desplegableAbierto ? "true" : "false")"
                                @onclick="AlternarDesplegable">
                                <span class="revision-ia-selector-textos">
                                    @if (RevisionSeleccionada is { } elegida)
                                    {
                                        <strong>@elegida.PropietarioNombre</strong>
                                        <span class="revision-ia-mudo">@elegida.TipoDocumentoNombre</span>
                                    }
                                    else
                                    {
                                        <strong>@Textos["RevIaEligeRevision"]</strong>
                                        <span class="revision-ia-mudo">@PendientesTexto(RevisionesVisibles.Count)</span>
                                    }
                                </span>
                                <span class="revision-ia-selector-n">@PosicionTexto</span>
                                <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
                            </button>
                            @if (_desplegableAbierto)
                            {
                                <div class="revision-ia-pop-fondo" @onclick="CerrarDesplegable"></div>
                                @* El panel agrupa filtros, opciones y pie; solo las opciones son el listbox. Flechas, Inicio y Fin
                                   las recorren (revision-ia.js) y Escape devuelve el foco al disparador. *@
                                <div class="revision-ia-pop" id="revision-ia-pop" @ref="_popRef">
                                    <div class="revision-ia-filtros" role="group" aria-label="@Textos["RevIaFiltrarAria"]">
                                        @foreach (var filtro in Filtros)
                                        {
                                            var recuento = Recuento(filtro);
                                            <button
                                                type="button"
                                                class="revision-ia-filtro"
                                                data-filtro="@filtro.ToString().ToLowerInvariant()"
                                                aria-pressed="@(_filtro == filtro ? "true" : "false")"
                                                disabled="@(recuento == 0 && _filtro != filtro)"
                                                @onclick="() => CambiarFiltro(filtro)">
                                                @TextoFiltro(filtro) <span>@recuento</span>
                                            </button>
                                        }
                                    </div>
                                    <div class="revision-ia-opciones" role="listbox" aria-label="@Textos["RevIaPendientesAria"]">
                                        @foreach (var revision in RevisionesVisibles)
                                        {
                                            <button
                                                type="button"
                                                role="option"
                                                class="revision-ia-opcion"
                                                aria-selected="@(RevisionSeleccionada?.Id == revision.Id ? "true" : "false")"
                                                @onclick="() => SeleccionarDesdeDesplegable(revision.Id)">
                                                <strong>@revision.PropietarioNombre <span class="revision-ia-mudo revision-ia-ambito">· @Ambito(revision)</span></strong>
                                                <span>@revision.TipoDocumentoNombre</span>
                                                <ConfianzaIa Revision="revision" Etiqueta="@EtiquetaTratamiento(revision)" />
                                            </button>
                                        }
                                    </div>
                                    <div class="revision-ia-pop-pie">@Textos["RevIaOrdenPie"]</div>
                                </div>
                            }
                        </span>
                        <Boton Variante="VarianteBoton.Secundario" class="revision-ia-nav" aria-label="@Textos["RevIaAnterior"]" title="@Textos["RevIaAnteriorTitulo"]"
                               Deshabilitado="@(!HayAnterior || _operacionEnCurso)" OnClick="IrAlAnteriorAsync">‹</Boton>
                        <Boton Variante="VarianteBoton.Secundario" class="revision-ia-nav" aria-label="@Textos["RevIaSiguiente"]" title="@Textos["RevIaSiguienteTitulo"]"
                               Deshabilitado="@(!HaySiguiente || _operacionEnCurso)" OnClick="IrAlSiguienteAsync">›</Boton>
                    </div>
                    @if (RevisionSeleccionada is { } seleccionada)
                    {
                        <div class="revision-ia-cab">
                            <Badge Tono="TonoTratamiento(seleccionada)">@EtiquetaTratamiento(seleccionada)</Badge>
                            <ConfianzaIa Revision="seleccionada" Etiqueta="@EtiquetaTratamiento(seleccionada)" />
                        </div>
                        <div class="revision-ia-motivo">
                            <h3>@Textos["RevIaPorQueTitulo"]</h3>
                            <p>@seleccionada.Motivo</p>
                            @if (seleccionada.TieneAlertaDeterminista)
                            {
                                <p class="revision-ia-alerta">@Textos["RevIaAlertaDeUnaEnUna"]</p>
                            }
                        </div>
                        <ul class="revision-ia-campos">
                            @foreach (var fila in FilasComparacion(seleccionada))
                            {
                                <li class="@(fila.Difiere ? "dif" : null)">
                                    <span class="k">@fila.Campo</span>
                                    <span class="v">
                                        @if (fila.FechaIntroducida is { } fechaIntroducida)
                                        {
                                            <TextoFechaCopiable Fecha="fechaIntroducida">@fila.Introducido</TextoFechaCopiable>
                                        }
                                        else
                                        {
                                            @fila.Introducido
                                        }
                                    </span>
                                    <span class="@(fila.Coincide ? "ia ok" : "ia")">
                                        @if (fila.FechaLeida is { } fechaLeida)
                                        {
                                            <TextoFechaCopiable Fecha="fechaLeida">@fila.Leido</TextoFechaCopiable>
                                        }
                                        else
                                        {
                                            @fila.Leido
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                        <p id="consecuencia-aceptar-deteccion" class="revision-ia-consecuencia">
                            @(seleccionada.FechaEmisionDetectada is null ? Textos["RevIaSiAceptasSinFecha"] : Textos["RevIaSiAceptasConFecha"])
                        </p>
                        <div class="revision-ia-acc">
                            <SoloConEscritura>
                                <div class="revision-ia-botones">
                                    <Boton
                                        class="revision-ia-boton-aceptar" aria-describedby="consecuencia-aceptar-deteccion"
                                        Variante="VarianteBoton.Primario"
                                        Deshabilitado="@(seleccionada.FechaEmisionDetectada is null)"
                                        Cargando="@(_procesandoId == seleccionada.Id)"
                                        OnClick="() => AceptarDeteccionAsync(seleccionada.Id)">
                                        @Textos["RevIaAceptar"]
                                    </Boton>
                                    <Boton
                                        class="revision-ia-boton-corregir"
                                        Variante="VarianteBoton.Secundario"
                                        Cargando="@(_procesandoId == seleccionada.Id)"
                                        OnClick="PrepararCorreccionManual">
                                        @Textos["RevIaCorregir"]
                                    </Boton>
                                    <Boton
                                        class="revision-ia-boton-descartar"
                                        Variante="VarianteBoton.Secundario"
                                        Cargando="@(_procesandoId == seleccionada.Id)"
                                        OnClick="PrepararDescartar">
                                        @Textos["RevIaDescartar"]
                                    </Boton>
                                </div>
                            </SoloConEscritura>
                            <label class="revision-ia-avance">
                                <input type="checkbox" checked="@_avanceAutomatico" @onchange="e => CambiarAvanceAsync(e.Value is true)" />
                                @Textos["RevIaAvance"]
                            </label>
                            @if (_avanceAutomatico && SiguienteDeLaLista is { } proxima)
                            {
                                <span class="revision-ia-ayuda">@string.Format(Textos["RevIaSiguienteA"].Value, proxima.PropietarioNombre, proxima.TipoDocumentoNombre)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="revision-ia-consecuencia">@Textos["RevIaEligeRevisionAyuda"]</p>
                        <label class="revision-ia-avance">
                            <input type="checkbox" checked="@_avanceAutomatico" @onchange="e => CambiarAvanceAsync(e.Value is true)" />
                            @Textos["RevIaAvance"]
                        </label>
                    }
                </aside>
            </div>
        </div>
    }
</section>
<DrawerFormulario Visible="_correccionManualVisible" VisibleChanged="v => _correccionManualVisible = v" Titulo="@Textos["RevIaCorregirTitulo"]"
                  HayCambios="() => HayCambiosSinGuardar" Guardando="_operacionEnCurso" HayErroresDeCampo="@(_errorFechaManual is not null)" MensajeError="@_mensajeErrorCorreccion"
                  OnGuardar="CorregirSeleccionadaAsync" TextoCancelar="@Textos["RevIaCancelar"]" TextoGuardar="@Textos["RevIaGuardarCerrar"]">
    <ChildContent>
        @if (RevisionSeleccionada is { } seleccionada)
        {
            <p>@seleccionada.PropietarioNombre · @seleccionada.TipoDocumentoNombre</p>
            <CampoTexto Etiqueta="@Textos["RevIaCampoEmision"]" Type="date" Valor="@_fechaEmisionManual" ValorChanged="v => { _fechaEmisionManual = v; _errorFechaManual = null; }" MensajeError="@_errorFechaManual"
                        FechaNoValida="_emisionManualNoValida" FechaNoValidaChanged="v => _emisionManualNoValida = v" />
            <p class="revision-ia-alerta">@string.Format(Textos["RevIaLaIaLeyo"].Value, Fecha(seleccionada.FechaEmisionDetectada))</p>
            <p class="revision-ia-alerta">@Textos["RevIaGuardarAyuda"]</p>
        }
    </ChildContent>
</DrawerFormulario>
<DialogoConfirmacion
    Visible="_confirmacionLoteVisible"
    VisibleChanged="v => _confirmacionLoteVisible = v"
    Titulo="@Textos["RevIaDialogoTitulo"]"
    Mensaje="@MensajeConfirmacionLote"
    TextoBotonConfirmar="@Textos["RevIaDialogoConfirmar"]"
    EnProgreso="_confirmandoLote"
    OnConfirmar="AceptarConfirmablesAsync" />
<DialogoConfirmacion
    Visible="_confirmacionDescartarVisible"
    VisibleChanged="v => _confirmacionDescartarVisible = v"
    Titulo="@Textos["RevIaDescartarTitulo"]"
    Mensaje="@Textos["RevIaDescartarMensaje"]"
    TextoBotonConfirmar="@Textos["RevIaDescartar"]"
    EnProgreso="@(_procesandoId is not null)"
    OnConfirmar="ResolverSeleccionadaAsync" />

@code {
    private string DescripcionSinPendientes => _revisadas switch
    {
        0 => Textos["RevIaSinPendientesDescripcion"].Value,
        1 => Textos["RevIaTerminadoUno"].Value,
        _ => string.Format(Textos["RevIaTerminadoVarios"].Value, _revisadas)
    };

    private string PendientesTexto(int n) => n == 1 ? $"1 {Textos["RevIaPendiente"]}" : $"{n} {Textos["RevIaPendientes"]}";
}
