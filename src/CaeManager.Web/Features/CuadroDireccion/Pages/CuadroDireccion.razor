                            <div class="cuadro-bloque cuadro-ancha" data-tarjeta="cmp-linea">
                                <Tarjeta Titulo="@Textos["CmpLineaTitulo"]" Class="cuadro-tarjeta">
                                    @if (_cargandoAnualFacturacion || _anualFacturacion is null)
                                    {
                                        <p class="cuadro-vacio">@Textos["CmpCargando"]</p>
                                    }
                                    else
                                    {
                                        <div class="cuadro-seg" role="group" aria-label="@Textos["CmpMetrica"]">
                                            <button type="button" aria-pressed="@(_metrica == "facturacion" ? "true" : "false")" @onclick='() => CambiarMetrica("facturacion")'>@Textos["MetricaFacturacion"]</button>
                                            <button type="button" aria-pressed="@(_metrica == "gestiones" ? "true" : "false")" @onclick='() => CambiarMetrica("gestiones")'>@Textos["MetricaGestiones"]</button>
                                            <button type="button" aria-pressed="@(_metrica == "altas" ? "true" : "false")" @onclick='() => CambiarMetrica("altas")'>@Textos["MetricaAltasTrabajadores"]</button>
                                            <button type="button" aria-pressed="@(_metrica == "extranjeros" ? "true" : "false")" @onclick='() => CambiarMetrica("extranjeros")'>@Textos["MetricaExtranjeros"]</button>
                                        </div>
                                        @if (!ComparaDosAnyos)
                                        {
                                            <p class="cuadro-vacio" data-sin-modelo="historico">@Textos["CmpVacio13"]</p>
                                        }
                                        else
                                        {
                                            <GraficoSerie Id="comparativa" EtiquetaAria="@Textos["CmpLineaTitulo"]" Etiquetas="@MesesDelAnyo"
                                                          Comparadas="@LineasAnuales()" FormatoBarra="@(v => _metrica == "facturacion" ? Importe((decimal)v, MonedaAnual) : Numero((int)v))" FormatoEjeBarra="@EjeImporteAnual" />
                                        }
                                    }
                                </Tarjeta>
                            </div>
                            break;
                        case "cmp-tabla":
                            <div class="cuadro-bloque cuadro-ancha" data-tarjeta="cmp-tabla">
                                <Tarjeta Titulo="@TituloAcumulado" Class="cuadro-tarjeta">
                                    <AccionesHeader>
                                        @if (HayAcumuladoComparable && !_cargandoAnualFacturacion && _anualFacturacion is not null)
                                        {
                                            <Boton Variante="VarianteBoton.Secundario" Class="cuadro-exportar" OnClick="ExportarComparativaAsync">@Textos["ExportarTabla"]</Boton>
                                        }
                                    </AccionesHeader>
                                    <ChildContent>
                                    <p class="cuadro-nota">@Textos["CmpTablaNota"]</p>
                                    @if (_cargandoAnualFacturacion || _anualFacturacion is null)
                                    {
                                        <p class="cuadro-vacio">@Textos["CmpCargando"]</p>
                                    }
                                    else if (!HayAcumuladoComparable)
                                    {
                                        <p class="cuadro-vacio" data-sin-modelo="historico">@Textos["CmpTablaVacio", NombreMesLargo.ToLowerInvariant()]</p>
                                    }
                                    else
                                    {
                                        var acumulado = AcumuladoPorAnyo();
                                        <div class="cuadro-tabla-envoltorio">
                                            <table class="cuadro-tabla" data-tabla="comparativa">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">@Textos["ColumnaAnio"]</th>
                                                        <th scope="col">@Textos["MetricaFacturacion"]</th>
                                                        <th scope="col">@Textos["ColumnaVar"]</th>
                                                        <th scope="col">@Textos["ColumnaIngresoEmpresaMes"]</th>
                                                        <th scope="col">@Textos["ColumnaGestiones"]</th>
                                                        <th scope="col">@Textos["ColumnaGestionesExtranjeros"]</th>
                                                        <th scope="col">@Textos["ColumnaAltasTrab"]</th>
                                                        <th scope="col">@Textos["ColumnaAltasCentro"]</th>
                                                        <th scope="col">@Textos["ColumnaEmpresasMas"]</th>
                                                        <th scope="col">@Textos["ColumnaEmpresasMenos"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var (anyo, meses) in acumulado)
                                                    {
                                                        <tr data-anyo="@anyo">
                                                            <td class="cuadro-texto">@anyo</td>
                                                            <td>@FacturacionAcumulada(meses)</td>
                                                            <td>@(anyo == _anyo ? VariacionAcumulada(meses, acumulado[1].Meses) : Textos["SinDato"].Value)</td>
                                                            <td>@IngresoPorEmpresaMes(meses)</td>
                                                            <td>@SumaGestiones(meses)</td>
                                                            <td>@ExtranjerosAcumulados(meses)</td>
                                                            <td>@SumaAltasTrabajadores(meses)</td>
                                                            <td>@SumaAltasCentros(meses)</td>
                                                            <td data-sin-modelo="empresas" title="@Textos["CeldaSinModelo"]">@Textos["SinDato"]</td>
                                                            <td data-sin-modelo="empresas" title="@Textos["CeldaSinModelo"]">@Textos["SinDato"]</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    </ChildContent>
                                </Tarjeta>
                            </div>
                            break;
                    }
                }
                </div>
                }
                </div>
            </Pestanas>
        }
    }
</div>

@if (_reaperturaAbierta)
{
    <ModalFormulario Visible="true" VisibleChanged="CerrarReapertura" Titulo="@Textos["ReabrirTitulo"]" Ancho="AnchoModal.Pequeno"
                     HayCambios="() => !_reabriendo && !string.IsNullOrWhiteSpace(_motivo)"
                     Guardando="_reabriendo" MensajeError="@_errorReapertura" OnGuardar="ReabrirAsync"
                     TextoGuardar="@Textos["ReabrirConfirmar"]" TextoCancelar="@Textos["ReabrirCancelar"]">
        <p class="cuadro-nota">@Textos["ReabrirAviso", NombreMesLargo, _cuadro?.Anyo ?? 0]</p>
        <CampoSelect Etiqueta="@Textos["ReabrirEmpresa"]" Valor="@_reabrirEmpresa" ValorChanged="v => _reabrirEmpresa = v">
            @foreach (var empresa in EmpresasCerradas)
            {
                <option value="@empresa.TenantId">@empresa.TenantNombre</option>
            }
        </CampoSelect>
        <CampoTextarea Etiqueta="@Textos["ReabrirMotivo"]" Valor="@_motivo" ValorChanged="v => _motivo = v"
                       Placeholder="@Textos["ReabrirMotivoAyuda"]" MensajeError="@ErrorMotivo" />
        <p class="cuadro-nota">@Textos["ReabrirContador", _motivo.Length, LongitudMaximaMotivo]</p>
    </ModalFormulario>
}
</LimiteDeErrores>
