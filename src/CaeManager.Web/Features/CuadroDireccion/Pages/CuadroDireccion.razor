                                                      Resaltar="@CalculosCuadro.IndicesPico(porMes, 3)" MostrarValores="@_preferencias.Etiquetas"
                                                      FormatoBarra="@(v => v.ToString("N1", CuadroDireccionUi.Castellano))" />
                                    }
                                </Tarjeta>
                            </div>
