                                                            <td>@(fila.MayorEmpresa is { } mayor ? Porcentaje(mayor) : Textos["SinDato"].Value)</td>
                                                            <td>@(fila.Indice is { } indice ? Numero(indice) : Textos["SinDato"].Value)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    </ChildContent>
                                </Tarjeta>
