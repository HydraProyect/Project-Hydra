                                                        <span class="cuadro-indice-barra" data-nivel="@NivelIndice(fila.Indice!.Value)" style="width:@((fila.Indice!.Value / ejeMaximo * 100).ToString("0.##", CultureInfo.InvariantCulture))%"></span>
