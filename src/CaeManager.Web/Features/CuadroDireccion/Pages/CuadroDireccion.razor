                        case "c-tabla":
                            <div class="cuadro-bloque cuadro-ancha" data-tarjeta="c-tabla">
                                <Tarjeta Titulo="@Textos["CarteraTitulo"]" Class="cuadro-tarjeta">
                                    <AccionesHeader>
                                        @if (CarteraPorGestor.Count > 0)
                                        {
                                            <Boton Variante="VarianteBoton.Secundario" Class="cuadro-exportar" OnClick="ExportarCarteraAsync">@Textos["ExportarTabla"]</Boton>
