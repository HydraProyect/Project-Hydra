@rendermode InteractiveServer
@using CaeManager.Application.Notificaciones.Commands.MarcarNotificacionLeida
@using CaeManager.Application.Notificaciones.Queries.ObtenerNotificacionesPendientes
@using MediatR
@inject IMediator Mediator
@inject NavigationManager Navigation

@if (_pendientes.Count > 0)
{
    var actual = _pendientes[0];
    <Modal Visible="true" VisibleChanged="_ => DescartarAsync(actual)" Titulo="@actual.Titulo" CerrarAlHacerClicFuera="false">
        <ChildContent>
            <p>@actual.Mensaje</p>
        </ChildContent>
        <Pie>
            <Boton Variante="VarianteBoton.Secundario" OnClick="() => DescartarAsync(actual)">Omitir</Boton>
            @if (!string.IsNullOrWhiteSpace(actual.UrlAccion))
            {
                <Boton OnClick="() => GestionarAsync(actual)">@(actual.TextoAccion ?? "Gestionar")</Boton>
            }
        </Pie>
    </Modal>
}

@code {
    private IReadOnlyList<NotificacionDto> _pendientes = [];

    protected override async Task OnInitializedAsync()
    {
        // El circuito de Blazor puede desconectarse (y con él el
        // CaeManagerDbContext scoped) mientras esta carga todavía está en
        // vuelo — mismo mecanismo documentado en MainLayout.razor.cs
        // (Sentry DOTNET-3/DOTNET-6): ObjectDisposedException o
        // ArgumentOutOfRangeException dentro de NpgsqlDataReader según en
        // qué punto exacto del socket la sorprenda la desconexión. Sin
        // captura aquí la excepción quedaba sin observar y tumbaba el
        // circuito entero ("Unhandled exception rendering component"). No
        // queda nadie al otro lado esperando el popup — el circuito ya se
        // fue — así que no hay nada que hacer salvo no dejarla sin observar.
        try
        {
            _pendientes = await Mediator.Send(new ObtenerNotificacionesPendientesQuery());
        }
        catch (Exception ex) when (ex is ObjectDisposedException or ArgumentOutOfRangeException)
        {
        }
    }

    private async Task DescartarAsync(NotificacionDto notificacion)
    {
        await Mediator.Send(new MarcarNotificacionLeidaCommand(notificacion.Id));
        _pendientes = _pendientes.Where(n => n.Id != notificacion.Id).ToList();
    }

    private async Task GestionarAsync(NotificacionDto notificacion)
    {
        await Mediator.Send(new MarcarNotificacionLeidaCommand(notificacion.Id));
        _pendientes = _pendientes.Where(n => n.Id != notificacion.Id).ToList();
        if (!string.IsNullOrWhiteSpace(notificacion.UrlAccion))
            Navigation.NavigateTo(notificacion.UrlAccion, forceLoad: true);
    }
}
