@using CaeManager.Application.Notificaciones.Commands.MarcarNotificacionLeida
@using CaeManager.Application.Notificaciones.Queries.ObtenerNotificacionesPendientes
@using CaeManager.Application.Operaciones.IncorporacionCartera
@using CaeManager.Application.Operaciones.IncorporacionCartera.Commands
@using CaeManager.Application.Operaciones.IncorporacionCartera.Queries
@using CaeManager.Application.Tenants.Queries.EsAdministradorPlataforma
@using CaeManager.Application.VigilanciaNormativa.Commands.MarcarAvisoRevisionNormativaRevisado
@using CaeManager.Application.VigilanciaNormativa.Queries.ObtenerAvisosRevisionNormativa
@using CaeManager.Domain.Common
@using CaeManager.Web.Components.DesignSystem
@using CaeManager.Web.Components.Layout
@using CaeManager.Web.Features.IncorporacionCartera.Recursos
@using CaeManager.Web.Features.Notificaciones.Recursos
@using CaeManager.Web.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject ILogger<ExcepcionDeCircuitoDesconectado> Logger
@inject IStringLocalizer<TextosComunes> Textos
@inject IStringLocalizer<TextosIncorporacionCartera> TextosCartera
@inject IStringLocalizer<TextosNotificaciones> TextosNotificacion
@inherits CaeManager.Web.Components.IsloteInteractivo

@*
    Rediseño de la cabecera, propuesta 04: la campana es el único sitio donde se anuncian los avisos
    pendientes de quien mira, visibles desde cualquier pantalla y con contador. Sustituye al modal de
    notificaciones, al botón flotante de avisos normativos y al aviso emergente de solicitudes de
    cartera. Lee las tres fuentes que ya existían, cada una con su propia Query y su propio alcance
    —ninguna se amplía ni se cruza aquí, así que el Tenant y la autorización los sigue decidiendo
    cada Query—:

      1. Notificaciones del usuario (ObtenerNotificacionesPendientesQuery, por usuario). Se marcan
         leídas con su Command al abrirlas, y la acción que traigan navega a su destino.
      2. Avisos de revisión normativa sin revisar (ObtenerAvisosRevisionNormativaQuery). Enlazan a la
         norma; «Marcar revisado» solo se ofrece al Actor de Plataforma TALVEG
         (EsAdministradorPlataformaQuery) y la autoridad final es el Command.
      3. Solicitudes de incorporación a cartera que el Coordinador CAE puede resolver
         (ObtenerSolicitudesIncorporacionCarteraQuery): una entrada por solicitud, con Aceptar y
         Rechazar (este con confirmación) por los mismos Commands que la bandeja.

    El contador es el número de elementos de las tres. Es el único productor de la lectura: se
    recarga al montarse, al abrir el panel y cada IntervaloRefresco; no mantiene estado propio de
    «leído», salvo el de las notificaciones, que se marca con su Command.
*@
<LimiteDeErrores Islote="this">
    <PanelDesplegableCabecera IdPanel="panel-campana-avisos"
                              ClaseBoton="campana-boton"
                              EtiquetaAccesible="@EtiquetaBoton"
                              Tooltip="@Textos["CabeceraAvisos"]"
                              Titulo="@Textos["CabeceraAvisos"]"
                              Abierto="_abierto"
                              AbiertoChanged="AlCambiarAbiertoAsync">
        <ContenidoBoton>
            <Icono Nombre="alertas" Tamano="TamanoIcono.Medio" />
            @if (_items.Count > 0)
            {
                <span class="campana-contador" data-testid="campana-contador">@_items.Count</span>
            }
        </ContenidoBoton>
        <ChildContent>
            <div class="campana-cabecera">
                <strong>@Textos["CabeceraAvisos"]</strong>
                @if (_items.Any(i => i.Tipo == TipoAviso.Notificacion))
                {
                    <button type="button" class="campana-marcar" @onclick="MarcarNotificacionesLeidasAsync">@Textos["CabeceraAvisosMarcarLeidas"]</button>
                }
            </div>

            @if (_items.Count == 0)
            {
                <p class="campana-vacio" role="status">@Textos["CabeceraAvisosVacio"]</p>
            }
            else
            {
                <ul class="campana-lista">
                    @foreach (var item in _items)
                    {
                        <li data-aviso="@item.Clave">
                            @switch (item.Tipo)
                            {
                                case TipoAviso.Notificacion:
                                    <button type="button" class="campana-item" @onclick="() => AbrirNotificacionAsync(item)">
                                        <span class="campana-item-texto">
                                            <strong>@item.Titulo</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Detalle))
                                            {
                                                <small>@item.Detalle</small>
                                            }
                                        </span>
                                        <span class="campana-nuevo">@(string.IsNullOrWhiteSpace(item.Url) ? Textos["CabeceraAvisosNuevo"] : item.TextoAccion ?? TextosNotificacion["AccionPorDefecto"])</span>
                                    </button>
                                    break;

                                case TipoAviso.Normativa:
                                    <div class="campana-item campana-item-con-acciones">
                                        <a class="campana-item-texto" href="@item.Url" target="_blank" rel="noopener noreferrer">
                                            <strong>@item.Titulo</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Detalle))
                                            {
                                                <small>@item.Detalle</small>
                                            }
                                        </a>
                                        @if (_esActorPlataforma)
                                        {
                                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                   OnClick="() => MarcarNormativaRevisadaAsync(item)"
                                                   Deshabilitado="_enCurso is not null">@TextosNotificacion["BotonMarcarRevisado"]</Boton>
                                        }
                                        else
                                        {
                                            <span class="campana-nuevo">@Textos["CabeceraAvisosNuevo"]</span>
                                        }
                                    </div>
                                    break;

                                case TipoAviso.Solicitud:
                                    <div class="campana-item campana-item-con-acciones">
                                        <span class="campana-item-texto">
                                            <strong>@item.Titulo</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Detalle))
                                            {
                                                <small>@item.Detalle</small>
                                            }
                                        </span>
                                        <span class="campana-acciones">
                                            <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno"
                                                   OnClick="() => AceptarSolicitudAsync(item)"
                                                   Deshabilitado="_enCurso is not null"
                                                   Cargando="_enCurso == item.Id">@TextosNotificacion["BotonAceptarSolicitud"]</Boton>
                                            <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                   OnClick="() => PedirRechazar(item)"
                                                   Deshabilitado="_enCurso is not null">@TextosNotificacion["BotonRechazarSolicitud"]</Boton>
                                        </span>
                                    </div>
                                    break;
                            }
                        </li>
                    }
                </ul>

                @if (_items.Any(i => i.Tipo == TipoAviso.Solicitud))
                {
                    <div class="campana-pie">
                        <a class="campana-ver-todas" href="@RutasIncorporacionCartera.Bandeja">@TextosCartera["AvisoVerTodas"]</a>
                    </div>
                }
            }
        </ChildContent>
    </PanelDesplegableCabecera>

    @* Fuera del panel: confirmar con el panel cerrado no puede dejar el diálogo sin anfitrión. *@
    <DialogoConfirmacion Visible="_aRechazar is not null"
                         VisibleChanged="CerrarConfirmacionRechazo"
                         Titulo="@TextosCartera["ConfirmarRechazarTitulo"]"
                         Mensaje="@MensajeConfirmarRechazar"
                         TextoBotonConfirmar="@TextosCartera["Rechazar"]"
                         EnProgreso="_enCurso is not null"
                         OnConfirmar="RechazarSolicitudAsync" />
</LimiteDeErrores>

@code {
    /// <summary>Único intervalo de refresco del contador y del panel (ver el comentario de arriba).</summary>
    private static readonly TimeSpan IntervaloRefresco = TimeSpan.FromSeconds(60);

    private enum TipoAviso { Notificacion, Normativa, Solicitud }

    /// <param name="Id">Id de la notificación, del aviso normativo o de la solicitud, según <paramref name="Tipo"/>.</param>
    /// <param name="Clave">Identifica el elemento entre las tres fuentes; no se muestra.</param>
    private sealed record ItemAviso(TipoAviso Tipo, Guid Id, string Clave, string Titulo, string? Detalle, string? Url,
        string? TextoAccion = null, string? Solicitante = null, string? Empresa = null);

    private IReadOnlyList<ItemAviso> _items = [];
    private bool _abierto;
    private bool _esActorPlataforma;
    private Guid? _enCurso;
    private ItemAviso? _aRechazar;
    private CancellationTokenSource? _cancelacion;

    private string EtiquetaBoton => _items.Count == 0
        ? Textos["CabeceraAvisos"].Value
        : Textos["CabeceraAvisosConContador", _items.Count].Value;

    private string MensajeConfirmarRechazar => _aRechazar is null
        ? string.Empty
        : TextosCartera["ConfirmarRechazarMensaje", _aRechazar.Solicitante ?? string.Empty, _aRechazar.Empresa ?? string.Empty];

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        IniciarRefresco();
    }

    private async Task AlCambiarAbiertoAsync(bool abierto)
    {
        _abierto = abierto;
        if (abierto) await CargarAsync();
    }

    /// <summary>
    /// Lee las tres fuentes. Cada una por su Query, con el alcance y la autorización que esa Query
    /// ya aplica; una que no puede decir nada (sin permiso, sin Operador CAE) aporta una lista vacía.
    /// </summary>
    private async Task CargarAsync()
    {
        // El circuito puede desconectarse con la carga en vuelo (ExcepcionDeCircuitoDesconectado,
        // REC-166). No queda nadie esperando el panel; solo se registra.
        try
        {
            var items = new List<ItemAviso>();

            foreach (var notificacion in await Mediator.Send(new ObtenerNotificacionesPendientesQuery()))
            {
                items.Add(new ItemAviso(TipoAviso.Notificacion, notificacion.Id, $"notificacion:{notificacion.Id}",
                    notificacion.Titulo, notificacion.Mensaje, notificacion.UrlAccion, notificacion.TextoAccion));
            }

            var normativa = (await Mediator.Send(new ObtenerAvisosRevisionNormativaQuery())).Where(a => !a.Revisado).ToList();
            foreach (var aviso in normativa)
            {
                items.Add(new ItemAviso(TipoAviso.Normativa, aviso.Id, $"normativa:{aviso.Id}",
                    aviso.Titulo, aviso.NormaVigilada, aviso.UrlHtml));
            }

            // Solo se pregunta si hay algo que marcar: sin avisos normativos pendientes el botón no existe.
            _esActorPlataforma = normativa.Count > 0 && await Mediator.Send(new EsAdministradorPlataformaQuery());

            var solicitudes = await Mediator.Send(new ObtenerSolicitudesIncorporacionCarteraQuery(SoloPendientes: true));
            if (solicitudes.EsExitoso && solicitudes.Valor.EsCoordinadorCae)
            {
                foreach (var solicitud in solicitudes.Valor.Pendientes.Where(s => s.PuedeResolver))
                {
                    items.Add(new ItemAviso(TipoAviso.Solicitud, solicitud.Id, $"cartera:{solicitud.Id}",
                        TextosCartera["AvisoPide", solicitud.NombreSolicitante, solicitud.NombreEmpresa],
                        solicitud.Mensaje, Url: null,
                        Solicitante: solicitud.NombreSolicitante, Empresa: solicitud.NombreEmpresa));
                }
            }

            _items = items;
        }
        catch (Exception ex) when (ExcepcionDeCircuitoDesconectado.Es(ex))
        {
            Logger.LogWarning(ex, "CampanaAvisos descartó una excepción de desconexión de circuito: {TipoExcepcion} — {Mensaje}",
                ex.GetType().Name, ex.Message);
        }
    }

    private void IniciarRefresco()
    {
        _cancelacion = new CancellationTokenSource();
        var token = _cancelacion.Token;

        _ = Task.Run(async () =>
        {
            using var reloj = new PeriodicTimer(IntervaloRefresco);
            try
            {
                while (await reloj.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        // No se refresca con una resolución en curso: la recarga posterior a esa resolución ya lo hace.
                        if (_enCurso is not null)
                            return;

                        await CargarAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Componente desechado.
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "CampanaAvisos detuvo su refresco periódico: {TipoExcepcion} — {Mensaje}",
                    ex.GetType().Name, ex.Message);
            }
        }, token);
    }

    /// <summary>Una notificación se marca leída al abrirla y, si trae acción, se navega a ella.</summary>
    private async Task AbrirNotificacionAsync(ItemAviso item)
    {
        await Mediator.Send(new MarcarNotificacionLeidaCommand(item.Id));
        _items = _items.Where(i => i.Clave != item.Clave).ToList();

        if (!string.IsNullOrWhiteSpace(item.Url))
            Navigation.NavigateTo(item.Url, forceLoad: true);
    }

    private async Task MarcarNotificacionesLeidasAsync()
    {
        foreach (var item in _items.Where(i => i.Tipo == TipoAviso.Notificacion).ToList())
            await Mediator.Send(new MarcarNotificacionLeidaCommand(item.Id));

        _items = _items.Where(i => i.Tipo != TipoAviso.Notificacion).ToList();
    }

    /// <summary>La autoridad final es el Command (ver su comentario); el botón solo se ofrece al Actor de Plataforma TALVEG.</summary>
    private async Task MarcarNormativaRevisadaAsync(ItemAviso item)
    {
        var resultado = await EjecutarAsync(item.Id, new MarcarAvisoRevisionNormativaRevisadoCommand(item.Id, Notas: null));
        if (resultado is { EsFallido: true })
            Toasts.Mostrar(resultado.Error.Mensaje, TonoToast.Error);
    }

    private async Task AceptarSolicitudAsync(ItemAviso item)
    {
        var resultado = await EjecutarAsync(item.Id, new AceptarSolicitudIncorporacionCarteraCommand(item.Id));
        if (resultado is null) return;

        if (resultado.EsFallido)
            Toasts.Mostrar(TextosIncorporacionCartera.MensajeDeError(TextosCartera, resultado.Error), TonoToast.Error);
        else
            Toasts.Mostrar(TextosCartera["ToastAceptada", item.Solicitante ?? string.Empty, item.Empresa ?? string.Empty], TonoToast.Exito);
    }

    // Rechazar cierra la solicitud sin vuelta atrás: se confirma, como en la bandeja.
    private void PedirRechazar(ItemAviso item) => _aRechazar = item;

    private void CerrarConfirmacionRechazo(bool visible)
    {
        if (!visible && _enCurso is null)
            _aRechazar = null;
    }

    private async Task RechazarSolicitudAsync()
    {
        if (_aRechazar is not { } item)
            return;

        var resultado = await EjecutarAsync(item.Id, new RechazarSolicitudIncorporacionCarteraCommand(item.Id));
        _aRechazar = null;
        if (resultado is null) return;

        if (resultado.EsFallido)
            Toasts.Mostrar(TextosIncorporacionCartera.MensajeDeError(TextosCartera, resultado.Error), TonoToast.Error);
        else
            Toasts.Mostrar(TextosCartera["ToastRechazada"], TonoToast.Exito);
    }

    /// <summary>Ejecuta un Command de un solo elemento y recarga; devuelve null si ya había otro en curso.</summary>
    private async Task<Result?> EjecutarAsync(Guid id, IRequest<Result> command)
    {
        if (_enCurso is not null)
            return null;

        _enCurso = id;
        try
        {
            var resultado = await Mediator.Send(command);
            await CargarAsync();
            return resultado;
        }
        finally
        {
            _enCurso = null;
        }
    }

    public void Dispose()
    {
        _cancelacion?.Cancel();
        _cancelacion?.Dispose();
        _cancelacion = null;
    }
}
