@page "/vision-cartera"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae}")]
@using CaeManager.Application.Dashboard.Queries

<PageTitle>@Textos["TituloPagina"] — @Marca.Nombre</PageTitle>

@*
    Visión de cartera contra su mockup Gen 2 («Vision Cartera TALVEG.dc.html»).

    Cada fila es un TENANT, no un Cliente empresarial: el tenant de origen del
    usuario más los que os han delegado su gestión CAE (ObtenerKpisGlobalesQuery
    recorre ObtenerClientesAutorizadosQuery). Por eso los textos dicen
    «organización» y no «cliente», que en el resto del producto es la Empresa
    contraparte de una Relación Empresarial.

    El alcance de cada fila lo decide ObtenerKpisGlobalesQuery con el rol
    efectivo y la Asignación de Cartera de ESA organización; la pantalla no
    lee ningún rol (el del contexto activo no vale para las demás) y solo pinta
    lo que la consulta dice por fila: SinCarteraAsignada, SinDatos y
    CentrosBloqueados.

    El porcentaje de cada fila es solo documental. El veredicto «en verde»
    exige además ClienteRiesgoDto.AdmiteVeredictoVerde: con cartera, con datos
    y sin ningún Centro de Trabajo bloqueado según ICalculoEstadoCentroService
    (D-7: una Rechazada aplicable bloquea). Una organización con bloqueos
    enseña su recuento junto al porcentaje y nunca sale en verde; una sin
    Centros ni documentos sale «sin datos», nunca al 100%.

    Lo que el mockup pinta y aquí NO se copia, porque la consulta no lo sabe:
    el desglose por centro de cada fila (ClienteRiesgoDto no lo trae), el
    «84 trabajadores · 7 centros» por fila, «X de N bloquean acceso a algún
    centro» (se cuentan Centros de Trabajo bloqueados, no documentos que
    bloquean), las ventanas fijas «≤15/≤30 días» (son los umbrales urgente y
    próximo de cada organización, configurables) y el rótulo «SLA» (no hay
    acuerdo de nivel de servicio detrás: es la tasa de cumplimiento
    documental). Tampoco los enlaces de las cifras a /documentos, /centros,
    /trabajadores o /bandeja: esas pantallas enseñan solo la organización
    activa, y el número de aquí suma varias.
*@
<div class="contenedor-pagina">
    <CabeceraPagina Titulo="@Textos["TituloCabecera"]" Kicker="@Textos["Kicker"]">
        <Acciones>
            @if (_kpis is { TotalClientes: > 1 })
            {
                <div class="ambito-cartera">
                    <span class="ambito-cartera-linea">@LineaAmbito</span>
                    <span class="ambito-cartera-linea">@LineaAlcance</span>
                    <span class="ambito-cartera-sistema"><span class="punto-sistema" aria-hidden="true"></span>@Textos["AmbitoRecalculado"]</span>
                </div>
            }
        </Acciones>
    </CabeceraPagina>

    @if (_error)
    {
        <EstadoVacio Titulo="@Textos["ErrorCargaTitulo"]" Descripcion="@Textos["ErrorCargaDescripcion"]"
                     NombreIcono="error-circulo" AcentoIcono="var(--color-danger-500)" FondoIcono="var(--color-danger-50)">
            <Accion>
                <Boton OnClick="CargarAsync">@Textos["BotonReintentar"]</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_kpis is null)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_kpis.TotalClientes <= 1)
    {
        @* Con una sola organización —la propia— esta vista coincidiría con el
           Dashboard, así que se declara vacía aunque haya datos (mockup,
           estado «Vacía»). *@
        <EstadoVacio Titulo="@Textos["VacioTitulo"]"
                     Descripcion="@Textos["VacioDescripcion"]"
                     NombreIcono="cartera">
            <Accion>
                <a class="enlace-accion-cartera" href="/delegaciones">@Textos["EnlaceAccionVacio"]</a>
            </Accion>
        </EstadoVacio>
    }
    else
    {
        <div class="vision-cartera-contenido">
            <section class="seccion-cartera" aria-labelledby="titulo-riesgo-documental">
                <h2 id="titulo-riesgo-documental" class="titulo-seccion-cartera">@Textos["SeccionRiesgoDocumental"]</h2>
                @* Iconografía obligatoria en superficies de resumen (02 § 7, DDL-036),
                   mismos iconos que Inicio. El desglose por organización de
                   vencidos y urgentes es la tabla de abajo. *@
                <div class="rejilla-kpis-criticos">
                    <TarjetaMetrica Etiqueta="@Textos["MetricaVencidos"]" Valor="@_kpis.DocumentosVencidos.ToString()" NombreIcono="advertencia" Tono="TonoBadge.Peligro"
                                    Pista="@PistaVencidos" />
                    <TarjetaMetrica Etiqueta="@Textos["MetricaUrgentes"]" Valor="@_kpis.DocumentosUrgentes.ToString()" NombreIcono="reloj" Tono="TonoBadge.Peligro"
                                    Pista="@Textos["PistaUrgentes"]" />
                    <TarjetaMetrica Etiqueta="@Textos["MetricaProximos"]" Valor="@_kpis.DocumentosProximos.ToString()" NombreIcono="calendario" Tono="TonoBadge.Advertencia"
                                    Pista="@Textos["PistaProximos"]" />
                    <TarjetaMetrica Etiqueta="@Textos["MetricaCumplimientoPromedio"]" Valor="@ValorMedia" NombreIcono="check"
                                    Tono="@TonoMedia" Pista="@PistaMedia" />
                    <TarjetaMetrica Etiqueta="@Textos["MetricaCentrosBloqueados"]" Valor="@_kpis.CentrosBloqueados.ToString()" NombreIcono="error-circulo"
                                    Tono="@TonoCentrosBloqueados" Pista="@PistaCentrosBloqueados" />
                </div>
            </section>

            <section class="resumen-cartera">
                <div class="dashboard-resumen-tarjeta-anillo">
                    @if (HayMediaQueMostrar)
                    {
                        <AnilloCumplimiento Porcentaje="_kpis.TasaCumplimientoDocumentalPromedio" Tamano="TamanoAnillo.Grande" Leyenda="@Textos["LeyendaAnillo"]"
                                            Etiqueta="@Textos["CumplimientoPromedioFrase", _kpis.TasaCumplimientoDocumentalPromedio]" />
                        <div>
                            <p class="dashboard-resumen-anillo-titulo">@Textos["CumplimientoPromedioFrase", _kpis.TasaCumplimientoDocumentalPromedio]</p>
                            <p class="dashboard-resumen-anillo-detalle detalle-media-cartera">@DetalleMedia</p>
                            @if (DetalleBloqueos is { } bloqueos)
                            {
                                <p class="dashboard-resumen-anillo-detalle detalle-bloqueos-cartera">@bloqueos</p>
                            }
                            <p class="dashboard-resumen-anillo-detalle detalle-tasa-cartera">
                                @Textos["DetalleTasaOrganizacion"]
                            </p>
                        </div>
                    }
                    else
                    {
                        @* Sin ninguna Asignación de Cartera, o sin ningún documento con
                           fecha en las que sí la tienen, el 100% que devuelve la consulta
                           es «nada que evaluar»: pintarlo en un anillo verde afirmaría lo
                           contrario. *@
                        <div>
                            <p class="dashboard-resumen-anillo-titulo">@Textos["SinCumplimientoTitulo"]</p>
                            <p class="dashboard-resumen-anillo-detalle detalle-media-cartera">@DetalleSinCumplimiento</p>
                            @if (DetalleBloqueos is { } bloqueos)
                            {
                                <p class="dashboard-resumen-anillo-detalle detalle-bloqueos-cartera">@bloqueos</p>
                            }
                        </div>
                    }
                </div>

                <div class="actividad-cartera">
                    <h2 class="titulo-seccion-cartera">@Textos["SeccionActividad"]</h2>
                    <div class="rejilla-actividad-cartera">
                        <TarjetaMetrica Discreta="true" Etiqueta="@Textos["MetricaOrganizaciones"]" Valor="@_kpis.TotalClientes.ToString()" NombreIcono="clientes" />
                        <TarjetaMetrica Discreta="true" Etiqueta="@Textos["MetricaTrabajadoresActivos"]" Valor="@_kpis.TrabajadoresActivos.ToString()" NombreIcono="trabajadores" />
                        <TarjetaMetrica Discreta="true" Etiqueta="@Textos["MetricaCentros"]" Valor="@_kpis.Centros.ToString()" NombreIcono="centros" />
                    </div>

                    @* Accesibilidad: el SVG es solo la imagen (aria-hidden, sin foco:
                       no tiene ninguna interacción, las <title> son ayuda de ratón).
                       Lo que dice lo dice también la tabla .reparto-riesgo-datos —
                       nombres completos y las dos cifras de cada organización, en el
                       mismo orden—, que el lector de pantalla recorre como tabla y a
                       la que el <figcaption> da nombre. *@
                    <figure class="reparto-riesgo" aria-labelledby="titulo-reparto-riesgo">
                        <figcaption id="titulo-reparto-riesgo" class="reparto-riesgo-titulo">@Textos["RepartoTitulo", Organizaciones.Count]</figcaption>
                        <table class="reparto-riesgo-datos">
                            <caption>@Textos["RepartoCaption"]</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@Textos["ColumnaOrganizacion"]</th>
                                    <th scope="col">@Textos["ColumnaVencidos"]</th>
                                    <th scope="col">@Textos["ColumnaUrgentes"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var organizacion in Organizaciones)
                                {
                                    <tr>
                                        <th scope="row">@FilaReparto(organizacion)</th>
                                        <td>@organizacion.DocumentosVencidos</td>
                                        <td>@organizacion.DocumentosUrgentes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <svg class="reparto-riesgo-grafico" viewBox="0 0 @AnchoGrafico @AltoGrafico" aria-hidden="true" focusable="false"
                             preserveAspectRatio="xMinYMid meet">
                            <line class="reparto-riesgo-base" x1="0" y1="@BaseBarras" x2="@AnchoGrafico" y2="@BaseBarras" />
                            @foreach (var barra in Barras)
                            {
                                <g class="barra-organizacion">
                                    @if (barra.AltoVencidos > 0)
                                    {
                                        <rect class="barra-vencidos" x="@barra.X" y="@barra.YVencidos" width="@AnchoBarra" height="@barra.AltoVencidos" rx="2">
                                            <title>@barra.TituloVencidos</title>
                                        </rect>
                                    }
                                    @if (barra.AltoUrgentes > 0)
                                    {
                                        <rect class="barra-urgentes" x="@barra.X" y="@barra.YUrgentes" width="@AnchoBarra" height="@barra.AltoUrgentes" rx="2">
                                            <title>@barra.TituloUrgentes</title>
                                        </rect>
                                    }
                                    @if (barra.SinRiesgo)
                                    {
                                        @* Envuelto en <g>: un <text> justo tras la transición a código lo
                                           interpretaría Razor como su propia etiqueta, no como SVG. *@
                                        <g>
                                            <text class="reparto-riesgo-sin-riesgo" x="@barra.Centro" y="@(BaseBarras - 14)" text-anchor="middle">@barra.TextoSinBarra</text>
                                        </g>
                                    }
                                    <text class="reparto-riesgo-etiqueta" x="@barra.Centro" y="@(BaseBarras + 16)" text-anchor="middle">
                                        <title>@barra.Nombre</title>@barra.EtiquetaCorta
                                    </text>
                                </g>
                            }
                        </svg>
                        <div class="reparto-riesgo-leyenda">
                            <span><span class="muestra-leyenda muestra-vencidos" aria-hidden="true"></span>@Textos["LeyendaVencidos"]</span>
                            <span><span class="muestra-leyenda muestra-urgentes" aria-hidden="true"></span>@Textos["LeyendaUrgentes"]</span>
                        </div>
                    </figure>
                </div>
            </section>

            <section class="seccion-cartera" aria-labelledby="titulo-organizaciones-riesgo">
                <div class="cabecera-seccion-cartera">
                    <h2 id="titulo-organizaciones-riesgo" class="titulo-seccion-cartera">@Textos["SeccionMasRiesgo"]</h2>
                    <span class="nota-seccion-cartera">@Textos["NotaOrdenMasRiesgo"]</span>
                </div>

                @if (AvisoSinCartera is { } aviso)
                {
                    <p class="aviso-sin-cartera">@aviso</p>
                }

                <Tarjeta Class="tarjeta-organizaciones-riesgo">
                    @if (Organizaciones.All(o => o.DocumentosVencidos == 0 && o.DocumentosUrgentes == 0 && o.CentrosBloqueados == 0))
                    {
                        <p class="texto-vacio-seccion">@TextoSinRiesgo</p>
                    }
                    else
                    {
                        <table class="tabla-datos">
                            <thead>
                                <tr>
                                    <th>@Textos["ColumnaOrganizacion"]</th>
                                    <th>@Textos["ColumnaVencidos"]</th>
                                    <th>@Textos["ColumnaUrgentes"]</th>
                                    <th>@Textos["ColumnaCumplimiento"]</th>
                                    <th aria-label="@Textos["ColumnaAcciones"]"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var organizacion in Organizaciones)
                                {
                                    var tasa = Math.Clamp(organizacion.TasaCumplimientoDocumental, 0, 100);
                                    <tr>
                                        <td>
                                            <span class="nombre-organizacion">@organizacion.Nombre</span>
                                            <span class="meta-organizacion">@MetaOrganizacion(organizacion)</span>
                                        </td>
                                        <td>
                                            <Badge Tono="@(organizacion.DocumentosVencidos > 0 ? TonoBadge.Peligro : TonoBadge.Neutro)"
                                                   title="@TituloVencidos(organizacion)">@organizacion.DocumentosVencidos</Badge>
                                        </td>
                                        <td>
                                            <Badge Tono="@(organizacion.DocumentosUrgentes > 0 ? TonoBadge.Advertencia : TonoBadge.Neutro)"
                                                   title="@TituloUrgentes(organizacion)">@organizacion.DocumentosUrgentes</Badge>
                                        </td>
                                        <td>
                                            @if (organizacion.SinCarteraAsignada)
                                            {
                                                <span class="sin-cartera-organizacion" title="@TituloCumplimiento(organizacion)">@Textos["CeldaSinCartera"]</span>
                                            }
                                            else if (organizacion.SinDatos)
                                            {
                                                <span class="sin-datos-organizacion" title="@TituloCumplimiento(organizacion)">@Textos["CeldaSinDatos"]</span>
                                            }
                                            else
                                            {
                                                <span class="cumplimiento-organizacion" title="@TituloCumplimiento(organizacion)">
                                                    <span class="barra-cumplimiento" aria-hidden="true">
                                                        <span class="barra-cumplimiento-relleno @ClaseTono(organizacion, tasa)" style="width: @(tasa)%"></span>
                                                    </span>
                                                    <span class="valor-cumplimiento @ClaseTono(organizacion, tasa)">@tasa%</span>
                                                </span>
                                                @if (organizacion.CentrosBloqueados > 0)
                                                {
                                                    <Badge Tono="TonoBadge.Peligro" ConIcono="true" class="bloqueos-organizacion" title="@TituloCumplimiento(organizacion)">@TextoBadgeBloqueados(organizacion)</Badge>
                                                }
                                            }
                                        </td>
                                        <td class="celda-accion-organizacion">
                                            @* Mismo patrón que SelectorClienteActivo: cambiar la organización
                                               activa escribe una cookie de servidor, así que va por POST con
                                               antiforgery (M-8) y no por navegación GET. Por eso la acción vive
                                               en un botón y no en un @onclick de la fila: un <form> no puede
                                               envolver un <tr>. *@
                                            <form method="post" action="/cuenta/cliente-activo">
                                                @if (_token is not null)
                                                {
                                                    <input type="hidden" name="@_token.FormFieldName" value="@_token.Value" />
                                                }
                                                <input type="hidden" name="returnUrl" value="/" />
                                                <input type="hidden" name="tenantId" value="@organizacion.TenantId" />
                                                <Boton Type="submit" Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
                                                       title="@Textos["BotonCambiarOrganizacionTitulo", organizacion.Nombre]">@Textos["BotonCambiarOrganizacion"]</Boton>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </Tarjeta>
            </section>

            <section class="pulso-cartera" aria-label="@Textos["PulsoTitulo"]">
                <div class="pulso-cartera-titular">
                    <span class="pulso-cartera-kicker">@Textos["PulsoTitulo"]</span>
                    <span class="pulso-cartera-frase">@FrasePulso</span>
                </div>
                <div class="pulso-cartera-cifras">
                    <div class="pulso-cartera-cifra">
                        <span class="pulso-cartera-etiqueta">@Textos["PulsoEtiquetaEnVerde"]</span>
                        <VentanaContexto class="pulso-cartera-valor pulso-en-verde" Etiqueta="@DetalleEnVerde" Titulo="@Textos["PulsoTituloEnVerde"]">
                            <Disparador>@EnVerde</Disparador>
                            <Detalle>@DetalleEnVerde</Detalle>
                        </VentanaContexto>
                    </div>
                    <div class="pulso-cartera-cifra">
                        <span class="pulso-cartera-etiqueta">@Textos["PulsoEtiquetaEnRiesgo"]</span>
                        <VentanaContexto class="pulso-cartera-valor pulso-en-riesgo" Etiqueta="@DetalleEnRiesgo" Titulo="@Textos["PulsoTituloEnRiesgo"]">
                            <Disparador>@DocumentosEnRiesgo</Disparador>
                            <Detalle>@DetalleEnRiesgo</Detalle>
                        </VentanaContexto>
                    </div>
                </div>
            </section>
        </div>
    }
</div>
