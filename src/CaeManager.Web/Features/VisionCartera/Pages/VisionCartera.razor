@page "/vision-cartera"
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{CaeManager.Infrastructure.Identity.Roles.Administrador},{CaeManager.Infrastructure.Identity.Roles.DireccionCae},{CaeManager.Infrastructure.Identity.Roles.CoordinadorCae}")]
@using CaeManager.Application.Dashboard.Queries

<PageTitle>Visión de cartera — CAE Manager</PageTitle>

<div class="contenedor-pagina">
    <div class="dashboard-cabecera">
        <span class="dashboard-kicker">Visión de cartera</span>
        <h1 class="titulo-pagina">Todos tus clientes de un vistazo</h1>
    </div>

    @if (_error)
    {
        <EstadoVacio Titulo="No pudimos cargar la visión de cartera" Descripcion="Intenta nuevamente en unos segundos.">
            <Accion>
                <Boton OnClick="CargarAsync">Reintentar</Boton>
            </Accion>
        </EstadoVacio>
    }
    else if (_kpis is null)
    {
        <EstadoCargando Filas="2" />
    }
    else if (_kpis.TotalClientes <= 1)
    {
        <EstadoVacio Titulo="Todavía no operas ningún cliente delegado" Descripcion="Esta vista agrega datos entre varios clientes. Cuando tengas al menos un Delegated Workspace activo, aparecerá aquí." />
    }
    else
    {
        @* Iconografía obligatoria en superficies de resumen (02 § 7, DDL-036) —
           mismo criterio y mismos iconos que Dashboard.razor: es la misma
           rejilla reutilizada, ver el comentario de VisionCartera.razor.css. *@
        <div class="rejilla-kpis-criticos">
            <TarjetaMetrica Etiqueta="Documentos vencidos" Valor="@_kpis.DocumentosVencidos.ToString()" NombreIcono="advertencia" Tono="TonoBadge.Peligro" />
            <TarjetaMetrica Etiqueta="Urgentes (≤15 días)" Valor="@_kpis.DocumentosUrgentes.ToString()" NombreIcono="reloj" Tono="TonoBadge.Peligro" />
            <TarjetaMetrica Etiqueta="Próximos (≤30 días)" Valor="@_kpis.DocumentosProximos.ToString()" NombreIcono="calendario" Tono="TonoBadge.Advertencia" />
            <TarjetaMetrica Etiqueta="SLA documental promedio" Valor="@($"{_kpis.TasaCumplimientoDocumentalPromedio}%")" NombreIcono="check" Tono="@SlaDocumentalTono(_kpis.TasaCumplimientoDocumentalPromedio)" />
        </div>

        <h2 class="dashboard-subtitulo">Actividad general</h2>
        <div class="rejilla-kpis-secundarios">
            <TarjetaMetrica Discreta="true" Etiqueta="Clientes" Valor="@_kpis.TotalClientes.ToString()" NombreIcono="clientes" />
            <TarjetaMetrica Discreta="true" Etiqueta="Trabajadores activos" Valor="@_kpis.TrabajadoresActivos.ToString()" NombreIcono="trabajadores" />
            <TarjetaMetrica Discreta="true" Etiqueta="Centros / plataformas" Valor="@_kpis.Centros.ToString()" NombreIcono="centros" />
        </div>

        <Tarjeta Titulo="Clientes con más riesgo" Class="tarjeta-clientes-riesgo">
            @if (_kpis.ClientesConMasRiesgo.All(c => c.DocumentosVencidos == 0 && c.DocumentosUrgentes == 0))
            {
                <p class="texto-vacio-seccion">Ningún cliente tiene documentación urgente o vencida.</p>
            }
            else
            {
                <table class="tabla-datos">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Vencidos</th>
                            <th>Urgentes</th>
                            <th>SLA documental</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in _kpis.ClientesConMasRiesgo)
                        {
                            <tr>
                                <td>@cliente.Nombre</td>
                                <td><Badge Tono="TonoBadge.Peligro">@cliente.DocumentosVencidos</Badge></td>
                                <td><Badge Tono="TonoBadge.Advertencia">@cliente.DocumentosUrgentes</Badge></td>
                                <td><Badge Tono="@SlaDocumentalTono(cliente.TasaCumplimientoDocumental)">@cliente.TasaCumplimientoDocumental%</Badge></td>
                                <td>
                                    @* Mismo patrón que SelectorClienteActivo: cambiar de cliente
                                       activo escribe una cookie de servidor, así que va por POST
                                       con antiforgery (M-8) y no por navegación GET. Por eso la
                                       acción vive en un botón y no en un @onclick de la fila: un
                                       <form> no puede envolver un <tr>. *@
                                    <form method="post" action="/cuenta/cliente-activo">
                                        @if (_token is not null)
                                        {
                                            <input type="hidden" name="@_token.FormFieldName" value="@_token.Value" />
                                        }
                                        <input type="hidden" name="returnUrl" value="/" />
                                        <input type="hidden" name="tenantId" value="@cliente.TenantId" />
                                        <button type="submit" class="accion-ver-cliente">Ver como este cliente →</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </Tarjeta>
    }
</div>
