@page "/alta/verificar"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using CaeManager.Application.AltaAutonoma
@using CaeManager.Web.Components.Account
@using CaeManager.Web.Features.AltaAutonoma.Recursos
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IOptions<AltaAutonomaOptions> OpcionesAlta
@inject IStringLocalizer<TextosAltaAutonoma> T
@inject ServicioRegistroAlta Registro
@inject NavigationManager Navigation

@* Enlace de verificación del correo (maqueta A0, artboards CorreoConfirmado y EnlaceCaducado). Abrir el enlace no
   verifica: pinta un botón que envía el token por POST. Los antivirus y las vistas previas de los gestores de correo
   abren los enlaces por su cuenta, y con un GET que verificase gastarían el enlace de un solo uso antes que la
   persona. El token viaja en la consulta y vuelve en un campo oculto; la base solo guarda su SHA-256.

   A4, pre-secuestro de la cuenta: el POST pide también la contraseña elegida en el registro, y solo verifica si casan
   token y contraseña. Si no casan, se responde lo mismo que con un enlace no válido y el enlace no se gasta. Verificado,
   el credencial de continuación va a una cookie HttpOnly y SameSite=Strict (CookieContinuacionAlta) y se redirige al
   paso «Empresa»: el token deja de estar en la URL. *@

<PageTitle>@T["VerificarTituloPagina"] — @Marca.Nombre</PageTitle>

@if (_habilitada)
{
    <div class="acceso-tarjeta">
        <CabeceraAcceso />
        @switch (_resultado)
        {
            case null:
            case ResultadoVerificacionCorreoAlta.NoValido:
                <PasosAlta Detalle="@T["PasoConfirmarCorreoDetalle"]" />
                <h2 class="acceso-titulo">@T["ConfirmarCorreoTitulo"]</h2>
                <p class="acceso-explica">@T["ConfirmarCorreoExplica"]</p>
                @if (_resultado is not null)
                {
                    <p class="acceso-alerta" role="alert">@T["ConfirmarCorreoNoValido"]</p>
                }
                <EditForm Model="Entrada" method="post" OnSubmit="VerificarAsync" FormName="alta-verificar" novalidate>
                    <InputText type="hidden" @bind-Value="Entrada!.Token" />
                    <div class="acceso-campo">
                        <label for="alta-verificar-contrasena">@T["ConfirmarCorreoContrasenaEtiqueta"]</label>
                        <InputText id="alta-verificar-contrasena" @bind-Value="Entrada!.Contrasena" type="password"
                                   autocomplete="current-password" aria-describedby="alta-verificar-contrasena-ayuda" />
                        <p id="alta-verificar-contrasena-ayuda" class="acceso-nota">@T["ConfirmarCorreoContrasenaAyuda"]</p>
                    </div>
                    <button type="submit" class="acceso-entrar">@T["ConfirmarCorreoBoton"]</button>
                </EditForm>
                break;
            case ResultadoVerificacionCorreoAlta.Verificado:
                <PasosAlta Detalle="@T["PasoCorreoConfirmadoDetalle"]" />
                <h2 class="acceso-titulo">@T["CorreoConfirmadoTitulo"]</h2>
                <p class="acceso-explica">@T["CorreoConfirmadoExplica"]</p>
                break;
            case ResultadoVerificacionCorreoAlta.EnlaceCaducado:
                <h2 class="acceso-titulo">@T["EnlaceCaducadoTitulo"]</h2>
                <p class="acceso-explica">@T["EnlaceCaducadoExplica"]</p>
                <p class="acceso-olvido"><a href="/alta">@T["VolverAEmpezar"]</a></p>
                break;
            case ResultadoVerificacionCorreoAlta.SolicitudCaducada:
                <h2 class="acceso-titulo">@T["SolicitudCaducadaTitulo"]</h2>
                <p class="acceso-explica">@T["SolicitudCaducadaExplica"]</p>
                <p class="acceso-olvido"><a href="/alta">@T["VolverAEmpezar"]</a></p>
                <p class="acceso-explica">@T["AyudaSoporte"]</p>
                break;
            default:
                @* Inalcanzable con los valores actuales del enum: NoValido vuelve a pintar el formulario. *@
                <h2 class="acceso-titulo">@T["EnlaceNoValidoTitulo"]</h2>
                <p class="acceso-explica">@T["EnlaceNoValidoExplica"]</p>
                <p class="acceso-olvido"><a href="/alta">@T["VolverAEmpezar"]</a></p>
                break;
        }
    </div>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? TokenConsulta { get; set; }

    [SupplyParameterFromForm(FormName = "alta-verificar")]
    private DatosEntrada? Entrada { get; set; }

    private bool _habilitada;
    private ResultadoVerificacionCorreoAlta? _resultado;

    protected override void OnInitialized()
    {
        _habilitada = OpcionesAlta.Value.Habilitada;
        if (!_habilitada)
        {
            Navigation.NotFound();
            return;
        }

        Entrada ??= new DatosEntrada { Token = TokenConsulta ?? string.Empty };
    }

    private async Task VerificarAsync()
    {
        if (!_habilitada || Entrada is null)
            return;

        var verificacion = await Registro.VerificarCorreoAsync(Entrada.Token, Entrada.Contrasena, CancellationToken.None);
        // La contraseña no vuelve nunca a la página: el campo se pinta vacío, también tras un intento fallido.
        Entrada.Contrasena = string.Empty;
        _resultado = verificacion.Resultado;

        if (verificacion is { Resultado: ResultadoVerificacionCorreoAlta.Verificado, CredencialContinuacion: { } credencial }
            && HttpContext is not null)
        {
            CookieContinuacionAlta.Escribir(HttpContext, credencial);
            Navigation.NavigateTo(OrganizacionAlta.Ruta);
        }
    }

    private sealed class DatosEntrada
    {
        public string Token { get; set; } = string.Empty;
        public string Contrasena { get; set; } = string.Empty;
    }
}
