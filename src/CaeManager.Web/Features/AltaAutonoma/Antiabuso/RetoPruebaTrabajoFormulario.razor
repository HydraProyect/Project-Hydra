@using CaeManager.Web.Features.AltaAutonoma.Recursos
@using Microsoft.Extensions.Localization
@inject ServicioRetoPruebaTrabajo Servicio
@inject Microsoft.Extensions.Options.IOptions<OpcionesAntiabusoAlta> Opciones
@inject IStringLocalizer<TextosAltaAutonoma> T

@* Reto de prueba de trabajo dentro de un <form> SSR estático (ver ServicioRetoPruebaTrabajo y LimitadorAlta: el envío
   tiene que ir por HTTP). wwwroot/js/reto-prueba-trabajo.js lo resuelve en un Web Worker nada más pintarse, sin que la
   persona haga nada, y deja el nonce en el campo oculto; si se envía antes de tener la solución o antes del tiempo
   mínimo de la trampa de tiempo (data-espera-minima-ms), retiene el envío y lo repite solo cuando se cumplen las dos.
   El estado se anuncia en una región role="status" educada: no roba el foco ni interrumpe al lector de pantalla. *@
<div data-reto-prueba-trabajo
     data-reto="@_reto.Token"
     data-bits="@_reto.DificultadBits"
     data-espera-minima-ms="@((long)Opciones.Value.TiempoMinimoEnvio.TotalMilliseconds)"
     data-vigencia-ms="@((long)Opciones.Value.VigenciaReto.TotalMilliseconds)"
     data-trabajador="@Assets["js/reto-prueba-trabajo-worker.js"]"
     data-texto-listo="@T["RetoListo"]"
     data-texto-esperando="@T["RetoEsperando"]"
     data-texto-error="@T["RetoError"]"
     data-texto-caducado="@T["RetoCaducado"]">
    <input type="hidden" name="@CampoReto" value="@_reto.Token" />
    <input type="hidden" name="@CampoSolucion" value="" data-reto-solucion />
    <p role="status" aria-live="polite" data-reto-estado>@T["RetoComprobando"]</p>
    <noscript><p>@T["RetoSinJavaScript"]</p></noscript>
</div>

@code {
    /// <summary>Nombre del campo del formulario con el token del reto.</summary>
    public const string CampoReto = "reto_prueba_trabajo";

    /// <summary>Nombre del campo del formulario con el nonce que lo resuelve.</summary>
    public const string CampoSolucion = "solucion_prueba_trabajo";

    private RetoPruebaTrabajo _reto = default!;

    // Un reto nuevo en cada pintado: tras un envío rechazado, la página vuelve con otro, porque el anterior ya no sirve.
    protected override void OnInitialized() => _reto = Servicio.Emitir();
}
