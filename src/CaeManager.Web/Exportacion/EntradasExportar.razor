@* El menú descarga todo el listado sin criterios; el icono de la cabecera descarga la vista filtrada. *@
@using Microsoft.Extensions.Localization
@using CaeManager.Web.Recursos
@inject IStringLocalizer<TextosComunes> Comunes

<ItemMenuAccion Href="@Ruta">@Comunes["ExportarTodo"]</ItemMenuAccion>

@code {
    /// <summary>Ruta del endpoint sin criterios de la vista.</summary>
    [Parameter, EditorRequired] public string Ruta { get; set; } = string.Empty;
}
