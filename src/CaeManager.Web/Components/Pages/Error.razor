@page "/Error"
@* MainLayout abre acceso a datos en OnParametersSetAsync (UserManager,
   ActividadUsuarioService) para el guard de cambio de contraseña / 2FA. Si el
   error que trajo al usuario aquí fue precisamente la base de datos caída
   (EnableRetryOnFailure agotado, ver ConfiguracionDeContexto), heredar ese
   layout vuelve a golpear la misma base y agota otros 6 reintentos antes de
   poder mostrar el mensaje (Sentry DOTNET-8). AuthLayout no toca datos — es
   el mismo layout que ya usan las páginas [AllowAnonymous] sin sesión
   (Login, TerminosCondiciones), y es también el que exige el rediseño
   (Estados Sistema TALVEG.dc.html): centrada, sin menú lateral ni barra
   superior. *@
@layout CaeManager.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Error — @Marca.Nombre</PageTitle>

<PaginaEstadoSistema Tipo="TipoEstadoSistema.Error" ReferenciaTecnica="@RequestId" RutaReintentar="@RutaOrigen" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // MainLayout llega aquí sin pasar por UseExceptionHandler (a propósito:
    // ver el comentario de ConDiagnostico en MainLayout.razor.cs — reentrar
    // en ese guard volvería a tocar la base de datos que puede estar
    // fallando), así que para ese camino no hay IExceptionHandlerPathFeature
    // que rellenar. Trae su propia referencia y ruta como parámetros de
    // consulta — un GUID de correlación y la ruta relativa a la que el
    // usuario ya estaba navegando, ninguno de los dos datos nuevos: es la
    // misma URL que ya tenía delante.
    [SupplyParameterFromQuery(Name = "ref")]
    [Parameter]
    public string? ReferenciaExterna { get; set; }

    [SupplyParameterFromQuery(Name = "ruta")]
    [Parameter]
    public string? RutaExterna { get; set; }

    private string? RequestId { get; set; }

    // IExceptionHandlerPathFeature.Path es la ruta que UseExceptionHandler("/Error")
    // capturó ANTES de reejecutar la petición aquí — la petición que de verdad falló,
    // no /Error. Sin ella "Reintentar" no tiene adónde volver de verdad (ver
    // PaginaEstadoSistema.RutaReintentar): PaginaEstadoSistema decide si es segura
    // para navegar, aquí solo se lee tal cual la deja el framework.
    private string? RutaOrigen { get; set; }

    protected override void OnInitialized()
    {
        RequestId = ReferenciaExterna ?? Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        RutaOrigen = RutaExterna ?? HttpContext?.Features.Get<IExceptionHandlerPathFeature>()?.Path;
    }
}
