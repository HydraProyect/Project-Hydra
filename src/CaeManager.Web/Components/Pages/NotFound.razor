@page "/not-found"
@* Antes @layout MainLayout: se pintaba con menú lateral y barra superior
   pese a no llevar sesión garantizada ([AllowAnonymous]). Estados Sistema
   TALVEG.dc.html la lleva centrada y sin menú, como Error — mismo
   AuthLayout, mismo motivo: no prometer una navegación que la ruta anónima
   puede no tener. *@
@layout CaeManager.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Diagnostics
@inject NavigationManager Navegacion

<PageTitle>Página no encontrada — @Marca.Nombre</PageTitle>

<PaginaEstadoSistema Tipo="TipoEstadoSistema.NoEncontrado" RutaOriginal="@RutaOriginal" />

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // La reejecución cambia Request.Path a /not-found; la feature conserva la petición original.
    private string RutaOriginal => HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath
        ?? "/" + Navegacion.ToBaseRelativePath(Navegacion.Uri);
}
