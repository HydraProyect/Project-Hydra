@* Shell centrado y sin navegación para las tres pantallas de estado del
   sistema (Error, /not-found, /acceso-denegado) — Estados Sistema
   TALVEG.dc.html. Estas páginas no llevan MainLayout: sin sesión (Error) o
   con ella pero sin destino claro (404, denegado), no tiene sentido pintar
   menú lateral ni barra superior. Marca arriba con salida al Dashboard,
   tarjeta con acento de color por Tipo, EstadoVacio del catálogo para
   icono/título/descripción, y un camino de salida siempre visible.

   Deliberadamente sin @rendermode: nada aquí necesita un circuito
   interactivo — Boton navega con Href (ancla real), incluido "Reintentar"
   (ver RutaReintentar en el @code). Error.razor en concreto depende de esto:
   si lo que trajo al usuario aquí fue la base de datos caída, abrir un
   circuito interactivo no debería añadir más trabajo antes de poder pintar
   el mensaje (mismo principio que ya aplicaba AuthLayout, Sentry DOTNET-8). *@
@using CaeManager.Infrastructure.Comunicaciones
@using CaeManager.Web.Components.Layout
@using CaeManager.Web.Features.Comunicaciones
@using Microsoft.AspNetCore.Components.Authorization
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IOptions<ComunicacionesOptions> OpcionesComunicaciones
@inject IStringLocalizer<TextosComunes> Textos
<div class="pagina-estado-sistema">
    <a class="marca-estado-sistema" href="/" aria-label="@($"{Marca.Nombre} — ir al Dashboard")">
        <span class="marca-estado-sistema-marca" aria-hidden="true"></span>
        <span class="marca-estado-sistema-nombre">@Marca.Nombre</span>
    </a>

    <Tarjeta Class="@($"tarjeta-estado-sistema tarjeta-estado-sistema-{ClaseTipo}")">
        <EstadoVacio Titulo="@Titulo" Descripcion="@Descripcion"
                     NombreIcono="@NombreIcono"
                     AcentoIcono="@Acento" FondoIcono="@Fondo">
            <Accion>
                @if (MostrarReferenciaTecnica)
                {
                    <div class="referencia-tecnica-estado-sistema">
                        <span class="referencia-tecnica-etiqueta">@Textos["CodigoParaSoporte"]</span>
                        <code class="referencia-tecnica-valor">@ReferenciaTecnica</code>
                        <BotonCopiar Valor="@ReferenciaTecnica" Etiqueta="@Textos["CodigoParaSoporteCopia"]" />
                    </div>
                    <p class="referencia-tecnica-ayuda">
                        @Textos["CodigoParaSoporteAyuda"]
                    </p>
                }

                <div class="acciones-estado-sistema">
                    @if (_destinoLista is { } lista)
                    {
                        <Boton Variante="VarianteBoton.Primario" Href="@lista.Ruta">@Textos[lista.ClaveTexto]</Boton>
                    }
                    @* En acceso denegado, Mi trabajo para quien lo tiene e Inicio para el resto: nunca otra pantalla que su rol niegue. *@
                    <Boton Variante="@(_destinoLista is null ? VarianteBoton.Primario : VarianteBoton.Secundario)" Href="@RutaPrincipal">@EtiquetaPrincipal</Boton>
                    @if (MostrarReintentar)
                    {
                        <Boton Variante="VarianteBoton.Secundario" Href="@RutaReintentar">Reintentar</Boton>
                    }
                    @if (Tipo == TipoEstadoSistema.AccesoDenegado && OpcionesComunicaciones.Value.Activo)
                    {
                        @* RolesComunicaciones.Gestion es la misma constante que exige
                           Bandeja.razor vía [Authorize(Roles = ...)] — este destino solo
                           se pinta si el usuario denegado puede llegar de verdad a
                           /comunicaciones (nunca el rol Cliente, que RolesComunicaciones
                           excluye a propósito). Comparar contra la autorización real de
                           la página en vez de una lista propia evita que las dos se
                           desincronicen. *@
                        <AuthorizeView Roles="@RolesComunicaciones.Gestion" Context="autorizacionComunicaciones">
                            <Boton Variante="VarianteBoton.Secundario" Href="/comunicaciones">Escribir en Comunicaciones</Boton>
                        </AuthorizeView>
                    }
                </div>
            </Accion>
        </EstadoVacio>
    </Tarjeta>

    <div class="pie-legal-estado-sistema">
        <a href="/legal/privacidad">Política de Privacidad</a>
        <span aria-hidden="true">·</span>
        <a href="/legal/terminos">Términos y Condiciones</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TipoEstadoSistema Tipo { get; set; }

    [Parameter] public string? RutaOriginal { get; set; }

    private (string Ruta, string ClaveTexto)? _destinoLista;

    // Los href y las claves proceden exclusivamente del catálogo cerrado, nunca de la URL recibida.
    private static (string Ruta, string ClaveTexto)? DestinoLista(string? ruta)
    {
        if (string.IsNullOrEmpty(ruta) || !ruta.StartsWith('/') || ruta.StartsWith("//", StringComparison.Ordinal))
            return null;

        var segmento = ruta[1..].Split('/', '?', '#')[0].ToLowerInvariant();
        return segmento switch
        {
            "trabajadores" => ("/trabajadores", "VolverListaTrabajadores"),
            "empresas" => ("/empresas", "VolverListaEmpresas"),
            "centros" => ("/centros", "VolverListaCentros"),
            "clientes" => ("/clientes", "VolverListaClientes"),
            "subcontratas" => ("/subcontratas", "VolverListaSubcontratas"),
            "vehiculos" => ("/vehiculos", "VolverListaVehiculos"),
            "proyectos" => ("/proyectos", "VolverListaProyectos"),
            "documentos" => ("/documentos", "VolverListaDocumentos"),
            "visitas" => ("/visitas", "VolverListaVisitas"),
            "gestiones" => ("/gestiones", "VolverListaGestiones"),
            "alertas" => ("/alertas", "VolverListaAlertas"),
            _ => null,
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        _destinoLista = Tipo == TipoEstadoSistema.NoEncontrado && EstadoAutenticacion is not null
            && (await EstadoAutenticacion).User.Identity?.IsAuthenticated == true
                ? DestinoLista(RutaOriginal)
                : null;
    }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    /// <summary>
    /// Adónde lleva el botón principal: siempre Inicio. La pantalla principal es Inicio para todos los
    /// roles (decisión del propietario, 2026-10-21); antes «acceso denegado» llevaba a Mi trabajo a los
    /// roles que lo tienen. «Acceso denegado» conserva su etiqueta «Ir a tu pantalla principal».
    /// </summary>
    private const string RutaPrincipal = "/";

    private string EtiquetaPrincipal => Tipo == TipoEstadoSistema.AccesoDenegado ? Textos["IrATuPantallaPrincipal"].Value : "Ir al Inicio";

    /// <summary>
    /// Solo aplica a <see cref="TipoEstadoSistema.Error"/>. Sin valor, el
    /// bloque de referencia no se pinta — nunca una etiqueta con un hueco
    /// vacío detrás.
    /// </summary>
    [Parameter] public string? ReferenciaTecnica { get; set; }

    /// <summary>
    /// Solo aplica a <see cref="TipoEstadoSistema.Error"/>: la ruta que
    /// falló (<c>IExceptionHandlerPathFeature.Path</c>, capturada en
    /// Error.razor), para que "Reintentar" repita de verdad esa petición en
    /// vez de recargar /Error — que no reproduce nada, solo vuelve a pintar
    /// la propia pantalla de error. Sin ruta conocida, o si no es local
    /// (nunca una URL absoluta ni protocol-relative: sería un redirect
    /// abierto), el botón no se pinta — mejor sin acción que una que promete
    /// un reintento que no hace. Como "Reintentar" siempre navega (ancla real
    /// vía Boton.Href, nunca un POST), tampoco puede duplicar una escritura
    /// que sí hubiera fallado.
    /// </summary>
    [Parameter] public string? RutaReintentar { get; set; }

    private bool MostrarReferenciaTecnica =>
        Tipo == TipoEstadoSistema.Error && !string.IsNullOrEmpty(ReferenciaTecnica);

    private bool MostrarReintentar =>
        Tipo == TipoEstadoSistema.Error && EsRutaLocalSegura(RutaReintentar);

    private static bool EsRutaLocalSegura(string? ruta) =>
        !string.IsNullOrEmpty(ruta)
        && ruta.StartsWith('/')
        && !ruta.StartsWith("//", StringComparison.Ordinal)
        && !ruta.StartsWith("/\\", StringComparison.Ordinal)
        && Uri.TryCreate(ruta, UriKind.Relative, out _);

    private string ClaseTipo => Tipo switch
    {
        TipoEstadoSistema.Error => "error",
        TipoEstadoSistema.NoEncontrado => "no-encontrado",
        TipoEstadoSistema.AccesoDenegado => "acceso-denegado",
        _ => "error",
    };

    private string Titulo => Tipo switch
    {
        TipoEstadoSistema.Error => "Ocurrió un error inesperado",
        TipoEstadoSistema.NoEncontrado => "No encontramos esta página",
        // Lenguaje de producto, no de permisos: quien llega aquí no sabe qué es un rol de plataforma y la
        // propia interfaz no debería haberle ofrecido el destino. Sin nombrar el recurso que se pedía.
        TipoEstadoSistema.AccesoDenegado => "Tu rol actual no incluye esta pantalla",
        _ => string.Empty,
    };

    private string Descripcion => Tipo switch
    {
        TipoEstadoSistema.Error => "No pudimos completar tu solicitud. Inténtalo nuevamente en unos segundos.",
        TipoEstadoSistema.NoEncontrado => "Comprueba la dirección o vuelve al Dashboard.",
        // Nunca "el cliente X no es tuyo" ni "esa ficha no existe": ambas
        // frases confirmarían que el recurso existe, y eso es justo la fuga
        // de información que esta pantalla existe para evitar.
        TipoEstadoSistema.AccesoDenegado => "Si la necesitas para tu trabajo, contacta con quien gestione tus accesos en tu organización.",
        _ => string.Empty,
    };

    private string NombreIcono => Tipo switch
    {
        TipoEstadoSistema.Error => "error-circulo",
        TipoEstadoSistema.NoEncontrado => "buscar",
        TipoEstadoSistema.AccesoDenegado => "seguridad",
        _ => "vacio",
    };

    private string Acento => Tipo switch
    {
        TipoEstadoSistema.Error => "var(--color-danger-500)",
        TipoEstadoSistema.NoEncontrado => "var(--color-border-strong)",
        TipoEstadoSistema.AccesoDenegado => "var(--color-info-500)",
        _ => "var(--color-border-strong)",
    };

    private string Fondo => Tipo switch
    {
        TipoEstadoSistema.Error => "var(--color-danger-50)",
        TipoEstadoSistema.NoEncontrado => "var(--color-surface-subtle)",
        TipoEstadoSistema.AccesoDenegado => "var(--color-info-50)",
        _ => "var(--color-surface-subtle)",
    };
}
