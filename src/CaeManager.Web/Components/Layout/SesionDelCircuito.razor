@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inherits CaeManager.Web.Components.IsloteInteractivo

@*
    Sin marcado: devuelve a la pantalla de acceso a quien tenía sesión y la ha
    perdido mientras el circuito seguía abierto (cuenta desactivada, security
    stamp rotado o un error al revalidar; ver ProveedorAutenticacionRevalidada).

    Hace falta porque el Router de Routes.razor se pinta en SSR estático y su
    AuthorizeRouteView no vive en el circuito: cuando el proveedor pasa a
    anónimo, la página interactiva conserva lo que ya mostraba y nadie la
    expulsa. Las lecturas y escrituras siguen fallando cerradas (sin usuario no
    hay tenant y el filtro global deniega), pero dejar la pantalla a medias
    parece una avería; navegar con forceLoad es lo que haría el
    AuthorizeRouteView de un circuito completo.

    Solo actúa en la transición autenticado → anónimo: la pantalla de acceso
    también usa este layout y nace anónima.
*@

<LimiteDeErrores Islote="this" />

@code {
    private bool _teniaSesion;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _teniaSesion = estado.User.Identity?.IsAuthenticated == true;
        AuthenticationStateProvider.AuthenticationStateChanged += AlCambiarElEstado;
    }

    private void AlCambiarElEstado(Task<AuthenticationState> tareaEstado) =>
        _ = InvokeAsync(async () =>
        {
            var estado = await tareaEstado;
            if (_teniaSesion && estado.User.Identity?.IsAuthenticated != true)
            {
                _teniaSesion = false;
                var rutaActual = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                var destino = "/cuenta/iniciar-sesion";
                var soloRuta = rutaActual.Split('?', '#')[0];
                var enCuenta = soloRuta.Equals("cuenta", StringComparison.OrdinalIgnoreCase)
                    || soloRuta.StartsWith("cuenta/", StringComparison.OrdinalIgnoreCase);
                if (!enCuenta)
                {
                    // Solo rutas locales: Sanear descarta "//host" y "/\host"; SanearParaVolver quita además
                    // la marca de un solo uso desde=login para no reactivar el aterrizaje tras iniciar sesión.
                    var retorno = CaeManager.Web.Components.Account.RedireccionLocal.SanearParaVolver("/" + rutaActual);
                    destino += $"?ReturnUrl={Uri.EscapeDataString(retorno)}";
                }
                NavigationManager.NavigateTo(destino, forceLoad: true);
            }
        });

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= AlCambiarElEstado;
}
