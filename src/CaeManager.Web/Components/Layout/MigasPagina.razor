@using System.Security.Claims
@using CaeManager.Application.Common
@using Microsoft.Extensions.DependencyInjection
@using CaeManager.Application.Tenants.Queries.UsaRotulosPrimeraPersona
@using CaeManager.Web.Recursos
@using MediatR
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject NavigationManager Navigation
@inject IMediator Mediator
@inject PersistentComponentState EstadoPersistente
@inject IServiceProvider Servicios
@inject ILogger<ExcepcionDeCircuitoDesconectado> Logger
@inject IStringLocalizer<TextosComunes> Textos
@inherits CaeManager.Web.Components.IsloteInteractivo

@*
    Rediseño de la cabecera, propuesta 03: dice dónde estás y deja subir un nivel con un clic.
    Las migas salen del catálogo del menú lateral (CatalogoMenuLateral), la misma fuente de
    rótulos y rutas que NavMenu, y no de la propia página: el grupo del menú («Negocio»), la
    sección («Empresas») y, en una ficha, la ficha.

    Solo pinta lo que el catálogo sabe. Una ruta que no es del menú (Mi firma, las pantallas de
    cuenta) no lleva migas, y el nombre de la entidad concreta no se inventa: viene de datos de la
    página, que la cabecera no tiene. Las migas no autorizan ni ocultan nada, solo señalan: el
    acceso a cada pantalla lo sigue decidiendo la pantalla. Es un islote porque tiene que
    seguir la navegación interna del circuito (LocationChanged).
*@
<LimiteDeErrores Islote="this">
@if (_miga is { } miga)
{
    <nav class="migas" aria-label="@Textos["CabeceraRuta"]" data-testid="migas-pagina">
        <ol class="migas-lista">
            <li class="miga miga-grupo">@miga.Grupo</li>
            @for (var i = 0; i < miga.Niveles.Count; i++)
            {
                var nivel = miga.Niveles[i];
                if (i == miga.Niveles.Count - 1)
                {
                    <li class="miga miga-actual" aria-current="page">@nivel.Texto</li>
                }
                else if (nivel.Ruta is not null)
                {
                    <li class="miga"><a href="@nivel.Ruta">@nivel.Texto</a></li>
                }
                else
                {
                    <li class="miga">@nivel.Texto</li>
                }
            }
        </ol>
    </nav>
}
</LimiteDeErrores>

@code {
    /// <param name="Ruta">Ruta absoluta a la que sube el nivel cuando no es el último; null si no es un enlace.</param>
    private sealed record Nivel(string Texto, string? Ruta);

    /// <param name="Niveles">Todo lo que cuelga del grupo; el último es la página actual.</param>
    private sealed record Miga(string Grupo, IReadOnlyList<Nivel> Niveles);

    private Miga? _miga;
    private bool _rotulosPrimeraPersona;
    private PersistingComponentStateSubscription _persistencia;
    private PresentacionMigas? _presentacion;
    private const string ClavePersistencia = "layout-migas-presentacion-v1";
    public sealed record PresentacionMigas(ClaveContextoMemo Contexto, DateTimeOffset Creado, bool PrimeraPersona);

    private Task PersistirPresentacionAsync()
    {
        if (_presentacion is { } presentacion)
            EstadoPersistente.PersistAsJson(ClavePersistencia, presentacion);
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += AlCambiarDeRuta;

        // Mismo dato que NavMenu usa para «Mi empresa» / «Mis trabajadores», para que la miga
        // diga lo mismo que el menú. Si no se puede leer, los rótulos genéricos.
        try
        {
            var usuario = Servicios.GetService<ICurrentUserService>();
            var tenant = Servicios.GetService<ITenantActual>();
            var contexto = usuario is not null && tenant is not null
                ? await ClaveContextoMemo.ResolverAsync(usuario, tenant) : null;
            if (Servicios.GetService<CaeManager.Application.Tenants.IVistaVocabularioPreviewService>()?.PerfilForzado is not null)
                contexto = null;
            if (EstadoPersistente.TryTakeFromJson<PresentacionMigas>(ClavePersistencia, out var anterior)
                && anterior is not null && contexto is { } clave && anterior.Contexto == clave
                && DateTimeOffset.UtcNow - anterior.Creado is var edad && edad >= TimeSpan.Zero && edad < MemoPorContexto.Caducidad)
                _rotulosPrimeraPersona = anterior.PrimeraPersona;
            else
            {
                _rotulosPrimeraPersona = await Mediator.Send(new UsaRotulosPrimeraPersonaQuery());
                if (contexto is { } actual)
                    _presentacion = new(actual, DateTimeOffset.UtcNow, _rotulosPrimeraPersona);
            }
        }
        catch (Exception ex) when (ExcepcionDeCircuitoDesconectado.Es(ex))
        {
            Logger.LogWarning(ex, "MigasPagina descartó una excepción de desconexión de circuito: {TipoExcepcion} — {Mensaje}",
                ex.GetType().Name, ex.Message);
        }

        _miga = Resolver(Navigation.Uri);
        _persistencia = EstadoPersistente.RegisterOnPersisting(PersistirPresentacionAsync);
    }

    private void AlCambiarDeRuta(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            _miga = Resolver(e.Location);
            StateHasChanged();
        });

    /// <summary>
    /// La sección del catálogo cuya ruta es la actual o su prefijo (la más larga gana, para que
    /// «cartera/solicitudes» no caiga en otra más corta). Una ruta con un segmento más que es un
    /// identificador es la ficha de esa sección.
    /// </summary>
    private Miga? Resolver(string uri)
    {
        var ruta = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/');
        var consulta = QueryHelpers.ParseQuery(new Uri(uri).Query);
        var pestana = consulta.TryGetValue("pestana", out var valorPestana) ? valorPestana.ToString() : null;

        // Una pestaña de sección (Revisión IA, Incidencias, Usuarios, Roles) se resuelve por su sección, como en
        // el marco de Design: «Negocio › Documentos › Incidencias», «Administración › Equipo › Roles». También la
        // primera pestaña: dos entradas del menú comparten la ruta «usuarios» (Control para el Coordinador CAE,
        // Administración) y la miga no evalúa condiciones, así que la sección fija el grupo.
        if (CatalogoSeccionesMenu.PestanaDe(ruta, pestana) is { } encontrada)
            return ResolverPestanaDeSeccion(ruta, encontrada.Seccion, encontrada.Pestana);

        // «Mi cuenta / Mi avatar» (revisión de Design §B): /mi-avatar no es del menú lateral (se llega desde el menú
        // de la cuenta), pero el marco la dibuja con su miga. «Mi cuenta» no es un grupo del menú: solo un rótulo.
        if (ruta.Equals("mi-avatar", StringComparison.OrdinalIgnoreCase))
            return new Miga(Textos["CabeceraMiCuenta"], [new Nivel(Textos["CabeceraMigaMiAvatar"], null)]);

        Miga? mejor = null;
        var longitudMejor = -1;

        foreach (var variante in new[] { false, true })
        {
            var contexto = new ContextoMenuLateral(new ClaimsPrincipal(), null, false, false, default,
                VariosTenants: variante, RotulosPrimeraPersona: _rotulosPrimeraPersona);

            foreach (var enlace in CatalogoMenuLateral.Enlaces)
            {
                var rutaEnlace = enlace.RutaPara(contexto).Trim('/');
                var coincide = enlace.CoincidenciaExacta || rutaEnlace.Length == 0
                    ? ruta.Equals(rutaEnlace, StringComparison.OrdinalIgnoreCase)
                    : ruta.Equals(rutaEnlace, StringComparison.OrdinalIgnoreCase)
                      || ruta.StartsWith(rutaEnlace + "/", StringComparison.OrdinalIgnoreCase);
                if (!coincide || rutaEnlace.Length <= longitudMejor) continue;

                var grupo = CatalogoMenuLateral.Grupos.FirstOrDefault(g => g.Id == enlace.GrupoId);
                if (grupo is null) continue;

                var resto = ruta.Length > rutaEnlace.Length ? ruta[rutaEnlace.Length..].Trim('/') : string.Empty;
                // Solo un identificador (Guid) cuenta como ficha; «importar», «revision-ia»… son
                // pantallas de la sección y no se les inventa un rótulo.
                var esFicha = Guid.TryParse(resto, out _);
                var seccion = enlace.RotuloPara(contexto, Textos);
                mejor = new Miga(grupo.Titulo,
                    esFicha
                        ? [new Nivel(seccion, "/" + rutaEnlace), new Nivel(Textos["CabeceraMigaFicha"], null)]
                        : [new Nivel(seccion, null)]);
                longitudMejor = rutaEnlace.Length;
            }
        }

        return mejor;
    }

    /// <summary>
    /// Una pantalla que ya no tiene enlace propio en el menú (Incidencias, Revisión IA, Roles) es pestaña de una
    /// sección (<see cref="CatalogoSeccionesMenu"/>). Migas del marco de Design: el grupo de la entrada de la
    /// que cuelga la sección, la sección (que sube a su primera pestaña) y la pestaña; y, en una ficha de la
    /// pestaña, esta pasa a ser un enlace y la ficha el nivel actual.
    /// </summary>
    private Miga? ResolverPestanaDeSeccion(string ruta, SeccionMenu seccion, PestanaSeccionMenu pestana)
    {
        var enlace = CatalogoMenuLateral.Enlaces.FirstOrDefault(e => e.Id == seccion.EnlaceId);
        var grupo = enlace is null ? null : CatalogoMenuLateral.Grupos.FirstOrDefault(g => g.Id == enlace.GrupoId);
        if (enlace is null || grupo is null) return null;

        var rutaPestana = pestana.Ruta.Split('?')[0].Trim('/');
        var resto = ruta.Length > rutaPestana.Length ? ruta[rutaPestana.Length..].Trim('/') : string.Empty;
        var rutaSeccion = "/" + seccion.Pestanas[0].Ruta;
        var nivelSeccion = new Nivel(Textos[seccion.ClaveRotulo], rutaSeccion);

        var esPrimera = seccion.Pestanas[0] == pestana;
        if (Guid.TryParse(resto, out _))
            return new Miga(grupo.Titulo, esPrimera
                ? [nivelSeccion, new Nivel(Textos["CabeceraMigaFicha"], null)]
                : [nivelSeccion, new Nivel(Textos[pestana.ClaveRotulo], "/" + pestana.Ruta), new Nivel(Textos["CabeceraMigaFicha"], null)]);

        // En la primera pestaña la sección es la propia página actual.
        return new Miga(grupo.Titulo, esPrimera
            ? [new Nivel(Textos[seccion.ClaveRotulo], null)]
            : [nivelSeccion, new Nivel(Textos[pestana.ClaveRotulo], null)]);
    }

    public void Dispose()
    {
        _persistencia.Dispose();
        Navigation.LocationChanged -= AlCambiarDeRuta;
    }
}
