@inherits LayoutComponentBase
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> TextosComunes

<a class="saltar-al-contenido" href="#contenido-principal">@TextosComunes["SaltarAlContenido"]</a>
<div class="shell">
    <aside class="barra-lateral">
        <div class="marca">
            @* Opción D elegida por el propietario (2026-09-19): wordmark oficial en vez del
               nombre en texto, con la etiqueta "CAE" al lado. Marca.Nombre NO se toca: sigue
               siendo el nombre de títulos de pestaña y correos, esto solo cambia lo que se
               pinta aquí. lockup-claro.svg/lockup-oscuro.svg alterna solo por data-theme='oscuro'
               explícito (SelectorTema); en "sistema" y en el primer render, antes de que el
               script del selector escriba data-theme, se ve el claro a propósito, porque
               tokens.css tiene el seguimiento automático de prefers-color-scheme apagado y
               --color-surface se queda en blanco en esos casos (ver MainLayout.razor.css). *@
            <img src="img/marca/talveg-lockup-claro.svg" alt="TALVEG" class="marca-wordmark marca-wordmark-claro" width="106" height="22" />
            <img src="img/marca/talveg-lockup-oscuro.svg" alt="TALVEG" class="marca-wordmark marca-wordmark-oscuro" width="106" height="22" />
            <span class="marca-etiqueta">CAE</span>
        </div>
        @* Selector de Tenant beneficiario (mockup «Selector Empresa Gestionada», decisión 7 ter):
           bajo la marca y encima del menú, solo para quien alcanza varias empresas gestionadas.
           Es el antiguo selector de la barra superior, evolucionado; en móvil vive en el cajón. *@
        <AuthorizeView>
            <Authorized>
                <SelectorClienteActivo @rendermode="InteractiveServer" />
            </Authorized>
        </AuthorizeView>
        <NavMenu />
    </aside>

    <div class="area-principal">
        @* Cabecera y banda de avisos del sistema forman un solo bloque fijo (rediseño de la
           cabecera): se quedan arriba al desplazar la página, con sombra y velo (cabecera.js
           marca data-desplazada). La sesión de soporte tiene que anunciarse en todas las
           pantallas y verse siempre, por eso los avisos viajan con la cabecera y no con @Body. *@
        <div class="cabecera-fija">
            <header class="barra-superior">
                <div class="barra-superior-izquierda">
                    <NavegacionMovil />
                    <MigasPagina @rendermode="InteractiveServer" />
                </div>
                <div class="barra-superior-derecha">
                    <CaeManager.Web.Features.BusquedaGlobal.BotonBuscadorGlobal />
                    <AuthorizeView>
                        <Authorized>
                            <div class="menu-usuario">
                                <VistasTecnicas @rendermode="InteractiveServer" />
                                <CaeManager.Web.Features.Notificaciones.CampanaAvisos @rendermode="InteractiveServer" />
                                <SelectorTema @rendermode="InteractiveServer" />
                                <MenuUsuario Nombre="@context.User.Identity?.Name" />
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </header>

            @* Banda única de avisos del sistema, por prioridad (de arriba abajo): sesión de soporte,
               fin de la ventana de soporte, fin de un acceso, solo consulta. Cada aviso conserva su
               componente y su fuente; aquí solo se agrupan. Necesitan su propio @rendermode por lo
               que explica el comentario de más abajo. *@
            <div class="cabecera-bandas" data-bandas-sistema>
                <div class="cabecera-bandas-interior">
                    <TrazaSoporte @rendermode="InteractiveServer" />
                    <AvisoVentanaSoporte @rendermode="InteractiveServer" />
                    <AvisoFinDeAccesoEstatico />
                    <AvisoSoloConsulta />
                </div>
            </div>
        </div>

        <SesionDelCircuito @rendermode="InteractiveServer" />
        <EnlaceVolverAMiTrabajo />

        <main class="contenido" id="contenido-principal" tabindex="-1">
            @* P1-E1: un fallo de la página se queda dentro de <main>; barra lateral y
               cabecera siguen vivas. Cubre el renderizado estático y el prerenderizado;
               una página InteractiveServer es raíz de su propio circuito y este límite no
               está por encima de ella ahí: lleva su propio envoltorio (PaginaInteractiva +
               <LimiteDeErrores Pagina="this">, ver el comentario de LimiteDeErrores). *@
            <LimiteDeErrores>
                @Body
            </LimiteDeErrores>
        </main>
    </div>
</div>

@* Body carga con su propio @rendermode, pero ese modo no se propaga hacia
   arriba al Layout — todo lo que vive fuera de @Body necesita su propio
   @rendermode explícito o nunca recibe eventos interactivos (bug real
   encontrado al construir el buscador global: los toasts llevaban toda la
   Fase 2 sin funcionar por este mismo motivo, sin que ningún test lo
   hubiera detectado).

   Cada componente con @rendermode="InteractiveServer" de este layout es otra raíz
   del mismo circuito que la página: una excepción no contenida en cualquiera de
   ellos tumba la pantalla entera. Por eso cada uno hereda de IsloteInteractivo y
   envuelve su marcado en <LimiteDeErrores Islote="this"> (P1-E1c; lo exige
   IslotesInteractivosConLimiteDeErroresTests). Uno nuevo tiene que hacer lo mismo. *@
<AnfitrionToasts @rendermode="InteractiveServer" />
<CaeManager.Web.Features.BusquedaGlobal.BuscadorGlobal @rendermode="InteractiveServer" />
<AuthorizeView>
    <Authorized>
        <CaeManager.Web.Features.Cumplimiento.AceptacionTerminosGate @rendermode="InteractiveServer" />
        <CaeManager.Web.Features.AsistenteIa.BotonAsistenteIa />
        <CaeManager.Web.Features.AsistenteIa.AsistenteIa @rendermode="InteractiveServer" />
        <CaeManager.Web.Components.Workspace.ContextWorkspace @rendermode="InteractiveServer" />
        <CaeManager.Web.Features.AtajosGlobales.AtajosGlobales @rendermode="InteractiveServer" />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    No pudimos completar esa acción.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
