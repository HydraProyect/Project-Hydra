@inherits CaeManager.Web.Components.IsloteInteractivo
@implements IDisposable
@implements IAsyncDisposable
@using CaeManager.Application.Tenants.Queries.ObtenerClientesAutorizados
@*
    Mockup «Selector Empresa Gestionada TALVEG» y contrato del selector de Tenant
    beneficiario (decisiones 1, 7 bis y 7 ter): vive en la cabecera de la barra
    lateral, bajo la marca, y solo se pinta si el usuario alcanza varios Tenants
    beneficiarios (ClientesAutorizados.SelectorVisible). Para cualquier otro
    usuario, cero cambio de UX. Nunca se usa la palabra «tenant» de cara al
    usuario: es la «empresa gestionada».

    La selección es una coordenada de contexto, no una autoridad: cada opción es
    un botón de envío de un <form> HTML corriente que hace POST a
    /cuenta/cliente-activo (recarga completa en la empresa elegida), no un
    @onchange de Blazor. Cambiar de Tenant escribe una cookie en el servidor y
    necesita token antiforgery (hallazgo M-8); el endpoint revalida la Asignación
    de Cartera y la de Operación en ese momento. Lo único interactivo (desplegar,
    buscar) es estado de pantalla: abrir la lista no autoriza nada. Las flechas
    ↑/↓ mueven el foco entre opciones con el listener delegado de
    microinteracciones.js (data-selector-tenant), porque la CSP no admite scripts
    en línea.
*@
<LimiteDeErrores Islote="this">
@if (_activo is not null && ClientesAutorizados.SelectorVisible(_clientes!, _activo))
{
    <div class="selector-tenant" data-selector-tenant @onkeydown="AlPulsarTecla"
         data-activo="@_activo.TenantId" data-autorizados="@IdsFijables" data-fijadas="@IdsFijadas">
        @* Alt+1…5 (selector-tenant-fijadas.js) cambia a la 1.ª…5.ª empresa fijada (data-fijadas) con este mismo POST: el
           formulario existe aunque la lista esté cerrada, con el token antiforgery y la ruta de retorno
           de siempre, y el servidor revalida la Asignación de Cartera y la de Operación como en cualquier
           cambio. El Id que escribe el JS sale de lo ya autorizado (data-autorizados): una fijada es una
           preferencia del navegador, no un permiso. *@
        <form data-selector-atajo method="post" action="/cuenta/cliente-activo" hidden>
            @if (_token is not null)
            {
                <input type="hidden" name="@_token.FormFieldName" value="@_token.Value" />
            }
            <input type="hidden" name="returnUrl" value="@RutaDeRetorno" />
            <input type="hidden" name="tenantId" value="" />
        </form>
        <button type="button" class="selector-tenant-disparador @(_abierto ? "selector-tenant-disparador-abierto" : null)"
                aria-haspopup="listbox" aria-expanded="@(_abierto ? "true" : "false")"
                aria-label="@Textos["SelectorTenantEtiqueta"]: @_activo.Nombre" title="@_activo.Nombre"
                data-tenant-id="@_activo.TenantId" @onclick="Alternar">
            <AvatarTenant Nombre="@_activo.Nombre" LogoUrl="@UrlLogo(_activo)" Tamano="TamanoAvatarTenant.Pequeno" />
            <span class="selector-tenant-texto">
                <span class="selector-tenant-sub">@Textos["SelectorTenantRotulo"]</span>
                <span class="selector-tenant-nombre" title="@_activo.Nombre">@_activo.Nombre</span>
            </span>
            <span class="selector-tenant-chevron @(_abierto ? "selector-tenant-chevron-abierto" : null)" aria-hidden="true">
                <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
            </span>
        </button>

        @if (_abierto)
        {
            <button type="button" class="selector-tenant-velo" tabindex="-1" aria-hidden="true" @onclick="Cerrar"></button>
            <div class="selector-tenant-panel">
                @* Marco de Design (marco-talveg.js, DDL-083): título de la cartera y, al lado, «+ Solicitar», que lleva al flujo
                   existente de solicitud de incorporación a la cartera (/cartera/solicitudes); solo se ofrece a quien participa
                   en él (ParticipaEnIncorporacionCarteraQuery), el mismo criterio que la página, que a los demás les niega el acceso. *@
                <div class="selector-tenant-cabecera">
                    <h6 class="selector-tenant-cabecera-titulo">@Textos["SelectorTenantCartera", Empresas(_totalCartera)]</h6>
                    @if (_puedeSolicitar)
                    {
                        <a class="selector-tenant-solicitar" href="/cartera/solicitudes"
                           title="@Textos["SelectorTenantSolicitarTitulo"]">@Textos["SelectorTenantSolicitar"]</a>
                    }
                </div>

                @if (_totalCartera >= UmbralBusqueda)
                {
                    @* Fuera del <form>: Intro en el buscador no debe enviar un POST sin Tenant. *@
                    <input type="search" class="selector-tenant-busqueda" placeholder="@Textos["SelectorTenantBuscar"]"
                           aria-label="@Textos["SelectorTenantBuscar"]" @ref="_buscador"
                           @bind="Busqueda" @bind:event="oninput" />
                }

                <form method="post" action="/cuenta/cliente-activo">
                    @if (_token is not null)
                    {
                        <input type="hidden" name="@_token.FormFieldName" value="@_token.Value" />
                    }
                    <input type="hidden" name="returnUrl" value="@RutaDeRetorno" />

                    @* Fijadas (estrella; Alt+1…5 para las cinco primeras) arriba, después las recientes y
                       el resto de la cartera. Mientras se busca, la búsqueda ve la cartera entera y plana. *@
                    @if (Fijadas.Count > 0)
                    {
                        <h6 class="selector-tenant-grupo" id="selector-tenant-fijadas">@Textos["SelectorTenantFijadas"]</h6>
                        <div role="listbox" aria-labelledby="selector-tenant-fijadas" aria-orientation="vertical" class="selector-tenant-lista">
                            @for (var i = 0; i < Fijadas.Count; i++)
                            {
                                @Opcion(Fijadas[i], false, i < MaximoAtajos ? i + 1 : 0)
                            }
                        </div>
                    }

                    @if (Recientes.Count > 0)
                    {
                        <h6 class="selector-tenant-grupo" id="selector-tenant-recientes">@Textos["SelectorTenantRecientes"]</h6>
                        <div role="listbox" aria-labelledby="selector-tenant-recientes" aria-orientation="vertical" class="selector-tenant-lista">
                            @foreach (var reciente in Recientes)
                            {
                                @Opcion(reciente, false)
                            }
                        </div>
                    }

                    @* Como en el marco de Design, la lista principal siempre lleva cabecera: «Resto de la cartera» si hay
                       fijadas (o recientes) encima y «Recientes» si no las hay. Mientras se busca no hay cabecera: la búsqueda
                       ve la cartera entera y plana. *@
                    @* Si todas las empresas ya están en Fijadas o Recientes la lista principal queda vacía: sin cabecera ni lista
                       y sin «Sin resultados», que solo tiene sentido al buscar. *@
                    @if (Buscando || Filtrados.Any())
                    {
                        @if (!Buscando)
                        {
                            <h6 class="selector-tenant-grupo" id="selector-tenant-resto">@(HayGruposArriba ? Textos["SelectorTenantResto"] : Textos["SelectorTenantRecientes"])</h6>
                        }
                        <div role="listbox" aria-orientation="vertical" class="selector-tenant-lista"
                             aria-label="@(Buscando ? Textos["SelectorTenantLista"].Value : null)"
                             aria-labelledby="@(Buscando ? null : "selector-tenant-resto")">
                            @foreach (var cliente in Filtrados)
                            {
                                @Opcion(cliente, false)
                            }
                        </div>
                    }

                    @if (Buscando && !Filtrados.Any())
                    {
                        <p class="selector-tenant-vacio" role="status">@Textos["SelectorTenantSinResultados"]</p>
                    }

                    @* «Tu organización» queda fija bajo la lista, separada de la cartera. *@
                    @if (_origen is not null)
                    {
                        <div class="selector-tenant-separador"></div>
                        <div role="listbox" aria-label="@Textos["SelectorTenantOrigen"]">
                            @Opcion(_origen, true)
                        </div>
                    }
                </form>
            </div>
        }
    </div>
}
</LimiteDeErrores>

@code {
    /// <param name="atajo">1…5 si la empresa está entre las cinco primeras fijadas (Alt + ese número); 0 si no.</param>
    private RenderFragment Opcion(ClienteAutorizadoDto cliente, bool esOrigen, int atajo = 0) => __builder =>
    {
        var esActivo = cliente.TenantId == _activo!.TenantId;
        var pendientes = Pendientes(cliente);
        var etiqueta = pendientes is { } n ? $"{cliente.Nombre}, {(n == 1 ? Textos["SelectorTenantPendientesUno"].Value : Textos["SelectorTenantPendientes", n].Value)}" : cliente.Nombre;
        var fijable = PuedeFijar && !esOrigen;
        var fijada = fijable && _fijadas.Contains(cliente.TenantId);
        var etiquetaFijar = fijada
            ? Textos["SelectorTenantQuitarFijada"].Value
            : Textos["SelectorTenantFijar"].Value;
        <div class="selector-tenant-fila-envoltorio" role="presentation">
            <button type="submit" name="tenantId" value="@cliente.TenantId" role="option" aria-selected="@(esActivo ? "true" : "false")"
                    class="selector-tenant-fila @(esActivo ? "selector-tenant-fila-activa" : null)"
                    title="@cliente.Nombre" aria-label="@etiqueta" aria-keyshortcuts="@(atajo > 0 ? $"Alt+{atajo}" : null)">
                <AvatarTenant Nombre="@cliente.Nombre" LogoUrl="@UrlLogo(cliente)" Tamano="TamanoAvatarTenant.Pequeno" />
                <span class="selector-tenant-texto">
                    <span class="selector-tenant-nombre">@cliente.Nombre</span>
                    @if (esOrigen)
                    {
                        <span class="selector-tenant-sub">@Textos["SelectorTenantOrigen"]</span>
                    }
                </span>
                @if (atajo > 0)
                {
                    <kbd class="selector-tenant-atajo" aria-hidden="true">Alt @atajo</kbd>
                }
                @if (pendientes is { } total)
                {
                    <span class="selector-tenant-contador" aria-hidden="true">@total</span>
                }
                @if (esActivo)
                {
                    <span class="selector-tenant-marca" aria-hidden="true"><Icono Nombre="check" Tamano="TamanoIcono.Pequeno" /></span>
                }
            </button>
            @if (fijable)
            {
                @* Fuera del botón de envío (un botón dentro de otro no es válido) y de tipo «button»: no envía el formulario. *@
                <button type="button" class="selector-tenant-fijar" aria-pressed="@(fijada ? "true" : "false")"
                        aria-label="@etiquetaFijar" title="@etiquetaFijar"
                        @onclick="() => AlternarFijadaAsync(cliente.TenantId)">
                    <Icono Nombre="estrella" Tamano="TamanoIcono.Pequeno" />
                </button>
            }
        </div>
    };
}
