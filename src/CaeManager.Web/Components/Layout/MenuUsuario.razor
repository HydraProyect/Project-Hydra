@using CaeManager.Web.Recursos
@using CaeManager.Application.Usuarios.Queries.ObtenerAvatarPropio
@using MediatR
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Textos
@inject IMediator Mediator
@inject ILogger<MenuUsuario> Logger

@*
    Menú de la cuenta (rediseño de la cabecera, propuesta 01): el avatar de la persona (el que
    eligió, o sus iniciales) abre un panel con «Mi firma y mis datos», el idioma y «Cerrar
    sesión», que antes ocupaban la fila de la cabecera. Dentro del panel, pulsar el propio
    avatar lleva a /mi-avatar, donde se elige (decisión de producto del 2026-10-08). SSR estático, sin @rendermode: abre, cierra y navega con el teclado
    wwwroot/js/cabecera.js (delegado en document), y «Cerrar sesión» e idioma siguen siendo
    <form> con POST y token antiforgery, como siempre.

    El panel está siempre en el marcado (oculto con visibility, no con display) para que la
    transición de apertura se vea y para que Esc devuelva el foco al botón.
*@
<div class="menu-cuenta">
    <button type="button" class="menu-cuenta-boton" id="menu-cuenta-boton"
            data-menu-cabecera aria-haspopup="menu" aria-expanded="false" aria-controls="menu-cuenta-panel"
            aria-label="@Textos["CabeceraMenuUsuario"]" data-tooltip="@Textos["CabeceraMenuUsuario"]">
        <AvatarUsuario Nombre="@Nombre" Avatar="@_avatar" />
    </button>

    <div class="panel-cabecera menu-cuenta-panel" id="menu-cuenta-panel" role="menu" aria-labelledby="menu-cuenta-boton">
        <a href="/mi-avatar" class="menu-cuenta-cabecera menu-cuenta-elemento" role="menuitem">
            <AvatarUsuario Nombre="@Nombre" Avatar="@_avatar" />
            <span class="menu-cuenta-identidad">
                <span class="menu-cuenta-nombre">@Nombre</span>
                <span class="menu-cuenta-cambiar">@Textos["CabeceraCambiarAvatar"]</span>
            </span>
        </a>
        <a href="/mi-firma" class="menu-cuenta-elemento" role="menuitem">@Textos["CabeceraMiFirma"]</a>
        <div class="menu-cuenta-idioma" role="none">
            <SelectorIdioma />
        </div>
        <div class="menu-cuenta-separador" role="separator"></div>
        <form method="post" action="/cuenta/cerrar-sesion" role="none">
            <AntiforgeryToken />
            <button type="submit" class="boton-cerrar-sesion menu-cuenta-elemento" role="menuitem">
                <Icono Nombre="cerrar-sesion" Tamano="TamanoIcono.Pequeno" />
                <span>@Textos["CabeceraCerrarSesion"]</span>
            </button>
        </form>
    </div>
</div>

@code {
    /// <summary>El nombre que expone la identidad de quien mira (<c>Identity.Name</c>).</summary>
    [Parameter] public string? Nombre { get; set; }

    /// <summary>Clave del avatar de quien mira; <c>null</c> pinta sus iniciales.</summary>
    private string? _avatar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _avatar = await Mediator.Send(new ObtenerAvatarPropioQuery());
        }
        catch (Exception excepcion) when (excepcion is not OperationCanceledException)
        {
            // El avatar es decoración: si no se puede leer, la cabecera se pinta con
            // las iniciales en vez de tumbar el layout de todas las páginas.
            Logger.LogWarning(excepcion, "No se pudo leer el avatar de la cuenta para el menú de cabecera");
        }
    }
}
