@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal-superposicion" @onclick="ManejarClicSuperposicionAsync">
        <div class="modal-contenido modal-contenido-@Ancho.ToString().ToLowerInvariant()" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="@_tituloId" tabindex="-1" @ref="_referenciaContenedor" @onkeydown="ManejarTeclaAsync">
            <div class="modal-header">
                <h2 id="@_tituloId">@Titulo</h2>
                @if (!Bloqueante)
                {
                    <button type="button" class="modal-cerrar" aria-label="Cerrar" @onclick="SolicitarCierreAsync"><Icono Nombre="cerrar" /></button>
                }
            </div>
            <div class="modal-cuerpo">
                @ChildContent
            </div>
            @if (Pie is not null)
            {
                <div class="modal-pie">@Pie</div>
            }
        </div>
    </div>

    @if (_confirmandoDescarte)
    {
        <ConfirmarDescartarCambios AlSeguir="SeguirEditando" AlDescartar="DescartarYCerrarAsync" />
    }
}

@code {
    private readonly string _tituloId = $"modal-titulo-{Guid.NewGuid():N}";
    private ElementReference _referenciaContenedor;
    private IJSObjectReference? _trampaFoco;
    private bool _previoVisible;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Pie { get; set; }
    [Parameter] public bool CerrarAlHacerClicFuera { get; set; } = true;

    /// <summary>
    /// Sin botón Cerrar, sin clic fuera, sin Escape — a diferencia de
    /// <see cref="CerrarAlHacerClicFuera"/> (que protege trabajo sin guardar
    /// pero deja el botón Cerrar como vía de escape explícita), este modal no tiene
    /// ninguna forma de cerrarse hasta que el propio contenido invoque
    /// <see cref="VisibleChanged"/> (p. ej. tras completar una acción
    /// obligatoria). Pensado para condiciones de bloqueo reales — aceptación
    /// de términos pendiente — no para "evitar perder cambios".
    /// </summary>
    [Parameter] public bool Bloqueante { get; set; }

    /// <summary>Mediano (520px) es el default histórico — ver <see cref="AnchoModal"/>.</summary>
    [Parameter] public AnchoModal Ancho { get; set; } = AnchoModal.Mediano;

    /// <summary>
    /// Focus trap + retorno de foco (hallazgo P0-8 de
    /// Project-Hydra-Negocio/MATURITY_REVIEW.md — Project-Hydra-Negocio/tecnico/docs/archive/design/DESIGN_SYSTEM.md ya prometía
    /// "Escape para cerrar overlays" y no se cumplía). El Tab en sí lo
    /// atrapa dialogo-foco.js (necesita recorrer el DOM, algo que Blazor no
    /// puede hacer sin interop); aquí solo se detecta la transición
    /// oculto→visible/visible→oculto para activar y liberar la trampa.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_previoVisible)
            await ActivarTrampaFocoAsync();
        else if (!Visible && _previoVisible)
            await LiberarTrampaFocoAsync();

        _previoVisible = Visible;
    }

    /// <summary>
    /// Mejor esfuerzo: el diálogo sigue siendo usable sin el focus trap si el
    /// entorno no soporta JS interop en este momento (circuito cerrándose, o
    /// —como en los tests de componente con bUnit, sin navegador real
    /// detrás— sin módulo que mockear). Escape para cerrar no depende de
    /// esto, es puro Blazor. El comportamiento real de foco/teclado lo
    /// prueba Playwright contra la app real (ver CaeManager.E2ETests).
    /// </summary>
    private async Task ActivarTrampaFocoAsync()
    {
        try
        {
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialogo-foco.js");
            if (modulo is null) return;

            await using (modulo)
            {
                _trampaFoco = await modulo.InvokeAsync<IJSObjectReference>("atraparFoco", _referenciaContenedor);
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task CerrarAsync() => await VisibleChanged.InvokeAsync(false);

    /// <summary>
    /// P1-E2b: si el formulario de dentro tiene algo que se perdería al cerrar. Se consulta
    /// al pedir el cierre con la X, Escape o un clic en el fondo; con <c>true</c>, antes de
    /// cerrar se pregunta «¿Descartar cambios?» (ConfirmarDescartarCambios). Los botones del
    /// propio formulario («Cancelar», «Guardar») no pasan por aquí: son decisión explícita.
    /// Es la misma función que el formulario pasa a AvisoCambiosSinGuardar.
    /// </summary>
    [Parameter] public Func<bool>? HayCambios { get; set; }

    private bool _confirmandoDescarte;

    private Task SolicitarCierreAsync()
    {
        if (HayCambios?.Invoke() == true)
        {
            _confirmandoDescarte = true;
            return Task.CompletedTask;
        }

        return CerrarAsync();
    }

    private void SeguirEditando() => _confirmandoDescarte = false;

    protected override void OnParametersSet()
    {
        // Cerrado desde fuera mientras preguntaba (p. ej. terminó un guardado): la
        // pregunta no puede reaparecer sola al volver a abrirlo.
        if (!Visible)
            _confirmandoDescarte = false;
    }

    private Task DescartarYCerrarAsync()
    {
        _confirmandoDescarte = false;
        return CerrarAsync();
    }

    private Task ManejarClicSuperposicionAsync() =>
        !Bloqueante && CerrarAlHacerClicFuera ? SolicitarCierreAsync() : Task.CompletedTask;

    /// <summary>
    /// Misma condición que cerrar al clicar fuera: si hay trabajo sin
    /// guardar, Escape tampoco debe descartarlo de golpe. Un modal
    /// <see cref="Bloqueante"/> tampoco cierra con Escape, por la misma razón
    /// que no tiene botón Cerrar.
    /// </summary>
    private Task ManejarTeclaAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" && !Bloqueante && CerrarAlHacerClicFuera ? SolicitarCierreAsync() : Task.CompletedTask;

    private async Task LiberarTrampaFocoAsync()
    {
        if (_trampaFoco is null) return;

        var trampa = _trampaFoco;
        _trampaFoco = null;

        try
        {
            // DisposeAsync de un IJSObjectReference también hace interop (para
            // liberar la referencia en el lado JS) — si el circuito se cerró
            // entre la llamada anterior y esta, también puede lanzar. Las dos
            // llamadas van en el mismo try: un circuito ya cerrado no tiene
            // nada que liberar en ninguna de ellas.
            await trampa.InvokeVoidAsync("dispose");
            await trampa.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync() => await LiberarTrampaFocoAsync();
}
