@*
    H2 (Project-Hydra-Negocio/tecnico/docs/ux-audit/05-trabajadores-vehiculos.md, ver Project-Hydra-Negocio/tecnico/docs/archive/design/DESIGN_SYSTEM.md §
    Dropdown): agrupa las acciones de fila (hoy apiladas verticalmente, 2-3
    botones por fila) tras un disparador de "más acciones" — densidad de una línea por
    fila. El cierre al clicar fuera reutiliza el mismo truco que Modal.razor
    (superposición a pantalla completa detrás del panel, sin JS interop);
    cada ItemMenuAccion se cierra a sí mismo tras ejecutar su acción vía
    CascadingValue — ver ItemMenuAccion.razor.
*@
<div class="menu-acciones">
    <button type="button" class="@ClasesDisparador" aria-haspopup="menu" aria-expanded="@(_abierto ? "true" : "false")"
            aria-controls="@_panelId" aria-label="@(Etiqueta ?? EtiquetaAccesible ?? "Más acciones")" title="@(Etiqueta is null && ConBorde ? EtiquetaAccesible : null)"
            @ref="_disparador" @onclick="Alternar" @onkeydown="ManejarTeclaDisparadorAsync">
        @if (Etiqueta is null)
        {
            <Icono Nombre="mas-opciones" />
        }
        else
        {
            @Etiqueta
            <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
        }
    </button>
    @if (_abierto)
    {
        <div class="menu-acciones-superposicion" @onclick="Cerrar"></div>
        <div id="@_panelId" class="@(Pastilla ? "menu-acciones-panel menu-acciones-panel-izquierda" : "menu-acciones-panel")" role="menu" @onclick:stopPropagation="true">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    }
</div>

@code {
    private readonly string _panelId = $"menu-acciones-{Guid.NewGuid():N}";
    private readonly List<ItemMenuAccion> _items = [];
    private ElementReference _disparador;

    internal Task EnfocarDisparadorAsync() => _disparador.FocusAsync().AsTask();
    private bool _abierto;
    private ItemMenuAccion? _itemPendienteDeFoco;
    private bool _primerItemPendiente;
    private bool _ultimoItemPendiente;
    private bool _disparadorPendienteDeFoco;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Texto del disparador («Más» en la cabecera de una lista). Sin valor, el
    /// disparador es el icono «⋯» de las filas.
    /// </summary>
    [Parameter] public string? Etiqueta { get; set; }

    /// <summary>
    /// Nombre accesible del disparador cuando es solo el icono «⋯» (p. ej. «Acciones de {fila}»), para
    /// que las filas de una lista se distingan entre sí. No se ve en pantalla; si hay <see cref="Etiqueta"/>,
    /// manda esta. Sin valor, el nombre es «Más acciones», como siempre.
    /// </summary>
    [Parameter] public string? EtiquetaAccesible { get; set; }

    /// <summary>
    /// El disparador es una pastilla de filtro (BarraFiltros con pastillas): borde redondeado
    /// completo, y el panel se abre alineado a la izquierda, bajo la pastilla.
    /// </summary>
    [Parameter] public bool Pastilla { get; set; }

    /// <summary>Con <see cref="Pastilla"/>: el filtro tiene un valor aplicado y la pastilla lo marca.</summary>
    [Parameter] public bool Activa { get; set; }

    /// <summary>Disparador de icono «⋯» con borde, del tamaño de los botones de la cabecera de listado.</summary>
    [Parameter] public bool ConBorde { get; set; }

    private string ClasesDisparador =>
        "menu-acciones-disparador"
        + (Etiqueta is null ? "" : " menu-acciones-disparador-texto")
        + (Pastilla ? " menu-acciones-disparador-pastilla" : "")
        + (Pastilla && Activa ? " menu-acciones-disparador-activa" : "")
        + (ConBorde ? " menu-acciones-disparador-borde" : "");

    private void Alternar()
    {
        if (_abierto)
        {
            Cerrar();
            return;
        }

        Abrir(primerItem: true);
    }

    internal void Cerrar()
    {
        _abierto = false;
        StateHasChanged();
    }

    /// <summary>
    /// Cierra y devuelve el foco al disparador: Esc, y elegir una opción de una pastilla de filtro
    /// (el usuario sigue en la barra; sin esto el foco se perdería con el panel). Las acciones no
    /// lo hacen: suelen abrir un drawer o un diálogo que se queda con el foco.
    /// </summary>
    internal void CerrarDevolviendoFoco()
    {
        _disparadorPendienteDeFoco = true;
        Cerrar();
    }

    internal void Registrar(ItemMenuAccion item)
    {
        if (_items.Contains(item)) return;

        _items.Add(item);
        if ((_primerItemPendiente || _ultimoItemPendiente) && _items.Count > 0)
            StateHasChanged();
    }

    internal Task ManejarTeclaDeItemAsync(ItemMenuAccion item, KeyboardEventArgs e)
    {
        var habilitados = _items.Where(i => i.Habilitado).ToList();

        switch (e.Key)
        {
            case "ArrowDown": ProgramarFoco(Siguiente(habilitados, item, 1)); break;
            case "ArrowUp": ProgramarFoco(Siguiente(habilitados, item, -1)); break;
            case "Home": ProgramarFoco(habilitados.FirstOrDefault()); break;
            case "End": ProgramarFoco(habilitados.LastOrDefault()); break;
            case "Escape":
                CerrarDevolviendoFoco();
                break;
            case "Tab": Cerrar(); break;
            // Enter y Espacio NO se manejan aquí: sobre un <button> el navegador ya
            // dispara el click nativo, que ejecuta el ítem y cierra. Manejarlos también
            // en keydown ejecutaría la acción dos veces.
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((_primerItemPendiente || _ultimoItemPendiente) && _items.Count > 0)
        {
            var habilitados = _items.Where(i => i.Habilitado).ToList();
            // En un menú de opciones (pastilla de filtro) el foco empieza en la vigente.
            var marcado = habilitados.FirstOrDefault(i => i.Marcado == true);
            _itemPendienteDeFoco = _primerItemPendiente ? marcado ?? habilitados.FirstOrDefault() : habilitados.LastOrDefault();
            _primerItemPendiente = false;
            _ultimoItemPendiente = false;
        }

        if (_itemPendienteDeFoco is not null)
        {
            var item = _itemPendienteDeFoco;
            _itemPendienteDeFoco = null;
            await item.EnfocarAsync();
        }

        if (_disparadorPendienteDeFoco)
        {
            _disparadorPendienteDeFoco = false;
            await _disparador.FocusAsync();
        }
    }

    private void Abrir(bool primerItem)
    {
        _abierto = true;
        _items.Clear();
        _primerItemPendiente = primerItem;
        _ultimoItemPendiente = !primerItem;
    }

    // La tecla llega por el @onkeydown del ítem hijo, así que Blazor solo repinta el
    // hijo: sin este StateHasChanged el menú no vuelve a pintarse, OnAfterRenderAsync
    // no corre y el foco nunca se mueve en el navegador.
    private void ProgramarFoco(ItemMenuAccion? item)
    {
        if (item is null) return;
        _itemPendienteDeFoco = item;
        StateHasChanged();
    }

    private static ItemMenuAccion? Siguiente(IReadOnlyList<ItemMenuAccion> items, ItemMenuAccion actual, int direccion)
    {
        if (items.Count == 0) return null;
        var indice = Enumerable.Range(0, items.Count).FirstOrDefault(i => ReferenceEquals(items[i], actual));
        if (!ReferenceEquals(items[indice], actual)) indice = -1;
        if (indice < 0) return items[0];
        return items[(indice + direccion + items.Count) % items.Count];
    }

    private Task ManejarTeclaDisparadorAsync(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") Abrir(primerItem: true);
        else if (e.Key == "ArrowUp") Abrir(primerItem: false);
        // Abierto sin ningún ítem habilitado (p. ej. «Más filtros» solo con «Guardar filtro»
        // deshabilitado) el foco se queda en el disparador: Esc también cierra desde ahí.
        else if (e.Key == "Escape" && _abierto) Cerrar();
        return Task.CompletedTask;
    }
}
