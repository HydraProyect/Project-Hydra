@*
    Badge circular de % de cumplimiento documental (Centro 360, PLAN-EJECUCION-UX.md
    § 0.8; ESPECIFICACION-VISUAL-HYDRA.md § 3.5) — SVG inline, sin dependencias
    externas (Design System, ver "Progress" en DESIGN_SYSTEM.md). Sin universo
    (Porcentaje null) se muestra "—", nunca 0%/100% ni el hueco vacío de antes
    — "sin requisitos" es un estado que hay que decir, no un silencio.

    El número va en un <span> HTML superpuesto (position:absolute), no en un
    <text> SVG (lámina L3, ".ring .pct"): un <text> dentro del <svg> hereda su
    propio motor de layout de texto — kerning y antialiasing distintos del
    resto de la interfaz — y por eso se veía "de otra tipografía" comparado
    con el lámina aunque el token de fuente fuera el mismo. Lleva el símbolo
    "%" (el lámina lo pinta siempre: "41%", no "41").
*@
@if (Porcentaje is { } porcentaje)
{
    <span class="anillo-cumplimiento-envoltorio anillo-cumplimiento-@Tamano.ToString().ToLowerInvariant() anillo-cumplimiento-@ObtenerTono(porcentaje).ToString().ToLowerInvariant()"
          role="img" aria-label="@(Etiqueta ?? $"{porcentaje}% de cumplimiento")">
        <svg class="anillo-cumplimiento" viewBox="0 0 36 36" aria-hidden="true">
            <title>@(Etiqueta ?? $"{porcentaje}% de cumplimiento")</title>
            <circle class="anillo-cumplimiento-pista" cx="18" cy="18" r="@RadioSvg" />
            <circle class="anillo-cumplimiento-progreso" cx="18" cy="18" r="@RadioSvg"
                    stroke-dasharray="@FormatearTrazo(porcentaje)" />
        </svg>
        <span class="anillo-cumplimiento-texto" aria-hidden="true">@porcentaje%</span>
    </span>
}
else
{
    <span class="anillo-cumplimiento-envoltorio anillo-cumplimiento-@Tamano.ToString().ToLowerInvariant() anillo-cumplimiento-sin-universo"
          role="img" aria-label="@(Etiqueta ?? "Sin requisitos")">
        <span class="anillo-cumplimiento-texto" aria-hidden="true">—</span>
    </span>
}

@code {
    private const double Radio = 15.5;
    private static readonly double Circunferencia = 2 * Math.PI * Radio;

    /// <summary>
    /// El radio, formateado en cultura invariante. Interpolar el <c>double</c>
    /// directamente en el atributo lo escribía con la coma decimal de la
    /// cultura de la petición (es-ES): <c>r="15,5"</c> no es una longitud SVG
    /// válida, el navegador la descartaba y el anillo se dibujaba con radio 0
    /// — solo se veía el número, nunca el aro. <c>stroke-dasharray</c> ya lo
    /// hacía bien; esto le faltaba al radio.
    /// </summary>
    private static readonly string RadioSvg = Radio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    [Parameter] public int? Porcentaje { get; set; }
    [Parameter] public TamanoAnillo Tamano { get; set; } = TamanoAnillo.Medio;

    /// <summary>Texto del tooltip/aria-label — por defecto "N% de cumplimiento"; pasar algo más específico (ej. "72% de cumplimiento de Empresa acumulado en 4 centros") cuando el contexto lo pida.</summary>
    [Parameter] public string? Etiqueta { get; set; }

    /// <summary>
    /// Umbrales propios del anillo (100% = Exito, ≥50% = Advertencia, resto
    /// Peligro) — no reutiliza EstadoCentroUi/EstadoDocumentoUi a propósito:
    /// esos traducen el peor caso documental, esto traduce una fracción, son
    /// preguntas distintas aunque compartan paleta.
    /// </summary>
    private static TonoBadge ObtenerTono(int porcentaje) => porcentaje switch
    {
        100 => TonoBadge.Exito,
        >= 50 => TonoBadge.Advertencia,
        _ => TonoBadge.Peligro
    };

    private static string FormatearTrazo(int porcentaje)
    {
        var progreso = Circunferencia * Math.Clamp(porcentaje, 0, 100) / 100.0;
        return $"{progreso.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {Circunferencia.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
    }
}
