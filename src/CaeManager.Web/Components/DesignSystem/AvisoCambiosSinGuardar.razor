@using Microsoft.AspNetCore.Components.Routing
@using CaeManager.Web.Components.Workspace
@inject NavigationManager Navegacion
@implements IDisposable
@using System.Runtime.CompilerServices

@*
    Aviso de cambios sin guardar (P1-E2): el único sitio de la aplicación que monta un
    NavigationLock (lo vigila NavigationLockSoloEnElAvisoDeCambiosSinGuardarTests).

    Cada formulario decide una sola cosa, HayCambios, con un único punto de verdad propio
    (normalmente: el estado actual del formulario comparado con una instantánea tomada al
    abrirlo). Lo demás es de aquí:
    - salir por la aplicación (menú lateral, miga, enlace, NavigateTo) con cambios se
      detiene y pregunta; «Seguir editando» se queda donde estaba y «Salir y descartar»
      repite la navegación ya sin volver a preguntar;
    - recargar o cerrar la pestaña con cambios dispara el aviso del propio navegador
      (ConfirmExternalNavigation), que no admite texto propio;
    HayCambios es una función y se consulta en el momento de navegar, no el valor del
    último render: así la navegación que el propio formulario lanza justo después de
    cerrarse (limpiar ?accion= de la URL, «Continuar con…» tras guardar) ya ve el
    formulario cerrado y no pregunta.
    Para decidir HayCambios en un drawer o modal, InstantaneaFormulario compara los
    campos con cómo se abrió el formulario.

    Dentro de un AmbitoCambiosSinGuardar en cascada (la pestaña de un panel del Context
    Workspace o de /documentos), además se registra en él: cambiar de pestaña no navega
    antes de desmontar, así que quien cambia pregunta con este mismo aviso
    (ConfirmarAbandonoAsync) antes de hacerlo. Dentro de un panel del Context Workspace se
    registra también en el ámbito de la ficha (cascada con nombre): abrir otra ficha, volver,
    el breadcrumb o cerrar el panel tampoco navegan antes de desmontarlo, y el
    ContextWorkspaceService pregunta igual antes de cambiar la pila.

    Una navegación, una pregunta (S12, lote 2b). Un formulario con kit (DrawerFormulario) lleva su propio aviso y una
    pantalla puede llevar además el suyo de página (cubre varios formularios, un modal, una edición en línea). El
    NavigationManager deja de invocar los demás NavigationLock en cuanto uno detiene la navegación (medido), así que la
    primera pregunta sale una sola vez; el defecto estaba en la segunda vuelta: «Salir y descartar» repite la navegación y
    el otro aviso, que nunca llegó a verla, volvía a preguntar si el AlDescartar del primero no limpiaba también lo que su
    HayCambios mira. Ahora el aviso que detiene la navegación conoce a todos los avisos montados del circuito (registro por
    NavigationManager) y al detenerla anota cuáles más tienen cambios y la habrían detenido: «Salir y descartar» corre el
    AlDescartar de todos ellos y deja pasar la navegación en todos; «Seguir editando» no descarta a ninguno. Lo mismo al
    cambiar de pestaña o de ficha: AmbitoCambiosSinGuardar pregunta una vez por ámbito, no una por aviso. Da igual quién
    pregunte y en qué orden se montaron: AvisoCambiosSinGuardarUnaPreguntaTests lo fija.

    Solo funciona en componentes interactivos: en una página estática (las de cuenta y
    2FA) no hay circuito que reciba el evento de navegación.

    Qué NO cubre: cerrar el drawer o el modal que contiene el formulario no es navegar.
    La X, Escape o el clic en el fondo preguntan «¿Descartar cambios?» si el formulario
    pasa ese mismo HayCambios a su Drawer/Modal (ConfirmarDescartarCambios, P1-E2b);
    La salida del pie («Cancelar», «Volver»… el botón secundario) pregunta igual que la X: el formulario llama a
    SolicitarCierreAsync del Drawer o Modal por referencia (@ref) en vez de poner Visible a false (D-05).
    DrawerYModalConCamposPreguntanAlDescartarTests exige las dos cosas: HayCambios en todo Drawer o Modal con
    campos y que, si lo pasa, el secundario de su pie use SolicitarCierreAsync (salvo las salidas declaradas
    allí con su motivo: acciones que no cierran y confirmaciones cuya salida descarta a propósito).
*@

<NavigationLock OnBeforeInternalNavigation="AntesDeSalirAsync" ConfirmExternalNavigation="HayCambios()" />

@if (_preguntando)
{
    <PreguntaSalirSinGuardar AlSeguir="SeguirEditando" AlDescartar="SalirDescartandoAsync"
                             Titulo="@Titulo" Mensaje="@Mensaje" TextoSeguir="@TextoSeguir" TextoDescartar="@TextoDescartar" />
}

@code {
    /// <summary>
    /// Si el formulario tiene algo escrito que se perdería al salir. Es el único dato
    /// que el formulario aporta: mientras devuelva <c>false</c>, este componente no hace
    /// nada. Se consulta al navegar (no el valor del último render): el formulario que
    /// acaba de cerrarse y navega en el mismo manejador ya no tiene nada que perder.
    /// </summary>
    [Parameter, EditorRequired] public Func<bool> HayCambios { get; set; } = () => false;

    /// <summary>
    /// Se invoca tras confirmar la salida y antes de repetir la navegación: para limpiar lo
    /// que el formulario dejaría a medias (p. ej. un archivo subido que nadie adoptó).
    /// </summary>
    [Parameter] public EventCallback AlDescartar { get; set; }

    /// <summary>Textos propios del formulario; si faltan, los genéricos de TextosComunes.</summary>
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Mensaje { get; set; }
    [Parameter] public string? TextoSeguir { get; set; }
    [Parameter] public string? TextoDescartar { get; set; }

    /// <summary>La zona que se desmonta sin navegar (pestaña), si la hay.</summary>
    [CascadingParameter] public AmbitoCambiosSinGuardar? Ambito { get; set; }

    /// <summary>La ficha del Context Workspace que contiene el formulario, si la hay.</summary>
    [CascadingParameter(Name = AmbitoCambiosSinGuardar.NombreAmbitoFicha)] public AmbitoCambiosSinGuardar? AmbitoFicha { get; set; }

    private bool _preguntando;
    private string? _destinoPendiente;
    private bool _salidaConfirmada;
    private TaskCompletionSource<bool>? _abandonoPendiente;

    /// <summary>
    /// Los avisos montados en un circuito (la clave es su NavigationManager, uno por circuito: no se mezclan entre usuarios y el
    /// registro no retiene un circuito cerrado). Solo lo lee quien detiene una navegación, para saber qué otros avisos con
    /// cambios la habrían detenido.
    /// </summary>
    private static readonly ConditionalWeakTable<NavigationManager, List<AvisoCambiosSinGuardar>> Montados = new();

    /// <summary>Avisos con cambios que se adhirieron a la pregunta de ESTE aviso (solo tiene contenido mientras pregunta).</summary>
    private readonly List<AvisoCambiosSinGuardar> _adheridos = [];

    protected override void OnInitialized()
    {
        var montados = Montados.GetOrCreateValue(Navegacion);
        lock (montados)
            montados.Add(this);
        Ambito?.Registrar(this);
        AmbitoFicha?.Registrar(this);
    }

    public void Dispose()
    {
        if (Montados.TryGetValue(Navegacion, out var montados))
        {
            lock (montados)
                montados.Remove(this);
        }

        Ambito?.Retirar(this);
        AmbitoFicha?.Retirar(this);
        // Desmontado mientras preguntaba: quien espera no se queda colgado.
        _abandonoPendiente?.TrySetResult(true);
    }

    internal bool TieneCambios => HayCambios();

    /// <summary>
    /// El ámbito ya preguntó una vez por todos los avisos de la zona y el líder descartó: este aviso descarta lo suyo sin volver a
    /// preguntar (una pregunta por ámbito, S12 lote 2b).
    /// </summary>
    internal Task DescartarSinPreguntarAsync() => AlDescartar.InvokeAsync();

    /// <summary>
    /// Lo llama el <see cref="AmbitoCambiosSinGuardar"/> antes de desmontar la zona: sin
    /// cambios, <c>true</c> al momento; con cambios, pregunta y devuelve la respuesta.
    /// </summary>
    internal Task<bool> ConfirmarAbandonoAsync()
    {
        if (!HayCambios())
            return Task.FromResult(true);

        _abandonoPendiente?.TrySetResult(false);
        _abandonoPendiente = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _destinoPendiente = null;
        _preguntando = true;
        StateHasChanged();
        return _abandonoPendiente.Task;
    }

    private Task AntesDeSalirAsync(LocationChangingContext contexto)
    {
        // La salida ya confirmada pasa una sola vez: si la navegación no desmonta el
        // formulario (misma página, otra query string), lo siguiente vuelve a preguntar.
        if (_salidaConfirmada)
        {
            _salidaConfirmada = false;
            return Task.CompletedTask;
        }

        if (!DebeDetener(contexto))
            return Task.CompletedTask;

        // Los otros avisos montados con cambios que también la habrían detenido (el NavigationManager ya no los invoca: este la
        // detiene primero): se adhieren a esta pregunta en vez de volver a preguntar en la segunda vuelta.
        _adheridos.Clear();
        _adheridos.AddRange(OtrosQueTambienLaDetendrian(contexto));

        contexto.PreventNavigation();
        _destinoPendiente = contexto.TargetLocation;
        _preguntando = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// ¿Este aviso detiene la navegación? Sin efectos: lo decide el aviso que la detiene y también los que se adhieren a su pregunta.
    /// </summary>
    private bool DebeDetener(LocationChangingContext contexto)
    {
        // Cambiar de ficha en el Context Workspace ya confirmado (o sin nada que perder) escribe
        // ?ctx= con la ficha nueva mientras esta todavía está montada: no es otra salida.
        if (AmbitoFicha?.EnAbandonoAutorizado == true)
            return false;

        // Cambiar de pestaña en el Context Workspace escribe ?ctx= con la pestaña nueva de la
        // misma ficha. Un formulario fuera de las pestañas (sin ámbito) no se desmonta con
        // eso: no es una salida. Uno dentro de una pestaña sí se desmonta, así que solo pasa
        // si esa navegación acompaña a un cambio que Pestanas ya confirmó; un enlace o
        // atrás/adelante hacia otra pestaña sigue preguntando.
        if ((Ambito is null || Ambito.EnAbandonoAutorizado)
            && ContextWorkspace.EsSoloCambioDePestana(
                Navegacion.ToAbsoluteUri(Navegacion.Uri), Navegacion.ToAbsoluteUri(contexto.TargetLocation)))
            return false;

        // Un formulario de la ficha del Context Workspace no se desmonta porque la PÁGINA
        // de debajo escriba su pestaña o un filtro en la URL (misma página, mismo ?ctx=):
        // no es una salida. Sin esto, cambiar de pestaña en una ficha 360 con el panel a
        // medio editar preguntaba sin motivo y «Seguir editando» dejaba la URL desincronizada.
        if (AmbitoFicha is not null
            && ContextWorkspace.ConservaLaFichaAbierta(
                Navegacion.ToAbsoluteUri(Navegacion.Uri), Navegacion.ToAbsoluteUri(contexto.TargetLocation)))
            return false;

        return HayCambios();
    }

    private IEnumerable<AvisoCambiosSinGuardar> OtrosQueTambienLaDetendrian(LocationChangingContext contexto)
    {
        if (!Montados.TryGetValue(Navegacion, out var montados))
            return [];

        // Solo los de la misma superficie: el Context Workspace vive en el layout y sus formularios sobreviven al cambio de ruta.
        // Quien descarta la pantalla no descarta de paso la ficha que tenga a medias: esa pregunta sigue siendo suya (segunda
        // vuelta, como antes de la v2) y en ella se puede seguir editando.
        lock (montados)
            return montados.Where(a => !ReferenceEquals(a, this) && ReferenceEquals(a.AmbitoFicha, AmbitoFicha)
                                       && !a._salidaConfirmada && !a._preguntando && a.DebeDetener(contexto)).ToList();
    }

    /// <summary>
    /// El aviso que preguntó descartó: este descarta lo suyo y deja pasar la navegación confirmada (una sola vez, como el que
    /// preguntó) sin volver a preguntar aunque su AlDescartar no limpie del todo lo que HayCambios mira.
    /// </summary>
    private async Task DescartarAdheridoAsync()
    {
        await AlDescartar.InvokeAsync();
        _salidaConfirmada = true;
    }

    private void SeguirEditando()
    {
        _preguntando = false;
        _destinoPendiente = null;
        _adheridos.Clear();
        _abandonoPendiente?.TrySetResult(false);
        _abandonoPendiente = null;
    }

    private async Task SalirDescartandoAsync()
    {
        _preguntando = false;
        if (_abandonoPendiente is { } abandono)
        {
            _abandonoPendiente = null;
            await AlDescartar.InvokeAsync();
            abandono.TrySetResult(true);
            return;
        }

        if (_destinoPendiente is not { } destino)
            return;

        _destinoPendiente = null;
        var adheridos = _adheridos.ToList();
        _adheridos.Clear();
        await AlDescartar.InvokeAsync();
        foreach (var adherido in adheridos)
            await adherido.DescartarAdheridoAsync();
        _salidaConfirmada = true;
        Navegacion.NavigateTo(destino);
    }
}
