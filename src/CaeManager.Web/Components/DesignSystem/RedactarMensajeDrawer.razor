@*
    Drawer "Redactar mensaje" reutilizable — mismo EnviarMensajeNuevoCommand
    y misma resolución de buzón que ya usaba Bandeja.razor (Parte XVI
    PROMPT 09), extraído para que otras pantallas (Reportes: "Enviar por
    Comunicaciones…") puedan abrir el mismo compositor sin duplicar la
    lógica de selección de buzón. Bandeja.razor conserva su propia copia
    inline sin tocar — es pantalla ya verificada esta sesión, y refactorizarla
    para consumir este componente no aporta nada que no fuera puramente
    cosmético, así que no se ha arriesgado esa regresión.
*@
@using CaeManager.Application.Comunicaciones.Commands.EnviarMensajeNuevo
@using CaeManager.Application.Integraciones
@using CaeManager.Application.Integraciones.Queries.ObtenerConexionesIntegracion
@using CaeManager.Domain.Common
@using CaeManager.Domain.Integraciones
@using CaeManager.Web.Recursos
@using MediatR
@using Microsoft.Extensions.Localization
@inject IMediator Mediator
@inject ToastService ToastService
@inject IStringLocalizer<TextosComunes> Comunes

<DrawerFormulario Visible="Visible" VisibleChanged="CerrarAsync" Titulo="Redactar mensaje"
                 HayCambios="() => HayCambiosSinGuardar" Guardando="_enviando" MensajeError="@_error"
                 OnGuardar="EnviarAsync" TextoGuardar="Enviar" TextoCancelar="Cancelar"
                 SinContenido="@(_sinBuzon ? ContenidoSinBuzon : null)"
                 MotivoGuardarDeshabilitado="@(_sinBuzon ? Comunes["SinBuzonEnviarDeshabilitado"].Value : null)">
    @if (_conexiones.Count > 1)
    {
        <CampoSelect Etiqueta="Enviar desde" Valor="@(_conexionId?.ToString() ?? string.Empty)" ValorChanged="v => _conexionId = Guid.TryParse(v, out var id) ? id : null">
            <option value="">Selecciona un buzón…</option>
            @foreach (var conexion in _conexiones)
            {
                <option value="@conexion.Id">@conexion.Nombre (@conexion.BuzonEmail)</option>
            }
        </CampoSelect>
    }

    <CampoTexto Etiqueta="Para (separados por coma)" Valor="@_destinatarios" ValorChanged="v => _destinatarios = v" Placeholder="contacto@cliente.com" />
    <CampoTexto Etiqueta="Asunto" Valor="@_asunto" ValorChanged="v => _asunto = v" />
    <CampoTextarea Etiqueta="Mensaje" Valor="@_cuerpo" ValorChanged="v => _cuerpo = v" Filas="6" />

    @if (Adjunto is not null)
    {
        <span class="detalle-tecnico">📎 @Adjunto.NombreArchivo</span>
    }
</DrawerFormulario>

@code {
    /// <summary>
    /// FS-15: sin buzón conectado el compositor no se cierra con un aviso que se va solo. Dice por qué no se puede enviar,
    /// quién lo arregla, y deja a mano lo que el llamador ya había preparado: el texto para copiarlo y, si dio de dónde
    /// bajarlo (<see cref="RutaDescargaAdjunto"/>), el adjunto.
    /// </summary>
    private RenderFragment ContenidoSinBuzon => @<AvisoSinBuzonCorreo TextoParaCopiar="@AvisoSinBuzonCorreo.TextoDeCorreo(AsuntoInicial, CuerpoInicial)"
                                                                      Destinatarios="@DestinatariosIniciales">
        @if (Adjunto is not null && !string.IsNullOrWhiteSpace(RutaDescargaAdjunto))
        {
            <a class="aviso-sin-buzon-descargar" href="@RutaDescargaAdjunto" download data-enhance-nav="false">@Comunes["SinBuzonDescargarAdjunto", Adjunto.NombreArchivo]</a>
        }
    </AvisoSinBuzonCorreo>;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    /// <summary>Destinatarios con los que se abre, separados por coma; quien redacta los revisa y puede cambiarlos.</summary>
    [Parameter] public string? DestinatariosIniciales { get; set; }
    [Parameter] public string? AsuntoInicial { get; set; }
    [Parameter] public string? CuerpoInicial { get; set; }
    [Parameter] public AdjuntoParaEnviarDto? Adjunto { get; set; }
    /// <summary>De dónde se baja <see cref="Adjunto"/> con una petición normal, para ofrecerlo cuando no hay buzón desde el que enviarlo.</summary>
    [Parameter] public string? RutaDescargaAdjunto { get; set; }
    [Parameter] public EventCallback OnEnviado { get; set; }

    /// <summary>
    /// Envío alternativo: quien abre el compositor para algo más que un mensaje suelto (el
    /// paquete de acreditación de una Visita, que además deja la Visita gestionada) manda el
    /// mensaje ya compuesto por su propio comando de Application. Sin él, se envía con
    /// <see cref="EnviarMensajeNuevoCommand"/> tal cual.
    /// </summary>
    [Parameter] public Func<EnviarMensajeNuevoCommand, Task<Result<Guid>>>? EnviarCon { get; set; }

    private IReadOnlyList<ConexionIntegracionListaDto> _conexiones = [];
    private Guid? _conexionId;
    private string _destinatarios = string.Empty;
    private string _asunto = string.Empty;
    private string _cuerpo = string.Empty;
    private string? _error;
    private bool _enviando;
    private bool _preparado;
    private bool _sinBuzon;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_preparado)
        {
            _preparado = true;
            await PrepararAsync();
        }
        else if (!Visible)
        {
            _preparado = false;
        }
    }

    private async Task PrepararAsync()
    {
        _destinatarios = DestinatariosIniciales ?? string.Empty;
        _asunto = AsuntoInicial ?? string.Empty;
        _cuerpo = CuerpoInicial ?? string.Empty;
        _error = null;
        _conexionId = null;
        _sinBuzon = false;
        FijarInstantaneaFormulario();

        var conexiones = await Mediator.Send(new ObtenerConexionesIntegracionQuery(SoloPropiasYGenerales: true));
        _conexiones = conexiones.Where(c => c.Estado == EstadoConexionIntegracion.Habilitada).ToList();
        _conexionId = _conexiones.Count == 1 ? _conexiones[0].Id : null;
        // El buzón preseleccionado (el único que hay) no es un cambio de quien redacta. Solo
        // cambia ese valor de partida: lo que se haya tecleado mientras cargaban los buzones
        // sí es un cambio, así que los demás siguen siendo los de la apertura.
        _instantanea.Fijar(_conexionId, DestinatariosIniciales ?? string.Empty, AsuntoInicial ?? string.Empty, CuerpoInicial ?? string.Empty);

        _sinBuzon = _conexiones.Count == 0;
    }

    private readonly InstantaneaFormulario _instantanea = new();

    /// <summary>
    /// P1-E2b: único punto de verdad de «hay cambios» en el mensaje que se está redactando,
    /// comparado con cómo se abrió (asunto y cuerpo iniciales del llamador incluidos). Lo
    /// lee DrawerFormulario: la X, Escape, el fondo, «Cancelar» y salir de la página.
    /// </summary>
    private bool HayCambiosSinGuardar => Visible && _instantanea.Difiere(ValoresFormulario());

    private object?[] ValoresFormulario() => [_conexionId, _destinatarios, _asunto, _cuerpo];

    private void FijarInstantaneaFormulario() => _instantanea.Fijar(ValoresFormulario());

    /// <summary>
    /// El cuadro es de texto plano y el comando envía HTML: sin esto los saltos de línea
    /// (el correo de la Visita lleva varios párrafos) llegarían colapsados y un «&lt;»
    /// escrito sería marcado.
    /// </summary>
    internal static string TextoPlanoAHtml(string texto) =>
        System.Net.WebUtility.HtmlEncode(texto).Replace("\r\n", "\n").Replace("\n", "<br>");

    private Task CerrarAsync(bool visible)
    {
        if (visible) return Task.CompletedTask;
        return VisibleChanged.InvokeAsync(false);
    }

    private async Task EnviarAsync()
    {
        if (_sinBuzon) return;

        if (_conexionId is null)
        {
            _error = "Selecciona desde qué buzón enviarlo.";
            return;
        }

        var destinatarios = _destinatarios
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (destinatarios.Count == 0)
        {
            _error = "Indica al menos un destinatario.";
            return;
        }

        _enviando = true;
        _error = null;
        StateHasChanged();

        try
        {
            var adjuntos = Adjunto is null ? null : new List<AdjuntoParaEnviarDto> { Adjunto };
            var mensaje = new EnviarMensajeNuevoCommand(
                _conexionId.Value, destinatarios, _asunto, TextoPlanoAHtml(_cuerpo), Adjuntos: adjuntos);
            var resultado = EnviarCon is null ? await Mediator.Send(mensaje) : await EnviarCon(mensaje);

            if (resultado.EsFallido)
            {
                _error = resultado.Error.Mensaje;
                return;
            }

            ToastService.Mostrar("Mensaje enviado.", TonoToast.Exito);
            // Enviado: lo escrito ya no se pierde, aunque el llamador navegue en OnEnviado.
            FijarInstantaneaFormulario();
            await OnEnviado.InvokeAsync();
            await CerrarAsync(false);
        }
        catch (Exception)
        {
            _error = "No pudimos enviar el mensaje. Intenta nuevamente.";
        }
        finally
        {
            _enviando = false;
        }
    }
}
