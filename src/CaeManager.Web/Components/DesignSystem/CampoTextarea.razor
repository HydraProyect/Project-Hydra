<div class="campo">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label for="@_id">@Etiqueta</label>
    }
    <textarea id="@_id"
              class="campo-textarea @(TieneError ? "campo-input-error" : null)"
              rows="@Filas"
              placeholder="@Placeholder"
              disabled="@Deshabilitado"
              @oninput="ManejarCambioAsync"
              @onblur="() => OnBlur.InvokeAsync()">@Valor</textarea>
    @if (TieneError)
    {
        <span class="campo-mensaje-error" role="alert">@MensajeError</span>
    }
</div>

@code {
    private readonly string _id = $"campo-textarea-{Guid.NewGuid():N}";

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public int Filas { get; set; } = 3;
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>Ver <see cref="CampoTexto"/> — mismo propósito, misma semántica.</summary>
    [Parameter] public EventCallback OnBlur { get; set; }

    private bool TieneError => !string.IsNullOrWhiteSpace(MensajeError);

    private Task ManejarCambioAsync(ChangeEventArgs e) => ValorChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
