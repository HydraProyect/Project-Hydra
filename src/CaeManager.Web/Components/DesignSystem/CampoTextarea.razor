<div class="campo">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label for="@_id">@Etiqueta</label>
    }
    <textarea id="@_id"
              class="campo-textarea @(TieneError ? "campo-input-error" : null)"
              rows="@Filas"
              placeholder="@Placeholder"
              disabled="@Deshabilitado"
              @oninput="ManejarCambioAsync"
              @onblur="() => OnBlur.InvokeAsync()">@_valorMostrado</textarea>
    @if (TieneError)
    {
        <span class="campo-mensaje-error" role="alert">@MensajeError</span>
    }
</div>

@code {
    private readonly string _id = $"campo-textarea-{Guid.NewGuid():N}";
    private string _valorMostrado = string.Empty;
    private string _ultimoValorNotificado = string.Empty;

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public int Filas { get; set; } = 3;
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>Ver <see cref="CampoTexto"/> — mismo propósito, misma semántica.</summary>
    [Parameter] public EventCallback OnBlur { get; set; }

    private bool TieneError => !string.IsNullOrWhiteSpace(MensajeError);

    /// <summary>Ver CampoTexto.OnParametersSet — mismo motivo y misma guarda.</summary>
    protected override void OnParametersSet()
    {
        if (Valor != _ultimoValorNotificado)
        {
            _valorMostrado = Valor;
            _ultimoValorNotificado = Valor;
        }
    }

    private Task ManejarCambioAsync(ChangeEventArgs e)
    {
        // _valorMostrado no se toca aquí — ver el comentario equivalente en
        // CampoTexto.ManejarCambioAsync: el navegador ya tiene el valor
        // correcto, y reflejarlo de vuelta en cada pulsación es lo que
        // permite que un render en cola bajo latencia lo sobrescriba con
        // una versión más corta.
        var valor = e.Value?.ToString() ?? string.Empty;
        _ultimoValorNotificado = valor;
        return ValorChanged.InvokeAsync(valor);
    }
}
