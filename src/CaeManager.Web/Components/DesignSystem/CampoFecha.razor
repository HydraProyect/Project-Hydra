@using System.Globalization
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Comunes
@inject IServiceProvider Servicios
@inject IJSRuntime JS
@*
    Campo de fecha de TALVEG: se escribe como dd/mm/aaaa (las barras entran solas, ver MascaraFecha) o se elige en el
    calendario del botón contiguo. Enlaza un DateOnly? y solo lo notifica cuando el texto es una fecha entera o está vacío:
    lo tecleado a medias se queda en el campo, nunca vuelve del padre convertido en «» (el defecto del 11-11 en Dividir un
    PDF). Solo vale la fecha entera dd/mm/aaaa (dos cifras de día, dos de mes, cuatro de año; «10/1/2030» no se completa).
    Un texto a medias, imposible (31/02) o sin cifras («mañana» pegado) se queda a la vista, se avisa al salir del campo y
    no mientras se escribe, y se notifica como null (lo que daba el campo nativo) para que el formulario no guarde la
    anterior creyendo que sigue en pantalla. Solo el campo vacío de verdad (borrado a mano) es «sin fecha».
    NoValidoChanged avisa en cada cambio de estado, también antes de salir del campo: todo formulario que guarde lo
    consume y bloquea el envío mientras sea true.
*@
@* Con el calendario abierto, Escape lo cierra a él y no al Drawer o Modal que lo contiene (mismo criterio que
   CampoSelectAvanzado). *@
<div class="campo campo-fecha" @onkeydown:stopPropagation="_abierto">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label id="@IdEtiqueta" for="@_id">@Etiqueta</label>
    }
    <div class="campo-fecha-fila" @ref="_refFila">
        @* @key: mismo criterio que CampoTexto — solo cambia cuando hay que imponer al navegador un texto que Blazor ya
           tenía renderizado (ver MostrarTexto). *@
        <input @key="_generacion"
               @ref="_refInput"
               id="@_id"
               type="text"
               inputmode="numeric"
               autocomplete="off"
               maxlength="10"
               data-campo-fecha
               class="@ClaseInput"
               value="@_valorMostrado"
               placeholder="@(Placeholder ?? Comunes["CampoFechaFormato"])"
               disabled="@Deshabilitado"
               aria-invalid="@(TieneError ? "true" : null)"
               @oninput="AlTeclearAsync"
               @onblur="AlSalirAsync"
               @attributes="AtributosInput" />
        <button type="button"
                class="campo-fecha-boton"
                aria-label="@Comunes["CampoFechaAbrirCalendario"]"
                aria-describedby="@(string.IsNullOrWhiteSpace(Etiqueta) ? null : IdEtiqueta)"
                aria-haspopup="dialog"
                aria-expanded="@(_abierto ? "true" : "false")"
                aria-controls="@IdCalendario"
                disabled="@Deshabilitado"
                data-campo-fecha-boton
                @onclick="AlternarCalendario">
            <Icono Nombre="calendario" Tamano="TamanoIcono.Pequeno" />
        </button>
    </div>
    @if (_abierto)
    {
        <div class="campo-fecha-velo" @onclick="CerrarYVolverAsync"></div>
        <div id="@IdCalendario" @ref="_refCalendario" class="campo-fecha-calendario" role="dialog" aria-modal="false"
             aria-label="@Comunes["CampoFechaCalendario"]" @onkeydown="AlPulsarEnCalendarioAsync">
            <div class="campo-fecha-cabecera">
                <button type="button" class="campo-fecha-mes" aria-label="@Comunes["CampoFechaMesAnterior"]" @onclick="() => CambiarMes(-1)"
                        @onkeydown="AlPulsarEnMesAnteriorAsync">
                    <Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" />
                </button>
                <span id="@IdTitulo" class="campo-fecha-titulo" aria-live="polite">@TituloMes</span>
                <button type="button" class="campo-fecha-mes" aria-label="@Comunes["CampoFechaMesSiguiente"]" @onclick="() => CambiarMes(1)">
                    <Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" />
                </button>
            </div>
            @* Patrón de rejilla de selector de fecha de WAI-ARIA APG: grid > row > columnheader/gridcell, con aria-selected en
               la celda del día elegido; el foco va al botón del día (roving tabindex). WCAG 2.1 AA: 1.3.1 (estructura de
               semanas y días de la semana), 4.1.2 (nombre, función y estado) y 3.3.2 (instrucciones de teclado visibles). *@
            <div class="campo-fecha-rejilla" role="grid" aria-labelledby="@IdTitulo" aria-describedby="@IdInstrucciones"
                 @onkeydown="AlPulsarEnRejillaAsync">
                <div class="campo-fecha-semana" role="row">
                    @foreach (var (corto, largo) in DiasSemana)
                    {
                        <span role="columnheader" aria-label="@largo"><span aria-hidden="true">@corto</span></span>
                    }
                </div>
                @foreach (var semana in Semanas)
                {
                    <div class="campo-fecha-fila-semana" role="row">
                        @foreach (var celda in semana)
                        {
                            if (celda is not { } fecha)
                            {
                                <span class="campo-fecha-hueco" role="gridcell"></span>
                            }
                            else
                            {
                                <span class="campo-fecha-celda" role="gridcell" aria-selected="@(EsElegido(fecha) ? "true" : "false")">
                                    @if (fecha == _diaEnfoco)
                                    {
                                        <button type="button" @ref="_refDia" @attributes="AtributosDia(fecha)" @onclick="() => ElegirAsync(fecha)">@fecha.Day</button>
                                    }
                                    else
                                    {
                                        <button type="button" @attributes="AtributosDia(fecha)" @onclick="() => ElegirAsync(fecha)">@fecha.Day</button>
                                    }
                                </span>
                            }
                        }
                    </div>
                }
            </div>
            <p id="@IdInstrucciones" class="campo-fecha-instrucciones">@Comunes["CampoFechaInstrucciones"]</p>
        </div>
    }
    @if (TieneError)
    {
        <span id="@IdMensajeError" class="campo-mensaje-error" role="alert">@Error</span>
    }
</div>
