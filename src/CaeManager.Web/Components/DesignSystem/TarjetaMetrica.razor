@inject IJSRuntime JS
@{
    var claseTono = Discreta ? "tarjeta-metrica-discreta" : $"tarjeta-metrica-{Tono.ToString().ToLowerInvariant()}";
}
@if (Enlace is not null)
{
    <a href="@Enlace" class="tarjeta-metrica @claseTono tarjeta-metrica-clicable">
        <span class="tarjeta-metrica-etiqueta">@Etiqueta</span>
        <span class="tarjeta-metrica-fila-valor">
            @if (NombreIcono is not null)
            {
                <Icono Nombre="@NombreIcono" Tamano="TamanoIcono.Pequeno" />
            }
            <span class="tarjeta-metrica-valor" @ref="_valor">@Valor</span>
        </span>
        @if (!string.IsNullOrWhiteSpace(Pista))
        {
            <span class="tarjeta-metrica-pista">@Pista</span>
        }
    </a>
}
else
{
    <div class="tarjeta-metrica @claseTono">
        <span class="tarjeta-metrica-etiqueta">@Etiqueta</span>
        <span class="tarjeta-metrica-fila-valor">
            @if (NombreIcono is not null)
            {
                <Icono Nombre="@NombreIcono" Tamano="TamanoIcono.Pequeno" />
            }
            <span class="tarjeta-metrica-valor" @ref="_valor">@Valor</span>
        </span>
        @if (!string.IsNullOrWhiteSpace(Pista))
        {
            <span class="tarjeta-metrica-pista">@Pista</span>
        }
    </div>
}

@code {
    private ElementReference _valor;
    private bool _contada;

    [Parameter] public string Etiqueta { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public TonoBadge Tono { get; set; } = TonoBadge.Neutro;

    /// <summary>
    /// Nombre del icono del catálogo (Icono.razor), opcional. La iconografía
    /// es obligatoria en superficies de resumen (02 § 7, DDL-036): sin ella,
    /// un número de color sobre fondo blanco lee como una hoja de cálculo.
    /// Ausente en usos donde el llamador no la ha decidido todavía (p. ej.
    /// los KPI discretos de Empresa/Centro/Trabajador) — no se inventa aquí,
    /// se deja sin icono en vez de forzar uno arbitrario.
    /// </summary>
    [Parameter] public string? NombreIcono { get; set; }

    /// <summary>
    /// Si se informa, la tarjeta se renderiza como enlace a esa ruta (p. ej.
    /// los KPI del Dashboard llevando a la lista filtrada correspondiente).
    /// Ausente en el resto de usos (resúmenes de importación), donde no
    /// tiene sentido que sea clicable.
    /// </summary>
    [Parameter] public string? Enlace { get; set; }

    /// <summary>
    /// Tercera línea, opcional, en tono atenuado — contexto del valor
    /// principal (p. ej. "12 nuevos este mes", "2 centros bloqueados").
    /// Ausente cuando el llamador no tiene un dato real que ofrecer: no se
    /// rellena con una frase vacía solo por completar la tarjeta.
    /// </summary>
    [Parameter] public string? Pista { get; set; }

    /// <summary>
    /// Variante de menor peso visual (sin degradado, sin borde de color, valor
    /// más pequeño) para KPIs informativos que no requieren atención — evita
    /// que todo el Dashboard compita con el mismo peso visual (ver
    /// Project-Hydra-Negocio/tecnico/docs/archive/design/DESIGN_SYSTEM.md, jerarquía Dashboard). El tono semántico (borde de
    /// color) se reserva así para los KPIs que sí son una señal de estado.
    /// </summary>
    [Parameter] public bool Discreta { get; set; }

    /// <summary>
    /// La cifra cuenta desde 0 hasta su valor, una sola vez, al primer pintado (ficha 09). Solo para el dashboard: un refresco que
    /// cambie el valor no vuelve a animar. Sin efecto si <see cref="Valor"/> no es un entero o con movimiento reducido.
    /// </summary>
    [Parameter] public bool ContarHastaValor { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _contada || !ContarHastaValor || !int.TryParse(Valor, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var final))
            return;

        _contada = true;

        // Mejor esfuerzo, como el foco de DrawerFormulario: sin módulo JS (tests de componente, circuito cerrándose) la tarjeta
        // enseña el valor final y nada más.
        try
        {
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/contar-cifra.js");
            if (modulo is null) return;

            await using (modulo)
            {
                await modulo.InvokeAsync<bool>("contarHasta", _valor, final);
            }
        }
        catch (Exception)
        {
        }
    }
}
