@* Selector con búsqueda que, a diferencia de CampoBuscarSelect (que usa
   <datalist> y por tanto no admite una fila de acción propia), sabe ofrecer
   "+ Crear «texto»" cuando la búsqueda no encuentra nada — el hueco entre
   "crear una entidad" y "elegir una ya existente" que hoy obliga a
   abandonar la pantalla (Fase A4). Combobox ARIA sin JS interop: las filas
   usan @@onmousedown:preventDefault para que el input nunca pierda el foco
   al hacer clic en una opción — el mismo motivo por el que Drawer.razor
   distingue mousedown de click, sin necesitar temporizadores. *@
<div class="campo">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label for="@_id">@Etiqueta</label>
    }
    <div class="selector-entidad-envoltorio">
        <input id="@_id"
               type="text"
               class="campo-input"
               role="combobox"
               aria-expanded="@(_abierto ? "true" : "false")"
               aria-controls="@_listaId"
               aria-autocomplete="list"
               aria-activedescendant="@IdOpcionResaltada"
               autocomplete="off"
               value="@_filtro"
               placeholder="@Placeholder"
               disabled="@Deshabilitado"
               @oninput="ManejarEntradaAsync"
               @onfocus="AbrirAsync"
               @onblur="CerrarAsync"
               @onkeydown="ManejarTeclaAsync" />

        @if (_abierto && (FilasFiltradas.Count > 0 || MostrarFilaCrear))
        {
            <ul id="@_listaId" class="selector-entidad-lista" role="listbox">
                @{ var indice = 0; }
                @foreach (var opcion in FilasFiltradas)
                {
                    var indiceFila = indice++;
                    <li id="@IdOpcion(opcion.Id)" role="option"
                        aria-selected="@(indiceFila == _indiceResaltado ? "true" : "false")"
                        class="selector-entidad-opcion @(indiceFila == _indiceResaltado ? "selector-entidad-opcion-resaltada" : "")"
                        @onmousedown:preventDefault="true"
                        @onclick="() => SeleccionarOpcionAsync(opcion)">
                        @opcion.Texto
                    </li>
                }
                @if (MostrarFilaCrear)
                {
                    var indiceFilaCrear = indice;
                    <li id="@IdOpcionCrear" role="option"
                        aria-selected="@(indiceFilaCrear == _indiceResaltado ? "true" : "false")"
                        class="selector-entidad-opcion selector-entidad-opcion-crear @(indiceFilaCrear == _indiceResaltado ? "selector-entidad-opcion-resaltada" : "")"
                        @onmousedown:preventDefault="true"
                        @onclick="SolicitarCreacionAsync">
                        @string.Format(TextoCrear, _filtro.Trim())
                    </li>
                }
            </ul>
        }
    </div>
    @if (TieneError)
    {
        <span class="campo-mensaje-error" role="alert">@MensajeError</span>
    }
</div>

@code {
    private const int MaximoOpcionesVisibles = 8;

    private readonly string _id = $"selector-entidad-{Guid.NewGuid():N}";
    private readonly string _listaId = $"selector-entidad-lista-{Guid.NewGuid():N}";

    private string _filtro = string.Empty;
    private string _ultimoValorNotificado = string.Empty;
    private bool _abierto;
    // Solo el usuario vacía la selección: borrar el texto a mano. Un campo vacío porque las opciones no llegaron (catálogo
    // que no cargó) no la vacía al salir.
    private bool _vaciadoPorUsuario;
    private int _indiceResaltado = -1;

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<OpcionBuscable> Opciones { get; set; } = [];
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>Si se ofrece "+ Crear «texto»" cuando lo escrito no coincide con ninguna opción.</summary>
    [Parameter] public bool PermiteCrear { get; set; }

    /// <summary>Plantilla de la fila de creación — <c>{0}</c> se sustituye por el texto escrito.</summary>
    [Parameter] public string TextoCrear { get; set; } = "+ Crear «{0}»";

    [Parameter] public EventCallback<string> OnCrearSolicitado { get; set; }

    /// <summary>
    /// Si borrar el texto y salir del campo deja el valor sin elegir (<c>ValorChanged("")</c>). Sin él (por defecto) el
    /// campo siempre vuelve al texto de la opción elegida, que es lo que quiere un selector obligatorio. Solo cuenta un
    /// borrado del usuario: salir de un campo que se ve vacío porque sus opciones no llegaron no toca el valor.
    /// </summary>
    [Parameter] public bool PermiteVaciar { get; set; }

    private bool TieneError => !string.IsNullOrWhiteSpace(MensajeError);

    private string? IdOpcionResaltada
    {
        get
        {
            if (!_abierto || _indiceResaltado < 0) return null;
            if (_indiceResaltado < FilasFiltradas.Count) return IdOpcion(FilasFiltradas[_indiceResaltado].Id);
            return _indiceResaltado == FilasFiltradas.Count && MostrarFilaCrear ? IdOpcionCrear : null;
        }
    }

    private string IdOpcion(string id) => $"{_listaId}-opcion-{id}";
    private string IdOpcionCrear => $"{_listaId}-opcion-crear";

    private IReadOnlyList<OpcionBuscable> FilasFiltradas
    {
        get
        {
            var filtro = _filtro.Trim();
            var coincidencias = filtro.Length == 0
                ? Opciones
                : Opciones.Where(o => o.Texto.Contains(filtro, StringComparison.OrdinalIgnoreCase)).ToList();

            return coincidencias.Take(MaximoOpcionesVisibles).ToList();
        }
    }

    /// <summary>Coincidencia exacta: si lo escrito ya nombra una opción tal cual, no tiene sentido ofrecer crearla de nuevo.</summary>
    private bool MostrarFilaCrear =>
        PermiteCrear && _filtro.Trim().Length > 0 &&
        !Opciones.Any(o => string.Equals(o.Texto, _filtro.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Igual que CampoBuscarSelect: solo se resincroniza el texto visible con el Id recibido cuando ese Id no vino de nuestro propio evento.</summary>
    protected override void OnParametersSet()
    {
        // Deshabilitado con la lista abierta: el blur ya no se atiende, así que se cierra aquí.
        if (Deshabilitado) { _abierto = false; _indiceResaltado = -1; }
        var textoDelValor = Opciones.FirstOrDefault(o => o.Id == Valor)?.Texto;
        if (Valor == _ultimoValorNotificado)
        {
            // Las opciones pueden llegar después del valor (un catálogo que se carga al abrir): se completa el texto.
            if (!_abierto && _filtro.Length == 0 && textoDelValor is not null)
                _filtro = textoDelValor;
            return;
        }

        _ultimoValorNotificado = Valor;
        _filtro = textoDelValor ?? string.Empty;
    }

    private Task ManejarEntradaAsync(ChangeEventArgs e)
    {
        if (Deshabilitado) return Task.CompletedTask;
        _filtro = e.Value?.ToString() ?? string.Empty;
        _vaciadoPorUsuario = _filtro.Trim().Length == 0;
        _abierto = true;
        _indiceResaltado = -1;
        return Task.CompletedTask;
    }

    private Task AbrirAsync()
    {
        if (Deshabilitado) return Task.CompletedTask;
        _abierto = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// No hace falta distinguir "perdió el foco por elegir una opción" de
    /// "perdió el foco por cualquier otro motivo": las opciones usan
    /// @@onmousedown:preventDefault, así que el input nunca llega a perder el
    /// foco al hacer clic en ellas — este blur solo ocurre para el resto de
    /// casos (Tab, clic fuera), donde cerrar y resincronizar es lo correcto.
    /// </summary>
    private async Task CerrarAsync()
    {
        if (Deshabilitado) return;
        _abierto = false;
        _indiceResaltado = -1;

        // Quitar la selección: con PermiteVaciar, salir del campo después de borrar el texto a mano la deja sin elegir.
        var vaciar = PermiteVaciar && _vaciadoPorUsuario && _filtro.Trim().Length == 0 && Valor.Length > 0;
        _vaciadoPorUsuario = false;
        if (vaciar)
        {
            _ultimoValorNotificado = string.Empty;
            await ValorChanged.InvokeAsync(string.Empty);
            return;
        }

        _filtro = Opciones.FirstOrDefault(o => o.Id == Valor)?.Texto ?? string.Empty;
    }

    private async Task SeleccionarOpcionAsync(OpcionBuscable opcion)
    {
        if (Deshabilitado) return;
        _filtro = opcion.Texto;
        _vaciadoPorUsuario = false;
        _ultimoValorNotificado = opcion.Id;
        _abierto = false;
        _indiceResaltado = -1;
        await ValorChanged.InvokeAsync(opcion.Id);
    }

    private async Task SolicitarCreacionAsync()
    {
        if (Deshabilitado) return;
        var texto = _filtro.Trim();
        _abierto = false;
        _indiceResaltado = -1;
        await OnCrearSolicitado.InvokeAsync(texto);
    }

    private async Task ManejarTeclaAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (Deshabilitado) return;
        var totalFilas = FilasFiltradas.Count + (MostrarFilaCrear ? 1 : 0);

        switch (e.Key)
        {
            case "ArrowDown":
                _abierto = true;
                if (totalFilas > 0)
                    _indiceResaltado = Math.Min(_indiceResaltado + 1, totalFilas - 1);
                break;

            case "ArrowUp":
                if (totalFilas > 0)
                    _indiceResaltado = Math.Max(_indiceResaltado - 1, 0);
                break;

            case "Escape":
                _abierto = false;
                _indiceResaltado = -1;
                _vaciadoPorUsuario = false;
                _filtro = Opciones.FirstOrDefault(o => o.Id == Valor)?.Texto ?? string.Empty;
                break;

            case "Enter":
                if (_abierto && _indiceResaltado >= 0 && _indiceResaltado < totalFilas)
                {
                    if (_indiceResaltado < FilasFiltradas.Count)
                        await SeleccionarOpcionAsync(FilasFiltradas[_indiceResaltado]);
                    else
                        await SolicitarCreacionAsync();
                }
                break;
        }
    }
}
