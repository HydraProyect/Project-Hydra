@*
    Kit de formulario en Drawer (S12, lote 1): cabecera, cuerpo, aviso, pie y guardián en un solo sitio.

    Un formulario de creación o edición de un agregado simple en un Drawer (patrón «Crear» de UX_PATTERNS) es este
    componente más sus campos. Lo que una pantalla ya no escribe, y por tanto no puede escribir mal:
      - el guardián: HayCambios es obligatorio (EditorRequired; con -warnaserror su falta es un error de compilación,
        RZ2012). La X, Escape, el fondo y «Cancelar» preguntan «¿Descartar cambios?» y salir por la aplicación, también
        (AvisoCambiosSinGuardar va dentro; D-05, D-20);
      - «Cancelar»: es siempre el secundario del pie y sale por SolicitarCierreAsync, como la X (D-05);
      - «Guardar»: es el único primario, con el estado Guardando (spinner, sin doble clic; D-30). Solo se puede deshabilitar
        dando el motivo (MotivoGuardarDeshabilitado, que sale como title): un botón mudo no se puede escribir (D-02, D-06);
      - el aviso del formulario: AvisoFormulario fuera del cuerpo desplazable, siempre a la vista (D-20), y tras un
        «Guardar» que deja errores por campo el foco va al primero (D-20);
      - no cerrar con un clic fuera ni con Escape mientras se guarda o hay un error visible.
    Lo que sigue siendo de cada pantalla: sus campos y su validación, su estado (Guardando, MensajeError,
    HayErroresDeCampo), HayCambios (normalmente InstantaneaFormulario) y el comando que guarda.

    No cubre: el diálogo de confirmación, los formularios en Modal ni a página completa, ni los de varias secciones
    o pasos (esos son página). Una acción secundaria que no cierra («Añadir otro…») va en PieExtra.
*@
@inject IJSRuntime JS

<Drawer @ref="_drawer" Visible="Visible" VisibleChanged="VisibleChanged" Titulo="@Titulo" HayCambios="HayCambios"
        CerrarAlHacerClicFuera="@(!Guardando && string.IsNullOrWhiteSpace(MensajeError) && !HayErroresDeCampo)"
        Aviso="@(string.IsNullOrWhiteSpace(MensajeError) ? null : AvisoRender)">
    <ChildContent>
        <div class="formulario-drawer-contenido" @ref="_contenido">
            @ChildContent
        </div>
    </ChildContent>
    <Pie>
        <Boton Variante="VarianteBoton.Secundario" Deshabilitado="Guardando" OnClick="CancelarAsync">
            @TextoCancelar
        </Boton>
        @if (PieExtra is not null)
        {
            @* Mientras se guarda, las acciones extra se deshabilitan solas (fieldset): la pantalla no puede olvidarlo. *@
            <fieldset class="formulario-drawer-pie-extra" disabled="@Guardando">@PieExtra</fieldset>
        }
        <Boton Variante="VarianteBoton.Primario" Cargando="Guardando" Deshabilitado="TieneMotivoDeshabilitado"
               title="@MotivoGuardarDeshabilitado" OnClick="GuardarAsync">
            @TextoGuardar
        </Boton>
    </Pie>
</Drawer>

<AvisoCambiosSinGuardar HayCambios="() => Visible && HayCambios()" AlDescartar="DescartarPorNavegacionAsync" />

@code {
    private Drawer? _drawer;
    private ElementReference _contenido;
    private bool _enfocarTrasGuardar;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;

    /// <summary>
    /// Obligatorio: si el formulario tiene algo que se perdería al cerrar o salir. Una instantánea de los campos al abrir
    /// (<see cref="InstantaneaFormulario"/>) es lo habitual.
    /// </summary>
    [Parameter, EditorRequired] public Func<bool> HayCambios { get; set; } = () => false;

    /// <summary>Se está guardando: «Cancelar» se deshabilita, «Guardar» muestra el spinner y no se cierra por fuera.</summary>
    [Parameter] public bool Guardando { get; set; }

    /// <summary>Error del formulario entero (servidor, regla de negocio, empleador sin elegir): se ve fuera del cuerpo desplazable.</summary>
    [Parameter] public string? MensajeError { get; set; }

    /// <summary>Hay errores por campo (los pintan los propios campos): bloquea el cierre por fuera y recibe el foco tras guardar.</summary>
    [Parameter] public bool HayErroresDeCampo { get; set; }

    /// <summary>
    /// Deshabilita «Guardar» y dice por qué (title del botón). Un «Guardar» deshabilitado sin motivo no existe: D-02 y D-06 eran
    /// un primario mudo. Vacío o nulo, «Guardar» está habilitado.
    /// </summary>
    [Parameter] public string? MotivoGuardarDeshabilitado { get; set; }

    [Parameter, EditorRequired] public string TextoGuardar { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string TextoCancelar { get; set; } = string.Empty;
    [Parameter] public EventCallback OnGuardar { get; set; }

    /// <summary>
    /// Acciones secundarias que no cierran (p. ej. «Añadir otro centro»), entre «Cancelar» y «Guardar». Se deshabilitan solas
    /// mientras <see cref="Guardando"/>; el spinner de la acción en curso sigue siendo cosa de la pantalla (Cargando del Boton).
    /// </summary>
    [Parameter] public RenderFragment? PieExtra { get; set; }

    /// <summary>Tras «Salir y descartar» del aviso de navegación, además de cerrar el drawer.</summary>
    [Parameter] public EventCallback AlDescartarPorNavegacion { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool TieneMotivoDeshabilitado => !string.IsNullOrWhiteSpace(MotivoGuardarDeshabilitado);

    private bool _guardandoPrevio;

    protected override void OnParametersSet()
    {
        // Un ciclo de guardado de la pantalla (también el de una acción de PieExtra, que no pasa por OnGuardar) que termina con
        // errores de campo lleva el foco al primero.
        if (_guardandoPrevio && !Guardando)
            _enfocarTrasGuardar = true;
        _guardandoPrevio = Guardando;
    }

    private RenderFragment AvisoRender => builder =>
    {
        builder.OpenComponent<AvisoFormulario>(0);
        builder.AddAttribute(1, nameof(AvisoFormulario.Mensaje), MensajeError);
        builder.CloseComponent();
    };

    private Task CancelarAsync() => _drawer is { } drawer ? drawer.SolicitarCierreAsync() : VisibleChanged.InvokeAsync(false);

    private bool _guardadoEnCurso;

    private async Task GuardarAsync()
    {
        // Guarda de doble clic en el kit: un segundo «Guardar» antes de que el botón se pinte deshabilitado daría de alta el mismo
        // registro dos veces. Antes lo escribía cada pantalla (`if (_guardando) return;`) o no lo escribía.
        if (_guardadoEnCurso || Guardando) return;
        _guardadoEnCurso = true;
        try
        {
            await OnGuardar.InvokeAsync();
        }
        finally
        {
            _guardadoEnCurso = false;
        }

        _enfocarTrasGuardar = true;
        StateHasChanged();
    }

    private async Task DescartarPorNavegacionAsync()
    {
        await VisibleChanged.InvokeAsync(false);
        await AlDescartarPorNavegacion.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_enfocarTrasGuardar) return;
        _enfocarTrasGuardar = false;

        if (!Visible || !HayErroresDeCampo) return;

        // Mejor esfuerzo, como el focus trap del Drawer: sin módulo JS (tests de componente, circuito cerrándose) el formulario
        // sigue siendo usable, solo sin el salto al primer error.
        try
        {
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/formulario-foco.js");
            if (modulo is null) return;

            await using (modulo)
            {
                await modulo.InvokeVoidAsync("enfocarPrimerError", _contenido);
            }
        }
        catch (Exception)
        {
        }
    }
}
