@*
    Aviso de error de un formulario (S9/S12). Un solo marcado para lo que 66 sitios escribían a mano:
    <div class="alerta-formulario" role="alert">. Sin mensaje no pinta nada.

    Dentro de DrawerFormulario va en la ranura Aviso del Drawer, fuera del cuerpo desplazable, para que se vea
    aunque el formulario esté desplazado (D-20). En cualquier otro contenedor basta con ponerlo al principio.
*@
@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    if (EnPanel)
    {
        @* Sin espacios entre el icono y el texto: el TextContent del aviso es exactamente el mensaje. *@
        <div class="alerta-formulario alerta-formulario-panel" role="alert"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v4" /><path d="M12 16h.01" /><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z" /></svg><span>@Mensaje</span></div>
    }
    else
    {
        <div class="alerta-formulario" role="alert">@Mensaje</div>
    }
}

@code {
    [Parameter] public string? Mensaje { get; set; }

    /// <summary>Variante del panel lateral (la pinta DrawerFormulario): caja con borde, icono y texto de cuerpo.</summary>
    [Parameter] public bool EnPanel { get; set; }
}
