@*
    Patrón estándar de creación/edición para un único agregado simple
    (ver Project-Hydra-Negocio/tecnico/docs/archive/design/UX_PATTERNS.md, "Crear"). Para formularios con varias secciones
    (p. ej. Trabajador con documentos y asignaciones) se usa página completa
    en su lugar, no este componente.
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Visible)
{
    <div class="drawer-superposicion" @onmousedown="() => _mouseDownEnSuperposicion = true" @onclick="ManejarClicSuperposicionAsync">
        <div class="drawer-panel" @onmousedown="() => _mouseDownEnSuperposicion = false" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="@_tituloId" tabindex="-1" @ref="_referenciaContenedor" @onkeydown="ManejarTeclaAsync">
            <div class="drawer-header">
                <h2 id="@_tituloId">@Titulo</h2>
                <button type="button" class="drawer-cerrar" aria-label="Cerrar" @onclick="SolicitarCierreAsync"><Icono Nombre="cerrar" /></button>
            </div>
            <div class="drawer-cuerpo">
                @ChildContent
            </div>
            @if (Pie is not null)
            {
                <div class="drawer-pie">@Pie</div>
            }
        </div>
    </div>

    @if (_confirmandoDescarte)
    {
        <ConfirmarDescartarCambios AlSeguir="SeguirEditando" AlDescartar="DescartarYCerrarAsync" />
    }
}

@code {
    private readonly string _tituloId = $"drawer-titulo-{Guid.NewGuid():N}";
    private ElementReference _referenciaContenedor;
    private IJSObjectReference? _trampaFoco;
    private bool _previoVisible;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Pie { get; set; }

    /// <summary>
    /// En false mientras hay un error de validación visible o se está
    /// guardando — evita que un clic fuera del panel (p. ej. al mover el
    /// cursor hacia un campo tras un error) cierre el formulario y se
    /// pierda lo que el usuario ya había escrito.
    /// </summary>
    [Parameter] public bool CerrarAlHacerClicFuera { get; set; } = true;

    /// <summary>
    /// True solo si el mousedown que originó el click en curso empezó en la
    /// superposición (no en el panel). Evita cerrar el drawer cuando el
    /// usuario selecciona texto arrastrando desde dentro del panel y suelta
    /// el clic fuera — el evento "click" del navegador se dispara igualmente
    /// sobre la superposición en ese caso, aunque el gesto no fuera un
    /// verdadero "clic fuera".
    /// </summary>
    private bool _mouseDownEnSuperposicion;

    /// <summary>
    /// Focus trap + retorno de foco (hallazgo P0-8 de
    /// Project-Hydra-Negocio/MATURITY_REVIEW.md). Ver el comentario equivalente en
    /// Modal.razor — mismo mecanismo, mismo módulo JS.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_previoVisible)
            await ActivarTrampaFocoAsync();
        else if (!Visible && _previoVisible)
            await LiberarTrampaFocoAsync();

        _previoVisible = Visible;
    }

    /// <summary>
    /// Mejor esfuerzo — ver el comentario equivalente en Modal.razor: sin
    /// módulo JS disponible (tests de componente, circuito cerrándose) el
    /// drawer sigue siendo usable, solo sin el focus trap.
    /// </summary>
    private async Task ActivarTrampaFocoAsync()
    {
        try
        {
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialogo-foco.js");
            if (modulo is null) return;

            await using (modulo)
            {
                _trampaFoco = await modulo.InvokeAsync<IJSObjectReference>("atraparFoco", _referenciaContenedor);
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task CerrarAsync() => await VisibleChanged.InvokeAsync(false);

    /// <summary>
    /// P1-E2b: si el formulario de dentro tiene algo que se perdería al cerrar. Se consulta
    /// al pedir el cierre con la X, Escape o un clic en el fondo; con <c>true</c>, antes de
    /// cerrar se pregunta «¿Descartar cambios?» (ConfirmarDescartarCambios). Los botones del
    /// propio formulario («Cancelar», «Guardar») no pasan por aquí: son decisión explícita.
    /// Es la misma función que el formulario pasa a AvisoCambiosSinGuardar.
    /// </summary>
    [Parameter] public Func<bool>? HayCambios { get; set; }

    private bool _confirmandoDescarte;

    private Task SolicitarCierreAsync()
    {
        if (HayCambios?.Invoke() == true)
        {
            _confirmandoDescarte = true;
            return Task.CompletedTask;
        }

        return CerrarAsync();
    }

    private void SeguirEditando() => _confirmandoDescarte = false;

    protected override void OnParametersSet()
    {
        // Cerrado desde fuera mientras preguntaba (p. ej. terminó un guardado): la
        // pregunta no puede reaparecer sola al volver a abrirlo.
        if (!Visible)
            _confirmandoDescarte = false;
    }

    private Task DescartarYCerrarAsync()
    {
        _confirmandoDescarte = false;
        return CerrarAsync();
    }

    private Task ManejarClicSuperposicionAsync() =>
        CerrarAlHacerClicFuera && _mouseDownEnSuperposicion ? SolicitarCierreAsync() : Task.CompletedTask;

    /// <summary>Mismo guard de trabajo sin guardar que el clic fuera — ver CerrarAlHacerClicFuera.</summary>
    private Task ManejarTeclaAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" && CerrarAlHacerClicFuera ? SolicitarCierreAsync() : Task.CompletedTask;

    private async Task LiberarTrampaFocoAsync()
    {
        if (_trampaFoco is null) return;

        var trampa = _trampaFoco;
        _trampaFoco = null;

        try
        {
            // DisposeAsync de un IJSObjectReference también hace interop — si
            // el circuito se cerró entre esta llamada y la anterior, también
            // puede lanzar. Ambas van en el mismo try: ver el comentario
            // equivalente en Modal.razor.
            await trampa.InvokeVoidAsync("dispose");
            await trampa.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync() => await LiberarTrampaFocoAsync();
}
