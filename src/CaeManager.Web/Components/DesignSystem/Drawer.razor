@*
    Patrón estándar de creación/edición para un único agregado simple
    (ver UX_PATTERNS.md, "Crear"). Para formularios con varias secciones
    (p. ej. Trabajador con documentos y asignaciones) se usa página completa
    en su lugar, no este componente.
*@
@if (Visible)
{
    <div class="drawer-superposicion" @onmousedown="() => _mouseDownEnSuperposicion = true" @onclick="ManejarClicSuperposicionAsync">
        <div class="drawer-panel" @onmousedown="() => _mouseDownEnSuperposicion = false" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="@_tituloId">
            <div class="drawer-header">
                <h2 id="@_tituloId">@Titulo</h2>
                <button type="button" class="drawer-cerrar" aria-label="Cerrar" @onclick="CerrarAsync">×</button>
            </div>
            <div class="drawer-cuerpo">
                @ChildContent
            </div>
            @if (Pie is not null)
            {
                <div class="drawer-pie">@Pie</div>
            }
        </div>
    </div>
}

@code {
    private readonly string _tituloId = $"drawer-titulo-{Guid.NewGuid():N}";

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Pie { get; set; }

    /// <summary>
    /// En false mientras hay un error de validación visible o se está
    /// guardando — evita que un clic fuera del panel (p. ej. al mover el
    /// cursor hacia un campo tras un error) cierre el formulario y se
    /// pierda lo que el usuario ya había escrito.
    /// </summary>
    [Parameter] public bool CerrarAlHacerClicFuera { get; set; } = true;

    /// <summary>
    /// True solo si el mousedown que originó el click en curso empezó en la
    /// superposición (no en el panel). Evita cerrar el drawer cuando el
    /// usuario selecciona texto arrastrando desde dentro del panel y suelta
    /// el clic fuera — el evento "click" del navegador se dispara igualmente
    /// sobre la superposición en ese caso, aunque el gesto no fuera un
    /// verdadero "clic fuera".
    /// </summary>
    private bool _mouseDownEnSuperposicion;

    private Task CerrarAsync() => VisibleChanged.InvokeAsync(false);

    private Task ManejarClicSuperposicionAsync() =>
        CerrarAlHacerClicFuera && _mouseDownEnSuperposicion ? CerrarAsync() : Task.CompletedTask;
}
