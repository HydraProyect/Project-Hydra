@*
    Lista desplegable del kit con popover propio (patrón combobox/listbox de WAI-ARIA): sustituye al
    <select> nativo cuando la lista es larga, necesita búsqueda o cada opción lleva una descripción.
    Hermano de CampoSelect, no su evolución: CampoSelect recibe <option> como contenido y se queda
    donde el envío nativo del formulario manda (data-enviar-al-cambiar); este recibe datos
    (OpcionSelect), porque la búsqueda, la descripción y el punto de color necesitan leerlos. Los grupos
    (OpcionSelect.Grupo) hacen de optgroup: role="group" con su rótulo, y el filtro esconde los que vacía.

    Teclado y estado viven en C# (se prueban con bUnit); el JS (campo-select-avanzado.js) solo hace lo
    que Blazor no puede: preventDefault condicional de las teclas de navegación, anclar el panel a la
    capa superior del navegador (así un Drawer o Modal con overflow no lo recorta), voltearlo si no
    cabe debajo, y devolver el foco al disparador al cerrar solo si no se ha ido ya a otro control
    (#2194). Sin JS el panel cae a posición absoluta bajo el disparador y sigue siendo usable.

    Formularios: con Name pinta un <input type="hidden"> con el valor, así que un POST nativo lo envía
    como un select. Lo que NO replica es el envío al cambiar de data-enviar-al-cambiar (SelectorIdioma y
    compañía): esos se quedan con select nativo.
*@
@using System.Globalization
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<TextosComunes> Comunes

<div class="@ClaseRaiz" @ref="_raiz" data-abierto="@(_abierto ? "true" : "false")" @onkeydown:stopPropagation="_abierto">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label id="@_idEtiqueta" for="@IdCampo">@Etiqueta</label>
    }
    @if (Multiple && Elegidos.Count > 0)
    {
        <div class="csa-chips" role="list">
            @foreach (var elegido in Elegidos)
            {
                <span class="csa-chip" role="listitem">
                    @TextoDe(elegido)
                    <button type="button" class="csa-chip-quitar" aria-label="@string.Format(Comunes["SelectorQuitarElegido"].Value, TextoDe(elegido))"
                            disabled="@Deshabilitado" @onclick="() => QuitarAsync(elegido)"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
                </span>
            }
        </div>
    }
    <button type="button" id="@IdCampo" class="csa-disparador" @ref="_disparador"
            role="combobox" aria-haspopup="listbox" aria-expanded="@(_abierto ? "true" : "false")"
            aria-controls="@_idLista" aria-activedescendant="@(_abierto && !EsBuscable ? IdActivo : null)"
            aria-label="@(string.IsNullOrWhiteSpace(Etiqueta) ? EtiquetaAccesible : null)"
            disabled="@Deshabilitado" @onclick="Alternar" @onkeydown="e => ManejarTeclaAsync(e, false)">
        @if (Actual?.Tono is { } tonoActual)
        {
            <span class="@ClasePunto(tonoActual)" aria-hidden="true"></span>
        }
        <span class="@(Actual is null ? "csa-valor csa-marcador" : "csa-valor")">@(Actual?.Texto ?? TextoMarcador)</span>
        <Icono Nombre="chevron" Tamano="TamanoIcono.Pequeno" />
    </button>
    @if (!string.IsNullOrEmpty(Name))
    {
        @if (Multiple)
        {
            @foreach (var elegido in Elegidos)
            {
                <input type="hidden" name="@Name" value="@elegido" />
            }
        }
        else
        {
            <input type="hidden" name="@Name" value="@Valor" />
        }
    }
    @if (_abierto)
    {
        <div class="csa-superposicion" @onclick="CerrarSinFoco"></div>
        <div class="csa-panel" @ref="_panel" @onclick:stopPropagation="true">
            @if (EsBuscable)
            {
                <div class="csa-buscador-caja">
                    <Icono Nombre="buscar" Tamano="TamanoIcono.Pequeno" />
                    <input type="text" class="csa-buscador" @ref="_buscador"
                           role="combobox" aria-expanded="true" aria-autocomplete="list" aria-controls="@_idLista"
                           aria-activedescendant="@IdActivo" aria-label="@Comunes["SelectorBuscarEtiqueta"]"
                           placeholder="@Comunes["SelectorBuscarMarcador"]" autocomplete="off" value="@_consultaSembrada"
                           @oninput="AlEscribir" @onkeydown="e => ManejarTeclaAsync(e, true)" />
                </div>
            }
            <ul id="@_idLista" class="csa-lista" role="listbox" tabindex="-1"
                aria-labelledby="@(string.IsNullOrWhiteSpace(Etiqueta) ? null : _idEtiqueta)"
                aria-label="@(string.IsNullOrWhiteSpace(Etiqueta) ? EtiquetaAccesible : null)">
                @{
                    // Una fila de opción; la pintan igual la lista plana y la agrupada (context = posición en _visibles).
                    RenderFragment<int> FilaOpcion = posicion =>
                        @<li id="@IdOpcion(_visibles[posicion])" role="option" data-valor="@OpcionEn(posicion).Valor"
                             aria-selected="@(EsElegida(posicion) ? "true" : "false")"
                             aria-disabled="@(OpcionEn(posicion).Deshabilitada ? "true" : null)"
                             class="@ClaseOpcion(posicion, EsElegida(posicion), OpcionEn(posicion).Deshabilitada)"
                             @onclick="() => ElegirAsync(posicion)">
                            @if (OpcionEn(posicion).Tono is { } tono)
                            {
                                <span class="@ClasePunto(tono)" aria-hidden="true"></span>
                            }
                            <span class="csa-texto">
                                @(OpcionEn(posicion).Texto)
                                @if (!string.IsNullOrWhiteSpace(OpcionEn(posicion).Descripcion))
                                {
                                    <small class="csa-descripcion">@(OpcionEn(posicion).Descripcion)</small>
                                }
                            </span>
                            <span class="csa-marca" aria-hidden="true">
                                @if (EsElegida(posicion))
                                {
                                    <Icono Nombre="check" Tamano="TamanoIcono.Pequeno" />
                                }
                            </span>
                        </li>;
                }
                @if (HayGrupos)
                {
                    @foreach (var (numero, tramo) in TramosPorGrupo().Index())
                    {
                        <li role="group" class="csa-grupo" aria-labelledby="@IdGrupo(numero)">
                            <div id="@IdGrupo(numero)" class="csa-grupo-rotulo">@tramo.Rotulo</div>
                            <ul role="none" class="csa-grupo-lista">
                                @foreach (var posicion in tramo.Posiciones)
                                {
                                    @FilaOpcion(posicion)
                                }
                            </ul>
                        </li>
                    }
                }
                else
                {
                    @foreach (var posicion in Enumerable.Range(0, _visibles.Count))
                    {
                        @FilaOpcion(posicion)
                    }
                }
                @if (MostrarCrear)
                {
                    <li id="@IdCrear" role="option" aria-selected="false" class="@(_activo == _visibles.Count ? "csa-crear csa-activa" : "csa-crear")"
                        @onclick="CrearAsync">
                        <span class="csa-crear-mas" aria-hidden="true"></span>
                        <span class="csa-texto">@TextoFilaCrear</span>
                    </li>
                }
            </ul>
            @if (_visibles.Count == 0)
            {
                <p class="csa-vacio">@(TextoSinResultados ?? Comunes["SelectorSinResultados"].Value)</p>
            }
            @if (EsBuscable)
            {
                <span class="csa-anuncio" role="@(HayBusqueda ? "status" : null)">@AnuncioResultados</span>
            }
        </div>
    }
</div>

@code {
    /// <summary>Con pocas opciones el buscador sobra: se enseña a partir de este número si <see cref="Buscable"/> no lo fija.</summary>
    internal const int UmbralBuscador = 8;

    /// <summary>Pausa tras la que la escritura rápida (typeahead) vuelve a empezar de cero.</summary>
    private const long MsReinicioEscritura = 700;

    private static readonly CompareOptions SinMayusculasNiTildes = CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace;

    private readonly string _idAuto = $"campo-select-avanzado-{Guid.NewGuid():N}";
    private readonly List<int> _visibles = [];
    private ElementReference _raiz;
    private ElementReference _disparador;
    private ElementReference _panel;
    private ElementReference _buscador;
    private IJSObjectReference? _modulo;
    private IJSObjectReference? _control;
    private bool _abierto;
    private bool _anclarPendiente;
    private bool _enfocarBuscadorPendiente;
    private bool _devolverFocoPendiente;
    private bool _desplazarPendiente;
    private bool _anclado;
    private bool _desechado;
    private string _consulta = string.Empty;

    // Lo que el servidor escribe en el buscador: solo cambia cuando la búsqueda se siembra desde fuera del input
    // (teclear sobre el disparador). Lo que el usuario escribe en el input no lo toca, así un render en cola con
    // un valor más corto nunca pisa lo que ya ve (el mismo fallo que CampoTexto evita).
    private string _consultaSembrada = string.Empty;
    private int _activo = -1;
    private string _escrito = string.Empty;
    private long _escritoEn;

    [Parameter] public string? Etiqueta { get; set; }

    /// <summary>Nombre accesible cuando la etiqueta visible la pone la pantalla por fuera (o no hay).</summary>
    [Parameter] public string? EtiquetaAccesible { get; set; }

    /// <summary>Id del disparador; el <c>for</c> de una etiqueta externa apunta aquí. Sin valor, uno único por instancia.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Con valor, un <c>&lt;input type="hidden"&gt;</c> lleva la elección a un POST nativo.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }

    /// <summary>
    /// Selección múltiple («Panel Formulario TALVEG»): lo elegido sale como chips con «Quitar» sobre el disparador, que pasa a ser
    /// «añadir» (el panel no ofrece lo ya elegido y se cierra al elegir). El valor es <see cref="Valores"/>, no <see cref="Valor"/>.
    /// </summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>Valores elegidos, en orden de elección (solo con <see cref="Multiple"/>).</summary>
    [Parameter] public IReadOnlyList<string> Valores { get; set; } = [];

    [Parameter] public EventCallback<IReadOnlyList<string>> ValoresChanged { get; set; }

    /// <summary>Texto del disparador mientras ningún valor coincide con una opción.</summary>
    [Parameter] public string? Marcador { get; set; }

    /// <summary>Disparador de 40 px (franjas y cabeceras de pantalla) en vez de los 48 px de un campo de formulario.</summary>
    [Parameter] public bool Compacto { get; set; }

    /// <summary>Clase extra del contenedor, para que la pantalla fije su ancho.</summary>
    [Parameter] public string? Clase { get; set; }

    /// <summary>Fuerza el buscador (<c>true</c>) o lo quita (<c>false</c>); sin valor aparece con más de <see cref="UmbralBuscador"/> opciones.</summary>
    [Parameter] public bool? Buscable { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<OpcionSelect> Opciones { get; set; } = [];

    /// <summary>Texto del panel cuando la búsqueda no deja ninguna opción. Sin valor, el común del kit.</summary>
    [Parameter] public string? TextoSinResultados { get; set; }

    /// <summary>
    /// Alta en línea («Panel Formulario TALVEG»): con <see cref="OnCrear"/>, y mientras se busca un texto que no coincide
    /// exactamente con ninguna opción, el panel termina en una fila fija «+ Crear "X"». Pulsarla, o Intro cuando no hay otra opción
    /// resaltada, llama a <see cref="OnCrear"/>; la opción que devuelve queda elegida sin salir del panel. Sin <see cref="OnCrear"/>
    /// (p. ej. un rol sin permiso sobre el catálogo) la fila no aparece. La pantalla decide si el alta es real o diferida al guardar.
    /// </summary>
    [Parameter] public bool PermitirCrear { get; set; }

    /// <summary>Crea la opción con el texto escrito y devuelve la opción nueva (nulo: no se creó). Obligatorio para que haya fila de alta.</summary>
    [Parameter] public Func<string, Task<OpcionSelect?>>? OnCrear { get; set; }

    /// <summary>Texto de la fila de alta a partir de lo escrito (p. ej. <c>t =&gt; $"Crear oficio «{t}»"</c>). Sin valor, «Crear «X»» localizado.</summary>
    [Parameter] public Func<string, string>? TextoCrear { get; set; }

    // Opciones + las creadas aquí que la pantalla aún no ha incorporado a Opciones: la opción recién creada se puede elegir y
    // mostrar aunque el padre tarde en devolverla (o la guarde al final).
    private readonly List<OpcionSelect> _creadas = [];
    private IReadOnlyList<OpcionSelect> _todas = [];

    protected override void OnParametersSet()
    {
        var anteriores = _todas;
        RecalcularTodas();
        if (!_abierto || ReferenceEquals(anteriores, _todas)) return;

        // Con la lista abierta, unas opciones que llegan mientras se busca (una carga asíncrona del padre) rehacen
        // el filtro: los índices visibles apuntaban a la lista anterior y pintaban filas que ya no tocaban.
        Recalcular();
        if (_activo < 0 || _activo >= _visibles.Count + (MostrarCrear ? 1 : 0))
            _activo = _visibles.FindIndex(i => !_todas[i].Deshabilitada);
    }

    private void RecalcularTodas() =>
        _todas = _creadas.Count == 0 ? Opciones : [.. Opciones, .. _creadas.Where(c => Opciones.All(o => o.Valor != c.Valor))];

    private bool PuedeCrear => PermitirCrear && OnCrear is not null;

    private bool MostrarCrear =>
        PuedeCrear && HayBusqueda && !_todas.Any(o => string.Equals(o.Texto.Trim(), _consulta.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || CultureInfo.CurrentCulture.CompareInfo.Compare(o.Texto.Trim(), _consulta.Trim(), SinMayusculasNiTildes) == 0);

    private int TotalFilas => _visibles.Count + (MostrarCrear ? 1 : 0);

    private string IdCrear => $"{IdCampo}-crear";

    private string TextoFilaCrear => TextoCrear is { } f ? f(_consulta.Trim()) : string.Format(Comunes["SelectorCrear"].Value, _consulta.Trim());

    private async Task CrearAsync()
    {
        var texto = _consulta.Trim();
        if (OnCrear is null || texto.Length == 0) return;

        var nueva = await OnCrear(texto);
        Cerrar(devolverFoco: true);
        if (nueva is null) return;

        if (_todas.All(o => o.Valor != nueva.Valor))
        {
            _creadas.Add(nueva);
            RecalcularTodas();
        }

        if (Multiple) await AnadirAsync(nueva.Valor);
        else if (nueva.Valor != Valor) await ValorChanged.InvokeAsync(nueva.Valor);
    }

    private bool HayBusqueda => _consulta.Trim().Length > 0;

    private string AnuncioResultados => !HayBusqueda ? string.Empty : Comunes[_visibles.Count == 1 ? "SelectorResultadoSingular" : "SelectorResultados", _visibles.Count].Value;

    private string IdCampo => string.IsNullOrWhiteSpace(Id) ? _idAuto : Id;
    private string _idEtiqueta => $"{IdCampo}-etiqueta";
    private string _idLista => $"{IdCampo}-lista";
    private bool EsBuscable => Buscable ?? (_todas.Count > UmbralBuscador || PuedeCrear);
    private OpcionSelect? Actual => Multiple ? null : _todas.FirstOrDefault(o => o.Valor == Valor);

    private IReadOnlyList<string> Elegidos => Valores ?? [];

    private string TextoDe(string valor) => _todas.FirstOrDefault(o => o.Valor == valor)?.Texto ?? valor;

    // Con el campo deshabilitado el botón de quitar sale deshabilitado; el clic de uno al que le quitaron `disabled` en el DOM no quita (CWE-602).
    private Task QuitarAsync(string valor) =>
        Deshabilitado ? Task.CompletedTask : ValoresChanged.InvokeAsync([.. Elegidos.Where(v => v != valor)]);

    private async Task AnadirAsync(string valor)
    {
        if (!Elegidos.Contains(valor)) await ValoresChanged.InvokeAsync([.. Elegidos, valor]);
    }
    private string TextoMarcador => Marcador ?? Comunes["SelectorMarcador"].Value;
    private string? IdActivo =>
        _activo >= 0 && _activo < _visibles.Count ? IdOpcion(_visibles[_activo]) : _activo == _visibles.Count && MostrarCrear ? IdCrear : null;

    private string ClaseRaiz => string.Join(' ', new[]
    {
        string.IsNullOrWhiteSpace(Etiqueta) ? null : "campo",
        "campo-select-avanzado",
        Compacto ? "csa-compacto" : null,
        _abierto ? "csa-abierto" : null,
        Clase,
    }.Where(c => !string.IsNullOrWhiteSpace(c)));

    private string IdOpcion(int indice) => $"{IdCampo}-op-{indice}";

    private string IdGrupo(int numero) => $"{IdCampo}-grupo-{numero}";

    private bool HayGrupos => _todas.Any(o => !string.IsNullOrWhiteSpace(o.Grupo));

    private readonly record struct TramoGrupo(string Rotulo, int Desde, int Hasta)
    {
        public IEnumerable<int> Posiciones => Enumerable.Range(Desde, Hasta - Desde);
    }

    /// <summary>
    /// Corta las opciones visibles en tramos seguidos del mismo <see cref="OpcionSelect.Grupo"/>, en el orden de
    /// <see cref="Opciones"/>. Solo salen los grupos con alguna opción visible: el que el filtro vacía desaparece.
    /// Las posiciones son las de <c>_visibles</c>, así que el teclado recorre la lista igual que sin grupos.
    /// </summary>
    private List<TramoGrupo> TramosPorGrupo()
    {
        var tramos = new List<TramoGrupo>();
        var desde = 0;
        for (var posicion = 1; posicion <= _visibles.Count; posicion++)
        {
            var rotulo = _todas[_visibles[desde]].Grupo ?? string.Empty;
            if (posicion < _visibles.Count && (_todas[_visibles[posicion]].Grupo ?? string.Empty) == rotulo) continue;

            tramos.Add(new TramoGrupo(rotulo, desde, posicion));
            desde = posicion;
        }

        return tramos;
    }

    private OpcionSelect OpcionEn(int posicion) => _todas[_visibles[posicion]];

    private bool EsElegida(int posicion) => !Multiple && OpcionEn(posicion).Valor == Valor;

    private static string ClasePunto(TonoBadge tono) => $"csa-punto csa-punto-{tono.ToString().ToLowerInvariant()}";

    private string ClaseOpcion(int posicion, bool elegida, bool deshabilitada) =>
        "csa-opcion" + (posicion == _activo ? " csa-activa" : "") + (elegida ? " csa-elegida" : "") + (deshabilitada ? " csa-deshabilitada" : "");

    private void Alternar()
    {
        if (_abierto) CerrarSinFoco();
        else Abrir();
    }

    private void CerrarSinFoco() => _abierto = false;

    private void Cerrar(bool devolverFoco)
    {
        _abierto = false;
        _devolverFocoPendiente = devolverFoco;
    }

    private void Abrir()
    {
        if (Deshabilitado) return;

        _abierto = true;
        _consulta = string.Empty;
        _consultaSembrada = string.Empty;
        _escrito = string.Empty;
        Recalcular();
        _activo = _visibles.FindIndex(i => _todas[i].Valor == Valor && !_todas[i].Deshabilitada);
        if (_activo < 0) _activo = _visibles.FindIndex(i => !_todas[i].Deshabilitada);
        _anclarPendiente = true;
        _enfocarBuscadorPendiente = EsBuscable;
        _desplazarPendiente = true;
    }

    private void Recalcular()
    {
        var buscado = _consulta.Trim();
        _visibles.Clear();
        for (var i = 0; i < _todas.Count; i++)
        {
            if (Multiple && Elegidos.Contains(_todas[i].Valor)) continue;
            if (buscado.Length == 0 || Coincide(_todas[i], buscado)) _visibles.Add(i);
        }
    }

    private static bool Coincide(OpcionSelect opcion, string buscado)
    {
        var comparador = CultureInfo.CurrentCulture.CompareInfo;
        return comparador.IndexOf(opcion.Texto, buscado, SinMayusculasNiTildes) >= 0
            || (opcion.Descripcion is not null && comparador.IndexOf(opcion.Descripcion, buscado, SinMayusculasNiTildes) >= 0)
            || (opcion.Alias is not null && opcion.Alias.Any(a => comparador.IndexOf(a, buscado, SinMayusculasNiTildes) >= 0));
    }

    /// <summary>
    /// Con buscador, escribir sobre el disparador es buscar: la letra entra en la búsqueda (y el panel se abre si
    /// estaba cerrado), en vez de saltar a la opción que empieza por ella. Así el campo es uno solo: se escribe en
    /// él y la lista se filtra.
    /// </summary>
    private void AnadirABusqueda(string tecla)
    {
        _consulta += tecla;
        _consultaSembrada = _consulta;
        Recalcular();
        _activo = _visibles.FindIndex(i => !_todas[i].Deshabilitada);
        if (_activo < 0 && MostrarCrear) _activo = _visibles.Count;
        _desplazarPendiente = true;
    }

    private void AlEscribir(ChangeEventArgs e)
    {
        _consulta = e.Value?.ToString() ?? string.Empty;
        Recalcular();
        _activo = _visibles.FindIndex(i => !_todas[i].Deshabilitada);
        // Sin ninguna coincidencia, Intro ejecuta el alta (la fila de alta es la única que queda).
        if (_activo < 0 && MostrarCrear) _activo = _visibles.Count;
        _desplazarPendiente = true;
    }

    private async Task ManejarTeclaAsync(KeyboardEventArgs e, bool enBuscador)
    {
        if (e.CtrlKey || e.MetaKey || e.AltKey) return;

        if (!_abierto)
        {
            if (e.Key is "ArrowDown" or "ArrowUp") Abrir();
            else if (!enBuscador && EsCaracter(e))
            {
                Abrir();
                if (EsBuscable) AnadirABusqueda(e.Key);
                else EscribirRapido(e.Key);
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowDown": Mover(1); break;
            case "ArrowUp": Mover(-1); break;
            case "Home" when !enBuscador || _consulta.Length == 0: IrAlExtremo(primero: true); break;
            case "End" when !enBuscador || _consulta.Length == 0: IrAlExtremo(primero: false); break;
            case "Enter": await ElegirAsync(_activo); break;
            case " " when !enBuscador: await ElegirAsync(_activo); break;
            case "Escape": Cerrar(devolverFoco: true); break;
            // Tab cierra y deja que el navegador siga su camino: el foco no se devuelve.
            case "Tab": Cerrar(devolverFoco: false); break;
            default:
                // Letras pulsadas antes de que el foco llegue al buscador: siguen sumando a la búsqueda.
                if (!enBuscador && EsCaracter(e))
                {
                    if (EsBuscable) AnadirABusqueda(e.Key);
                    else EscribirRapido(e.Key);
                }
                break;
        }
    }

    private static bool EsCaracter(KeyboardEventArgs e) => e.Key.Length == 1 && e.Key != " ";

    private void Mover(int paso)
    {
        var total = TotalFilas;
        var destino = _activo < 0 ? (paso > 0 ? -1 : total) : _activo;
        do
        {
            destino += paso;
        }
        while (destino >= 0 && destino < _visibles.Count && _todas[_visibles[destino]].Deshabilitada);

        if (destino < 0 || destino >= total) return;

        _activo = destino;
        _desplazarPendiente = true;
    }

    private void IrAlExtremo(bool primero)
    {
        var posicion = primero
            ? _visibles.FindIndex(i => !_todas[i].Deshabilitada)
            : _visibles.FindLastIndex(i => !_todas[i].Deshabilitada);
        if (posicion < 0) return;

        _activo = posicion;
        _desplazarPendiente = true;
    }

    /// <summary>
    /// Escritura rápida sobre el disparador: las letras seguidas dentro de una pausa corta buscan una
    /// opción que EMPIECE por ellas; la misma letra repetida recorre las que empiezan por ella.
    /// </summary>
    private void EscribirRapido(string tecla)
    {
        var ahora = Environment.TickCount64;
        _escrito = ahora - _escritoEn > MsReinicioEscritura ? tecla : _escrito + tecla;
        _escritoEn = ahora;

        var repetida = _escrito.Length > 1 && _escrito.All(c => c == _escrito[0]);
        var buscado = repetida ? _escrito[..1] : _escrito;
        var desde = repetida || _escrito.Length == 1 ? _activo + 1 : Math.Max(_activo, 0);

        var comparador = CultureInfo.CurrentCulture.CompareInfo;
        for (var paso = 0; paso < _visibles.Count; paso++)
        {
            var posicion = (desde + paso) % _visibles.Count;
            var opcion = _todas[_visibles[posicion]];
            if (opcion.Deshabilitada || !comparador.IsPrefix(opcion.Texto, buscado, SinMayusculasNiTildes)) continue;

            _activo = posicion;
            _desplazarPendiente = true;
            return;
        }
    }

    private async Task ElegirAsync(int posicion)
    {
        // El padre puede deshabilitar el campo con la lista ya abierta (un guardado en curso): Abrir() no basta.
        if (Deshabilitado) return;

        if (posicion == _visibles.Count && MostrarCrear)
        {
            await CrearAsync();
            return;
        }

        if (posicion < 0 || posicion >= _visibles.Count) return;

        var opcion = _todas[_visibles[posicion]];
        if (opcion.Deshabilitada) return;

        Cerrar(devolverFoco: true);
        if (Multiple) await AnadirAsync(opcion.Valor);
        else if (opcion.Valor != Valor) await ValorChanged.InvokeAsync(opcion.Valor);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_desechado) return;

        try
        {
            if (_control is null && (firstRender || _abierto)) await CrearControlAsync();

            if (_anclarPendiente && _abierto)
            {
                _anclarPendiente = false;
                if (_control is not null)
                {
                    await _control.InvokeVoidAsync("anclar", _panel, _disparador);
                    _anclado = true;
                }
            }

            if (_enfocarBuscadorPendiente && _abierto)
            {
                _enfocarBuscadorPendiente = false;
                await _buscador.FocusAsync();
            }

            if (_desplazarPendiente && _abierto)
            {
                _desplazarPendiente = false;
                if (_control is not null && IdActivo is { } id) await _control.InvokeVoidAsync("desplazarA", id);
            }

            if (!_abierto && _anclado)
            {
                _anclado = false;
                if (_control is not null) await _control.InvokeVoidAsync("soltar");
            }

            if (_devolverFocoPendiente)
            {
                _devolverFocoPendiente = false;
                await DevolverFocoAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Mejor esfuerzo (mismo criterio que Drawer/Modal): sin el módulo JS (tests de componente,
            // circuito cerrándose) la lista sigue usable, solo sin el anclaje a la capa superior.
        }
    }

    /// <summary>
    /// Con el módulo, el foco vuelve al disparador solo si no se ha ido ya a otro control mientras llegaba esta orden
    /// del servidor (devolverFoco en campo-select-avanzado.js, #2194). Sin módulo, o con uno que no la tenga (un
    /// campo-select-avanzado.js anterior en la caché del navegador), vuelve siempre, como antes.
    /// </summary>
    private async Task DevolverFocoAsync()
    {
        if (_control is not null)
        {
            try
            {
                await _control.InvokeVoidAsync("devolverFoco", _disparador);
                return;
            }
            catch (JSException)
            {
                // Se cae al FocusAsync de siempre.
            }
        }

        await _disparador.FocusAsync();
    }

    private async Task CrearControlAsync()
    {
        try
        {
            _modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/campo-select-avanzado.js");
            if (_modulo is null) return;
            _control = await _modulo.InvokeAsync<IJSObjectReference>("crear", _raiz);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            _control = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _desechado = true;
        try
        {
            if (_control is not null)
            {
                await _control.InvokeVoidAsync("dispose");
                await _control.DisposeAsync();
            }

            if (_modulo is not null) await _modulo.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
        }
    }
}
