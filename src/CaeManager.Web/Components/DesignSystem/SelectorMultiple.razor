@*
    Lista de checkboxes con buscador, paginación y filtro "solo
    relacionados" — para selectores muchos-a-muchos con cientos de
    elementos (Clientes/Empresas en los drawers de Empresas/Subcontratas).
    Ver Project-Hydra-Negocio/tecnico/docs/archive/design/UX_PATTERNS.md.
*@
<div class="campo" tabindex="-1" @ref="_raiz">
    @if (!string.IsNullOrWhiteSpace(Etiqueta))
    {
        <label>@Etiqueta</label>
    }

    @if (Elementos.Count == 0)
    {
        <p class="texto-vacio-seccion">@TextoVacio</p>
    }
    else
    {
        <div class="selector-multiple-controles">
            <CampoTexto Placeholder="Buscar…" Valor="@_busqueda" ValorChanged="CambiarBusquedaAsync" />
            <label class="campo-checkbox" for="@($"{_idBase}-relacionados")">
                <input type="checkbox" id="@($"{_idBase}-relacionados")"
                       checked="@SoloRelacionadosEfectivo"
                       @onchange="e => CambiarSoloRelacionados(e.Value is bool marcado && marcado)" />
                Solo mostrar relacionados
            </label>
        </div>

        @if (ElementosFiltrados.Count == 0)
        {
            <p class="texto-vacio-seccion">Ningún elemento coincide con la búsqueda.</p>
        }
        else
        {
            <div class="lista-seleccion-multiple">
                @foreach (var elemento in ElementosPagina)
                {
                    <label class="campo-checkbox" for="@($"{_idBase}-{elemento.Id}")">
                        <input type="checkbox" id="@($"{_idBase}-{elemento.Id}")"
                               checked="@Seleccionados.Contains(elemento.Id)"
                               @onchange="e => AlternarAsync(elemento.Id, e.Value is bool marcado && marcado)" />
                        @elemento.Nombre
                    </label>
                }
            </div>

            @if (TotalPaginas > 1)
            {
                <PaginadorSimple PaginaActual="PaginaActualEfectiva" TotalPaginas="TotalPaginas"
                                  TotalElementos="ElementosFiltrados.Count" Etiqueta="elemento(s)"
                                  PaginaActualChanged="v => _paginaActual = v" />
            }
        }
    }

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <span class="campo-mensaje-error" role="alert">@MensajeError</span>
    }
</div>

@code {
    private const int ItemsPorPagina = 20;

    // Las etiquetas se asocian a su casilla por for/id, además de envolverla (D-08: nombre accesible «on»).
    private static int _contador;
    private readonly string _idBase = $"selector-multiple-{System.Threading.Interlocked.Increment(ref _contador)}";

    private string _busqueda = string.Empty;
    private bool _soloRelacionados;
    private int _paginaActual = 1;

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public IReadOnlyList<ElementoSeleccionable> Elementos { get; set; } = [];
    [Parameter] public IReadOnlySet<Guid> Seleccionados { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<(Guid Id, bool Marcado)> OnAlternar { get; set; }
    /// <summary>Error de validación del campo, en línea bajo la lista (mismo estilo que CampoTexto).</summary>
    [Parameter] public string? MensajeError { get; set; }
    /// <summary>
    /// Conjunto de «relacionados» distinto de los marcados (p. ej. los Trabajadores asignados al
    /// Centro de la Visita). <c>null</c> (por defecto) conserva el significado histórico:
    /// «solo relacionados» = solo los ya marcados. Con conjunto, «solo relacionados» muestra los
    /// relacionados y, además, los ya marcados, para que una selección no desaparezca de la lista.
    /// </summary>
    [Parameter] public IReadOnlySet<Guid>? Relacionados { get; set; }
    /// <summary>
    /// Estado de «Solo mostrar relacionados» cuando lo gobierna el padre (enlace bidireccional con
    /// <see cref="SoloRelacionadosChanged"/>). <c>null</c> (por defecto): el componente lo gestiona solo.
    /// </summary>
    [Parameter] public bool? SoloRelacionados { get; set; }
    [Parameter] public EventCallback<bool> SoloRelacionadosChanged { get; set; }
    [Parameter] public string TextoVacio { get; set; } = "Todavía no hay elementos creados.";

    private IReadOnlyList<ElementoSeleccionable> ElementosFiltrados =>
        Elementos
            .Where(e => string.IsNullOrWhiteSpace(_busqueda) || e.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(e => !SoloRelacionadosEfectivo || EsRelacionado(e.Id))
            .ToList();

    private ElementReference _raiz;

    private bool SoloRelacionadosEfectivo => SoloRelacionados ?? _soloRelacionados;

    private bool EsRelacionado(Guid id) =>
        Seleccionados.Contains(id) || (Relacionados is not null && Relacionados.Contains(id));

    /// <summary>Lleva el foco al campo (p. ej. tras un error de validación al guardar).</summary>
    public async Task EnfocarAsync() => await _raiz.FocusAsync();

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ElementosFiltrados.Count / (double)ItemsPorPagina));

    private int PaginaActualEfectiva => Math.Clamp(_paginaActual, 1, TotalPaginas);

    private IReadOnlyList<ElementoSeleccionable> ElementosPagina =>
        ElementosFiltrados.Skip((PaginaActualEfectiva - 1) * ItemsPorPagina).Take(ItemsPorPagina).ToList();

    private Task CambiarBusquedaAsync(string valor)
    {
        _busqueda = valor;
        _paginaActual = 1;
        return Task.CompletedTask;
    }

    private Task CambiarSoloRelacionados(bool marcado)
    {
        _soloRelacionados = marcado;
        _paginaActual = 1;
        return SoloRelacionadosChanged.InvokeAsync(marcado);
    }

    private Task AlternarAsync(Guid id, bool marcado) => OnAlternar.InvokeAsync((id, marcado));
}
