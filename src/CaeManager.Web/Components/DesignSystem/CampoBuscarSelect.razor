@*
    Campo de una sola elección con búsqueda sobre una lista larga (Trabajador, Centro, Cliente empresarial…). Es el
    mismo combobox que el «Tipo de documento»: se escribe en el propio campo y la lista se filtra sin mayúsculas ni
    tildes; se elige una opción de la lista, nunca un texto libre. Antes era un input con <datalist>, que solo elegía
    si el texto coincidía exactamente con una opción, dejaba sin elegir a dos homónimos y no decía «sin
    coincidencias». La API (Valor, ValorChanged, Opciones, Etiqueta, Marcador, Deshabilitado) no cambia.
    Lo que no hace el combobox es vaciar la elección: el campo solo cambia de una opción a otra. La pantalla que
    necesite «sin elección» pone su propio botón (Reportes, «Quitar filtro»).
*@
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Comunes
<CampoSelectAvanzado Etiqueta="@Etiqueta" Marcador="@Marcador" Valor="@Valor" ValorChanged="ValorChanged"
                     Deshabilitado="@Deshabilitado" Buscable="true" Opciones="@_opciones"
                     TextoSinResultados="@Comunes["SelectorSinCoincidencias"]" />

@code {
    private IReadOnlyList<OpcionBuscable>? _origen;
    private IReadOnlyList<OpcionSelect> _opciones = [];

    [Parameter] public string? Etiqueta { get; set; }
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public string? Marcador { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<OpcionBuscable> Opciones { get; set; } = [];

    /// <summary>
    /// Las opciones se traducen solo cuando cambia la lista recibida: un render del padre con la misma lista no
    /// rehace el array ni obliga al combobox a recalcular.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_origen, Opciones)) return;
        _origen = Opciones;
        _opciones = Opciones.Select(o => new OpcionSelect(o.Id, o.Texto)).ToList();
    }
}
