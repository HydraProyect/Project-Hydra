<div class="tarjeta @(Compacta ? "tarjeta-compacta" : null) @Class" data-pieza="tarjeta">
    @if (!string.IsNullOrWhiteSpace(Titulo) || AccionesHeader is not null)
    {
        <div class="tarjeta-header">
            @if (!string.IsNullOrWhiteSpace(Titulo))
            {
                @* Marcado literal, no RenderTreeBuilder: un elemento creado con
                   builder.OpenElement no recibe el atributo de ámbito del CSS
                   aislado y .tarjeta-titulo de Tarjeta.razor.css no le llega. *@
                @switch (NivelTitulo)
                {
                    case 3:
                        <h3 class="tarjeta-titulo">@Titulo</h3>
                        break;
                    case 4:
                        <h4 class="tarjeta-titulo">@Titulo</h4>
                        break;
                    default:
                        <h2 class="tarjeta-titulo">@Titulo</h2>
                        break;
                }
            }
            @if (AccionesHeader is not null)
            {
                <div class="tarjeta-acciones">@AccionesHeader</div>
            }
        </div>
    }
    <div class="tarjeta-contenido">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public RenderFragment? AccionesHeader { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Tarjeta del lateral de una página 360 (<see cref="CuerpoConLateral"/>):
    /// relleno de 16 px, cabecera sin separador y título más pequeño, con la
    /// acción de la cabecera («Editar →») a la derecha. Nació como la
    /// .centro360-tarjeta-lateral de Centro 360 (que ya usa esta variante) y de los mockups Cliente 360 y
    /// Empresa 360. Falso por defecto: ningún consumidor existente cambia.
    /// </summary>
    [Parameter] public bool Compacta { get; set; }

    /// <summary>
    /// Nivel de encabezado HTML del título (2 a 4). 2 por defecto, para no
    /// cambiar a ningún consumidor existente: solo baja a 3 o 4 cuando la
    /// tarjeta es una subsección bajo un h2/h3 que ya pintó el contenedor.
    /// </summary>
    [Parameter] public int NivelTitulo { get; set; } = 2;

    protected override void OnParametersSet()
    {
        if (NivelTitulo is < 2 or > 4)
            throw new ArgumentOutOfRangeException(nameof(NivelTitulo), NivelTitulo, "NivelTitulo debe estar entre 2 y 4.");
    }
}
