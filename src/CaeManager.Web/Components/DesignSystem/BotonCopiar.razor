<button type="button" class="@(EnLinea ? "boton-copiar boton-copiar-en-linea" : "boton-copiar")" disabled="@Deshabilitado"
        aria-label="@NombreAccesible" title="@(EnLinea ? NombreAccesible : null)"
        @onclick="CopiarAsync" @onclick:stopPropagation="EnLinea">
    <TextoResaltado Texto="@Texto" Termino="@TerminoResaltado" />
</button>
