<button type="button" class="@(EnLinea ? (ConIcono ? "boton-copiar boton-copiar-en-linea boton-copiar-con-icono" : "boton-copiar boton-copiar-en-linea") : "boton-copiar")" disabled="@Deshabilitado"
        aria-label="@NombreAccesible" title="@TituloEnLinea"
        @onclick="CopiarAsync" @onclick:stopPropagation="EnLinea">
    <TextoResaltado Texto="@Texto" Termino="@TerminoResaltado" />
    @if (ConIcono)
    {
        <span class="boton-copiar-icono" aria-hidden="true"><Icono Nombre="copiar" Tamano="TamanoIcono.Pequeno" /></span>
    }
    @if (_copiado)
    {
        <span class="boton-copiar-confirmacion" aria-hidden="true"><Icono Nombre="check" Tamano="TamanoIcono.Pequeno" /></span>
    }
</button>
