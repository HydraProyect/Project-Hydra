@implements IDisposable
@inject ToastService ToastService
@inject NavigationManager Navegacion
@inherits CaeManager.Web.Components.IsloteInteractivo

<LimiteDeErrores Islote="this">
<div class="anfitrion-toasts" aria-live="polite">
    @foreach (var toast in ToastService.Mensajes)
    {
        @* @key evita que Blazor recree el nodo cuando entra o sale otro toast
           de la pila: sin él, la animación de entrada y el trazado de
           confirmación se redibujarían en cada cambio de la lista, y el
           trazado debe dibujarse una vez por evento (07 § 6.1, DDL-071). *@
        <div class="toast toast-@toast.Tono.ToString().ToLowerInvariant()" role="status" @key="toast.Id"
             @onmouseenter="() => ToastService.PunteroSobre(toast.Id, true)"
             @onmouseleave="() => ToastService.PunteroSobre(toast.Id, false)"
             @onfocusin="() => ToastService.FocoEn(toast.Id, true)"
             @onfocusout="() => ToastService.FocoEn(toast.Id, false)">
            @if (toast.Tono == TonoToast.Exito)
            {
                @* Trazado de confirmación (Tier C, 07 § 6): la marca se dibuja
                   al entrar el toast — el cierre de la operación se ve
                   completarse. prefers-reduced-motion la muestra ya trazada. *@
                <svg class="toast-trazado" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8.5 6.5 12 13 4.5" />
                </svg>
            }
            else if (IconoDelTono(toast.Tono) is { } nombreIcono)
            {
                @* Los demás tonos no llevan trazado (es un patrón de motion
                   reservado al Éxito) pero sí icono: el tono del toast no
                   puede quedar solo en el color de fondo (WCAG 1.4.1). *@
                <Icono Nombre="@nombreIcono" Tamano="TamanoIcono.Pequeno" />
            }
            <span>@toast.Mensaje</span>
            @if (toast.TextoAccion is not null)
            {
                <button type="button" class="toast-accion" @onclick="() => ToastService.EjecutarAccionAsync(toast.Id)">@toast.TextoAccion</button>
                @* Cuenta atrás a la vista (decisión del 2026-10-08). aria-hidden: la región es
                   aria-live y un número que cambia cada segundo se anunciaría ocho veces. *@
                @if (ToastService.SegundosRestantes(toast.Id) is { } segundos)
                {
                    <span class="toast-cuenta" aria-hidden="true">@segundos s</span>
                }
            }
            <button type="button" class="toast-cerrar" aria-label="Cerrar" @onclick="() => ToastService.Descartar(toast.Id)"><Icono Nombre="cerrar" Tamano="TamanoIcono.Pequeno" /></button>
            @if (toast.Tono != TonoToast.Error)
            {
                var duracionMs = toast.TextoAccion is not null
                    ? (int)ToastService.DuracionAutoDescarteConAccion.TotalMilliseconds
                    : (int)ToastService.DuracionAutoDescarte.TotalMilliseconds;
                <div class="toast-progreso" style="animation-duration:@(duracionMs)ms"></div>
            }
        </div>
    }
</div>
</LimiteDeErrores>

@code {
    /// <summary>
    /// Icono del catálogo por tono. Éxito no aparece aquí: su marca es el
    /// trazado de confirmación animado (07 § 6.1, DDL-071), que ya cumple la
    /// misma función y no debe duplicarse con un segundo icono.
    /// </summary>
    private static string? IconoDelTono(TonoToast tono) => tono switch
    {
        TonoToast.Error => "error-circulo",
        TonoToast.Advertencia => "advertencia",
        TonoToast.Info => "info",
        _ => null
    };

    private string _ruta = string.Empty;

    protected override void OnInitialized()
    {
        ToastService.OnCambio += ManejarCambio;
        _ruta = RutaDe(Navegacion.Uri);
        Navegacion.LocationChanged += ManejarNavegacion;
    }

    private void ManejarCambio() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Otra pantalla es otra ruta. Un cambio de la cadena de consulta (filtros, panel de contexto,
    /// pestaña) es la misma pantalla, y ahí un error sigue exigiendo descarte manual.
    /// </summary>
    private void ManejarNavegacion(object? emisor, LocationChangedEventArgs e)
    {
        var ruta = RutaDe(e.Location);
        if (string.Equals(ruta, _ruta, StringComparison.OrdinalIgnoreCase))
            return;

        _ruta = ruta;
        ToastService.AlCambiarDePantalla();
    }

    private static string RutaDe(string uri) => new Uri(uri).AbsolutePath.TrimEnd('/');

    public void Dispose()
    {
        ToastService.OnCambio -= ManejarCambio;
        Navegacion.LocationChanged -= ManejarNavegacion;
    }
}
