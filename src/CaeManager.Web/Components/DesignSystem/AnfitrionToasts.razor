@implements IDisposable
@inject ToastService ToastService

<div class="anfitrion-toasts" aria-live="polite">
    @foreach (var toast in ToastService.Mensajes)
    {
        @* @key evita que Blazor recree el nodo cuando entra o sale otro toast
           de la pila: sin él, la animación de entrada y el trazado de
           confirmación se redibujarían en cada cambio de la lista, y el
           trazado debe dibujarse una vez por evento (07 § 6.1, DDL-071). *@
        <div class="toast toast-@toast.Tono.ToString().ToLowerInvariant()" role="status" @key="toast.Id">
            @if (toast.Tono == TonoToast.Exito)
            {
                @* Trazado de confirmación (Tier C, 07 § 6): la marca se dibuja
                   al entrar el toast — el cierre de la operación se ve
                   completarse. prefers-reduced-motion la muestra ya trazada. *@
                <svg class="toast-trazado" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8.5 6.5 12 13 4.5" />
                </svg>
            }
            <span>@toast.Mensaje</span>
            @if (toast.TextoAccion is not null)
            {
                <button type="button" class="toast-accion" @onclick="() => ToastService.EjecutarAccionAsync(toast.Id)">@toast.TextoAccion</button>
            }
            <button type="button" aria-label="Cerrar" @onclick="() => ToastService.Descartar(toast.Id)">×</button>
            @if (toast.Tono != TonoToast.Error)
            {
                var duracionMs = toast.TextoAccion is not null
                    ? (int)ToastService.DuracionAutoDescarteConAccion.TotalMilliseconds
                    : (int)ToastService.DuracionAutoDescarte.TotalMilliseconds;
                <div class="toast-progreso" style="animation-duration:@(duracionMs)ms"></div>
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastService.OnCambio += ManejarCambio;

    private void ManejarCambio() => InvokeAsync(StateHasChanged);

    public void Dispose() => ToastService.OnCambio -= ManejarCambio;
}
