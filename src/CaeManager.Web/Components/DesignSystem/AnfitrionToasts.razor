@implements IDisposable
@inject ToastService ToastService

<div class="anfitrion-toasts" aria-live="polite">
    @foreach (var toast in ToastService.Mensajes)
    {
        <div class="toast toast-@toast.Tono.ToString().ToLowerInvariant()" role="status">
            <span>@toast.Mensaje</span>
            <button type="button" aria-label="Cerrar" @onclick="() => ToastService.Descartar(toast.Id)">×</button>
            @if (toast.Tono != TonoToast.Error)
            {
                <div class="toast-progreso" style="animation-duration:@((int)ToastService.DuracionAutoDescarte.TotalMilliseconds)ms"></div>
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastService.OnCambio += ManejarCambio;

    private void ManejarCambio() => InvokeAsync(StateHasChanged);

    public void Dispose() => ToastService.OnCambio -= ManejarCambio;
}
