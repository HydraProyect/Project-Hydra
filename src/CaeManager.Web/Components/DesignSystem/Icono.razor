        </g>,

        "buscar" => @<g>
            <circle cx="10.5" cy="10.5" r="6.5" />
            <line x1="20" y1="20" x2="15.3" y2="15.3" />
        </g>,

        "cerrar-sesion" => @<g>
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="15 16 20 11 15 6" />
            <line x1="20" y1="11" x2="8.5" y2="11" />
        </g>,

        "seguridad" => @<g>
            <rect x="5" y="11" width="14" height="10" rx="1.5" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            <line x1="12" y1="15" x2="12" y2="17" />
        </g>,

        "chat" => @<g>
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </g>,

        // Badge de canal Correo en la bandeja unificada (docs/COMUNICACIONES.md § 12.1).
        "correo" => @<g>
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <polyline points="3.5 6 12 13 20.5 6" />
        </g>,

        "volver" => @<g>
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="11 6 5 12 11 18" />
        </g>,

        "cartera" => @<g>
            <rect x="3" y="7" width="18" height="13" rx="1.5" />
            <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7" />
            <circle cx="12" cy="13" r="1.75" />
        </g>,

        "evaluaciones" => @<g>
            <path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z" />
            <rect x="5" y="5" width="14" height="16" rx="1.5" />
            <polyline points="8.5 13 11 15.5 16 10.5" />
        </g>,

        "incidencias" => @<g>
            <path d="M12 3.5 21 19.5H3Z" />
            <line x1="12" y1="9.5" x2="12" y2="14" />
            <line x1="12" y1="17" x2="12" y2="17.01" />
        </g>,

        "menu" => @<g>
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
        </g>,

        // Apunta hacia abajo por defecto; NavMenu la rota -90° con CSS
        // cuando el grupo está colapsado, en vez de mantener dos variantes.
        "chevron" => @<polyline points="6 9 12 15 18 9" />,

        // Edición in situ de la pestaña "Información" del Context Workspace
        // (Centro 360, PLAN-EJECUCION-UX.md § 0.10).
        "editar" => @<g>
            <path d="M17 3a2.83 2.83 0 0 1 4 4L7 21l-4 1 1-4Z" />
        </g>,

        // Marca de "esto lo propuso la IA" (sugerencia de visita/gestión en el
        // Communication Workspace, docs/COMUNICACIONES.md § 12.3/§ 12.6) —
        // "IA como copiloto, nunca invitado": un destello, no un logo de robot.
        "ia" => @<g>
            <path d="M12 3.5 13.4 8.6 18.5 10 13.4 11.4 12 16.5 10.6 11.4 5.5 10 10.6 8.6Z" />
            <path d="M19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7Z" />
        </g>,

        // Botón circular de envío del ComposerBar en modo WhatsApp (§ 12.4) —
        // patrón de "burbuja de chat" habitual, distinto del botón "Enviar" de
        // texto que usa el modo Correo.
        "enviar" => @<g>
            <path d="M4 12 20.5 4.5 15 20l-2.7-6.3z" />
            <path d="M20.5 4.5 12.3 13.3" />
        </g>,

        _ => @<g></g>
    };
}
