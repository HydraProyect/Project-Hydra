@*
    Un único set de iconos outline en todo el sistema (ver DESIGN_SYSTEM.md,
    "Iconografía") — nunca mezclar con emojis ni con un segundo estilo de
    icono. Trazo 1.75px, sin relleno, esquinas redondeadas: misma convención
    visual que Lucide/Heroicons.
*@
<svg class="icono icono-@Tamano.ToString().ToLowerInvariant()"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.75"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true">
    @ObtenerContenido()
</svg>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter] public TamanoIcono Tamano { get; set; } = TamanoIcono.Medio;

    private RenderFragment ObtenerContenido() => Nombre switch
    {
        "dashboard" => @<g>
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
        </g>,

        "clientes" => @<g>
            <rect x="4" y="3" width="16" height="18" rx="1.5" />
            <line x1="8" y1="8" x2="8" y2="8.01" />
            <line x1="12" y1="8" x2="12" y2="8.01" />
            <line x1="16" y1="8" x2="16" y2="8.01" />
            <line x1="8" y1="12" x2="8" y2="12.01" />
            <line x1="12" y1="12" x2="12" y2="12.01" />
            <line x1="16" y1="12" x2="16" y2="12.01" />
            <path d="M10 21v-4h4v4" />
        </g>,

        "empresas" => @<g>
            <rect x="3" y="8" width="18" height="12" rx="1.5" />
            <path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <line x1="3" y1="13" x2="21" y2="13" />
        </g>,

        "centros" => @<g>
            <path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Z" />
            <circle cx="12" cy="9.5" r="2.25" />
        </g>,

        "subcontratas" => @<g>
            <rect x="3" y="8" width="18" height="12" rx="1.5" />
            <path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <path d="M9 13a3 3 0 0 0 6 0" />
        </g>,

        "trabajadores" => @<g>
            <circle cx="8.5" cy="8" r="3" />
            <path d="M2.5 20a6 6 0 0 1 12 0" />
            <circle cx="17" cy="9" r="2.5" />
            <path d="M15.5 13.2A5 5 0 0 1 21.5 18" />
        </g>,

        "documentos" => @<g>
            <path d="M7 3h7l4 4v14H7Z" />
            <path d="M14 3v4h4" />
            <line x1="9.5" y1="12" x2="15" y2="12" />
            <line x1="9.5" y1="16" x2="15" y2="16" />
        </g>,

        "asignaciones" => @<g>
            <circle cx="9" cy="8" r="3" />
            <path d="M3.5 20a5.5 5.5 0 0 1 11 0" />
            <path d="M16 12.5l2 2 3.5-3.5" />
        </g>,

        "alertas" => @<g>
            <path d="M6 10a6 6 0 0 1 12 0c0 4.5 1.5 6 1.5 6h-15S6 14.5 6 10Z" />
            <path d="M10 20a2 2 0 0 0 4 0" />
        </g>,

        "calendario" => @<g>
            <rect x="3.5" y="5" width="17" height="16" rx="1.5" />
            <line x1="3.5" y1="10" x2="20.5" y2="10" />
            <line x1="8" y1="3" x2="8" y2="7" />
            <line x1="16" y1="3" x2="16" y2="7" />
        </g>,

        "reportes" => @<g>
            <line x1="5" y1="21" x2="5" y2="12" />
            <line x1="12" y1="21" x2="12" y2="7" />
            <line x1="19" y1="21" x2="19" y2="15" />
            <line x1="3" y1="21" x2="21" y2="21" />
        </g>,

        "tipos-documento" => @<g>
            <path d="M12 3h6a2 2 0 0 1 2 2v6l-9.5 9.5a2 2 0 0 1-2.8 0L3.5 16.3a2 2 0 0 1 0-2.8Z" />
            <line x1="16.5" y1="7.5" x2="16.51" y2="7.5" />
        </g>,

        "configuracion" => @<g>
            <line x1="4" y1="7" x2="20" y2="7" />
            <circle cx="9" cy="7" r="2" />
            <line x1="4" y1="14" x2="20" y2="14" />
            <circle cx="16" cy="14" r="2" />
            <line x1="4" y1="19" x2="20" y2="19" />
            <circle cx="11" cy="19" r="2" />
        </g>,

        "auditoria" => @<g>
            <circle cx="12" cy="12" r="9" />
            <polyline points="12 7 12 12 15.5 14" />
        </g>,

        "usuarios" => @<g>
            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />
        </g>,

        "roles" => @<g>
            <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z" />
            <polyline points="9 12 11 14 15 10" />
        </g>,

        "importar" => @<g>
            <path d="M12 15V4" />
            <polyline points="7.5 8.5 12 4 16.5 8.5" />
            <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
        </g>,

        "buscar" => @<g>
            <circle cx="10.5" cy="10.5" r="6.5" />
            <line x1="20" y1="20" x2="15.3" y2="15.3" />
        </g>,

        "cerrar-sesion" => @<g>
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="15 16 20 11 15 6" />
            <line x1="20" y1="11" x2="8.5" y2="11" />
        </g>,

        _ => @<g></g>
    };
}
