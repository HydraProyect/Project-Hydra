@*
    Paginador Anterior/Siguiente reutilizable — es el único paginador de la
    plataforma (H2, Project-Hydra-Negocio/tecnico/docs/ux-audit/02-clientes.md; ver Project-Hydra-Negocio/tecnico/docs/archive/design/UX_PATTERNS.md §
    Paginar): tanto para listas con paginación manual en memoria/página
    (`PaginaActual`/`TotalPaginas` como enteros propios) como para listas con
    `QuickGrid` + `PaginationState` (Clientes, Trabajadores, Documentos...),
    donde el caller deriva `PaginaActual` de `PaginationState.CurrentPageIndex`
    y `PaginaActualChanged` delega en `PaginationState.SetCurrentPageIndexAsync`.
    Nunca el `Paginator` propio de QuickGrid — no está localizado ("Page 1 of 1").
*@
@if (ElementosEnPagina is not null || TextoFilasMostradas is not null)
{
    <PieListado PresentacionMaqueta="PresentacionMaqueta" PaginaActual="PaginaActual" TotalPaginas="TotalPaginas" TotalElementos="TotalElementos"
                ElementosEnPagina="ElementosEnPagina" TamanoPagina="TamanoPagina" OpcionesTamanoPagina="OpcionesTamanoPagina"
                PaginaActualChanged="PaginaActualChanged" TamanoPaginaChanged="TamanoPaginaChanged"
                TextoFilasMostradas="@TextoFilasMostradas" EtiquetaTamanoPagina="@EtiquetaTamanoPagina"
                EtiquetaAnterior="@EtiquetaAnterior" EtiquetaSiguiente="@EtiquetaSiguiente" Centro="Centro" />
}
else
{
<div class="paginador paginador-simple">
    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
           Deshabilitado="@(PaginaActual <= 1)" OnClick="() => CambiarPaginaAsync(PaginaActual - 1)">
        <Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> Anterior
    </Boton>
    <span class="paginador-texto">Página @PaginaActual de @Math.Max(TotalPaginas, 1) — @TotalElementos @Etiqueta</span>
    @if (TamanoPaginaChanged.HasDelegate)
    {
        <label class="paginador-tamano">
            Mostrar
            <select class="paginador-tamano-select" value="@TamanoPagina" @onchange="e => TamanoPaginaChanged.InvokeAsync(int.Parse((string)e.Value!))">
                @foreach (var opcion in OpcionesTamanoPagina)
                {
                    <option value="@opcion">@opcion</option>
                }
            </select>
        </label>
    }
    <Boton Variante="VarianteBoton.Secundario" Tamano="TamanoBoton.Pequeno"
           Deshabilitado="@(PaginaActual >= TotalPaginas)" OnClick="() => CambiarPaginaAsync(PaginaActual + 1)">
        Siguiente <Icono Nombre="siguiente" Tamano="TamanoIcono.Pequeno" />
    </Boton>
</div>
}

@code {
    [Parameter] public bool PresentacionMaqueta { get; set; }
    [Parameter] public int PaginaActual { get; set; } = 1;
    [Parameter] public int TotalPaginas { get; set; }
    [Parameter] public int TotalElementos { get; set; }
    [Parameter] public string Etiqueta { get; set; } = "elemento(s)";
    [Parameter] public EventCallback<int> PaginaActualChanged { get; set; }

    /// <summary>
    /// Tamaño de página, 20 de serie. En el modo tradicional el selector
    /// solo se pinta cuando el llamador conecta <see cref="TamanoPaginaChanged"/>, así que sigue
    /// siendo válido usar <c>PaginadorSimple</c> sin tamaño configurable
    /// (p. ej. paginación puramente en memoria de una miniatura) sin tener
    /// que pasar los tres parámetros nuevos.
    /// </summary>
    [Parameter] public int TamanoPagina { get; set; } = 20;
    [Parameter] public EventCallback<int> TamanoPaginaChanged { get; set; }
    [Parameter] public IReadOnlyList<int> OpcionesTamanoPagina { get; set; } = [20, 50, 100];

    /// <summary>Activa el pie de listado de tres zonas, sin alterar el paginador tradicional.</summary>
    [Parameter] public string? TextoFilasMostradas { get; set; }
    /// <summary>Recuento real de elementos de la página; activa el pie de tres zonas localizado.</summary>
    [Parameter] public int? ElementosEnPagina { get; set; }
    [Parameter] public string? EtiquetaTamanoPagina { get; set; }
    [Parameter] public string? EtiquetaAnterior { get; set; }
    [Parameter] public string? EtiquetaSiguiente { get; set; }
    [Parameter] public RenderFragment? Centro { get; set; }

    private Task CambiarPaginaAsync(int pagina) => PaginaActualChanged.InvokeAsync(pagina);
}
