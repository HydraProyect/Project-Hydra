@*
    Un dato de <RejillaDatos>: etiqueta (dt) y valor (dd). El valor es texto
    (Valor) o marcado (ChildContent, p. ej. el valor con un BotonCopiar al
    lado). Sin ninguno de los dos se pinta «—», como CampoInfo: un hueco en
    blanco no distingue «vacío» de «no ha cargado».
*@
@using CaeManager.Web.Recursos
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TextosComunes> Comunes
<div class="dato-rejilla @(Ancho ? "dato-rejilla-ancho" : null) @(EnLectura ? "dato-rejilla-lectura" : null)">
    <dt class="dato-rejilla-etiqueta">@Etiqueta</dt>
    <dd class="dato-rejilla-valor">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrWhiteSpace(Valor))
        {
            @Valor
        }
        else
        {
            <span class="dato-rejilla-vacio">@(EnLectura ? Comunes["LecturaSinDato"].Value : "—")</span>
        }
    </dd>
</div>

@code {
    /// <summary>Etiqueta del dato, ya localizada por quien lo usa.</summary>
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = string.Empty;

    /// <summary>Valor en texto. Se ignora si hay <see cref="ChildContent"/>.</summary>
    [Parameter] public string? Valor { get; set; }

    /// <summary>Valor como marcado (enlace, badge, valor + BotonCopiar).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Ocupa las dos columnas de la rejilla (textos largos: convenio, actividad).</summary>
    [Parameter] public bool Ancho { get; set; }

    /// <summary>
    /// Modo Lectura del panel («Panel Formulario TALVEG»): el dato es una fila etiqueta/valor de la rejilla de <see cref="SeccionLectura"/>
    /// (dt y dd son celdas de ésa) y el vacío dice «Sin dato».
    /// </summary>
    [Parameter] public bool EnLectura { get; set; }
}
