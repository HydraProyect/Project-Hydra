@*
    Host único del Context Workspace — montado una sola vez en MainLayout,
    junto a AnfitrionToasts/BuscadorGlobal (ver comentario de esos dos en
    MainLayout.razor: cualquier componente fuera de @@Body necesita su
    propio @@rendermode explícito o nunca recibe eventos interactivos).

    No modal (role="complementary", sin superposición oscurecida): el
    usuario puede seguir interactuando con la página detrás mientras
    consulta contexto — a diferencia de Drawer/Modal, que sí bloquean.
*@
@using CaeManager.Web.Features.Clientes.Components
@using CaeManager.Web.Features.Empresas.Components
@using CaeManager.Web.Features.Subcontratas.Components
@using CaeManager.Web.Features.Centros.Components
@using CaeManager.Web.Features.Trabajadores.Components
@using CaeManager.Web.Features.Vehiculos.Components
@using CaeManager.Web.Features.Documentos.Components
@implements IAsyncDisposable
@inject ContextWorkspaceService WorkspaceService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject ToastService ToastService

@if (WorkspaceService.EstaAbierto)
{
    var frame = WorkspaceService.FrameActual!;
    <aside class="workspace-panel"
           role="complementary"
           aria-label="@($"Panel de contexto — {frame.TituloVisible}")"
           tabindex="-1"
           @ref="_referenciaPanel"
           @onkeydown="ManejarTeclaGlobalAsync">
        <header class="workspace-header">
            <div class="workspace-header-nav">
                @if (WorkspaceService.Pila.Count > 1)
                {
                    <button type="button" class="workspace-boton-volver" @onclick="() => WorkspaceService.VolverAsync()">
                        <Icono Nombre="volver" Tamano="TamanoIcono.Pequeno" /> Volver
                    </button>
                }
                <Breadcrumb Elementos="_elementosBreadcrumb" ElementoSeleccionadoChanged="IrABreadcrumbAsync" EtiquetaNavegacion="Ruta del Context Workspace" />
            </div>
            <div class="workspace-header-acciones">
                <button type="button" class="workspace-copiar-enlace" title="Copiar enlace a esta ficha"
                        aria-label="Copiar enlace a esta ficha" @onclick="CopiarEnlaceAsync">
                    <Icono Nombre="copiar" Tamano="TamanoIcono.Pequeno" />
                </button>
                <button type="button" class="workspace-cerrar" aria-label="Cerrar panel de contexto" @onclick="() => WorkspaceService.CerrarAsync()">×</button>
            </div>
        </header>

        <div class="workspace-cuerpo">
            @switch (frame.Tipo)
            {
                case EntidadWorkspace.Cliente:
                    <ClienteWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Empresa:
                    <EmpresaWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Subcontrata:
                    <SubcontrataWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Centro:
                    <CentroWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Trabajador:
                    <TrabajadorWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Vehiculo:
                    <VehiculoWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
                case EntidadWorkspace.Documento:
                    <DocumentoWorkspacePanel EntidadId="@frame.EntidadId" PestanaActiva="@frame.PestanaActiva" PestanaActivaChanged="CambiarPestanaAsync" />
                    break;
            }
        </div>
    </aside>
}

@code {
    private ElementReference _referenciaPanel;
    private int _profundidadAnterior;
    private IJSObjectReference? _trampaFoco;
    private bool _panelEstabaAbierto;
    private IReadOnlyList<BreadcrumbElemento> _elementosBreadcrumb = [];

    /// <summary>
    /// Parámetro de query que serializa el nivel ACTUAL del panel —
    /// <c>?ctx=Tipo:Id:pestaña</c> (05_WORKSPACE_PATTERNS.md § 3.6, primer
    /// hueco declarado: "no serializa su estado en la URL, sin deep-link, y
    /// recargar lo pierde entero").
    ///
    /// Solo el nivel actual, no la pila entera: el breadcrumb es historial de
    /// navegación de la sesión, no estado direccionable. Un enlace compartido
    /// abre esa entidad con el breadcrumb en un solo nivel — que es
    /// exactamente lo que significa "enlazar a esta ficha".
    ///
    /// Cierra de paso el segundo hueco de § 3.6 ("no se cierra al navegar por
    /// el menú principal", decisión cerrada desde 2026-07-25 que dependía de
    /// este mismo mecanismo): un enlace del menú lleva a una URL sin
    /// <c>ctx</c>, y una URL sin <c>ctx</c> significa panel cerrado.
    /// </summary>
    private const string ParametroCtx = "ctx";

    /// <summary>
    /// Último valor de <c>ctx</c> ya reflejado en el servicio — evita el bucle
    /// URL→servicio→URL: cada lado comprueba contra esto antes de escribir en
    /// el otro.
    /// </summary>
    private string? _ctxSincronizado;

    protected override void OnInitialized()
    {
        WorkspaceService.OnCambio += ManejarCambio;
        Navigation.LocationChanged += ManejarNavegacion;
        AplicarCtxDeUrl();
    }

    private void ManejarCambio()
    {
        _elementosBreadcrumb = WorkspaceService.Pila.Select(f => new BreadcrumbElemento(f.TituloVisible)).ToList();
        ActualizarUrlDesdeEstado();
        InvokeAsync(StateHasChanged);
    }

    private void ManejarNavegacion(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(() =>
        {
            AplicarCtxDeUrl();
            StateHasChanged();
        });

    /// <summary>La URL manda: sin <c>ctx</c> el panel se cierra; con <c>ctx</c> se abre en ese nivel.</summary>
    private void AplicarCtxDeUrl()
    {
        var ctx = LeerCtxDeUrl();
        if (ctx == _ctxSincronizado) return;

        _ctxSincronizado = ctx;

        if (ctx is null)
        {
            WorkspaceService.CerrarAsync();
            return;
        }

        if (!TryParsearCtx(ctx, out var tipo, out var entidadId, out var pestana))
            return;

        // Título de marcador: al restaurar desde URL todavía no sabemos el
        // nombre de la entidad (lo carga el panel concreto, que además lo pinta
        // en su propia cabecera). El breadcrumb muestra el tipo hasta entonces.
        WorkspaceService.AbrirAsync(tipo, entidadId, tipo.ToString(), pestana);
    }

    private void ActualizarUrlDesdeEstado()
    {
        var ctxDelEstado = WorkspaceService.FrameActual is { } frame
            ? $"{frame.Tipo}:{frame.EntidadId}:{frame.PestanaActiva}"
            : null;

        if (ctxDelEstado == _ctxSincronizado) return;

        _ctxSincronizado = ctxDelEstado;

        var destino = Navigation.GetUriWithQueryParameter(ParametroCtx, ctxDelEstado);
        // replace: abrir/cerrar el panel de contexto no es un paso de
        // navegación propio — con push, "Atrás" del navegador tendría que
        // deshacer cada cambio de pestaña del panel antes de salir de la página.
        Navigation.NavigateTo(destino, forceLoad: false, replace: true);
    }

    private string? LeerCtxDeUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var valor = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return valor.TryGetValue(ParametroCtx, out var encontrado) && !string.IsNullOrWhiteSpace(encontrado)
            ? encontrado.ToString()
            : null;
    }

    /// <summary>Un <c>ctx</c> corrupto (enlace viejo, tipo retirado) se ignora en silencio: mejor la página sin panel que un error.</summary>
    private static bool TryParsearCtx(string ctx, out EntidadWorkspace tipo, out Guid entidadId, out string pestana)
    {
        tipo = default;
        entidadId = default;
        pestana = string.Empty;

        var partes = ctx.Split(':');
        if (partes.Length != 3) return false;

        return Enum.TryParse(partes[0], out tipo)
               && Guid.TryParse(partes[1], out entidadId)
               && !string.IsNullOrWhiteSpace(pestana = partes[2]);
    }

    /// <summary>
    /// Activa la trampa de foco solo cuando el panel se abre desde cerrado
    /// (profundidad 0 → 1). Navegar entre niveles o pestañas ya con el panel
    /// abierto no debe robarle el foco al usuario si lo tiene en otro sitio
    /// del panel.
    ///
    /// El Context Panel no es modal y no bloquea el puntero sobre la página,
    /// pero sí es una capa de interacción: el teclado no puede escapar a la
    /// página de debajo ni perder el origen al cerrarlo (04_UX_PATTERNS.md
    /// § 11). dialogo-foco.js conserva el elemento previo, recorre los
    /// enfocables reales y lo restaura solo si aún existe en el documento.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var profundidadActual = WorkspaceService.Pila.Count;
        var seAbreDesdeCerrado = profundidadActual > 0 && _profundidadAnterior == 0;
        var seCierra = !WorkspaceService.EstaAbierto && _panelEstabaAbierto;

        // Se actualiza ANTES del await, no después: OnAfterRenderAsync no es
        // reentrant-safe por diseño (Blazor puede invocarlo de nuevo para un
        // render posterior mientras este await sigue en vuelo, típicamente
        // porque NavigateTo dentro de ManejarCambio dispara su propio
        // LocationChanged y el Router vuelve a renderizar el árbol de
        // MainLayout). Con el campo actualizado al final (como estaba antes),
        // esa segunda invocación también veía _profundidadAnterior == 0 y
        // volvía a llamar FocusAsync — dos llamadas concurrentes sobre
        // _referenciaPanel, confirmado con un diagnóstico real en CI (siempre
        // dos, no un caso raro). Si la segunda ocurre después de que Blazor
        // haya sustituido el nodo del <aside> (p. ej. bajo la carga real de
        // CI, con más renders intermedios que en local), _referenciaPanel
        // puede apuntar a un elemento ya desmontado — un FocusAsync que no
        // falla pero tampoco mueve el foco de verdad, dejándolo fuera del
        // panel y con eso el @onkeydown de Escape sin nada que lo dispare.
        // Marcar la transición ya consumida antes de ceder el control cierra
        // esa ventana: solo la primera invocación entra aquí.
        _profundidadAnterior = profundidadActual;
        _panelEstabaAbierto = WorkspaceService.EstaAbierto;

        if (seAbreDesdeCerrado)
        {
            var trampaActivada = await ActivarTrampaFocoAsync();
            if (!trampaActivada)
                await _referenciaPanel.FocusAsync();
        }
        else if (seCierra)
        {
            await LiberarTrampaFocoAsync();
        }
    }

    /// <summary>
    /// Mejor esfuerzo: Escape sigue siendo puro Blazor y conserva su cierre
    /// aunque el módulo no esté disponible durante el arranque o el cierre de
    /// un circuito. La trampa y el retorno preciso del foco requieren inspeccionar
    /// document.activeElement y por eso viven en JavaScript.
    /// </summary>
    private async Task<bool> ActivarTrampaFocoAsync()
    {
        try
        {
            var modulo = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dialogo-foco.js");
            if (modulo is null) return false;

            await using (modulo)
            {
                _trampaFoco = await modulo.InvokeAsync<IJSObjectReference>("atraparFoco", _referenciaPanel);
            }

            return _trampaFoco is not null;
        }
        catch (Exception)
        {
            return false;
        }
    }

    private async Task LiberarTrampaFocoAsync()
    {
        if (_trampaFoco is null) return;

        var trampa = _trampaFoco;
        _trampaFoco = null;

        try
        {
            await trampa.InvokeVoidAsync("dispose");
            await trampa.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task IrABreadcrumbAsync(int indice) => WorkspaceService.IrABreadcrumbAsync(indice);

    private Task CambiarPestanaAsync(string pestana) => WorkspaceService.CambiarPestanaAsync(pestana);

    private Task ManejarTeclaGlobalAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
            return Task.CompletedTask;

        return WorkspaceService.Pila.Count > 1 ? WorkspaceService.VolverAsync() : WorkspaceService.CerrarAsync();
    }

    private IJSObjectReference? _moduloClipboard;

    /// <summary>
    /// "Copiar enlace" (§ 7 punto 3 y Horizonte 2.6 de MACRO_PLAN_2026-08-13.md):
    /// como <see cref="ActualizarUrlDesdeEstado"/> ya mantiene <c>ctx</c>
    /// sincronizado con el nivel actual de la pila, la URL del navegador EN
    /// ESTE MOMENTO ya es el deep-link — no hace falta construir nada aparte,
    /// solo copiarla. Mismo módulo clipboard.js que BotonCopiar.
    /// </summary>
    private async Task CopiarEnlaceAsync()
    {
        try
        {
            _moduloClipboard ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            await _moduloClipboard.InvokeVoidAsync("copiarAlPortapapeles", Navigation.Uri);
            ToastService.Mostrar("Se copió el enlace a esta ficha al portapapeles.", TonoToast.Exito);
        }
        catch (Exception)
        {
            ToastService.Mostrar("No pudimos copiar el enlace.", TonoToast.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        WorkspaceService.OnCambio -= ManejarCambio;
        Navigation.LocationChanged -= ManejarNavegacion;

        await LiberarTrampaFocoAsync();

        if (_moduloClipboard is not null)
            await _moduloClipboard.DisposeAsync();
    }
}
