@*
    Pestaña "Documentación" reutilizada por los paneles de Cliente, Empresa,
    Trabajador y Vehículo — Documento ya modela su dueño con cuatro FKs
    excluyentes según AmbitoAplicacion (ver ObtenerDocumentosQuery), así que
    un único componente parametrizado por Ambito+PropietarioId cubre los
    cuatro casos sin duplicar la carga ni el pintado.

    Cada fila navega al Context Workspace del propio Documento — el panel
    cambia de contenido internamente, no se abre uno nuevo.
*@
@using CaeManager.Application.Documentos.Queries.ObtenerDocumentos
@using CaeManager.Domain.Documentos
@using CaeManager.Web.Features.Documentos
@using CaeManager.Web.Features.Documentos.Components
@using MediatR
@inject IMediator Mediator
@inject ContextWorkspaceService WorkspaceService
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Recursos.TextosComunes> Comunes

@* «+ Subir documento» (mockup Vehículo 360): abre el mismo DrawerGestionDocumento que
   usan Documentos, Trabajador 360 y Centro 360, con el vehículo preseleccionado.
   Crear es un ICommand que AutorizacionEscrituraBehavior deniega a Consulta. *@
@if (PermiteSubir && Ambito == AmbitoAplicacion.Vehiculo)
{
    <SoloConEscritura>
        <div class="workspace-acciones-documentacion">
            <Boton Variante="VarianteBoton.Primario" Tamano="TamanoBoton.Pequeno" OnClick="() => _drawerGestion!.AbrirCrearParaVehiculoAsync(PropietarioId)">@Comunes["SubirDocumento"]</Boton>
        </div>
    </SoloConEscritura>
    <DrawerGestionDocumento @ref="_drawerGestion" OnGuardado="CargarAsync" />
}

@if (_cargando)
{
    <EstadoCargando Filas="3" />
}
else if (_error)
{
    <EstadoVacio Titulo="No pudimos cargar la documentación" Descripcion="Intenta nuevamente en unos segundos.">
        <Accion>
            <Boton Variante="VarianteBoton.Primario" OnClick="CargarAsync">Reintentar</Boton>
        </Accion>
    </EstadoVacio>
}
else if (_documentos.Count == 0)
{
    <EstadoVacio Titulo="Sin documentos" Descripcion="Todavía no hay documentos registrados para esta entidad." />
}
else if (EnPagina)
{
    @* Ficha 360 en página: misma gramática de lista que los documentos de Trabajador 360 (tarjeta, fila con vigencia,
       pastilla de estado y acreditaciones), sin viñetas. El panel de 520 px conserva la lista de filas-botón de abajo. *@
    @if (ConFiltros)
    {
        @* Barra de la maqueta «Empresa 360» (.barra-lista): un chip por estado con su recuento y el buscador a la derecha. *@
        <div class="documentacion-barra">
            <div class="documentacion-chips" role="group" aria-label="@EtiquetaFiltros">
                <button type="button" class="documentacion-chip" aria-pressed="@(_filtroEstado is null ? "true" : "false")"
                        @onclick="() => _filtroEstado = null">@Comunes["OpcionTodos"] · @_documentos.Count</button>
                @foreach (var (texto, cantidad) in GruposDeEstado)
                {
                    <button type="button" class="documentacion-chip" aria-pressed="@(_filtroEstado == texto ? "true" : "false")"
                            @onclick="() => _filtroEstado = texto">@texto · @cantidad</button>
                }
            </div>
            <BuscadorLista Placeholder="@PlaceholderBuscador" Valor="@_busqueda" ValorChanged="v => _busqueda = v" />
        </div>
    }
    @if (DocumentosVisibles.Count == 0)
    {
        <p class="documentacion-sin-resultados">@TextoSinResultados</p>
    }
    <ListaRelaciones EnTarjeta="true" Etiqueta="@Comunes["ListaDocumentacion"]">
        @foreach (var documento in DocumentosVisibles)
        {
            @* Con ConVerDocumento (Empresa 360) el nombre es un enlace real a la ficha 360 del Documento, el panel de 520 px
               sigue a un clic en el botón 360 (el patrón de FilaRelacion) y la fila gana «Ver», que abre el visor del PDF. *@
            <FilaRelacion Compacta="true" @key="documento.Id" Nombre="@documento.TipoDocumentoNombre"
                          Tono="@EstadoDocumentoFicha360.TonoFila(documento.Estado)"
                          Href="@(ConVerDocumento ? EstadoDocumentoFicha360.RutaFicha360(documento.Id) : null)"
                          OnNombre="@(ConVerDocumento ? default : EventCallback.Factory.Create(this, () => AbrirDocumentoAsync(documento)))"
                          OnAbrir360="@(ConVerDocumento ? EventCallback.Factory.Create(this, () => AbrirDocumentoAsync(documento)) : default)">
                <Detalle><BadgesAcreditacion Acreditaciones="documento.Acreditaciones" /></Detalle>
                <Cifra><span>@TextoVence(documento)</span></Cifra>
                <Estado><Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)" Tamano="TamanoBadge.Pequeno">@EstadoDocumentoUi.Texto(documento.Estado)</Badge></Estado>
                <Acciones>
                    @if (ConVerDocumento && documento.ArchivoUrl is not null)
                    {
                        @* Acción secundaria, de enlace, para todo rol que ve la ficha (como «Ver» en la lista de Documentos). *@
                        <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="accion-fila-enlace"
                               aria-label="@EstadoDocumentoFicha360.TextoVerAccesible(documento.TipoDocumentoNombre)"
                               OnClick="() => AbrirVisor(documento)">@EstadoDocumentoFicha360.TextoVer</Boton>
                    }
                    @if (EstadoDocumentoFicha360.PideGestionar(documento.Estado))
                    {
                        <SoloConEscritura>
                            <Boton Variante="VarianteBoton.Fantasma" Tamano="TamanoBoton.Pequeno" class="@EstadoDocumentoFicha360.ClaseGestionar(documento.Estado, "accion-fila-enlace")"
                                   aria-label="@EstadoDocumentoFicha360.TextoAccionAccesible(documento.TipoDocumentoNombre)"
                                   OnClick="() => _correccion.AbrirAsync(documento.Id, null, null, null)">@EstadoDocumentoFicha360.TextoAccion</Boton>
                        </SoloConEscritura>
                    }
                </Acciones>
            </FilaRelacion>
        }
    </ListaRelaciones>
}
else
{
    <ul class="workspace-lista-entidades">
        @foreach (var documento in _documentos)
        {
            <FilaEntidadRelacionada
                @key="documento.Id"
                Titulo="@documento.TipoDocumentoNombre"
                Subtitulo="@($"Vence: {(documento.FechaVencimiento is null ? "—" : documento.FechaVencimiento.Value.ToString("dd/MM/yyyy"))}")"
                OnClic="() => AbrirDocumentoAsync(documento)">
                <Badge Tono="EstadoDocumentoUi.Tono(documento.Estado)">@EstadoDocumentoUi.Texto(documento.Estado)</Badge>
                <BadgesAcreditacion Acreditaciones="documento.Acreditaciones" />
            </FilaEntidadRelacionada>
        }
    </ul>
}

<CorreccionIncidenciaDocumental @ref="_correccion" OnCorregida="CargarAsync" />
@if (ConVerDocumento)
{
    <VisorDocumento Visible="_visorVisible" VisibleChanged="v => _visorVisible = v" DocumentoId="_visorDocumentoId" Titulo="@_visorTitulo" />
}

@code {
    private CorreccionIncidenciaDocumental _correccion = default!;
    [Parameter, EditorRequired] public AmbitoAplicacion Ambito { get; set; }
    [Parameter, EditorRequired] public Guid PropietarioId { get; set; }

    /// <summary>Ofrece «+ Subir documento». Hoy solo Vehículo 360 lo pide (y solo Vehículo lo admite).</summary>
    [Parameter] public bool PermiteSubir { get; set; }

    /// <summary>
    /// Pinta la lista como la de documentos de Trabajador 360 (tarjeta con filas de rejilla) en vez de la lista de
    /// filas-botón del panel. Solo para las fichas 360 en página; el panel de 520 px no lo pide.
    /// </summary>
    [Parameter] public bool EnPagina { get; set; }

    /// <summary>
    /// Con <see cref="EnPagina"/>, añade sobre la lista los chips por estado (con recuento) y el buscador de la maqueta
    /// «Empresa 360». Solo lo pide esa ficha; el filtrado es en memoria sobre los documentos ya cargados.
    /// </summary>
    [Parameter] public bool ConFiltros { get; set; }

    /// <summary>
    /// Con <see cref="EnPagina"/>: el nombre de cada documento enlaza a su ficha 360 (<c>/documentos/{id}</c>), el panel pasa al
    /// botón 360 y los documentos con archivo llevan «Ver» (visor del PDF sin salir de la ficha). Solo lo pide Empresa 360.
    /// </summary>
    [Parameter] public bool ConVerDocumento { get; set; }

    private bool _visorVisible;
    private Guid _visorDocumentoId;
    private string _visorTitulo = string.Empty;

    private void AbrirVisor(DocumentoListaDto documento)
    {
        _visorDocumentoId = documento.Id;
        _visorTitulo = documento.TipoDocumentoNombre;
        _visorVisible = true;
    }

    [Parameter] public string? PlaceholderBuscador { get; set; }
    [Parameter] public string? EtiquetaFiltros { get; set; }
    [Parameter] public string? TextoSinResultados { get; set; }

    private string? _filtroEstado;
    private string _busqueda = string.Empty;

    private static readonly EstadoDocumento[] OrdenEstados =
    [
        EstadoDocumento.Vencido, EstadoDocumento.EnTolerancia, EstadoDocumento.Faltante, EstadoDocumento.Urgente,
        EstadoDocumento.Proximo, EstadoDocumento.SinConfirmar, EstadoDocumento.Vigente, EstadoDocumento.SinCaducidad
    ];

    /// <summary>Estados presentes, del peor al mejor, por su rótulo (Urgente y Próximo se leen los dos «Por vencer»).</summary>
    private IReadOnlyList<(string Texto, int Cantidad)> GruposDeEstado =>
        [.. OrdenEstados.Select(e => EstadoDocumentoUi.Texto(e)).Distinct()
            .Select(t => (Texto: t, Cantidad: _documentos.Count(d => EstadoDocumentoUi.Texto(d.Estado) == t)))
            .Where(g => g.Cantidad > 0)];

    private IReadOnlyList<DocumentoListaDto> DocumentosVisibles =>
        !ConFiltros ? _documentos
        : [.. _documentos.Where(d =>
            (_filtroEstado is null || EstadoDocumentoUi.Texto(d.Estado) == _filtroEstado)
            && (string.IsNullOrWhiteSpace(_busqueda)
                || d.TipoDocumentoNombre.Contains(_busqueda.Trim(), StringComparison.CurrentCultureIgnoreCase)))];

    private DrawerGestionDocumento? _drawerGestion;

    private IReadOnlyList<DocumentoListaDto> _documentos = [];
    private bool _cargando = true;
    private bool _error;
    private (AmbitoAplicacion Ambito, Guid PropietarioId)? _claveCargada;

    /// <summary>
    /// OnParametersSetAsync (no OnInitializedAsync): el Context Workspace
    /// reutiliza esta misma instancia de componente al navegar entre dos
    /// entidades del mismo tipo (p. ej. Trabajador → Trabajador vía
    /// breadcrumb) — sin este guard por clave, la pestaña se quedaría
    /// mostrando los documentos de la entidad anterior.
    /// </summary>
    protected override Task OnParametersSetAsync()
    {
        var clave = (Ambito, PropietarioId);
        if (_claveCargada == clave)
            return Task.CompletedTask;

        _claveCargada = clave;
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = false;

        try
        {
            var resultado = await Mediator.Send(new ObtenerDocumentosQuery(
                TrabajadorId: null, Ambito: Ambito, Busqueda: null, TamanoPagina: 50, PropietarioId: PropietarioId));
            _documentos = resultado.Elementos;
        }
        catch (Exception)
        {
            _error = true;
        }
        finally
        {
            _cargando = false;
            // Tras recargar (p. ej. al corregir una incidencia) el estado filtrado puede haber desaparecido: sin
            // este reinicio la lista quedaría vacía y ningún chip, ni «Todos», aparecería activo.
            if (_filtroEstado is not null && !GruposDeEstado.Any(g => g.Texto == _filtroEstado))
                _filtroEstado = null;
        }
    }

    /// <summary>
    /// En el panel el Documento se apila sobre la entidad (volver regresa a ella); en la página 360 no hay nada que
    /// apilar, así que el panel se abre directamente sobre el Documento.
    /// </summary>
    private Task AbrirDocumentoAsync(DocumentoListaDto documento) =>
        EnPagina
            ? WorkspaceService.AbrirAsync(EntidadWorkspace.Documento, documento.Id, documento.TipoDocumentoNombre, "informacion")
            : WorkspaceService.NavegarAAsync(EntidadWorkspace.Documento, documento.Id, documento.TipoDocumentoNombre, "informacion");

    private static string TextoVence(DocumentoListaDto documento) =>
        DetalleVigenciaDocumentoUi.DeFicha360(documento.Estado, documento.FechaVencimiento,
            documento.TipoDocumentoNombre, deEmpresa: documento.Ambito == AmbitoAplicacion.Empresa);
}
