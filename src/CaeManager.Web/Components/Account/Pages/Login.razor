@page "/cuenta/iniciar-sesion"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using CaeManager.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IOptions<AzureAdOptions> OpcionesAzureAd
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Components.Account.Recursos.TextosCuenta> Textos
@inject ILoggerFactory LoggerFactory

<PageTitle>Iniciar sesión — @Marca.Nombre</PageTitle>

@* Pantalla contra el artefacto aprobado «Luz de agua» (el acceso hecho junto a
   la web oficial), no contra «Iniciar Sesion TALVEG.dc.html». El artefacto no
   pinta errores, validación ni SSO: ese comportamiento es del código y se
   conserva tal cual. El lockup es el activo final de marca, vectorizado: no
   depende de ninguna fuente. *@
<div class="acceso-tarjeta">
    <CabeceraAcceso />

    @if (mensajeErrorSso is not null)
    {
        <div class="acceso-alerta" role="alert">@mensajeErrorSso</div>
    }

    @if (Entrada is not null)
    {
        @* novalidate: la validación la dice el servidor, con sus mensajes, en
           vez de la burbuja nativa que traería type="email". *@
        <EditForm Model="Entrada" method="post" OnValidSubmit="IniciarSesionAsync" FormName="iniciar-sesion" novalidate>
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="acceso-alerta" role="alert">@mensajeError</div>
            }

            <div class="acceso-campo">
                <label for="email">Correo electrónico</label>
                <InputText id="email" type="email" @bind-Value="Entrada.Email" autocomplete="username" />
                <ValidationMessage For="() => Entrada.Email" />
            </div>

            <div class="acceso-campo">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="Entrada.Password" autocomplete="current-password" />
                <ValidationMessage For="() => Entrada.Password" />
            </div>

            <button type="submit" class="acceso-entrar">Iniciar sesión</button>
        </EditForm>
    }

    @* Sin AzureAd configurado el enlace ni se muestra — el login local sigue
       siendo el único camino (mismo principio "inerte por defecto" que
       Sentry/Backups/Anthropic). Ver RestriccionLoginLocalClaimsTransformation:
       una vez configurado, el login local deja de dar rol de edición a las
       cuentas del Tenant propietario declarado para el inicio con Microsoft (ver
       AzureAdOptions; las de otros Tenants
       conservan su rol), y la nota lo dice antes de que alguien entre y no pueda
       editar. *@
    @if (OpcionesAzureAd.Value.EstaConfigurado)
    {
        @* Botón de inicio de sesión con Microsoft según la guía de marca de Microsoft
           Learn (howto-add-branding-in-apps): logotipo de cuatro cuadrados sin
           alterar y el texto «Iniciar sesión con Microsoft». El SVG es decorativo:
           el nombre accesible lo da el texto. Sin scripts (CSP script-src 'self'). *@
        <p class="acceso-separador" aria-hidden="true"><span>@Textos["LoginMicrosoftSeparador"]</span></p>
        <a class="acceso-microsoft" href="@EnlaceLoginMicrosoft">
            <svg class="acceso-microsoft-logo" width="21" height="21" viewBox="0 0 21 21" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="10" height="10" fill="#F25022" />
                <rect x="11" y="0" width="10" height="10" fill="#7FBA00" />
                <rect x="0" y="11" width="10" height="10" fill="#00A4EF" />
                <rect x="11" y="11" width="10" height="10" fill="#FFB900" />
            </svg>
            <span>@Textos["LoginMicrosoftIniciarSesion"]</span>
        </a>
        <p class="acceso-nota">Con correo y contraseña, el acceso es solo de consulta.</p>
    }

    <p class="acceso-olvido"><a href="/cuenta/olvide-contrasena">¿Olvidaste tu contraseña?</a></p>
</div>

@code {
    private string? mensajeError;
    private string? mensajeErrorSso;

    [SupplyParameterFromForm]
    private DatosEntrada? Entrada { get; set; }

    // Página SSR estática: el HttpContext de la petición del formulario, en el
    // que SignInManager ya escribe la cookie de autenticación.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? ErrorSso { get; set; }

    // Único sitio que llama a DestinoTrasLogin: tanto el fin del login como el redirect de quien ya
    // tiene sesión aterrizan con la marca de un solo uso (AterrizajeTrasLoginLlevaLaMarcaTests).
    private string DestinoFinal => RedireccionLocal.DestinoTrasLogin(ReturnUrl);

    private string EnlaceLoginMicrosoft => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/cuenta/iniciar-sesion-microsoft"
        : $"/cuenta/iniciar-sesion-microsoft?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override void OnInitialized()
    {
        Entrada ??= new DatosEntrada();
        // D-09: con sesión iniciada, la página de login no se muestra: se redirige a donde iba
        // (ReturnUrl, saneado como en el login) o al inicio. Solo en la petición GET: el POST del
        // formulario lo gestiona IniciarSesionAsync, y una cuenta con 2FA pendiente todavía no
        // está autenticada (no hay identidad hasta completar el segundo factor).
        if (HttpContext is { Request.Method: "GET" } contexto && contexto.User.Identity?.IsAuthenticated == true)
        {
            // Un returnUrl que apunta al propio login (enlace manual) daría un bucle: se va al inicio.
            var vuelveAlLogin = ReturnUrl?.StartsWith("/cuenta/iniciar-sesion", StringComparison.OrdinalIgnoreCase) == true;
            Navigation.NavigateTo(vuelveAlLogin ? "/" : DestinoFinal, forceLoad: true);
            return;
        }
        mensajeErrorSso = ErrorSso switch
        {
            // La marca va como argumento: dentro de una cadena C# «@Marca.Nombre» no
            // es Razor, es texto, y así llegaba a la pantalla. «sin-cuenta» es también
            // la cuenta de otro Tenant, la desactivada y la ya vinculada a otra identidad:
            // no se confirma que exista (D-3).
            "sin-cuenta" => Textos["LoginErrorSsoSinCuenta", Marca.Nombre].Value,
            "sin-mfa" => Textos["LoginErrorSsoSinSegundoFactor", Marca.Nombre].Value,
            "fallo" => Textos["LoginErrorSsoFallo"].Value,
            _ => null,
        };
    }

    private async Task IniciarSesionAsync()
    {
        if (Entrada is null) return;

        // Antes de que exista Tenant: la cuenta se busca por su clave bajo la RLS
        // de AspNetUsers (ver AmbitoIdentificacionSinTenant, P1-M1).
        using var identificacion = AmbitoIdentificacionSinTenant.Abrir();

        // lockoutOnFailure: los intentos fallidos cuentan y bloquean la
        // cuenta temporalmente (ver opciones Lockout en
        // InfrastructureServiceCollectionExtensions). Convive con el uso de
        // LockoutEnd = MaxValue como "usuario desactivado" (Usuarios.razor):
        // el bloqueo por intentos pone una ventana corta, la desactivación
        // manual una indefinida — ambos caen en IsLockedOut.
        var resultado = await SignInManager.PasswordSignInAsync(
            Entrada.Email, Entrada.Password, isPersistent: false, lockoutOnFailure: true);
        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);

        // El correo NO entra en el registro de autenticación. Serilog lo
        // persiste en fichero y en Seq, dos superficies con permisos y
        // retención propios: cada línea replicaba un dato personal fuera de la
        // base de datos y ampliaba el alcance RGPD de logs, copias e
        // incidentes. Se registra el UsuarioId, que es opaco, estable y ya
        // existía — así no se pierde nada de la correlación forense: seguir la
        // pista de los intentos contra una misma cuenta sigue siendo posible.
        // Para una cuenta que no existe no hay nada que correlacionar ni nadie
        // a quien proteger, y se dice justamente eso.
        var cuenta = await UserManager.FindByEmailAsync(Entrada.Email);
        var idCuenta = cuenta?.Id.ToString() ?? "desconocida";

        if (resultado.IsLockedOut)
        {
            // Literalmente el mismo mensaje que credenciales inválidas (más
            // abajo) — no un texto parecido: una diferencia de wording, por
            // mínima que sea, deja enumerar qué cuentas existen y están
            // bloqueadas tras varios intentos, justo lo que esto evita. Esa
            // simetría es del mensaje al USUARIO; el log sí distingue, porque
            // no lo ve quien ataca.
            logger.LogWarning("Login rechazado, cuenta bloqueada: {UsuarioId}", idCuenta);
            mensajeError = MensajeErrorLogin;
            return;
        }

        if (resultado.RequiresTwoFactor)
        {
            logger.LogInformation("Login con contraseña correcto, pendiente de 2FA: {UsuarioId}", idCuenta);

            var destino = "/cuenta/verificar-2fa";
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
                destino += $"?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}";

            Navigation.NavigateTo(destino, forceLoad: true);
            return;
        }

        if (resultado.Succeeded)
        {
            // El propio guard de MainLayout haría cumplir esto en la
            // siguiente navegación aunque no se comprobara aquí, pero
            // resolverlo ya en el login evita un salto visible de "/" (o
            // ReturnUrl) a la pantalla de cambio de contraseña.
            logger.LogInformation("Login correcto: {UsuarioId}", idCuenta);

            // La cookie de cultura es una proyección de ApplicationUser.Idioma
            // (ver CulturaUsuarioCookie): se reconstruye en cada inicio de
            // sesión, así que un navegador nuevo o sin cookies no pierde la
            // preferencia y un usuario anterior en este navegador no la deja
            // heredada.
            if (cuenta is not null && HttpContext is not null)
                CulturaUsuarioCookie.Escribir(HttpContext, cuenta.Idioma);

            if (cuenta is { DebeCambiarContrasena: true })
            {
                Navigation.NavigateTo("/cuenta/cambiar-contrasena", forceLoad: true);
                return;
            }

            Navigation.NavigateTo(DestinoFinal, forceLoad: true);
            return;
        }

        logger.LogWarning("Login fallido (credenciales inválidas): {UsuarioId}", idCuenta);
        mensajeError = MensajeErrorLogin;
    }

    /// <summary>
    /// Un único texto para credenciales inválidas y cuenta bloqueada —
    /// distinguirlos permitiría enumerar cuentas existentes y bloqueadas
    /// (hallazgo de la auditoría de PR #48 sobre P0-2; ASVS 4.0.3 V2.2, OWASP A07).
    /// El texto ofrece además una salida común a ambos casos —restablecer la
    /// contraseña o consultar con quien gestiona su acceso en su organización—:
    /// quien tiene la cuenta desactivada (<c>LockoutEnd = MaxValue</c>) no debe
    /// reintentar sin fin ante un mensaje que solo le dice «revisa tus datos»,
    /// y como el texto es el mismo para ambos, la salida no revela cuál de los
    /// dos casos es.
    /// </summary>
    private const string MensajeErrorLogin = "No pudimos iniciar sesión. Revisa tu correo y contraseña. Si sigue sin funcionar, restablece tu contraseña o consulta con quien gestiona tu acceso en tu organización.";

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
