@page "/cuenta/iniciar-sesion"
@layout CaeManager.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IOptions<AzureAdOptions> OpcionesAzureAd

<PageTitle>Iniciar sesión — CAE Manager</PageTitle>

<div class="tarjeta-login">
    <h1>CAE Manager</h1>
    <p class="subtitulo-login">Coordinación de Actividades Empresariales</p>

    @if (mensajeErrorSso is not null)
    {
        <div class="alerta-login" role="alert">@mensajeErrorSso</div>
    }

    @* Sin AzureAd configurado el botón ni se muestra — el login local sigue
       siendo el único camino (mismo principio "inerte por defecto" que
       Sentry/Backups/Anthropic). Ver RestriccionLoginLocalClaimsTransformation:
       una vez configurado, el login local deja de dar rol de edición. *@
    @if (OpcionesAzureAd.Value.EstaConfigurado)
    {
        <a class="boton-primario boton-microsoft" href="@EnlaceLoginMicrosoft">Iniciar sesión con Microsoft</a>
        <p class="separador-login">o con tu correo y contraseña (acceso solo de consulta)</p>
    }

    @if (Entrada is not null)
    {
        <EditForm Model="Entrada" method="post" OnValidSubmit="IniciarSesionAsync" FormName="iniciar-sesion">
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="alerta-login" role="alert">@mensajeError</div>
            }

            <label for="email">Correo electrónico</label>
            <InputText id="email" @bind-Value="Entrada.Email" autocomplete="username" />
            <ValidationMessage For="() => Entrada.Email" />

            <label for="password">Contraseña</label>
            <InputText id="password" type="password" @bind-Value="Entrada.Password" autocomplete="current-password" />
            <ValidationMessage For="() => Entrada.Password" />

            <button type="submit" class="boton-primario">Iniciar sesión</button>
        </EditForm>
    }
</div>

@code {
    private string? mensajeError;
    private string? mensajeErrorSso;

    [SupplyParameterFromForm]
    private DatosEntrada? Entrada { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? ErrorSso { get; set; }

    private string EnlaceLoginMicrosoft => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/cuenta/iniciar-sesion-microsoft"
        : $"/cuenta/iniciar-sesion-microsoft?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override void OnInitialized()
    {
        Entrada ??= new DatosEntrada();
        mensajeErrorSso = ErrorSso switch
        {
            "sin-cuenta" => "Tu cuenta de Microsoft no está dada de alta en CAE Manager. Contacta con tu administrador.",
            "fallo" => "No pudimos completar el inicio de sesión con Microsoft. Intenta nuevamente.",
            _ => null,
        };
    }

    private async Task IniciarSesionAsync()
    {
        if (Entrada is null) return;

        var resultado = await SignInManager.PasswordSignInAsync(
            Entrada.Email, Entrada.Password, isPersistent: true, lockoutOnFailure: false);

        if (resultado.RequiresTwoFactor)
        {
            var destino = "/cuenta/verificar-2fa";
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
                destino += $"?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}";

            Navigation.NavigateTo(destino, forceLoad: true);
            return;
        }

        if (resultado.Succeeded)
        {
            // El propio guard de MainLayout haría cumplir esto en la
            // siguiente navegación aunque no se comprobara aquí, pero
            // resolverlo ya en el login evita un salto visible de "/" (o
            // ReturnUrl) a la pantalla de cambio de contraseña.
            var usuario = await UserManager.FindByEmailAsync(Entrada.Email);
            if (usuario is { DebeCambiarContrasena: true })
            {
                Navigation.NavigateTo("/cuenta/cambiar-contrasena", forceLoad: true);
                return;
            }

            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            return;
        }

        mensajeError = "No pudimos iniciar sesión. Revisa tu correo y contraseña e intenta nuevamente.";
    }

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
