@page "/cuenta/iniciar-sesion"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IOptions<AzureAdOptions> OpcionesAzureAd
@inject ILoggerFactory LoggerFactory

<PageTitle>Iniciar sesión — @Marca.Nombre</PageTitle>

@* Pantalla contra el artefacto aprobado «Luz de agua» (el acceso hecho junto a
   la web oficial), no contra «Iniciar Sesion TALVEG.dc.html». El artefacto no
   pinta errores, validación ni SSO: ese comportamiento es del código y se
   conserva tal cual. El lockup es el activo final de marca, vectorizado: no
   depende de ninguna fuente. *@
<div class="acceso-tarjeta">
    <CabeceraAcceso />

    @if (mensajeErrorSso is not null)
    {
        <div class="acceso-alerta" role="alert">@mensajeErrorSso</div>
    }

    @if (Entrada is not null)
    {
        @* novalidate: la validación la dice el servidor, con sus mensajes, en
           vez de la burbuja nativa que traería type="email". *@
        <EditForm Model="Entrada" method="post" OnValidSubmit="IniciarSesionAsync" FormName="iniciar-sesion" novalidate>
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="acceso-alerta" role="alert">@mensajeError</div>
            }

            <div class="acceso-campo">
                <label for="email">Correo electrónico</label>
                <InputText id="email" type="email" @bind-Value="Entrada.Email" autocomplete="username" />
                <ValidationMessage For="() => Entrada.Email" />
            </div>

            <div class="acceso-campo">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="Entrada.Password" autocomplete="current-password" />
                <ValidationMessage For="() => Entrada.Password" />
            </div>

            <button type="submit" class="acceso-entrar">Entrar</button>
        </EditForm>
    }

    @* Sin AzureAd configurado el enlace ni se muestra — el login local sigue
       siendo el único camino (mismo principio "inerte por defecto" que
       Sentry/Backups/Anthropic). Ver RestriccionLoginLocalClaimsTransformation:
       una vez configurado, el login local deja de dar rol de edición, y la nota
       lo dice antes de que alguien entre y no pueda editar. *@
    @if (OpcionesAzureAd.Value.EstaConfigurado)
    {
        <p class="acceso-alterno">o <a href="@EnlaceLoginMicrosoft">continuar con Microsoft</a></p>
        <p class="acceso-nota">Con correo y contraseña, el acceso es solo de consulta.</p>
    }

    <p class="acceso-olvido"><a href="/cuenta/olvide-contrasena">¿Has olvidado la contraseña?</a></p>
</div>

@code {
    private string? mensajeError;
    private string? mensajeErrorSso;

    [SupplyParameterFromForm]
    private DatosEntrada? Entrada { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? ErrorSso { get; set; }

    private string EnlaceLoginMicrosoft => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/cuenta/iniciar-sesion-microsoft"
        : $"/cuenta/iniciar-sesion-microsoft?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override void OnInitialized()
    {
        Entrada ??= new DatosEntrada();
        mensajeErrorSso = ErrorSso switch
        {
            // Interpolado: dentro de una cadena C# «@Marca.Nombre» no es Razor,
            // es texto, y así llegaba a la pantalla.
            "sin-cuenta" => $"Tu cuenta de Microsoft no está dada de alta en {Marca.Nombre}. Contacta con tu administrador.",
            "fallo" => "No pudimos completar el inicio de sesión con Microsoft. Intenta nuevamente.",
            _ => null,
        };
    }

    private async Task IniciarSesionAsync()
    {
        if (Entrada is null) return;

        // lockoutOnFailure: los intentos fallidos cuentan y bloquean la
        // cuenta temporalmente (ver opciones Lockout en
        // InfrastructureServiceCollectionExtensions). Convive con el uso de
        // LockoutEnd = MaxValue como "usuario desactivado" (Usuarios.razor):
        // el bloqueo por intentos pone una ventana corta, la desactivación
        // manual una indefinida — ambos caen en IsLockedOut.
        var resultado = await SignInManager.PasswordSignInAsync(
            Entrada.Email, Entrada.Password, isPersistent: true, lockoutOnFailure: true);
        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);

        // El correo NO entra en el registro de autenticación. Serilog lo
        // persiste en fichero y en Seq, dos superficies con permisos y
        // retención propios: cada línea replicaba un dato personal fuera de la
        // base de datos y ampliaba el alcance RGPD de logs, copias e
        // incidentes. Se registra el UsuarioId, que es opaco, estable y ya
        // existía — así no se pierde nada de la correlación forense: seguir la
        // pista de los intentos contra una misma cuenta sigue siendo posible.
        // Para una cuenta que no existe no hay nada que correlacionar ni nadie
        // a quien proteger, y se dice justamente eso.
        var cuenta = await UserManager.FindByEmailAsync(Entrada.Email);
        var idCuenta = cuenta?.Id.ToString() ?? "desconocida";

        if (resultado.IsLockedOut)
        {
            // Literalmente el mismo mensaje que credenciales inválidas (más
            // abajo) — no un texto parecido: una diferencia de wording, por
            // mínima que sea, deja enumerar qué cuentas existen y están
            // bloqueadas tras varios intentos, justo lo que esto evita. Esa
            // simetría es del mensaje al USUARIO; el log sí distingue, porque
            // no lo ve quien ataca.
            logger.LogWarning("Login rechazado, cuenta bloqueada: {UsuarioId}", idCuenta);
            mensajeError = MensajeErrorLogin;
            return;
        }

        if (resultado.RequiresTwoFactor)
        {
            logger.LogInformation("Login con contraseña correcto, pendiente de 2FA: {UsuarioId}", idCuenta);

            var destino = "/cuenta/verificar-2fa";
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
                destino += $"?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}";

            Navigation.NavigateTo(destino, forceLoad: true);
            return;
        }

        if (resultado.Succeeded)
        {
            // El propio guard de MainLayout haría cumplir esto en la
            // siguiente navegación aunque no se comprobara aquí, pero
            // resolverlo ya en el login evita un salto visible de "/" (o
            // ReturnUrl) a la pantalla de cambio de contraseña.
            logger.LogInformation("Login correcto: {UsuarioId}", idCuenta);

            if (cuenta is { DebeCambiarContrasena: true })
            {
                Navigation.NavigateTo("/cuenta/cambiar-contrasena", forceLoad: true);
                return;
            }

            Navigation.NavigateTo(RedireccionLocal.Sanear(ReturnUrl), forceLoad: true);
            return;
        }

        logger.LogWarning("Login fallido (credenciales inválidas): {UsuarioId}", idCuenta);
        mensajeError = MensajeErrorLogin;
    }

    /// <summary>
    /// Un único texto para credenciales inválidas y cuenta bloqueada —
    /// distinguirlos permitiría enumerar cuentas existentes y bloqueadas
    /// (hallazgo de la auditoría de PR #48 sobre P0-2).
    /// </summary>
    private const string MensajeErrorLogin = "No pudimos iniciar sesión. Revisa tu correo y contraseña e intenta nuevamente.";

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}
