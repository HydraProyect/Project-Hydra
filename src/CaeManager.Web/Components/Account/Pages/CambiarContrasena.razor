@page "/cuenta/cambiar-contrasena"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CaeManager.Application.Common
@using CaeManager.Infrastructure.Coordinacion
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IRegistroSesionesUsuario Sesiones
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IOptions<IdentityOptions> OpcionesIdentity
@inject ILoggerFactory LoggerFactory
@inject IEleccionLiderService CerrojoCredencial
@inject IClienteActivoSeleccionado Seleccion
@inject Microsoft.Extensions.Localization.IStringLocalizer<CaeManager.Web.Components.Account.Recursos.TextosCuenta> Textos

<PageTitle>Cambiar contraseña — @Marca.Nombre</PageTitle>

<div class="acceso-tarjeta">
    <CabeceraAcceso Titulo="Cambiar contraseña" Explicacion="@Explicacion" />

    @if (Entrada is not null)
    {
        <EditForm Model="Entrada" method="post" OnValidSubmit="CambiarContrasenaAsync" FormName="cambiar-contrasena" novalidate>
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="acceso-alerta" role="alert">@mensajeError</div>
            }

            <div class="acceso-campo">
                <label for="password-actual">Contraseña actual</label>
                <InputText id="password-actual" type="password" @bind-Value="Entrada.ContrasenaActual" autocomplete="current-password" />
                <ValidationMessage For="() => Entrada.ContrasenaActual" />
            </div>

            <div class="acceso-campo">
                <label for="password-nueva">Contraseña nueva</label>
                <InputText id="password-nueva" type="password" @bind-Value="Entrada.ContrasenaNueva" autocomplete="new-password" aria-describedby="password-nueva-requisitos" />
                <ValidationMessage For="() => Entrada.ContrasenaNueva" />
            </div>

            <RequisitosContrasena IdCampo="password-nueva" Politica="OpcionesIdentity.Value.Password" Valor="@Entrada.ContrasenaNueva" />

            <div class="acceso-campo">
                <label for="password-confirmar">Confirma la contraseña nueva</label>
                <InputText id="password-confirmar" type="password" @bind-Value="Entrada.ConfirmarContrasenaNueva" autocomplete="new-password" />
                <ValidationMessage For="() => Entrada.ConfirmarContrasenaNueva" />
                <p class="acceso-coincidencia" data-coincidencia-de="password-confirmar" data-coincidencia-con="password-nueva" aria-live="polite"></p>
            </div>

            <button type="submit" class="acceso-entrar">Cambiar contraseña</button>
        </EditForm>

        @* Con DebeCambiarContrasena el guard de MainLayout devuelve aquí cualquier
           navegación, así que «Volver» no llevaría a ningún sitio y la única salida es
           cerrar sesión (el mismo POST que la cabecera y Pendiente de Rol). «Volver» solo
           se pinta a quien llega por voluntad propia desde «Mi cuenta» (FS-16). *@
        @if (EsCambioVoluntario)
        {
            <p class="acceso-alterno"><a class="acceso-enlace-boton" href="/" data-enhance-nav="false">@Textos["CambiarContrasenaVolverSinCambiarla"]</a></p>
        }
        <form class="acceso-alterno" method="post" action="/cuenta/cerrar-sesion">
            <AntiforgeryToken />
            <button type="submit" class="acceso-enlace-boton">Cerrar sesión</button>
        </form>
    }
</div>

@code {
    private string? mensajeError;

    [SupplyParameterFromForm]
    private DatosEntrada? Entrada { get; set; }

    // FS-16: el menú de usuario enlaza aquí con ?motivo=mi-cuenta (RutasMiCuenta). Solo
    // decide el texto de la cabecera y si se ofrece «Volver»; no autoriza ni exime de nada.
    [SupplyParameterFromQuery(Name = "motivo")]
    private string? Motivo { get; set; }

    private bool EsCambioVoluntario => Motivo == RutasMiCuenta.MotivoMiCuenta;

    private string Explicacion => EsCambioVoluntario
        ? Textos["CambiarContrasenaVoluntarioExplicacion", OpcionesIdentity.Value.Password.RequiredLength].Value
        : "Tienes que cambiar tu contraseña antes de continuar.";

    protected override void OnInitialized() => Entrada ??= new DatosEntrada();

    private async Task CambiarContrasenaAsync()
    {
        // Coherencia con el rol de solo lectura que TenantRlsConnectionInterceptor adopta con esta misma coordenada:
        // la guarda da un mensaje y un aviso en vez del fallo de Postgres (ASVS 4.0.3 V4.1.5). Una selección caducada,
        // retirada o de otro usuario ya llega aquí como null (LeerCargaUtil y el middleware de revalidación).
        if (Seleccion.SesionPrivilegiadaIdSeleccionada is { } sesionId)
        {
            LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog).LogWarning(
                "Cambio de contraseña denegado durante la Sesión Privilegiada {SesionPrivilegiadaId}.", sesionId);
            mensajeError = Textos["SesionPrivilegiadaCambiarContrasena"];
            return;
        }
        if (Entrada is null) return;

        if (Entrada.ContrasenaNueva != Entrada.ConfirmarContrasenaNueva)
        {
            mensajeError = "La confirmación no coincide con la contraseña nueva.";
            return;
        }

        // La política sale de IdentityOptions, la misma que aplica ChangePasswordAsync
        // al guardar (antes el modelo pedía MinLength(8) y la política exige 12): así el
        // formulario no acepta lo que Identity va a rechazar, y el motivo sale en
        // castellano en vez de con la descripción en inglés de IdentityResult.
        var incumplidos = ReglasContrasena.Evaluar(OpcionesIdentity.Value.Password, Entrada.ContrasenaNueva)
            .Where(r => !r.Cumplido)
            .Select(r => r.Etiqueta.ToLowerInvariant())
            .ToList();
        if (incumplidos.Count > 0)
        {
            mensajeError = $"La contraseña nueva no cumple los requisitos: {string.Join(", ", incumplidos)}.";
            return;
        }

        var estadoAutenticacion = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var idClaim = estadoAutenticacion.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(idClaim, out var id))
        {
            mensajeError = "No pudimos identificar tu sesión. Vuelve a iniciar sesión.";
            return;
        }

        var usuario = await UserManager.FindByIdAsync(id.ToString());
        if (usuario is null)
        {
            mensajeError = "No pudimos identificar tu sesión. Vuelve a iniciar sesión.";
            return;
        }

        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);

        // Cerrojo no bloqueante compartido con RestablecerContrasena.razor.cs
        // bajo la misma clave `credencial:{userId}` — las dos pantallas mutan
        // la misma credencial de Identity, así que un cambio autenticado y un
        // restablecimiento que coincidan en el tiempo para el mismo usuario
        // también deben excluirse entre sí. NO comparte clave con
        // `verificar-2fa:{userId}` (cerrojo distinto, en LoginCon2fa): son
        // operaciones distintas y no hay motivo para que una bloquee a la
        // otra.
        //
        // Se adquiere ANTES de tocar ChangePasswordAsync: el competidor se
        // rechaza sin gastar ningún intento contra Identity.
        IdentityResult? resultadoObtenido = null;
        var verificacionFallida = false;
        var ejecutado = await CerrojoCredencial.IntentarEjecutarComoLiderAsync(
            $"credencial:{usuario.Id}",
            async _ =>
            {
                if (await UserManager.IsLockedOutAsync(usuario))
                {
                    verificacionFallida = true;
                    return;
                }
                // Se fija ANTES de ChangePasswordAsync, sobre la misma
                // instancia de usuario que la operación va a actualizar: así
                // Identity persiste el fin del cambio obligatorio en la MISMA
                // actualización que la contraseña, sin un UpdateAsync
                // posterior separado. Ese segundo UpdateAsync era el estado
                // parcial: si fallaba, la contraseña ya había cambiado pero
                // DebeCambiarContrasena seguía en true. Si ChangePasswordAsync
                // falla (contraseña actual incorrecta, política de
                // contraseña), no se persiste nada — ni la contraseña ni esta
                // bandera en memoria — porque Identity no llega a guardar.
                var cambioObligatorio = usuario.DebeCambiarContrasena;
                usuario.DebeCambiarContrasena = false;
                resultadoObtenido = await UserManager.ChangePasswordAsync(usuario, Entrada.ContrasenaActual, Entrada.ContrasenaNueva);
                if (!resultadoObtenido.Succeeded)
                {
                    usuario.DebeCambiarContrasena = cambioObligatorio;
                    if (resultadoObtenido.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.PasswordMismatch)))
                    {
                        verificacionFallida = true;
                        await UserManager.AccessFailedAsync(usuario);
                    }
                }
                else if (await UserManager.GetAccessFailedCountAsync(usuario) > 0)
                {
                    // Como un login correcto: acertar la contraseña actual pone el contador a cero.
                    await UserManager.ResetAccessFailedCountAsync(usuario);
                }
            },
            CancellationToken.None);

        if (!ejecutado)
        {
            logger.LogWarning(
                "Cambio de contraseña rechazado, ya había una operación de credencial en curso: {UsuarioId}", usuario.Id);
            mensajeError = "Ya hay una operación sobre esta cuenta en curso. Espera un momento e inténtalo de nuevo.";
            return;
        }

        if (verificacionFallida)
        {
            // Un único mensaje para contraseña actual incorrecta y cuenta bloqueada, como en
            // el login; el registro sí lo deja anotado (S-A-9).
            logger.LogWarning(
                "Cambio de contraseña rechazado, contraseña actual incorrecta o cuenta bloqueada: {UsuarioId}", usuario.Id);
            mensajeError = Textos["CambiarContrasenaVerificacionFallida"];
            return;
        }

        // ejecutado == true garantiza que el delegado corrió y asignó el resultado.
        var resultado = resultadoObtenido!;
        if (!resultado.Succeeded)
        {
            mensajeError = string.Join(" ", resultado.Errors.Select(e => e.Description));
            return;
        }

        // ASVS 4.0.3 V3.3.3: esta sesión sigue y las demás se revocan. El sello rotado no basta: durante
        // el intervalo de revalidación, una cookie robada de una sesión sin revocar puede llegar a
        // RefreshSignInAsync y salir con el sello nuevo. Un fallo se propaga, como en
        // CierreSesionEnServidor, y sin refresco esta cookie cae en la siguiente revalidación.
        await Sesiones.CerrarLasDemasAsync(usuario.Id, SignInManagerCuentaDesactivada.LeerSid(estadoAutenticacion.User));

        // Reemite la cookie de autenticación tras el cambio de credencial —
        // práctica estándar de Identity (rota el security stamp) aunque el
        // guard de MainLayout ya relee DebeCambiarContrasena de la base de
        // datos en cada navegación, no de un claim cacheado.
        await SignInManager.RefreshSignInAsync(usuario);

        // El cambio obligatorio es el último paso del inicio de sesión: aterriza con
        // la marca de un solo uso, igual que Login y LoginCon2fa.
        Navigation.NavigateTo(RedireccionLocal.DestinoTrasLogin(null), forceLoad: true);
    }

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "Introduce tu contraseña actual.")]
        public string ContrasenaActual { get; set; } = string.Empty;

        [Required(ErrorMessage = "Introduce la contraseña nueva.")]
        public string ContrasenaNueva { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la contraseña nueva.")]
        public string ConfirmarContrasenaNueva { get; set; } = string.Empty;
    }
}
