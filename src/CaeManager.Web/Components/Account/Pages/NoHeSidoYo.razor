@page "/cuenta/no-he-sido-yo"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using CaeManager.Infrastructure.Seguridad
@using CaeManager.Web.Components.Account.Recursos
@inject IVigilanciaInicioSesion Vigilancia
@inject IStringLocalizer<TextosCuenta> Textos

@* Destino del enlace «no he sido yo» del aviso de inicio de sesión inusual.
   El GET no cambia nada: los antivirus y las vistas previas del correo abren
   los enlaces por su cuenta, y si abrirlo bastara, cualquier escáner cerraría
   las sesiones de la persona. Lo que actúa es el POST del botón (con
   antiforgery), y el token lo comprueba VigilanciaInicioSesionService. La
   página no promete un correo que no salió: el texto sigue al desenlace.
   Sin guarda de Sesión Privilegiada a propósito: la autoridad es el token del
   buzón y la página no añade una barrera propia por la cookie de selección. Lo
   que esa selección cambie por debajo (rol de la conexión, Tenant de la búsqueda)
   lo resuelve VigilanciaInicioSesionService. *@

<PageTitle>@Textos["NoHeSidoYoTituloPagina"] — @Marca.Nombre</PageTitle>

<div class="acceso-tarjeta">
    @if (_resultado == ResultadoNoHeSidoYo.EnlaceNoValido)
    {
        <CabeceraAcceso Titulo="@Textos["NoHeSidoYoEnlaceNoValidoTitulo"]"
                        Explicacion="@Textos["NoHeSidoYoEnlaceNoValidoExplicacion"]" />
        <a class="acceso-entrar" href="/cuenta/olvide-contrasena">@Textos["NoHeSidoYoCambiarContrasena"]</a>
    }
    else if (_resultado == ResultadoNoHeSidoYo.SesionesSinCerrar)
    {
        <CabeceraAcceso Titulo="@Textos["NoHeSidoYoSesionesSinCerrarTitulo"]"
                        Explicacion="@Textos["NoHeSidoYoSesionesSinCerrarExplicacion"]" />
    }
    else if (_resultado is { } resultado)
    {
        <CabeceraAcceso />
        <span class="acceso-exito" aria-hidden="true"><Icono Nombre="check" Tamano="TamanoIcono.Grande" /></span>
        <h2 class="acceso-titulo">@Textos["NoHeSidoYoProtegidaTitulo"]</h2>
        <p class="acceso-explica">@Textos[ClaveExplicacion(resultado)]</p>
        @if (resultado == ResultadoNoHeSidoYo.ProtegidaSinCorreo)
        {
            <a class="acceso-entrar" href="/cuenta/olvide-contrasena">@Textos["NoHeSidoYoPedirEnlace"]</a>
        }
    }
    else
    {
        <CabeceraAcceso Titulo="@Textos["NoHeSidoYoPreguntaTitulo"]"
                        Explicacion="@Textos["NoHeSidoYoPreguntaExplicacion"]" />
        <form method="post" @formname="no-he-sido-yo" @onsubmit="ConfirmarAsync">
            <AntiforgeryToken />
            <button type="submit" class="acceso-entrar">@Textos["NoHeSidoYoBoton"]</button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private ResultadoNoHeSidoYo? _resultado;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
            _resultado = ResultadoNoHeSidoYo.EnlaceNoValido;
    }

    private async Task ConfirmarAsync()
    {
        if (_resultado == ResultadoNoHeSidoYo.EnlaceNoValido)
            return;

        _resultado = await Vigilancia.ConfirmarNoHeSidoYoAsync(UserId!, Code!);
    }

    private static string ClaveExplicacion(ResultadoNoHeSidoYo resultado) => resultado switch
    {
        ResultadoNoHeSidoYo.ProtegidaSinCorreo => "NoHeSidoYoProtegidaSinCorreoExplicacion",
        ResultadoNoHeSidoYo.ProtegidaCuentaMicrosoft => "NoHeSidoYoMicrosoftExplicacion",
        _ => "NoHeSidoYoProtegidaExplicacion",
    };
}
