@page "/cuenta/configurar-2fa"
@* AuthLayout y no MainLayout, aunque el mockup la dibuja con el menú (revisión UX
   pre-piloto 2026-09-28, D.1): el guard de MainLayout trae aquí con forceLoad a todo
   Administrador sin 2FA, así que con MainLayout esta misma página volvería a pasar
   por el guard y se recargaría sin fin; y en el primer acceso cada enlace del menú
   devolvería aquí igualmente (MainLayout y CuentaAMedioActivarSinAccesoMiddleware).
   Lo que el mockup señalaba —«se entra y no hay cómo volver»— se resuelve con la
   salida del final de la página: «Volver» cuando la 2FA no es obligatoria y
   «Cerrar sesión» siempre. *@
@layout CaeManager.Web.Components.Layout.AuthLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CaeManager.Application.Usuarios.Commands.GenerarCodigosRecuperacion
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using CaeManager.Web.Components.Account.Recursos
@using CaeManager.Web.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using MediatR
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILoggerFactory LoggerFactory
@inject NavigationManager NavigationManager
@inject IStringLocalizer<TextosCuenta> Textos
@inject IMediator Mediator
@inject CaeManager.Infrastructure.Coordinacion.IEleccionLiderService CerrojoVerificacion
@inject IDataProtectionProvider ProteccionDatos

<PageTitle>Autenticación en dos pasos — @Marca.Nombre</PageTitle>

<div class="contenedor-pagina">
    <div class="cabecera-pagina">
        <h1 class="titulo-pagina">Autenticación en dos pasos</h1>
        <p class="cabecera-pagina-descripcion">Configura el segundo factor de tu propia cuenta.</p>
    </div>

    @if (_cargando)
    {
        <div class="dos-factores-cargando" aria-busy="true" aria-label="Cargando la configuración de autenticación en dos pasos">
            <span class="dos-factores-esqueleto dos-factores-esqueleto-qr" aria-hidden="true"></span>
            <span class="dos-factores-esqueleto dos-factores-esqueleto-linea" aria-hidden="true"></span>
            <span class="dos-factores-esqueleto dos-factores-esqueleto-linea-corta" aria-hidden="true"></span>
        </div>
    }
    else if (_codigosRecuperacion is not null)
    {
        @* Paso 3 del mockup «Configurar 2FA TALVEG»: los códigos solo existen en
           claro en esta respuesta; en la base quedan con hash (AlmacenUsuarios). *@
        <section class="tarjeta-2fa tarjeta-codigos-recuperacion" aria-labelledby="codigos-recuperacion-titulo">
            <h2 id="codigos-recuperacion-titulo">@(_dosFactoresRecienActivado ? Textos["CodigosPasoTresTitulo"] : Textos["CodigosNuevosTitulo"])</h2>
            <div class="aviso-codigos" role="status">
                <Icono Nombre="advertencia" Tamano="TamanoIcono.Pequeno" />
                <span>@Textos["CodigosAviso"]</span>
            </div>
            @* Opción C (decisión del 25-09): sin otro Administrador en el Tenant no hay
               vía de recuperación; ni Soporte TALVEG ni la base de datos la sustituyen. *@
            <p class="texto-2fa-secundario aviso-administrador-unico">@Textos["CodigosAvisoAdministradorUnico"]</p>
            <ul class="lista-codigos" aria-label="@Textos["CodigosLista"]">
                @foreach (var codigo in _codigosRecuperacion)
                {
                    <li><code>@codigo</code></li>
                }
            </ul>
            <div class="acciones-codigos">
                <a class="boton-secundario" href="@EnlaceDescarga" download="@NombreFicheroDescarga">
                    <Icono Nombre="descargar" Tamano="TamanoIcono.Pequeno" /> <span>@Textos["CodigosDescargar"]</span>
                </a>
                <span class="texto-2fa-secundario">@Textos["CodigosUnSoloUso"]</span>
            </div>
            @* Carga completa, no navegación mejorada: el menú y los gates de rol
               dependen de una claims transformation que solo se recalcula en una
               petición nueva (mismo motivo que el forceLoad de VerificarAsync). *@
            <Boton Variante="VarianteBoton.Primario" Href="@RutaDeVuelta" class="boton-2fa boton-continuar" data-enhance-nav="false">@Textos["CodigosContinuar"]</Boton>
        </section>
    }
    else if (_dosFactoresActivo)
    {
        <div class="tarjeta-2fa tarjeta-2fa-activa">
            <p class="texto-2fa-exito"><Icono Nombre="exito-circulo" Tamano="TamanoIcono.Pequeno" /> <span>La autenticación en dos pasos ya está activada en tu cuenta.</span></p>
            <p class="texto-2fa-secundario">Tu aplicación autenticadora te pedirá un código cuando sea necesario.</p>
            @if (HayVueltaAFicha)
            {
                <Boton Variante="VarianteBoton.Primario" Href="@RutaDeVuelta" class="boton-2fa boton-continuar" data-enhance-nav="false">@Textos["VolverALaFicha"]</Boton>
            }
        </div>

        <section class="tarjeta-2fa tarjeta-2fa-activa tarjeta-regenerar" aria-labelledby="codigos-restantes-titulo">
            <h2 id="codigos-restantes-titulo">@Textos["CodigosLista"]</h2>
            <p class="codigos-restantes">@TextoCodigosRestantes</p>
            @if (mensajeError is not null)
            {
                <div class="alerta-login" role="alert"><Icono Nombre="error-circulo" Tamano="TamanoIcono.Pequeno" /> <span>@mensajeError</span></div>
            }
            <p class="texto-2fa-secundario">@Textos["CodigosRegenerarAyuda"]</p>
            <EditForm Model="Regenerar" method="post" OnSubmit="RegenerarCodigosAsync" FormName="regenerar-codigos">
                <label for="codigo-regenerar">@Textos["CodigosVerificarAutenticador"]</label>
                <InputText id="codigo-regenerar" @bind-Value="Regenerar!.Codigo" autocomplete="one-time-code" inputmode="numeric" maxlength="12" />
                <Boton Variante="VarianteBoton.Primario" Type="submit" class="boton-2fa">@Textos["CodigosRegenerar"]</Boton>
            </EditForm>
        </section>
    }
    else if (_errorCarga is not null)
    {
        <div class="tarjeta-2fa">
            <div class="alerta-login" role="alert"><Icono Nombre="error-circulo" Tamano="TamanoIcono.Pequeno" /> <span>@_errorCarga</span></div>
        </div>
    }
    else if (_usuario is not null)
    {
        @if (_dosFactoresObligatorio)
        {
            <p class="dos-factores-obligatorio" role="status">@Textos["DosFactoresObligatorioPorRol", Marca.Nombre]</p>
        }
        else if (Motivo == SegundoFactorParaCredenciales.Motivo)
        {
            <p class="dos-factores-obligatorio" role="status">@Textos["DosFactoresObligatorioParaCredenciales"]</p>
        }

        @if (!_reautenticado)
        {
            @* ASVS 4.0.3 V2.5 y V3.7.1: dar de alta un factor exige haberse autenticado hace poco.
               Sin eso, la clave no se genera ni se enseña: una cookie robada de una cuenta sin
               TOTP no basta para registrar el factor de otro y dejar fuera al titular. *@
            <section class="tarjeta-2fa tarjeta-reautenticacion" aria-labelledby="reautenticacion-titulo">
                <h2 id="reautenticacion-titulo">@Textos["ReautenticacionTitulo"]</h2>

                @if (mensajeError is not null)
                {
                    <div class="alerta-login" role="alert"><Icono Nombre="error-circulo" Tamano="TamanoIcono.Pequeno" /> <span>@mensajeError</span></div>
                }

                @if (_reautenticacionConMicrosoft)
                {
                    <p class="texto-2fa-secundario">@Textos["ReautenticacionMicrosoftAyuda"]</p>
                    <Boton Variante="VarianteBoton.Primario" Href="@EnlaceReautenticacionMicrosoft" class="boton-2fa" data-enhance-nav="false">@Textos["ReautenticacionMicrosoftBoton"]</Boton>
                }
                else
                {
                    <p class="texto-2fa-secundario">@Textos["ReautenticacionContrasenaAyuda"]</p>
                    <EditForm Model="Reautenticacion" method="post" OnValidSubmit="ReautenticarAsync" FormName="reautenticar-2fa">
                        <DataAnnotationsValidator />
                        <label for="contrasena-actual">@Textos["ReautenticacionContrasena"]</label>
                        <InputText id="contrasena-actual" type="password" autocomplete="current-password" @bind-Value="Reautenticacion!.Contrasena" />
                        <ValidationMessage For="() => Reautenticacion!.Contrasena" />
                        <Boton Variante="VarianteBoton.Primario" Type="submit" class="boton-2fa">@Textos["ReautenticacionContinuar"]</Boton>
                    </EditForm>
                }
            </section>
        }
        else if (_claveCompartida is not null && Entrada is not null)
        {
            <div class="dos-factores-alta">
                <aside class="tarjeta-2fa tarjeta-qr" aria-label="Código QR de configuración">
                    <img class="qr-2fa" src="@_qrCodeDataUri" alt="Código QR para configurar la aplicación autenticadora" width="220" height="220" />
                    <p>Escanea con Google Authenticator, Microsoft Authenticator o 1Password.</p>
                </aside>

                <div class="dos-factores-pasos">
                    <section class="tarjeta-2fa" aria-labelledby="anadir-aplicacion-titulo">
                        <h2 id="anadir-aplicacion-titulo">1. Añade la cuenta a tu aplicación</h2>
                        <p>Escanea el código QR con una aplicación autenticadora compatible con TOTP. ¿No puedes escanearlo? Introduce esta clave manualmente:</p>
                        <div class="clave-manual">
                            <code>@_claveCompartida</code>
                        </div>

                        <p class="texto-2fa-secundario">Si tu aplicación admite pegar una URI, usa esta:</p>
                        <p class="uri-otpauth"><code>@_uriOtpAuth</code></p>
                    </section>

                    <section class="tarjeta-2fa tarjeta-confirmacion" aria-labelledby="confirmar-aplicacion-titulo">
                        <h2 id="confirmar-aplicacion-titulo">2. Confirma que funciona</h2>

                        @if (mensajeError is not null)
                        {
                            <div class="alerta-login" role="alert"><Icono Nombre="error-circulo" Tamano="TamanoIcono.Pequeno" /> <span>@mensajeError</span></div>
                        }

                        <EditForm Model="Entrada" method="post" OnValidSubmit="VerificarAsync" FormName="configurar-2fa">
                            <DataAnnotationsValidator />
                            @* La prueba de autenticación reciente viaja con el código: la página es SSR
                               estática y el POST no ve lo que se decidió al pintarla. *@
                            <InputText id="prueba-reautenticacion" type="hidden" @bind-Value="Entrada.Reautenticacion" />

                            <label for="codigo">Código de 6 dígitos generado por la app</label>
                            <InputText id="codigo" @bind-Value="Entrada.Codigo" autocomplete="one-time-code" inputmode="numeric" maxlength="6" placeholder="000000" aria-describedby="codigo-ayuda" />
                            <span id="codigo-ayuda" class="ayuda-codigo">Se aceptan espacios y guiones: se limpian antes de verificar.</span>
                            <ValidationMessage For="() => Entrada.Codigo" />

                            <Boton Variante="VarianteBoton.Primario" Type="submit" class="boton-2fa">Activar autenticación en dos pasos</Boton>
                        </EditForm>
                    </section>
                </div>
            </div>
        }
    }

    @if (!_cargando && _codigosRecuperacion is null)
    {
        <div class="salida-2fa">
            @* «Volver» solo si la cuenta puede irse sin activar la 2FA: al Administrador
               sin 2FA el guard lo traería de vuelta. Con la 2FA ya activa y una ficha de
               origen, la tarjeta ya ofrece «Volver a la ficha». *@
            @if (!_dosFactoresObligatorio && !(_dosFactoresActivo && HayVueltaAFicha))
            {
                <a class="boton-secundario" href="@RutaDeVuelta" data-enhance-nav="false">@Textos["SalidaVolver"]</a>
            }
            <form method="post" action="/cuenta/cerrar-sesion">
                <AntiforgeryToken />
                <button type="submit" class="boton-secundario">@Textos["SalidaCerrarSesion"]</button>
            </form>
        </div>
    }
</div>

@code {
    private bool _cargando = true;
    private bool _dosFactoresActivo;
    private string? _claveCompartida;
    private string? _uriOtpAuth;
    private string? _qrCodeDataUri;
    private string? mensajeError;
    private string? _errorCarga;
    private ApplicationUser? _usuario;
    private int _codigosRestantes;
    private IReadOnlyList<string>? _codigosRecuperacion;
    private bool _dosFactoresRecienActivado;

    // Quien llega aquí redirigido por CuentaAMedioActivarSinAccesoMiddleware o
    // por el guard de MainLayout no puede usar nada más hasta activarla, y la
    // página tiene que decírselo: sin el aviso parecía una opción del perfil, y
    // la demo de Dirección (2026-09-21) lo describió como «bucle TOTP». Misma
    // regla y mismo rol ALMACENADO que TenantClaimsPrincipalFactory y
    // MainLayout (Administrador sin 2FA); solo decide un texto, no autoriza.
    private bool _dosFactoresObligatorio;

    // P1-I1: la pantalla que pidió datos de credencial sin 2FA llega con
    // ?motivo=credenciales (SegundoFactorParaCredenciales). Igual que el aviso
    // de arriba, solo decide un texto: quien deniega es AutorizacionSecretosDeTenantBehavior.
    [SupplyParameterFromQuery(Name = "motivo")]
    private string? Motivo { get; set; }

    // P1-I2 (hueco de #900): la ficha que mandó aquí pasa su propia ruta para
    // volver a ella al terminar. Solo una ruta local (EsRutaLocal): cualquier
    // otra se ignora y la salida es el inicio, nunca una redirección abierta.
    [SupplyParameterFromQuery(Name = SegundoFactorParaCredenciales.ParametroVuelta)]
    private string? ReturnUrl { get; set; }

    private bool HayVueltaAFicha => SegundoFactorParaCredenciales.EsRutaLocal(ReturnUrl);

    // Salida sin ficha: quien llega forzado por la 2FA obligatoria (_dosFactoresObligatorio)
    // acaba de iniciar sesión y termina aquí su login, así que aterriza con la marca de un
    // solo uso (RedireccionLocal.DestinoTrasLogin), como Login. Un returnUrl local
    // explícito manda siempre; el alta voluntaria desde el perfil no es un login y vuelve a "/".
    private string RutaDeVuelta => HayVueltaAFicha
        ? ReturnUrl!
        : _dosFactoresObligatorio ? RedireccionLocal.DestinoTrasLogin(null) : "/";

    [SupplyParameterFromForm]
    private DatosEntrada? Entrada { get; set; }

    // Un solo campo: el código TOTP actual, que reautentica a quien regenera con un
    // factor independiente de la sesión (S-A-2); una sesión robada no basta para
    // obtener códigos nuevos. EditForm y no un <form> suelto, como el resto de
    // formularios de esta página estática.
    [SupplyParameterFromForm(FormName = "regenerar-codigos")]
    private DatosRegenerar? Regenerar { get; set; }

    // Reautenticación antes del alta (ASVS 4.0.3 V2.5, V3.7.1): la contraseña actual, con el mismo
    // conteo en el bloqueo de la cuenta que el login. Quien acaba de iniciar sesión no la repite
    // (SignInManagerCuentaDesactivada.AutenticacionEsReciente): es el caso del Administrador al que
    // se fuerza el alta justo después del login.
    [SupplyParameterFromForm(FormName = "reautenticar-2fa")]
    private DatosReautenticacion? Reautenticacion { get; set; }

    // Hay autenticación reciente: inicio de sesión de hace poco, contraseña acertada en esta página
    // o una prueba vigente de cualquiera de las dos. Sin ella no se genera ni se enseña la clave.
    private bool _reautenticado;

    // La sesión entró por Microsoft o la cuenta no tiene contraseña local: la reautenticación es
    // volver a iniciar sesión con Microsoft. La contraseña no sustituye al inicio con Microsoft de
    // una cuenta que lo usa (RestriccionLoginLocalClaimsTransformation).
    private bool _reautenticacionConMicrosoft;

    private ClaimsPrincipal? _principal;

    protected override async Task OnInitializedAsync()
    {
        Entrada ??= new DatosEntrada();
        Regenerar ??= new DatosRegenerar();
        Reautenticacion ??= new DatosReautenticacion();

        var estadoAutenticacion = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _principal = estadoAutenticacion.User;
        var idClaim = estadoAutenticacion.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(idClaim, out var id))
        {
            _cargando = false;
            return;
        }

        _usuario = await UserManager.FindByIdAsync(id.ToString());
        if (_usuario is null)
        {
            _cargando = false;
            return;
        }

        _dosFactoresActivo = await UserManager.GetTwoFactorEnabledAsync(_usuario);
        if (_dosFactoresActivo)
            _codigosRestantes = await UserManager.CountRecoveryCodesAsync(_usuario);
        else
        {
            _dosFactoresObligatorio = await UserManager.IsInRoleAsync(_usuario, Roles.Administrador);

            // La prueba que llega con el código (o la de un inicio de sesión reciente) es lo único que
            // abre el alta; una prueba ajena, caducada o de otra sesión no vale.
            var pruebaRecibida = PruebaReautenticacionEsValida(Entrada.Reautenticacion);
            _reautenticado = pruebaRecibida
                || SignInManagerCuentaDesactivada.AutenticacionEsReciente(_principal, DateTimeOffset.UtcNow);
            if (_reautenticado)
            {
                if (!pruebaRecibida)
                    Entrada.Reautenticacion = EmitirPruebaReautenticacion();
                await CargarClaveCompartidaAsync(_usuario);
            }
            else
            {
                Entrada.Reautenticacion = string.Empty;
                await PrepararReautenticacionAsync(_usuario);
            }
        }

        _cargando = false;
    }

    private async Task PrepararReautenticacionAsync(ApplicationUser usuario)
    {
        var entroConMicrosoft = _principal?.HasClaim(
            RestriccionLoginLocalClaimsTransformation.TipoClaimMetodoLogin,
            RestriccionLoginLocalClaimsTransformation.MetodoLoginSso) == true;
        var tieneContrasena = UserManager.SupportsUserPassword && await UserManager.HasPasswordAsync(usuario);
        _reautenticacionConMicrosoft = entroConMicrosoft || !tieneContrasena;
    }

    // Vuelve aquí, con la misma consulta (motivo, returnUrl), tras el inicio con Microsoft: una
    // sesión nueva lleva su marca de inicio reciente. reautenticar=true pide a Microsoft que vuelva
    // a pedir las credenciales (prompt=login) en vez de reutilizar su sesión en silencio.
    private string EnlaceReautenticacionMicrosoft =>
        "/cuenta/iniciar-sesion-microsoft?reautenticar=true&returnUrl="
        + Uri.EscapeDataString("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    // Ligada a la cuenta y a la sesión de cookie (talveg:sid): una prueba copiada de otra sesión
    // no sirve aquí.
    private string EmitirPruebaReautenticacion() =>
        PruebaReautenticacion2fa.Emitir(
            ProteccionDatos, _usuario!.Id, SignInManagerCuentaDesactivada.LeerSid(_principal), DateTimeOffset.UtcNow);

    private bool PruebaReautenticacionEsValida(string? prueba) =>
        _usuario is not null
        && PruebaReautenticacion2fa.EsValida(
            ProteccionDatos, prueba, _usuario.Id, SignInManagerCuentaDesactivada.LeerSid(_principal));

    private async Task ReautenticarAsync()
    {
        if (_usuario is null || _dosFactoresActivo || _reautenticado || _reautenticacionConMicrosoft
            || Reautenticacion is null || Entrada is null)
            return;

        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);
        var contrasena = Reautenticacion.Contrasena;
        // No vuelve a la página: el campo de contraseña se pinta vacío en la respuesta.
        Reautenticacion.Contrasena = string.Empty;

        // Mismo cerrojo no bloqueante que LoginCon2fa y la regeneración de códigos
        // (verificar-2fa:{userId}): sin él, N contraseñas en paralelo cargarían la cuenta con el mismo
        // ConcurrencyStamp y solo un AccessFailedAsync ganaría, de modo que N intentos sumarían un único
        // fallo al bloqueo de la cuenta (S-A-9). Con la cuenta bloqueada no se comprueba nada.
        var verificacionFallida = false;
        var falloSinRegistrar = false;
        var cuenta = _usuario;
        var ejecutado = await CerrojoVerificacion.IntentarEjecutarComoLiderAsync(
            $"verificar-2fa:{cuenta.Id}",
            async _ =>
            {
                if (await UserManager.IsLockedOutAsync(cuenta))
                {
                    verificacionFallida = true;
                    return;
                }
                if (!await UserManager.CheckPasswordAsync(cuenta, contrasena))
                {
                    verificacionFallida = true;
                    // Como en LoginCon2fa: si el fallo no se guarda (concurrencia optimista), queda
                    // anotado; el intento se rechaza igual.
                    falloSinRegistrar = !(await UserManager.AccessFailedAsync(cuenta)).Succeeded;
                    return;
                }
                // Como un login correcto: acertar la contraseña pone el contador a cero.
                if (await UserManager.GetAccessFailedCountAsync(cuenta) > 0)
                    await UserManager.ResetAccessFailedCountAsync(cuenta);
            },
            CancellationToken.None);

        if (!ejecutado)
        {
            logger.LogWarning(
                "Reautenticación para el alta de 2FA rechazada, ya había una verificación en curso: {UsuarioId}", cuenta.Id);
            mensajeError = Textos["ReautenticacionEnCurso"];
            return;
        }

        if (verificacionFallida)
        {
            // Un único mensaje para contraseña incorrecta y cuenta bloqueada, como en el login.
            logger.LogWarning(
                "Reautenticación para el alta de 2FA rechazada, contraseña incorrecta o cuenta bloqueada: {UsuarioId}", cuenta.Id);
            if (falloSinRegistrar)
                logger.LogWarning(
                    "El fallo de contraseña del alta de 2FA no se pudo sumar al bloqueo de la cuenta: {UsuarioId}", cuenta.Id);
            mensajeError = Textos["CambiarContrasenaVerificacionFallida"];
            return;
        }

        logger.LogInformation("Reautenticación con contraseña para el alta de 2FA: {UsuarioId}", cuenta.Id);
        mensajeError = null;
        _reautenticado = true;
        Entrada.Reautenticacion = EmitirPruebaReautenticacion();
        await CargarClaveCompartidaAsync(cuenta);
    }

    private async Task CargarClaveCompartidaAsync(ApplicationUser usuario)
    {
        var claveSinFormato = await UserManager.GetAuthenticatorKeyAsync(usuario);
        if (string.IsNullOrEmpty(claveSinFormato))
        {
            // Si el reinicio no se guardo, no hay clave que ensenar: pintar una en cualquiera de los dos
            // modos seria ensenar una clave que el servidor nunca guardo, y el codigo que alguien
            // registre con ella no lo aceptaria jamas (#625).
            var resultadoReset = await UserManager.ResetAuthenticatorKeyAsync(usuario);
            if (!resultadoReset.Succeeded)
            {
                _errorCarga = string.Join(" ", resultadoReset.Errors.Select(e => e.Description));
                return;
            }

            claveSinFormato = await UserManager.GetAuthenticatorKeyAsync(usuario);
        }

        _claveCompartida = ClaveAutenticadorTotp.FormatearClave(claveSinFormato!);
        _uriOtpAuth = ClaveAutenticadorTotp.GenerarUriOtpAuth(usuario.Email ?? usuario.UserName ?? string.Empty, claveSinFormato!);
        _qrCodeDataUri = ClaveAutenticadorTotp.GenerarQrCodeDataUri(_uriOtpAuth);
    }

    private async Task VerificarAsync()
    {
        if (Entrada is null || _usuario is null) return;

        // Se comprueba otra vez al activar, no solo al enseñar la clave: el POST del código es una
        // petición nueva y su prueba de reautenticación puede haber caducado o no venir.
        if (!_reautenticado)
        {
            mensajeError = Textos["ReautenticacionCaducada"];
            return;
        }

        var codigoLimpio = Entrada.Codigo.Replace(" ", string.Empty).Replace("-", string.Empty);

        var esValido = await UserManager.VerifyTwoFactorTokenAsync(
            _usuario, UserManager.Options.Tokens.AuthenticatorTokenProvider, codigoLimpio);

        if (!esValido)
        {
            mensajeError = "El código no es válido. Comprueba la hora de tu dispositivo e inténtalo de nuevo.";
            return;
        }

        var resultadoActivar = await UserManager.SetTwoFactorEnabledAsync(_usuario, true);
        if (!resultadoActivar.Succeeded)
        {
            // Si esta escritura no ocurrio de verdad, la cuenta se queda sin segundo factor aunque el
            // codigo introducido fuera valido: ni se reemite la sesion, ni se audita una activacion
            // que no paso, ni se navega como si hubiera terminado (#625).
            mensajeError = string.Join(" ", resultadoActivar.Errors.Select(e => e.Description));
            return;
        }

        mensajeError = null;

        // Reemite el ticket de autenticación, y hacen falta las dos cosas que
        // eso arregla:
        //
        // 1. El claim "requiere_activacion" lo sella la CLAIMS FACTORY, que
        //    corre al iniciar sesión, no en cada petición — a diferencia de la
        //    claims transformation en la que confía el forceLoad de más abajo.
        //    Sin reemitir, el ticket seguiría diciendo que esta cuenta está a
        //    medio activar y CuentaAMedioActivarSinAccesoMiddleware la
        //    devolvería aquí una y otra vez: el mismo cepo que este método ya
        //    evitaba para MainLayout, por una vía distinta.
        //
        // 2. SetTwoFactorEnabledAsync cambia el sello de seguridad, así que el
        //    validador periódico de AddIdentityCookies habría cerrado la sesión
        //    dentro de su ventana. Eso pasaba ya antes de este cambio.
        await SignInManager.RefreshSignInAsync(_usuario);

        LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
            .LogInformation("2FA activado: {UsuarioId}", _usuario.Id);

        // Los códigos de recuperación nacen con la 2FA (P0-8, FS-01): sin ellos,
        // perder el móvil deja la cuenta fuera. Se muestran aquí una sola vez, y
        // el botón de continuar lleva a "/" con carga completa: sin esa salida,
        // quien llega forzado por MainLayout (2FA obligatoria para
        // Administrador) se quedaría atrapado en esta pantalla. Si generarlos
        // falla, la 2FA ya está activa: se sale como antes (forceLoad, porque el
        // menú y los gates de rol dependen de una claims transformation que solo
        // se recalcula en una carga nueva), y los códigos se generan después
        // desde esta misma página.
        var codigos = await Mediator.Send(new GenerarCodigosRecuperacionCommand(codigoLimpio));
        if (codigos.EsFallido)
        {
            LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
                .LogWarning("2FA activado sin códigos de recuperación: {UsuarioId} ({Codigo})", _usuario.Id, codigos.Error.Codigo);
            NavigationManager.NavigateTo(RutaDeVuelta, forceLoad: true);
            return;
        }

        _dosFactoresActivo = true;
        _dosFactoresRecienActivado = true;
        _codigosRecuperacion = codigos.Valor;
    }

    private async Task RegenerarCodigosAsync()
    {
        if (_usuario is null || !_dosFactoresActivo) return;

        // Mismo cerrojo no bloqueante que LoginCon2fa (verificar-2fa:{userId}): la página es SSR
        // estática y dos POST concurrentes no se ven entre sí. Sin él, N códigos en paralelo
        // cargarían la cuenta con el mismo ConcurrencyStamp y solo un AccessFailedAsync ganaría,
        // de modo que N intentos sumarían un único fallo al bloqueo de la cuenta (S-A-2).
        CaeManager.Domain.Common.Result<IReadOnlyList<string>>? resultadoObtenido = null;
        var ejecutado = await CerrojoVerificacion.IntentarEjecutarComoLiderAsync(
            $"verificar-2fa:{_usuario.Id}",
            async _ => resultadoObtenido = await Mediator.Send(new GenerarCodigosRecuperacionCommand(Regenerar?.Codigo ?? "")),
            CancellationToken.None);
        if (!ejecutado)
        {
            LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
                .LogWarning("Regeneración de códigos de recuperación rechazada, ya había una verificación en curso: {UsuarioId}", _usuario.Id);
            mensajeError = Textos["CodigosVerificacionEnCurso"];
            return;
        }

        // ejecutado == true garantiza que el delegado corrió y asignó el resultado.
        var codigos = resultadoObtenido!;
        if (codigos.EsFallido)
        {
            LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
                .LogWarning("Regeneración de códigos de recuperación rechazada: {UsuarioId} ({Codigo})", _usuario.Id, codigos.Error.Codigo);
            mensajeError = codigos.Error.Codigo == "SegundoFactor.VerificacionFallida"
                ? Textos["CodigosVerificacionFallida"] : codigos.Error.Mensaje;
            return;
        }

        LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
            .LogInformation("Códigos de recuperación de 2FA regenerados: {UsuarioId}", _usuario.Id);

        _codigosRecuperacion = codigos.Valor;
    }

    private string TextoCodigosRestantes => _codigosRestantes switch
    {
        0 => Textos["CodigosRestantesNinguno"],
        1 => Textos["CodigosRestantesUno"],
        _ => Textos["CodigosRestantesVarios", _codigosRestantes],
    };

    private static string NombreFicheroDescarga => $"codigos-recuperacion-{Marca.Nombre.ToLowerInvariant()}.txt";

    // Fichero de texto que el navegador arma con esta misma respuesta: los códigos
    // no pasan por ningún otro endpoint ni quedan en claro en el servidor.
    private string EnlaceDescarga =>
        "data:text/plain;charset=utf-8," + Uri.EscapeDataString(
            Textos["CodigosFicheroCabecera", Marca.Nombre, _usuario?.Email ?? string.Empty] + "\n" +
            Textos["CodigosUnSoloUso"] + "\n\n" +
            string.Join("\n", _codigosRecuperacion ?? []));

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "Introduce el código de la aplicación autenticadora.")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "El código debe tener 6 dígitos.")]
        public string Codigo { get; set; } = string.Empty;

        public string Reautenticacion { get; set; } = string.Empty;
    }

    private sealed class DatosReautenticacion
    {
        [Required(ErrorMessage = "Introduce tu contraseña actual.")]
        public string Contrasena { get; set; } = string.Empty;
    }

    private sealed class DatosRegenerar { public string Codigo { get; set; } = string.Empty; }
}
