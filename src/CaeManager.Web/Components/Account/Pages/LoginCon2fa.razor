@page "/cuenta/verificar-2fa"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using CaeManager.Infrastructure.Coordinacion
@using CaeManager.Infrastructure.Identity
@using CaeManager.Web.Components.Account
@using CaeManager.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using CaeManager.Web.Components.Account.Recursos
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject IEleccionLiderService CerrojoVerificacion
@inject NavigationManager Navigation
@inject ILoggerFactory LoggerFactory
@inject IStringLocalizer<TextosCuenta> Textos

<PageTitle>Verificación en dos pasos — @Marca.Nombre</PageTitle>

<div class="acceso-tarjeta">
    @if (_bloqueado)
    {
        <CabeceraAcceso Titulo="Verificación en dos pasos" />
        <div class="acceso-alerta" role="alert">@(_mensajeCierre ?? MensajeBloqueo)</div>
        <a class="acceso-entrar" href="/cuenta/iniciar-sesion">Volver a iniciar sesión</a>
    }
    else if (_altaTotp && EntradaAlta is not null && _usuarioPendiente is not null)
    {
        @* Primera vinculación de Microsoft de una cuenta sin TOTP (decisión de 2026-10-28,
           ASVS 4.0.3 V2.1 y V3.7.1): antes de pedir el código, se da de alta el TOTP. La
           autenticación reciente es la reautenticación en Microsoft (prompt=login) que pidió
           el callback, acotada por la vida de la cookie de dos pasos. *@
        <CabeceraAcceso Titulo="Verificación en dos pasos" Explicacion="@Textos["AltaVinculoExplicacion", Marca.Nombre]" />

        @if (_claveCompartida is null)
        {
            <div class="acceso-alerta" role="alert">@Textos["AltaVinculoErrorCarga"]</div>
        }
        else
        {
            <img src="@_qrCodeDataUri" alt="@Textos["AltaVinculoQrAlternativo"]" width="220" height="220" />
            <p class="acceso-nota">@Textos["AltaVinculoClaveManual"]</p>
            <p class="acceso-nota"><code>@_claveCompartida</code></p>

            <EditForm Model="EntradaAlta" method="post" OnValidSubmit="ActivarAltaTotpAsync" FormName="alta-2fa-vinculo-microsoft" novalidate>
                <DataAnnotationsValidator />

                @if (mensajeError is not null)
                {
                    <div class="acceso-alerta" role="alert">@mensajeError</div>
                }

                <div class="acceso-campo acceso-codigo">
                    <label for="codigo-alta">@Textos["AltaVinculoCodigoEtiqueta"]</label>
                    <InputText id="codigo-alta" @bind-Value="EntradaAlta.Codigo" autocomplete="one-time-code" inputmode="numeric" />
                    <ValidationMessage For="() => EntradaAlta.Codigo" />
                </div>

                <p class="acceso-nota">@Textos["AltaVinculoCodigoSiguiente"]</p>
                <button type="submit" class="acceso-entrar">@Textos["AltaVinculoActivar"]</button>
            </EditForm>
        }

        <p class="acceso-olvido"><a href="/cuenta/iniciar-sesion">@Textos["RecuperacionVolverInicio"]</a></p>
    }
    else if (ModoRecuperacion && EntradaRecuperacion is not null && _usuarioPendiente is not null)
    {
        @* Mockup «Verificar 2FA TALVEG», modo recuperación (P0-8, FS-01). *@
        <CabeceraAcceso Titulo="Verificación en dos pasos" Explicacion="@Textos["RecuperacionExplicacion"]" />

        <EditForm Model="EntradaRecuperacion" method="post" OnValidSubmit="VerificarRecuperacionAsync" FormName="verificar-2fa-recuperacion" novalidate>
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="acceso-alerta" role="alert">@mensajeError</div>
            }

            <div class="acceso-campo acceso-codigo">
                <label for="recuperacion">@Textos["RecuperacionEtiqueta"]</label>
                <InputText id="recuperacion" @bind-Value="EntradaRecuperacion.Codigo" autocomplete="one-time-code" placeholder="@Textos["RecuperacionMarcador"]" aria-describedby="recuperacion-ayuda" />
                <span id="recuperacion-ayuda" class="acceso-nota">@Textos["RecuperacionAyuda"]</span>
            </div>

            <button type="submit" class="acceso-entrar">@Textos["RecuperacionVerificar"]</button>
        </EditForm>

        <p class="acceso-olvido"><a href="@EnlaceModo(recuperacion: false)">@Textos["RecuperacionVolverAplicacion"]</a></p>
        <p class="acceso-olvido"><a href="/cuenta/iniciar-sesion">@Textos["RecuperacionVolverInicio"]</a></p>
    }
    else if (Entrada is not null && _usuarioPendiente is not null)
    {
        <CabeceraAcceso Titulo="Verificación en dos pasos" Explicacion="Introduce el código de tu aplicación autenticadora." />

        <EditForm Model="Entrada" method="post" OnValidSubmit="VerificarAsync" FormName="verificar-2fa" novalidate>
            <DataAnnotationsValidator />

            @if (mensajeError is not null)
            {
                <div class="acceso-alerta" role="alert">@mensajeError</div>
            }

            <div class="acceso-campo acceso-codigo">
                <label for="codigo">Código de 6 dígitos</label>
                <InputText id="codigo" @bind-Value="Entrada.Codigo" autocomplete="one-time-code" inputmode="numeric" />
                <ValidationMessage For="() => Entrada.Codigo" />
            </div>

            <button type="submit" class="acceso-entrar">Verificar</button>
        </EditForm>

        @* Sin el móvil: los códigos de recuperación que se guardaron al activar
           la 2FA (P0-8, FS-01). Antes de ellos, perder el móvil dejaba la cuenta
           fuera sin más salida que la base de datos. *@
        <p class="acceso-olvido"><a href="@EnlaceModo(recuperacion: true)">@Textos["RecuperacionUsarCodigo"]</a></p>

        @* Salida también sin bloqueo: quien se equivocó de cuenta o no tiene el
           móvil a mano no debe quedarse atrapado en este paso. *@
        <p class="acceso-olvido"><a href="/cuenta/iniciar-sesion">Volver a iniciar sesión</a></p>
    }
</div>

@code {
    private string? mensajeError;
    private bool _bloqueado;
    // Con _bloqueado: el paso se cierra por otro motivo que el bloqueo (hoy, un
    // intento fallido que no se pudo registrar).
    private string? _mensajeCierre;
    private ApplicationUser? _usuarioPendiente;

    [SupplyParameterFromForm(FormName = "verificar-2fa")]
    private DatosEntrada? Entrada { get; set; }

    [SupplyParameterFromForm(FormName = "verificar-2fa-recuperacion")]
    private DatosRecuperacion? EntradaRecuperacion { get; set; }

    // Alta del TOTP previa a la primera vinculación de Microsoft (ver ActivarAltaTotpAsync).
    [SupplyParameterFromForm(FormName = "alta-2fa-vinculo-microsoft")]
    private DatosEntrada? EntradaAlta { get; set; }

    // La cookie de dos pasos es la de una primera vinculación cuya cuenta aún no tiene el TOTP
    // activado: la página enseña el alta y ninguno de los dos caminos de verificación.
    private bool _altaTotp;
    private string? _claveCompartida;
    private string? _qrCodeDataUri;

    // "recuperacion" muestra el campo del código de recuperación. Va en la URL y
    // no en estado del componente porque la página es SSR estática: cada petición
    // construye una instancia nueva, y el POST del formulario conserva la query.
    [SupplyParameterFromQuery]
    private string? Modo { get; set; }

    private bool ModoRecuperacion => string.Equals(Modo, "recuperacion", StringComparison.Ordinal);

    // Página SSR estática: el HttpContext de la petición del formulario, en el
    // que SignInManager ya escribe la cookie de autenticación.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Entrada ??= new DatosEntrada();
        EntradaRecuperacion ??= new DatosRecuperacion();
        EntradaAlta ??= new DatosEntrada();

        // Antes de que exista Tenant: la cuenta se busca por su clave bajo la RLS
        // de AspNetUsers (ver AmbitoIdentificacionSinTenant, P1-M1).
        using var identificacion = AmbitoIdentificacionSinTenant.Abrir();

        // Si no hay un login con contraseña ya validado en curso (por
        // ejemplo, alguien navega aquí directamente sin haber pasado por
        // Login.razor), no hay nada que verificar — de vuelta al login.
        _usuarioPendiente = await SignInManager.GetTwoFactorAuthenticationUserAsync();
        if (_usuarioPendiente is null)
        {
            Navigation.NavigateTo("/cuenta/iniciar-sesion", forceLoad: true);
        }
        else if (!await SignInManager.UserManager.GetTwoFactorEnabledAsync(_usuarioPendiente))
        {
            // TwoFactorAuthenticatorSignInAsync no mira si la cuenta tiene el TOTP activado:
            // solo verifica el código con la clave guardada. Sin TOTP activado no se verifica
            // nada (ASVS 4.0.3 V2.1): la primera vinculación de Microsoft lo da de alta aquí
            // antes (_altaTotp, que los dos caminos de verificación rechazan), y cualquier
            // otro caso vuelve al inicio. Va en la inicialización, que también corre en el POST.
            if (await EsAltaTotpPendienteAsync())
            {
                _altaTotp = true;
                await PrepararAltaTotpAsync(_usuarioPendiente);
            }
            else
            {
                _usuarioPendiente = null;
                Navigation.NavigateTo("/cuenta/iniciar-sesion", forceLoad: true);
            }
        }
    }

    // Clave nueva al pintar el alta (GET), nunca al recibir el código (POST): una clave que la
    // cuenta tuviera de un alta abandonada pudo verla otra persona.
    private async Task PrepararAltaTotpAsync(ApplicationUser usuario)
    {
        var userManager = SignInManager.UserManager;
        if (HttpContext is not null && HttpMethods.IsGet(HttpContext.Request.Method)
            && !(await userManager.ResetAuthenticatorKeyAsync(usuario)).Succeeded)
            return;

        var claveSinFormato = await userManager.GetAuthenticatorKeyAsync(usuario);
        if (string.IsNullOrEmpty(claveSinFormato))
            return;

        _claveCompartida = ClaveAutenticadorTotp.FormatearClave(claveSinFormato);
        _qrCodeDataUri = ClaveAutenticadorTotp.GenerarQrCodeDataUri(
            ClaveAutenticadorTotp.GenerarUriOtpAuth(usuario.Email ?? usuario.UserName ?? string.Empty, claveSinFormato));
    }

    /// <summary>
    /// Activa el TOTP de la primera vinculación de Microsoft con un código de la clave recién
    /// enseñada, y vuelve a esta misma página: con el TOTP ya activo pide un código como
    /// cualquier inicio, y al superarlo guarda el vínculo y emite la sesión.
    /// </summary>
    private async Task ActivarAltaTotpAsync()
    {
        if (!_altaTotp || EntradaAlta is null || _usuarioPendiente is null || _claveCompartida is null) return;

        using var identificacion = AmbitoIdentificacionSinTenant.Abrir();

        var userManager = SignInManager.UserManager;
        var codigoLimpio = EntradaAlta.Codigo.Replace(" ", string.Empty).Replace("-", string.Empty);
        if (!await userManager.VerifyTwoFactorTokenAsync(
                _usuarioPendiente, userManager.Options.Tokens.AuthenticatorTokenProvider, codigoLimpio))
        {
            mensajeError = Textos["AltaVinculoCodigoNoValido"];
            return;
        }

        var activacion = await userManager.SetTwoFactorEnabledAsync(_usuarioPendiente, true);
        if (!activacion.Succeeded)
        {
            mensajeError = string.Join(" ", activacion.Errors.Select(e => e.Description));
            return;
        }

        LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog)
            .LogInformation("2FA activado antes de la primera vinculación de Microsoft: {UsuarioId}", _usuarioPendiente.Id);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task VerificarAsync()
    {
        if (Entrada is null || _usuarioPendiente is null || _altaTotp) return;

        // Antes de que exista Tenant: la cuenta se busca por su clave bajo la RLS
        // de AspNetUsers (ver AmbitoIdentificacionSinTenant, P1-M1).
        using var identificacion = AmbitoIdentificacionSinTenant.Abrir();

        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);
        var vinculoPendiente = await LeerVinculoPendienteAsync();
        var altaTotpPendiente = await EsAltaTotpPendienteAsync();

        // Cerrojo no bloqueante por usuario pendiente de 2FA — necesario
        // porque esta página es SSR estática (sin @rendermode): cada POST
        // reconstruye la instancia del componente, así que ninguna bandera de
        // instancia puede ver una segunda petición concurrente (medido con
        // una sonda propia: dos POST concurrentes con "if (_enviando) return"
        // producen dos instancias, ambas ejecutan el manejador, cero
        // bloqueos). Sin este cerrojo, dos envíos del mismo código gastarían
        // DOS intentos del contador de bloqueo de Identity por una sola
        // acción del usuario. El segundo envío se rechaza aquí, ANTES de
        // tocar SignInManager: no cuenta como intento fallido, no toca el
        // contador. Réplicas contempladas (ver EleccionLiderPostgresService):
        // por eso es un advisory lock de PostgreSQL, no un semáforo en
        // proceso, que no se excluiría entre réplicas distintas.
        SignInResult? resultadoObtenido = null;
        var ejecutado = await CerrojoVerificacion.IntentarEjecutarComoLiderAsync(
            $"verificar-2fa:{_usuarioPendiente.Id}",
            async _ => resultadoObtenido = await SignInManager.TwoFactorAuthenticatorSignInAsync(
                Entrada.Codigo, isPersistent: false, rememberClient: false),
            CancellationToken.None);

        if (!ejecutado)
        {
            // Ni éxito ni fallo de verificación: no hay nada que auditar como
            // intento de 2FA, porque Identity no llegó a ver este código.
            logger.LogWarning(
                "Verificación 2FA rechazada, ya había una en curso para el mismo usuario: {UsuarioId}",
                _usuarioPendiente.Id);
            mensajeError = "Ya se está verificando un código para esta cuenta. Espera un momento e inténtalo de nuevo.";
            return;
        }

        // ejecutado == true garantiza que el delegado corrió y asignó el resultado.
        var resultado = resultadoObtenido!;

        if (resultado.Succeeded)
        {
            logger.LogInformation("Verificación 2FA correcta: {UsuarioId}", _usuarioPendiente.Id);

            if (!await CompletarVinculoPendienteAsync(_usuarioPendiente, vinculoPendiente, logger))
                return;

            // La cookie de cultura es una proyección de ApplicationUser.Idioma
            // (ver CulturaUsuarioCookie): se reconstruye en cada inicio de
            // sesión, así que un navegador nuevo o sin cookies no pierde la
            // preferencia y un usuario anterior en este navegador no la deja
            // heredada.
            if (HttpContext is not null)
                CulturaUsuarioCookie.Escribir(HttpContext, _usuarioPendiente.Idioma);

            // Mismo caso borde que en Login.razor: un Administrador creado
            // con contraseña temporal que además ya tuviera 2FA activado
            // (por ejemplo, reactivado tras estar desactivado) también debe
            // pasar por el cambio de contraseña — el guard de MainLayout lo
            // haría cumplir igualmente, pero se resuelve aquí ya para
            // evitar el salto visible.
            if (_usuarioPendiente.DebeCambiarContrasena)
            {
                Navigation.NavigateTo("/cuenta/cambiar-contrasena", forceLoad: true);
                return;
            }

            // Recién dado de alta el TOTP en la primera vinculación: la cuenta aún no tiene
            // códigos de recuperación (P0-8), y generarlos exige la sesión que se acaba de
            // emitir, así que se termina en la página de la 2FA, que los ofrece.
            if (altaTotpPendiente)
            {
                Navigation.NavigateTo(SegundoFactorParaCredenciales.RutaConfigurarVolviendoA(ReturnUrl), forceLoad: true);
                return;
            }

            Navigation.NavigateTo(RedireccionLocal.DestinoTrasLogin(ReturnUrl), forceLoad: true);
            return;
        }

        if (resultado.IsLockedOut)
        {
            // Aquí el bloqueo SÍ se le dice al usuario, al revés que en
            // Login.razor. Allí un mensaje distinto dejaría enumerar qué
            // cuentas existen; aquí no hay nada que enumerar, porque llegar a
            // este paso exige haber demostrado ya la contraseña. Y el mensaje
            // de código incorrecto le mandaría a reintentar algo que no puede
            // funcionar mientras dure el bloqueo. Decisión del propietario,
            // 2026-09-10.
            logger.LogWarning("Verificación 2FA rechazada, cuenta bloqueada: {UsuarioId}", _usuarioPendiente.Id);

            // Se cierra también el paso de 2FA pendiente (la cookie
            // Identity.TwoFactorUserId). Si la cuenta se desbloquea mientras
            // esa cookie sigue viva, volver aquí no debe ahorrar la
            // contraseña. Mismo idioma que RestablecerContrasena.razor.cs.
            await SignInManager.SignOutAsync();
            _bloqueado = true;
            return;
        }

        logger.LogWarning("Verificación 2FA fallida: {UsuarioId}", _usuarioPendiente.Id);
        mensajeError = "Código no válido. Revisa tu aplicación autenticadora e intenta nuevamente.";
    }

    /// <summary>
    /// Entrada con un código de recuperación. Mismo cerrojo por usuario que
    /// <see cref="VerificarAsync"/>, y por el mismo motivo: dos envíos concurrentes
    /// del mismo código no deben poder canjearlo dos veces ni gastar dos intentos.
    /// A diferencia de <c>TwoFactorRecoveryCodeSignInAsync</c>, que ni mira el
    /// bloqueo ni cuenta los fallos, aquí se hacen las dos cosas: un código de
    /// recuperación no puede ser la puerta trasera de una cuenta bloqueada por
    /// intentos, ni un canal de prueba sin límite.
    /// </summary>
    private async Task VerificarRecuperacionAsync()
    {
        if (EntradaRecuperacion is null || _usuarioPendiente is null || _altaTotp) return;

        // Antes de que exista Tenant: la cuenta se busca por su clave bajo la RLS
        // de AspNetUsers (ver AmbitoIdentificacionSinTenant, P1-M1).
        using var identificacion = AmbitoIdentificacionSinTenant.Abrir();

        // Validación a mano y no con DataAnnotations: sus mensajes no pasan por
        // TextosCuenta. Un código mal formado no es un caso aparte: se trata como
        // no válido y, como cualquier fallo, cuenta un intento.
        if (string.IsNullOrWhiteSpace(EntradaRecuperacion.Codigo))
        {
            mensajeError = Textos["RecuperacionVacio"];
            return;
        }

        var logger = LoggerFactory.CreateLogger(AuditoriaAutenticacion.CategoriaLog);
        var usuario = _usuarioPendiente;
        var vinculoPendiente = await LeerVinculoPendienteAsync();

        SignInResult? resultadoObtenido = null;
        var fallidoSinRegistrar = false;
        var ejecutado = await CerrojoVerificacion.IntentarEjecutarComoLiderAsync(
            $"verificar-2fa:{usuario.Id}",
            async _ =>
            {
                if (await SignInManager.UserManager.IsLockedOutAsync(usuario))
                {
                    resultadoObtenido = SignInResult.LockedOut;
                    return;
                }

                resultadoObtenido = await SignInManager.TwoFactorRecoveryCodeSignInAsync(EntradaRecuperacion.Codigo);
                if (!resultadoObtenido.Succeeded)
                {
                    // Revisión Codex: AccessFailedAsync devuelve un IdentityResult fallido
                    // cuando pierde la concurrencia optimista (un intento de contraseña
                    // simultáneo, otra instancia). Ignorarlo dejaría probar códigos sin
                    // gastar intentos; si no se registra, el paso se cierra.
                    var registro = await SignInManager.UserManager.AccessFailedAsync(usuario);
                    if (!registro.Succeeded)
                        fallidoSinRegistrar = true;
                    else if (await SignInManager.UserManager.IsLockedOutAsync(usuario))
                        resultadoObtenido = SignInResult.LockedOut;
                }
            },
            CancellationToken.None);

        if (!ejecutado)
        {
            logger.LogWarning(
                "Verificación 2FA con código de recuperación rechazada, ya había una en curso para el mismo usuario: {UsuarioId}",
                usuario.Id);
            mensajeError = Textos["RecuperacionEnCurso"];
            return;
        }

        var resultado = resultadoObtenido!;

        if (resultado.Succeeded)
        {
            logger.LogInformation("Verificación 2FA correcta con código de recuperación: {UsuarioId}", usuario.Id);

            if (!await CompletarVinculoPendienteAsync(usuario, vinculoPendiente, logger))
                return;

            if (HttpContext is not null)
                CulturaUsuarioCookie.Escribir(HttpContext, usuario.Idioma);

            if (usuario.DebeCambiarContrasena)
            {
                Navigation.NavigateTo("/cuenta/cambiar-contrasena", forceLoad: true);
                return;
            }

            Navigation.NavigateTo(RedireccionLocal.DestinoTrasLogin(ReturnUrl), forceLoad: true);
            return;
        }

        if (resultado.IsLockedOut)
        {
            logger.LogWarning("Verificación 2FA con código de recuperación rechazada, cuenta bloqueada: {UsuarioId}", usuario.Id);
            await SignInManager.SignOutAsync();
            _bloqueado = true;
            return;
        }

        if (fallidoSinRegistrar)
        {
            logger.LogError(
                "Verificación 2FA con código de recuperación fallida y sin registrar el intento; se cierra el paso: {UsuarioId}",
                usuario.Id);
            await SignInManager.SignOutAsync();
            _mensajeCierre = Textos["RecuperacionIntentoNoRegistrado"];
            _bloqueado = true;
            return;
        }

        logger.LogWarning("Verificación 2FA con código de recuperación fallida: {UsuarioId}", usuario.Id);
        mensajeError = Textos["RecuperacionNoValido"];
    }

    private string EnlaceModo(bool recuperacion)
    {
        var parametros = new Dictionary<string, object?>
        {
            ["modo"] = recuperacion ? "recuperacion" : null,
            ["returnUrl"] = ReturnUrl,
        };
        return Navigation.GetUriWithQueryParameters("/cuenta/verificar-2fa", parametros);
    }

    private const string MensajeBloqueo =
        "Demasiados intentos. Tu cuenta está bloqueada temporalmente; espera unos minutos y vuelve a iniciar sesión.";

    /// <summary>
    /// La identidad de Microsoft que el callback dejó pendiente en la cookie de dos
    /// pasos (D-2, vínculo tras el TOTP). Se lee antes de verificar: al superarlo,
    /// Identity borra esa cookie.
    /// </summary>
    private async Task<UserLoginInfo?> LeerVinculoPendienteAsync() =>
        HttpContext is null
            ? null
            : InicioSesionMicrosoft.VinculoPendiente(
                (await HttpContext.AuthenticateAsync(IdentityConstants.TwoFactorUserIdScheme)).Principal);

    /// <summary>Si la cookie de dos pasos es la de una primera vinculación que acaba de dar de alta el TOTP.</summary>
    private async Task<bool> EsAltaTotpPendienteAsync() =>
        HttpContext is not null
        && InicioSesionMicrosoft.AltaTotpPendiente(
            (await HttpContext.AuthenticateAsync(IdentityConstants.TwoFactorUserIdScheme)).Principal);

    /// <summary>
    /// Tras superar el TOTP de un inicio con Microsoft, guarda el vínculo pendiente.
    /// Si no queda guardado, se cierra la sesión recién emitida y se vuelve al inicio,
    /// como hace el callback: una identidad que no queda vinculada no entra.
    /// </summary>
    private async Task<bool> CompletarVinculoPendienteAsync(ApplicationUser usuario, UserLoginInfo? vinculo, ILogger logger)
    {
        if (vinculo is null)
            return true;

        if (await InicioSesionMicrosoft.CompletarVinculoPendienteAsync(SignInManager.UserManager, usuario, vinculo))
        {
            logger.LogInformation("Identidad de Microsoft vinculada tras el TOTP de TALVEG: {UsuarioId}", usuario.Id);
            return true;
        }

        logger.LogError("No se pudo vincular la identidad de Microsoft tras el TOTP de TALVEG; se cierra la sesión: {UsuarioId}", usuario.Id);
        await SignInManager.SignOutAsync();
        Navigation.NavigateTo("/cuenta/iniciar-sesion?errorSso=fallo", forceLoad: true);
        return false;
    }

    private sealed class DatosRecuperacion
    {
        public string Codigo { get; set; } = string.Empty;
    }

    private sealed class DatosEntrada
    {
        [Required(ErrorMessage = "Introduce el código de verificación.")]
