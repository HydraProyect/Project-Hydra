@page "/cuenta/olvide-contrasena"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization

<PageTitle>¿Has olvidado la contraseña? — @Marca.Nombre</PageTitle>

@* Mismo texto que el enlace del login («¿Has olvidado la contraseña?»): antes la
   pantalla decía «¿Olvidaste tu contraseña?» y el enlace que lleva a ella otra cosa. *@
<div class="acceso-tarjeta">
    @if (!_enviado)
    {
        <CabeceraAcceso Titulo="¿Has olvidado la contraseña?" Explicacion="@ExplicacionFormulario" />

        @if (_error)
        {
            <div class="acceso-alerta" role="alert">No pudimos procesar tu solicitud. Inténtalo de nuevo en unos minutos.</div>
        }

        @if (Entrada is not null)
        {
            <EditForm Model="Entrada" method="post" OnValidSubmit="EnviarAsync" FormName="olvide-contrasena" novalidate>
                <DataAnnotationsValidator />

                <div class="acceso-campo">
                    <label for="email">Correo electrónico</label>
                    <InputText id="email" @bind-Value="Entrada.Email" type="email" placeholder="nombre@consultora.es" autocomplete="username" />
                    <ValidationMessage For="() => Entrada.Email" />
                </div>

                <button type="submit" class="acceso-entrar" disabled="@_enviando">@(_enviando ? "Enviando…" : "Enviarme el enlace")</button>
            </EditForm>
        }
    }
    else
    {
        <CabeceraAcceso />
        <span class="acceso-exito" aria-hidden="true"><Icono Nombre="check" Tamano="TamanoIcono.Grande" /></span>
        <h2 class="acceso-titulo">Revisa tu correo</h2>
        <p class="acceso-explica">
            Si la dirección existe, recibirás un enlace en unos minutos. El enlace caduca en @MinutosCaducidad minutos.
        </p>

        @* El reenvío es un segundo envío del mismo formulario, con el correo en un
           campo oculto. Antes era un botón con @onclick, y esta página es SSR
           estática: sin circuito, ese clic no ejecutaba nada. *@
        @if (Entrada is not null)
        {
            <EditForm Model="Entrada" method="post" OnValidSubmit="EnviarAsync" FormName="olvide-contrasena" class="acceso-reenvio">
                <InputText type="hidden" @bind-Value="Entrada.Email" />
                ¿No llega nada? Revisa la carpeta de spam o
                <button type="submit" class="acceso-enlace-boton">vuelve a enviarlo</button>.
            </EditForm>
        }
    }

    <p class="acceso-olvido"><a href="/cuenta/iniciar-sesion">Volver a iniciar sesión</a></p>
</div>
