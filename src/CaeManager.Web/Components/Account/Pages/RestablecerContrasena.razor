@page "/cuenta/restablecer-contrasena"
@layout CaeManager.Web.Components.Layout.AccesoLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization

<PageTitle>Nueva contraseña — @Marca.Nombre</PageTitle>

<div class="acceso-tarjeta">
    @if (_enlaceInvalido)
    {
        <CabeceraAcceso Titulo="Enlace no válido"
                        Explicacion="Este enlace para restablecer la contraseña no es válido o ya caducó. Pide uno nuevo." />
        <a class="acceso-entrar" href="/cuenta/olvide-contrasena">Pedir un enlace nuevo</a>
    }
    else if (_completado)
    {
        <CabeceraAcceso />
        <span class="acceso-exito" aria-hidden="true"><Icono Nombre="check" Tamano="TamanoIcono.Grande" /></span>
        <h2 class="acceso-titulo">Contraseña actualizada</h2>
        <p class="acceso-explica">Ya puedes iniciar sesión con tu nueva contraseña.</p>
        <a class="acceso-entrar" href="/cuenta/iniciar-sesion">Iniciar sesión</a>
    }
    else
    {
        <CabeceraAcceso Titulo="Nueva contraseña" Explicacion="@ExplicacionCuenta" />

        @if (_mensajeError is not null)
        {
            <div class="acceso-alerta" role="alert">@_mensajeError</div>
        }

        @if (Entrada is not null)
        {
            <EditForm Model="Entrada" method="post" OnValidSubmit="GuardarAsync" FormName="restablecer-contrasena" novalidate>
                <DataAnnotationsValidator />

                <div class="acceso-campo">
                    <label for="password-nueva">Nueva contraseña</label>
                    <InputText id="password-nueva" type="password" @bind-Value="Entrada.ContrasenaNueva" autocomplete="new-password" aria-describedby="password-nueva-requisitos" />
                    <ValidationMessage For="() => Entrada.ContrasenaNueva" />
                </div>

                <RequisitosContrasena IdCampo="password-nueva" Politica="OpcionesIdentity.Value.Password" Valor="@Entrada.ContrasenaNueva" />

                <div class="acceso-campo">
                    <label for="password-confirmar">Repite la contraseña</label>
                    <InputText id="password-confirmar" type="password" @bind-Value="Entrada.ConfirmarContrasenaNueva" autocomplete="new-password" />
                    <ValidationMessage For="() => Entrada.ConfirmarContrasenaNueva" />
                    <p class="acceso-coincidencia" data-coincidencia-de="password-confirmar" data-coincidencia-con="password-nueva" aria-live="polite"></p>
                </div>

                @* disabled SOLO por _guardando, que nace en false — igual que el
                   _enviando de OlvideContrasena. Con !PuedeGuardar el boton
                   nacia deshabilitado y NADA podia habilitarlo: esta pagina es
                   SSR estatica, ese disabled se evaluaba una sola vez en
                   servidor con la contrasena vacia, y sin circuito escribir no
                   reevalua nada. Restablecer la contrasena era imposible.
                   La coincidencia de las dos contrasenas la comprueba ahora
                   GuardarAsync, que es donde puede comprobarse de verdad. *@
                <button type="submit" class="acceso-entrar" disabled="@_guardando">
                    @(_guardando ? "Guardando…" : "Guardar y entrar")
                </button>
            </EditForm>
        }
    }
</div>
