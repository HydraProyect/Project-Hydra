@page "/cuenta/pendiente-de-rol"
@layout CaeManager.Web.Components.Layout.AuthLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Asignación de rol pendiente — @Marca.Nombre</PageTitle>

<main class="pendiente-rol" aria-labelledby="pendiente-rol-titulo">
    <section class="pendiente-rol-tarjeta">
        <div class="pendiente-rol-icono" aria-hidden="true">i</div>
        <div class="pendiente-rol-cabecera">
            <p class="pendiente-rol-eyebrow">Cuenta creada</p>
            <h1 id="pendiente-rol-titulo">Asignación de rol pendiente</h1>
        </div>

        <p class="pendiente-rol-mensaje">Has iniciado sesión correctamente, pero todavía no tienes un rol asignado. Hasta que se asigne, no hay ninguna pantalla disponible para tu cuenta.</p>

        <section class="pendiente-rol-ayuda" aria-labelledby="pendiente-rol-ayuda-titulo">
            <h2 id="pendiente-rol-ayuda-titulo">¿Qué puedes hacer?</h2>
            <p>Contacta con la persona de tu organización que tenga capacidad para gestionar usuarios y roles.</p>
        </section>

        <form method="post" action="/cuenta/cerrar-sesion">
            <AntiforgeryToken />
            <button type="submit" class="pendiente-rol-cerrar-sesion">Cerrar sesión</button>
        </form>
    </section>

    <p class="pendiente-rol-pie">Esta es una cuenta autenticada sin acceso efectivo todavía.</p>
</main>
